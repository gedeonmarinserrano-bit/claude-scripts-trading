{
  "mcpServers": {
    "ctrader": {
      "command": "python",
      "args": ["-m", "ctrader_mcp"],
      "env": {
        "PYTHONPATH": "/ruta/a/claude-scripts-trading",
        "CTRADER_CLIENT_ID": "tu_client_id",
        "CTRADER_CLIENT_SECRET": "tu_client_secret",
        "CTRADER_ACCESS_TOKEN": "tu_access_token",
        "CTRADER_HOST": "demo",
        "CTRADER_ACCOUNT_ID": "",
        "CTRADER_ALLOW_TRADING": "0"
      }
    }
  }
}
