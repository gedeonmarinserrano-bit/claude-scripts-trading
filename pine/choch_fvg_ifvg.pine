// Indicador CHoCH + FVG + IFVG
// Misma lógica que scripts/choch_fvg.py:
//  - CHoCH/BOS: cierre más allá del último swing confirmado (pivote de `swingLen` velas).
//  - FVG: patrón de 3 velas (low > high[2] alcista, high < low[2] bajista).
//  - IFVG: un FVG se invierte cuando una vela CIERRA al otro lado del gap.
//@version=5
indicator("CHoCH + FVG + IFVG", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ───────── Inputs ─────────
swingLen      = input.int(5, "Longitud swing", minval = 1, group = "Estructura")
showBOS       = input.bool(true, "Mostrar BOS", group = "Estructura")
bullColor     = input.color(color.teal, "Alcista", group = "Estructura")
bearColor     = input.color(color.red, "Bajista", group = "Estructura")

showFVG       = input.bool(true, "Mostrar FVG", group = "FVG")
minSizePct    = input.float(0.0, "Tamaño mínimo (% del precio)", minval = 0, step = 0.05, group = "FVG")
fvgBullCol    = input.color(color.new(color.green, 80), "FVG alcista", group = "FVG")
fvgBearCol    = input.color(color.new(color.red, 80), "FVG bajista", group = "FVG")
hideMitigated = input.bool(false, "Ocultar FVG mitigados", group = "FVG")

showIFVG      = input.bool(true, "Mostrar IFVG", group = "IFVG")
ifvgBullCol   = input.color(color.new(color.aqua, 70), "IFVG alcista (soporte)", group = "IFVG")
ifvgBearCol   = input.color(color.new(color.orange, 70), "IFVG bajista (resistencia)", group = "IFVG")

maxZones      = input.int(50, "Máx. zonas vigiladas", minval = 1, maxval = 250, group = "General")

// ───────── Estructura: CHoCH / BOS ─────────
var float shPrice = na
var int   shIdx   = na
var float slPrice = na
var int   slIdx   = na
var int   trend   = 0   // 1 alcista, -1 bajista, 0 sin definir

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
if not na(ph)
    shPrice := ph
    shIdx   := bar_index - swingLen
if not na(pl)
    slPrice := pl
    slIdx   := bar_index - swingLen

bullBreak = not na(shPrice) and close > shPrice
bearBreak = not bullBreak and not na(slPrice) and close < slPrice
chochBull = bullBreak and trend == -1
chochBear = bearBreak and trend == 1

drawBreak(int fromIdx, float level, bool isChoch, bool bullish) =>
    col = bullish ? bullColor : bearColor
    line.new(fromIdx, level, bar_index, level, color = col, width = isChoch ? 2 : 1, style = isChoch ? line.style_solid : line.style_dashed)
    label.new(math.round((fromIdx + bar_index) / 2), level, isChoch ? "CHoCH" : "BOS", color = color(na), textcolor = col, size = size.small, style = bullish ? label.style_label_down : label.style_label_up)

if bullBreak
    if chochBull or showBOS
        drawBreak(shIdx, shPrice, chochBull, true)
    trend   := 1
    shPrice := na
else if bearBreak
    if chochBear or showBOS
        drawBreak(slIdx, slPrice, chochBear, false)
    trend   := -1
    slPrice := na

// ───────── FVG / IFVG ─────────
type Zone
    box   bx
    float top
    float bottom
    int   dir        // dirección actual: 1 alcista, -1 bajista
    bool  inverse    // true = IFVG
    bool  mitigated  // FVG rellenado por mecha (sigue vigilado por si se invierte)

var zones = array.new<Zone>()
newIfvgBull = false
newIfvgBear = false

// Actualizar zonas existentes (antes de añadir las de esta vela).
if zones.size() > 0
    for i = zones.size() - 1 to 0
        z = zones.get(i)
        if not z.inverse
            inverted = z.dir == 1 ? close < z.bottom : close > z.top
            if inverted
                if not z.mitigated
                    z.bx.set_right(bar_index)
                newDir = -z.dir
                if newDir == 1
                    newIfvgBull := true
                else
                    newIfvgBear := true
                if showIFVG
                    col = newDir == 1 ? ifvgBullCol : ifvgBearCol
                    b = box.new(bar_index, z.top, bar_index + 1, z.bottom, border_color = color.new(col, 0), bgcolor = col, text = "IFVG", text_size = size.tiny, text_color = color.new(col, 0), text_halign = text.align_right)
                    zones.set(i, Zone.new(b, z.top, z.bottom, newDir, true, false))
                else
                    zones.remove(i)
            else if not z.mitigated
                filled = z.dir == 1 ? low <= z.bottom : high >= z.top
                if filled
                    z.mitigated := true
                    if hideMitigated
                        z.bx.delete()
                    else
                        z.bx.set_right(bar_index)
                else
                    z.bx.set_right(bar_index + 1)
        else
            // IFVG invalidado cuando el precio cierra de nuevo al otro lado.
            invalid = z.dir == 1 ? close < z.bottom : close > z.top
            if invalid
                z.bx.set_right(bar_index)
                zones.remove(i)
            else
                z.bx.set_right(bar_index + 1)

bullFvg = low > high[2] and (low - high[2]) / close * 100 > minSizePct
bearFvg = high < low[2] and (low[2] - high) / close * 100 > minSizePct

addFvg(float top, float bottom, int dir) =>
    col = dir == 1 ? fvgBullCol : fvgBearCol
    b = showFVG ? box.new(bar_index - 2, top, bar_index + 1, bottom, border_color = na, bgcolor = col, text = "FVG", text_size = size.tiny, text_color = color.new(col, 0), text_halign = text.align_right) : na
    zones.push(Zone.new(b, top, bottom, dir, false, false))
    if zones.size() > maxZones
        zones.shift()

if bullFvg
    addFvg(low, high[2], 1)
else if bearFvg
    addFvg(low[2], high, -1)

// ───────── Alertas ─────────
alertcondition(chochBull, "CHoCH alcista", "CHoCH alcista en {{ticker}} ({{interval}})")
alertcondition(chochBear, "CHoCH bajista", "CHoCH bajista en {{ticker}} ({{interval}})")
alertcondition(bullFvg, "FVG alcista", "Nuevo FVG alcista en {{ticker}} ({{interval}})")
alertcondition(bearFvg, "FVG bajista", "Nuevo FVG bajista en {{ticker}} ({{interval}})")
alertcondition(newIfvgBull, "IFVG alcista creado", "Nuevo IFVG alcista (soporte) en {{ticker}} ({{interval}})")
alertcondition(newIfvgBear, "IFVG bajista creado", "Nuevo IFVG bajista (resistencia) en {{ticker}} ({{interval}})")
