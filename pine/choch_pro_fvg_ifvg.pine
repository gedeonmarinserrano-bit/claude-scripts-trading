// Paleta: cada tipo de elemento tiene un tono propio y separado de los demás
g_col           = "Colores"
color_alcista   = input.color(#00A651, "Estructura y FVG alcista (verde)", group=g_col)
color_bajista   = input.color(#E4002B, "Estructura y FVG bajista (rojo)", group=g_col)
