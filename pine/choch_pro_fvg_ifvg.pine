max_htf         = input.int(25, "Máx. FVG por temporalidad (M5, M15, H1, H4)", minval=1, maxval=60, group=g_fvgtf)
// Las zonas muy lejos del precio no aportan en intradía y son las que más tiempo de cálculo cuestan
max_dibujadas   = input.int(100, "Máx. zonas dibujadas a la vez (menos = más rápido)", minval=5, maxval=150, group=g_fvgtf)
