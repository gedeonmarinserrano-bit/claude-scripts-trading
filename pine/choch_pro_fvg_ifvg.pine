col_ifvg        = input.color(#FF00C8, "IFVG (magenta)", group=g_col)
// Zonas intensas pero algo transparentes: TradingView pinta siempre las cajas por encima de las EMAs
// (plot), y solo con transparencia se ven las EMAs a través de ellas. Todo queda detrás de las velas.
transp_zonas    = input.int(40, "Transparencia de las zonas (0 = color pleno, tapa las EMAs)", minval=0, maxval=95, step=5, group=g_col)
sin_solape      = input.bool(true, "Zonas sin solaparse (la más concreta encima, la mayor alrededor)", group=g_col)

// Zonas (FVG, IFVG, OB, FVG M15/H1/H4): aquí solo se guardan los datos. Se dibujan al final,
// recortadas para que ninguna quede por debajo de otra (ver «DIBUJO DE ZONAS SIN SOLAPES»).
type Zona
    int   x1          // vela donde empieza la zona
    float techo
    float suelo
    int   dir         // 1 alcista, -1 bajista
    float borde = na  // límite de la parte aún sin tocar (na = intacta)
    int   creado = na // vela en la que se creó (esa vela no la consume)
    bool  avisado = false // IFVG: ya ha saltado la alerta de retesteo

var zonas  = array.new<Zona>()   // FVG del gráfico (el riesgo del CHoCH las consulta)
var ifvgs  = array.new<Zona>()
var obs    = array.new<Zona>()
var fvg1   = array.new<Zona>()
var fvg5   = array.new<Zona>()
var fvg15  = array.new<Zona>()
var fvg60  = array.new<Zona>()
var fvg240 = array.new<Zona>()
// IFVG que vienen de FVG de M1, M5, M15, H1 y H4
var ifvg1   = array.new<Zona>()
var ifvg5   = array.new<Zona>()
var ifvg15  = array.new<Zona>()
var ifvg60  = array.new<Zona>()
var ifvg240 = array.new<Zona>()

// Rangos ya terminados, para dibujar su sombreado sin solaparse con las zonas
type Rango
    int   x1
    int   x2
    float techo
    float suelo
    color col

var rangos_hist = array.new<Rango>()

// Consumo progresivo con la vela actual: la zona alcista se consume desde el techo hacia abajo y
// la bajista desde el suelo hacia arriba. Devuelve true cuando la mecha llega al otro extremo.
consumir(Zona z) =>
    completa = z.dir == 1 ? low <= z.suelo : high >= z.techo
    if not completa
        borde = na(z.borde) ? (z.dir == 1 ? z.techo : z.suelo) : z.borde
        if z.dir == 1 ? low < borde : high > borde
            z.borde := z.dir == 1 ? low : high
    completa

// Etiquetas de estructura dibujadas (CHoCH, ✗ CHoCH, BOS), para poder borrarlas
// si después se detecta un rango que las contiene
type Marca
    label lb
    line  ln
    int   bar

var marcas = array.new<Marca>()

// Último CHoCH/BOS (texto y vela), para el panel
var array<string> ult_evento_txt = array.from("")
var array<int>    ult_evento_bar = array.from(0)

registrar_marca(label lb, line ln, int bar) =>
    marcas.push(Marca.new(lb, ln, bar))
    if not na(lb)
        ult_evento_txt.set(0, lb.get_text())
        ult_evento_bar.set(0, bar)
    if marcas.size() > 500
        marcas.shift()

ema_rapida = ta.ema(close, ema_rap_len)
ema_media  = ta.ema(close, ema_med_len)
ema_lenta  = ta.ema(close, ema_len_len)
atr_val    = ta.atr(atr_len)

//              ╔════════════════════════════════╗              //
//              ║  AUTO RANGE DETECTOR [QuantAlgo] ║            //
//              ║      USER-DEFINED SETTINGS     ║              //
//              ╚════════════════════════════════╝              //

var string group_detect    = '════════ Detection ════════'
var string group_structure = '════════ Structure Filters ════════'
var string group_range     = '════════ Range Behavior ════════'
