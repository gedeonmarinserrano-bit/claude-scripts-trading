info_liquidez = input.bool(true, "Liquidez más cercana por arriba y por abajo", group=g_panel)
noticias      = input.string("", "Noticias de hoy (texto libre, p. ej. «CPI 14:30»; vacío = no se muestra)", group=g_panel)

// Información extra en el gráfico: cada una se puede quitar y poner
