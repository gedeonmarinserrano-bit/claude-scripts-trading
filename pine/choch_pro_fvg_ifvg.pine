info_eq       = input.bool(true, "Línea del 50 % del día anterior (por encima premium, por debajo descuento)", group=g_extra)
info_eqhl     = input.bool(true, "Altos y bajos iguales sin barrer (EQH / EQL)", group=g_extra)
