show_quartiles    = true
show_range_label  = input.bool(true, 'Mostrar etiqueta del rango', group = g_rng)
show_breakouts    = input.bool(true, 'Mostrar flechas de ruptura (breakout)', group = g_rng)
show_deviations   = input.bool(true, 'Mostrar marcas de ruptura fallida (deviation)', group = g_rng)
label_text_size   = 'Small'
marcas_sutiles    = true
tam_marcas_txt    = 'Small'

[bullish_color, bearish_color] = switch color_preset
    'Classic' => [#00ff00, #ff0000]
    'Aqua'    => [#00d4ff, #ff8c00]
    'Cosmic'  => [#49ffce, #9932cc]
    'Cyber'   => [#00cccc, #ff6600]
    'Neon'    => [#ffff00, #ff00ff]
    =>           [bullish_input, bearish_input]

var color transparent_fill = color.new(color.black, 100)
var float contrast_line    = 3.0
var float contrast_fill    = 1.6

//              ╔════════════════════════════════╗              //
//              ║       UTILITY FUNCTIONS        ║              //
//              ╚════════════════════════════════╝              //

resolveSize(string choice) =>
    switch choice
        'Tiny'   => size.tiny
        'Normal' => size.normal
        'Large'  => size.large
        =>          size.small

luminanceOf(color source) =>
    channel_r = color.r(source) / 255.0
    channel_g = color.g(source) / 255.0
    channel_b = color.b(source) / 255.0
    linear_r  = channel_r <= 0.03928 ? channel_r / 12.92 : math.pow((channel_r + 0.055) / 1.055, 2.4)
    linear_g  = channel_g <= 0.03928 ? channel_g / 12.92 : math.pow((channel_g + 0.055) / 1.055, 2.4)
    linear_b  = channel_b <= 0.03928 ? channel_b / 12.92 : math.pow((channel_b + 0.055) / 1.055, 2.4)
    0.2126 * linear_r + 0.7152 * linear_g + 0.0722 * linear_b

contrastRatio(color first_color, color second_color) =>
    first_lum  = luminanceOf(first_color)
    second_lum = luminanceOf(second_color)
    (math.max(first_lum, second_lum) + 0.05) / (math.min(first_lum, second_lum) + 0.05)

contrastText(color backdrop) =>
    luminanceOf(backdrop) > 0.179 ? #000000 : #ffffff

blendToward(color source, color target, float weight) =>
    color.rgb(color.r(source) + (color.r(target) - color.r(source)) * weight, color.g(source) + (color.g(target) - color.g(source)) * weight, color.b(source) + (color.b(target) - color.b(source)) * weight)

readableOn(color source, color backdrop, float floor_ratio) =>
    target   = contrastText(backdrop)
    adjusted = source
    for step = 1 to 10
        if contrastRatio(adjusted, backdrop) >= floor_ratio
            break
        adjusted := blendToward(source, target, step / 10.0)
    adjusted

percentText(float value) =>
    str.tostring(value, '#.##') + '%'

buildShade(array<box> shade, int left_bar, float top_price, float bottom_price) =>
    array.clear(shade)
    // Sin solapes, el sombreado del rango lo dibuja el bloque de zonas (aquí no se crea)
    if not sin_solape
        for i = 0 to gradient_steps - 1
            array.push(shade, box.new(left_bar, top_price, bar_index, bottom_price, border_color = na, border_width = 0, bgcolor = na, xloc = xloc.bar_index))

paintShade(array<box> shade, float top_price, float bottom_price, int left_bar, int right_bar, color shade_color) =>
    slices = array.size(shade)
    if slices > 0 and top_price > bottom_price
        slice_height = (top_price - bottom_price) / slices
        for i = 0 to slices - 1
            slice_box   = array.get(shade, i)
            center_dist = math.abs((i + 0.5) / slices - 0.5) * 2.0
            slice_trans = int(math.min(99, math.max(0, fill_transparency + (1.0 - center_dist) * 10)))
            box.set_lefttop(slice_box, left_bar, top_price - slice_height * i)
            box.set_rightbottom(slice_box, right_bar, top_price - slice_height * (i + 1))
            box.set_bgcolor(slice_box, color.new(shade_color, slice_trans))

deleteShade(array<box> shade) =>
    if array.size(shade) > 0
        for i = 0 to array.size(shade) - 1
            box.delete(array.get(shade, i))
    array.clear(shade)

anchorSpan(int window, float top_price, float bottom_price, float tolerance) =>
    span = window
    if range_anchoring == 'Extend to containment'
        limit   = math.min(anchor_lookback, bar_index)
        allowed = math.max(2, math.round((1.0 - min_containment) * window))
        outside = 0
        offset  = 0
        while offset < limit and outside <= allowed
            closed_in = close[offset] <= top_price and close[offset] >= bottom_price
            fully_in  = closed_in and high[offset] <= top_price + tolerance and low[offset] >= bottom_price - tolerance
            if closed_in
                outside := math.max(0, outside - 1)
                if fully_in and offset + 1 >= window
                    span := offset + 1
            else
                outside += 1
            offset += 1
    span

//              ╔════════════════════════════════╗              //
//              ║        CORE CALCULATION        ║              //
//              ╚════════════════════════════════╝              //

atr_value   = ta.atr(atr_length)
context_ok  = not na(atr_value) and atr_value > 0
wick_break  = break_confirm == 'Wick beyond'
wick_touch  = touch_basis == 'Wick reaches'
live_timing = signal_timing == 'Live bar'
bar_ready   = live_timing or barstate.isconfirmed
label_size  = resolveSize(label_text_size)
tam_marcas  = resolveSize(tam_marcas_txt)

chart_backdrop     = chart.bg_color
range_line_color   = readableOn(range_input, chart_backdrop, contrast_line)
bullish_line_color = readableOn(bullish_color, chart_backdrop, contrast_line)
bearish_line_color = readableOn(bearish_color, chart_backdrop, contrast_line)
range_fill_color   = readableOn(range_input, chart_backdrop, contrast_fill)
bullish_fill_color = readableOn(bullish_color, chart_backdrop, contrast_fill)
bearish_fill_color = readableOn(bearish_color, chart_backdrop, contrast_fill)

scanWindow(simple int len) =>
    pct_top     = ta.percentile_linear_interpolation(high, len, band_percentile)
    pct_bottom  = ta.percentile_linear_interpolation(low, len, 100.0 - band_percentile)
    ext_top     = ta.highest(high, len)
    ext_bottom  = ta.lowest(low, len)
    body_top    = ta.highest(math.max(open, close), len)
    body_bottom = ta.lowest(math.min(open, close), len)
    top         = boundary_basis == 'Absolute extremes' ? ext_top : boundary_basis == 'Body extremes' ? body_top : pct_top
    bottom      = boundary_basis == 'Absolute extremes' ? ext_bottom : boundary_basis == 'Body extremes' ? body_bottom : pct_bottom
    band_height = top - bottom
    compression = context_ok and band_height > 0 ? band_height / (atr_value * math.sqrt(len)) : 99.0
    span_cap    = bar_index < 1 ? calibration_len : int(math.max(1, math.min(calibration_len, bar_index - atr_length)))
    rank        = ta.percentrank(compression, span_cap)
    slope       = ta.linreg(close, len, 0) - ta.linreg(close, len, 1)
    drift       = band_height > 0 ? math.abs(slope) * len / band_height : 99.0
    midpoint    = math.avg(top, bottom)
    tolerance   = touch_tolerance * nz(atr_value)
    crossings   = 0
    hits_top    = 0
    hits_bottom = 0
    contained   = 0
    for i = 0 to len - 1
        if (close[i] > midpoint) != (close[i + 1] > midpoint)
            crossings += 1
        touched_top    = wick_touch ? high[i] >= top - tolerance : close[i] >= top - tolerance
        touched_bottom = wick_touch ? low[i] <= bottom + tolerance : close[i] <= bottom + tolerance
        if touched_top
            hits_top += 1
        if touched_bottom
            hits_bottom += 1
        if close[i] <= top and close[i] >= bottom
            contained += 1
    containment = contained / float(len)
    qualified   = context_ok and not na(rank) and bar_index > len + 5 and rank <= compression_pct and crossings >= math.max(3, math.round(min_rotation * len)) and hits_top >= min_touches and hits_bottom >= min_touches and drift <= max_drift and containment >= min_containment
    [qualified, top, bottom]

// Solo dentro de las velas a calcular (es la parte que más tiempo cuesta)
bool  qualified_a = false
bool  qualified_b = false
bool  qualified_c = false
float top_a = na
float top_b = na
float top_c = na
float bottom_a = na
float bottom_b = na
float bottom_c = na
if en_calc
    [qa, ta_, ba] = scanWindow(base_length)
    qualified_a := qa
    top_a       := ta_
    bottom_a    := ba
    if scan_scaling != 'Base only'
        [qb, tb, bb] = scanWindow(base_length * 2)
        qualified_b := qb
        top_b       := tb
        bottom_b    := bb
    if scan_scaling == 'Base + 2x + 3x'
        [qc, tc, bc] = scanWindow(base_length * 3)
        qualified_c := qc
        top_c       := tc
        bottom_c    := bc

use_double = scan_scaling != 'Base only' and qualified_b
use_triple = scan_scaling == 'Base + 2x + 3x' and qualified_c
qualified  = qualified_a or use_double or use_triple

scan_length = use_triple ? base_length * 3 : use_double ? base_length * 2 : base_length
scan_top    = use_triple ? top_c : use_double ? top_b : top_a
scan_bottom = use_triple ? bottom_c : use_double ? bottom_b : bottom_a

//              ╔════════════════════════════════╗              //
//              ║          RANGE ENGINE          ║              //
//              ╚════════════════════════════════╝              //

var array<box> shade_boxes = array.new<box>()
var box   range_box        = na
var line  equilibrium_line = na
var line  lower_quartile   = na
var line  upper_quartile   = na
var label range_tag        = na
var label break_marker     = na
var float range_top        = na
var float range_bottom     = na
var int   range_left       = na
var int   range_opened     = na
var bool  range_active     = false
var bool  range_confirmed  = false
var bool  range_dormant    = false
var int   dormant_since    = na
var int   dormant_dir      = 0
var float deviation_price  = na
var int   deviation_bar    = na
var int   cooldown_left    = 0

signal_new_range  = false
signal_break_up   = false
signal_break_down = false
signal_deviation  = false

if bar_ready and cooldown_left > 0
    cooldown_left -= 1

if bar_ready and not range_active and not range_dormant and cooldown_left <= 0 and qualified
    anchor_bars      = anchorSpan(scan_length, scan_top, scan_bottom, touch_tolerance * atr_value)
    range_left      := bar_index - anchor_bars + 1
    range_opened    := bar_index
    range_top       := scan_top
    range_bottom    := scan_bottom
    range_active    := true
    range_confirmed := false
    midpoint         = math.avg(range_top, range_bottom)
    quartile_low     = range_bottom + (range_top - range_bottom) * 0.25
    quartile_high    = range_bottom + (range_top - range_bottom) * 0.75
    range_box       := box.new(range_left, range_top, bar_index, range_bottom, border_color = color.new(range_line_color, 55), border_width = 2, border_style = line.style_dotted, bgcolor = na, xloc = xloc.bar_index)
    buildShade(shade_boxes, range_left, range_top, range_bottom)
    if show_equilibrium
        equilibrium_line := line.new(range_left, midpoint, bar_index, midpoint, xloc.bar_index, extend.none, color.new(color.gray, 45), line.style_dotted, 1)
    if show_quartiles
        lower_quartile := line.new(range_left, quartile_low, bar_index, quartile_low, xloc.bar_index, extend.none, color.new(color.gray, 70), line.style_dotted, 1)
        upper_quartile := line.new(range_left, quartile_high, bar_index, quartile_high, xloc.bar_index, extend.none, color.new(color.gray, 70), line.style_dotted, 1)
    if show_range_label
        range_tag := label.new(range_left, range_top, '', xloc = xloc.bar_index, yloc = yloc.price, color = transparent_fill, style = label.style_label_down, textcolor = color.new(range_line_color, 10), size = label_size)
    signal_new_range := true

if range_active and bar_ready
    break_offset  = breakout_buffer * atr_value
    absorb_offset = overshoot_tol * atr_value
    if absorb_overshoot and not wick_break and close <= range_top and close >= range_bottom
        if high > range_top and high <= range_top + absorb_offset
            range_top := high
        if low < range_bottom and low >= range_bottom - absorb_offset
            range_bottom := low
    break_up   = wick_break ? high > range_top + break_offset : close > range_top + break_offset
    break_down = wick_break ? low < range_bottom - break_offset : close < range_bottom - break_offset
    range_aged = max_range_age > 0 and bar_index - range_opened + 1 >= max_range_age
    if break_up or break_down or range_aged
        break_direction = break_up ? 1 : break_down ? -1 : 0
        held_bars       = break_direction != 0 ? bar_index - range_left : bar_index - range_left + 1
        range_height    = range_bottom != 0 ? (range_top - range_bottom) / range_bottom * 100.0 : 0.0
        hold_for_merge  = merge_deviations and break_direction != 0 and range_confirmed
        if range_confirmed
            retire_line = break_direction == 1 ? bullish_line_color : break_direction == -1 ? bearish_line_color : range_line_color
            retire_fill = break_direction == 1 ? bullish_fill_color : break_direction == -1 ? bearish_fill_color : range_fill_color
            retire_base = break_direction == 1 ? bullish_color : break_direction == -1 ? bearish_color : range_input
            box.set_lefttop(range_box, range_left, range_top)
            box.set_rightbottom(range_box, bar_index, range_bottom)
            // Rango terminado: sin fondo; el marco y el letrero toman el color de la ruptura
            box.set_border_color(range_box, color.new(retire_line, 30))
            box.set_border_style(range_box, line.style_dotted)
            paintShade(shade_boxes, range_top, range_bottom, range_left, bar_index, na)
            rangos_hist.push(Rango.new(range_left, bar_index, range_top, range_bottom, retire_fill))
            if rangos_hist.size() > 8
                rangos_hist.shift()
            if not na(equilibrium_line)
                line.set_x2(equilibrium_line, bar_index)
            if not na(lower_quartile)
                line.set_x2(lower_quartile, bar_index)
                line.set_x2(upper_quartile, bar_index)
            if not na(range_tag)
                label.set_xy(range_tag, int(math.avg(range_left, bar_index)), range_top)
                label.set_text(range_tag, 'RANGE   ' + str.tostring(held_bars) + ' BARS   ' + percentText(range_height))
                label.set_textcolor(range_tag, color.new(retire_line, 10))
            if show_breakouts and break_direction != 0
                marker_text  = (break_direction == 1 ? '▲  ' : '▼  ') + 'Breakout'
                if marcas_sutiles
                    // Solo una flecha pequeña del color de la ruptura, sin fondo; el texto va en el tooltip
                    break_marker := label.new(bar_index, break_direction == 1 ? low : high, break_direction == 1 ? '▲' : '▼', xloc = xloc.bar_index, yloc = yloc.price, color = transparent_fill, style = break_direction == 1 ? label.style_label_up : label.style_label_down, textcolor = color.new(retire_line, 20), size = tam_marcas, tooltip = 'Breakout del rango')
                else
                    break_marker := label.new(bar_index, break_direction == 1 ? low : high, marker_text, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(retire_base, 10), style = break_direction == 1 ? label.style_label_up : label.style_label_down, textcolor = contrastText(retire_base), size = label_size)
            if break_direction == 1
                signal_break_up := true
            else if break_direction == -1
                signal_break_down := true
        else
            box.delete(range_box)
            deleteShade(shade_boxes)
            line.delete(equilibrium_line)
            line.delete(lower_quartile)
            line.delete(upper_quartile)
            label.delete(range_tag)
        if hold_for_merge
            range_dormant   := true
            dormant_since   := bar_index
            dormant_dir     := break_direction
            deviation_price := break_direction == 1 ? high : low
            deviation_bar   := bar_index
        else
            array.clear(shade_boxes)
            range_box        := na
            equilibrium_line := na
            lower_quartile   := na
            upper_quartile   := na
            range_tag        := na
            break_marker     := na
        range_active    := false
        range_confirmed := false
        cooldown_left   := cooldown_bars
    else
        range_confirmed := bar_index - range_left + 1 >= min_range_bars

if range_dormant and bar_ready
    if dormant_dir == 1 and high > deviation_price
        deviation_price := high
        deviation_bar   := bar_index
    if dormant_dir == -1 and low < deviation_price
        deviation_price := low
        deviation_bar   := bar_index
    reentered = dormant_dir == 1 ? close <= range_top : close >= range_bottom
    expired   = bar_index - dormant_since >= deviation_window
    if reentered and bar_index > dormant_since
        deviation_base = dormant_dir == 1 ? bearish_color : bullish_color
        deviation_text = (dormant_dir == 1 ? '⤵  ' : '⤴  ') + 'Deviation'
        if show_deviations
            if marcas_sutiles
                deviation_line = readableOn(deviation_base, chart_backdrop, contrast_line)
                label.new(deviation_bar, deviation_price, dormant_dir == 1 ? '⤵' : '⤴', xloc = xloc.bar_index, yloc = yloc.price, color = transparent_fill, style = dormant_dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.new(deviation_line, 20), size = tam_marcas, tooltip = 'Deviation: ruptura fallida, el precio volvió al rango')
            else
                label.new(deviation_bar, deviation_price, deviation_text, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(deviation_base, 10), style = dormant_dir == 1 ? label.style_label_down : label.style_label_up, textcolor = contrastText(deviation_base), size = label_size)
        label.delete(break_marker)
        break_marker := na
        if not na(range_box)
            box.set_border_color(range_box, color.new(range_line_color, 30))
            paintShade(shade_boxes, range_top, range_bottom, range_left, bar_index, na)
        if not na(range_tag)
            label.set_textcolor(range_tag, color.new(range_line_color, 10))
        range_active     := true
        range_confirmed  := true
        range_dormant    := false
        dormant_dir      := 0
        cooldown_left    := 0
        signal_deviation := true
        // El rango vuelve a estar activo: deja de contar como rango terminado
        if rangos_hist.size() > 0 and rangos_hist.last().x1 == range_left
            rangos_hist.pop()
    else if expired
        array.clear(shade_boxes)
        range_dormant    := false
        dormant_dir      := 0
        range_box        := na
        equilibrium_line := na
        lower_quartile   := na
        upper_quartile   := na
        range_tag        := na
        break_marker     := na

if range_active
    live_height   = range_bottom != 0 ? (range_top - range_bottom) / range_bottom * 100.0 : 0.0
    midpoint      = math.avg(range_top, range_bottom)
    quartile_low  = range_bottom + (range_top - range_bottom) * 0.25
    quartile_high = range_bottom + (range_top - range_bottom) * 0.75
    box.set_lefttop(range_box, range_left, range_top)
    box.set_rightbottom(range_box, bar_index, range_bottom)
    box.set_border_color(range_box, color.new(range_line_color, range_confirmed ? 30 : 55))
    box.set_border_style(range_box, line.style_dotted)
    // Sin fondo: el rango se distingue por su marco y su letrero, del color de su estado
    paintShade(shade_boxes, range_top, range_bottom, range_left, bar_index, na)
    if not na(equilibrium_line)
        line.set_xy1(equilibrium_line, range_left, midpoint)
        line.set_xy2(equilibrium_line, bar_index, midpoint)
    if not na(lower_quartile)
        line.set_xy1(lower_quartile, range_left, quartile_low)
        line.set_xy2(lower_quartile, bar_index, quartile_low)
        line.set_xy1(upper_quartile, range_left, quartile_high)
        line.set_xy2(upper_quartile, bar_index, quartile_high)
    if not na(range_tag)
        label.set_xy(range_tag, int(math.avg(range_left, bar_index)), range_top)
        label.set_text(range_tag, (range_confirmed ? 'RANGE   ' : 'FORMING   ') + str.tostring(bar_index - range_left + 1) + ' BARS   ' + percentText(live_height))

signal_any_break = signal_break_up or signal_break_down

// Mientras hay un rango activo (en formación o confirmado) no se marcan CHoCH ni BOS.
// Al salir del rango (breakout) se evalúa la estructura en esa misma vela.
en_rango     = filtro_rango and range_active
salida_rango = filtro_rango and range_active[1] and not range_active

// ─────────────────────────────
// DETECCIÓN DE PIVOTES
// ─────────────────────────────
pico  = ta.pivothigh(high, periodo, periodo)
valle = ta.pivotlow(low, periodo, periodo)

var float ultimo_pico  = na
var int bar_pico       = na
var float ultimo_valle = na
var int bar_valle      = na
var int tendencia      = 0 

if not na(pico)
    ultimo_pico := pico
    bar_pico    := bar_index[periodo]
if not na(valle)
    ultimo_valle := valle
    bar_valle    := bar_index[periodo]

// ─────────────────────────────
// LÓGICA DE VOLUMEN
// ─────────────────────────────
avg_vol = ta.sma(volume, vol_len)
vol_ok  = volume > (avg_vol * vol_mult)
vol_top_confirm = volume > (avg_vol * vol_top)

// ─────────────────────────────
// RIESGO DE CHoCH FALSO (evaluado al cierre de la vela del CHoCH)
// ─────────────────────────────
riesgo_choch(int dir, float nivel) =>
    rango  = math.max(high - low, syminfo.mintick)
    cuerpo = math.abs(close - open)
    mecha  = dir == 1 ? high - math.max(open, close) : math.min(open, close) - low
    int puntos = 0
    string motivos = ""
    if mecha / rango >= mecha_pct / 100
        puntos += 1
        motivos += "• Mecha de rechazo\n"
    if math.abs(close - nivel) < dist_atr * atr_val
        puntos += 1
        motivos += "• Ruptura corta\n"
    if rango > climax_atr * atr_val
        puntos += 1
        motivos += "• Vela de clímax\n"
    if (dir == 1 and close < ema_lenta) or (dir == -1 and close > ema_lenta)
        puntos += 1
        motivos += "• Contra la EMA lenta\n"
    if cuerpo / rango < cuerpo_pct / 100
        puntos += 1
        motivos += "• Cuerpo pequeño\n"
    zona_delante = false
    for z in zonas
        if dir == 1 and z.dir == -1 and z.suelo >= close and z.suelo - close <= zona_atr * atr_val
            zona_delante := true
        if dir == -1 and z.dir == 1 and z.techo <= close and close - z.techo <= zona_atr * atr_val
            zona_delante := true
    if zona_delante
        puntos += 1
        motivos += "• FVG contrario delante\n"
    [puntos, motivos]

// ─────────────────────────────
// SIN REPINTADO
// Todo se decide al CIERRE de la vela (barstate.isconfirmed) y cada etiqueta de CHoCH se
// dibuja una sola vez, ya con su estado definitivo, y no se modifica después:
//  - El CHoCH se dibuja al cierre de la vela siguiente a la ruptura, si se mantiene.
//  - Si falla, se dibuja como «✗ CHoCH» (gris).
//  - Si luego el precio recupera ese nivel, ESA MISMA etiqueta pasa a CHoCH válido
//    (nunca hay un «✗ CHoCH» y un «CHoCH» del mismo nivel a la vez).
// ─────────────────────────────
cerrada = barstate.isconfirmed

// CHoCH pendiente de confirmar en la vela siguiente
var int    choch_bar     = na
var int    choch_dir     = 0
var float  choch_nivel   = na
var int    choch_bar_piv = na
var string choch_texto   = ""
var string choch_tip     = ""
var int    tend_previa   = 0
// true desde que un CHoCH falla hasta que hay un CHoCH nuevo o la tendencia se reactiva:
// mientras tanto no se dibujan BOS
var bool   tendencia_invalidada = false
var int    dir_invalidada       = 0
var float  nivel_invalidado     = na
var int    bar_piv_invalidado   = na
var string texto_invalidado     = ""
var label  lbl_invalidado       = na
var line   ln_invalidado        = na
var int    bar_invalidado       = na

// Último BOS dibujado: cuando un CHoCH contrario se confirma, ese BOS era el que marcó
// el giro y se borra (en el cambio de tendencia solo queda el CHoCH)
var label ultimo_bos_lbl = na
var int   ultimo_bos_bar = na
var int   ultimo_bos_dir = 0

borrar_bos_contrario(int dir_choch, int bar_choch) =>
    if borrar_bos_giro and not na(ultimo_bos_bar) and ultimo_bos_dir == -dir_choch and (bos_ventana == 0 or bar_choch - ultimo_bos_bar <= bos_ventana)
        ultimo_bos_lbl.delete()

dibujar_choch(int dir, int bar_piv, float nivel, int bar_rotura, string texto, string tip, color col, bool fallido) =>
    ln = line.new(bar_piv, nivel, bar_rotura, nivel, color=col, width=1, style=fallido ? line.style_dashed : line.style_solid)
    lb = label.new(bar_rotura - offset_x, nivel, texto, style=dir == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.white, 100), textcolor=col, size=size.small, tooltip=tip)
    [ln, lb]

// Al detectarse un rango (o volver a él tras una Deviation) se borran los CHoCH/BOS que
// quedaron dentro de la caja: el rango se detecta cuando ya lleva varias velas formado.
// Tendencia que había justo antes de la primera vela del rango
tend_antes_rango = na(range_left) ? tendencia : nz(tendencia[math.max(0, bar_index - range_left + 1)], 0)
if filtro_rango and (signal_new_range or signal_deviation) and not na(range_left)
    // Las rupturas que hubo dentro de la caja no cuentan: se vuelve a la tendencia previa al rango
    tendencia := tend_antes_rango
    if marcas.size() > 0
        for i = marcas.size() - 1 to 0
            m = marcas.get(i)
            if m.bar >= range_left
                m.lb.delete()
                m.ln.delete()
                marcas.remove(i)
    if not na(choch_bar) and choch_bar >= range_left
        choch_bar := na
    if tendencia_invalidada and bar_invalidado >= range_left
        tendencia_invalidada := false
        lbl_invalidado       := na
        ln_invalidado        := na

choch_fallido_alc = false
choch_fallido_baj = false
// Dentro de un rango el CHoCH pendiente se descarta (no se dibuja ni como válido ni como ✗)
if cerrada and en_rango and not na(choch_bar)
    choch_bar := na
    tendencia := tend_previa
if cerrada and not na(choch_bar) and bar_index == choch_bar + 1
    fallido = choch_dir == 1 ? close < choch_nivel : close > choch_nivel
    col_dir = choch_dir == 1 ? color_alcista : color_bajista
    if fallido
        tendencia_invalidada := true
        dir_invalidada       := choch_dir
        nivel_invalidado     := choch_nivel
        bar_piv_invalidado   := choch_bar_piv
        texto_invalidado     := choch_texto
        bar_invalidado       := choch_bar
        lbl_invalidado       := na
        ln_invalidado        := na
        if choch_dir == 1
            choch_fallido_alc := true
        else
            choch_fallido_baj := true
        if marcar_fallidos
            [ln_f, lb_f] = dibujar_choch(choch_dir, choch_bar_piv, choch_nivel, choch_bar, "✗ " + choch_texto, "CHoCH fallido: la vela siguiente cerró de nuevo al otro lado del nivel\n" + choch_tip, color_fallido, true)
            lbl_invalidado := lb_f
            ln_invalidado  := ln_f
            registrar_marca(lb_f, ln_f, choch_bar)
        if anular_fallidos
            tendencia := tend_previa
            // Se restaura el nivel roto si no se ha formado un pivote nuevo
            if choch_dir == 1 and na(ultimo_pico)
                ultimo_pico := choch_nivel
                bar_pico    := choch_bar_piv
            if choch_dir == -1 and na(ultimo_valle)
                ultimo_valle := choch_nivel
                bar_valle    := choch_bar_piv
    else
        // CHoCH confirmado: se dibuja (sin ⚠) y se borra el BOS contrario previo
        [ln_c, lb_c] = dibujar_choch(choch_dir, choch_bar_piv, choch_nivel, choch_bar, choch_texto, choch_tip, col_dir, false)
        registrar_marca(lb_c, ln_c, choch_bar)
        borrar_bos_contrario(choch_dir, choch_bar)
    choch_bar := na

// --- REACTIVACIÓN ---
// La tendencia del CHoCH fallido vuelve a estar activa si el precio cierra de nuevo
// más allá del nivel que rompió.
// La etiqueta «✗ CHoCH» de ese nivel se convierte en CHoCH válido (no se dibuja otra).
// Va antes de las señales para que la nueva ruptura del mismo nivel no cree otro CHoCH.
reactivada_alc = false
reactivada_baj = false
if cerrada and tendencia_invalidada and not en_rango
    if dir_invalidada == 1 and close > nivel_invalidado
        reactivada_alc := true
        tendencia := 1
        if ultimo_pico == nivel_invalidado
            ultimo_pico := na
    else if dir_invalidada == -1 and close < nivel_invalidado
        reactivada_baj := true
        tendencia := -1
        if ultimo_valle == nivel_invalidado
            ultimo_valle := na
    if reactivada_alc or reactivada_baj
        tendencia_invalidada := false
        col_ok = dir_invalidada == 1 ? color_alcista : color_bajista
        if na(lbl_invalidado)
            [ln_r, lb_r] = dibujar_choch(dir_invalidada, bar_piv_invalidado, nivel_invalidado, bar_index, texto_invalidado, "CHoCH confirmado al recuperar el nivel", col_ok, false)
            registrar_marca(lb_r, ln_r, bar_index)
        else
            lbl_invalidado.set_text(texto_invalidado)
            lbl_invalidado.set_textcolor(col_ok)
            lbl_invalidado.set_tooltip("CHoCH confirmado al recuperar el nivel")
            ln_invalidado.set_color(col_ok)
            ln_invalidado.set_style(line.style_solid)
        borrar_bos_contrario(dir_invalidada, bar_index)

// ─────────────────────────────
// SEÑALES
// ─────────────────────────────
// Cruce del nivel en esta vela, o nivel ya superado dentro del rango y la vela es el breakout
cruce_arriba = cerrada and not en_rango and vol_ok and not na(ultimo_pico) and close > ultimo_pico and (close[1] <= ultimo_pico or salida_rango)
cruce_abajo  = cerrada and not en_rango and vol_ok and not na(ultimo_valle) and close < ultimo_valle and (close[1] >= ultimo_valle or salida_rango)
choch_alcista = cruce_arriba and not na(ultimo_pico) and tendencia <= 0
choch_bajista = cruce_abajo and not na(ultimo_valle) and tendencia >= 0
choch_riesgo_alc = false
choch_riesgo_baj = false

// ─────────────────────────────
// ORDER BLOCKS
// Al romper estructura se busca, entre el swing roto y la vela de ruptura:
//  - OB alcista: la vela BAJISTA con el mínimo más bajo (origen del impulso alcista).
//  - OB bajista: la vela ALCISTA con el máximo más alto (origen del impulso bajista).
// Si no hay ninguna vela de ese color, se usa la del extremo.
// ─────────────────────────────
crear_caja_ob(int dir, int idx) =>
    techo = ob_cuerpo ? math.max(open[idx], close[idx]) : high[idx]
    suelo = ob_cuerpo ? math.min(open[idx], close[idx]) : low[idx]
    col = dir == 1 ? col_ob_alc : col_ob_baj
    if pintar_velas
        // La vela del OB queda pintada con su color (no se puede recolorear una vela pasada con barcolor)
        line.new(bar_index - idx, high[idx], bar_index - idx, low[idx], color=color.new(col, 10), width=5)
    obs.push(Zona.new(bar_index - idx, techo, suelo, dir, na, bar_index))
    if obs.size() > max_ob
        obs.shift()

crear_ob(int dir, int bar_desde) =>
    n = math.min(math.max(bar_index - bar_desde, 1), 150)
    int idx = na
    float ext = na
    for i = 0 to n
        contraria = dir == 1 ? close[i] < open[i] : close[i] > open[i]
        valor = dir == 1 ? low[i] : high[i]
        if contraria and (na(ext) or (dir == 1 ? valor < ext : valor > ext))
            ext := valor
            idx := i
    if na(idx)
        for i = 0 to n
            valor = dir == 1 ? low[i] : high[i]
            if na(ext) or (dir == 1 ? valor < ext : valor > ext)
                ext := valor
                idx := i
    // Solo es OB si deja un imbalance (FVG) a continuación en la dirección del impulso.
    // El FVG empieza en la vela del OB (j = idx) o en una de las siguientes, hasta ob_imb_velas.
    hay_imbalance = false
    if idx >= 2
        for j = idx to math.max(idx - ob_imb_velas + 1, 2)
            // El imbalance tiene que superar el tamaño mínimo de FVG: un hueco de 1-2 ticks no hace relevante el OB
            if dir == 1 ? low[j - 2] - high[j] >= fvg_min_atr * nz(atr_val) and low[j - 2] > high[j] : low[j] - high[j - 2] >= fvg_min_atr * nz(atr_val) and high[j - 2] < low[j]
                hay_imbalance := true
    if hay_imbalance
        crear_caja_ob(dir, idx)

// --- ALCISTA (BUY) ---
if cruce_arriba and not na(ultimo_pico)
    if tendencia <= 0
        // El CHoCH queda pendiente: se dibuja al cierre de la vela siguiente
        [riesgo, motivos] = riesgo_choch(1, ultimo_pico)
        choch_riesgo_alc := marcar_riesgo and riesgo >= riesgo_min
        choch_bar     := bar_index
        choch_dir     := 1
        choch_nivel   := ultimo_pico
        choch_bar_piv := bar_pico
        choch_texto   := vol_top_confirm ? "🔥 CHoCH" : "CHoCH"
        choch_tip     := "Riesgo de fallo al romper: " + str.tostring(riesgo) + "/6\n" + motivos
        tend_previa   := tendencia
        tendencia_invalidada := false
    else if mostrar_bos and not tendencia_invalidada
        ultimo_bos_lbl := label.new(bar_index, high, "BOS", yloc=yloc.abovebar, style=label.style_none, textcolor=color_alcista, size=size.small)
        ultimo_bos_bar := bar_index
        ultimo_bos_dir := 1
        registrar_marca(ultimo_bos_lbl, na, bar_index)
    if mostrar_ob and (tendencia <= 0 or not ob_solo_choch)
        if en_calc
            crear_ob(1, bar_pico)
    tendencia := 1
    ultimo_pico := na 

// --- BAJISTA (SELL) ---
if cruce_abajo and not na(ultimo_valle)
    if tendencia >= 0
        // El CHoCH queda pendiente: se dibuja al cierre de la vela siguiente
        [riesgo, motivos] = riesgo_choch(-1, ultimo_valle)
        choch_riesgo_baj := marcar_riesgo and riesgo >= riesgo_min
        choch_bar     := bar_index
        choch_dir     := -1
        choch_nivel   := ultimo_valle
        choch_bar_piv := bar_valle
        choch_texto   := vol_top_confirm ? "🔥 CHoCH" : "CHoCH"
        choch_tip     := "Riesgo de fallo al romper: " + str.tostring(riesgo) + "/6\n" + motivos
        tend_previa   := tendencia
        tendencia_invalidada := false
    else if mostrar_bos and not tendencia_invalidada
        ultimo_bos_lbl := label.new(bar_index, low, "BOS", yloc=yloc.belowbar, style=label.style_none, textcolor=color_bajista, size=size.small)
        ultimo_bos_bar := bar_index
        ultimo_bos_dir := -1
        registrar_marca(ultimo_bos_lbl, na, bar_index)
    if mostrar_ob and (tendencia >= 0 or not ob_solo_choch)
        if en_calc
            crear_ob(-1, bar_valle)
    tendencia := -1
    ultimo_valle := na 

// Order Blocks vigentes: se consumen a medida que el precio los toca, igual que los FVG.
//  - OB alcista (demanda): se consume desde su máximo hacia abajo.
//  - OB bajista (oferta): se consume desde su mínimo hacia arriba.
// La parte tocada queda en gris translúcido y, cuando la mecha llega al otro extremo, desaparece.
if cerrada and obs.size() > 0
    for i = obs.size() - 1 to 0
        ob = obs.get(i)
        if ob.creado != bar_index and consumir(ob)
            obs.remove(i)

// FONDO BLANCO (sin colorear por tendencia)
bgcolor(fondo_blanco ? color.white : na)

// ─────────────────────────────
// EMAs
// ─────────────────────────────
plot(mostrar_emas ? ema_rapida : na, "EMA rápida", color=ema_rap_col, linewidth=1)
plot(mostrar_emas ? ema_media : na, "EMA media", color=ema_med_col, linewidth=1)
plot(mostrar_emas ? ema_lenta : na, "EMA lenta", color=ema_len_col, linewidth=2)

// ─────────────────────────────
// FVG
// FVG: patrón de 3 velas (low > high[2] alcista, high < low[2] bajista).
// ─────────────────────────────

// Actualizar zonas existentes antes de añadir las de esta vela.
// Consumo progresivo: la parte del hueco que el precio ya ha tocado se pinta en gris
// translúcido y la caja de color se encoge hasta lo que queda sin tocar.
//  - FVG alcista (soporte): se consume desde el techo hacia abajo.
//  - FVG bajista (resistencia): se consume desde el suelo hacia arriba.
// Cuando se consume del todo (la mecha llega al otro extremo) desaparece.
// IFVG: una sola vela atraviesa un FVG intacto entero (abre a un lado y cierra al otro).
// El FVG pasa a ser un IFVG del mismo tamaño y dirección contraria, que sigue vigente y se consume
// por partes hasta que el precio lo cubre entero en dirección contraria.
nuevo_ifvg_alc = false
nuevo_ifvg_baj = false
// Temporalidad del gráfico en el mismo formato que los letreros de M15, H1 y H4 (M5, M15, H1, D…)
tf_nombre() =>
    string r = timeframe.period
    if timeframe.isseconds
        r := "S" + str.tostring(timeframe.multiplier)
    else if timeframe.isminutes
        r := timeframe.multiplier % 60 == 0 ? "H" + str.tostring(int(timeframe.multiplier / 60)) : "M" + str.tostring(timeframe.multiplier)
    else if timeframe.isdaily
        r := timeframe.multiplier == 1 ? "D" : str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        r := timeframe.multiplier == 1 ? "W" : str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        r := timeframe.multiplier == 1 ? "MN" : str.tostring(timeframe.multiplier) + "MN"
    r
tf_graf = tf_nombre()
seg_graf = timeframe.in_seconds()
// Tamaño mínimo de un FVG de otra temporalidad de "mins" minutos
min_gap(int mins) =>
    fvg_min_atr * nz(atr_val) * math.sqrt(mins * 60.0 / math.max(seg_graf, 1))

// El FVG del propio gráfico usa el interruptor y el color de su temporalidad si es una de las 5
ver_graf = seg_graf == 60 ? mostrar_fvg1 : seg_graf == 300 ? mostrar_fvg5 : seg_graf == 900 ? mostrar_fvg15 : seg_graf == 3600 ? mostrar_fvg60 : seg_graf == 14400 ? mostrar_fvg240 : mostrar_fvg
graf_alc = seg_graf == 60 ? fvg_alc_1 : seg_graf == 300 ? fvg_alc_5 : seg_graf == 900 ? fvg_alc_15 : seg_graf == 3600 ? fvg_alc_60 : seg_graf == 14400 ? fvg_alc_240 : fvg_alc_0
graf_baj = seg_graf == 60 ? fvg_baj_1 : seg_graf == 300 ? fvg_baj_5 : seg_graf == 900 ? fvg_baj_15 : seg_graf == 3600 ? fvg_baj_60 : seg_graf == 14400 ? fvg_baj_240 : fvg_baj_0

// ─────────────────────────────
// RETESTEO DE IFVG EN LA VELA SIGUIENTE
// Avisa cuando, en alguna de las velas_retest velas posteriores a la que crea un IFVG (de cualquier
// temporalidad), el precio vuelve a tocarlo. Una sola vez por IFVG. Se comprueba en tiempo real.
// ─────────────────────────────
velas_retest = input.int(4, "Alerta de retesteo de IFVG: velas posteriores a vigilar", minval=1, maxval=20, group=g_ny)

retesteo(array<Zona> arr) =>
    toca = false
    for z in arr
        n = bar_index - z.creado
        if not z.avisado and n >= 1 and n <= velas_retest and high >= z.suelo and low <= z.techo
            z.avisado := true
            toca := true
    toca

retest_ifvg_graf = retesteo(ifvgs)

// --- FVG/IFVG de temporalidades MÁS BAJAS que el gráfico (p. ej. M5 y M1 en un gráfico de M15) ---
// Solo si su interruptor está activado. Se recorren las velas de esa temporalidad dentro de cada vela
// del gráfico con las mismas reglas (FVG de 3 velas, consumo por partes, IFVG cuando una sola vela
// atraviesa entero un FVG intacto) y se avisa si el precio toca un IFVG en las velas siguientes a su
// creación. Solo se usan velas ya cerradas, así que no repintan. El M1 también se calcula sin
// dibujarlo cuando solo está activada su alerta de retesteo.
alerta_m1 = input.bool(true, "Alerta de retesteo también para IFVG de M1 (aunque no se dibujen)", group=g_ny)

type EstadoLTF
    float h2
    float l2
    float h1
    float l1
    int   n = 0   // número de vela de esa temporalidad (para saber cuál es la siguiente a la del IFVG)

consumir_ltf(Zona z, float hi, float lo) =>
    completa = z.dir == 1 ? lo <= z.suelo : hi >= z.techo
    if not completa
        borde = na(z.borde) ? (z.dir == 1 ? z.techo : z.suelo) : z.borde
        if z.dir == 1 ? lo < borde : hi > borde
            z.borde := z.dir == 1 ? lo : hi
    completa

procesar_ltf(array<Zona> fvg, array<Zona> ifvg, EstadoLTF s, array<float> ao, array<float> ah, array<float> al, array<float> ac, int tope, float gap_min) =>
    retest = false
    if ah.size() > 0
        // En tiempo real la última vela de esa temporalidad aún no ha cerrado: solo sirve para el toque
        ultima_cerrada = barstate.isconfirmed ? ah.size() - 1 : ah.size() - 2
        for k = 0 to ah.size() - 1
            o1 = ao.get(k)
            h1 = ah.get(k)
            l1 = al.get(k)
            c1 = ac.get(k)
            for z in ifvg
                n = s.n - z.creado
                if not z.avisado and n >= 1 and n <= velas_retest and h1 >= z.suelo and l1 <= z.techo
                    if k <= ultima_cerrada
                        z.avisado := true
                    retest := true
            if k <= ultima_cerrada
                if ifvg.size() > 0
                    for i = ifvg.size() - 1 to 0
                        if consumir_ltf(ifvg.get(i), h1, l1)
                            ifvg.remove(i)
                if fvg.size() > 0
                    for i = fvg.size() - 1 to 0
                        z = fvg.get(i)
                        inv = na(z.borde) and (z.dir == 1 ? (o1 >= z.techo and c1 < z.suelo) : (o1 <= z.suelo and c1 > z.techo))
                        if inv
                            fvg.remove(i)
                            ifvg.push(Zona.new(z.x1, z.techo, z.suelo, -z.dir, na, s.n))
                            if ifvg.size() > tope
                                ifvg.shift()
                        else if consumir_ltf(z, h1, l1)
                            fvg.remove(i)
                if not na(s.h2)
                    if l1 > s.h2 and l1 - s.h2 >= gap_min
                        fvg.push(Zona.new(bar_index, l1, s.h2, 1))
                    else if h1 < s.l2 and s.l2 - h1 >= gap_min
                        fvg.push(Zona.new(bar_index, s.l2, h1, -1))
                    if fvg.size() > tope
                        fvg.shift()
                s.h2 := s.h1
                s.l2 := s.l1
                s.h1 := h1
                s.l1 := l1
                s.n  := s.n + 1
    retest

var est1   = EstadoLTF.new()
var est5   = EstadoLTF.new()
var est15  = EstadoLTF.new()
var est60  = EstadoLTF.new()
var est240 = EstadoLTF.new()
// Solo se piden las velas de una temporalidad más baja si hace falta (si no, se pide la del gráfico)
usa1   = timeframe.isintraday and ((mostrar_fvg1 and not solo_su_graf) or alerta_m1) and seg_graf > 60
usa5   = timeframe.isintraday and mostrar_fvg5 and not solo_su_graf and seg_graf > 300
usa15  = timeframe.isintraday and mostrar_fvg15 and not solo_su_graf and seg_graf > 900
usa60  = timeframe.isintraday and mostrar_fvg60 and not solo_su_graf and seg_graf > 3600
usa240 = mostrar_fvg240 and not solo_su_graf and seg_graf > 14400

// Retesteo de IFVG: los de temporalidades más altas se vigilan con las velas del gráfico y los de
// temporalidades más bajas, vela a vela de su temporalidad dentro de procesar_ltf. Las velas de una
// temporalidad más baja solo se piden si su interruptor está activado y dentro de las velas a calcular.
// TradingView revisa todas las peticiones aunque no se ejecuten: si la temporalidad no es más baja que
// la del gráfico se pide la del propio gráfico (nunca se usa) para que no dé error.
retest_ifvg_m1 = false
if usa1 and en_calc
    [o_, h_, l_, c_] = request.security_lower_tf(syminfo.tickerid, usa1 ? "1" : timeframe.period, [open, high, low, close])
    retest_ifvg_m1 := procesar_ltf(fvg1, ifvg1, est1, o_, h_, l_, c_, 30, min_gap(1))
retest_ifvg_m5 = false
if seg_graf < 300
    retest_ifvg_m5 := retesteo(ifvg5)
else if usa5 and en_calc
    [o_, h_, l_, c_] = request.security_lower_tf(syminfo.tickerid, usa5 ? "5" : timeframe.period, [open, high, low, close])
    retest_ifvg_m5 := procesar_ltf(fvg5, ifvg5, est5, o_, h_, l_, c_, max_htf, min_gap(5))
retest_ifvg_m15 = false
if seg_graf < 900
    retest_ifvg_m15 := retesteo(ifvg15)
else if usa15 and en_calc
    [o_, h_, l_, c_] = request.security_lower_tf(syminfo.tickerid, usa15 ? "15" : timeframe.period, [open, high, low, close])
    retest_ifvg_m15 := procesar_ltf(fvg15, ifvg15, est15, o_, h_, l_, c_, max_htf, min_gap(15))
retest_ifvg_h1 = false
if seg_graf < 3600
    retest_ifvg_h1 := retesteo(ifvg60)
else if usa60 and en_calc
    [o_, h_, l_, c_] = request.security_lower_tf(syminfo.tickerid, usa60 ? "60" : timeframe.period, [open, high, low, close])
    retest_ifvg_h1 := procesar_ltf(fvg60, ifvg60, est60, o_, h_, l_, c_, max_htf, min_gap(60))
retest_ifvg_h4 = false
if seg_graf < 14400
    retest_ifvg_h4 := retesteo(ifvg240)
else if usa240 and en_calc
    [o_, h_, l_, c_] = request.security_lower_tf(syminfo.tickerid, usa240 ? "240" : timeframe.period, [open, high, low, close])
    retest_ifvg_h4 := procesar_ltf(fvg240, ifvg240, est240, o_, h_, l_, c_, max_htf, min_gap(240))

retest_ifvg      = retest_ifvg_graf or retest_ifvg_m1 or retest_ifvg_m5 or retest_ifvg_m15 or retest_ifvg_h1 or retest_ifvg_h4
if retest_ifvg
    tfs = (retest_ifvg_m1 ? " M1" : "") + (retest_ifvg_m5 ? " M5" : "") + (retest_ifvg_graf ? " " + tf_graf : "") + (retest_ifvg_m15 ? " M15" : "") + (retest_ifvg_h1 ? " H1" : "") + (retest_ifvg_h4 ? " H4" : "")
    alert("Retesteo de IFVG (" + str.trim(tfs) + ") en " + syminfo.ticker + " a " + str.tostring(close), alert.freq_once_per_bar)

if cerrada and ifvgs.size() > 0
    for i = ifvgs.size() - 1 to 0
        if consumir(ifvgs.get(i))
            ifvgs.remove(i)

if cerrada and zonas.size() > 0
    for i = zonas.size() - 1 to 0
        z = zonas.get(i)
        // Solo FVG intactos: si ya se había mitigado en parte, no puede pasar a IFVG
        invertida = na(z.borde) and (z.dir == 1 ? (open >= z.techo and close < z.suelo) : (open <= z.suelo and close > z.techo))
        if invertida
            zonas.remove(i)
            if z.dir == 1
                nuevo_ifvg_baj := true
            else
                nuevo_ifvg_alc := true
            ifvgs.push(Zona.new(z.x1, z.techo, z.suelo, -z.dir, na, bar_index))
            if ifvgs.size() > max_zonas
                ifvgs.shift()
        else if consumir(z)
            zonas.remove(i)

fvg_alcista = cerrada and low > high[2] and (low - high[2]) >= fvg_min_atr * nz(atr_val)
fvg_bajista = cerrada and high < low[2] and (low[2] - high) >= fvg_min_atr * nz(atr_val)

agregar_fvg(float techo, float suelo, int dir) =>
    zonas.push(Zona.new(bar_index - 2, techo, suelo, dir))
    if zonas.size() > max_zonas
        zonas.shift()

if fvg_alcista
    agregar_fvg(low, high[2], 1)
else if fvg_bajista
    agregar_fvg(low[2], high, -1)

// ─────────────────────────────
// ESTRATEGIA NY (Bias + PO3)
//  Paso 1 (Bias): niveles clave = altos/bajos relevantes (H4 y día anterior).
//  Paso 2 (PO3): horas de Madrid 15:00, 15:30, 15:45 y 16:00 y FVG de M15 y H1
//                con su 50%, que es donde se espera la manipulación.
//  SL: debajo del FVG en compras, encima del FVG en ventas.
// ─────────────────────────────
seg_tf = timeframe.in_seconds()

// --- Horas de Madrid ---
// Verano: 15:00 / 15:30 / 15:45 / 16:00. Invierno: una hora antes (14:00 / 14:30 / 14:45 / 15:00).
// Automático: se sigue la apertura de Nueva York (9:00 / 9:30 / 9:45 / 10:00 en Nueva York) y la
// marca muestra la hora de Madrid que corresponda, así también acierta en las semanas en que
// Europa y Estados Unidos cambian de hora en fechas distintas.
es_auto     = str.startswith(modo_horas, "Automático")
es_invierno = str.startswith(modo_horas, "Invierno")
zona_marcas = es_auto ? "America/New_York" : "Europe/Madrid"
base_marcas = es_auto ? 9 * 60 : es_invierno ? 14 * 60 : 15 * 60   // primera marca, en minutos
mins_mad = hour(time, zona_marcas) * 60 + minute(time, zona_marcas)
prev_mad = nz(mins_mad[1], mins_mad)
cruza_hora(int objetivo) =>
    mins_mad >= objetivo and (prev_mad < objetivo or prev_mad > mins_mad)

// Texto de la marca: la hora de Madrid del momento marcado (p. ej. «14:30» en invierno)
texto_hora(int objetivo) =>
    es_auto ? str.format_time(time - (mins_mad - objetivo) * 60000, "HH:mm", "Europe/Madrid") : str.format("{0,number,00}:{1,number,00}", int(objetivo / 60), objetivo % 60)

marcar_hora(string txt, bool fuerte) =>
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.new(col_horas, fuerte ? 30 : 60), style=fuerte ? line.style_dashed : line.style_dotted, width=1)
    label.new(bar_index, high, txt, yloc=yloc.abovebar, style=label.style_none, textcolor=color.new(col_horas, 10), size=size.tiny)

if mostrar_horas and timeframe.isintraday and seg_tf <= 900
    if cruza_hora(base_marcas)
        marcar_hora(texto_hora(base_marcas), false)
    if cruza_hora(base_marcas + 30)
        marcar_hora(texto_hora(base_marcas + 30), false)
    if cruza_hora(base_marcas + 45)
        marcar_hora(texto_hora(base_marcas + 45), false)
    if cruza_hora(base_marcas + 60)
        marcar_hora(texto_hora(base_marcas + 60), true)

// --- FVG de M15, H1 y H4 (sin repintado: se evalúa la última vela cerrada de esa temporalidad) ---
// La petición se hace solo cuando hace falta (al cambiar de vela de esa temporalidad, con su
// interruptor activado y dentro de las velas a calcular): así no cuesta tiempo el resto del historial.
fvg_htf() =>
    [low[1] > high[3], high[1] < low[3], low[1], high[3], high[1], low[3], time[3]]


// Vela (bar_index) en la que empieza una zona de otra temporalidad, a partir de su hora
vela_de(int t) =>
    int k = 0
    while k < 1500 and time[k] > t
        k += 1
    bar_index - k

nueva_htf(array<Zona> arr, float techo, float suelo, int dir, int t_izq, int mins) =>
    if techo - suelo >= min_gap(mins)
        z = Zona.new(vela_de(t_izq), techo, suelo, dir)
        // El FVG de M15/H1/H4 se conoce al cerrar su vela, pero se crea en la primera vela del gráfico
        // de la siguiente: esa vela también puede haber entrado ya en el hueco, así que se consume ya
        // con ella (antes se la saltaba y el FVG quedaba sin consumir aunque el precio hubiera pasado)
        if not consumir(z)
            arr.push(z)
            if arr.size() > max_htf
                arr.shift()

// Consumo progresivo igual que el resto de zonas. Devuelve si el precio tocó el 50% de alguna.
// Misma regla de IFVG que en el gráfico: una sola vela atraviesa entero un FVG intacto (abre a un
// lado y cierra al otro) y lo convierte en IFVG de su misma temporalidad, que se consume por partes.
actualizar_htf(array<Zona> arr, array<Zona> arr_ifvg) =>
    toque = false
    if arr_ifvg.size() > 0
        for i = arr_ifvg.size() - 1 to 0
            if consumir(arr_ifvg.get(i))
                arr_ifvg.remove(i)
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            z = arr.get(i)
            mitad = (z.techo + z.suelo) / 2
            if low <= mitad and high >= mitad
                toque := true
            invertida = na(z.borde) and (z.dir == 1 ? (open >= z.techo and close < z.suelo) : (open <= z.suelo and close > z.techo))
            if invertida
                arr.remove(i)
                arr_ifvg.push(Zona.new(z.x1, z.techo, z.suelo, -z.dir, na, bar_index))
                if arr_ifvg.size() > max_htf
                    arr_ifvg.shift()
            else if consumir(z)
                arr.remove(i)
    toque

cambio5   = timeframe.change("5")
cambio15  = timeframe.change("15")
cambio60  = timeframe.change("60")
cambio240 = timeframe.change("240")
toque50_m5  = false
toque50_m15 = false
toque50_h1  = false
toque50_h4  = false
if cerrada and timeframe.isintraday and en_calc
    if mostrar_fvg5 and not solo_su_graf and seg_tf < 300
        toque50_m5 := actualizar_htf(fvg5, ifvg5)
        if cambio5
            [a5, b5, a5_top, a5_bot, b5_bot, b5_top, t5] = request.security(syminfo.tickerid, "5", fvg_htf(), lookahead = barmerge.lookahead_on)
            if a5
                nueva_htf(fvg5, a5_top, a5_bot, 1, t5, 5)
            else if b5
                nueva_htf(fvg5, b5_top, b5_bot, -1, t5, 5)
    if mostrar_fvg15 and not solo_su_graf and seg_tf < 900
        toque50_m15 := actualizar_htf(fvg15, ifvg15)
        if cambio15
            [a15, b15, a15_top, a15_bot, b15_bot, b15_top, t15] = request.security(syminfo.tickerid, "15", fvg_htf(), lookahead = barmerge.lookahead_on)
            if a15
                nueva_htf(fvg15, a15_top, a15_bot, 1, t15, 15)
            else if b15
                nueva_htf(fvg15, b15_top, b15_bot, -1, t15, 15)
    if mostrar_fvg60 and not solo_su_graf and seg_tf < 3600
        toque50_h1 := actualizar_htf(fvg60, ifvg60)
        if cambio60
            [a60, b60, a60_top, a60_bot, b60_bot, b60_top, t60] = request.security(syminfo.tickerid, "60", fvg_htf(), lookahead = barmerge.lookahead_on)
            if a60
                nueva_htf(fvg60, a60_top, a60_bot, 1, t60, 60)
            else if b60
                nueva_htf(fvg60, b60_top, b60_bot, -1, t60, 60)
    if mostrar_fvg240 and not solo_su_graf and seg_tf < 14400
        toque50_h4 := actualizar_htf(fvg240, ifvg240)
        if cambio240
            [a240, b240, a240_top, a240_bot, b240_bot, b240_top, t240] = request.security(syminfo.tickerid, "240", fvg_htf(), lookahead = barmerge.lookahead_on)
            if a240
                nueva_htf(fvg240, a240_top, a240_bot, 1, t240, 240)
            else if b240
                nueva_htf(fvg240, b240_top, b240_bot, -1, t240, 240)

// --- Niveles clave: altos y bajos relevantes de H4 (vigentes hasta que un cierre los rompe) ---
type Nivel
    line  ln
    label lb
    float precio
    int   dir    // 1 = alto relevante, -1 = bajo relevante

var niveles_h4 = array.new<Nivel>()

piv_h4() =>
    [ta.pivothigh(high, piv_h4_len, piv_h4_len)[1], ta.pivotlow(low, piv_h4_len, piv_h4_len)[1], time[1 + piv_h4_len]]

[ph4, pl4, tp4] = request.security(syminfo.tickerid, "240", piv_h4(), lookahead = barmerge.lookahead_on)

nuevo_nivel(float precio, int dir, int t_izq) =>
    ln = line.new(t_izq, precio, time, precio, xloc=xloc.bar_time, color=color.new(col_niveles, 20), width=1)
    lb = label.new(time, precio, dir == 1 ? "Alto H4" : "Bajo H4", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.new(col_niveles, 10), size=size.tiny)
    niveles_h4.push(Nivel.new(ln, lb, precio, dir))
    if niveles_h4.size() > max_niv_h4
        n = niveles_h4.shift()
        n.ln.delete()
        n.lb.delete()

if cerrada and mostrar_niv_h4 and timeframe.isintraday and seg_tf < 14400
    if niveles_h4.size() > 0
        for i = niveles_h4.size() - 1 to 0
            n = niveles_h4.get(i)
            if (n.dir == 1 and close > n.precio) or (n.dir == -1 and close < n.precio)
                // Nivel roto por cierre: deja de ser vigente y se borra
                n.ln.delete()
                n.lb.delete()
                niveles_h4.remove(i)
            else
                n.ln.set_x2(time)
                n.lb.set_x(time)
    if cambio240
        if not na(ph4)
            nuevo_nivel(ph4, 1, tp4)
        if not na(pl4)
            nuevo_nivel(pl4, -1, tp4)

// --- Niveles clave: alto y bajo del día anterior ---
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
ver_pd = mostrar_pd and timeframe.isintraday and not timeframe.change("D")
plot(ver_pd ? pdh : na, "Alto día anterior", color=color.new(col_niveles, 30), style=plot.style_linebr, linewidth=1)
plot(ver_pd ? pdl : na, "Bajo día anterior", color=color.new(col_niveles, 30), style=plot.style_linebr, linewidth=1)

// --- Línea del 50 % del día anterior: por encima = premium (caro), por debajo = descuento (barato) ---
plot(info_eq and timeframe.isintraday and not timeframe.change("D") ? (pdh + pdl) / 2 : na, "50 % día anterior", color=color.new(#7E57C2, 25), style=plot.style_linebr, linewidth=1)

// --- Sesiones (hora de Nueva York): Asia 20:00-00:00, Londres 02:00-05:00, apertura NY 09:30-11:00 ---
ses_ok  = timeframe.isintraday and seg_graf <= 3600
en_asia = ses_ok and not na(time(timeframe.period, "2000-0000", "America/New_York"))
en_lon  = ses_ok and not na(time(timeframe.period, "0200-0500", "America/New_York"))
en_nyk  = ses_ok and not na(time(timeframe.period, "0930-1100", "America/New_York"))
bgcolor(info_killzone ? (en_asia ? color.new(#7E57C2, 94) : en_lon ? color.new(#1E88E5, 94) : en_nyk ? color.new(#F9A825, 90) : na) : na, title="Sesiones")

var float asia_h = na
var float asia_l = na
var float lon_h  = na
var float lon_l  = na
var bool  asia_bh = false   // alto de Asia ya barrido
var bool  asia_bl = false
var bool  lon_bh  = false
var bool  lon_bl  = false
if en_asia
    if not en_asia[1]
        asia_h  := high
        asia_l  := low
        asia_bh := false
        asia_bl := false
    else
        asia_h := math.max(asia_h, high)
        asia_l := math.min(asia_l, low)
else if not na(asia_h)
    asia_bh := asia_bh or high > asia_h
    asia_bl := asia_bl or low < asia_l
if en_lon
    if not en_lon[1]
        lon_h  := high
        lon_l  := low
        lon_bh := false
        lon_bl := false
    else
        lon_h := math.max(lon_h, high)
        lon_l := math.min(lon_l, low)
else if not na(lon_h)
    lon_bh := lon_bh or high > lon_h
    lon_bl := lon_bl or low < lon_l

// --- Barridos: la vela pasa un nivel relevante y cierra de vuelta al otro lado (manipulación) ---
var array<bool>  barrido_hecho = array.new<bool>(6, false)
var array<label> barrido_lbls  = array.new<label>()
if timeframe.change("D")
    barrido_hecho.fill(false)
if en_asia and not en_asia[1]
    barrido_hecho.set(2, false)
    barrido_hecho.set(3, false)
if en_lon and not en_lon[1]
    barrido_hecho.set(4, false)
    barrido_hecho.set(5, false)
if info_barridos and cerrada and ses_ok and en_calc
    for k = 0 to 5
        // 0-1 día anterior, 2-3 Asia (ya cerrada), 4-5 Londres (ya cerrada); pares = altos, impares = bajos
        nv = k == 0 ? pdh : k == 1 ? pdl : k == 2 ? asia_h : k == 3 ? asia_l : k == 4 ? lon_h : lon_l
        vale = k < 2 or (k < 4 ? not en_asia : not en_lon)
        alto = k % 2 == 0
        if vale and not na(nv) and not barrido_hecho.get(k) and (alto ? high > nv and close < nv : low < nv and close > nv)
            barrido_hecho.set(k, true)
            nom = (k < 2 ? (alto ? "PDH" : "PDL") : k < 4 ? (alto ? "Alto Asia" : "Bajo Asia") : (alto ? "Alto Londres" : "Bajo Londres"))
            barrido_lbls.push(label.new(bar_index, alto ? high : low, "Barrido " + nom, style=alto ? label.style_label_down : label.style_label_up, color=color.new(color.white, 100), textcolor=#6A1B9A, size=size.tiny))
            if barrido_lbls.size() > 20
                barrido_lbls.shift().delete()

// --- Altos y bajos iguales sin barrer (EQH / EQL): dos pivotes casi al mismo precio = liquidez ---
type Igual
    line  ln
    label lb
    float precio
    int   dir   // 1 = altos iguales, -1 = bajos iguales
var array<Igual> iguales = array.new<Igual>()
var float eq_ph = na
var int   eq_phx = na
var float eq_pl = na
var int   eq_plx = na
eq_tol = nz(atr_val) * 0.1
ph_eq = ta.pivothigh(high, periodo, periodo)
pl_eq = ta.pivotlow(low, periodo, periodo)
if info_eqhl and en_calc and timeframe.isintraday
    if not na(ph_eq)
        x = bar_index - periodo
        if not na(eq_ph) and math.abs(ph_eq - eq_ph) <= eq_tol and x - eq_phx <= 150
            nv = math.max(ph_eq, eq_ph)
            iguales.push(Igual.new(line.new(eq_phx, nv, bar_index, nv, color=color.new(#6A1B9A, 20), style=line.style_dotted, width=1), label.new(eq_phx, nv, "EQH", style=label.style_label_down, color=color.new(color.white, 100), textcolor=#6A1B9A, size=size.tiny), nv, 1))
        eq_ph  := ph_eq
        eq_phx := x
    if not na(pl_eq)
        x = bar_index - periodo
        if not na(eq_pl) and math.abs(pl_eq - eq_pl) <= eq_tol and x - eq_plx <= 150
            nv = math.min(pl_eq, eq_pl)
            iguales.push(Igual.new(line.new(eq_plx, nv, bar_index, nv, color=color.new(#6A1B9A, 20), style=line.style_dotted, width=1), label.new(eq_plx, nv, "EQL", style=label.style_label_up, color=color.new(color.white, 100), textcolor=#6A1B9A, size=size.tiny), nv, -1))
        eq_pl  := pl_eq
        eq_plx := x
    if iguales.size() > 8
        q = iguales.shift()
        q.ln.delete()
        q.lb.delete()
    // Se alargan hasta la vela actual y desaparecen cuando el precio las barre
    if iguales.size() > 0
        for i = iguales.size() - 1 to 0
            q = iguales.get(i)
            if q.dir == 1 ? high > q.precio : low < q.precio
                q.ln.delete()
                q.lb.delete()
                iguales.remove(i)
            else
                q.ln.set_x2(bar_index)

// ─────────────────────────────
// SMT: DIVERGENCIAS ENTRE ÍNDICES (basado en "SMT Divergences [LuxAlgo]" © LuxAlgo, CC BY-NC-SA 4.0)
// Mejoras sobre el original:
//  - El original solo detectaba SMT si el otro índice marcaba su pivote EXACTAMENTE en la misma vela;
//    aquí se toma el máximo/mínimo del otro índice en la misma ventana del pivote (± N velas), así no
//    se pierden las SMT con un desfase de 1-2 velas.
//  - El original perdía la referencia tras un pivote sin pareja; aquí siempre se compara con el pivote
//    anterior del gráfico, y solo si está cerca (máx. velas configurable), para evitar SMT sin sentido.
//  - Cuenta también los dobles techos/suelos (igualar el alto sin superarlo es "no confirmar").
//  - Solo se marca al cierre de la vela (sin repintado) y el número de marcas está limitado.
//  - Una sola etiqueta por SMT con el estilo del original (caja de color y texto blanco) y el ticker
//    de los activos que divergen. Alertas incluidas. Se ignora el activo si es el mismo del gráfico.
// ─────────────────────────────
g_smt        = "SMT (divergencias entre índices)"
mostrar_smt  = input.bool(false, "Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)", group=g_smt)
smt_etiquetas = input.bool(true, "Mostrar etiquetas de la SMT", group=g_smt)
smt_linea    = input.bool(true, "Mostrar línea de la SMT", group=g_smt)
smt_usa1     = input.bool(true, "Comparar con", inline="smt1", group=g_smt)
smt_sym1     = input.symbol("CME_MINI:ES1!", "", inline="smt1", group=g_smt)
smt_usa2     = input.bool(true, "Comparar con", inline="smt2", group=g_smt)
smt_sym2     = input.symbol("CBOT_MINI:YM1!", "", inline="smt2", group=g_smt)
smt_len      = input.int(5, "Sensibilidad pivotes SMT (velas a cada lado)", minval=2, maxval=20, group=g_smt)
smt_dist     = input.int(60, "Máx. velas entre los dos altos/bajos comparados", minval=5, maxval=400, group=g_smt)
smt_max      = input.int(20, "Máx. SMT en el gráfico", minval=1, maxval=60, group=g_smt)
smt_col_baj  = input.color(#ff1100, "SMT bajista (en altos)", group=g_smt)
smt_col_alc  = input.color(#2157f3, "SMT alcista (en bajos)", group=g_smt)

// Ticker de un símbolo: "CME_MINI:ES1!" -> "ES1!" (el que se muestra en la etiqueta)
smt_ticker(string s) =>
    partes = str.split(s, ":")
    partes.size() > 0 ? partes.last() : s

smt_t1  = smt_ticker(smt_sym1)
smt_t2  = smt_ticker(smt_sym2)
smt_n1  = str.replace(smt_t1, "1!", "")
smt_n2  = str.replace(smt_t2, "1!", "")
smt_yo  = str.replace(syminfo.ticker, "1!", "")
smt_ok1 = mostrar_smt and smt_usa1 and smt_n1 != smt_yo
smt_ok2 = mostrar_smt and smt_usa2 and smt_n2 != smt_yo

// Extremo del otro índice en la ventana del pivote (las 2N+1 velas centradas en él) y cuántas velas
// atrás lo hizo, para poder marcar la vela exacta
smt_ext() =>
    w = 2 * smt_len + 1
    [ta.highest(high, w), ta.lowest(low, w), ta.highestbars(high, w), ta.lowestbars(low, w)]
float smt_h1  = na
float smt_l1  = na
int   smt_hb1 = na
int   smt_lb1 = na
float smt_h2  = na
float smt_l2  = na
int   smt_hb2 = na
int   smt_lb2 = na
// Los datos de ES/YM solo se piden si la SMT está activada y dentro de las velas a calcular
if smt_ok1 and en_calc
    [h_, l_, hb_, lb_] = request.security(smt_sym1, timeframe.period, smt_ext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    smt_h1  := h_
    smt_l1  := l_
    smt_hb1 := hb_
    smt_lb1 := lb_
if smt_ok2 and en_calc
    [h_, l_, hb_, lb_] = request.security(smt_sym2, timeframe.period, smt_ext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    smt_h2  := h_
    smt_l2  := l_
    smt_hb2 := hb_
    smt_lb2 := lb_

smt_ph = ta.pivothigh(high, smt_len, smt_len)
smt_pl = ta.pivotlow(low, smt_len, smt_len)
smt_x  = bar_index - smt_len

// Pivote anterior del gráfico y valor de cada índice en ese pivote
var int   smt_ph_x  = na
var float smt_ph_y  = na
var float smt_ph_c1 = na
var float smt_ph_c2 = na
var int   smt_pl_x  = na
var float smt_pl_y  = na
var float smt_pl_c1 = na
var float smt_pl_c2 = na
var array<line>  smt_lineas = array.new<line>()
var array<label> smt_textos = array.new<label>()

// true si uno hace un alto más alto (bajo más bajo) y el otro no lo confirma
smt_diverge(float y, float y_ant, float c, float c_ant, bool altos) =>
    nuevo_y = altos ? y > y_ant : y < y_ant
    nuevo_c = altos ? c > c_ant : c < c_ant
    not na(y_ant) and not na(c_ant) and not na(c) and nuevo_y != nuevo_c

// Ticker + flecha: dónde quedó el otro índice respecto a su alto/bajo anterior
//   ↑ = más alto que antes, ↓ = más bajo que antes, = = igual
smt_texto(string t, float c, float c_ant) =>
    t + (c > c_ant ? " ↑" : c < c_ant ? " ↓" : " =")

smt_marcar(int x1, float y1, int xv, string txt, color col, bool altos) =>
    // xv = vela exacta de la divergencia: el alto/bajo de MNQ si fue él quien barrió, o la vela en la
    // que el otro índice hizo su alto/bajo si fue el otro el que barrió y MNQ no le acompañó
    yv = altos ? high[bar_index - xv] : low[bar_index - xv]
    if smt_linea
        smt_lineas.push(line.new(x1, y1, xv, yv, color=col))
    if smt_etiquetas
        smt_textos.push(label.new(xv, yv, txt, style=altos ? label.style_label_down : label.style_label_up, color=col, textcolor=color.white, size=size.tiny, tooltip="SMT " + (altos ? "bajista" : "alcista") + ". Flecha = dónde quedó ese índice respecto a su " + (altos ? "alto" : "bajo") + " anterior: ↑ más alto, ↓ más bajo, = igual"))
    if smt_lineas.size() > smt_max
        smt_lineas.shift().delete()
    if smt_textos.size() > smt_max
        smt_textos.shift().delete()

var int smt_ult_bar = na
var int smt_ult_dir = 0
smt_bajista = false
smt_alcista = false
if barstate.isconfirmed
    if not na(smt_ph)
        cerca = not na(smt_ph_x) and smt_x - smt_ph_x <= smt_dist
        d1 = cerca and smt_ok1 and smt_diverge(smt_ph, smt_ph_y, smt_h1, smt_ph_c1, true)
        d2 = cerca and smt_ok2 and smt_diverge(smt_ph, smt_ph_y, smt_h2, smt_ph_c2, true)
        if d1 or d2
            smt_bajista := true
            smt_ult_bar := bar_index
            smt_ult_dir := -1
            mnq_barre = smt_ph > smt_ph_y
            xv = mnq_barre ? smt_x : bar_index + int(d1 ? smt_hb1 : smt_hb2)
            t1 = smt_texto(smt_t1, smt_h1, smt_ph_c1)
            t2 = smt_texto(smt_t2, smt_h2, smt_ph_c2)
            smt_marcar(smt_ph_x, smt_ph_y, xv, d1 and d2 ? t1 + " | " + t2 : d1 ? t1 : t2, smt_col_baj, true)
        smt_ph_x  := smt_x
        smt_ph_y  := smt_ph
        smt_ph_c1 := smt_h1
        smt_ph_c2 := smt_h2
    if not na(smt_pl)
        cerca = not na(smt_pl_x) and smt_x - smt_pl_x <= smt_dist
        d1 = cerca and smt_ok1 and smt_diverge(smt_pl, smt_pl_y, smt_l1, smt_pl_c1, false)
        d2 = cerca and smt_ok2 and smt_diverge(smt_pl, smt_pl_y, smt_l2, smt_pl_c2, false)
        if d1 or d2
            smt_alcista := true
            smt_ult_bar := bar_index
            smt_ult_dir := 1
            mnq_barre = smt_pl < smt_pl_y
            xv = mnq_barre ? smt_x : bar_index + int(d1 ? smt_lb1 : smt_lb2)
            t1 = smt_texto(smt_t1, smt_l1, smt_pl_c1)
            t2 = smt_texto(smt_t2, smt_l2, smt_pl_c2)
            smt_marcar(smt_pl_x, smt_pl_y, xv, d1 and d2 ? t1 + " | " + t2 : d1 ? t1 : t2, smt_col_alc, false)
        smt_pl_x  := smt_x
        smt_pl_y  := smt_pl
        smt_pl_c1 := smt_l1
        smt_pl_c2 := smt_l2

// ─────────────────────────────
// DIBUJO DE ZONAS SIN SOLAPES
// Cada zona se dibuja solo donde no la tapa otra de más prioridad, así nunca se mezclan colores:
//   IFVG > FVG del gráfico > OB > IFVG/FVG M15 > IFVG/FVG H1 > IFVG/FVG H4 > rangos
// Dentro del mismo tipo, la más reciente va encima. Ejemplo: un FVG M15 dentro de un FVG H4 se ve
// con su color, y el H4 solo se ve por encima y por debajo de él.
// La parte ya consumida de cada zona se ve en gris y también ocupa su sitio.
// ─────────────────────────────
type Pieza
    int   x1
    int   x2
    float top
    float bot
    int   dir = 0   // en las zonas ya dibujadas: 1 alcista, -1 bajista (para separar las contrarias)

var array<box>   dib_cajas  = array.new<box>()
var array<line>  dib_lineas = array.new<line>()
var array<label> dib_letreros = array.new<label>()
// Las cajas, líneas y letreros se reutilizan de un dibujo al siguiente (solo se mueven y se cambia su
// color) en vez de borrarlos y crearlos de nuevo: crear cientos de objetos en cada actualización es
// lo que más tiempo cuesta. uso = cuántos de cada tipo lleva usados el dibujo actual.
var array<int> uso = array.from(0, 0, 0)

poner_caja(int x1, float top, int x2, float bot, color col) =>
    i = uso.get(0)
    if i < dib_cajas.size()
        b = dib_cajas.get(i)
        b.set_lefttop(x1, top)
        b.set_rightbottom(x2, bot)
        b.set_bgcolor(col)
    else
        dib_cajas.push(box.new(x1, top, x2, bot, border_color=na, bgcolor=col))
    uso.set(0, i + 1)

poner_linea(int x1, int x2, float y, color col) =>
    i = uso.get(1)
    if i < dib_lineas.size()
        l = dib_lineas.get(i)
        l.set_xy1(x1, y)
        l.set_xy2(x2, y)
        l.set_color(col)
    else
        dib_lineas.push(line.new(x1, y, x2, y, color=col, style=line.style_dashed, width=1))
    uso.set(1, i + 1)

poner_letrero(int x, float y, string txt, color col) =>
    i = uso.get(2)
    if i < dib_letreros.size()
        e = dib_letreros.get(i)
        e.set_xy(x, y)
        e.set_text(txt)
        e.set_textcolor(col)
    else
        dib_letreros.push(label.new(x, y, txt, style=label.style_label_right, color=color.new(color.white, 100), textcolor=col, size=size.tiny))
    uso.set(2, i + 1)

// Letreros pendientes de colocar (se colocan todos juntos al final para que no se monten)
type Letrero
    int    x
    float  y
    string txt
    color  col
    bool   derecha   // true = letrero del final (termina en x); false = del principio (empieza en x)
    bool   fondo     // true = letrero blanco sobre el color de la zona (FVG)

var array<Letrero> letreros = array.new<Letrero>()
// Separación vertical mínima entre letreros cercanos, en precio
sep_letrero = nz(ta.atr(50)) * 0.5
// Hueco entre una zona alcista y una bajista que se tocan, para que no parezcan una sola
sep_pct     = input.float(8.0, "Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)", minval=0, maxval=50, step=1, group=g_col)
sep_zonas   = nz(ta.atr(50)) * sep_pct / 100

var array<Pieza> ocupado    = array.new<Pieza>()

// Rectángulo p menos el rectángulo o: hasta 4 trozos (izquierda, derecha, arriba y abajo)
restar(Pieza p, Pieza o) =>
    out = array.new<Pieza>()
    if o.x2 <= p.x1 or o.x1 >= p.x2 or o.bot >= p.top or o.top <= p.bot
        out.push(p)
    else
        if o.x1 > p.x1
            out.push(Pieza.new(p.x1, o.x1, p.top, p.bot))
        if o.x2 < p.x2
            out.push(Pieza.new(o.x2, p.x2, p.top, p.bot))
        cx1 = math.max(p.x1, o.x1)
        cx2 = math.min(p.x2, o.x2)
        if o.top < p.top
            out.push(Pieza.new(cx1, cx2, p.top, o.top))
        if o.bot > p.bot
            out.push(Pieza.new(cx1, cx2, o.bot, p.bot))
    out

// Trozos de p que no tapa ninguna zona ya dibujada
recortar(Pieza p) =>
    res = array.from(p)
    if sin_solape and ocupado.size() > 0
        for o in ocupado
            // Solo cuentan las zonas que de verdad se cruzan con esta (ahorra cálculo)
            if not (o.x2 <= p.x1 or o.x1 >= p.x2 or o.bot >= p.top or o.top <= p.bot)
                nuevo = array.new<Pieza>()
                for q in res
                    for r in restar(q, o)
                        nuevo.push(r)
                res := nuevo
                // Tapada del todo, o demasiados trozos: no hace falta seguir recortando
                if res.size() == 0 or res.size() > 10
                    break
    res

pintar_parte(Pieza p, color col, int dir) =>
    for q in recortar(p)
        top = q.top
        bot = q.bot
        // Si toca una zona de dirección contraria ya dibujada, se deja un pequeño hueco en ese borde
        if sep_zonas > 0 and dir != 0
            for o in ocupado
                if o.dir == -dir and not (o.x2 <= q.x1 or o.x1 >= q.x2)
                    if math.abs(top - o.bot) <= sep_zonas
                        top := math.min(top, o.bot - sep_zonas)
                    if math.abs(bot - o.top) <= sep_zonas
                        bot := math.max(bot, o.top + sep_zonas)
        // Tope de cajas para no superar el límite de TradingView (500): se dibujan antes las de más prioridad
        if q.x2 > q.x1 and top > bot and uso.get(0) < 440
            poner_caja(q.x1, top, q.x2, bot, col)

dibujar_zona(int x1_zona, int x2, float techo, float suelo, int dir, float borde, color col, string txt, color coltxt, color colmitad, color colgris, bool fondo) =>
    // TradingView no deja dibujar con bar_index demasiado lejos hacia atrás: las zonas muy antiguas
    // que siguen vigentes se dibujan como mucho desde 1000 velas atrás (margen de seguridad amplio)
    x1 = math.max(x1_zona, bar_index - 1000)
    // Parte aún sin tocar (con su color) y parte consumida (gris)
    ctop = na(borde) ? techo : (dir == 1 ? borde : techo)
    cbot = na(borde) ? suelo : (dir == 1 ? suelo : borde)
    pintar_parte(Pieza.new(x1, x2, ctop, cbot), col, dir)
    if not na(borde)
        pintar_parte(Pieza.new(x1, x2, dir == 1 ? techo : borde, dir == 1 ? borde : suelo), colgris, dir)
    // Letrero solo al final de la zona (junto a la vela actual), a la altura de la parte sin tocar
    if txt != "" and letreros.size() < 60
        letreros.push(Letrero.new(x2, (ctop + cbot) / 2, txt, coltxt, true, fondo))
    // Línea del 50% (FVG de M15, H1 y H4), también recortada
    if not na(colmitad)
        m = (techo + suelo) / 2
        for q in recortar(Pieza.new(x1, x2, m, m))
            if q.x2 > q.x1
                poner_linea(q.x1, q.x2, m, colmitad)
    ocupado.push(Pieza.new(x1, x2, techo, suelo, dir))

dibujar_lista(array<Zona> arr, color c_alc, color c_baj, int transp, string txt, bool flecha, bool mitad, color colgris, bool fondo) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            z = arr.get(i)
            c = z.dir == 1 ? c_alc : c_baj
            // Letrero solo con el nombre (sin flecha de dirección)
            t = txt
            dist = z.suelo > close ? z.suelo - close : close > z.techo ? close - z.techo : 0.0
            // Si ya no caben más cajas o la zona está demasiado lejos del precio, no se calcula
            if uso.get(0) < 440 and ocupado.size() < max_dibujadas and (dist_max == 0 or dist / close * 100 <= dist_max)
                dibujar_zona(z.x1, bar_index + 1, z.techo, z.suelo, z.dir, z.borde, color.new(c, transp_zonas), t, c, mitad ? color.new(color.white, 30) : na, colgris, fondo)

// FVG/IFVG y OB del propio gráfico
dibujar_graf() =>
    if ver_graf
        dibujar_lista(ifvgs, col_ifvg, col_ifvg, 88, "IFVG " + tf_graf, true, false, color_consumido, false)
        dibujar_lista(zonas, graf_alc, graf_baj, 80, "FVG " + tf_graf, true, false, color_consumido, true)
    dibujar_lista(obs, col_ob_alc, col_ob_baj, 90, "OB " + tf_graf, true, false, color_consumido, false)

// FVG/IFVG de otra temporalidad (más alta o más baja que el gráfico). Los de M15 o más llevan su 50%.
dibujar_tf(bool ver, int mins, array<Zona> f, array<Zona> fi, color ca, color cb, int transp, string nom) =>
    if ver and not solo_su_graf and seg_graf != mins * 60
        dibujar_lista(fi, col_ifvg, col_ifvg, 88, "IFVG " + nom, true, false, color_consumido, false)
        dibujar_lista(f, ca, cb, transp, "FVG " + nom, true, mins >= 15, color_consumido, true)

if barstate.islast
    uso.set(0, 0)
    uso.set(1, 0)
    uso.set(2, 0)
    letreros.clear()
    ocupado.clear()
    // Cada temporalidad se dibuja solo si su interruptor está activado, de la más baja (encima) a la
    // más alta (alrededor). El FVG del propio gráfico ocupa el sitio de su temporalidad.
    graf_hecho = false
    if seg_graf <= 60
        dibujar_graf()
        graf_hecho := true
    dibujar_tf(mostrar_fvg1, 1, fvg1, ifvg1, fvg_alc_1, fvg_baj_1, 84, "M1")
    if not graf_hecho and seg_graf <= 300
        dibujar_graf()
        graf_hecho := true
    dibujar_tf(mostrar_fvg5, 5, fvg5, ifvg5, fvg_alc_5, fvg_baj_5, 84, "M5")
    if not graf_hecho and seg_graf <= 900
        dibujar_graf()
        graf_hecho := true
    dibujar_tf(mostrar_fvg15, 15, fvg15, ifvg15, fvg_alc_15, fvg_baj_15, 84, "M15")
    if not graf_hecho and seg_graf <= 3600
        dibujar_graf()
        graf_hecho := true
    dibujar_tf(mostrar_fvg60, 60, fvg60, ifvg60, fvg_alc_60, fvg_baj_60, 82, "H1")
    if not graf_hecho and seg_graf <= 14400
        dibujar_graf()
        graf_hecho := true
    dibujar_tf(mostrar_fvg240, 240, fvg240, ifvg240, fvg_alc_240, fvg_baj_240, 80, "H4")
    if not graf_hecho
        dibujar_graf()
    // Colocar los letreros dentro de su zona: a la altura de la zona y pegados a su borde derecho.
    // Si dos coinciden (misma altura aproximada), el segundo se pone a la izquierda del primero, en
    // la misma línea, en vez de subirlo o bajarlo. El ancho de cada letrero se estima en velas
    // (~1 vela por letra), así que con mucho zoom puede quedar algo de hueco entre ellos.
    if letreros.size() > 0
        colocados = array.new<Letrero>()
        for l in letreros
            x = l.x
            ancho = str.length(l.txt) + 2
            for intento = 0 to 3
                choca = false
                for c in colocados
                    ancho_c = str.length(c.txt) + 2
                    // Ambos letreros terminan en su x y ocupan [x - ancho, x]
                    if math.abs(c.y - l.y) < sep_letrero and x > c.x - ancho_c and x - ancho < c.x
                        x := c.x - ancho_c
                        choca := true
                if not choca
                    break
            colocados.push(Letrero.new(x, l.y, l.txt, l.col, true, l.fondo))
            // Solo el nombre, en el color de su zona, sin caja ni fondo
            poner_letrero(x, l.y, l.txt, color.white)
    // Los objetos que sobran de un dibujo anterior con más zonas se borran
    while dib_cajas.size() > uso.get(0)
        dib_cajas.pop().delete()
    while dib_lineas.size() > uso.get(1)
        dib_lineas.pop().delete()
    while dib_letreros.size() > uso.get(2)
        dib_letreros.pop().delete()

// ─────────────────────────────
// PANEL DE INFORMACIÓN
// Resumen para decidir de un vistazo: bias de H4 y H1, estructura del gráfico, sesión de Nueva York,
// FVG más cercano por arriba y por abajo y última SMT. Solo informa: no da señales.
// ─────────────────────────────

// Bias de una temporalidad superior: dirección de la última ruptura de estructura (cierre por encima
// del último alto relevante = alcista; por debajo del último bajo relevante = bajista). Se usa la vela
// ya cerrada de esa temporalidad, así que no repinta.
bias_htf() =>
    var int t = 0
    var float uh = na
    var float ul = na
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    if not na(ph)
        uh := ph
    if not na(pl)
        ul := pl
    if not na(uh) and close > uh
        t := 1
        uh := na
    else if not na(ul) and close < ul
        t := -1
        ul := na
    t[1]

// FVG más cercano de una lista, por arriba (arriba = true) o por abajo, mirando solo su parte sin tocar.
// Devuelve [distancia, nombre]; distancia 0 si el precio está dentro.
fvg_cercano(array<Zona> arr, string nom, bool arriba) =>
    float mejor = na
    string txt = ""
    for z in arr
        lo = z.dir == 1 or na(z.borde) ? z.suelo : z.borde
        hi = z.dir == -1 or na(z.borde) ? z.techo : z.borde
        d = close >= lo and close <= hi ? 0.0 : arriba ? (lo > close ? lo - close : na) : (hi < close ? close - hi : na)
        if not na(d) and (na(mejor) or d < mejor)
            mejor := d
            txt := nom + (z.dir == 1 ? " alcista" : " bajista")
    [mejor, txt]

fila(table t, int f, string a, string b, color cb, string tam) =>
    t.cell(0, f, a, text_color=#424242, text_size=tam, text_halign=text.align_left)
    t.cell(1, f, b, text_color=cb, text_size=tam, text_halign=text.align_left)
txt_bias(int b) =>
    b == 1 ? "▲ Alcista" : b == -1 ? "▼ Bajista" : "—"
col_bias(int b) =>
    b == 1 ? color_alcista : b == -1 ? color_bajista : #757575
txt_d(float d, string n) =>
    na(d) ? "—" : d == 0 ? "Precio dentro de " + n : n + " · a " + str.tostring(d, format.mintick) + " pts"
col_n(string n) =>
    str.contains(n, "alcista") ? color_alcista : str.contains(n, "bajista") ? color_bajista : #757575

ses_txt(float h, float l, bool en, bool bh, bool bl) =>
    na(h) ? "—" : str.tostring(l, format.mintick) + " – " + str.tostring(h, format.mintick) + (en ? " (en curso)" : bh and bl ? " · barridos los dos" : bh ? " · barrido el alto" : bl ? " · barrido el bajo" : " · sin barrer")

var table panel = na
if barstate.islast and mostrar_panel
    pos = panel_pos == "Arriba izquierda" ? position.top_left : panel_pos == "Abajo derecha" ? position.bottom_right : panel_pos == "Abajo izquierda" ? position.bottom_left : position.top_right
    tam = panel_tam == "Muy pequeño" ? size.tiny : panel_tam == "Normal" ? size.normal : size.small
    if na(panel)
        panel := table.new(pos, 2, 14, bgcolor=color.new(color.white, 8), border_color=color.new(#9E9E9E, 60), border_width=1, frame_color=color.new(#9E9E9E, 30), frame_width=1)
    panel.clear(0, 0, 1, 13)
    int f = 0
    // Bias H4 y H1 (solo se piden en la última vela)
    int b240 = 0
    int b60 = 0
    if timeframe.isintraday and seg_graf < 14400
        b240 := request.security(syminfo.tickerid, "240", bias_htf(), lookahead=barmerge.lookahead_on)
    if timeframe.isintraday and seg_graf < 3600
        b60 := request.security(syminfo.tickerid, "60", bias_htf(), lookahead=barmerge.lookahead_on)
    fila(panel, f, "Bias H4", seg_graf < 14400 ? txt_bias(b240) : "(gráfico ≥ H4)", col_bias(b240), tam)
    f += 1
    fila(panel, f, "Bias H1", seg_graf < 3600 ? txt_bias(b60) : "(gráfico ≥ H1)", col_bias(b60), tam)
    f += 1
    // Estructura del gráfico y último CHoCH/BOS
    ev = ult_evento_txt.get(0)
    ev_txt = ev == "" ? "" : " · " + ev + " hace " + str.tostring(bar_index - ult_evento_bar.get(0)) + " velas"
    fila(panel, f, "Estructura " + tf_graf, txt_bias(tendencia) + ev_txt, col_bias(tendencia), tam)
    f += 1
    // Sesión de Nueva York (apertura 9:30 y cierre 16:00 de Nueva York), en hora de Madrid
    tz = "America/New_York"
    m_ny = hour(timenow, tz) * 60 + minute(timenow, tz)
    dsem = dayofweek(timenow, tz)
    t_ap = timestamp(tz, year(timenow, tz), month(timenow, tz), dayofmonth(timenow, tz), 9, 30)
    t_ci = timestamp(tz, year(timenow, tz), month(timenow, tz), dayofmonth(timenow, tz), 16, 0)
    finde = dsem == dayofweek.saturday or dsem == dayofweek.sunday
    falta = 570 - m_ny
    ses = finde ? "Cerrada (fin de semana)" : m_ny < 570 ? "Abre a las " + str.format_time(t_ap, "HH:mm", "Europe/Madrid") + " (en " + (falta >= 60 ? str.tostring(int(falta / 60)) + " h " : "") + str.tostring(falta % 60) + " min)" : m_ny < 960 ? "● Abierta (cierra " + str.format_time(t_ci, "HH:mm", "Europe/Madrid") + ")" : "Cerrada (abre mañana " + str.format_time(t_ap, "HH:mm", "Europe/Madrid") + ")"
    fila(panel, f, "Sesión NY", ses, not finde and m_ny >= 570 and m_ny < 960 ? color_alcista : #424242, tam)
    f += 1
    // FVG más cercano por arriba y por abajo (entre los que se ven en el gráfico)
    float d_ar = na
    string n_ar = ""
    float d_ab = na
    string n_ab = ""
    if ver_graf
        [d1, t1] = fvg_cercano(zonas, "FVG " + tf_graf, true)
        [d2, t2] = fvg_cercano(ifvgs, "IFVG " + tf_graf, true)
        [d3, t3] = fvg_cercano(zonas, "FVG " + tf_graf, false)
        [d4, t4] = fvg_cercano(ifvgs, "IFVG " + tf_graf, false)
        if not na(d1) and (na(d_ar) or d1 < d_ar)
            d_ar := d1
            n_ar := t1
        if not na(d2) and (na(d_ar) or d2 < d_ar)
            d_ar := d2
            n_ar := t2
        if not na(d3) and (na(d_ab) or d3 < d_ab)
            d_ab := d3
            n_ab := t3
        if not na(d4) and (na(d_ab) or d4 < d_ab)
            d_ab := d4
            n_ab := t4
    if not solo_su_graf
        for k = 0 to 4
            arr = k == 0 ? fvg1 : k == 1 ? fvg5 : k == 2 ? fvg15 : k == 3 ? fvg60 : fvg240
            nom = k == 0 ? "FVG M1" : k == 1 ? "FVG M5" : k == 2 ? "FVG M15" : k == 3 ? "FVG H1" : "FVG H4"
            ver = k == 0 ? mostrar_fvg1 : k == 1 ? mostrar_fvg5 : k == 2 ? mostrar_fvg15 : k == 3 ? mostrar_fvg60 : mostrar_fvg240
            if ver
                [da, ta_] = fvg_cercano(arr, nom, true)
                [db, tb] = fvg_cercano(arr, nom, false)
                if not na(da) and (na(d_ar) or da < d_ar)
                    d_ar := da
                    n_ar := ta_
                if not na(db) and (na(d_ab) or db < d_ab)
                    d_ab := db
                    n_ab := tb
    fila(panel, f, "FVG por arriba", txt_d(d_ar, n_ar), col_n(n_ar), tam)
    f += 1
    fila(panel, f, "FVG por abajo", txt_d(d_ab, n_ab), col_n(n_ab), tam)
    f += 1
    // Última SMT (si está activada)
    smt_txt = not mostrar_smt ? "(apagada)" : na(smt_ult_bar) ? "Ninguna reciente" : (smt_ult_dir == 1 ? "▲ Alcista" : "▼ Bajista") + " hace " + str.tostring(bar_index - smt_ult_bar) + " velas"
    fila(panel, f, "SMT", smt_txt, not mostrar_smt or na(smt_ult_bar) ? #757575 : smt_ult_dir == 1 ? smt_col_alc : smt_col_baj, tam)
    f += 1
    // Movimiento esperado del día: VIX del cierre anterior / 16, en % y en puntos sobre el cierre
    // anterior del gráfico, y cuánto de ese movimiento lleva ya el rango de hoy
    if mostrar_vix
        vix_ant = request.security(vix_sym, "D", close[1], lookahead=barmerge.lookahead_on)
        [c_ant, h_hoy, l_hoy] = request.security(syminfo.tickerid, "D", [close[1], high, low], lookahead=barmerge.lookahead_on)
        pct = vix_ant / 16
        pts = c_ant * pct / 100
        usado = pts > 0 ? (h_hoy - l_hoy) / pts * 100 : na
        vix_txt = na(vix_ant) ? "Sin datos del VIX" : "±" + str.tostring(pct, "#.##") + " % · ±" + str.tostring(pts, "#") + " pts (VIX " + str.tostring(vix_ant, "#.#") + ") · hoy " + str.tostring(h_hoy - l_hoy, "#") + " pts = " + str.tostring(usado, "#") + " %"
        fila(panel, f, "Mov. esperado", vix_txt, na(usado) ? #757575 : usado >= 100 ? color_bajista : usado >= 75 ? #EF6C00 : #424242, tam)
        f += 1

    // Rangos de Asia y Londres
    if info_sesiones and ses_ok
        fila(panel, f, "Asia", ses_txt(asia_h, asia_l, en_asia, asia_bh, asia_bl), #5E35B1, tam)
        f += 1
        fila(panel, f, "Londres", ses_txt(lon_h, lon_l, en_lon, lon_bh, lon_bl), #1E88E5, tam)
        f += 1
    // Datos diarios para el ATR y la apertura
    if info_atr or info_apertura
        [d_open, d_atr, d_h, d_l] = request.security(syminfo.tickerid, "D", [open, ta.atr(14)[1], high, low], lookahead=barmerge.lookahead_on)
        if info_atr
            rng = d_h - d_l
            uso_atr = d_atr > 0 ? rng / d_atr * 100 : na
            fila(panel, f, "Rango hoy / ATR D", str.tostring(rng, "#") + " de " + str.tostring(d_atr, "#") + " pts (" + str.tostring(uso_atr, "#") + " %)", na(uso_atr) ? #757575 : uso_atr >= 100 ? color_bajista : uso_atr >= 75 ? #EF6C00 : #424242, tam)
            f += 1
        if info_apertura
            dif = close - d_open
            fila(panel, f, "vs apertura del día", (dif >= 0 ? "Por encima +" : "Por debajo ") + str.tostring(dif, format.mintick) + " pts" + (dif >= 0 ? " · premium" : " · descuento"), dif >= 0 ? color_bajista : color_alcista, tam)
            f += 1
    // Liquidez más cercana: altos/bajos del día anterior, de Asia y Londres sin barrer, de H4 y EQH/EQL
    if info_liquidez
        float l_ar = na
        string n_lar = ""
        float l_ab = na
        string n_lab = ""
        cand_p = array.from(pdh, pdl, asia_bh ? na : asia_h, asia_bl ? na : asia_l, lon_bh ? na : lon_h, lon_bl ? na : lon_l)
        cand_n = array.from("PDH", "PDL", "Alto Asia", "Bajo Asia", "Alto Londres", "Bajo Londres")
        for nv in niveles_h4
            cand_p.push(nv.precio)
            cand_n.push(nv.dir == 1 ? "Alto H4" : "Bajo H4")
        for q in iguales
            cand_p.push(q.precio)
            cand_n.push(q.dir == 1 ? "EQH" : "EQL")
        for i = 0 to cand_p.size() - 1
            pv = cand_p.get(i)
            if not na(pv)
                if pv > close and (na(l_ar) or pv < l_ar)
                    l_ar := pv
                    n_lar := cand_n.get(i)
                if pv < close and (na(l_ab) or pv > l_ab)
                    l_ab := pv
                    n_lab := cand_n.get(i)
        liq_txt = (na(l_ar) ? "↑ —" : "↑ " + n_lar + " " + str.tostring(l_ar, format.mintick) + " (+" + str.tostring(l_ar - close, format.mintick) + ")") + "  ·  " + (na(l_ab) ? "↓ —" : "↓ " + n_lab + " " + str.tostring(l_ab, format.mintick) + " (−" + str.tostring(close - l_ab, format.mintick) + ")")
        fila(panel, f, "Liquidez", liq_txt, #424242, tam)
        f += 1
    if noticias != ""
        fila(panel, f, "Noticias hoy", noticias, #EF6C00, tam)
        f += 1

