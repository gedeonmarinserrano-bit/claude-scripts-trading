min_rotation      = 0.18
touch_basis       = 'Wick reaches'
min_touches       = input.int(2, 'Toques mínimos en cada borde del rango', minval = 1, maxval = 10, group = g_rng)
touch_tolerance   = 0.10
max_drift         = 0.45
min_containment   = 0.70

range_anchoring   = 'Extend to containment'
anchor_lookback   = 300
min_range_bars    = input.int(10, 'Duración mínima del rango (velas)', minval = 2, maxval = 200, group = g_rng)
absorb_overshoot  = true
