	if _ge.size()> _se
		_ge.shift().delete()
var int _cj=na
var int _du=0
_ip=false
_ht=false
if barstate.isconfirmed
	if not na(_nj)
		_rk=not na(_hj)and _qo-_hj <=_ph
		d1=_rk and _oq and _dp(_nj,_fj,_pj,_je,true)
