	_dh(0,_as,_as and not _as[1],_gd,1,"Asia",#5E35B1)
	_dh(1,_as,_as and not _as[1],_gw,-1,"Asia",#5E35B1)
	_dh(2,_cn,_cn and not _cn[1],_lk,1,"Londres",#1E88E5)
	_dh(3,_cn,_cn and not _cn[1],_mp,-1,"Londres",#1E88E5)
