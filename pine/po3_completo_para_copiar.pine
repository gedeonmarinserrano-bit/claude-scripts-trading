_ph=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_ox=input.color(#2962FF,"Color EMA media",group="EMAs")
_oa=input.color(#363A45,"Color EMA lenta",group="EMAs")
_jb=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hr=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fp=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kn=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_uo=14
_ro=50
_tm=0.15
_qx=2.5
_rb=30
_qc=1.0
_li=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pf="Colores"
_ad=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pf)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pf)
_no=input.bool(true,"Marcar la vela del OB",group=_pf)
_hl=input.color(#FF00C8,"IFVG (magenta)",group=_pf)
_ni=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pf)
_ko=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pf)
type Zona
	int x1
	float _ah
	float _ag
	int dir
	float _bh=na
	int _sq=na
	bool _lz=false
var _hd=array.new<Zona>()
var _hy=array.new<Zona>()
var obs=array.new<Zona>()
var _xt=array.new<Zona>()
var _wb=array.new<Zona>()
var _qw=array.new<Zona>()
var _qv=array.new<Zona>()
var _kq=array.new<Zona>()
var _wm=array.new<Zona>()
var _tp=array.new<Zona>()
var _ql=array.new<Zona>()
var _qk=array.new<Zona>()
var _mc=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ag
	color col
var _bi=array.new<Rango>()
_ew(Zona z)=>
	_fx=z.dir==1?low <=z._ag:high >=z._ah
	if not _fx
		_bh=na(z._bh)?(z.dir==1?z._ah:z._ag):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_fx
type Marca
	label lb
	line ln
	int bar
var _iu=array.new<Marca>()
var array<string> _fd=array.from("")
var array<int> _fc=array.from(0)
_al(label lb,line ln,int bar)=>
	_iu.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fd.set(0,lb.get_text())
		_fc.set(0,bar)
	if _iu.size()> 500
		_iu.shift()
_re=ta.ema(close,_op)
_ru=ta.ema(close,_ov)
_ji=ta.ema(close,_nv)
_cz=ta.atr(_uo)
var string _uh='════════ Detection ════════'
var string _sh='════════ Structure Filters ════════'
var string _vb='════════ Range Behavior ════════'
var string _ub='════════ Visual Settings ════════'
_cq='Base + 2x + 3x'
_oj='Rangos'
_bn=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_oj)
_br='Percentile band'
_ef=90.0
_lt='Bar close'
_kv=200
_iv=40.0
_ei=500
_mp=0.18
_pc='Wick reaches'
_jo=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_oj)
_ee=0.10
_rj=0.45
_ej=0.70
_jp='Extend to containment'
_is=300
_kc=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_oj)
_hh=true
_ln=0.25
_mb='Close beyond'
_jd=0.15
_ha=true
_hj=10
_lw=3
_fi=0
_nf='Custom'
_ly=#00A651
_mj=#E4002B
_ff=input.color(#F9A825,'Color del rango (neutral)',group=_oj)
_kd=4
_gl=93
_hb=true
_kb=true
_hi=input.bool(true,'Mostrar etiqueta del rango',group=_oj)
_jw=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_oj)
_hq=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_oj)
_ia='Small'
_ex=true
_jy='Small'
[_cf,_cg]=switch _nf
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_ly,_mj]
var color _cc=color.new(color.black,100)
var float _ch=3.0
var float _dm=1.6
_ip(string _wk)=>
	switch _wk
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fe(color _dd)=>
	_js=color.r(_dd)/255.0
	_hv=color.g(_dd)/255.0
	_ij=color.b(_dd)/255.0
	_tt=_js <=0.03928?_js/12.92:math.pow((_js+0.055)/1.055,2.4)
	_tl=_hv <=0.03928?_hv/12.92:math.pow((_hv+0.055)/1.055,2.4)
	_tj=_ij <=0.03928?_ij/12.92:math.pow((_ij+0.055)/1.055,2.4)
	0.2126*_tt+0.7152*_tl+0.0722*_tj
_lh(color _nt,color _mr)=>
	_na=_fe(_nt)
	_kw=_fe(_mr)
	(math.max(_na,_kw)+0.05)/(math.min(_na,_kw)+0.05)
_eg(color _hn)=>
	_fe(_hn)> 0.179?#000000:#ffffff
_om(color _dd,color _nh,float _rz)=>
	color.rgb(color.r(_dd)+(color.r(_nh)-color.r(_dd))*_rz,color.g(_dd)+(color.g(_nh)-color.g(_dd))*_rz,color.b(_dd)+(color.b(_nh)-color.b(_dd))*_rz)
_bm(color _dd,color _hn,float _ow)=>
	_nh=_eg(_hn)
	_lp=_dd
	for step=1 to 10
		if _lh(_lp,_hn)>=_ow
			break
		_lp:=_om(_dd,_nh,step/10.0)
	_lp
_jj(float _xw)=>
	str.tostring(_xw,'#.##')+'%'
_qz(array<box> _ka,int _ma,float _au,float _ak)=>
	array.clear(_ka)
	if not _ko
		for i=0 to _kd-1
			array.push(_ka,box.new(_ma,_au,bar_index,_ak,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gn(array<box> _ka,float _au,float _ak,int _ma,int _rf,color _pa)=>
	_qm=array.size(_ka)
	if _qm > 0 and _au > _ak
		_gq=(_au-_ak)/_qm
		for i=0 to _qm-1
			_if=array.get(_ka,i)
			_oi=math.abs((i+0.5)/_qm-0.5)*2.0
			_od=int(math.min(99,math.max(0,_gl+(1.0-_oi)*10)))
			box.set_lefttop(_if,_ma,_au-_gq*i)
			box.set_rightbottom(_if,_rf,_au-_gq*(i+1))
			box.set_bgcolor(_if,color.new(_pa,_od))
_os(array<box> _ka)=>
	if array.size(_ka)> 0
		for i=0 to array.size(_ka)-1
			box.delete(array.get(_ka,i))
	array.clear(_ka)
_qr(int _sj,float _au,float _ak,float _ci)=>
	_yo=_sj
	if _jp=='Extend to containment'
		_xo=math.min(_is,bar_index)
		_vn=math.max(2,math.round((1.0-_ej)*_sj))
		_lo=0
		_gx=0
		while _gx < _xo and _lo <=_vn
			_nb=close[_gx]<=_au and close[_gx]>=_ak
			_tc=_nb and high[_gx]<=_au+_ci and low[_gx]>=_ak-_ci
			if _nb
				_lo:=math.max(0,_lo-1)
				if _tc and _gx+1 >=_sj
					_yo:=_gx+1
			else
				_lo+=1
			_gx+=1
	_yo
_cj=ta.atr(_kv)
_kx=not na(_cj)and _cj > 0
_gh=_mb=='Wick beyond'
_ld=_pc=='Wick reaches'
_ob=_lt=='Live bar'
_fl=_ob or barstate.isconfirmed
_gp=_ip(_ia)
_kf=_ip(_jy)
_y=chart.bg_color
_s=_bm(_ff,_y,_ch)
_fz=_bm(_cf,_y,_ch)
_gc=_bm(_cg,_y,_ch)
_hg=_bm(_ff,_y,_dm)
_fr=_bm(_cf,_y,_dm)
_fs=_bm(_cg,_y,_dm)
_go(simple int len)=>
	_vh=ta.percentile_linear_interpolation(high,len,_ef)
	_rd=ta.percentile_linear_interpolation(low,len,100.0-_ef)
	_vt=ta.highest(high,len)
	_qs=ta.lowest(low,len)
	_tr=ta.highest(math.max(open,close),len)
	_oy=ta.lowest(math.min(open,close),len)
	top=_br=='Absolute extremes'?_vt:_br=='Body extremes'?_tr:_vh
	_kj=_br=='Absolute extremes'?_qs:_br=='Body extremes'?_oy:_rd
	_ds=top-_kj
	_oc=_kx and _ds > 0?_ds/(_cj*math.sqrt(len)):99.0
	_sw=bar_index < 1?_ei:int(math.max(1,math.min(_ei,bar_index-_kv)))
	_yd=ta.percentrank(_oc,_sw)
	_yc=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xr=_ds > 0?math.abs(_yc)*len/_ds:99.0
	_cp=math.avg(top,_kj)
	_ci=_ee*nz(_cj)
	_mv=0
	_qe=0
	_ib=0
	_mu=0
	for i=0 to len-1
		if(close[i]> _cp)!=(close[i+1]> _cp)
			_mv+=1
		_on=_ld?high[i]>=top-_ci:close[i]>=top-_ci
		_jx=_ld?low[i]<=_kj+_ci:close[i]<=_kj+_ci
		if _on
			_qe+=1
		if _jx
			_ib+=1
		if close[i]<=top and close[i]>=_kj
			_mu+=1
	_ok=_mu/float(len)
	_hu=_kx and not na(_yd)and bar_index > len+5 and _yd <=_iv and _mv >=math.max(3,math.round(_mp*len))and _qe >=_jo and _ib >=_jo and _xr <=_rj and _ok >=_ej
	[_hu,top,_kj]
bool _jk=false
bool _il=false
bool _iq=false
float _wn=na
float _ww=na
float _wu=na
float _py=na
float _qn=na
float _ps=na
if _az
	[qa,ta_,ba]=_go(_bn)
	_jk:=qa
	_wn:=ta_
	_py:=ba
	if _cq !='Base only'
		[qb,tb,bb]=_go(_bn*2)
		_il:=qb
		_ww:=tb
		_qn:=bb
	if _cq=='Base + 2x + 3x'
		[qc,tc,bc]=_go(_bn*3)
		_iq:=qc
		_wu:=tc
		_ps:=bc
_eu=_cq !='Base only' and _il
_ev=_cq=='Base + 2x + 3x' and _iq
_hu=_jk or _eu or _ev
_ol=_ev?_bn*3:_eu?_bn*2:_bn
_po=_ev?_wu:_eu?_ww:_wn
_id=_ev?_ps:_eu?_qn:_py
var array<box> _ar=array.new<box>()
var box _t=na
var line _g=na
var line _k=na
var line _x=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _gy=na
var bool _v=false
var bool _m=false
var bool _bg=false
var int _dp=na
var int _q=0
var float _p=na
var int _bb=na
var int _be=0
_cb=false
_cm=false
_bk=false
_ca=false
if _fl and _be > 0
	_be-=1
if _fl and not _v and not _bg and _be <=0 and _hu
	_og=_qr(_ol,_po,_id,_ee*_cj)
	_c:=bar_index-_og+1
	_gy:=bar_index
	_f:=_po
	_a:=_id
	_v:=true
	_m:=false
	_cp=math.avg(_f,_a)
	_by=_a+(_f-_a)*0.25
	_aw=_a+(_f-_a)*0.75
	_t:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qz(_ar,_c,_f,_a)
	if _hb
		_g:=line.new(_c,_cp,bar_index,_cp,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kb
		_k:=line.new(_c,_by,bar_index,_by,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_x:=line.new(_c,_aw,bar_index,_aw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hi
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cc,style=label.style_label_down,textcolor=color.new(_s,10),size=_gp)
	_cb:=true
if _v and _fl
	_cu=_jd*_cj
	_fj=_ln*_cj
	if _hh and not _gh and close <=_f and close >=_a
		if high > _f and high <=_f+_fj
			_f:=high
		if low < _a and low >=_a-_fj
			_a:=low
	_px=_gh?high > _f+_cu:close > _f+_cu
	_kt=_gh?low < _a-_cu:close < _a-_cu
	_rc=_fi > 0 and bar_index-_gy+1 >=_fi
	if _px or _kt or _rc
		_b=_px?1:_kt?-1:0
		_rp=_b !=0?bar_index-_c:bar_index-_c+1
		_mo=_a !=0?(_f-_a)/_a*100.0:0.0
		_jt=_ha and _b !=0 and _m
		if _m
			_fh=_b==1?_fz:_b==-1?_gc:_s
			_pi=_b==1?_fr:_b==-1?_fs:_hg
			_jm=_b==1?_cf:_b==-1?_cg:_ff
			box.set_lefttop(_t,_c,_f)
			box.set_rightbottom(_t,bar_index,_a)
			box.set_border_color(_t,color.new(_fh,30))
			box.set_border_style(_t,line.style_dotted)
			_gn(_ar,_f,_a,_c,bar_index,na)
			_bi.push(Rango.new(_c,bar_index,_f,_a,_pi))
			if _bi.size()> 8
				_bi.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_x,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_rp)+' BARS   '+_jj(_mo))
				label.set_textcolor(_z,color.new(_fh,10))
			if _jw and _b !=0
				_ot=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _ex
