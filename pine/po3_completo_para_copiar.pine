		_bg(f,ca,cb,_tx,"FVG "+nom,true,_wc >=15,_aj,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_ga.clear()
	_gk.clear()
	_af=false
	if _d <=60
		_as()
		_af:=true
	_di(_cq,1,_xw,_wg,_nk,_mt,84,"M1")
	if not _af and _d <=300
		_as()
		_af:=true
	_di(_bv,5,_wa,_tg,_nc,_np,84,"M5")
	if not _af and _d <=900
		_as()
		_af:=true
	_di(_az,15,_qq,_qm,_km,_kv,84,"M15")
	if not _af and _d <=3600
		_as()
		_af:=true
	_di(_aw,60,_qt,_pv,_kg,_ks,82,"H1")
	if not _af and _d <=14400
		_as()
		_af:=true
	_di(_ap,240,_kj,_lu,_jr,_hq,80,"H4")
	if not _af
		_as()
	if _ga.size()> 0
		_mw=array.new<Letrero>()
		for l in _ga
			x=l.x
			_sq=str.length(l.txt)+2
			for _vg=0 to 3
				_rq=false
				for c in _mw
					_rs=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _fg and x > c.x-_rs and x-_sq < c.x
						x:=c.x-_rs
						_rq:=true
				if not _rq
					break
			_mw.push(Letrero.new(x,l.y,l.txt,l.col,true,l._sb))
			_lj(x,l.y,l.txt,color.white)
	while _eh.size()> uso.get(0)
		_eh.pop().delete()
	while _df.size()> uso.get(1)
		_df.pop().delete()
	while _bx.size()> uso.get(2)
		_bx.pop().delete()
_pk()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bj(array<Zona> arr,string nom,bool _wm)=>
	float _tt=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bh)?z._ah:z._bh
		hi=z.dir==-1 or na(z._bh)?z._ag:z._bh
		d=close >=lo and close <=hi?0.0:_wm?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_tt)or d < _tt)
			_tt:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_tt,txt]
_qk(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_ls(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_mj(int b)=>
	b==1?_ad:b==-1?_t:#757575
_wn(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_xl(string n)=>
	str.contains(n,"alcista")?_ad:str.contains(n,"bajista")?_t:#757575
_rn(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ef=na
