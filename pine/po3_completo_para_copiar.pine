_li=input.bool(true,"Liquidez más cercana por arriba y por abajo",group=_cx)
_pq=input.string("","Noticias de hoy (texto libre, p. ej. «CPI 14:30»; vacío = no se muestra)",group=_cx)
_ii="Información en el gráfico"
_lr=input.bool(true,"Fondo suave en las sesiones de Asia, Londres y apertura de Nueva York",group=_ii)
_ux=input.bool(true,"Línea del 50 % del día anterior (por encima premium, por debajo descuento)",group=_ii)
_rv=input.bool(true,"Altos y bajos iguales sin barrer (EQH / EQL)",group=_ii)
_lg=input.bool(true,"Marcar barridos de niveles (pasa el nivel y cierra de vuelta)",group=_ii)
_mr=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_ii)
_db="FVG por temporalidad (solo se ven los activados)"
_ar=input.bool(true,"FVG H4",inline="fvgtf1",group=_db)
_ay=input.bool(true,"FVG H1",inline="fvgtf1",group=_db)
_ax=input.bool(true,"FVG M15",inline="fvgtf1",group=_db)
_bw=input.bool(true,"FVG M5",inline="fvgtf2",group=_db)
_cr=input.bool(true,"FVG M1",inline="fvgtf2",group=_db)
_ou=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_db)
_l=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_db)
_gj=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_db)
_lk=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_db)
_pz=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_db)
_om="Estructura (CHoCH / BOS)"
_cb=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_om)
_tb=1.1
_vt=2.0
_uq=20
_tu=2
_mz=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_om)
_is=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_om)
_ij=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_om)
_hs=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_om)
_em=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_om)
_qw=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_om)
_be=bar_index >=last_bar_index-_qw
_cn=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mm=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_ak=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_vp="Order Blocks"
_km=input.bool(true,"Mostrar Order Blocks",group=_vp)
_fv=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_vp)
_nf=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_vp)
_xi=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_vp)
_mw=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_vp)
_ku=input.color(#1565C0,"OB alcista (demanda)",group=_vp)
_kp=input.color(#EF6C00,"OB bajista (oferta)",group=_vp)
_qb="Estrategia NY (Bias + PO3)"
_lq=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_qb)
_kv=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_qb)
_ue="Colores FVG"
_ao=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_ue)
_ap=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_ue)
_rf=_ao
_nj=_ao
_mn=_ao
_kj=_ao
_ky=_ao
_ik=_ao
_se=_ap
_nh=_ap
_mx=_ap
_kh=_ap
_lc=_ap
_hu=_ap
_jx=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qb)
_rd=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qb)
_le=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qb)
_jy=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_qb)
_qo=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_qb)
_la=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_qb)
_kf=input.color(#8D6E63,"Color niveles H1",group=_qb)
_ra=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qb)
_dr=input.color(#424242,"Color niveles clave",group=_qb)
_ms=input.color(#757575,"Color horas",group=_qb)
_ej=input.bool(true,"Mostrar EMAs",group="EMAs")
_pc=input.int(9,"EMA rápida",minval=1,group="EMAs")
_of=input.int(20,"EMA media",minval=1,group="EMAs")
_oj=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oe=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_op=input.color(#9E9D24,"Color EMA media",group="EMAs")
_nx=input.color(color.black,"Color EMA lenta",group="EMAs")
_in=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_io=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_ft=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_ko=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vq=14
_so=50
_tw=0.15
_qp=2.5
_qv=30
_pv=1.0
_lh=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pf="Colores"
_ac=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pf)
_t=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pf)
_ni=input.bool(true,"Marcar la vela del OB",group=_pf)
_ho=input.color(#FF00C8,"IFVG (magenta)",group=_pf)
_nl=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pf)
_kx=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pf)
type Zona
	int x1
	float _ah
	float _ai
	int dir
	float _bi=na
	int _su=na
	bool _md=false
var _hc=array.new<Zona>()
var _hy=array.new<Zona>()
var obs=array.new<Zona>()
var _yc=array.new<Zona>()
var _wb=array.new<Zona>()
var _rb=array.new<Zona>()
var _qy=array.new<Zona>()
var _kn=array.new<Zona>()
var _xl=array.new<Zona>()
var _tj=array.new<Zona>()
var _pt=array.new<Zona>()
var _pk=array.new<Zona>()
var _mj=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ai
	color col
var _bn=array.new<Rango>()
_ey(Zona z)=>
	_fu=z.dir==1?low <=z._ai:high >=z._ah
	if not _fu
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ai):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fu
type Marca
	label lb
	line ln
	int bar
var _jh=array.new<Marca>()
var array<string> _ff=array.from("")
var array<int> _fe=array.from(0)
_am(label lb,line ln,int bar)=>
	_jh.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ff.set(0,lb.get_text())
		_fe.set(0,bar)
	if _jh.size()> 500
		_jh.shift()
_qq=ta.ema(close,_pc)
_rq=ta.ema(close,_of)
_ir=ta.ema(close,_oj)
_cl=ta.atr(_vq)
var string _ug='════════ Detection ════════'
var string _sm='════════ Structure Filters ════════'
var string _uv='════════ Range Behavior ════════'
var string _tz='════════ Visual Settings ════════'
_cw='Base + 2x + 3x'
_oz='Rangos'
_bl=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_oz)
_bs='Percentile band'
_es=90.0
_mf='Bar close'
_lb=200
_ht=40.0
_en=500
_np=0.18
_ok='Wick reaches'
_jo=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_oz)
_eo=0.10
_sp=0.45
_ei=0.70
_js='Extend to containment'
_ih=300
_kc=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_oz)
_hj=true
_mk=0.25
_ma='Close beyond'
_jr=0.15
_he=true
_hd=10
_lz=3
_gb=0
_nr='Custom'
_lo=#00A651
_mb=#E4002B
_fk=input.color(#F9A825,'Color del rango (neutral)',group=_oz)
_ka=4
_gn=93
_hh=true
_ke=true
_hi=input.bool(true,'Mostrar etiqueta del rango',group=_oz)
_jw=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_oz)
_jj=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_oz)
_hz='Small'
_fb=true
_ju='Small'
[_ch,_cg]=switch _nr
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lo,_mb]
var color _bz=color.new(color.black,100)
var float _cf=3.0
var float _dz=1.6
_ja(string _wr)=>
	switch _wr
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fi(color _dl)=>
	_hx=color.r(_dl)/255.0
	_if=color.g(_dl)/255.0
	_iq=color.b(_dl)/255.0
	_tt=_hx <=0.03928?_hx/12.92:math.pow((_hx+0.055)/1.055,2.4)
	_tx=_if <=0.03928?_if/12.92:math.pow((_if+0.055)/1.055,2.4)
	_sx=_iq <=0.03928?_iq/12.92:math.pow((_iq+0.055)/1.055,2.4)
	0.2126*_tt+0.7152*_tx+0.0722*_sx
_mg(color _pb,color _nb)=>
	_nc=_fi(_pb)
	_kq=_fi(_nb)
	(math.max(_nc,_kq)+0.05)/(math.min(_nc,_kq)+0.05)
_el(color _hq)=>
	_fi(_hq)> 0.179?#000000:#ffffff
_os(color _dl,color _mu,float _sf)=>
	color.rgb(color.r(_dl)+(color.r(_mu)-color.r(_dl))*_sf,color.g(_dl)+(color.g(_mu)-color.g(_dl))*_sf,color.b(_dl)+(color.b(_mu)-color.b(_dl))*_sf)
_bj(color _dl,color _hq,float _oq)=>
	_mu=_el(_hq)
	_ll=_dl
	for step=1 to 10
		if _mg(_ll,_hq)>=_oq
			break
		_ll:=_os(_dl,_mu,step/10.0)
	_ll
_ix(float _yd)=>
	str.tostring(_yd,'#.##')+'%'
_qs(array<box> _kd,int _lp,float _aw,float _aj)=>
	array.clear(_kd)
	if not _kx
		for i=0 to _ka-1
			array.push(_kd,box.new(_lp,_aw,bar_index,_aj,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gh(array<box> _kd,float _aw,float _aj,int _lp,int _ro,color _od)=>
	_qn=array.size(_kd)
	if _qn > 0 and _aw > _aj
		_gy=(_aw-_aj)/_qn
		for i=0 to _qn-1
			_ic=array.get(_kd,i)
			_oo=math.abs((i+0.5)/_qn-0.5)*2.0
			_ph=int(math.min(99,math.max(0,_gn+(1.0-_oo)*10)))
			box.set_lefttop(_ic,_lp,_aw-_gy*i)
			box.set_rightbottom(_ic,_ro,_aw-_gy*(i+1))
			box.set_bgcolor(_ic,color.new(_od,_ph))
_pi(array<box> _kd)=>
	if array.size(_kd)> 0
		for i=0 to array.size(_kd)-1
			box.delete(array.get(_kd,i))
	array.clear(_kd)
_rc(int _rw,float _aw,float _aj,float _ci)=>
	_yl=_rw
	if _js=='Extend to containment'
		_xu=math.min(_ih,bar_index)
		_va=math.max(2,math.round((1.0-_ei)*_rw))
		_lw=0
		_gw=0
		while _gw < _xu and _lw <=_va
			_mp=close[_gw]<=_aw and close[_gw]>=_aj
			_tp=_mp and high[_gw]<=_aw+_ci and low[_gw]>=_aj-_ci
			if _mp
				_lw:=math.max(0,_lw-1)
				if _tp and _gw+1 >=_rw
					_yl:=_gw+1
			else
				_lw+=1
			_gw+=1
	_yl
_cm=ta.atr(_lb)
_ks=not na(_cm)and _cm > 0
_gm=_ma=='Wick beyond'
_kg=_ok=='Wick reaches'
_ox=_mf=='Live bar'
_fz=_ox or barstate.isconfirmed
_gg=_ja(_hz)
_kt=_ja(_ju)
_w=chart.bg_color
_r=_bj(_fk,_w,_cf)
_ga=_bj(_ch,_w,_cf)
_fr=_bj(_cg,_w,_cf)
_hg=_bj(_fk,_w,_dz)
_fm=_bj(_ch,_w,_dz)
_gd=_bj(_cg,_w,_dz)
_gq(simple int len)=>
	_uw=ta.percentile_linear_interpolation(high,len,_es)
	_qz=ta.percentile_linear_interpolation(low,len,100.0-_es)
	_vk=ta.highest(high,len)
	_qu=ta.lowest(low,len)
	_ti=ta.highest(math.max(open,close),len)
	_nv=ta.lowest(math.min(open,close),len)
	top=_bs=='Absolute extremes'?_vk:_bs=='Body extremes'?_ti:_uw
	_kw=_bs=='Absolute extremes'?_qu:_bs=='Body extremes'?_nv:_qz
	_do=top-_kw
	_ob=_ks and _do > 0?_do/(_cm*math.sqrt(len)):99.0
	_tl=bar_index < 1?_en:int(math.max(1,math.min(_en,bar_index-_lb)))
	_yk=ta.percentrank(_ob,_tl)
	_xt=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xp=_do > 0?math.abs(_xt)*len/_do:99.0
	_ct=math.avg(top,_kw)
	_ci=_eo*nz(_cm)
	_nk=0
	_qm=0
	_jn=0
	_mq=0
	for i=0 to len-1
		if(close[i]> _ct)!=(close[i+1]> _ct)
			_nk+=1
		_og=_kg?high[i]>=top-_ci:close[i]>=top-_ci
		_jv=_kg?low[i]<=_kw+_ci:close[i]<=_kw+_ci
		if _og
			_qm+=1
		if _jv
			_jn+=1
		if close[i]<=top and close[i]>=_kw
			_mq+=1
	_ow=_mq/float(len)
	_ia=_ks and not na(_yk)and bar_index > len+5 and _yk <=_ht and _nk >=math.max(3,math.round(_np*len))and _qm >=_jo and _jn >=_jo and _xp <=_sp and _ow >=_ei
	[_ia,top,_kw]
bool _jp=false
bool _hr=false
bool _jq=false
float _wn=na
float _wx=na
float _wy=na
float _pm=na
float _qe=na
float _pw=na
if _be
	[qa,ta_,ba]=_gq(_bl)
	_jp:=qa
	_wn:=ta_
	_pm:=ba
	if _cw !='Base only'
		[qb,tb,bb]=_gq(_bl*2)
		_hr:=qb
		_wx:=tb
		_qe:=bb
	if _cw=='Base + 2x + 3x'
		[qc,tc,bc]=_gq(_bl*3)
		_jq:=qc
		_wy:=tc
		_pw:=bc
_eu=_cw !='Base only' and _hr
_ex=_cw=='Base + 2x + 3x' and _jq
_ia=_jp or _eu or _ex
_ol=_ex?_bl*3:_eu?_bl*2:_bl
_py=_ex?_wy:_eu?_wx:_wn
_im=_ex?_pw:_eu?_qe:_pm
var array<box> _as=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _x=na
var label _z=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gt=na
var bool _v=false
var bool _m=false
var bool _bh=false
var int _dm=na
var int _p=0
var float _q=na
var int _az=na
var int _bb=0
_cc=false
_cj=false
_bm=false
_cd=false
if _fz and _bb > 0
	_bb-=1
if _fz and not _v and not _bh and _bb <=0 and _ia
	_nu=_rc(_ol,_py,_im,_eo*_cm)
	_c:=bar_index-_nu+1
	_gt:=bar_index
	_f:=_py
	_a:=_im
	_v:=true
	_m:=false
	_ct=math.avg(_f,_a)
	_bu=_a+(_f-_a)*0.25
	_bc=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qs(_as,_c,_f,_a)
	if _hh
		_g:=line.new(_c,_ct,bar_index,_ct,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _ke
		_k:=line.new(_c,_bu,bar_index,_bu,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_x:=line.new(_c,_bc,bar_index,_bc,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hi
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bz,style=label.style_label_down,textcolor=color.new(_r,10),size=_gg)
	_cc:=true
if _v and _fz
	_cs=_jr*_cm
	_fn=_mk*_cm
	if _hj and not _gm and close <=_f and close >=_a
		if high > _f and high <=_f+_fn
			_f:=high
		if low < _a and low >=_a-_fn
			_a:=low
	_qd=_gm?high > _f+_cs:close > _f+_cs
	_kr=_gm?low < _a-_cs:close < _a-_cs
	_re=_gb > 0 and bar_index-_gt+1 >=_gb
	if _qd or _kr or _re
		_b=_qd?1:_kr?-1:0
		_sa=_b !=0?bar_index-_c:bar_index-_c+1
		_no=_a !=0?(_f-_a)/_a*100.0:0.0
		_jz=_he and _b !=0 and _m
		if _m
			_fh=_b==1?_ga:_b==-1?_fr:_r
			_pe=_b==1?_fm:_b==-1?_gd:_hg
			_jd=_b==1?_ch:_b==-1?_cg:_fk
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_fh,30))
			box.set_border_style(_u,line.style_dotted)
			_gh(_as,_f,_a,_c,bar_index,na)
			_bn.push(Rango.new(_c,bar_index,_f,_a,_pe))
			if _bn.size()> 8
				_bn.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_x,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sa)+' BARS   '+_ix(_no))
				label.set_textcolor(_z,color.new(_fh,10))
			if _jw and _b !=0
				_nt=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fb
