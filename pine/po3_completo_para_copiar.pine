_fp=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_uq)
_mq=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_uq)
_xj=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_uq)
_nk=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_uq)
_ku=input.color(#1565C0,"OB alcista (demanda)",group=_uq)
