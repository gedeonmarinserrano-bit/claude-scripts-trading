_uh=_ra and timeframe.isintraday and not timeframe.change("D")
plot(_uh?pdh:na,"Alto día anterior",color=color.new(_do,30),style=plot.style_linebr,linewidth=1)
plot(_uh?pdl:na,"Bajo día anterior",color=color.new(_do,30),style=plot.style_linebr,linewidth=1)
