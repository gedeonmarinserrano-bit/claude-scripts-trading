_kj=input.color(#8D6E63,"Color niveles H1",group=_qb)
_qo=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qb)
_dr=input.color(#424242,"Color niveles clave",group=_qb)
_nh=input.color(#757575,"Color horas",group=_qb)
_ee=input.bool(true,"Mostrar EMAs",group="EMAs")
_ou=input.int(9,"EMA rápida",minval=1,group="EMAs")
_og=input.int(20,"EMA media",minval=1,group="EMAs")
_ny=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ot=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_ns=input.color(#9E9D24,"Color EMA media",group="EMAs")
_pd=input.color(color.black,"Color EMA lenta",group="EMAs")
_ip=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hs=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fu=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kn=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_uz=14
_sb=50
_sy=0.15
_qv=2.5
_qs=30
_pg=1.0
_lx=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pf="Colores"
_ae=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pf)
_v=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pf)
_mz=input.bool(true,"Marcar la vela del OB",group=_pf)
_hn=input.color(#FF00C8,"IFVG (magenta)",group=_pf)
_nc=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pf)
_le=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pf)
type Zona
	int x1
	float _ah
	float _ai
	int dir
	float _bi=na
	int _sn=na
	bool _lg=false
var _hd=array.new<Zona>()
var _jq=array.new<Zona>()
var obs=array.new<Zona>()
var _xt=array.new<Zona>()
var _vs=array.new<Zona>()
var _qy=array.new<Zona>()
var _qt=array.new<Zona>()
var _ki=array.new<Zona>()
var _xe=array.new<Zona>()
var _tm=array.new<Zona>()
var _po=array.new<Zona>()
var _pu=array.new<Zona>()
var _lr=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ai
	color col
var _bj=array.new<Rango>()
_ey(Zona z)=>
	_fx=z.dir==1?low <=z._ai:high >=z._ah
	if not _fx
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ai):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fx
type Marca
	label lb
	line ln
	int bar
var _hx=array.new<Marca>()
var array<string> _fb=array.from("")
var array<int> _fe=array.from(0)
_an(label lb,line ln,int bar)=>
	_hx.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fb.set(0,lb.get_text())
		_fe.set(0,bar)
	if _hx.size()> 500
		_hx.shift()
_qm=ta.ema(close,_ou)
_sh=ta.ema(close,_og)
_ie=ta.ema(close,_ny)
_cj=ta.atr(_uz)
var string _tz='════════ Detection ════════'
var string _rv='════════ Structure Filters ════════'
var string _va='════════ Range Behavior ════════'
var string _ug='════════ Visual Settings ════════'
_ct='Base + 2x + 3x'
_pa='Rangos'
_bm=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_pa)
_bt='Percentile band'
_eh=90.0
_lt='Bar close'
_km=200
_hq=40.0
_ed=500
_ms=0.18
_on='Wick reaches'
_jk=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_pa)
_er=0.10
_rz=0.45
_ef=0.70
_iw='Extend to containment'
_il=300
_ju=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_pa)
_hj=true
_lk=0.25
_mc='Close beyond'
_iu=0.15
_hh=true
_hf=10
_ly=3
_fj=0
_nf='Custom'
_lo=#00A651
_lm=#E4002B
_fi=input.color(#F9A825,'Color del rango (neutral)',group=_pa)
_jx=4
_gp=93
_he=true
_kb=true
_ha=input.bool(true,'Mostrar etiqueta del rango',group=_pa)
_jy=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_pa)
_ij=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_pa)
_js='Small'
_fa=true
_kc='Small'
[_cf,_ch]=switch _nf
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lo,_lm]
var color _cb=color.new(color.black,100)
var float _cg=3.0
var float _do=1.6
_hy(string _wz)=>
	switch _wz
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fg(color _df)=>
	_id=color.r(_df)/255.0
	_ht=color.g(_df)/255.0
	_hw=color.b(_df)/255.0
	_tq=_id <=0.03928?_id/12.92:math.pow((_id+0.055)/1.055,2.4)
	_ts=_ht <=0.03928?_ht/12.92:math.pow((_ht+0.055)/1.055,2.4)
	_su=_hw <=0.03928?_hw/12.92:math.pow((_hw+0.055)/1.055,2.4)
	0.2126*_tq+0.7152*_ts+0.0722*_su
_mi(color _od,color _mk)=>
	_mo=_fg(_od)
	_kf=_fg(_mk)
	(math.max(_mo,_kf)+0.05)/(math.min(_mo,_kf)+0.05)
_eo(color _hm)=>
	_fg(_hm)> 0.179?#000000:#ffffff
_nt(color _df,color _mr,float _rw)=>
	color.rgb(color.r(_df)+(color.r(_mr)-color.r(_df))*_rw,color.g(_df)+(color.g(_mr)-color.g(_df))*_rw,color.b(_df)+(color.b(_mr)-color.b(_df))*_rw)
_bn(color _df,color _hm,float _pb)=>
	_mr=_eo(_hm)
	_lq=_df
	for step=1 to 10
		if _mi(_lq,_hm)>=_pb
			break
		_lq:=_nt(_df,_mr,step/10.0)
	_lq
_ia(float _xs)=>
	str.tostring(_xs,'#.##')+'%'
_ql(array<box> _jv,int _li,float _ax,float _aj)=>
	array.clear(_jv)
	if not _le
		for i=0 to _jx-1
			array.push(_jv,box.new(_li,_ax,bar_index,_aj,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gi(array<box> _jv,float _ax,float _aj,int _li,int _sj,color _nw)=>
	_qh=array.size(_jv)
	if _qh > 0 and _ax > _aj
		_gs=(_ax-_aj)/_qh
		for i=0 to _qh-1
			_jo=array.get(_jv,i)
			_nv=math.abs((i+0.5)/_qh-0.5)*2.0
			_ov=int(math.min(99,math.max(0,_gp+(1.0-_nv)*10)))
			box.set_lefttop(_jo,_li,_ax-_gs*i)
			box.set_rightbottom(_jo,_sj,_ax-_gs*(i+1))
			box.set_bgcolor(_jo,color.new(_nw,_ov))
_os(array<box> _jv)=>
	if array.size(_jv)> 0
		for i=0 to array.size(_jv)-1
			box.delete(array.get(_jv,i))
	array.clear(_jv)
_qu(int _rd,float _ax,float _aj,float _co)=>
	_yf=_rd
	if _iw=='Extend to containment'
		_xx=math.min(_il,bar_index)
		_vg=math.max(2,math.round((1.0-_ef)*_rd))
		_mb=0
		_gv=0
		while _gv < _xx and _mb <=_vg
			_mn=close[_gv]<=_ax and close[_gv]>=_aj
			_tf=_mn and high[_gv]<=_ax+_co and low[_gv]>=_aj-_co
			if _mn
				_mb:=math.max(0,_mb-1)
				if _tf and _gv+1 >=_rd
					_yf:=_gv+1
			else
				_mb+=1
			_gv+=1
	_yf
_cl=ta.atr(_km)
_kq=not na(_cl)and _cl > 0
_gk=_mc=='Wick beyond'
_ks=_on=='Wick reaches'
_oa=_lt=='Live bar'
_fv=_oa or barstate.isconfirmed
_gl=_hy(_js)
_kr=_hy(_kc)
_x=chart.bg_color
_r=_bn(_fi,_x,_cg)
_fm=_bn(_cf,_x,_cg)
_gb=_bn(_ch,_x,_cg)
_hi=_bn(_fi,_x,_do)
_fz=_bn(_cf,_x,_do)
_fp=_bn(_ch,_x,_do)
_go(simple int len)=>
	_vk=ta.percentile_linear_interpolation(high,len,_eh)
	_qn=ta.percentile_linear_interpolation(low,len,100.0-_eh)
	_ve=ta.highest(high,len)
	_qq=ta.lowest(low,len)
	_tr=ta.highest(math.max(open,close),len)
	_oy=ta.lowest(math.min(open,close),len)
	top=_bt=='Absolute extremes'?_ve:_bt=='Body extremes'?_tr:_vk
	_lb=_bt=='Absolute extremes'?_qq:_bt=='Body extremes'?_oy:_qn
	_dp=top-_lb
	_ox=_kq and _dp > 0?_dp/(_cl*math.sqrt(len)):99.0
	_sv=bar_index < 1?_ed:int(math.max(1,math.min(_ed,bar_index-_km)))
	_ya=ta.percentrank(_ox,_sv)
	_xl=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xj=_dp > 0?math.abs(_xl)*len/_dp:99.0
	_cw=math.avg(top,_lb)
	_co=_er*nz(_cl)
	_mp=0
	_qj=0
	_iv=0
	_my=0
	for i=0 to len-1
		if(close[i]> _cw)!=(close[i+1]> _cw)
			_mp+=1
		_om=_ks?high[i]>=top-_co:close[i]>=top-_co
		_kd=_ks?low[i]<=_lb+_co:close[i]<=_lb+_co
		if _om
			_qj+=1
		if _kd
			_iv+=1
		if close[i]<=top and close[i]>=_lb
			_my+=1
	_nz=_my/float(len)
	_is=_kq and not na(_ya)and bar_index > len+5 and _ya <=_hq and _mp >=math.max(3,math.round(_ms*len))and _qj >=_jk and _iv >=_jk and _xj <=_rz and _nz >=_ef
	[_is,top,_lb]
bool _ic=false
bool _jd=false
bool _it=false
float _xd=na
float _we=na
float _xb=na
float _pr=na
float _pv=na
float _pi=na
if _bg
	[qa,ta_,ba]=_go(_bm)
	_ic:=qa
	_xd:=ta_
	_pr:=ba
	if _ct !='Base only'
		[qb,tb,bb]=_go(_bm*2)
		_jd:=qb
		_we:=tb
		_pv:=bb
	if _ct=='Base + 2x + 3x'
		[qc,tc,bc]=_go(_bm*3)
		_it:=qc
		_xb:=tc
		_pi:=bc
_et=_ct !='Base only' and _jd
_ev=_ct=='Base + 2x + 3x' and _it
_is=_ic or _et or _ev
_pc=_ev?_bm*3:_et?_bm*2:_bm
_pl=_ev?_xb:_et?_we:_xd
_jb=_ev?_pi:_et?_pv:_pr
var array<box> _at=array.new<box>()
var box _t=na
var line _g=na
var line _k=na
var line _w=na
var label _z=na
var label _au=na
var float _f=na
var float _a=na
var int _c=na
var int _gt=na
var bool _u=false
var bool _l=false
var bool _ba=false
var int _dy=na
var int _p=0
var float _o=na
var int _bf=na
var int _az=0
_cc=false
_cp=false
_bk=false
_bz=false
if _fv and _az > 0
	_az-=1
if _fv and not _u and not _ba and _az <=0 and _is
	_oj=_qu(_pc,_pl,_jb,_er*_cl)
	_c:=bar_index-_oj+1
	_gt:=bar_index
	_f:=_pl
	_a:=_jb
	_u:=true
	_l:=false
	_cw=math.avg(_f,_a)
	_by=_a+(_f-_a)*0.25
	_bc=_a+(_f-_a)*0.75
	_t:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_ql(_at,_c,_f,_a)
	if _he
		_g:=line.new(_c,_cw,bar_index,_cw,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kb
		_k:=line.new(_c,_by,bar_index,_by,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_bc,bar_index,_bc,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _ha
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cb,style=label.style_label_down,textcolor=color.new(_r,10),size=_gl)
	_cc:=true
if _u and _fv
	_cv=_iu*_cl
	_fl=_lk*_cl
	if _hj and not _gk and close <=_f and close >=_a
		if high > _f and high <=_f+_fl
			_f:=high
		if low < _a and low >=_a-_fl
			_a:=low
	_pm=_gk?high > _f+_cv:close > _f+_cv
	_kx=_gk?low < _a-_cv:close < _a-_cv
	_qx=_fj > 0 and bar_index-_gt+1 >=_fj
	if _pm or _kx or _qx
		_b=_pm?1:_kx?-1:0
		_rk=_b !=0?bar_index-_c:bar_index-_c+1
		_nk=_a !=0?(_f-_a)/_a*100.0:0.0
		_jz=_hh and _b !=0 and _l
		if _l
			_fh=_b==1?_fm:_b==-1?_gb:_r
			_op=_b==1?_fz:_b==-1?_fp:_hi
			_iq=_b==1?_cf:_b==-1?_ch:_fi
			box.set_lefttop(_t,_c,_f)
			box.set_rightbottom(_t,bar_index,_a)
			box.set_border_color(_t,color.new(_fh,30))
			box.set_border_style(_t,line.style_dotted)
			_gi(_at,_f,_a,_c,bar_index,na)
			_bj.push(Rango.new(_c,bar_index,_f,_a,_op))
			if _bj.size()> 8
				_bj.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_rk)+' BARS   '+_ia(_nk))
				label.set_textcolor(_z,color.new(_fh,10))
			if _jy and _b !=0
				_nu=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fa
