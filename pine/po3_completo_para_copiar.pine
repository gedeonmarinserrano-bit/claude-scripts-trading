		ul:=na
	t[1]
_bj(array<Zona> arr,string nom,bool _wj)=>
	float _sw=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bi)?z._ah:z._bi
		hi=z.dir==-1 or na(z._bi)?z._ag:z._bi
		d=close >=lo and close <=hi?0.0:_wj?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sw)or d < _sw)
			_sw:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sw,txt]
_qf(table t,int f,string a,string b,color cb,string tam)=>
