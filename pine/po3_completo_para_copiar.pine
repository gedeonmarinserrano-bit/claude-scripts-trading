	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_tv=(z._ag+z._ah)/2
			if low <=_tv and high >=_tv
				_wi:=true
			_jc=na(z._bh)and(z.dir==1?(open >=z._ag and close < z._ah):(open <=z._ah and close > z._ag))
			if _jc
				arr.remove(i)
				_dq.push(Zona.new(z.x1,z._ag,z._ah,-z.dir,na,bar_index))
				if _dq.size()> _gg
					_dq.shift()
			else if _er(z)
				arr.remove(i)
	_wi
