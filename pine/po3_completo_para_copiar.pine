_ie=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_ke)
_jn=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_ke)
_ij=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_ke)
_eq=input.bool(false,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_ke)
_rh=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_ke)
_aq=bar_index >=last_bar_index-_rh
_ck=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_ng=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
