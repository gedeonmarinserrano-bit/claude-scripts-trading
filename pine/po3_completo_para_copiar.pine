_gy="SMT (divergencias entre índices)"
_dx=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_gy)
_lz=input.bool(true,"Mostrar etiquetas de la SMT",group=_gy)
_sh=input.bool(true,"Mostrar línea de la SMT",group=_gy)
_sz=input.bool(true,"Comparar con",inline="smt1",group=_gy)
_qc=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_gy)
_sv=input.bool(true,"Comparar con",inline="smt2",group=_gy)
_pr=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_gy)
