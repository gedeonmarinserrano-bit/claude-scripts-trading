					_vz:=pv
					_wv:=_ml.get(i)
		_uv=(na(_wb)?"↑ —":"↑ "+_wx+" "+str.tostring(_wb,format.mintick)+" (+"+str.tostring(_wb-close,format.mintick)+")")+"  ·  "+(na(_vz)?"↓ —":"↓ "+_wv+" "+str.tostring(_vz,format.mintick)+" (−"+str.tostring(close-_vz,format.mintick)+")")
		_qj(_eg,f,"Liquidez",_uv,#424242,tam)
