_bq(array<Zona> arr,array<Zona> _dp)=>
	_ws=false
	if _dp.size()> 0
		for i=_dp.size()-1 to 0
			if _eu(_dp.get(i))
				_dp.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_tf=(z._ah+z._ai)/2
			if low <=_tf and high >=_tf
				_ws:=true
			_iz=na(z._bi)and(z.dir==1?(open >=z._ah and close < z._ai):(open <=z._ai and close > z._ah))
			if _iz
				arr.remove(i)
				_dp.push(Zona.new(z.x1,z._ah,z._ai,-z.dir,na,bar_index))
				if _dp.size()> _gp
					_dp.shift()
			else if _eu(z)
				arr.remove(i)
	_ws
