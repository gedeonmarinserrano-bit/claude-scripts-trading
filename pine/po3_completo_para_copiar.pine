			if uso.get(0)< 440 and _gj.size()< _lh and(_pq==0 or _yy/close*100 <=_pq)
				_ne(z.x1,bar_index+1,z._ag,z._ah,z.dir,z._bi,color.new(c,_ml),t,c,_sy?color.new(color.white,30):na,_oq,_sj)
