_hg="SMT (divergencias entre índices)"
_dp=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hg)
_lh=input.bool(true,"Mostrar etiquetas de la SMT",group=_hg)
_so=input.bool(true,"Mostrar línea de la SMT",group=_hg)
_st=input.bool(true,"Comparar con",inline="smt1",group=_hg)
_qh=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_hg)
_to=input.bool(true,"Comparar con",inline="smt2",group=_hg)
_ph=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_hg)
_gp=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hg)
_qk=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hg)
_rp=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hg)
_ih=input.color(#ff1100,"SMT bajista (en altos)",group=_hg)
_jq=input.color(#2157f3,"SMT alcista (en bajos)",group=_hg)
_ko(string s)=>
