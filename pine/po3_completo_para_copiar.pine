type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gw(Zona z,float hi,float lo)=>
	_fo=z.dir==1?lo <=z._ah:hi >=z._ai
	if not _fo
		_bi=na(z._bi)?(z.dir==1?z._ai:z._ah):z._bi
		if z.dir==1?lo < _bi:hi > _bi
			z._bi:=z.dir==1?lo:hi
	_fo
_by(array<Zona> fvg,array<Zona> _tv,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xi,float _sc)=>
	_ue=false
	if ah.size()> 0
		_ez=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tv
				n=s.n-z._rk
				if not z._ma and n >=1 and n <=_gu and h1 >=z._ah and l1 <=z._ai
					if k <=_ez
						z._ma:=true
					_ue:=true
			if k <=_ez
				if _tv.size()> 0
					for i=_tv.size()-1 to 0
						if _gw(_tv.get(i),h1,l1)
							_tv.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ai and c1 < z._ah):(o1 <=z._ah and c1 > z._ai))
						if inv
							fvg.remove(i)
							_tv.push(Zona.new(z.x1,z._ai,z._ah,-z.dir,na,s.n))
							if _tv.size()> _xi
								_tv.shift()
						else if _gw(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_sc
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_sc
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xi
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_ue
