	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xu
	bool _rz
var array<Letrero> _gc=array.new<Letrero>()
_je=nz(ta.atr(50))*0.5
_uh=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oz)
_ek=nz(ta.atr(50))*_uh/100
var array<Pieza> _gn=array.new<Pieza>()
_xh(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pn(Pieza p)=>
	res=array.from(p)
	if _kf and _gn.size()> 0
		for o in _gn
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wp=array.new<Pieza>()
				for q in res
					for r in _xh(q,o)
						_wp.push(r)
				res:=_wp
				if res.size()==0 or res.size()> 10
					break
	res
_gq(Pieza p,color col,int dir)=>
	for q in _pn(p)
		top=q.top
		bot=q.bot
		if _ek > 0 and dir !=0
			for o in _gn
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ek
						top:=math.min(top,o.bot-_ek)
					if math.abs(bot-o.top)<=_ek
						bot:=math.max(bot,o.top+_ek)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_ra(q.x1,top,q.x2,bot,col)
_mt(int _vd,int x2,float _ai,float _ah,int dir,float _bi,color col,string txt,color _wa,color _pv,color _ot,bool _rz)=>
	x1=math.max(_vd,bar_index-1000)
	_yl=na(_bi)?_ai:(dir==1?_bi:_ai)
	_ym=na(_bi)?_ah:(dir==1?_ah:_bi)
