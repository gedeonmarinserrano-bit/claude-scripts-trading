_km=input.color(#8D6E63,"Color niveles H1",group=_po)
_qq=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_po)
_dr=input.color(#424242,"Color niveles clave",group=_po)
_ng=input.color(#757575,"Color horas",group=_po)
_eo=input.bool(true,"Mostrar EMAs",group="EMAs")
_od=input.int(9,"EMA rápida",minval=1,group="EMAs")
_ox=input.int(20,"EMA media",minval=1,group="EMAs")
_nw=input.int(200,"EMA lenta",minval=1,group="EMAs")
_op=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_on=input.color(#9E9D24,"Color EMA media",group="EMAs")
_oy=input.color(color.black,"Color EMA lenta",group="EMAs")
_hu=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ii=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fz=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_ke=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ur=14
_rc=50
_th=0.15
_ql=2.5
_qs=30
_ps=1.0
_lr=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oo="Colores"
_aa=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oo)
_t=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oo)
_nh=input.bool(true,"Marcar la vela del OB",group=_oo)
_hh=input.color(#FF00C8,"IFVG (magenta)",group=_oo)
_mf=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oo)
_kc=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oo)
type Zona
	int x1
	float _ah
	float _ag
	int dir
	float _bi=na
	int _re=na
	bool _lg=false
var _hg=array.new<Zona>()
var _ji=array.new<Zona>()
var obs=array.new<Zona>()
var _xn=array.new<Zona>()
var _vm=array.new<Zona>()
var _qv=array.new<Zona>()
var _qh=array.new<Zona>()
var _kf=array.new<Zona>()
var _wh=array.new<Zona>()
var _so=array.new<Zona>()
var _pw=array.new<Zona>()
var _pm=array.new<Zona>()
var _me=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ag
	color col
var _bl=array.new<Rango>()
_et(Zona z)=>
	_fx=z.dir==1?low <=z._ag:high >=z._ah
	if not _fx
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ag):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fx
type Marca
	label lb
	line ln
	int bar
var _ic=array.new<Marca>()
var array<string> _fa=array.from("")
var array<int> _ey=array.from(0)
_ai(label lb,line ln,int bar)=>
	_ic.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fa.set(0,lb.get_text())
		_ey.set(0,bar)
	if _ic.size()> 500
		_ic.shift()
_qm=ta.ema(close,_od)
_qz=ta.ema(close,_ox)
_jd=ta.ema(close,_nw)
_da=ta.atr(_ur)
var string _ts='════════ Detection ════════'
var string _rq='════════ Structure Filters ════════'
var string _un='════════ Range Behavior ════════'
var string _tm='════════ Visual Settings ════════'
_ct='Base + 2x + 3x'
_oz='Rangos'
_bj=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_oz)
_br='Percentile band'
_eh=90.0
_lo='Bar close'
_kr=200
_il=40.0
_ef=500
_mw=0.18
_oa='Wick reaches'
_jh=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_oz)
_em=0.10
_rg=0.45
_eg=0.70
_ih='Extend to containment'
_jk=300
_jv=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_oz)
_he=true
_md=0.25
_lb='Close beyond'
_hw=0.15
_hd=true
_hc=10
_lw=3
_fo=0
_nk='Custom'
_lh=#00A651
_lf=#E4002B
_fg=input.color(#F9A825,'Color del rango (neutral)',group=_oz)
_ju=4
_gc=93
_hf=true
_jx=true
_gx=input.bool(true,'Mostrar etiqueta del rango',group=_oz)
_jw=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_oz)
_hq=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_oz)
_ie='Small'
_fc=true
_jp='Small'
[_cf,_ch]=switch _nk
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lh,_lf]
var color _cd=color.new(color.black,100)
var float _cg=3.0
var float _ds=1.6
_hn(string _vx)=>
	switch _vx
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fe(color _dh)=>
	_iz=color.r(_dh)/255.0
	_ja=color.g(_dh)/255.0
	_jl=color.b(_dh)/255.0
	_sx=_iz <=0.03928?_iz/12.92:math.pow((_iz+0.055)/1.055,2.4)
	_sr=_ja <=0.03928?_ja/12.92:math.pow((_ja+0.055)/1.055,2.4)
	_tj=_jl <=0.03928?_jl/12.92:math.pow((_jl+0.055)/1.055,2.4)
	0.2126*_sx+0.7152*_sr+0.0722*_tj
_lt(color _pb,color _na)=>
	_mr=_fe(_pb)
	_kb=_fe(_na)
	(math.max(_mr,_kb)+0.05)/(math.min(_mr,_kb)+0.05)
_eb(color _hi)=>
	_fe(_hi)> 0.179?#000000:#ffffff
_oi(color _dh,color _mm,float _sf)=>
	color.rgb(color.r(_dh)+(color.r(_mm)-color.r(_dh))*_sf,color.g(_dh)+(color.g(_mm)-color.g(_dh))*_sf,color.b(_dh)+(color.b(_mm)-color.b(_dh))*_sf)
_bk(color _dh,color _hi,float _ot)=>
	_mm=_eb(_hi)
	_ll=_dh
	for step=1 to 10
		if _lt(_ll,_hi)>=_ot
			break
		_ll:=_oi(_dh,_mm,step/10.0)
	_ll
_hz(float _xd)=>
	str.tostring(_xd,'#.##')+'%'
_qr(array<box> _jr,int _ls,float _az,float _am)=>
	array.clear(_jr)
	if not _kc
		for i=0 to _ju-1
			array.push(_jr,box.new(_ls,_az,bar_index,_am,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gj(array<box> _jr,float _az,float _am,int _ls,int _rs,color _np)=>
	_pl=array.size(_jr)
	if _pl > 0 and _az > _am
		_gn=(_az-_am)/_pl
		for i=0 to _pl-1
			_ik=array.get(_jr,i)
			_nt=math.abs((i+0.5)/_pl-0.5)*2.0
			_no=int(math.min(99,math.max(0,_gc+(1.0-_nt)*10)))
			box.set_lefttop(_ik,_ls,_az-_gn*i)
			box.set_rightbottom(_ik,_rs,_az-_gn*(i+1))
			box.set_bgcolor(_ik,color.new(_np,_no))
_ou(array<box> _jr)=>
	if array.size(_jr)> 0
		for i=0 to array.size(_jr)-1
			box.delete(array.get(_jr,i))
	array.clear(_jr)
_qx(int _sb,float _az,float _am,float _cn)=>
	_xw=_sb
	if _ih=='Extend to containment'
		_xj=math.min(_jk,bar_index)
		_vf=math.max(2,math.round((1.0-_eg)*_sb))
		_lu=0
		_gq=0
		while _gq < _xj and _lu <=_vf
			_ml=close[_gq]<=_az and close[_gq]>=_am
			_td=_ml and high[_gq]<=_az+_cn and low[_gq]>=_am-_cn
			if _ml
				_lu:=math.max(0,_lu-1)
				if _td and _gq+1 >=_sb
					_xw:=_gq+1
			else
				_lu+=1
			_gq+=1
	_xw
_cm=ta.atr(_kr)
_ky=not na(_cm)and _cm > 0
_gi=_lb=='Wick beyond'
_ki=_oa=='Wick reaches'
_ov=_lo=='Live bar'
_fm=_ov or barstate.isconfirmed
_gk=_hn(_ie)
_ko=_hn(_jp)
_w=chart.bg_color
_r=_bk(_fg,_w,_cg)
_fv=_bk(_cf,_w,_cg)
_fw=_bk(_ch,_w,_cg)
_hb=_bk(_fg,_w,_ds)
_gb=_bk(_cf,_w,_ds)
_fr=_bk(_ch,_w,_ds)
_gd(simple int len)=>
	_ua=ta.percentile_linear_interpolation(high,len,_eh)
	_qi=ta.percentile_linear_interpolation(low,len,100.0-_eh)
	_ug=ta.highest(high,len)
	_qj=ta.lowest(low,len)
	_tk=ta.highest(math.max(open,close),len)
	_ns=ta.lowest(math.min(open,close),len)
	top=_br=='Absolute extremes'?_ug:_br=='Body extremes'?_tk:_ua
	_kz=_br=='Absolute extremes'?_qj:_br=='Body extremes'?_ns:_qi
	_dw=top-_kz
	_or=_ky and _dw > 0?_dw/(_cm*math.sqrt(len)):99.0
	_tf=bar_index < 1?_ef:int(math.max(1,math.min(_ef,bar_index-_kr)))
	_xz=ta.percentrank(_or,_tf)
	_xp=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xe=_dw > 0?math.abs(_xp)*len/_dw:99.0
	_cu=math.avg(top,_kz)
	_cn=_em*nz(_cm)
	_nm=0
	_qd=0
	_is=0
	_mn=0
	for i=0 to len-1
		if(close[i]> _cu)!=(close[i+1]> _cu)
			_nm+=1
		_nr=_ki?high[i]>=top-_cn:close[i]>=top-_cn
		_ka=_ki?low[i]<=_kz+_cn:close[i]<=_kz+_cn
		if _nr
			_qd+=1
		if _ka
			_is+=1
		if close[i]<=top and close[i]>=_kz
			_mn+=1
	_ob=_mn/float(len)
	_jj=_ky and not na(_xz)and bar_index > len+5 and _xz <=_il and _nm >=math.max(3,math.round(_mw*len))and _qd >=_jh and _is >=_jh and _xe <=_rg and _ob >=_eg
	[_jj,top,_kz]
bool _if=false
bool _it=false
bool _im=false
float _wv=na
float _vv=na
float _vz=na
float _pi=na
float _pv=na
float _qa=na
if _bc
	[qa,ta_,ba]=_gd(_bj)
	_if:=qa
	_wv:=ta_
	_pi:=ba
	if _ct !='Base only'
		[qb,tb,bb]=_gd(_bj*2)
		_it:=qb
		_vv:=tb
		_pv:=bb
	if _ct=='Base + 2x + 3x'
		[qc,tc,bc]=_gd(_bj*3)
		_im:=qc
		_vz:=tc
		_qa:=bc
_ep=_ct !='Base only' and _it
_er=_ct=='Base + 2x + 3x' and _im
_jj=_if or _ep or _er
_ny=_er?_bj*3:_ep?_bj*2:_bj
_qe=_er?_vz:_ep?_vv:_wv
_ib=_er?_qa:_ep?_pv:_pi
var array<box> _at=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _v=na
var label _y=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gt=na
var bool _s=false
var bool _l=false
var bool _ay=false
var int _dt=na
var int _p=0
var float _o=na
var int _bh=na
var int _bf=0
_cc=false
_co=false
_bn=false
_cb=false
if _fm and _bf > 0
	_bf-=1
if _fm and not _s and not _ay and _bf <=0 and _jj
	_nv=_qx(_ny,_qe,_ib,_em*_cm)
	_c:=bar_index-_nv+1
	_gt:=bar_index
	_f:=_qe
	_a:=_ib
	_s:=true
	_l:=false
	_cu=math.avg(_f,_a)
	_bu=_a+(_f-_a)*0.25
	_bg=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qr(_at,_c,_f,_a)
	if _hf
		_g:=line.new(_c,_cu,bar_index,_cu,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jx
		_k:=line.new(_c,_bu,bar_index,_bu,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_v:=line.new(_c,_bg,bar_index,_bg,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gx
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cd,style=label.style_label_down,textcolor=color.new(_r,10),size=_gk)
	_cc:=true
if _s and _fm
	_cq=_hw*_cm
	_fk=_md*_cm
	if _he and not _gi and close <=_f and close >=_a
		if high > _f and high <=_f+_fk
			_f:=high
		if low < _a and low >=_a-_fk
			_a:=low
	_pc=_gi?high > _f+_cq:close > _f+_cq
	_kq=_gi?low < _a-_cq:close < _a-_cq
	_qw=_fo > 0 and bar_index-_gt+1 >=_fo
	if _pc or _kq or _qw
		_b=_pc?1:_kq?-1:0
		_si=_b !=0?bar_index-_c:bar_index-_c+1
		_nl=_a !=0?(_f-_a)/_a*100.0:0.0
		_jt=_hd and _b !=0 and _l
		if _l
			_ff=_b==1?_fv:_b==-1?_fw:_r
			_oc=_b==1?_gb:_b==-1?_fr:_hb
			_ia=_b==1?_cf:_b==-1?_ch:_fg
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_ff,30))
			box.set_border_style(_u,line.style_dotted)
			_gj(_at,_f,_a,_c,bar_index,na)
			_bl.push(Rango.new(_c,bar_index,_f,_a,_oc))
			if _bl.size()> 8
				_bl.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_v,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_si)+' BARS   '+_hz(_nl))
				label.set_textcolor(_y,color.new(_ff,10))
			if _jw and _b !=0
				_pa=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fc
