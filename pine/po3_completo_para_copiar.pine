		f+=1
_eb(array<label> etq,bool _rf,int _vl,float sep)=>
	_ob=_vl
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xv=ys.sort_indices()
		_sz=array.new<float>()
		_rx=array.new<int>()
		_ny=array.new<int>()
		_up=timeframe.in_seconds()*1000
		for j in _xv
			e=etq.get(j)
			y=e.get_y()
			_ru=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_vl
			for _vd=0 to 6
				_sm=false
				if _sz.size()> 0
					for c=0 to _sz.size()-1
						if math.abs(_sz.get(c)-y)< sep and ini < _ny.get(c)and ini+_ru > _rx.get(c)
							ini:=_ny.get(c)
							_sm:=true
				if not _sm
					break
			_sz.push(y)
			_rx.push(ini)
			_ny.push(ini+_ru)
			_ob:=math.max(_ob,ini+_ru)
			if _rf
				e.set_x(time+ini*_up)
			else
				e.set_x(bar_index+ini)
	_ob
if barstate.islast
	_me=array.new<label>()
	for o in _gn
		if not na(o)and not na(o.lb)
			_me.push(o.lb)
	for q in _n
		q.ln.set_x2(bar_index)
		_me.push(q.lb)
	_pg=array.new<label>()
	for n in _dh
		_pg.push(n.lb)
	for n in _dg
		_pg.push(n.lb)
	_ul=_eb(_me,false,1,_fh*0.35)
	_eb(_pg,true,_me.size()> 0?_ul:1,_fh*0.35)
