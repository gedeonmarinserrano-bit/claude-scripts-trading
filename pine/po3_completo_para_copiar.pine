_mw=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_hu)
_dd="FVG por temporalidad (solo se ven los activados)"
_ar=input.bool(true,"FVG H4",inline="fvgtf1",group=_dd)
_az=input.bool(true,"FVG H1",inline="fvgtf1",group=_dd)
_bg=input.bool(true,"FVG M15",inline="fvgtf1",group=_dd)
_bx=input.bool(true,"FVG M5",inline="fvgtf2",group=_dd)
_ct=input.bool(true,"FVG M1",inline="fvgtf2",group=_dd)
_op=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_dd)
_l=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_dd)
_gl=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_dd)
_lm=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_dd)
_qe=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_dd)
_nw="Estructura (CHoCH / BOS)"
_ca=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_nw)
_sz=1.1
_vw=2.0
_vm=20
_tv=2
_nb=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_nw)
_iy=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_nw)
_ji=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_nw)
_jl=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_nw)
_el=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_nw)
_qo=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_nw)
_ba=bar_index >=last_bar_index-_qo
_cm=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_ne=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_aj=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_un="Order Blocks"
_kt=input.bool(true,"Mostrar Order Blocks",group=_un)
_fm=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_un)
_nl=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_un)
_wu=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_un)
_mz=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_un)
_lc=input.color(#1565C0,"OB alcista (demanda)",group=_un)
_kz=input.color(#EF6C00,"OB bajista (oferta)",group=_un)
_pl="Estrategia NY (Bias + PO3)"
_lw=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_pl)
_kk=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_pl)
_tz="Colores FVG"
_ao=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_tz)
_ap=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_tz)
_ru=_ao
_ni=_ao
_my=_ao
_kv=_ao
_kj=_ao
_ig=_ao
_rg=_ap
_mq=_ap
_mt=_ap
_kh=_ap
_ks=_ap
_iu=_ap
_jv=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pl)
_qp=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pl)
_ko=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pl)
_kd=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pl)
_qy=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pl)
_kf=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pl)
_kg=input.color(#8D6E63,"Color niveles H1",group=_pl)
_qu=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_pl)
_ds=input.color(#424242,"Color niveles clave",group=_pl)
_nc=input.color(#757575,"Color horas",group=_pl)
_ef=input.bool(true,"Mostrar EMAs",group="EMAs")
_pa=input.int(9,"EMA rápida",minval=1,group="EMAs")
_oo=input.int(20,"EMA media",minval=1,group="EMAs")
_nt=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ok=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_ox=input.color(#9E9D24,"Color EMA media",group="EMAs")
_pb=input.color(color.black,"Color EMA lenta",group="EMAs")
_jh=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_jc=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_gb=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kr=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ve=14
_sn=50
_to=0.15
_re=2.5
_qv=30
_pt=1.0
_mj=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pe="Colores"
_ad=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pe)
_v=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pe)
_mv=input.bool(true,"Marcar la vela del OB",group=_pe)
_hm=input.color(#FF00C8,"IFVG (magenta)",group=_pe)
_no=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pe)
_kw=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pe)
type Zona
	int x1
	float _ai
	float _ah
	int dir
	float _bi=na
	int _sl=na
	bool _mc=false
var _he=array.new<Zona>()
var _id=array.new<Zona>()
var obs=array.new<Zona>()
var _xt=array.new<Zona>()
var _wa=array.new<Zona>()
var _qz=array.new<Zona>()
var _rd=array.new<Zona>()
var _ld=array.new<Zona>()
var _wj=array.new<Zona>()
var _tb=array.new<Zona>()
var _pp=array.new<Zona>()
var _pv=array.new<Zona>()
var _lg=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ai
	float _ah
	color col
var _bj=array.new<Rango>()
_ew(Zona z)=>
	_ge=z.dir==1?low <=z._ah:high >=z._ai
	if not _ge
		_bi=na(z._bi)?(z.dir==1?z._ai:z._ah):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_ge
type Marca
	label lb
	line ln
	int bar
var _is=array.new<Marca>()
var array<string> _ff=array.from("")
var array<int> _fd=array.from(0)
_ak(label lb,line ln,int bar)=>
	_is.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ff.set(0,lb.get_text())
		_fd.set(0,bar)
	if _is.size()> 500
		_is.shift()
_rc=ta.ema(close,_pa)
_sb=ta.ema(close,_oo)
_im=ta.ema(close,_nt)
_cn=ta.atr(_ve)
var string _uj='════════ Detection ════════'
var string _rm='════════ Structure Filters ════════'
var string _vp='════════ Range Behavior ════════'
var string _ub='════════ Visual Settings ════════'
_cr='Base + 2x + 3x'
_ou='Rangos'
_bk=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_ou)
_bt='Percentile band'
_er=90.0
_lr='Bar close'
_kl=200
_ij=40.0
_et=500
_mp=0.18
_oe='Wick reaches'
_jm=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_ou)
_ep=0.10
_sa=0.45
_ee=0.70
_it='Extend to containment'
_iz=300
_ju=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_ou)
_hf=true
_lq=0.25
_mi='Close beyond'
_ht=0.15
_hc=true
_hj=10
_lu=3
_fn=0
_np='Custom'
_lk=#00A651
_lv=#E4002B
_fj=input.color(#F9A825,'Color del rango (neutral)',group=_ou)
_kb=4
_gn=93
_hi=true
_kc=true
_hd=input.bool(true,'Mostrar etiqueta del rango',group=_ou)
_jw=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_ou)
_hy=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_ou)
_jd='Small'
_fe=true
_jx='Small'
[_ch,_cg]=switch _np
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lk,_lv]
var color _cd=color.new(color.black,100)
var float _cf=3.0
var float _dq=1.6
_hs(string _ww)=>
	switch _ww
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fi(color _di)=>
	_hv=color.r(_di)/255.0
	_jp=color.g(_di)/255.0
	_if=color.b(_di)/255.0
	_tq=_hv <=0.03928?_hv/12.92:math.pow((_hv+0.055)/1.055,2.4)
	_tu=_jp <=0.03928?_jp/12.92:math.pow((_jp+0.055)/1.055,2.4)
	_tj=_if <=0.03928?_if/12.92:math.pow((_if+0.055)/1.055,2.4)
	0.2126*_tq+0.7152*_tu+0.0722*_tj
_lf(color _nv,color _nm)=>
	_ml=_fi(_nv)
	_ki=_fi(_nm)
	(math.max(_ml,_ki)+0.05)/(math.min(_ml,_ki)+0.05)
_ej(color _ho)=>
	_fi(_ho)> 0.179?#000000:#ffffff
_oq(color _di,color _mx,float _rt)=>
	color.rgb(color.r(_di)+(color.r(_mx)-color.r(_di))*_rt,color.g(_di)+(color.g(_mx)-color.g(_di))*_rt,color.b(_di)+(color.b(_mx)-color.b(_di))*_rt)
_bn(color _di,color _ho,float _nu)=>
	_mx=_ej(_ho)
	_lp=_di
	for step=1 to 10
		if _lf(_lp,_ho)>=_nu
			break
		_lp:=_oq(_di,_mx,step/10.0)
	_lp
_jg(float _xz)=>
	str.tostring(_xz,'#.##')+'%'
_qx(array<box> _ka,int _li,float _bh,float _an)=>
	array.clear(_ka)
	if not _kw
		for i=0 to _kb-1
			array.push(_ka,box.new(_li,_bh,bar_index,_an,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gm(array<box> _ka,float _bh,float _an,int _li,int _sk,color _oa)=>
	_px=array.size(_ka)
	if _px > 0 and _bh > _an
		_gq=(_bh-_an)/_px
		for i=0 to _px-1
			_il=array.get(_ka,i)
			_nz=math.abs((i+0.5)/_px-0.5)*2.0
			_nx=int(math.min(99,math.max(0,_gn+(1.0-_nz)*10)))
			box.set_lefttop(_il,_li,_bh-_gq*i)
			box.set_rightbottom(_il,_sk,_bh-_gq*(i+1))
			box.set_bgcolor(_il,color.new(_oa,_nx))
_on(array<box> _ka)=>
	if array.size(_ka)> 0
		for i=0 to array.size(_ka)-1
			box.delete(array.get(_ka,i))
	array.clear(_ka)
_qs(int _rn,float _bh,float _an,float _cj)=>
	_yp=_rn
	if _it=='Extend to containment'
		_xp=math.min(_iz,bar_index)
		_uo=math.max(2,math.round((1.0-_ee)*_rn))
		_lz=0
		_gw=0
		while _gw < _xp and _lz <=_uo
			_mr=close[_gw]<=_bh and close[_gw]>=_an
			_tf=_mr and high[_gw]<=_bh+_cj and low[_gw]>=_an-_cj
			if _mr
				_lz:=math.max(0,_lz-1)
				if _tf and _gw+1 >=_rn
					_yp:=_gw+1
			else
				_lz+=1
			_gw+=1
	_yp
_cl=ta.atr(_kl)
_le=not na(_cl)and _cl > 0
_gf=_mi=='Wick beyond'
_kq=_oe=='Wick reaches'
_ol=_lr=='Live bar'
_fs=_ol or barstate.isconfirmed
_gh=_hs(_jd)
_lb=_hs(_jx)
_y=chart.bg_color
_s=_bn(_fj,_y,_cf)
_fl=_bn(_ch,_y,_cf)
_gc=_bn(_cg,_y,_cf)
_hh=_bn(_fj,_y,_dq)
_fy=_bn(_ch,_y,_dq)
_ft=_bn(_cg,_y,_dq)
_gg(simple int len)=>
	_vt=ta.percentile_linear_interpolation(high,len,_er)
	_rb=ta.percentile_linear_interpolation(low,len,100.0-_er)
	_vr=ta.highest(high,len)
	_qw=ta.lowest(low,len)
	_sx=ta.highest(math.max(open,close),len)
	_oy=ta.lowest(math.min(open,close),len)
	top=_bt=='Absolute extremes'?_vr:_bt=='Body extremes'?_sx:_vt
	_km=_bt=='Absolute extremes'?_qw:_bt=='Body extremes'?_oy:_rb
	_dz=top-_km
	_ov=_le and _dz > 0?_dz/(_cl*math.sqrt(len)):99.0
	_tg=bar_index < 1?_et:int(math.max(1,math.min(_et,bar_index-_kl)))
	_yi=ta.percentrank(_ov,_tg)
	_xv=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xr=_dz > 0?math.abs(_xv)*len/_dz:99.0
	_cw=math.avg(top,_km)
	_cj=_ep*nz(_cl)
	_nj=0
	_po=0
	_jf=0
	_mm=0
	for i=0 to len-1
		if(close[i]> _cw)!=(close[i+1]> _cw)
			_nj+=1
		_ny=_kq?high[i]>=top-_cj:close[i]>=top-_cj
		_jt=_kq?low[i]<=_km+_cj:close[i]<=_km+_cj
		if _ny
			_po+=1
		if _jt
			_jf+=1
		if close[i]<=top and close[i]>=_km
			_mm+=1
	_od=_mm/float(len)
	_jn=_le and not na(_yi)and bar_index > len+5 and _yi <=_ij and _nj >=math.max(3,math.round(_mp*len))and _po >=_jm and _jf >=_jm and _xr <=_sa and _od >=_ee
	[_jn,top,_km]
bool _hz=false
bool _in=false
bool _hx=false
float _xj=na
float _wo=na
float _wp=na
float _pw=na
float _qk=na
float _qn=na
if _ba
	[qa,ta_,ba]=_gg(_bk)
	_hz:=qa
	_xj:=ta_
	_pw:=ba
	if _cr !='Base only'
		[qb,tb,bb]=_gg(_bk*2)
		_in:=qb
		_wo:=tb
		_qk:=bb
	if _cr=='Base + 2x + 3x'
		[qc,tc,bc]=_gg(_bk*3)
		_hx:=qc
		_wp:=tc
		_qn:=bc
_ey=_cr !='Base only' and _in
_ev=_cr=='Base + 2x + 3x' and _hx
_jn=_hz or _ey or _ev
_ob=_ev?_bk*3:_ey?_bk*2:_bk
_qb=_ev?_wp:_ey?_wo:_xj
_ii=_ev?_qn:_ey?_qk:_pw
var array<box> _as=array.new<box>()
var box _t=na
var line _g=na
var line _k=na
var line _x=na
var label _z=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gt=na
var bool _u=false
var bool _m=false
var bool _bd=false
var int _dm=na
var int _p=0
var float _q=na
var int _bf=na
var int _ax=0
_cb=false
_co=false
_bl=false
_bz=false
if _fs and _ax > 0
	_ax-=1
if _fs and not _u and not _bd and _ax <=0 and _jn
	_of=_qs(_ob,_qb,_ii,_ep*_cl)
	_c:=bar_index-_of+1
	_gt:=bar_index
	_f:=_qb
	_a:=_ii
	_u:=true
	_m:=false
	_cw=math.avg(_f,_a)
	_bu=_a+(_f-_a)*0.25
	_bc=_a+(_f-_a)*0.75
	_t:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qx(_as,_c,_f,_a)
	if _hi
		_g:=line.new(_c,_cw,bar_index,_cw,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kc
		_k:=line.new(_c,_bu,bar_index,_bu,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_x:=line.new(_c,_bc,bar_index,_bc,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hd
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cd,style=label.style_label_down,textcolor=color.new(_s,10),size=_gh)
	_cb:=true
if _u and _fs
	_cs=_ht*_cl
	_fo=_lq*_cl
	if _hf and not _gf and close <=_f and close >=_a
		if high > _f and high <=_f+_fo
			_f:=high
		if low < _a and low >=_a-_fo
			_a:=low
	_pn=_gf?high > _f+_cs:close > _f+_cs
	_ky=_gf?low < _a-_cs:close < _a-_cs
	_qr=_fn > 0 and bar_index-_gt+1 >=_fn
	if _pn or _ky or _qr
		_b=_pn?1:_ky?-1:0
		_sc=_b !=0?bar_index-_c:bar_index-_c+1
		_nq=_a !=0?(_f-_a)/_a*100.0:0.0
		_jy=_hc and _b !=0 and _m
		if _m
			_fh=_b==1?_fl:_b==-1?_gc:_s
			_oi=_b==1?_fy:_b==-1?_ft:_hh
			_jk=_b==1?_ch:_b==-1?_cg:_fj
			box.set_lefttop(_t,_c,_f)
			box.set_rightbottom(_t,bar_index,_a)
			box.set_border_color(_t,color.new(_fh,30))
			box.set_border_style(_t,line.style_dotted)
			_gm(_as,_f,_a,_c,bar_index,na)
			_bj.push(Rango.new(_c,bar_index,_f,_a,_oi))
			if _bj.size()> 8
				_bj.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_x,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sc)+' BARS   '+_jg(_nq))
				label.set_textcolor(_z,color.new(_fh,10))
			if _jw and _b !=0
				_pg=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fe
