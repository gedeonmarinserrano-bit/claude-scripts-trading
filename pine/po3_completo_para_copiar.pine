type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _eg=array.new<box>()
var array<line> _df=array.new<line>()
var array<label> _by=array.new<label>()
var array<int> uso=array.from(0,0,0)
_rh(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eg.size()
		b=_eg.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eg.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_od(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _df.size()
		l=_df.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_df.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_ma(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _by.size()
		e=_by.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_by.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _yg
	bool _ss
var array<Letrero> _fv=array.new<Letrero>()
_fh=nz(ta.atr(50))*0.5
_vg=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oz)
_em=nz(ta.atr(50))*_vg/100
var array<Pieza> _gn=array.new<Pieza>()
_xh(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_qn(Pieza p)=>
	res=array.from(p)
	if _kf and _gn.size()> 0
		for o in _gn
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xb=array.new<Pieza>()
				for q in res
					for r in _xh(q,o)
						_xb.push(r)
				res:=_xb
				if res.size()==0 or res.size()> 10
					break
	res
_gw(Pieza p,color col,int dir)=>
	for q in _qn(p)
		top=q.top
		bot=q.bot
		if _em > 0 and dir !=0
			for o in _gn
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_em
						top:=math.min(top,o.bot-_em)
					if math.abs(bot-o.top)<=_em
						bot:=math.max(bot,o.top+_em)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_rh(q.x1,top,q.x2,bot,col)
_nj(int _vt,int x2,float _ag,float _ah,int dir,float _bh,color col,string txt,color _xa,color _pw,color _ok,bool _ss)=>
	x1=math.max(_vt,bar_index-1000)
	_yt=na(_bh)?_ag:(dir==1?_bh:_ag)
	_ys=na(_bh)?_ah:(dir==1?_ah:_bh)
	_gw(Pieza.new(x1,x2,_yt,_ys),col,dir)
	if not na(_bh)
		_gw(Pieza.new(x1,x2,dir==1?_ag:_bh,dir==1?_bh:_ah),_ok,dir)
	if txt !="" and _fv.size()< 60
		_fv.push(Letrero.new(x2,(_yt+_ys)/2,txt,_xa,true,_ss))
	if not na(_pw)
		m=(_ag+_ah)/2
		for q in _qn(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_od(q.x1,q.x2,m,_pw)
	_gn.push(Pieza.new(x1,x2,_ag,_ah,dir))
_az(array<Zona> arr,color _ya,color _xx,int _uj,string txt,bool _yr,bool _tu,color _ok,bool _ss)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_ya:_xx
			t=txt
			_zd=z._ah > close?z._ah-close:close > z._ag?close-z._ag:0.0
			if uso.get(0)< 440 and _gn.size()< _lg and(_qo==0 or _zd/close*100 <=_qo)
				_nj(z.x1,bar_index+1,z._ag,z._ah,z.dir,z._bh,color.new(c,_nc),t,c,_tu?color.new(color.white,30):na,_ok,_ss)
_as()=>
	if _qh
		_az(_is,_hl,_hl,88,"IFVG "+_du,true,false,_am,false)
		_az(_hc,_tp,_th,80,"FVG "+_du,true,false,_am,true)
	_az(obs,_kx,_kq,90,"OB "+_du,true,false,_am,false)
_dd(bool ver,int _wd,array<Zona> f,array<Zona> fi,color ca,color cb,int _uj,string nom)=>
	if ver and not _l and _d !=_wd*60
		_az(fi,_hl,_hl,88,"IFVG "+nom,true,false,_am,false)
		_az(f,ca,cb,_uj,"FVG "+nom,true,_wd >=15,_am,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fv.clear()
	_gn.clear()
	_ae=false
	if _d <=60
		_as()
		_ae:=true
	_dd(_cp,1,_yh,_ww,_nh,_mq,84,"M1")
	if not _ae and _d <=300
		_as()
		_ae:=true
	_dd(_bw,5,_wg,_tb,_nk,_mt,84,"M5")
	if not _ae and _d <=900
		_as()
		_ae:=true
	_dd(_be,15,_rf,_qc,_kz,_ld,84,"M15")
	if not _ae and _d <=3600
		_as()
		_ae:=true
	_dd(_av,60,_qz,_po,_kj,_kv,82,"H1")
	if not _ae and _d <=14400
		_as()
		_ae:=true
	_dd(_aq,240,_kt,_lw,_jg,_ji,80,"H4")
	if not _ae
		_as()
	if _fv.size()> 0
		_np=array.new<Letrero>()
		for l in _fv
			x=l.x
			_st=str.length(l.txt)+2
			for _ux=0 to 3
				_sh=false
				for c in _np
					_ry=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _fh and x > c.x-_ry and x-_st < c.x
						x:=c.x-_ry
						_sh:=true
				if not _sh
					break
			_np.push(Letrero.new(x,l.y,l.txt,l.col,true,l._ss))
			_ma(x,l.y,l.txt,color.white)
	while _eg.size()> uso.get(0)
		_eg.pop().delete()
	while _df.size()> uso.get(1)
		_df.pop().delete()
	while _by.size()> uso.get(2)
		_by.pop().delete()
_qp()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bk(array<Zona> arr,string nom,bool _wq)=>
	float _tc=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bh)?z._ah:z._bh
		hi=z.dir==-1 or na(z._bh)?z._ag:z._bh
		d=close >=lo and close <=hi?0.0:_wq?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_tc)or d < _tc)
			_tc:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_tc,txt]
_ql(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_lm(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_lo(int b)=>
	b==1?_ac:b==-1?_v:#757575
_ws(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wv(string n)=>
	str.contains(n,"alcista")?_ac:str.contains(n,"bajista")?_v:#757575
_sd(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ep=na
if barstate.islast and _mh
	pos=_hv=="Arriba izquierda"?position.top_left:_hv=="Abajo derecha"?position.bottom_right:_hv=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_nr=="Muy pequeño"?size.tiny:_nr=="Normal"?size.normal:size.small
	if na(_ep)
		_ep:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ep.clear(0,0,1,13)
	int f=0
	int _wy=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_wy:=request.security(syminfo.tickerid,"240",_qp(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_qp(),lookahead=barmerge.lookahead_on)
	_ql(_ep,f,"Bias H4",_d < 14400?_lm(_wy):"(gráfico ≥ H4)",_lo(_wy),tam)
	f+=1
	_ql(_ep,f,"Bias H1",_d < 3600?_lm(b60):"(gráfico ≥ H1)",_lo(b60),tam)
	f+=1
	ev=_fd.get(0)
	_xe=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_fc.get(0))+" velas"
	_ql(_ep,f,"Estructura "+_du,_lm(_i)+_xe,_lo(_i),tam)
	f+=1
	tz="America/New_York"
	_wl=hour(timenow,tz)*60+minute(timenow,tz)
	_yi=dayofweek(timenow,tz)
	_yn=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_zf=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_xo=_yi==dayofweek.saturday or _yi==dayofweek.sunday
	_vp=570-_wl
	ses=_xo?"Cerrada (fin de semana)":_wl < 570?"Abre a las "+str.format_time(_yn,"HH:mm","Europe/Madrid")+" (en "+(_vp >=60?str.tostring(int(_vp/60))+" h ":"")+str.tostring(_vp%60)+" min)":_wl < 960?"● Abierta (cierra "+str.format_time(_zf,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yn,"HH:mm","Europe/Madrid")+")"
	_ql(_ep,f,"Sesión NY",ses,not _xo and _wl >=570 and _wl < 960?_ac:#424242,tam)
	f+=1
	float _sz=na
	string _wx=""
	float _ta=na
	string _wp=""
	if _qh
		[d1,t1]=_bk(_hc,"FVG "+_du,true)
		[d2,t2]=_bk(_is,"IFVG "+_du,true)
		[d3,t3]=_bk(_hc,"FVG "+_du,false)
		[d4,t4]=_bk(_is,"IFVG "+_du,false)
		if not na(d1)and(na(_sz)or d1 < _sz)
			_sz:=d1
			_wx:=t1
		if not na(d2)and(na(_sz)or d2 < _sz)
			_sz:=d2
			_wx:=t2
		if not na(d3)and(na(_ta)or d3 < _ta)
			_ta:=d3
			_wp:=t3
		if not na(d4)and(na(_ta)or d4 < _ta)
			_ta:=d4
			_wp:=t4
	if not _l
		for k=0 to 4
			arr=k==0?_yh:k==1?_wg:k==2?_rf:k==3?_qz:_kt
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cp:k==1?_bw:k==2?_be:k==3?_av:_aq
			if ver
				[da,ta_]=_bk(arr,nom,true)
				[db,tb]=_bk(arr,nom,false)
				if not na(da)and(na(_sz)or da < _sz)
					_sz:=da
					_wx:=ta_
				if not na(db)and(na(_ta)or db < _ta)
					_ta:=db
					_wp:=tb
	_ql(_ep,f,"FVG por arriba",_ws(_sz,_wx),_wv(_wx),tam)
	f+=1
	_ql(_ep,f,"FVG por abajo",_ws(_ta,_wp),_wv(_wp),tam)
	f+=1
	_vc=not _dn?"(apagada)":na(_cm)?"Ninguna reciente":(_dv==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cm)+" velas"
	_ql(_ep,f,"SMT",_vc,not _dn or na(_cm)?#757575:_dv==1?_it:_ia,tam)
	f+=1
	if _oe
		_of=request.security(_vy,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mp,_xk,_wn]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_of/16
		pts=_mp*pct/100
		_tf=pts > 0?(_xk-_wn)/pts*100:na
		_uu=na(_of)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_of,"#.#")+") · hoy "+str.tostring(_xk-_wn,"#")+" pts = "+str.tostring(_tf,"#")+" %"
		_ql(_ep,f,"Mov. esperado",_uu,na(_tf)?#757575:_tf >=100?_v:_tf >=75?#EF6C00:#424242,tam)
		f+=1
	if _mc and _ie
		_ql(_ep,f,"Asia",_sd(_ft,_gy,_bj,_jj,_hz),#5E35B1,tam)
		f+=1
		_ql(_ep,f,"Londres",_sd(_li,_my,_dg,_mx,_mr),#1E88E5,tam)
		f+=1
	if _py or _gd
		[_wz,_vs,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _py
			rng=d_h-d_l
			_md=_vs > 0?rng/_vs*100:na
			_ql(_ep,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_vs,"#")+" pts ("+str.tostring(_md,"#")+" %)",na(_md)?#757575:_md >=100?_v:_md >=75?#EF6C00:#424242,tam)
			f+=1
		if _gd
			dif=close-_wz
			_ql(_ep,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_v:_ac,tam)
			f+=1
	if _lp
		float _wf=na
		string _wr=""
		float _we=na
		string _wt=""
		_nq=array.from(pdh,pdl,_jj?na:_ft,_hz?na:_gy,_mx?na:_li,_mr?na:_my)
		_ml=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _dl
			_nq.push(nv._bd)
			_ml.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _dj
			_nq.push(nv._bd)
			_ml.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _do
			_nq.push(q._bd)
			_ml.push(q.dir==1?"EQH":"EQL")
		for i=0 to _nq.size()-1
			pv=_nq.get(i)
			if not na(pv)
				if pv > close and(na(_wf)or pv < _wf)
					_wf:=pv
					_wr:=_ml.get(i)
				if pv < close and(na(_we)or pv > _we)
					_we:=pv
					_wt:=_ml.get(i)
		_ur=(na(_wf)?"↑ —":"↑ "+_wr+" "+str.tostring(_wf,format.mintick)+" (+"+str.tostring(_wf-close,format.mintick)+")")+"  ·  "+(na(_we)?"↓ —":"↓ "+_wt+" "+str.tostring(_we,format.mintick)+" (−"+str.tostring(close-_we,format.mintick)+")")
		_ql(_ep,f,"Liquidez",_ur,#424242,tam)
		f+=1
	if _pu !=""
		_ql(_ep,f,"Noticias hoy",_pu,#EF6C00,tam)
		f+=1
_ec(array<label> etq,array<line> lns,bool _sv,int _wb,float sep)=>
	_nv=_wb
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xu=ys.sort_indices()
		_tk=array.new<float>()
		_ru=array.new<int>()
		_pk=array.new<int>()
		_su=timeframe.in_seconds()*1000
		for j in _xu
			e=etq.get(j)
			y=e.get_y()
			_st=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_wb
			for _ux=0 to 6
				_sh=false
				if _tk.size()> 0
					for c=0 to _tk.size()-1
						if math.abs(_tk.get(c)-y)< sep and ini < _pk.get(c)and ini+_st > _ru.get(c)
							ini:=_pk.get(c)
							_sh:=true
				if not _sh
					break
			_tk.push(y)
			_ru.push(ini)
			_pk.push(ini+_st)
			_nv:=math.max(_nv,ini+_st)
			if _sv
				e.set_x(time+ini*_su)
				lns.get(j).set_x2(time+ini*_su)
			else
				e.set_x(bar_index+ini)
				lns.get(j).set_x2(bar_index+ini)
	_nv
if barstate.islast
	_lh=array.new<label>()
	_oq=array.new<line>()
	for o in _gh
		if not na(o)and not na(o.lb)
			_lh.push(o.lb)
			_oq.push(o.ln)
	for q in _n
		_lh.push(q.lb)
		_oq.push(q.ln)
	_pd=array.new<label>()
	_nx=array.new<line>()
	for n in _dl
		_pd.push(n.lb)
		_nx.push(n.ln)
	for n in _dj
		_pd.push(n.lb)
		_nx.push(n.ln)
	_vq=_ec(_lh,_oq,false,1,_fh*0.35)
	_ec(_pd,_nx,true,_lh.size()> 0?_vq:1,_fh*0.35)
