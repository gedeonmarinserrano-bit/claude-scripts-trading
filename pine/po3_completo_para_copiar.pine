_jz=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pn)
_re=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pn)
_kh=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pn)
