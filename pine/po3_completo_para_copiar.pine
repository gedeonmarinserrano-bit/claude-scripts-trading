_hf="SMT (divergencias entre índices)"
_dt=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hf)
_lt=input.bool(true,"Mostrar etiquetas de la SMT",group=_hf)
_rl=input.bool(true,"Mostrar línea de la SMT",group=_hf)
_tr=input.bool(true,"Comparar con",inline="smt1",group=_hf)
_qk=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_hf)
_tq=input.bool(true,"Comparar con",inline="smt2",group=_hf)
_pj=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_hf)
_gk=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hf)
_qg=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hf)
_rn=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hf)
_jg=input.color(#ff1100,"SMT bajista (en altos)",group=_hf)
_id=input.color(#2157f3,"SMT alcista (en bajos)",group=_hf)
_ld(string s)=>
	_uj=str.split(s,":")
