	_qk:=h_
	_qa:=l_
	_rn:=hb_
	_sc:=lb_
_ni=ta.pivothigh(high,_gj,_gj)
_nm=ta.pivotlow(low,_gj,_gj)
_qw=bar_index-_gj
var int _hp=na
var float _ga=na
var float _jm=na
var float _ix=na
var int _hl=na
var float _gc=na
var float _jr=na
var float _jf=na
var array<line> _gh=array.new<line>()
var array<label> _gn=array.new<label>()
_dw(float y,float _ut,float c,float _nj,bool _ok)=>
	_uh=_ok?y > _ut:y < _ut
	_uk=_ok?c > _nj:c < _nj
	not na(_ut)and not na(_nj)and not na(c)and _uh !=_uk
_fy(string t,float c,float _nj)=>
	t+(c > _nj?" ↑":c < _nj?" ↓":" =")
_kv(int x1,float y1,int xv,string txt,color col,bool _ok)=>
	yv=_ok?high[bar_index-xv]:low[bar_index-xv]
	if _rp
		_gh.push(line.new(x1,y1,xv,yv,color=col))
	if _mh
		_gn.push(label.new(xv,yv,txt,style=_ok?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_ok?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_ok?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gh.size()> _rj
		_gh.shift().delete()
	if _gn.size()> _rj
		_gn.shift().delete()
var int _ci=na
var int _dv=0
_iy=false
_ih=false
if barstate.isconfirmed
	if not na(_ni)
		_sd=not na(_hp)and _qw-_hp <=_qf
		d1=_sd and _oq and _dw(_ni,_ga,_pk,_jm,true)
