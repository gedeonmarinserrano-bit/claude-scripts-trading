_by=input.bool(true,"FVG M5",inline="fvgtf2",group=_dd)
_cu=input.bool(true,"FVG M1",inline="fvgtf2",group=_dd)
_os=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_dd)
_m=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_dd)
_gg=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_dd)
_lg=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_dd)
_qa=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_dd)
_nx="Estructura (CHoCH / BOS)"
_cd=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_nx)
_ts=1.1
_vu=2.0
_vo=20
_tf=2
_mm=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_nx)
_jj=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_nx)
_ja=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_nx)
_ht=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_nx)
_en=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_nx)
_qu=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_nx)
_be=bar_index >=last_bar_index-_qu
_co=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_nj=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_ak=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_uq="Order Blocks"
