_mt=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_uz)
_wh=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_uz)
_mw=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_uz)
_ky=input.color(#1565C0,"OB alcista (demanda)",group=_uz)
