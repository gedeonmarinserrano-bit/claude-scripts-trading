	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xq
	bool _sm
var array<Letrero> _fu=array.new<Letrero>()
_jo=nz(ta.atr(50))*0.5
_uu=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oe)
_ei=nz(ta.atr(50))*_uu/100
var array<Pieza> _ge=array.new<Pieza>()
_wc(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_qh(Pieza p)=>
	res=array.from(p)
	if _kd and _ge.size()> 0
		for o in _ge
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wh=array.new<Pieza>()
				for q in res
					for r in _wc(q,o)
						_wh.push(r)
				res:=_wh
				if res.size()==0 or res.size()> 10
					break
	res
_gr(Pieza p,color col,int dir)=>
	for q in _qh(p)
		top=q.top
		bot=q.bot
		if _ei > 0 and dir !=0
			for o in _ge
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ei
						top:=math.min(top,o.bot-_ei)
					if math.abs(bot-o.top)<=_ei
						bot:=math.max(bot,o.top+_ei)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qz(q.x1,top,q.x2,bot,col)
_mx(int _uf,int x2,float _ah,float _ag,int dir,float _bi,color col,string txt,color _wr,color _qe,color _ol,bool _sm)=>
	x1=math.max(_uf,bar_index-1000)
	_ye=na(_bi)?_ah:(dir==1?_bi:_ah)
	_xx=na(_bi)?_ag:(dir==1?_ag:_bi)
	_gr(Pieza.new(x1,x2,_ye,_xx),col,dir)
	if not na(_bi)
		_gr(Pieza.new(x1,x2,dir==1?_ah:_bi,dir==1?_bi:_ag),_ol,dir)
	if txt !="" and _fu.size()< 60
		_fu.push(Letrero.new(x2,(_ye+_xx)/2,txt,_wr,true,_sm))
	if not na(_qe)
		m=(_ah+_ag)/2
		for q in _qh(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_pd(q.x1,q.x2,m,_qe)
	_ge.push(Pieza.new(x1,x2,_ah,_ag,dir))
_bf(array<Zona> arr,color _xv,color _xr,int _tw,string txt,bool _yg,bool _tm,color _ol,bool _sm)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xv:_xr
			t=txt
			_yt=z._ag > close?z._ag-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _ge.size()< _ls and(_pz==0 or _yt/close*100 <=_pz)
				_mx(z.x1,bar_index+1,z._ah,z._ag,z.dir,z._bi,color.new(c,_mv),t,c,_tm?color.new(color.white,30):na,_ol,_sm)
_au()=>
	if _po
		_bf(_hq,_hi,_hi,88,"IFVG "+_dx,true,false,_am,false)
		_bf(_gz,_sv,_th,80,"FVG "+_dx,true,false,_am,true)
	_bf(obs,_kl,_kq,90,"OB "+_dx,true,false,_am,false)
_dg(bool ver,int _vs,array<Zona> f,array<Zona> fi,color ca,color cb,int _tw,string nom)=>
	if ver and not _l and _d !=_vs*60
		_bf(fi,_hi,_hi,88,"IFVG "+nom,true,false,_am,false)
		_bf(f,ca,cb,_tw,"FVG "+nom,true,_vs >=15,_am,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fu.clear()
	_ge.clear()
	_ae=false
	if _d <=60
		_au()
		_ae:=true
	_dg(_cv,1,_xk,_wp,_mr,_mo,84,"M1")
	if not _ae and _d <=300
		_au()
		_ae:=true
	_dg(_bv,5,_vq,_td,_nh,_nk,84,"M5")
	if not _ae and _d <=900
		_au()
		_ae:=true
	_dg(_aw,15,_qo,_pk,_kg,_lc,84,"M15")
	if not _ae and _d <=3600
		_au()
		_ae:=true
	_dg(_ax,60,_qj,_pn,_ke,_kr,82,"H1")
	if not _ae and _d <=14400
		_au()
		_ae:=true
	_dg(_ar,240,_kx,_lf,_hr,_jf,80,"H4")
	if not _ae
		_au()
	if _fu.size()> 0
		_my=array.new<Letrero>()
		for l in _fu
			x=l.x
			_tc=str.length(l.txt)+2
			for _va=0 to 3
				_rf=false
				for c in _my
					_sf=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _jo and x > c.x-_sf and x-_tc < c.x
						x:=c.x-_sf
						_rf:=true
				if not _rf
					break
			_my.push(Letrero.new(x,l.y,l.txt,l.col,true,l._sm))
			_lo(x,l.y,l.txt,color.white)
	while _eh.size()> uso.get(0)
		_eh.pop().delete()
	while _di.size()> uso.get(1)
		_di.pop().delete()
	while _bx.size()> uso.get(2)
		_bx.pop().delete()
_qf()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bj(array<Zona> arr,string nom,bool _wz)=>
	float _sr=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bi)?z._ag:z._bi
		hi=z.dir==-1 or na(z._bi)?z._ah:z._bi
		d=close >=lo and close <=hi?0.0:_wz?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sr)or d < _sr)
			_sr:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sr,txt]
_pe(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_ly(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_mg(int b)=>
	b==1?_z:b==-1?_u:#757575
_xc(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_xb(string n)=>
	str.contains(n,"alcista")?_z:str.contains(n,"bajista")?_u:#757575
_rx(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ed=na
if barstate.islast and _lq
	pos=_hp=="Arriba izquierda"?position.top_left:_hp=="Abajo derecha"?position.bottom_right:_hp=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_nm=="Muy pequeño"?size.tiny:_nm=="Normal"?size.normal:size.small
	if na(_ed)
		_ed:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ed.clear(0,0,1,13)
	int f=0
	int _xf=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_xf:=request.security(syminfo.tickerid,"240",_qf(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_qf(),lookahead=barmerge.lookahead_on)
	_pe(_ed,f,"Bias H4",_d < 14400?_ly(_xf):"(gráfico ≥ H4)",_mg(_xf),tam)
	f+=1
	_pe(_ed,f,"Bias H1",_d < 3600?_ly(b60):"(gráfico ≥ H1)",_mg(b60),tam)
	f+=1
	ev=_ey.get(0)
	_xd=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_fa.get(0))+" velas"
	_pe(_ed,f,"Estructura "+_dx,_ly(_i)+_xd,_mg(_i),tam)
	f+=1
	tz="America/New_York"
	_wv=hour(timenow,tz)*60+minute(timenow,tz)
	_yf=dayofweek(timenow,tz)
	_yi=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yo=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_vw=_yf==dayofweek.saturday or _yf==dayofweek.sunday
	_vk=570-_wv
	ses=_vw?"Cerrada (fin de semana)":_wv < 570?"Abre a las "+str.format_time(_yi,"HH:mm","Europe/Madrid")+" (en "+(_vk >=60?str.tostring(int(_vk/60))+" h ":"")+str.tostring(_vk%60)+" min)":_wv < 960?"● Abierta (cierra "+str.format_time(_yo,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yi,"HH:mm","Europe/Madrid")+")"
	_pe(_ed,f,"Sesión NY",ses,not _vw and _wv >=570 and _wv < 960?_z:#424242,tam)
	f+=1
	float _sp=na
	string _vz=""
	float _so=na
	string _wb=""
	if _po
		[d1,t1]=_bj(_gz,"FVG "+_dx,true)
		[d2,t2]=_bj(_hq,"IFVG "+_dx,true)
		[d3,t3]=_bj(_gz,"FVG "+_dx,false)
		[d4,t4]=_bj(_hq,"IFVG "+_dx,false)
		if not na(d1)and(na(_sp)or d1 < _sp)
			_sp:=d1
			_vz:=t1
		if not na(d2)and(na(_sp)or d2 < _sp)
			_sp:=d2
			_vz:=t2
		if not na(d3)and(na(_so)or d3 < _so)
			_so:=d3
			_wb:=t3
		if not na(d4)and(na(_so)or d4 < _so)
			_so:=d4
			_wb:=t4
	if not _l
		for k=0 to 4
			arr=k==0?_xk:k==1?_vq:k==2?_qo:k==3?_qj:_kx
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cv:k==1?_bv:k==2?_aw:k==3?_ax:_ar
			if ver
				[da,ta_]=_bj(arr,nom,true)
				[db,tb]=_bj(arr,nom,false)
				if not na(da)and(na(_sp)or da < _sp)
					_sp:=da
					_vz:=ta_
				if not na(db)and(na(_so)or db < _so)
					_so:=db
					_wb:=tb
	_pe(_ed,f,"FVG por arriba",_xc(_sp,_vz),_xb(_vz),tam)
	f+=1
	_pe(_ed,f,"FVG por abajo",_xc(_so,_wb),_xb(_wb),tam)
	f+=1
	_vf=not _do?"(apagada)":na(_cp)?"Ninguna reciente":(_dm==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cp)+" velas"
	_pe(_ed,f,"SMT",_vf,not _do or na(_cp)?#757575:_dm==1?_ir:_hu,tam)
	f+=1
	if _oz
		_oq=request.security(_up,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mu,_wq,_wo]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_oq/16
		pts=_mu*pct/100
		_sz=pts > 0?(_wq-_wo)/pts*100:na
		_vn=na(_oq)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_oq,"#.#")+") · hoy "+str.tostring(_wq-_wo,"#")+" pts = "+str.tostring(_sz,"#")+" %"
		_pe(_ed,f,"Mov. esperado",_vn,na(_sz)?#757575:_sz >=100?_u:_sz >=75?#EF6C00:#424242,tam)
		f+=1
	if _lh and _ix
		_pe(_ed,f,"Asia",_rx(_fs,_gt,_as,_iq,_im),#5E35B1,tam)
		f+=1
		_pe(_ed,f,"Londres",_rx(_lg,_nc,_cm,_ni,_ms),#1E88E5,tam)
		f+=1
	if _pm or _fp
		[_wk,_ve,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _pm
			rng=d_h-d_l
			_lx=_ve > 0?rng/_ve*100:na
			_pe(_ed,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_ve,"#")+" pts ("+str.tostring(_lx,"#")+" %)",na(_lx)?#757575:_lx >=100?_u:_lx >=75?#EF6C00:#424242,tam)
			f+=1
		if _fp
			dif=close-_wk
			_pe(_ed,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_u:_z,tam)
			f+=1
	if _mh
		float _vu=na
		string _wx=""
		float _vr=na
		string _ww=""
		_nl=array.from(pdh,pdl,_iq?na:_fs,_im?na:_gt,_ni?na:_lg,_ms?na:_nc)
		_na=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _dj
			_nl.push(nv._ap)
			_na.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _dk
			_nl.push(nv._ap)
			_na.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dn
			_nl.push(q._ap)
			_na.push(q.dir==1?"EQH":"EQL")
		for i=0 to _nl.size()-1
			pv=_nl.get(i)
			if not na(pv)
				if pv > close and(na(_vu)or pv < _vu)
					_vu:=pv
					_wx:=_na.get(i)
				if pv < close and(na(_vr)or pv > _vr)
					_vr:=pv
					_ww:=_na.get(i)
		_uz=(na(_vu)?"↑ —":"↑ "+_wx+" "+str.tostring(_vu,format.mintick)+" (+"+str.tostring(_vu-close,format.mintick)+")")+"  ·  "+(na(_vr)?"↓ —":"↓ "+_ww+" "+str.tostring(_vr,format.mintick)+" (−"+str.tostring(close-_vr,format.mintick)+")")
		_pe(_ed,f,"Liquidez",_uz,#424242,tam)
		f+=1
	if _pj !=""
		_pe(_ed,f,"Noticias hoy",_pj,#EF6C00,tam)
		f+=1
if barstate.islast
	etq=array.new<label>()
	_fj=array.new<bool>()
	for o in _lm
		if not na(o)and not na(o.lb)
			etq.push(o.lb)
			_fj.push(false)
	for n in _dj
		etq.push(n.lb)
		_fj.push(true)
	for n in _dk
		etq.push(n.lb)
		_fj.push(true)
	if etq.size()> 1
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xt=ys.sort_indices()
		_tr=array.new<float>()
		_rn=array.new<int>()
		_nw=array.new<int>()
		_vc=timeframe.in_seconds()*1000
		for j in _xt
			e=etq.get(j)
			y=e.get_y()
			_tc=str.length(e.get_text())+2
			ini=0
			for _va=0 to 6
				_rf=false
				if _tr.size()> 0
					for c=0 to _tr.size()-1
						if math.abs(_tr.get(c)-y)< _jo and ini < _nw.get(c)and ini+_tc > _rn.get(c)
							ini:=_nw.get(c)
							_rf:=true
				if not _rf
					break
			_tr.push(y)
			_rn.push(ini)
			_nw.push(ini+_tc)
			if _fj.get(j)
				e.set_x(time+ini*_vc)
			else
				e.set_x(bar_index+ini)
