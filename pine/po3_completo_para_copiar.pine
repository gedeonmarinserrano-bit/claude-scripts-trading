_dr(float y,float _ur,float c,float _mw,bool _os)=>
	_vv=_os?y > _ur:y < _ur
	_vk=_os?c > _mw:c < _mw
	not na(_ur)and not na(_mw)and not na(c)and _vv !=_vk
_fj(string t,float c,float _mw)=>
	t+(c > _mw?" ↑":c < _mw?" ↓":" =")
_lc(int x1,float y1,int xv,string txt,color col,bool _os)=>
	yv=_os?high[bar_index-xv]:low[bar_index-xv]
	if _sd
