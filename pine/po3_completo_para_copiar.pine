		n.ln.delete()
		n.lb.delete()
if _bu and _jg and timeframe.isintraday and _ju < 14400
	if _bd.size()> 0
		for i=_bd.size()-1 to 0
			n=_bd.get(i)
			if(n.dir==1 and close > n._im)or(n.dir==-1 and close < n._im)
				n.ln.delete()
				n.lb.delete()
				_bd.remove(i)
			else
				n.ln.set_x2(time)
				n.lb.set_x(time)
	if _ly
