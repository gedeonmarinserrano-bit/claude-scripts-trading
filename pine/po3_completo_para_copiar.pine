_au=bar_index >=last_bar_index-_qt
_ck=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_nd=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
