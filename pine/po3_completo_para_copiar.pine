			o._ap:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
		else if not na(o._we)and bar_index-o._we <=5
			nv=dir==1?math.max(o._ap,high):math.min(o._ap,low)
			o._ap:=nv
			o.ln.set_y1(nv)
			o.ln.set_y2(nv)
