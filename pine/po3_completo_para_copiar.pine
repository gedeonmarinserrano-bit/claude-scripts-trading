type Letrero
	int x
	float y
	string txt
	color col
	bool _ya
	bool _rr
var array<Letrero> _fs=array.new<Letrero>()
_fe=nz(ta.atr(50))*0.5
_vi=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_og)
_ep=nz(ta.atr(50))*_vi/100
var array<Pieza> _ge=array.new<Pieza>()
_ws(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pl(Pieza p)=>
	res=array.from(p)
	if _kq and _ge.size()> 0
		for o in _ge
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wt=array.new<Pieza>()
				for q in res
					for r in _ws(q,o)
						_wt.push(r)
				res:=_wt
				if res.size()==0 or res.size()> 10
					break
	res
_gz(Pieza p,color col,int dir)=>
	for q in _pl(p)
		top=q.top
		bot=q.bot
		if _ep > 0 and dir !=0
			for o in _ge
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ep
						top:=math.min(top,o.bot-_ep)
					if math.abs(bot-o.top)<=_ep
						bot:=math.max(bot,o.top+_ep)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qy(q.x1,top,q.x2,bot,col)
_nd(int _ul,int x2,float _ah,float _ag,int dir,float _bh,color col,string txt,color _wr,color _pj,color _pf,bool _rr)=>
	x1=math.max(_ul,bar_index-1000)
	_yd=na(_bh)?_ah:(dir==1?_bh:_ah)
	_yj=na(_bh)?_ag:(dir==1?_ag:_bh)
	_gz(Pieza.new(x1,x2,_yd,_yj),col,dir)
	if not na(_bh)
		_gz(Pieza.new(x1,x2,dir==1?_ah:_bh,dir==1?_bh:_ag),_pf,dir)
	if txt !="" and _fs.size()< 60
		_fs.push(Letrero.new(x2,(_yd+_yj)/2,txt,_wr,true,_rr))
	if not na(_pj)
		m=(_ah+_ag)/2
		for q in _pl(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nu(q.x1,q.x2,m,_pj)
	_ge.push(Pieza.new(x1,x2,_ah,_ag,dir))
_aw(array<Zona> arr,color _xt,color _xz,int _ui,string txt,bool _yi,bool _th,color _pf,bool _rr)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xt:_xz
			t=txt
			_yy=z._ag > close?z._ag-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _ge.size()< _lr and(_qb==0 or _yy/close*100 <=_qb)
				_nd(z.x1,bar_index+1,z._ah,z._ag,z.dir,z._bh,color.new(c,_mq),t,c,_th?color.new(color.white,30):na,_pf,_rr)
_as()=>
	if _pr
		_aw(_iv,_hl,_hl,88,"IFVG "+_dm,true,false,_ak,false)
		_aw(_hf,_tq,_tk,80,"FVG "+_dm,true,false,_ak,true)
	_aw(obs,_kx,_km,90,"OB "+_dm,true,false,_ak,false)
_dd(bool ver,int _wc,array<Zona> f,array<Zona> fi,color ca,color cb,int _ui,string nom)=>
	if ver and not _m and _d !=_wc*60
		_aw(fi,_hl,_hl,88,"IFVG "+nom,true,false,_ak,false)
		_aw(f,ca,cb,_ui,"FVG "+nom,true,_wc >=15,_ak,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fs.clear()
	_ge.clear()
	_ae=false
	if _d <=60
		_as()
		_ae:=true
	_dd(_cu,1,_xp,_xk,_mo,_nk,84,"M1")
	if not _ae and _d <=300
		_as()
		_ae:=true
	_dd(_bw,5,_vz,_sw,_mm,_ni,84,"M5")
	if not _ae and _d <=900
		_as()
		_ae:=true
	_dd(_bb,15,_qt,_qi,_kl,_ku,84,"M15")
	if not _ae and _d <=3600
		_as()
		_ae:=true
	_dd(_az,60,_qp,_pm,_ld,_kh,82,"H1")
	if not _ae and _d <=14400
		_as()
		_ae:=true
	_dd(_aq,240,_la,_lv,_jl,_it,80,"H4")
	if not _ae
		_as()
	if _fs.size()> 0
		_mz=array.new<Letrero>()
		for l in _fs
			x=l.x
			_sc=str.length(l.txt)+2
			for _vr=0 to 3
				_sn=false
				for c in _mz
					_sh=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _fe and x > c.x-_sh and x-_sc < c.x
						x:=c.x-_sh
						_sn:=true
				if not _sn
					break
			_mz.push(Letrero.new(x,l.y,l.txt,l.col,true,l._rr))
			_li(x,l.y,l.txt,color.white)
	while _ef.size()> uso.get(0)
		_ef.pop().delete()
	while _dj.size()> uso.get(1)
		_dj.pop().delete()
	while _bu.size()> uso.get(2)
		_bu.pop().delete()
_qe()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bn(array<Zona> arr,string nom,bool _wn)=>
	float _tn=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bh)?z._ag:z._bh
		hi=z.dir==-1 or na(z._bh)?z._ah:z._bh
		d=close >=lo and close <=hi?0.0:_wn?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_tn)or d < _tn)
			_tn:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_tn,txt]
_qn(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_me(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_mb(int b)=>
	b==1?_ad:b==-1?_u:#757575
_wy(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_xl(string n)=>
	str.contains(n,"alcista")?_ad:str.contains(n,"bajista")?_u:#757575
_rj(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _eh=na
if barstate.islast and _lo
	pos=_jb=="Arriba izquierda"?position.top_left:_jb=="Abajo derecha"?position.bottom_right:_jb=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_nm=="Muy pequeño"?size.tiny:_nm=="Normal"?size.normal:size.small
	if na(_eh)
		_eh:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_eh.clear(0,0,1,13)
	int f=0
	int _xm=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_xm:=request.security(syminfo.tickerid,"240",_qe(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_qe(),lookahead=barmerge.lookahead_on)
	_qn(_eh,f,"Bias H4",_d < 14400?_me(_xm):"(gráfico ≥ H4)",_mb(_xm),tam)
	f+=1
	_qn(_eh,f,"Bias H1",_d < 3600?_me(b60):"(gráfico ≥ H1)",_mb(b60),tam)
	f+=1
	ev=_fa.get(0)
	_xb=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_fb.get(0))+" velas"
	_qn(_eh,f,"Estructura "+_dm,_me(_i)+_xb,_mb(_i),tam)
	f+=1
	tz="America/New_York"
	_xe=hour(timenow,tz)*60+minute(timenow,tz)
	_yn=dayofweek(timenow,tz)
	_yl=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yt=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_ww=_yn==dayofweek.saturday or _yn==dayofweek.sunday
	_vu=570-_xe
	ses=_ww?"Cerrada (fin de semana)":_xe < 570?"Abre a las "+str.format_time(_yl,"HH:mm","Europe/Madrid")+" (en "+(_vu >=60?str.tostring(int(_vu/60))+" h ":"")+str.tostring(_vu%60)+" min)":_xe < 960?"● Abierta (cierra "+str.format_time(_yt,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yl,"HH:mm","Europe/Madrid")+")"
	_qn(_eh,f,"Sesión NY",ses,not _ww and _xe >=570 and _xe < 960?_ad:#424242,tam)
	f+=1
	float _sv=na
	string _xj=""
	float _su=na
	string _wu=""
	if _pr
		[d1,t1]=_bn(_hf,"FVG "+_dm,true)
		[d2,t2]=_bn(_iv,"IFVG "+_dm,true)
		[d3,t3]=_bn(_hf,"FVG "+_dm,false)
		[d4,t4]=_bn(_iv,"IFVG "+_dm,false)
		if not na(d1)and(na(_sv)or d1 < _sv)
			_sv:=d1
			_xj:=t1
		if not na(d2)and(na(_sv)or d2 < _sv)
			_sv:=d2
			_xj:=t2
		if not na(d3)and(na(_su)or d3 < _su)
			_su:=d3
			_wu:=t3
		if not na(d4)and(na(_su)or d4 < _su)
			_su:=d4
			_wu:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_xp:k==1?_vz:k==2?_qt:k==3?_qp:_la
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cu:k==1?_bw:k==2?_bb:k==3?_az:_aq
			if ver
				[da,ta_]=_bn(arr,nom,true)
				[db,tb]=_bn(arr,nom,false)
				if not na(da)and(na(_sv)or da < _sv)
					_sv:=da
					_xj:=ta_
				if not na(db)and(na(_su)or db < _su)
					_su:=db
					_wu:=tb
	_qn(_eh,f,"FVG por arriba",_wy(_sv,_xj),_xl(_xj),tam)
	f+=1
	_qn(_eh,f,"FVG por abajo",_wy(_su,_wu),_xl(_wu),tam)
	f+=1
	_um=not _du?"(apagada)":na(_cl)?"Ninguna reciente":(_dx==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cl)+" velas"
	_qn(_eh,f,"SMT",_um,not _du or na(_cl)?#757575:_dx==1?_hv:_js,tam)
	f+=1
	if _oj
		_oo=request.security(_va,"D",close[1],lookahead=barmerge.lookahead_on)
		[_no,_xd,_xa]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_oo/16
		pts=_no*pct/100
		_sx=pts > 0?(_xd-_xa)/pts*100:na
		_uv=na(_oo)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_oo,"#.#")+") · hoy "+str.tostring(_xd-_xa,"#")+" pts = "+str.tostring(_sx,"#")+" %"
		_qn(_eh,f,"Mov. esperado",_uv,na(_sx)?#757575:_sx >=100?_u:_sx >=75?#EF6C00:#424242,tam)
		f+=1
	if _lj and _ia
		_qn(_eh,f,"Asia",_rj(_gd,_gt,_bj,_hu,_jf),#5E35B1,tam)
		f+=1
		_qn(_eh,f,"Londres",_rj(_ma,_ms,_di,_mx,_ng),#1E88E5,tam)
		f+=1
	if _px or _fy
		[_wm,_vx,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _px
			rng=d_h-d_l
			_ly=_vx > 0?rng/_vx*100:na
			_qn(_eh,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_vx,"#")+" pts ("+str.tostring(_ly,"#")+" %)",na(_ly)?#757575:_ly >=100?_u:_ly >=75?#EF6C00:#424242,tam)
			f+=1
		if _fy
			dif=close-_wm
			_qn(_eh,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_u:_ad,tam)
			f+=1
	if _mj
		float _wb=na
		string _wd=""
		float _vy=na
		string _wz=""
		_ne=array.from(pdh,pdl,_hu?na:_gd,_jf?na:_gt,_mx?na:_ma,_ng?na:_ms)
		_ns=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _dh
			_ne.push(nv._au)
			_ns.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _df
			_ne.push(nv._au)
			_ns.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dn
			_ne.push(q._au)
			_ns.push(q.dir==1?"EQH":"EQL")
		for i=0 to _ne.size()-1
			pv=_ne.get(i)
			if not na(pv)
				if pv > close and(na(_wb)or pv < _wb)
					_wb:=pv
					_wd:=_ns.get(i)
				if pv < close and(na(_vy)or pv > _vy)
					_vy:=pv
					_wz:=_ns.get(i)
		_uz=(na(_wb)?"↑ —":"↑ "+_wd+" "+str.tostring(_wb,format.mintick)+" (+"+str.tostring(_wb-close,format.mintick)+")")+"  ·  "+(na(_vy)?"↓ —":"↓ "+_wz+" "+str.tostring(_vy,format.mintick)+" (−"+str.tostring(close-_vy,format.mintick)+")")
		_qn(_eh,f,"Liquidez",_uz,#424242,tam)
		f+=1
	if _qk !=""
		_qn(_eh,f,"Noticias hoy",_qk,#EF6C00,tam)
		f+=1
_eb(array<label> etq,bool _sj,int _ur,float sep)=>
	_pa=_ur
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xw=ys.sort_indices()
		_tt=array.new<float>()
		_sl=array.new<int>()
		_on=array.new<int>()
		_vk=timeframe.in_seconds()*1000
		for j in _xw
			e=etq.get(j)
			y=e.get_y()
			_sc=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_ur
			for _vr=0 to 6
				_sn=false
				if _tt.size()> 0
					for c=0 to _tt.size()-1
						if math.abs(_tt.get(c)-y)< sep and ini < _on.get(c)and ini+_sc > _sl.get(c)
							ini:=_on.get(c)
							_sn:=true
				if not _sn
					break
			_tt.push(y)
			_sl.push(ini)
			_on.push(ini+_sc)
			_pa:=math.max(_pa,ini+_sc)
			if _sj
				e.set_x(time+ini*_vk)
			else
				e.set_x(bar_index+ini)
	_pa
if barstate.islast
	_mg=array.new<label>()
	for o in _gi
		if not na(o)and not na(o.lb)
			_mg.push(o.lb)
	for q in _n
		q.ln.set_x2(bar_index)
		_mg.push(q.lb)
	_oh=array.new<label>()
	for n in _dh
		_oh.push(n.lb)
	for n in _df
		_oh.push(n.lb)
	_ux=_eb(_mg,false,1,_fe*0.35)
	_eb(_oh,true,_mg.size()> 0?_ux:1,_fe*0.35)
