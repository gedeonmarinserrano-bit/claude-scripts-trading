_gg=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cw)
_lw=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cw)
_qd=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cw)
_or="Estructura (CHoCH / BOS)"
_cc=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_or)
_tl=1.1
_vc=2.0
_uv=20
_ta=2
_nf=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_or)
_hv=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_or)
_ij=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_or)
_jh=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_or)
_eo=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_or)
_rb=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_or)
_ba=bar_index >=last_bar_index-_rb
_ci=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mr=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_aj=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_vn="Order Blocks"
_kr=input.bool(true,"Mostrar Order Blocks",group=_vn)
