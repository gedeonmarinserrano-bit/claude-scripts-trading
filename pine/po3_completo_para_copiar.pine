_sl=_kn(_ps)
_sm=_kn(_pz)
_wv=str.replace(_sl,"1!","")
_xj=str.replace(_sm,"1!","")
_ug=str.replace(syminfo.ticker,"1!","")
_ou=_dm and _td and _wv !=_ug
_ph=_dm and _tw and _xj !=_ug
_rz()=>
	w=2*_gn+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _qe=na
float _qn=na
int _sk=na
int _so=na
float _qf=na
float _qc=na
int _sp=na
int _su=na
if _ou and _ay
