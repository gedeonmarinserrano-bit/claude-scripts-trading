			_eh.push(label.new(bar_index,_vb?high:low,"Barrido "+nom,style=_vb?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _eh.size()> 20
				_eh.shift().delete()
type Igual
	line ln
