_sy=input.int(10,"Máx. Order Blocks vigentes",minval=1,maxval=50,group=_sh)
_la=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_sh)
_jd=input.color(#1565C0,"OB alcista (demanda)",group=_sh)
_jc=input.color(#EF6C00,"OB bajista (oferta)",group=_sh)
_qa="Estrategia NY (Bias + PO3)"
