_hm="SMT (divergencias entre índices)"
_dq=input.bool(true,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hm)
_mh=input.bool(true,"Mostrar etiquetas de la SMT",group=_hm)
_sw=input.bool(true,"Mostrar línea de la SMT",group=_hm)
_tl=input.bool(true,"Comparar con",inline="smt1",group=_hm)
_pr=input.symbol("CME_MINI:MES1!","",inline="smt1",group=_hm)
_ti=input.bool(true,"Comparar con",inline="smt2",group=_hm)
_qb=input.symbol("CME_MINI:MNQ1!","",inline="smt2",group=_hm)
_gk=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hm)
_qn=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hm)
_sy=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hm)
_jk=input.color(#ff1100,"SMT bajista (en altos)",group=_hm)
_js=input.color(#2157f3,"SMT alcista (en bajos)",group=_hm)
_kp(string s)=>
	_ui=str.split(s,":")
	_ui.size()> 0?_ui.last():s
_sx=_kp(_pr)
_sc=_kp(_qb)
_xa=str.replace(_sx,"1!","")
_wt=str.replace(_sc,"1!","")
_uu=str.replace(syminfo.ticker,"1!","")
_oz=_dq and _tl and _xa !=_uu
_ph=_dq and _ti and _wt !=_uu
_sd()=>
	w=2*_gk+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _ps=na
float _qs=na
int _ry=na
int _si=na
float _qg=na
float _qq=na
int _sm=na
int _sa=na
if _oz and _aq
	[h_,l_,hb_,lb_]=request.security(_pr,timeframe.period,_sd(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_ps:=h_
	_qs:=l_
	_ry:=hb_
	_si:=lb_
if _ph and _aq
	[h_,l_,hb_,lb_]=request.security(_qb,timeframe.period,_sd(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_qg:=h_
	_qq:=l_
	_sm:=hb_
	_sa:=lb_
_ne=ta.pivothigh(high,_gk,_gk)
_np=ta.pivotlow(low,_gk,_gk)
_qu=bar_index-_gk
var int _hr=na
var float _fk=na
var float _jj=na
var float _jm=na
var int _hq=na
var float _fz=na
var float _jy=na
var float _ju=na
var array<line> _gj=array.new<line>()
var array<label> _gq=array.new<label>()
_dp(float y,float _vw,float c,float _nf,bool _pl)=>
	_vd=_pl?y > _vw:y < _vw
	_vq=_pl?c > _nf:c < _nf
	not na(_vw)and not na(_nf)and not na(c)and _vd !=_vq
_fs(string t,float c,float _nf)=>
	t+(c > _nf?" ↑":c < _nf?" ↓":" =")
_lb(int x1,float y1,int xv,string txt,color col,bool _pl)=>
	yv=_pl?high[bar_index-xv]:low[bar_index-xv]
	if _sw
		_gj.push(line.new(x1,y1,xv,yv,color=col))
	if _mh
		_gq.push(label.new(xv,yv,txt,style=_pl?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_pl?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_pl?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gj.size()> _sy
		_gj.shift().delete()
	if _gq.size()> _sy
		_gq.shift().delete()
var int _ci=na
var int _dm=0
_ji=false
_iq=false
if barstate.isconfirmed
	if not na(_ne)
		_sp=not na(_hr)and _qu-_hr <=_qn
		d1=_sp and _oz and _dp(_ne,_fk,_ps,_jj,true)
		d2=_sp and _ph and _dp(_ne,_fk,_qg,_jm,true)
		if d1 or d2
			_ji:=true
			_ci:=bar_index
			_dm:=-1
			_jp=_ne > _fk
			xv=_jp?_qu:bar_index+int(d1?_ry:_sm)
			t1=_fs(_sx,_ps,_jj)
			t2=_fs(_sc,_qg,_jm)
			_lb(_hr,_fk,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jk,true)
		_hr:=_qu
		_fk:=_ne
		_jj:=_ps
		_jm:=_qg
	if not na(_np)
		_sp=not na(_hq)and _qu-_hq <=_qn
		d1=_sp and _oz and _dp(_np,_fz,_qs,_jy,false)
		d2=_sp and _ph and _dp(_np,_fz,_qq,_ju,false)
		if d1 or d2
			_iq:=true
			_ci:=bar_index
			_dm:=1
			_jp=_np < _fz
			xv=_jp?_qu:bar_index+int(d1?_si:_sa)
			t1=_fs(_sx,_qs,_jy)
			t2=_fs(_sc,_qq,_ju)
			_lb(_hq,_fz,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_js,false)
		_hq:=_qu
		_fz:=_np
		_jy:=_qs
		_ju:=_qq
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ef=array.new<box>()
var array<line> _dg=array.new<line>()
var array<label> _bt=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qv(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ef.size()
		b=_ef.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ef.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_oh(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dg.size()
		l=_dg.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dg.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_mt(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bt.size()
		e=_bt.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bt.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _yt
	bool _tb
var array<Letrero> _ft=array.new<Letrero>()
_ff=nz(ta.atr(50))*0.5
_vs=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_pi)
_ee=nz(ta.atr(50))*_vs/100
var array<Pieza> _gs=array.new<Pieza>()
_xp(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_qc(Pieza p)=>
	res=array.from(p)
	if _qw and _gs.size()> 0
		for o in _gs
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xw=array.new<Pieza>()
				for q in res
					for r in _xp(q,o)
						_xw.push(r)
				res:=_xw
				if res.size()==0 or res.size()> 10
					break
	res
_ha(Pieza p,color col,int dir)=>
	for q in _qc(p)
		top=q.top
		bot=q.bot
		if _ee > 0 and dir !=0
			for o in _gs
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ee
						top:=math.min(top,o.bot-_ee)
					if math.abs(bot-o.top)<=_ee
						bot:=math.max(bot,o.top+_ee)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qv(q.x1,top,q.x2,bot,col)
