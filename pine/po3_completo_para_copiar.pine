if _mj and _ay and _ie and _bf
	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_ft:k==3?_gy:k==4?_li:_my
		_zg=k < 2 or(k < 4?not _bj:not _dg)
		_wh=k%2==0
		if _zg and not na(nv)and not _aa.get(k)and(_wh?high > nv and close < nv:low < nv and close > nv)
			_aa.set(k,true)
			nom=(k < 2?(_wh?"PDH":"PDL"):k < 4?(_wh?"Alto Asia":"Bajo Asia"):(_wh?"Alto Londres":"Bajo Londres"))
			_eq.push(label.new(bar_index,_wh?high:low,"Barrido "+nom,style=_wh?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _eq.size()> 20
				_eq.shift().delete()
type Igual
	line ln
	label lb
	float _bd
	int dir
var array<Igual> _do=array.new<Igual>()
var float _tw=na
var int _pq=na
var float _tn=na
var int _qe=na
_ul=nz(_cv)*0.1
_tr=ta.pivothigh(high,_cd,_cd)
_uc=ta.pivotlow(low,_cd,_cd)
if _si and _bf and timeframe.isintraday
	if not na(_tr)
		x=bar_index-_cd
		if not na(_tw)and math.abs(_tr-_tw)<=_ul and x-_pq <=150
