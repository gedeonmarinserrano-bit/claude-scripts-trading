_gx="SMT (divergencias entre índices)"
_dk=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_gx)
_lj=input.bool(true,"Mostrar etiquetas de la SMT",group=_gx)
_qp=input.bool(true,"Mostrar línea de la SMT",group=_gx)
_sn=input.bool(true,"Comparar con",inline="smt1",group=_gx)
_oq=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_gx)
