	_ab.set(5,false)
if _mg and _az and _hr and _be
	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_gd:k==3?_gw:k==4?_lk:_mp
		_zb=k < 2 or(k < 4?not _as:not _cn)
		_vz=k%2==0
		if _zb and not na(nv)and not _ab.get(k)and(_vz?high > nv and close < nv:low < nv and close > nv)
			_ab.set(k,true)
