_br(array<Zona> arr,array<Zona> _dr)=>
	_wi=false
	if _dr.size()> 0
		for i=_dr.size()-1 to 0
			if _ew(_dr.get(i))
				_dr.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_tm=(z._ai+z._ah)/2
			if low <=_tm and high >=_tm
				_wi:=true
			_ic=na(z._bi)and(z.dir==1?(open >=z._ai and close < z._ah):(open <=z._ah and close > z._ai))
			if _ic
