type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gu(Zona z,float hi,float lo)=>
	_ge=z.dir==1?lo <=z._ah:hi >=z._ai
	if not _ge
		_bi=na(z._bi)?(z.dir==1?z._ai:z._ah):z._bi
		if z.dir==1?lo < _bi:hi > _bi
			z._bi:=z.dir==1?lo:hi
	_ge
_by(array<Zona> fvg,array<Zona> _uh,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xo,float _rl)=>
	_ud=false
	if ah.size()> 0
		_fg=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _uh
				n=s.n-z._sl
				if not z._mc and n >=1 and n <=_gs and h1 >=z._ah and l1 <=z._ai
					if k <=_fg
						z._mc:=true
					_ud:=true
			if k <=_fg
				if _uh.size()> 0
					for i=_uh.size()-1 to 0
						if _gu(_uh.get(i),h1,l1)
							_uh.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ai and c1 < z._ah):(o1 <=z._ah and c1 > z._ai))
						if inv
							fvg.remove(i)
							_uh.push(Zona.new(z.x1,z._ai,z._ah,-z.dir,na,s.n))
							if _uh.size()> _xo
								_uh.shift()
						else if _gu(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rl
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rl
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xo
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_ud
