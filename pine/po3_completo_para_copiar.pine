		string _we=""
		float _vz=na
		string _xh=""
		_mn=array.from(pdh,pdl,_jp?na:_gd,_ig?na:_gx,_nn?na:_lz,_na?na:_nl)
		_mv=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _dk
			_mn.push(nv._av)
			_mv.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _dl
			_mn.push(nv._av)
			_mv.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _du
			_mn.push(q._av)
			_mv.push(q.dir==1?"EQH":"EQL")
		for i=0 to _mn.size()-1
			pv=_mn.get(i)
			if not na(pv)
				if pv > close and(na(_wb)or pv < _wb)
					_wb:=pv
					_we:=_mv.get(i)
				if pv < close and(na(_vz)or pv > _vz)
					_vz:=pv
					_xh:=_mv.get(i)
		_vj=(na(_wb)?"↑ —":"↑ "+_we+" "+str.tostring(_wb,format.mintick)+" (+"+str.tostring(_wb-close,format.mintick)+")")+"  ·  "+(na(_vz)?"↓ —":"↓ "+_xh+" "+str.tostring(_vz,format.mintick)+" (−"+str.tostring(close-_vz,format.mintick)+")")
		_qk(_ef,f,"Liquidez",_vj,#424242,tam)
		f+=1
	if _qa !=""
		_qk(_ef,f,"Noticias hoy",_qa,#EF6C00,tam)
		f+=1
_ec(array<label> etq,bool _sj,int _vq,float sep)=>
	_pa=_vq
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xp=ys.sort_indices()
		_te=array.new<float>()
		_sl=array.new<int>()
		_oc=array.new<int>()
		_vu=timeframe.in_seconds()*1000
		for j in _xp
			e=etq.get(j)
			y=e.get_y()
			_sq=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_vq
			for _vg=0 to 6
				_rq=false
				if _te.size()> 0
					for c=0 to _te.size()-1
						if math.abs(_te.get(c)-y)< sep and ini < _oc.get(c)and ini+_sq > _sl.get(c)
							ini:=_oc.get(c)
							_rq:=true
				if not _rq
					break
			_te.push(y)
			_sl.push(ini)
			_oc.push(ini+_sq)
			_pa:=math.max(_pa,ini+_sq)
			if _sj
				e.set_x(time+ini*_vu)
			else
				e.set_x(bar_index+ini)
	_pa
if barstate.islast
	_li=array.new<label>()
	for o in _gp
		if not na(o)and not na(o.lb)
			_li.push(o.lb)
	for q in _n
		q.ln.set_x2(bar_index)
		_li.push(q.lb)
	_om=array.new<label>()
	for n in _dk
		_om.push(n.lb)
	for n in _dl
		_om.push(n.lb)
	_ur=_ec(_li,false,1,_fg*0.35)
	_ec(_om,true,_li.size()> 0?_ur:1,_fg*0.35)
