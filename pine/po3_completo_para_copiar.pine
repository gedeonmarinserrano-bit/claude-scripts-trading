var array<label> _gd=array.new<label>()
_dw(float y,float _uy,float c,float _mu,bool _oa)=>
	_uh=_oa?y > _uy:y < _uy
	_uv=_oa?c > _mu:c < _mu
	not na(_uy)and not na(_mu)and not na(c)and _uh !=_uv
_fn(string t,float c,float _mu)=>
	t+(c > _mu?" ↑":c < _mu?" ↓":" =")
_km(int x1,float y1,int xv,string txt,color col,bool _oa)=>
	yv=_oa?high[bar_index-xv]:low[bar_index-xv]
	if _rd
