_kg=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qb)
_jt=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_qb)
_qp=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_qb)
