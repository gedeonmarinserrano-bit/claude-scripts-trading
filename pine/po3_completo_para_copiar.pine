_ph=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_gy)
_se=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_gy)
_ho=input.color(#ff1100,"SMT bajista (en altos)",group=_gy)
_jn=input.color(#2157f3,"SMT alcista (en bajos)",group=_gy)
_ku(string s)=>
