_kg=input.color(#8D6E63,"Color niveles H1",group=_qm)
_rc=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qm)
_ds=input.color(#424242,"Color niveles clave",group=_qm)
_nl=input.color(#757575,"Color horas",group=_qm)
_eo=input.bool(true,"Mostrar EMAs",group="EMAs")
_ot=input.int(9,"EMA rápida",minval=1,group="EMAs")
_or=input.int(20,"EMA media",minval=1,group="EMAs")
_ph=input.int(200,"EMA lenta",minval=1,group="EMAs")
_op=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_os=input.color(#9E9D24,"Color EMA media",group="EMAs")
_pg=input.color(color.black,"Color EMA lenta",group="EMAs")
_hx=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ij=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fr=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_lc=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_uq=14
_se=50
_tc=0.15
_qr=2.5
_qs=30
_po=1.0
_lx=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_og="Colores"
_ad=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_og)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_og)
_my=input.bool(true,"Marcar la vela del OB",group=_og)
_hl=input.color(#FF00C8,"IFVG (magenta)",group=_og)
_mq=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_og)
_kq=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_og)
type Zona
	int x1
	float _ah
	float _ag
	int dir
	float _bh=na
	int _sb=na
	bool _lh=false
var _hf=array.new<Zona>()
var _iv=array.new<Zona>()
var obs=array.new<Zona>()
var _xp=array.new<Zona>()
var _vz=array.new<Zona>()
var _qt=array.new<Zona>()
var _qp=array.new<Zona>()
var _la=array.new<Zona>()
var _xk=array.new<Zona>()
var _sw=array.new<Zona>()
var _qi=array.new<Zona>()
var _pm=array.new<Zona>()
var _lv=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ag
	color col
var _bm=array.new<Rango>()
_eu(Zona z)=>
	_fv=z.dir==1?low <=z._ag:high >=z._ah
	if not _fv
		_bh=na(z._bh)?(z.dir==1?z._ah:z._ag):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_fv
type Marca
	label lb
	line ln
	int bar
var _iw=array.new<Marca>()
var array<string> _fa=array.from("")
var array<int> _fb=array.from(0)
_ai(label lb,line ln,int bar)=>
	_iw.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fa.set(0,lb.get_text())
		_fb.set(0,bar)
	if _iw.size()> 500
		_iw.shift()
_qo=ta.ema(close,_ot)
_sp=ta.ema(close,_or)
_jd=ta.ema(close,_ph)
_cz=ta.atr(_uq)
var string _tx='════════ Detection ════════'
var string _rl='════════ Structure Filters ════════'
var string _uo='════════ Range Behavior ════════'
var string _ud='════════ Visual Settings ════════'
_cr='Base + 2x + 3x'
_nv='Rangos'
_bl=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_nv)
_br='Percentile band'
_ej=90.0
_lz='Bar close'
_kk=200
_hs=40.0
_en=500
_ml=0.18
_ow='Wick reaches'
_id=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_nv)
_ei=0.10
_st=0.45
_eg=0.70
_if='Extend to containment'
_ip=300
_jw=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_nv)
_hb=true
_lw=0.25
_md='Close beyond'
_ib=0.15
_ha=true
_hi=10
_lu=3
_fu=0
_mv='Custom'
_lf=#00A651
_lk=#E4002B
_fh=input.color(#F9A825,'Color del rango (neutral)',group=_nv)
_jv=4
_go=93
_hh=true
_jz=true
_hj=input.bool(true,'Mostrar etiqueta del rango',group=_nv)
_kc=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_nv)
_ic=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_nv)
_ii='Small'
_fd=true
_jt='Small'
[_cg,_ch]=switch _mv
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lf,_lk]
var color _ca=color.new(color.black,100)
var float _cf=3.0
var float _dv=1.6
_iq(string _wv)=>
	switch _wv
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ff(color _dk)=>
	_ht=color.r(_dk)/255.0
	_jj=color.g(_dk)/255.0
	_hw=color.b(_dk)/255.0
	_tu=_ht <=0.03928?_ht/12.92:math.pow((_ht+0.055)/1.055,2.4)
	_tb=_jj <=0.03928?_jj/12.92:math.pow((_jj+0.055)/1.055,2.4)
	_tl=_hw <=0.03928?_hw/12.92:math.pow((_hw+0.055)/1.055,2.4)
	0.2126*_tu+0.7152*_tb+0.0722*_tl
_ln(color _oe,color _mr)=>
	_mp=_ff(_oe)
	_kz=_ff(_mr)
	(math.max(_mp,_kz)+0.05)/(math.min(_mp,_kz)+0.05)
_eq(color _hm)=>
	_ff(_hm)> 0.179?#000000:#ffffff
_ok(color _dk,color _mn,float _rx)=>
	color.rgb(color.r(_dk)+(color.r(_mn)-color.r(_dk))*_rx,color.g(_dk)+(color.g(_mn)-color.g(_dk))*_rx,color.b(_dk)+(color.b(_mn)-color.b(_dk))*_rx)
_bk(color _dk,color _hm,float _ny)=>
	_mn=_eq(_hm)
	_mi=_dk
	for step=1 to 10
		if _ln(_mi,_hm)>=_ny
			break
		_mi:=_ok(_dk,_mn,step/10.0)
	_mi
_jo(float _yc)=>
	str.tostring(_yc,'#.##')+'%'
_ra(array<box> _kd,int _mk,float _ax,float _am)=>
	array.clear(_kd)
	if not _kq
		for i=0 to _jv-1
			array.push(_kd,box.new(_mk,_ax,bar_index,_am,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gf(array<box> _kd,float _ax,float _am,int _mk,int _ro,color _pi)=>
	_py=array.size(_kd)
	if _py > 0 and _ax > _am
		_gu=(_ax-_am)/_py
		for i=0 to _py-1
			_ie=array.get(_kd,i)
			_ob=math.abs((i+0.5)/_py-0.5)*2.0
			_nt=int(math.min(99,math.max(0,_go+(1.0-_ob)*10)))
			box.set_lefttop(_ie,_mk,_ax-_gu*i)
			box.set_rightbottom(_ie,_ro,_ax-_gu*(i+1))
			box.set_bgcolor(_ie,color.new(_pi,_nt))
_pd(array<box> _kd)=>
	if array.size(_kd)> 0
		for i=0 to array.size(_kd)-1
			box.delete(array.get(_kd,i))
	array.clear(_kd)
_qv(int _rk,float _ax,float _am,float _ci)=>
	_ye=_rk
	if _if=='Extend to containment'
		_yb=math.min(_ip,bar_index)
		_vh=math.max(2,math.round((1.0-_eg)*_rk))
		_lt=0
		_gr=0
		while _gr < _yb and _lt <=_vh
			_nf=close[_gr]<=_ax and close[_gr]>=_am
			_tr=_nf and high[_gr]<=_ax+_ci and low[_gr]>=_am-_ci
			if _nf
				_lt:=math.max(0,_lt-1)
				if _tr and _gr+1 >=_rk
					_ye:=_gr+1
			else
				_lt+=1
			_gr+=1
	_ye
_cm=ta.atr(_kk)
_kw=not na(_cm)and _cm > 0
_gh=_md=='Wick beyond'
_ky=_ow=='Wick reaches'
_ov=_lz=='Live bar'
_gb=_ov or barstate.isconfirmed
_gm=_iq(_ii)
_kj=_iq(_jt)
_x=chart.bg_color
_s=_bk(_fh,_x,_cf)
_fo=_bk(_cg,_x,_cf)
_fw=_bk(_ch,_x,_cf)
_hg=_bk(_fh,_x,_dv)
_fj=_bk(_cg,_x,_dv)
_fm=_bk(_ch,_x,_dv)
_gl(simple int len)=>
	_vo=ta.percentile_linear_interpolation(high,len,_ej)
	_qz=ta.percentile_linear_interpolation(low,len,100.0-_ej)
	_ut=ta.highest(high,len)
	_re=ta.lowest(low,len)
	_tg=ta.highest(math.max(open,close),len)
	_oq=ta.lowest(math.min(open,close),len)
	top=_br=='Absolute extremes'?_ut:_br=='Body extremes'?_tg:_vo
	_kv=_br=='Absolute extremes'?_re:_br=='Body extremes'?_oq:_qz
	_do=top-_kv
	_oi=_kw and _do > 0?_do/(_cm*math.sqrt(len)):99.0
	_tm=bar_index < 1?_en:int(math.max(1,math.min(_en,bar_index-_kk)))
	_yp=ta.percentrank(_oi,_tm)
	_xs=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xq=_do > 0?math.abs(_xs)*len/_do:99.0
	_cs=math.avg(top,_kv)
	_ci=_ei*nz(_cm)
	_nh=0
	_pn=0
	_hr=0
	_nq=0
	for i=0 to len-1
		if(close[i]> _cs)!=(close[i+1]> _cs)
			_nh+=1
		_ox=_ky?high[i]>=top-_ci:close[i]>=top-_ci
		_ju=_ky?low[i]<=_kv+_ci:close[i]<=_kv+_ci
		if _ox
			_pn+=1
		if _ju
			_hr+=1
		if close[i]<=top and close[i]>=_kv
			_nq+=1
	_oc=_nq/float(len)
	_is=_kw and not na(_yp)and bar_index > len+5 and _yp <=_hs and _nh >=math.max(3,math.round(_ml*len))and _pn >=_id and _hr >=_id and _xq <=_st and _oc >=_eg
	[_is,top,_kv]
bool _jn=false
bool _jm=false
bool _jk=false
float _xi=na
float _wl=na
float _xc=na
float _pz=na
float _pw=na
float _pk=na
if _av
	[qa,ta_,ba]=_gl(_bl)
	_jn:=qa
	_xi:=ta_
	_pz:=ba
	if _cr !='Base only'
		[qb,tb,bb]=_gl(_bl*2)
		_jm:=qb
		_wl:=tb
		_pw:=bb
	if _cr=='Base + 2x + 3x'
		[qc,tc,bc]=_gl(_bl*3)
		_jk:=qc
		_xc:=tc
		_pk:=bc
_es=_cr !='Base only' and _jm
_er=_cr=='Base + 2x + 3x' and _jk
_is=_jn or _es or _er
_oy=_er?_bl*3:_es?_bl*2:_bl
_pv=_er?_xc:_es?_wl:_xi
_iu=_er?_pk:_es?_pw:_pz
var array<box> _ar=array.new<box>()
var box _v=na
var line _g=na
var line _k=na
var line _y=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _gy=na
var bool _t=false
var bool _l=false
var bool _bd=false
var int _dt=na
var int _q=0
var float _p=na
var int _ay=na
var int _be=0
_bz=false
_ck=false
_bi=false
_cb=false
if _gb and _be > 0
	_be-=1
if _gb and not _t and not _bd and _be <=0 and _is
	_pe=_qv(_oy,_pv,_iu,_ei*_cm)
	_c:=bar_index-_pe+1
	_gy:=bar_index
	_f:=_pv
	_a:=_iu
	_t:=true
	_l:=false
	_cs=math.avg(_f,_a)
	_bv=_a+(_f-_a)*0.25
	_bc=_a+(_f-_a)*0.75
	_v:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_ra(_ar,_c,_f,_a)
	if _hh
		_g:=line.new(_c,_cs,bar_index,_cs,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jz
		_k:=line.new(_c,_bv,bar_index,_bv,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_y:=line.new(_c,_bc,bar_index,_bc,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hj
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_ca,style=label.style_label_down,textcolor=color.new(_s,10),size=_gm)
	_bz:=true
if _t and _gb
	_cq=_ib*_cm
	_fi=_lw*_cm
	if _hb and not _gh and close <=_f and close >=_a
		if high > _f and high <=_f+_fi
			_f:=high
		if low < _a and low >=_a-_fi
			_a:=low
	_pt=_gh?high > _f+_cq:close > _f+_cq
	_le=_gh?low < _a-_cq:close < _a-_cq
	_qq=_fu > 0 and bar_index-_gy+1 >=_fu
	if _pt or _le or _qq
		_b=_pt?1:_le?-1:0
		_rh=_b !=0?bar_index-_c:bar_index-_c+1
		_nn=_a !=0?(_f-_a)/_a*100.0:0.0
		_kb=_ha and _b !=0 and _l
		if _l
			_fg=_b==1?_fo:_b==-1?_fw:_s
			_oz=_b==1?_fj:_b==-1?_fm:_hg
			_il=_b==1?_cg:_b==-1?_ch:_fh
			box.set_lefttop(_v,_c,_f)
			box.set_rightbottom(_v,bar_index,_a)
			box.set_border_color(_v,color.new(_fg,30))
			box.set_border_style(_v,line.style_dotted)
			_gf(_ar,_f,_a,_c,bar_index,na)
			_bm.push(Rango.new(_c,bar_index,_f,_a,_oz))
			if _bm.size()> 8
				_bm.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_y,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_rh)+' BARS   '+_jo(_nn))
				label.set_textcolor(_z,color.new(_fg,10))
			if _kc and _b !=0
				_nw=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fd
