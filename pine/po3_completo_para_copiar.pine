		f+=1
		_qk(_ef,f,"Londres",_rn(_lz,_nl,_dg,_nn,_na),#1E88E5,tam)
		f+=1
	if _px or _fz
		[_xa,_vt,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _px
			rng=d_h-d_l
			_lq=_vt > 0?rng/_vt*100:na
			_qk(_ef,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_vt,"#")+" pts ("+str.tostring(_lq,"#")+" %)",na(_lq)?#757575:_lq >=100?_t:_lq >=75?#EF6C00:#424242,tam)
			f+=1
		if _fz
