	not na(_vb)and not na(_mr)and not na(c)and _va !=_uq
_fs(string t,float c,float _mr)=>
	t+(c > _mr?" ↑":c < _mr?" ↓":" =")
_km(int x1,float y1,int xv,string txt,color col,bool _nr)=>
	yv=_nr?high[bar_index-xv]:low[bar_index-xv]
	if _rw
		_gj.push(line.new(x1,y1,xv,yv,color=col))
