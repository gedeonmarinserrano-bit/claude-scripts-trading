var array<box> _ek=array.new<box>()
var array<line> _di=array.new<line>()
var array<label> _bv=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qu(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ek.size()
		b=_ek.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ek.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_nz(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _di.size()
		l=_di.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_di.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_le(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bv.size()
		e=_bv.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bv.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xk
	bool _sa
var array<Letrero> _fs=array.new<Letrero>()
_nq=nz(ta.atr(50))*0.5
_ve=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oo)
_ee=nz(ta.atr(50))*_ve/100
var array<Pieza> _gl=array.new<Pieza>()
_vn(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_py(Pieza p)=>
	res=array.from(p)
	if _kc and _gl.size()> 0
		for o in _gl
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wm=array.new<Pieza>()
				for q in res
					for r in _vn(q,o)
						_wm.push(r)
				res:=_wm
				if res.size()==0 or res.size()> 10
					break
	res
_gr(Pieza p,color col,int dir)=>
	for q in _py(p)
		top=q.top
		bot=q.bot
		if _ee > 0 and dir !=0
			for o in _gl
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ee
						top:=math.min(top,o.bot-_ee)
					if math.abs(bot-o.top)<=_ee
						bot:=math.max(bot,o.top+_ee)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qu(q.x1,top,q.x2,bot,col)
_mu(int _uf,int x2,float _ah,float _ag,int dir,float _bi,color col,string txt,color _wb,color _pn,color _nx,bool _sa)=>
	x1=math.max(_uf,bar_index-1000)
	_xu=na(_bi)?_ah:(dir==1?_bi:_ah)
	_xt=na(_bi)?_ag:(dir==1?_ag:_bi)
	_gr(Pieza.new(x1,x2,_xu,_xt),col,dir)
	if not na(_bi)
		_gr(Pieza.new(x1,x2,dir==1?_ah:_bi,dir==1?_bi:_ag),_nx,dir)
	if txt !="" and _fs.size()< 60
		_fs.push(Letrero.new(x2,(_xu+_xt)/2,txt,_wb,true,_sa))
	if not na(_pn)
		m=(_ah+_ag)/2
		for q in _py(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nz(q.x1,q.x2,m,_pn)
	_gl.push(Pieza.new(x1,x2,_ah,_ag,dir))
_be(array<Zona> arr,color _xc,color _xg,int _tp,string txt,bool _yb,bool _st,color _nx,bool _sa)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xc:_xg
			t=txt
			_yg=z._ag > close?z._ag-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gl.size()< _li and(_pu==0 or _yg/close*100 <=_pu)
				_mu(z.x1,bar_index+1,z._ah,z._ag,z.dir,z._bi,color.new(c,_mf),t,c,_st?color.new(color.white,30):na,_nx,_sa)
_au()=>
	if _pd
		_be(_ji,_hh,_hh,88,"IFVG "+_dl,true,false,_al,false)
		_be(_hg,_ta,_sw,80,"FVG "+_dl,true,false,_al,true)
	_be(obs,_kw,_kj,90,"OB "+_dl,true,false,_al,false)
_dj(bool ver,int _vj,array<Zona> f,array<Zona> fi,color ca,color cb,int _tp,string nom)=>
	if ver and not _m and _d !=_vj*60
		_be(fi,_hh,_hh,88,"IFVG "+nom,true,false,_al,false)
		_be(f,ca,cb,_tp,"FVG "+nom,true,_vj >=15,_al,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fs.clear()
	_gl.clear()
	_ad=false
	if _d <=60
		_au()
		_ad:=true
	_dj(_cs,1,_xn,_wh,_nf,_my,84,"M1")
	if not _ad and _d <=300
		_au()
		_ad:=true
	_dj(_bx,5,_vm,_so,_nb,_ni,84,"M5")
	if not _ad and _d <=900
		_au()
		_ad:=true
	_dj(_aw,15,_qv,_pw,_kp,_kg,84,"M15")
	if not _ad and _d <=3600
		_au()
		_ad:=true
	_dj(_bd,60,_qh,_pm,_kl,_ks,82,"H1")
	if not _ad and _d <=14400
		_au()
		_ad:=true
	_dj(_aq,240,_kf,_me,_jf,_hp,80,"H4")
	if not _ad
		_au()
	if _fs.size()> 0
		_mq=array.new<Letrero>()
		for l in _fs
			x=l.x
			_xl=str.length(l.txt)+2
			for _xm=0 to 3
				_wi=false
				for c in _mq
					_rm=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _nq and x > c.x-_rm and x-_xl < c.x
						x:=c.x-_rm
						_wi:=true
				if not _wi
					break
			_mq.push(Letrero.new(x,l.y,l.txt,l.col,true,l._sa))
			_le(x,l.y,l.txt,color.white)
	while _ek.size()> uso.get(0)
		_ek.pop().delete()
	while _di.size()> uso.get(1)
		_di.pop().delete()
	while _bv.size()> uso.get(2)
		_bv.pop().delete()
_qg()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bm(array<Zona> arr,string nom,bool _vw)=>
	float _sn=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bi)?z._ag:z._bi
		hi=z.dir==-1 or na(z._bi)?z._ah:z._bi
		d=close >=lo and close <=hi?0.0:_vw?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sn)or d < _sn)
			_sn:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sn,txt]
_pq(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_lc(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_lx(int b)=>
	b==1?_aa:b==-1?_t:#757575
_wt(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wc(string n)=>
	str.contains(n,"alcista")?_aa:str.contains(n,"bajista")?_t:#757575
_rn(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ed=na
if barstate.islast and _ln
	pos=_io=="Arriba izquierda"?position.top_left:_io=="Abajo derecha"?position.bottom_right:_io=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_mx=="Muy pequeño"?size.tiny:_mx=="Normal"?size.normal:size.small
	if na(_ed)
		_ed:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ed.clear(0,0,1,13)
	int f=0
	int _vu=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_vu:=request.security(syminfo.tickerid,"240",_qg(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_qg(),lookahead=barmerge.lookahead_on)
	_pq(_ed,f,"Bias H4",_d < 14400?_lc(_vu):"(gráfico ≥ H4)",_lx(_vu),tam)
	f+=1
	_pq(_ed,f,"Bias H1",_d < 3600?_lc(b60):"(gráfico ≥ H1)",_lx(b60),tam)
	f+=1
	ev=_fa.get(0)
	_vo=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ey.get(0))+" velas"
	_pq(_ed,f,"Estructura "+_dl,_lc(_i)+_vo,_lx(_i),tam)
	f+=1
	tz="America/New_York"
	_wq=hour(timenow,tz)*60+minute(timenow,tz)
	_xr=dayofweek(timenow,tz)
	_ya=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yi=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_ww=_xr==dayofweek.saturday or _xr==dayofweek.sunday
	_uo=570-_wq
	ses=_ww?"Cerrada (fin de semana)":_wq < 570?"Abre a las "+str.format_time(_ya,"HH:mm","Europe/Madrid")+" (en "+(_uo >=60?str.tostring(int(_uo/60))+" h ":"")+str.tostring(_uo%60)+" min)":_wq < 960?"● Abierta (cierra "+str.format_time(_yi,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_ya,"HH:mm","Europe/Madrid")+")"
	_pq(_ed,f,"Sesión NY",ses,not _ww and _wq >=570 and _wq < 960?_aa:#424242,tam)
	f+=1
	float _sk=na
	string _wx=""
	float _sl=na
	string _wg=""
	if _pd
		[d1,t1]=_bm(_hg,"FVG "+_dl,true)
		[d2,t2]=_bm(_ji,"IFVG "+_dl,true)
		[d3,t3]=_bm(_hg,"FVG "+_dl,false)
		[d4,t4]=_bm(_ji,"IFVG "+_dl,false)
		if not na(d1)and(na(_sk)or d1 < _sk)
			_sk:=d1
			_wx:=t1
		if not na(d2)and(na(_sk)or d2 < _sk)
			_sk:=d2
			_wx:=t2
		if not na(d3)and(na(_sl)or d3 < _sl)
			_sl:=d3
			_wg:=t3
		if not na(d4)and(na(_sl)or d4 < _sl)
			_sl:=d4
			_wg:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_xn:k==1?_vm:k==2?_qv:k==3?_qh:_kf
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cs:k==1?_bx:k==2?_aw:k==3?_bd:_aq
			if ver
				[da,ta_]=_bm(arr,nom,true)
				[db,tb]=_bm(arr,nom,false)
				if not na(da)and(na(_sk)or da < _sk)
					_sk:=da
					_wx:=ta_
				if not na(db)and(na(_sl)or db < _sl)
					_sl:=db
					_wg:=tb
	_pq(_ed,f,"FVG por arriba",_wt(_sk,_wx),_wc(_wx),tam)
	f+=1
	_pq(_ed,f,"FVG por abajo",_wt(_sl,_wg),_wc(_wg),tam)
	f+=1
	_ul=not _dx?"(apagada)":na(_cj)?"Ninguna reciente":(_du==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cj)+" velas"
	_pq(_ed,f,"SMT",_ul,not _dx or na(_cj)?#757575:_du==1?_jn:_ho,tam)
	f+=1
	if _os
		_og=request.security(_ud,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mp,_wr,_wa]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_og/16
		pts=_mp*pct/100
		_tg=pts > 0?(_wr-_wa)/pts*100:na
		_ui=na(_og)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_og,"#.#")+") · hoy "+str.tostring(_wr-_wa,"#")+" pts = "+str.tostring(_tg,"#")+" %"
		_pq(_ed,f,"Mov. esperado",_ui,na(_tg)?#757575:_tg >=100?_t:_tg >=75?#EF6C00:#424242,tam)
		f+=1
	if _mb and _ig
		_pq(_ed,f,"Asia",_rn(_fl,_gw,_as,_iy,_jo),#5E35B1,tam)
		f+=1
		_pq(_ed,f,"Londres",_rn(_lv,_mk,_ck,_mi,_mj),#1E88E5,tam)
		f+=1
	if _pf or _fy
		[_wf,_uu,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _pf
			rng=d_h-d_l
			_lq=_uu > 0?rng/_uu*100:na
			_pq(_ed,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_uu,"#")+" pts ("+str.tostring(_lq,"#")+" %)",na(_lq)?#757575:_lq >=100?_t:_lq >=75?#EF6C00:#424242,tam)
			f+=1
		if _fy
			dif=close-_wf
			_pq(_ed,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_t:_aa,tam)
			f+=1
	if _lp
		float _vi=na
		string _vs=""
		float _vl=na
		string _vt=""
		_nd=array.from(pdh,pdl,_iy?na:_fl,_jo?na:_gw,_mi?na:_lv,_mj?na:_mk)
		_mh=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _ew
			_nd.push(nv._ap)
			_mh.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _eu
			_nd.push(nv._ap)
			_mh.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dk
			_nd.push(q._ap)
			_mh.push(q.dir==1?"EQH":"EQL")
		for i=0 to _nd.size()-1
			pv=_nd.get(i)
			if not na(pv)
				if pv > close and(na(_vi)or pv < _vi)
					_vi:=pv
					_vs:=_mh.get(i)
				if pv < close and(na(_vl)or pv > _vl)
					_vl:=pv
					_vt:=_mh.get(i)
		_uv=(na(_vi)?"↑ —":"↑ "+_vs+" "+str.tostring(_vi,format.mintick)+" (+"+str.tostring(_vi-close,format.mintick)+")")+"  ·  "+(na(_vl)?"↓ —":"↓ "+_vt+" "+str.tostring(_vl,format.mintick)+" (−"+str.tostring(close-_vl,format.mintick)+")")
		_pq(_ed,f,"Liquidez",_uv,#424242,tam)
		f+=1
	if _pe !=""
		_pq(_ed,f,"Noticias hoy",_pe,#EF6C00,tam)
		f+=1
