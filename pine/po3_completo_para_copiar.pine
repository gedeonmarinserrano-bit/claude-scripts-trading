		for q in _i
			q.ln.delete()
			q.lb.delete()
		_i.clear()
	_dl(0,_as,_as and not _as[1],_gb,1,"Asia",#5E35B1)
	_dl(1,_as,_as and not _as[1],_gz,-1,"Asia",#5E35B1)
	_dl(2,_cm,_cm and not _cm[1],_lv,1,"Londres",#1E88E5)
	_dl(3,_cm,_cm and not _cm[1],_no,-1,"Londres",#1E88E5)
