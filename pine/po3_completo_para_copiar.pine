_hh="SMT (divergencias entre índices)"
_dq=input.bool(true,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hh)
_ma=input.bool(true,"Mostrar etiquetas de la SMT",group=_hh)
_sp=input.bool(true,"Mostrar línea de la SMT",group=_hh)
_tj=input.bool(true,"Comparar con",inline="smt1",group=_hh)
_pl=input.symbol("CME_MINI:MES1!","",inline="smt1",group=_hh)
_tv=input.bool(true,"Comparar con",inline="smt2",group=_hh)
_pz=input.symbol("CME_MINI:MNQ1!","",inline="smt2",group=_hh)
_gn=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hh)
_qg=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hh)
_rl=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hh)
_je=input.color(#ff1100,"SMT bajista (en altos)",group=_hh)
_ii=input.color(#2157f3,"SMT alcista (en bajos)",group=_hh)
_ki(string s)=>
	_ue=str.split(s,":")
	_ue.size()> 0?_ue.last():s
_sv=_ki(_pl)
_sn=_ki(_pz)
_ws=str.replace(_sv,"1!","")
_xm=str.replace(_sn,"1!","")
_ud=str.replace(syminfo.ticker,"1!","")
_pf=_dq and _tj and _ws !=_ud
_ol=_dq and _tv and _xm !=_ud
_rn()=>
	w=2*_gn+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pn=na
float _pm=na
int _so=na
int _sq=na
float _pt=na
float _pk=na
int _ss=na
int _sk=na
if _pf and _az
	[h_,l_,hb_,lb_]=request.security(_pl,timeframe.period,_rn(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pn:=h_
	_pm:=l_
	_so:=hb_
	_sq:=lb_
if _ol and _az
	[h_,l_,hb_,lb_]=request.security(_pz,timeframe.period,_rn(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pt:=h_
	_pk:=l_
	_ss:=hb_
	_sk:=lb_
_ni=ta.pivothigh(high,_gn,_gn)
_nm=ta.pivotlow(low,_gn,_gn)
_ra=bar_index-_gn
var int _hq=na
var float _fx=na
var float _iq=na
var float _is=na
var int _hm=na
var float _fq=na
var float _ih=na
var float _im=na
var array<line> _gi=array.new<line>()
var array<label> _gj=array.new<label>()
_dz(float y,float _vq,float c,float _mw,bool _ov)=>
	_vo=_ov?y > _vq:y < _vq
	_vu=_ov?c > _mw:c < _mw
	not na(_vq)and not na(_mw)and not na(c)and _vo !=_vu
_fr(string t,float c,float _mw)=>
	t+(c > _mw?" ↑":c < _mw?" ↓":" =")
_kt(int x1,float y1,int xv,string txt,color col,bool _ov)=>
	yv=_ov?high[bar_index-xv]:low[bar_index-xv]
	if _sp
		_gi.push(line.new(x1,y1,xv,yv,color=col))
	if _ma
		_gj.push(label.new(xv,yv,txt,style=_ov?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_ov?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_ov?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gi.size()> _rl
		_gi.shift().delete()
	if _gj.size()> _rl
		_gj.shift().delete()
var int _ci=na
var int _du=0
_in=false
_ic=false
if barstate.isconfirmed
	if not na(_ni)
		_rw=not na(_hq)and _ra-_hq <=_qg
		d1=_rw and _pf and _dz(_ni,_fx,_pn,_iq,true)
		d2=_rw and _ol and _dz(_ni,_fx,_pt,_is,true)
		if d1 or d2
			_in:=true
			_ci:=bar_index
			_du:=-1
			_io=_ni > _fx
			xv=_io?_ra:bar_index+int(d1?_so:_ss)
			t1=_fr(_sv,_pn,_iq)
			t2=_fr(_sn,_pt,_is)
			_kt(_hq,_fx,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_je,true)
		_hq:=_ra
		_fx:=_ni
		_iq:=_pn
		_is:=_pt
	if not na(_nm)
		_rw=not na(_hm)and _ra-_hm <=_qg
		d1=_rw and _pf and _dz(_nm,_fq,_pm,_ih,false)
		d2=_rw and _ol and _dz(_nm,_fq,_pk,_im,false)
		if d1 or d2
			_ic:=true
			_ci:=bar_index
			_du:=1
			_io=_nm < _fq
			xv=_io?_ra:bar_index+int(d1?_sq:_sk)
			t1=_fr(_sv,_pm,_ih)
			t2=_fr(_sn,_pk,_im)
			_kt(_hm,_fq,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ii,false)
		_hm:=_ra
		_fq:=_nm
		_ih:=_pm
		_im:=_pk
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ej=array.new<box>()
var array<line> _dg=array.new<line>()
var array<label> _bw=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qt(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ej.size()
		b=_ej.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ej.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_of(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dg.size()
		l=_dg.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dg.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_mh(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bw.size()
		e=_bw.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bw.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xv
	bool _ru
var array<Letrero> _ga=array.new<Letrero>()
_ff=nz(ta.atr(50))*0.5
_vs=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_om)
_eg=nz(ta.atr(50))*_vs/100
var array<Pieza> _gh=array.new<Pieza>()
_wl(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_qm(Pieza p)=>
	res=array.from(p)
	if _kk and _gh.size()> 0
		for o in _gh
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wy=array.new<Pieza>()
				for q in res
					for r in _wl(q,o)
						_wy.push(r)
				res:=_wy
				if res.size()==0 or res.size()> 10
					break
	res
_gx(Pieza p,color col,int dir)=>
	for q in _qm(p)
		top=q.top
		bot=q.bot
		if _eg > 0 and dir !=0
			for o in _gh
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_eg
						top:=math.min(top,o.bot-_eg)
					if math.abs(bot-o.top)<=_eg
						bot:=math.max(bot,o.top+_eg)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qt(q.x1,top,q.x2,bot,col)
_nf(int _vj,int x2,float _ah,float _ag,int dir,float _bh,color col,string txt,color _xp,color _qi,color _os,bool _ru)=>
	x1=math.max(_vj,bar_index-1000)
	_ys=na(_bh)?_ah:(dir==1?_bh:_ah)
	_yk=na(_bh)?_ag:(dir==1?_ag:_bh)
	_gx(Pieza.new(x1,x2,_ys,_yk),col,dir)
	if not na(_bh)
		_gx(Pieza.new(x1,x2,dir==1?_ah:_bh,dir==1?_bh:_ag),_os,dir)
	if txt !="" and _ga.size()< 60
		_ga.push(Letrero.new(x2,(_ys+_yk)/2,txt,_xp,true,_ru))
	if not na(_qi)
		m=(_ah+_ag)/2
		for q in _qm(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_of(q.x1,q.x2,m,_qi)
	_gh.push(Pieza.new(x1,x2,_ah,_ag,dir))
_bb(array<Zona> arr,color _xz,color _xu,int _ug,string txt,bool _yp,bool _tw,color _os,bool _ru)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xz:_xu
			t=txt
			_ze=z._ag > close?z._ag-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gh.size()< _ll and(_po==0 or _ze/close*100 <=_po)
				_nf(z.x1,bar_index+1,z._ah,z._ag,z.dir,z._bh,color.new(c,_my),t,c,_tw?color.new(color.white,30):na,_os,_ru)
_as()=>
	if _qb
		_bb(_hw,_ho,_ho,88,"IFVG "+_dt,true,false,_al,false)
		_bb(_hg,_tg,_ta,80,"FVG "+_dt,true,false,_al,true)
	_bb(obs,_km,_ld,90,"OB "+_dt,true,false,_al,false)
_di(bool ver,int _we,array<Zona> f,array<Zona> fi,color ca,color cb,int _ug,string nom)=>
	if ver and not _m and _d !=_we*60
		_bb(fi,_ho,_ho,88,"IFVG "+nom,true,false,_al,false)
		_bb(f,ca,cb,_ug,"FVG "+nom,true,_we >=15,_al,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_ga.clear()
	_gh.clear()
	_ae=false
	if _d <=60
		_as()
		_ae:=true
	_di(_cu,1,_yf,_xk,_na,_ns,84,"M1")
	if not _ae and _d <=300
		_as()
		_ae:=true
	_di(_bv,5,_wb,_te,_ms,_np,84,"M5")
	if not _ae and _d <=900
		_as()
		_ae:=true
	_di(_be,15,_rf,_py,_le,_kh,84,"M15")
	if not _ae and _d <=3600
		_as()
		_ae:=true
	_di(_ba,60,_rd,_pq,_ko,_kn,82,"H1")
	if not _ae and _d <=14400
		_as()
		_ae:=true
	_di(_aq,240,_ks,_ln,_jb,_it,80,"H4")
	if not _ae
		_as()
	if _ga.size()> 0
		_mm=array.new<Letrero>()
		for l in _ga
			x=l.x
			_sb=str.length(l.txt)+2
			for _va=0 to 3
				_ry=false
				for c in _mm
					_su=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _ff and x > c.x-_su and x-_sb < c.x
						x:=c.x-_su
						_ry:=true
				if not _ry
					break
			_mm.push(Letrero.new(x,l.y,l.txt,l.col,true,l._ru))
			_mh(x,l.y,l.txt,color.white)
	while _ej.size()> uso.get(0)
		_ej.pop().delete()
	while _dg.size()> uso.get(1)
		_dg.pop().delete()
	while _bw.size()> uso.get(2)
		_bw.pop().delete()
_pw()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bk(array<Zona> arr,string nom,bool _xc)=>
	float _tn=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bh)?z._ag:z._bh
		hi=z.dir==-1 or na(z._bh)?z._ah:z._bh
		d=close >=lo and close <=hi?0.0:_xc?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_tn)or d < _tn)
			_tn:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_tn,txt]
_pp(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_mk(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_lr(int b)=>
	b==1?_ac:b==-1?_u:#757575
_ww(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wj(string n)=>
	str.contains(n,"alcista")?_ac:str.contains(n,"bajista")?_u:#757575
_sg(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ep=na
if barstate.islast and _lu
	pos=_il=="Arriba izquierda"?position.top_left:_il=="Abajo derecha"?position.bottom_right:_il=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_nc=="Muy pequeño"?size.tiny:_nc=="Normal"?size.normal:size.small
	if na(_ep)
		_ep:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ep.clear(0,0,1,13)
	int f=0
	int _wx=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_wx:=request.security(syminfo.tickerid,"240",_pw(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_pw(),lookahead=barmerge.lookahead_on)
	_pp(_ep,f,"Bias H4",_d < 14400?_mk(_wx):"(gráfico ≥ H4)",_lr(_wx),tam)
	f+=1
	_pp(_ep,f,"Bias H1",_d < 3600?_mk(b60):"(gráfico ≥ H1)",_lr(b60),tam)
	f+=1
	ev=_fb.get(0)
	_xa=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ez.get(0))+" velas"
	_pp(_ep,f,"Estructura "+_dt,_mk(_i)+_xa,_lr(_i),tam)
	f+=1
	tz="America/New_York"
	_xn=hour(timenow,tz)*60+minute(timenow,tz)
	_yr=dayofweek(timenow,tz)
	_yq=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yx=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_wh=_yr==dayofweek.saturday or _yr==dayofweek.sunday
	_uq=570-_xn
	ses=_wh?"Cerrada (fin de semana)":_xn < 570?"Abre a las "+str.format_time(_yq,"HH:mm","Europe/Madrid")+" (en "+(_uq >=60?str.tostring(int(_uq/60))+" h ":"")+str.tostring(_uq%60)+" min)":_xn < 960?"● Abierta (cierra "+str.format_time(_yx,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yq,"HH:mm","Europe/Madrid")+")"
	_pp(_ep,f,"Sesión NY",ses,not _wh and _xn >=570 and _xn < 960?_ac:#424242,tam)
	f+=1
	float _sw=na
	string _wi=""
	float _sx=na
	string _wu=""
	if _qb
		[d1,t1]=_bk(_hg,"FVG "+_dt,true)
		[d2,t2]=_bk(_hw,"IFVG "+_dt,true)
		[d3,t3]=_bk(_hg,"FVG "+_dt,false)
		[d4,t4]=_bk(_hw,"IFVG "+_dt,false)
		if not na(d1)and(na(_sw)or d1 < _sw)
			_sw:=d1
			_wi:=t1
		if not na(d2)and(na(_sw)or d2 < _sw)
			_sw:=d2
			_wi:=t2
		if not na(d3)and(na(_sx)or d3 < _sx)
			_sx:=d3
			_wu:=t3
		if not na(d4)and(na(_sx)or d4 < _sx)
			_sx:=d4
			_wu:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_yf:k==1?_wb:k==2?_rf:k==3?_rd:_ks
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cu:k==1?_bv:k==2?_be:k==3?_ba:_aq
			if ver
				[da,ta_]=_bk(arr,nom,true)
				[db,tb]=_bk(arr,nom,false)
				if not na(da)and(na(_sw)or da < _sw)
					_sw:=da
					_wi:=ta_
				if not na(db)and(na(_sx)or db < _sx)
					_sx:=db
					_wu:=tb
	_pp(_ep,f,"FVG por arriba",_ww(_sw,_wi),_wj(_wi),tam)
	f+=1
	_pp(_ep,f,"FVG por abajo",_ww(_sx,_wu),_wj(_wu),tam)
	f+=1
	_ur=not _dq?"(apagada)":na(_ci)?"Ninguna reciente":(_du==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_ci)+" velas"
	_pp(_ep,f,"SMT",_ur,not _dq or na(_ci)?#757575:_du==1?_ii:_je,tam)
	f+=1
	if _nu
		_ou=request.security(_ux,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mw,_wq,_wr]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_ou/16
		pts=_mw*pct/100
		_tm=pts > 0?(_wq-_wr)/pts*100:na
		_vw=na(_ou)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_ou,"#.#")+") · hoy "+str.tostring(_wq-_wr,"#")+" pts = "+str.tostring(_tm,"#")+" %"
		_pp(_ep,f,"Mov. esperado",_vw,na(_tm)?#757575:_tm >=100?_u:_tm >=75?#EF6C00:#424242,tam)
		f+=1
	if _lg and _hu
		_pp(_ep,f,"Asia",_sg(_fz,_gz,_bm,_if,_jm),#5E35B1,tam)
		f+=1
		_pp(_ep,f,"Londres",_sg(_me,_ne,_dk,_no,_mn),#1E88E5,tam)
		f+=1
	if _qf or _ft
		[_wo,_vg,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _qf
			rng=d_h-d_l
			_lz=_vg > 0?rng/_vg*100:na
			_pp(_ep,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_vg,"#")+" pts ("+str.tostring(_lz,"#")+" %)",na(_lz)?#757575:_lz >=100?_u:_lz >=75?#EF6C00:#424242,tam)
			f+=1
		if _ft
			dif=close-_wo
			_pp(_ep,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_u:_ac,tam)
			f+=1
	if _lt
		float _wf=na
		string _xb=""
		float _wd=na
		string _xl=""
		_mx=array.from(pdh,pdl,_if?na:_fz,_jm?na:_gz,_no?na:_me,_mn?na:_ne)
		_ng=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _df
			_mx.push(nv._ax)
			_ng.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _dj
			_mx.push(nv._ax)
			_ng.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dp
			_mx.push(q._ax)
			_ng.push(q.dir==1?"EQH":"EQL")
		for i=0 to _mx.size()-1
			pv=_mx.get(i)
			if not na(pv)
				if pv > close and(na(_wf)or pv < _wf)
					_wf:=pv
					_xb:=_ng.get(i)
				if pv < close and(na(_wd)or pv > _wd)
					_wd:=pv
					_xl:=_ng.get(i)
		_vy=(na(_wf)?"↑ —":"↑ "+_xb+" "+str.tostring(_wf,format.mintick)+" (+"+str.tostring(_wf-close,format.mintick)+")")+"  ·  "+(na(_wd)?"↓ —":"↓ "+_xl+" "+str.tostring(_wd,format.mintick)+" (−"+str.tostring(close-_wd,format.mintick)+")")
		_pp(_ep,f,"Liquidez",_vy,#424242,tam)
		f+=1
	if _pv !=""
		_pp(_ep,f,"Noticias hoy",_pv,#EF6C00,tam)
		f+=1
_ed(array<label> etq,bool _rk,int _vp,float sep)=>
	_op=_vp
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_yb=ys.sort_indices()
		_tk=array.new<float>()
		_sm=array.new<int>()
		_nx=array.new<int>()
		_uo=timeframe.in_seconds()*1000
		for j in _yb
			e=etq.get(j)
			y=e.get_y()
			_sb=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_vp
			for _va=0 to 6
				_ry=false
				if _tk.size()> 0
					for c=0 to _tk.size()-1
						if math.abs(_tk.get(c)-y)< sep and ini < _nx.get(c)and ini+_sb > _sm.get(c)
							ini:=_nx.get(c)
							_ry:=true
				if not _ry
					break
			_tk.push(y)
			_sm.push(ini)
			_nx.push(ini+_sb)
			_op:=math.max(_op,ini+_sb)
			if _rk
				e.set_x(time+ini*_uo)
			else
				e.set_x(bar_index+ini)
	_op
if barstate.islast
	_lk=array.new<label>()
	for o in _gq
		if not na(o)and not na(o.lb)
			_lk.push(o.lb)
	for q in _n
		q.ln.set_x2(bar_index)
		_lk.push(q.lb)
	_ot=array.new<label>()
	for n in _df
		_ot.push(n.lb)
	for n in _dj
		_ot.push(n.lb)
	_vz=_ed(_lk,false,1,_ff*0.35)
	_ed(_ot,true,_lk.size()> 0?_vz:1,_ff*0.35)
