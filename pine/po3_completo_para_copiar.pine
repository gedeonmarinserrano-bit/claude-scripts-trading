_ga=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_us)
_mu=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_us)
_xq=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_us)
_nd=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_us)
_kx=input.color(#1565C0,"OB alcista (demanda)",group=_us)
_kq=input.color(#EF6C00,"OB bajista (oferta)",group=_us)
_pn="Estrategia NY (Bias + PO3)"
_lq=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_pn)
_lc=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_pn)
_up="Colores FVG"
_an=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_up)
_ao=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_up)
_sg=_an
_nh=_an
_nk=_an
_kz=_an
_kj=_an
_jg=_an
_sn=_ao
_mq=_ao
_mt=_ao
_ld=_ao
_kv=_ao
_ji=_ao
_ka=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pn)
_qx=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pn)
_kh=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pn)
_kc=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pn)
_qr=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pn)
_kr=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pn)
_km=input.color(#8D6E63,"Color niveles H1",group=_pn)
_qt=input.bool(false,"Niveles clave: alto/bajo del día anterior",group=_pn)
_dx=input.color(#424242,"Color niveles clave",group=_pn)
_ni=input.color(#757575,"Color horas",group=_pn)
_ef=input.bool(true,"Mostrar EMAs",group="EMAs")
_oa=input.int(9,"EMA rápida",minval=1,group="EMAs")
_og=input.int(20,"EMA media",minval=1,group="EMAs")
_nw=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oy=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_pj=input.color(#2962FF,"Color EMA media",group="EMAs")
_pf=input.color(#363A45,"Color EMA lenta",group="EMAs")
_jb=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_jr=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fs=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_ki=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_wc=14
_sx=50
_ts=0.15
_rd=2.5
_qu=30
_qi=1.0
_ln=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oz="Colores"
_ac=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oz)
_v=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oz)
_ng=input.bool(true,"Marcar la vela del OB",group=_oz)
_hl=input.color(#FF00C8,"IFVG (magenta)",group=_oz)
_nc=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oz)
_kf=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oz)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _bh=na
	int _sr=na
	bool _lr=false
var _hc=array.new<Zona>()
var _is=array.new<Zona>()
var obs=array.new<Zona>()
var _yh=array.new<Zona>()
var _wg=array.new<Zona>()
var _rf=array.new<Zona>()
var _qz=array.new<Zona>()
var _kt=array.new<Zona>()
var _ww=array.new<Zona>()
var _tb=array.new<Zona>()
var _qc=array.new<Zona>()
var _po=array.new<Zona>()
var _lw=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bn=array.new<Rango>()
_ex(Zona z)=>
	_fp=z.dir==1?low <=z._ah:high >=z._ag
	if not _fp
		_bh=na(z._bh)?(z.dir==1?z._ag:z._ah):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_fp
type Marca
	label lb
	line ln
	int bar
var _jp=array.new<Marca>()
var array<string> _fd=array.from("")
var array<int> _fc=array.from(0)
_aj(label lb,line ln,int bar)=>
	_jp.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fd.set(0,lb.get_text())
		_fc.set(0,bar)
	if _jp.size()> 500
		_jp.shift()
_re=ta.ema(close,_oa)
_rt=ta.ema(close,_og)
_if=ta.ema(close,_nw)
_cv=ta.atr(_wc)
var string _ud='════════ Detection ════════'
var string _rx='════════ Structure Filters ════════'
var string _uv='════════ Range Behavior ════════'
var string _ug='════════ Visual Settings ════════'
_ct='Base + 2x + 3x'
_ny='Rangos'
_bl=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_ny)
_br='Percentile band'
_eh=90.0
_lk='Bar close'
_ku=200
_hw=40.0
_ei=500
_mv=0.18
_nt='Wick reaches'
_jf=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_ny)
_en=0.10
_ro=0.45
_eo=0.70
_hr='Extend to containment'
_ii=300
_jw=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_ny)
_hb=true
_lz=0.25
_mi='Close beyond'
_jq=0.15
_hf=true
_hk=10
_lf=3
_fk=0
_ms='Custom'
_ls=#00A651
_mb=#E4002B
_fg=input.color(#F9A825,'Color del rango (neutral)',group=_ny)
_jx=4
_gp=93
_hh=true
_ke=true
_hd=input.bool(true,'Mostrar etiqueta del rango',group=_ny)
_ju=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_ny)
_hs=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_ny)
_il='Small'
_ey=true
_kd='Small'
[_cg,_ch]=switch _ms
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_ls,_mb]
var color _bz=color.new(color.black,100)
var float _cf=3.0
var float _dz=1.6
_hu(string _xf)=>
	switch _xf
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fi(color _dh)=>
	_jc=color.r(_dh)/255.0
	_ih=color.g(_dh)/255.0
	_js=color.b(_dh)/255.0
	_td=_jc <=0.03928?_jc/12.92:math.pow((_jc+0.055)/1.055,2.4)
	_tl=_ih <=0.03928?_ih/12.92:math.pow((_ih+0.055)/1.055,2.4)
	_tz=_js <=0.03928?_js/12.92:math.pow((_js+0.055)/1.055,2.4)
	0.2126*_td+0.7152*_tl+0.0722*_tz
_ll(color _oj,color _mn)=>
	_na=_fi(_oj)
	_kw=_fi(_mn)
	(math.max(_na,_kw)+0.05)/(math.min(_na,_kw)+0.05)
_ee(color _hp)=>
	_fi(_hp)> 0.179?#000000:#ffffff
_pa(color _dh,color _nl,float _sw)=>
	color.rgb(color.r(_dh)+(color.r(_nl)-color.r(_dh))*_sw,color.g(_dh)+(color.g(_nl)-color.g(_dh))*_sw,color.b(_dh)+(color.b(_nl)-color.b(_dh))*_sw)
_bm(color _dh,color _hp,float _ov)=>
	_nl=_ee(_hp)
	_me=_dh
	for step=1 to 10
		if _ll(_me,_hp)>=_ov
			break
		_me:=_pa(_dh,_nl,step/10.0)
	_me
_ja(float _yf)=>
	str.tostring(_yf,'#.##')+'%'
_qy(array<box> _jv,int _mk,float _bb,float _ak)=>
	array.clear(_jv)
	if not _kf
		for i=0 to _jx-1
			array.push(_jv,box.new(_mk,_bb,bar_index,_ak,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gq(array<box> _jv,float _bb,float _ak,int _mk,int _rv,color _ow)=>
	_qf=array.size(_jv)
	if _qf > 0 and _bb > _ak
		_ha=(_bb-_ak)/_qf
		for i=0 to _qf-1
			_in=array.get(_jv,i)
			_op=math.abs((i+0.5)/_qf-0.5)*2.0
			_oh=int(math.min(99,math.max(0,_gp+(1.0-_op)*10)))
			box.set_lefttop(_in,_mk,_bb-_ha*i)
			box.set_rightbottom(_in,_rv,_bb-_ha*(i+1))
			box.set_bgcolor(_in,color.new(_ow,_oh))
_os(array<box> _jv)=>
	if array.size(_jv)> 0
		for i=0 to array.size(_jv)-1
			box.delete(array.get(_jv,i))
	array.clear(_jv)
_qs(int _rw,float _bb,float _ak,float _ck)=>
	_yu=_rw
	if _hr=='Extend to containment'
		_xy=math.min(_ii,bar_index)
		_vr=math.max(2,math.round((1.0-_eo)*_rw))
		_mf=0
		_gv=0
		while _gv < _xy and _mf <=_vr
			_no=close[_gv]<=_bb and close[_gv]>=_ak
			_tx=_no and high[_gv]<=_bb+_ck and low[_gv]>=_ak-_ck
			if _no
				_mf:=math.max(0,_mf-1)
				if _tx and _gv+1 >=_rw
					_yu:=_gv+1
			else
				_mf+=1
			_gv+=1
	_yu
_cn=ta.atr(_ku)
_ky=not na(_cn)and _cn > 0
_gj=_mi=='Wick beyond'
_ks=_nt=='Wick reaches'
_or=_lk=='Live bar'
_fl=_or or barstate.isconfirmed
_gl=_hu(_il)
_le=_hu(_kd)
_w=chart.bg_color
_s=_bm(_fg,_w,_cf)
_fr=_bm(_cg,_w,_cf)
_fx=_bm(_ch,_w,_cf)
_hj=_bm(_fg,_w,_dz)
_gc=_bm(_cg,_w,_dz)
_fw=_bm(_ch,_w,_dz)
_go(simple int len)=>
	_vz=ta.percentile_linear_interpolation(high,len,_eh)
	_qw=ta.percentile_linear_interpolation(low,len,100.0-_eh)
	_wa=ta.highest(high,len)
	_rg=ta.lowest(low,len)
	_tg=ta.highest(math.max(open,close),len)
	_pb=ta.lowest(math.min(open,close),len)
	top=_br=='Absolute extremes'?_wa:_br=='Body extremes'?_tg:_vz
	_kn=_br=='Absolute extremes'?_rg:_br=='Body extremes'?_pb:_qw
	_dm=top-_kn
	_ph=_ky and _dm > 0?_dm/(_cn*math.sqrt(len)):99.0
	_ty=bar_index < 1?_ei:int(math.max(1,math.min(_ei,bar_index-_ku)))
	_ym=ta.percentrank(_ph,_ty)
	_xt=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xz=_dm > 0?math.abs(_xt)*len/_dm:99.0
	_cr=math.avg(top,_kn)
	_ck=_en*nz(_cn)
	_nf=0
	_qa=0
	_io=0
	_ns=0
	for i=0 to len-1
		if(close[i]> _cr)!=(close[i+1]> _cr)
			_nf+=1
		_ou=_ks?high[i]>=top-_ck:close[i]>=top-_ck
		_jy=_ks?low[i]<=_kn+_ck:close[i]<=_kn+_ck
		if _ou
			_qa+=1
		if _jy
			_io+=1
		if close[i]<=top and close[i]>=_kn
			_ns+=1
	_nz=_ns/float(len)
	_im=_ky and not na(_ym)and bar_index > len+5 and _ym <=_hw and _nf >=math.max(3,math.round(_mv*len))and _qa >=_jf and _io >=_jf and _xz <=_ro and _nz >=_eo
	[_im,top,_kn]
bool _ik=false
bool _ib=false
bool _ic=false
float _xd=na
float _xl=na
float _xm=na
float _pv=na
float _qb=na
float _pm=na
if _bf
	[qa,ta_,ba]=_go(_bl)
	_ik:=qa
	_xd:=ta_
	_pv:=ba
	if _ct !='Base only'
		[qb,tb,bb]=_go(_bl*2)
		_ib:=qb
		_xl:=tb
		_qb:=bb
	if _ct=='Base + 2x + 3x'
		[qc,tc,bc]=_go(_bl*3)
		_ic:=qc
		_xm:=tc
		_pm:=bc
_es=_ct !='Base only' and _ib
_ew=_ct=='Base + 2x + 3x' and _ic
_im=_ik or _es or _ew
_pi=_ew?_bl*3:_es?_bl*2:_bl
_ps=_ew?_xm:_es?_xl:_xd
_iu=_ew?_pm:_es?_qb:_pv
var array<box> _ar=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _y=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _gs=na
var bool _t=false
var bool _m=false
var bool _bc=false
var int _dy=na
var int _p=0
var float _q=na
var int _aw=na
var int _ax=0
_cb=false
_cl=false
_bi=false
_cc=false
if _fl and _ax > 0
	_ax-=1
if _fl and not _t and not _bc and _ax <=0 and _im
	_om=_qs(_pi,_ps,_iu,_en*_cn)
	_c:=bar_index-_om+1
	_gs:=bar_index
	_f:=_ps
	_a:=_iu
	_t:=true
	_m:=false
	_cr=math.avg(_f,_a)
	_bx=_a+(_f-_a)*0.25
	_au=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qy(_ar,_c,_f,_a)
	if _hh
		_g:=line.new(_c,_cr,bar_index,_cr,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _ke
		_k:=line.new(_c,_bx,bar_index,_bx,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_y:=line.new(_c,_au,bar_index,_au,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hd
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bz,style=label.style_label_down,textcolor=color.new(_s,10),size=_gl)
	_cb:=true
if _t and _fl
	_cs=_jq*_cn
	_ge=_lz*_cn
	if _hb and not _gj and close <=_f and close >=_a
		if high > _f and high <=_f+_ge
			_f:=high
		if low < _a and low >=_a-_ge
			_a:=low
	_pl=_gj?high > _f+_cs:close > _f+_cs
	_kl=_gj?low < _a-_cs:close < _a-_cs
	_qq=_fk > 0 and bar_index-_gs+1 >=_fk
	if _pl or _kl or _qq
		_b=_pl?1:_kl?-1:0
		_rp=_b !=0?bar_index-_c:bar_index-_c+1
		_mm=_a !=0?(_f-_a)/_a*100.0:0.0
		_jz=_hf and _b !=0 and _m
		if _m
			_ff=_b==1?_fr:_b==-1?_fx:_s
			_oc=_b==1?_gc:_b==-1?_fw:_hj
			_iz=_b==1?_cg:_b==-1?_ch:_fg
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_ff,30))
			box.set_border_style(_u,line.style_dotted)
			_gq(_ar,_f,_a,_c,bar_index,na)
			_bn.push(Rango.new(_c,bar_index,_f,_a,_oc))
			if _bn.size()> 8
				_bn.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_y,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_rp)+' BARS   '+_ja(_mm))
