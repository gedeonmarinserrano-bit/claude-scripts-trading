		_vv=na(_on)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_on,"#.#")+") · hoy "+str.tostring(_wq-_xc,"#")+" pts = "+str.tostring(_tc,"#")+" %"
		_qk(_ef,f,"Mov. esperado",_vv,na(_tc)?#757575:_tc >=100?_t:_tc >=75?#EF6C00:#424242,tam)
		f+=1
	if _ly and _ht
