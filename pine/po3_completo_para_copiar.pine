	_qd:=h_
	_qb:=l_
	_rn:=hb_
	_sd:=lb_
if _pb and _bg
	[h_,l_,hb_,lb_]=request.security(_pm,timeframe.period,_sk(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pj:=h_
	_pi:=l_
	_rh:=hb_
	_sj:=lb_
_nb=ta.pivothigh(high,_gn,_gn)
_nq=ta.pivotlow(low,_gn,_gn)
_qn=bar_index-_gn
var int _hm=na
var float _fj=na
var float _iq=na
var float _je=na
var int _hp=na
var float _fw=na
var float _ip=na
var float _jf=na
var array<line> _gk=array.new<line>()
var array<label> _gh=array.new<label>()
_dv(float y,float _ul,float c,float _nh,bool _nz)=>
	_uw=_nz?y > _ul:y < _ul
	_vq=_nz?c > _nh:c < _nh
	not na(_ul)and not na(_nh)and not na(c)and _uw !=_vq
_fx(string t,float c,float _nh)=>
	t+(c > _nh?" ↑":c < _nh?" ↓":" =")
_kz(int x1,float y1,int xv,string txt,color col,bool _nz)=>
	yv=_nz?high[bar_index-xv]:low[bar_index-xv]
	if _sc
		_gk.push(line.new(x1,y1,xv,yv,color=col))
	if _lp
		_gh.push(label.new(xv,yv,txt,style=_nz?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_nz?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_nz?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gk.size()> _ry
		_gk.shift().delete()
	if _gh.size()> _ry
		_gh.shift().delete()
var int _cp=na
var int _dq=0
_jq=false
_hz=false
if barstate.isconfirmed
	if not na(_nb)
		_sl=not na(_hm)and _qn-_hm <=_po
		d1=_sl and _os and _dv(_nb,_fj,_qd,_iq,true)
		d2=_sl and _pb and _dv(_nb,_fj,_pj,_je,true)
