			_ae.push(o)
			if _ae.size()> 24
				q=_ae.shift()
				q.ln.delete()
				q.lb.delete()
			nv=dir==1?high:low
			o:=NivelSes.new(line.new(bar_index,nv,bar_index,nv,color=color.new(col,15),width=1),label.new(bar_index,nv,_rj,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny),nv,bar_index,k)
