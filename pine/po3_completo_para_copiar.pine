	not na(_uo)and not na(_nl)and not na(c)and _vp !=_uk
_fr(string t,float c,float _nl)=>
	t+(c > _nl?" ↑":c < _nl?" ↓":" =")
_kf(int x1,float y1,int xv,string txt,color col,bool _ok)=>
