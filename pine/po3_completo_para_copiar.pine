_ib=_an
_jt=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_sb)
_dj=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_sb)
_qd=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_sb)
_qi=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_sb)
_dx=input.color(#424242,"Color niveles clave",group=_sb)
_mk=input.color(#757575,"Color horas",group=_sb)
_ef=input.bool(true,"Mostrar EMAs",group="EMAs")
_nj=input.int(9,"EMA rápida",minval=1,group="EMAs")
_ni=input.int(20,"EMA media",minval=1,group="EMAs")
_nm=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ot=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_of=input.color(#9E9D24,"Color EMA media",group="EMAs")
_om=input.color(color.black,"Color EMA lenta",group="EMAs")
_id=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_iw=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fo=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kh=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ty=14
_qy=50
_sz=0.15
_qm=2.5
_qb=30
_pj=1.0
_li=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oi="Colores"
_ab=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oi)
_s=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oi)
_na=input.bool(true,"Marcar la vela del OB",group=_oi)
_hi=input.color(#FF00C8,"IFVG (magenta)",group=_oi)
_nf=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oi)
_kj=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oi)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _bi=na
	int _sa=na
	bool _ln=false
var _gw=array.new<Zona>()
var _jm=array.new<Zona>()
var obs=array.new<Zona>()
var _xb=array.new<Zona>()
var _vc=array.new<Zona>()
var _qh=array.new<Zona>()
var _qf=array.new<Zona>()
var _kd=array.new<Zona>()
var _wr=array.new<Zona>()
var _sw=array.new<Zona>()
var _ov=array.new<Zona>()
var _pd=array.new<Zona>()
var _lm=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bk=array.new<Rango>()
_et(Zona z)=>
	_fh=z.dir==1?low <=z._ah:high >=z._ag
	if not _fh
		_bi=na(z._bi)?(z.dir==1?z._ag:z._ah):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fh
type Marca
	label lb
	line ln
	int bar
var _iy=array.new<Marca>()
var array<string> _ev=array.from("")
var array<int> _ey=array.from(0)
_aj(label lb,line ln,int bar)=>
	_iy.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ev.set(0,lb.get_text())
		_ey.set(0,bar)
	if _iy.size()> 500
		_iy.shift()
_qe=ta.ema(close,_nj)
_re=ta.ema(close,_ni)
_hl=ta.ema(close,_nm)
_dd=ta.atr(_ty)
var string _tg='════════ Detection ════════'
var string _rb='════════ Structure Filters ════════'
var string _ur='════════ Range Behavior ════════'
var string _tk='════════ Visual Settings ════════'
_cr='Base + 2x + 3x'
_og='Rangos'
_bj=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_og)
_bp='Percentile band'
_ek=90.0
_kx='Bar close'
_kt=200
_ih=40.0
_eb=500
_mq=0.18
_nl='Wick reaches'
_hx=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_og)
_ei=0.10
_ro=0.45
_ed=0.70
_hq='Extend to containment'
_ix=300
_js=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_og)
_he=true
_lr=0.25
_lg='Close beyond'
_hw=0.15
_hd=true
_ha=10
_lt=3
_fx=0
_nd='Custom'
_lb=#00A651
_lz=#E4002B
_fd=input.color(#F9A825,'Color del rango (neutral)',group=_og)
_jn=4
_gk=93
_hb=true
_jq=true
_gv=input.bool(true,'Mostrar etiqueta del rango',group=_og)
_jx=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_og)
_ir=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_og)
_ii='Small'
_ew=true
_jr='Small'
[_cg,_ch]=switch _nd
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lb,_lz]
var color _ce=color.new(color.black,100)
var float _ci=3.0
var float _du=1.6
_im(string _wn)=>
	switch _wn
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fe(color _dh)=>
	_hm=color.r(_dh)/255.0
	_jj=color.g(_dh)/255.0
	_it=color.b(_dh)/255.0
	_te=_hm <=0.03928?_hm/12.92:math.pow((_hm+0.055)/1.055,2.4)
	_sj=_jj <=0.03928?_jj/12.92:math.pow((_jj+0.055)/1.055,2.4)
	_si=_it <=0.03928?_it/12.92:math.pow((_it+0.055)/1.055,2.4)
	0.2126*_te+0.7152*_sj+0.0722*_si
_lv(color _oc,color _my)=>
	_mt=_fe(_oc)
	_kn=_fe(_my)
	(math.max(_mt,_kn)+0.05)/(math.min(_mt,_kn)+0.05)
_el(color _hf)=>
	_fe(_hf)> 0.179?#000000:#ffffff
_nv(color _dh,color _mj,float _rl)=>
	color.rgb(color.r(_dh)+(color.r(_mj)-color.r(_dh))*_rl,color.g(_dh)+(color.g(_mj)-color.g(_dh))*_rl,color.b(_dh)+(color.b(_mj)-color.b(_dh))*_rl)
_bm(color _dh,color _hf,float _on)=>
	_mj=_el(_hf)
	_lu=_dh
	for step=1 to 10
		if _lv(_lu,_hf)>=_on
			break
		_lu:=_nv(_dh,_mj,step/10.0)
	_lu
_iu(float _xi)=>
	str.tostring(_xi,'#.##')+'%'
_ql(array<box> _ju,int _ld,float _ax,float _am)=>
	array.clear(_ju)
	if not _kj
		for i=0 to _jn-1
			array.push(_ju,box.new(_ld,_ax,bar_index,_am,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gb(array<box> _ju,float _ax,float _am,int _ld,int _rk,color _ou)=>
	_pr=array.size(_ju)
	if _pr > 0 and _ax > _am
		_gm=(_ax-_am)/_pr
		for i=0 to _pr-1
			_jd=array.get(_ju,i)
			_ok=math.abs((i+0.5)/_pr-0.5)*2.0
			_oq=int(math.min(99,math.max(0,_gk+(1.0-_ok)*10)))
			box.set_lefttop(_jd,_ld,_ax-_gm*i)
			box.set_rightbottom(_jd,_rk,_ax-_gm*(i+1))
			box.set_bgcolor(_jd,color.new(_ou,_oq))
_ob(array<box> _ju)=>
	if array.size(_ju)> 0
		for i=0 to array.size(_ju)-1
			box.delete(array.get(_ju,i))
	array.clear(_ju)
_qp(int _ri,float _ax,float _am,float _ck)=>
	_xv=_ri
	if _hq=='Extend to containment'
		_xg=math.min(_ix,bar_index)
		_ua=math.max(2,math.round((1.0-_ed)*_ri))
		_la=0
		_gs=0
		while _gs < _xg and _la <=_ua
			_mi=close[_gs]<=_ax and close[_gs]>=_am
			_sk=_mi and high[_gs]<=_ax+_ck and low[_gs]>=_am-_ck
			if _mi
				_la:=math.max(0,_la-1)
				if _sk and _gs+1 >=_ri
					_xv:=_gs+1
			else
				_la+=1
			_gs+=1
	_xv
_co=ta.atr(_kt)
_kc=not na(_co)and _co > 0
_gi=_lg=='Wick beyond'
_km=_nl=='Wick reaches'
_ny=_kx=='Live bar'
_fy=_ny or barstate.isconfirmed
_gc=_im(_ii)
_kb=_im(_jr)
_v=chart.bg_color
_r=_bm(_fd,_v,_ci)
_fu=_bm(_cg,_v,_ci)
_ff=_bm(_ch,_v,_ci)
_gz=_bm(_fd,_v,_du)
_fs=_bm(_cg,_v,_du)
_fw=_bm(_ch,_v,_du)
_gd(simple int len)=>
	_ud=ta.percentile_linear_interpolation(high,len,_ek)
	_qa=ta.percentile_linear_interpolation(low,len,100.0-_ek)
	_um=ta.highest(high,len)
	_qc=ta.lowest(low,len)
	_sm=ta.highest(math.max(open,close),len)
	_ol=ta.lowest(math.min(open,close),len)
	top=_bp=='Absolute extremes'?_um:_bp=='Body extremes'?_sm:_ud
	_kg=_bp=='Absolute extremes'?_qc:_bp=='Body extremes'?_ol:_qa
	_dl=top-_kg
	_nw=_kc and _dl > 0?_dl/(_co*math.sqrt(len)):99.0
	_sr=bar_index < 1?_eb:int(math.max(1,math.min(_eb,bar_index-_kt)))
	_xr=ta.percentrank(_nw,_sr)
	_wy=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_wu=_dl > 0?math.abs(_wy)*len/_dl:99.0
	_cv=math.avg(top,_kg)
	_ck=_ei*nz(_co)
	_nb=0
	_pp=0
	_ip=0
	_mg=0
	for i=0 to len-1
		if(close[i]> _cv)!=(close[i+1]> _cv)
			_nb+=1
		_or=_km?high[i]>=top-_ck:close[i]>=top-_ck
		_jw=_km?low[i]<=_kg+_ck:close[i]<=_kg+_ck
		if _or
			_pp+=1
		if _jw
			_ip+=1
		if close[i]<=top and close[i]>=_kg
			_mg+=1
	_os=_mg/float(len)
	_hs=_kc and not na(_xr)and bar_index > len+5 and _xr <=_ih and _nb >=math.max(3,math.round(_mq*len))and _pp >=_hx and _ip >=_hx and _wu <=_ro and _os >=_ed
	[_hs,top,_kg]
bool _jh=false
bool _hu=false
bool _io=false
float _wk=na
float _vl=na
float _vt=na
float _pa=na
float _pn=na
float _pu=na
if _ba
	[qa,ta_,ba]=_gd(_bj)
	_jh:=qa
	_wk:=ta_
	_pa:=ba
	if _cr !='Base only'
		[qb,tb,bb]=_gd(_bj*2)
		_hu:=qb
		_vl:=tb
		_pn:=bb
	if _cr=='Base + 2x + 3x'
		[qc,tc,bc]=_gd(_bj*3)
		_io:=qc
		_vt:=tc
		_pu:=bc
_ep=_cr !='Base only' and _hu
_eq=_cr=='Base + 2x + 3x' and _io
_hs=_jh or _ep or _eq
_nq=_eq?_bj*3:_ep?_bj*2:_bj
_ow=_eq?_vt:_ep?_vl:_wk
_jg=_eq?_pu:_ep?_pn:_pa
var array<box> _at=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _w=na
var label _y=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gr=na
var bool _t=false
var bool _l=false
var bool _bg=false
var int _ds=na
var int _p=0
var float _o=na
var int _az=na
var int _bb=0
_cc=false
_cp=false
_bl=false
_ca=false
if _fy and _bb > 0
	_bb-=1
if _fy and not _t and not _bg and _bb <=0 and _hs
	_od=_qp(_nq,_ow,_jg,_ei*_co)
	_c:=bar_index-_od+1
	_gr:=bar_index
	_f:=_ow
	_a:=_jg
	_t:=true
	_l:=false
	_cv=math.avg(_f,_a)
	_by=_a+(_f-_a)*0.25
	_bf=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_ql(_at,_c,_f,_a)
	if _hb
		_g:=line.new(_c,_cv,bar_index,_cv,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jq
		_k:=line.new(_c,_by,bar_index,_by,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_bf,bar_index,_bf,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gv
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_ce,style=label.style_label_down,textcolor=color.new(_r,10),size=_gc)
	_cc:=true
if _t and _fy
	_ct=_hw*_co
	_fk=_lr*_co
	if _he and not _gi and close <=_f and close >=_a
		if high > _f and high <=_f+_fk
			_f:=high
		if low < _a and low >=_a-_fk
			_a:=low
	_pc=_gi?high > _f+_ct:close > _f+_ct
	_ka=_gi?low < _a-_ct:close < _a-_ct
	_qo=_fx > 0 and bar_index-_gr+1 >=_fx
	if _pc or _ka or _qo
		_b=_pc?1:_ka?-1:0
		_rp=_b !=0?bar_index-_c:bar_index-_c+1
		_mz=_a !=0?(_f-_a)/_a*100.0:0.0
		_jo=_hd and _b !=0 and _l
		if _l
			_fc=_b==1?_fu:_b==-1?_ff:_r
			_op=_b==1?_fs:_b==-1?_fw:_gz
			_ig=_b==1?_cg:_b==-1?_ch:_fd
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_fc,30))
			box.set_border_style(_u,line.style_dotted)
			_gb(_at,_f,_a,_c,bar_index,na)
			_bk.push(Rango.new(_c,bar_index,_f,_a,_op))
			if _bk.size()> 8
				_bk.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_rp)+' BARS   '+_iu(_mz))
				label.set_textcolor(_y,color.new(_fc,10))
			if _jx and _b !=0
				_oe=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _ew
					_av:=label.new(bar_index,_b==1?low:high,_b==1?'▲':'▼',xloc=xloc.bar_index,yloc=yloc.price,color=_ce,style=_b==1?label.style_label_up:label.style_label_down,textcolor=color.new(_fc,20),size=_kb,tooltip='Breakout del rango')
				else
					_av:=label.new(bar_index,_b==1?low:high,_oe,xloc=xloc.bar_index,yloc=yloc.price,color=color.new(_ig,10),style=_b==1?label.style_label_up:label.style_label_down,textcolor=_el(_ig),size=_gc)
