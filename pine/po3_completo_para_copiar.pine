var array<Letrero> _ft=array.new<Letrero>()
_fh=nz(ta.atr(50))*0.5
_vh=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_pf)
_ei=nz(ta.atr(50))*_vh/100
var array<Pieza> _gm=array.new<Pieza>()
_xg(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_ql(Pieza p)=>
	res=array.from(p)
	if _ku and _gm.size()> 0
		for o in _gm
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xe=array.new<Pieza>()
				for q in res
					for r in _xg(q,o)
						_xe.push(r)
				res:=_xe
				if res.size()==0 or res.size()> 10
					break
	res
_gt(Pieza p,color col,int dir)=>
	for q in _ql(p)
		top=q.top
		bot=q.bot
		if _ei > 0 and dir !=0
			for o in _gm
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ei
						top:=math.min(top,o.bot-_ei)
					if math.abs(bot-o.top)<=_ei
						bot:=math.max(bot,o.top+_ei)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qp(q.x1,top,q.x2,bot,col)
_nq(int _vo,int x2,float _ag,float _ah,int dir,float _bh,color col,string txt,color _xf,color _pm,color _of,bool _rs)=>
	x1=math.max(_vo,bar_index-1000)
	_yi=na(_bh)?_ag:(dir==1?_bh:_ag)
	_yh=na(_bh)?_ah:(dir==1?_ah:_bh)
