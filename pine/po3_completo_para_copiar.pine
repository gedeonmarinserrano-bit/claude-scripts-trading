_sm=_ko(_qh)
_se=_ko(_ph)
_wt=str.replace(_sm,"1!","")
_vz=str.replace(_se,"1!","")
_ty=str.replace(syminfo.ticker,"1!","")
_pb=_dp and _st and _wt !=_ty
_ns=_dp and _to and _vz !=_ty
_rm()=>
	w=2*_gp+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pm=na
float _qg=na
int _ru=na
int _ro=na
float _pz=na
float _px=na
int _rv=na
int _rg=na
if _pb and _bc
	[h_,l_,hb_,lb_]=request.security(_qh,timeframe.period,_rm(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pm:=h_
	_qg:=l_
	_ru:=hb_
	_ro:=lb_
if _ns and _bc
	[h_,l_,hb_,lb_]=request.security(_ph,timeframe.period,_rm(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pz:=h_
	_px:=l_
	_rv:=hb_
	_rg:=lb_
_nd=ta.pivothigh(high,_gp,_gp)
_nj=ta.pivotlow(low,_gp,_gp)
_qo=bar_index-_gp
var int _hp=na
var float _fm=na
var float _hr=na
var float _iu=na
var int _hl=na
var float _fx=na
var float _ip=na
var float _hx=na
var array<line> _gi=array.new<line>()
var array<label> _gf=array.new<label>()
_dn(float y,float _va,float c,float _mv,bool _pa)=>
	_uq=_pa?y > _va:y < _va
	_us=_pa?c > _mv:c < _mv
	not na(_va)and not na(_mv)and not na(c)and _uq !=_us
_fv(string t,float c,float _mv)=>
	t+(c > _mv?" ↑":c < _mv?" ↓":" =")
_kp(int x1,float y1,int xv,string txt,color col,bool _pa)=>
	yv=_pa?high[bar_index-xv]:low[bar_index-xv]
	if _so
		_gi.push(line.new(x1,y1,xv,yv,color=col))
	if _lh
		_gf.push(label.new(xv,yv,txt,style=_pa?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_pa?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_pa?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
