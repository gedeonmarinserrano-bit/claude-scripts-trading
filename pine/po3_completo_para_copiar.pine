_mg()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_vv(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_bu(array<Zona> arr,float _ag,float _ah,int dir,int _vj,int _wd)=>
	if _ag-_ah >=_gg(_wd)
		z=Zona.new(_vv(_vj),_ag,_ah,dir)
		if not _ex(z)
			arr.push(z)
			if arr.size()> _gm
				arr.shift()
_bo(array<Zona> arr,array<Zona> _dp)=>
	_wo=false
	if _dp.size()> 0
		for i=_dp.size()-1 to 0
			if _ex(_dp.get(i))
				_dp.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_tu=(z._ag+z._ah)/2
			if low <=_tu and high >=_tu
				_wo:=true
			_ir=na(z._bh)and(z.dir==1?(open >=z._ag and close < z._ah):(open <=z._ah and close > z._ag))
			if _ir
				arr.remove(i)
				_dp.push(Zona.new(z.x1,z._ag,z._ah,-z.dir,na,bar_index))
				if _dp.size()> _gm
					_dp.shift()
			else if _ex(z)
				arr.remove(i)
	_wo
