type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gx(Zona z,float hi,float lo)=>
	_fq=z.dir==1?lo <=z._ai:hi >=z._ah
	if not _fq
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ai):z._bi
		if z.dir==1?lo < _bi:hi > _bi
			z._bi:=z.dir==1?lo:hi
	_fq
_bv(array<Zona> fvg,array<Zona> _tw,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xh,float _rk)=>
	_uf=false
	if ah.size()> 0
		_fb=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tw
				n=s.n-z._rq
				if not z._ma and n >=1 and n <=_gt and h1 >=z._ai and l1 <=z._ah
					if k <=_fb
						z._ma:=true
					_uf:=true
			if k <=_fb
				if _tw.size()> 0
					for i=_tw.size()-1 to 0
						if _gx(_tw.get(i),h1,l1)
							_tw.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ah and c1 < z._ai):(o1 <=z._ai and c1 > z._ah))
						if inv
							fvg.remove(i)
							_tw.push(Zona.new(z.x1,z._ah,z._ai,-z.dir,na,s.n))
							if _tw.size()> _xh
								_tw.shift()
						else if _gx(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rk
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rk
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xh
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_uf
