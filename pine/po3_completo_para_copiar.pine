_ye=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_uw)
_nk=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_uw)
_lc=input.color(#1565C0,"OB alcista (demanda)",group=_uw)
_kt=input.color(#EF6C00,"OB bajista (oferta)",group=_uw)
_qh="Estrategia NY (Bias + PO3)"
