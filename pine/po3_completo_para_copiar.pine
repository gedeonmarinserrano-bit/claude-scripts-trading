type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gz(Zona z,float hi,float lo)=>
	_fp=z.dir==1?lo <=z._ah:hi >=z._ag
	if not _fp
		_bh=na(z._bh)?(z.dir==1?z._ag:z._ah):z._bh
		if z.dir==1?lo < _bh:hi > _bh
			z._bh:=z.dir==1?lo:hi
	_fp
_bv(array<Zona> fvg,array<Zona> _uo,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xs,float _sc)=>
	_uf=false
	if ah.size()> 0
		_fa=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _uo
				n=s.n-z._sr
				if not z._lr and n >=1 and n <=_gx and h1 >=z._ah and l1 <=z._ag
					if k <=_fa
						z._lr:=true
					_uf:=true
			if k <=_fa
				if _uo.size()> 0
					for i=_uo.size()-1 to 0
						if _gz(_uo.get(i),h1,l1)
							_uo.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bh)and(z.dir==1?(o1 >=z._ag and c1 < z._ah):(o1 <=z._ah and c1 > z._ag))
						if inv
							fvg.remove(i)
							_uo.push(Zona.new(z.x1,z._ag,z._ah,-z.dir,na,s.n))
							if _uo.size()> _xs
								_uo.shift()
						else if _gz(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_sc
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_sc
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xs
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_uf
