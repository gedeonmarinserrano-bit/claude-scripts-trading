_hb="SMT (divergencias entre índices)"
_dm=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hb)
_lp=input.bool(true,"Mostrar etiquetas de la SMT",group=_hb)
_rx=input.bool(true,"Mostrar línea de la SMT",group=_hb)
_td=input.bool(true,"Comparar con",inline="smt1",group=_hb)
_ps=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_hb)
_tw=input.bool(true,"Comparar con",inline="smt2",group=_hb)
_pz=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_hb)
_gn=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hb)
_ql=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hb)
_rp=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hb)
_iw=input.color(#ff1100,"SMT bajista (en altos)",group=_hb)
_hx=input.color(#2157f3,"SMT alcista (en bajos)",group=_hb)
_kn(string s)=>
	_uf=str.split(s,":")
