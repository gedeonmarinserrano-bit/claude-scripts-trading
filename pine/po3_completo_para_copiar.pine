_mt=_ao
_kw=_ao
_ky=_ao
_jp=_ao
_ke=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pt)
_rb=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pt)
_kk=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pt)
_ka=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pt)
_qr=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pt)
_ku=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pt)
_lb=input.color(#8D6E63,"Color niveles H1",group=_pt)
_re=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_pt)
_dq=input.color(#424242,"Color niveles clave",group=_pt)
_mz=input.color(#757575,"Color horas",group=_pt)
_es=input.bool(true,"Mostrar EMAs",group="EMAs")
_pa=input.int(9,"EMA rápida",minval=1,group="EMAs")
_pf=input.int(20,"EMA media",minval=1,group="EMAs")
_of=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ol=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_ow=input.color(#9E9D24,"Color EMA media",group="EMAs")
_oe=input.color(color.black,"Color EMA lenta",group="EMAs")
_jb=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_iu=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fm=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_la=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vf=14
_sq=50
_tp=0.15
_qo=2.5
_qy=30
_pm=1.0
_lf=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_ox="Colores"
_ad=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_ox)
_v=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_ox)
_na=input.bool(true,"Marcar la vela del OB",group=_ox)
_ho=input.color(#FF00C8,"IFVG (magenta)",group=_ox)
_ni=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_ox)
_ki=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_ox)
type Zona
	int x1
	float _ah
	float _ai
	int dir
	float _bi=na
	int _rs=na
	bool _lr=false
var _hf=array.new<Zona>()
var _il=array.new<Zona>()
var obs=array.new<Zona>()
var _xt=array.new<Zona>()
var _wb=array.new<Zona>()
var _qv=array.new<Zona>()
var _qx=array.new<Zona>()
var _kj=array.new<Zona>()
var _xn=array.new<Zona>()
var _tv=array.new<Zona>()
var _qa=array.new<Zona>()
var _qi=array.new<Zona>()
var _ly=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ai
	color col
var _bm=array.new<Rango>()
_ex(Zona z)=>
	_ft=z.dir==1?low <=z._ai:high >=z._ah
	if not _ft
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ai):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_ft
type Marca
	label lb
	line ln
	int bar
var _iv=array.new<Marca>()
var array<string> _fb=array.from("")
var array<int> _fg=array.from(0)
_ak(label lb,line ln,int bar)=>
	_iv.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fb.set(0,lb.get_text())
		_fg.set(0,bar)
	if _iv.size()> 500
		_iv.shift()
_qq=ta.ema(close,_pa)
_sd=ta.ema(close,_pf)
_jo=ta.ema(close,_of)
_cq=ta.atr(_vf)
var string _uh='════════ Detection ════════'
var string _sh='════════ Structure Filters ════════'
var string _vo='════════ Range Behavior ════════'
var string _ud='════════ Visual Settings ════════'
_cs='Base + 2x + 3x'
_og='Rangos'
_bj=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_og)
_bs='Percentile band'
_er=90.0
_me='Bar close'
_kh=200
_hv=40.0
_en=500
_nd=0.18
_os='Wick reaches'
_je=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_og)
_ek=0.10
_rf=0.45
_eq=0.70
_jc='Extend to containment'
_ig=300
_jv=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_og)
_hh=true
_md=0.25
_mc='Close beyond'
_ic=0.15
_hc=true
_hd=10
_ll=3
_fv=0
_mr='Custom'
_lo=#00A651
_ma=#E4002B
_fj=input.color(#F9A825,'Color del rango (neutral)',group=_og)
_kc=4
_gl=93
_hg=true
_jz=true
_hi=input.bool(true,'Mostrar etiqueta del rango',group=_og)
_jt=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_og)
_iq=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_og)
_hu='Small'
_fe=true
_ju='Small'
[_ch,_cg]=switch _mr
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lo,_ma]
var color _cb=color.new(color.black,100)
var float _cf=3.0
var float _dw=1.6
_id(string _xb)=>
	switch _xb
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fh(color _di)=>
	_jn=color.r(_di)/255.0
	_hw=color.g(_di)/255.0
	_io=color.b(_di)/255.0
	_tk=_jn <=0.03928?_jn/12.92:math.pow((_jn+0.055)/1.055,2.4)
	_tq=_hw <=0.03928?_hw/12.92:math.pow((_hw+0.055)/1.055,2.4)
	_tt=_io <=0.03928?_io/12.92:math.pow((_io+0.055)/1.055,2.4)
	0.2126*_tk+0.7152*_tq+0.0722*_tt
_lt(color _oq,color _mn)=>
	_mp=_fh(_oq)
	_kl=_fh(_mn)
	(math.max(_mp,_kl)+0.05)/(math.min(_mp,_kl)+0.05)
_ep(color _hp)=>
	_fh(_hp)> 0.179?#000000:#ffffff
_oi(color _di,color _nr,float _ss)=>
	color.rgb(color.r(_di)+(color.r(_nr)-color.r(_di))*_ss,color.g(_di)+(color.g(_nr)-color.g(_di))*_ss,color.b(_di)+(color.b(_nr)-color.b(_di))*_ss)
_bk(color _di,color _hp,float _oj)=>
	_nr=_ep(_hp)
	_lz=_di
	for step=1 to 10
		if _lt(_lz,_hp)>=_oj
			break
		_lz:=_oi(_di,_nr,step/10.0)
	_lz
_hs(float _xr)=>
	str.tostring(_xr,'#.##')+'%'
_qz(array<box> _kb,int _lw,float _aw,float _am)=>
	array.clear(_kb)
	if not _ki
		for i=0 to _kc-1
			array.push(_kb,box.new(_lw,_aw,bar_index,_am,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gf(array<box> _kb,float _aw,float _am,int _lw,int _ro,color _pg)=>
	_pw=array.size(_kb)
	if _pw > 0 and _aw > _am
		_gr=(_aw-_am)/_pw
		for i=0 to _pw-1
			_im=array.get(_kb,i)
			_oo=math.abs((i+0.5)/_pw-0.5)*2.0
			_ok=int(math.min(99,math.max(0,_gl+(1.0-_oo)*10)))
			box.set_lefttop(_im,_lw,_aw-_gr*i)
			box.set_rightbottom(_im,_ro,_aw-_gr*(i+1))
			box.set_bgcolor(_im,color.new(_pg,_ok))
_pe(array<box> _kb)=>
	if array.size(_kb)> 0
		for i=0 to array.size(_kb)-1
			box.delete(array.get(_kb,i))
	array.clear(_kb)
_rc(int _rq,float _aw,float _am,float _ci)=>
	_yp=_rq
	if _jc=='Extend to containment'
		_xz=math.min(_ig,bar_index)
		_vu=math.max(2,math.round((1.0-_eq)*_rq))
		_lm=0
		_gz=0
		while _gz < _xz and _lm <=_vu
			_nk=close[_gz]<=_aw and close[_gz]>=_am
			_tx=_nk and high[_gz]<=_aw+_ci and low[_gz]>=_am-_ci
			if _nk
				_lm:=math.max(0,_lm-1)
				if _tx and _gz+1 >=_rq
					_yp:=_gz+1
			else
				_lm+=1
			_gz+=1
	_yp
_co=ta.atr(_kh)
_kz=not na(_co)and _co > 0
_gh=_mc=='Wick beyond'
_kq=_os=='Wick reaches'
_ns=_me=='Live bar'
_fp=_ns or barstate.isconfirmed
_gg=_id(_hu)
_kt=_id(_ju)
_y=chart.bg_color
_r=_bk(_fj,_y,_cf)
_fy=_bk(_ch,_y,_cf)
_ge=_bk(_cg,_y,_cf)
_ha=_bk(_fj,_y,_dw)
_fl=_bk(_ch,_y,_dw)
_gd=_bk(_cg,_y,_dw)
_gp(simple int len)=>
	_up=ta.percentile_linear_interpolation(high,len,_er)
	_rd=ta.percentile_linear_interpolation(low,len,100.0-_er)
	_vg=ta.highest(high,len)
	_qu=ta.lowest(low,len)
	_sy=ta.highest(math.max(open,close),len)
	_nz=ta.lowest(math.min(open,close),len)
	top=_bs=='Absolute extremes'?_vg:_bs=='Body extremes'?_sy:_up
	_kp=_bs=='Absolute extremes'?_qu:_bs=='Body extremes'?_nz:_rd
	_ds=top-_kp
	_oh=_kz and _ds > 0?_ds/(_co*math.sqrt(len)):99.0
	_tj=bar_index < 1?_en:int(math.max(1,math.min(_en,bar_index-_kh)))
	_yh=ta.percentrank(_oh,_tj)
	_xy=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xp=_ds > 0?math.abs(_xy)*len/_ds:99.0
	_cw=math.avg(top,_kp)
	_ci=_ek*nz(_co)
	_mu=0
	_qg=0
	_ik=0
	_mx=0
	for i=0 to len-1
		if(close[i]> _cw)!=(close[i+1]> _cw)
			_mu+=1
		_or=_kq?high[i]>=top-_ci:close[i]>=top-_ci
		_kd=_kq?low[i]<=_kp+_ci:close[i]<=_kp+_ci
		if _or
			_qg+=1
		if _kd
			_ik+=1
		if close[i]<=top and close[i]>=_kp
			_mx+=1
	_oy=_mx/float(len)
	_jj=_kz and not na(_yh)and bar_index > len+5 and _yh <=_hv and _mu >=math.max(3,math.round(_nd*len))and _qg >=_je and _ik >=_je and _xp <=_rf and _oy >=_eq
	[_jj,top,_kp]
bool _js=false
bool _jf=false
bool _it=false
float _wr=na
float _wq=na
float _we=na
float _qb=na
float _pv=na
float _pu=na
if _ay
	[qa,ta_,ba]=_gp(_bj)
	_js:=qa
	_wr:=ta_
	_qb:=ba
	if _cs !='Base only'
		[qb,tb,bb]=_gp(_bj*2)
		_jf:=qb
		_wq:=tb
		_pv:=bb
	if _cs=='Base + 2x + 3x'
		[qc,tc,bc]=_gp(_bj*3)
		_it:=qc
		_we:=tc
		_pu:=bc
_ey=_cs !='Base only' and _jf
_eu=_cs=='Base + 2x + 3x' and _it
_jj=_js or _ey or _eu
_om=_eu?_bj*3:_ey?_bj*2:_bj
_pp=_eu?_we:_ey?_wq:_wr
_jl=_eu?_pu:_ey?_pv:_qb
var array<box> _as=array.new<box>()
var box _t=na
var line _g=na
var line _k=na
var line _x=na
var label _z=na
var label _au=na
var float _f=na
var float _a=na
var int _c=na
var int _gy=na
var bool _u=false
var bool _l=false
var bool _bd=false
var int _dx=na
var int _p=0
var float _o=na
var int _bc=na
var int _ax=0
_bz=false
_cp=false
_bn=false
_cc=false
if _fp and _ax > 0
	_ax-=1
if _fp and not _u and not _bd and _ax <=0 and _jj
	_nu=_rc(_om,_pp,_jl,_ek*_co)
	_c:=bar_index-_nu+1
	_gy:=bar_index
	_f:=_pp
	_a:=_jl
	_u:=true
	_l:=false
	_cw=math.avg(_f,_a)
	_bu=_a+(_f-_a)*0.25
	_bf=_a+(_f-_a)*0.75
	_t:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qz(_as,_c,_f,_a)
	if _hg
		_g:=line.new(_c,_cw,bar_index,_cw,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jz
		_k:=line.new(_c,_bu,bar_index,_bu,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_x:=line.new(_c,_bf,bar_index,_bf,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hi
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cb,style=label.style_label_down,textcolor=color.new(_r,10),size=_gg)
	_bz:=true
if _u and _fp
	_cu=_ic*_co
	_fo=_md*_co
	if _hh and not _gh and close <=_f and close >=_a
		if high > _f and high <=_f+_fo
			_f:=high
		if low < _a and low >=_a-_fo
			_a:=low
	_py=_gh?high > _f+_cu:close > _f+_cu
	_kx=_gh?low < _a-_cu:close < _a-_cu
	_qw=_fv > 0 and bar_index-_gy+1 >=_fv
	if _py or _kx or _qw
		_b=_py?1:_kx?-1:0
		_sb=_b !=0?bar_index-_c:bar_index-_c+1
		_nm=_a !=0?(_f-_a)/_a*100.0:0.0
		_jx=_hc and _b !=0 and _l
		if _l
			_fi=_b==1?_fy:_b==-1?_ge:_r
			_oz=_b==1?_fl:_b==-1?_gd:_ha
			_ja=_b==1?_ch:_b==-1?_cg:_fj
			box.set_lefttop(_t,_c,_f)
			box.set_rightbottom(_t,bar_index,_a)
			box.set_border_color(_t,color.new(_fi,30))
			box.set_border_style(_t,line.style_dotted)
			_gf(_as,_f,_a,_c,bar_index,na)
			_bm.push(Rango.new(_c,bar_index,_f,_a,_oz))
			if _bm.size()> 8
				_bm.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_x,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sb)+' BARS   '+_hs(_nm))
				label.set_textcolor(_z,color.new(_fi,10))
			if _jt and _b !=0
				_pc=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fe
