	if not na(_tp)
		x=bar_index-_cb
		if not na(_tl)and math.abs(_tp-_tl)<=_ul and x-_pu <=150
			nv=math.min(_tp,_tl)
			_dp.push(Igual.new(line.new(_pu,nv,bar_index,nv,color=color.new(#6A1B9A,20),style=line.style_dotted,width=1),label.new(_pu,nv,"EQL",style=label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny),nv,-1))
		_tl:=_tp
