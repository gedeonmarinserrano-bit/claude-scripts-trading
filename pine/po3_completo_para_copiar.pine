_pj=input.string("","Noticias de hoy (texto libre, p. ej. «CPI 14:30»; vacío = no se muestra)",group=_dc)
_io="Información en el gráfico"
_mc=input.bool(true,"Fondo suave en las sesiones de Asia, Londres y apertura de Nueva York",group=_io)
_uw=input.bool(true,"Línea del 50 % del día anterior (por encima premium, por debajo descuento)",group=_io)
_ry=input.bool(true,"Altos y bajos iguales sin barrer (EQH / EQL)",group=_io)
