		_jr:=_qc
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _el=array.new<box>()
var array<line> _dh=array.new<line>()
var array<label> _bv=array.new<label>()
var array<int> uso=array.from(0,0,0)
_ra(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _el.size()
		b=_el.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_el.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_nw(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dh.size()
		l=_dh.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dh.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_mj(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bv.size()
		e=_bv.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bv.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _yb
