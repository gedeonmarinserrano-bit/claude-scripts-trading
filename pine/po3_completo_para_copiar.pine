	float _aa
	int dir
var array<Igual> _dq=array.new<Igual>()
var float _tv=na
var int _qh=na
var float _ta=na
var int _px=na
_ub=nz(_ck)*0.1
_tk=ta.pivothigh(high,_cd,_cd)
_tr=ta.pivotlow(low,_cd,_cd)
if _rz and _be and timeframe.isintraday
	if not na(_tk)
