			_ry=str.length(l.txt)+2
			for _vs=0 to 3
				_rt=false
				for c in _mo
					_sm=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _fh and x > c.x-_sm and x-_ry < c.x
