type Letrero
	int x
	float y
	string txt
	color col
	bool _xx
	bool _rv
var array<Letrero> _fy=array.new<Letrero>()
_fg=nz(ta.atr(50))*0.5
_vk=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_pf)
_en=nz(ta.atr(50))*_vk/100
var array<Pieza> _gk=array.new<Pieza>()
_wq(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pr(Pieza p)=>
	res=array.from(p)
	if _ko and _gk.size()> 0
		for o in _gk
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wr=array.new<Pieza>()
				for q in res
					for r in _wq(q,o)
						_wr.push(r)
				res:=_wr
				if res.size()==0 or res.size()> 10
					break
	res
_gs(Pieza p,color col,int dir)=>
	for q in _pr(p)
		top=q.top
		bot=q.bot
		if _en > 0 and dir !=0
			for o in _gk
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_en
						top:=math.min(top,o.bot-_en)
					if math.abs(bot-o.top)<=_en
						bot:=math.max(bot,o.top+_en)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_ra(q.x1,top,q.x2,bot,col)
_ng(int _ul,int x2,float _ah,float _ag,int dir,float _bh,color col,string txt,color _we,color _pw,color _pg,bool _rv)=>
	x1=math.max(_ul,bar_index-1000)
	_yj=na(_bh)?_ah:(dir==1?_bh:_ah)
	_yf=na(_bh)?_ag:(dir==1?_ag:_bh)
	_gs(Pieza.new(x1,x2,_yj,_yf),col,dir)
	if not na(_bh)
		_gs(Pieza.new(x1,x2,dir==1?_ah:_bh,dir==1?_bh:_ag),_pg,dir)
	if txt !="" and _fy.size()< 60
		_fy.push(Letrero.new(x2,(_yj+_yf)/2,txt,_we,true,_rv))
	if not na(_pw)
		m=(_ah+_ag)/2
		for q in _pr(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_oq(q.x1,q.x2,m,_pw)
	_gk.push(Pieza.new(x1,x2,_ah,_ag,dir))
_av(array<Zona> arr,color _xs,color _xp,int _ud,string txt,bool _ym,bool _ta,color _pg,bool _rv)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xs:_xp
			t=txt
			_yz=z._ag > close?z._ag-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gk.size()< _lg and(_qd==0 or _yz/close*100 <=_qd)
				_ng(z.x1,bar_index+1,z._ah,z._ag,z.dir,z._bh,color.new(c,_ni),t,c,_ta?color.new(color.white,30):na,_pg,_rv)
_as()=>
