	_pr:=h_
	_qj:=l_
	_rf:=hb_
	_sg:=lb_
if _oc and _ba
	[h_,l_,hb_,lb_]=request.security(_pj,timeframe.period,_rh(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_qf:=h_
	_qh:=l_
	_sf:=hb_
	_rq:=lb_
_nf=ta.pivothigh(high,_gj,_gj)
_nr=ta.pivotlow(low,_gj,_gj)
_ra=bar_index-_gj
var int _hl=na
var float _gd=na
var float _iq=na
var float _jb=na
var int _hp=na
var float _fv=na
var float _iw=na
var float _jj=na
var array<line> _gk=array.new<line>()
var array<label> _go=array.new<label>()
_do(float y,float _vv,float c,float _nh,bool _oj)=>
	_vi=_oj?y > _vv:y < _vv
	_ur=_oj?c > _nh:c < _nh
	not na(_vv)and not na(_nh)and not na(c)and _vi !=_ur
_fx(string t,float c,float _nh)=>
	t+(c > _nh?" ↑":c < _nh?" ↓":" =")
_la(int x1,float y1,int xv,string txt,color col,bool _oj)=>
	yv=_oj?high[bar_index-xv]:low[bar_index-xv]
	if _so
		_gk.push(line.new(x1,y1,xv,yv,color=col))
	if _ls
		_go.push(label.new(xv,yv,txt,style=_oj?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_oj?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_oj?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gk.size()> _sd
		_gk.shift().delete()
	if _go.size()> _sd
		_go.shift().delete()
var int _ci=na
var int _du=0
_je=false
_io=false
if barstate.isconfirmed
	if not na(_nf)
		_rp=not na(_hl)and _ra-_hl <=_ps
		d1=_rp and _pd and _do(_nf,_gd,_pr,_iq,true)
		d2=_rp and _oc and _do(_nf,_gd,_qf,_jb,true)
