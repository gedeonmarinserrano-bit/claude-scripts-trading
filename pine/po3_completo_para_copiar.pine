indicator("Po3 + CHoCH PRO - High Contrast + FVG + Rangos + OB",overlay=true,max_labels_count=500,max_lines_count=500,max_boxes_count=500,max_bars_back=2000,behind_chart=true)
_ip="Panel de información"
_kk=input.bool(true,"Mostrar panel",group=_ip)
_in=input.string("Arriba derecha","Posición",options=["Arriba derecha","Arriba izquierda","Abajo derecha","Abajo izquierda"],group=_ip)
_lo=input.string("Pequeño","Tamaño del texto",options=["Muy pequeño","Pequeño","Normal"],group=_ip)
_mq=input.bool(true,"Movimiento esperado del día (VIX / 16)",group=_ip)
_th=input.symbol("CBOE:VIX","Índice de volatilidad (para el Nasdaq también vale CBOE:VXN)",group=_ip)
_cu="FVG por temporalidad (solo se ven los activados)"
_ao=input.bool(true,"FVG H4",inline="fvgtf1",group=_cu)
_ax=input.bool(true,"FVG H1",inline="fvgtf1",group=_cu)
_ba=input.bool(true,"FVG M15",inline="fvgtf1",group=_cu)
_bq=input.bool(true,"FVG M5",inline="fvgtf2",group=_cu)
_cm=input.bool(false,"FVG M1",inline="fvgtf2",group=_cu)
_mi=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_cu)
_m=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_cu)
_fs=input.int(10,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=50,group=_cu)
_ko=input.int(35,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=120,group=_cu)
_od=input.float(1.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cu)
_ni="Estructura (CHoCH / BOS)"
_fq=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_ni)
_rd=1.1
_tj=2.0
_st=20
_ra=2
_ls=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_ni)
_ih=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_ni)
_hd=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_ni)
_il=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_ni)
_dq=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_ni)
_pg=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_ni)
_ci=bar_index >=last_bar_index-_pg
_es=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_lv=input.int(20,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_ag=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_sz="Order Blocks"
_jm=input.bool(true,"Mostrar Order Blocks",group=_sz)
_fi=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_sz)
_lk=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_sz)
_tn=input.int(10,"Máx. Order Blocks vigentes",minval=1,maxval=50,group=_sz)
_lm=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_sz)
_kg=input.color(#1565C0,"OB alcista (demanda)",group=_sz)
_jy=input.color(#EF6C00,"OB bajista (oferta)",group=_sz)
_qt="Estrategia NY (Bias + PO3)"
_ks=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_qt)
_jj=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_qt)
_sc="Colores FVG"
_ak=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_sc)
_am=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_sc)
_pv=_ak
_li=_ak
_lt=_ak
_jk=_ak
_jl=_ak
_hu=_ak
_pl=_am
_lu=_am
_lj=_am
_jz=_am
_jt=_am
_id=_am
_jg=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qt)
_cx=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qt)
_ot=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qt)
_pi=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qt)
_dd=input.color(#424242,"Color niveles clave",group=_qt)
_lx=input.color(#757575,"Color horas",group=_qt)
_dw=input.bool(true,"Mostrar EMAs",group="EMAs")
_nh=input.int(9,"EMA rápida",minval=1,group="EMAs")
_np=input.int(20,"EMA media",minval=1,group="EMAs")
_na=input.int(200,"EMA lenta",minval=1,group="EMAs")
_mv=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_mz=input.color(#9E9D24,"Color EMA media",group="EMAs")
_mp=input.color(color.black,"Color EMA lenta",group="EMAs")
_gy=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hb=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_ev=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_jp=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_se=14
_qj=50
_rb=0.15
_pc=2.5
_pb=30
_on=1.0
_kh=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_mj="Colores"
_al=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_mj)
_aj=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_mj)
_lr=input.bool(true,"Marcar la vela del OB",group=_mj)
_gw=input.color(#FF00C8,"IFVG (magenta)",group=_mj)
_lq=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_mj)
_kb=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_mj)
type Zona
	int x1
	float _ac
	float _ad
	int dir
	float _bc=na
	int _qk=na
	bool _ku=false
var _gi=array.new<Zona>()
var _hq=array.new<Zona>()
var obs=array.new<Zona>()
var _vd=array.new<Zona>()
var _tk=array.new<Zona>()
var _oy=array.new<Zona>()
var _ph=array.new<Zona>()
var _jo=array.new<Zona>()
var _ur=array.new<Zona>()
var _qx=array.new<Zona>()
var _oh=array.new<Zona>()
var _ok=array.new<Zona>()
var _kl=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ac
	float _ad
	color col
var _bf=array.new<Rango>()
_ed(Zona z)=>
	_fg=z.dir==1?low <=z._ad:high >=z._ac
	if not _fg
		_bc=na(z._bc)?(z.dir==1?z._ac:z._ad):z._bc
		if z.dir==1?low < _bc:high > _bc
			z._bc:=z.dir==1?low:high
	_fg
type Marca
	label lb
	line ln
	int bar
var _ie=array.new<Marca>()
var array<string> _ej=array.from("")
var array<int> _em=array.from(0)
_ae(label lb,line ln,int bar)=>
	_ie.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ej.set(0,lb.get_text())
		_em.set(0,bar)
	if _ie.size()> 500
		_ie.shift()
_ov=ta.ema(close,_nh)
_qh=ta.ema(close,_np)
_ii=ta.ema(close,_na)
_eo=ta.atr(_se)
var string _rt='════════ Detection ════════'
var string _ql='════════ Structure Filters ════════'
var string _su='════════ Range Behavior ════════'
var string _rv='════════ Visual Settings ════════'
_cl='Base + 2x + 3x'
_no='Rangos'
_bh=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_no)
_bo='Percentile band'
_dz=90.0
_ld='Bar close'
_kd=200
_if=40.0
_dt=500
_lp=0.18
_mk='Wick reaches'
_hi=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_no)
_dv=0.10
_qp=0.45
_dr=0.70
_hx='Extend to containment'
_hg=300
_jh=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_no)
_gn=true
_le=0.25
_la='Close beyond'
_ik=0.15
_gj=true
_gk=10
_kq=3
_ff=0
_ll='Custom'
_kj=#00A651
_kt=#E4002B
_ep=input.color(#F9A825,'Color del rango (neutral)',group=_no)
_iy=4
_fw=93
_gh=true
_jf=true
_gl=input.bool(true,'Mostrar etiqueta del rango',group=_no)
_jd=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_no)
_hf=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_no)
_ir='Small'
_el=true
_jb='Small'
[_cb,_cc]=switch _ll
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_kj,_kt]
var color _bx=color.new(color.black,100)
var float _ca=3.0
var float _de=1.6
_hp(string _ut)=>
	switch _ut
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_er(color _cz)=>
	_hz=color.r(_cz)/255.0
	_hl=color.g(_cz)/255.0
	_hm=color.b(_cz)/255.0
	_rn=_hz <=0.03928?_hz/12.92:math.pow((_hz+0.055)/1.055,2.4)
	_rh=_hl <=0.03928?_hl/12.92:math.pow((_hl+0.055)/1.055,2.4)
	_qz=_hm <=0.03928?_hm/12.92:math.pow((_hm+0.055)/1.055,2.4)
	0.2126*_rn+0.7152*_rh+0.0722*_qz
_kv(color _nn,color _lh)=>
	_mb=_er(_nn)
	_jn=_er(_lh)
	(math.max(_mb,_jn)+0.05)/(math.min(_mb,_jn)+0.05)
_dy(color _gu)=>
	_er(_gu)> 0.179?#000000:#ffffff
_ne(color _cz,color _md,float _qd)=>
	color.rgb(color.r(_cz)+(color.r(_md)-color.r(_cz))*_qd,color.g(_cz)+(color.g(_md)-color.g(_cz))*_qd,color.b(_cz)+(color.b(_md)-color.b(_cz))*_qd)
_be(color _cz,color _gu,float _mh)=>
	_md=_dy(_gu)
	_km=_cz
	for step=1 to 10
		if _kv(_km,_gu)>=_mh
			break
		_km:=_ne(_cz,_md,step/10.0)
	_km
_hn(float _ux)=>
	str.tostring(_ux,'#.##')+'%'
_pf(array<box> _je,int _ky,float _ay,float _ai)=>
	array.clear(_je)
	if not _kb
		for i=0 to _iy-1
			array.push(_je,box.new(_ky,_ay,bar_index,_ai,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_ft(array<box> _je,float _ay,float _ai,int _ky,int _px,color _nc)=>
	_om=array.size(_je)
	if _om > 0 and _ay > _ai
		_gc=(_ay-_ai)/_om
		for i=0 to _om-1
			_ic=array.get(_je,i)
			_mu=math.abs((i+0.5)/_om-0.5)*2.0
			_mn=int(math.min(99,math.max(0,_fw+(1.0-_mu)*10)))
			box.set_lefttop(_ic,_ky,_ay-_gc*i)
			box.set_rightbottom(_ic,_px,_ay-_gc*(i+1))
			box.set_bgcolor(_ic,color.new(_nc,_mn))
_nq(array<box> _je)=>
	if array.size(_je)> 0
		for i=0 to array.size(_je)-1
			box.delete(array.get(_je,i))
	array.clear(_je)
_ow(int _pu,float _ay,float _ai,float _cj)=>
	_vi=_pu
	if _hx=='Extend to containment'
		_uu=math.min(_hg,bar_index)
		_si=math.max(2,math.round((1.0-_dr)*_pu))
		_ki=0
		_gb=0
		while _gb < _uu and _ki <=_si
			_lg=close[_gb]<=_ay and close[_gb]>=_ai
			_rq=_lg and high[_gb]<=_ay+_cj and low[_gb]>=_ai-_cj
			if _lg
				_ki:=math.max(0,_ki-1)
				if _rq and _gb+1 >=_pu
					_vi:=_gb+1
			else
				_ki+=1
			_gb+=1
	_vi
_cd=ta.atr(_kd)
_jw=not na(_cd)and _cd > 0
_fp=_la=='Wick beyond'
_jv=_mk=='Wick reaches'
_nl=_ld=='Live bar'
_fh=_nl or barstate.isconfirmed
_fm=_hp(_ir)
_ke=_hp(_jb)
_v=chart.bg_color
_r=_be(_ep,_v,_ca)
_ex=_be(_cb,_v,_ca)
_ey=_be(_cc,_v,_ca)
_gm=_be(_ep,_v,_de)
_et=_be(_cb,_v,_de)
_fd=_be(_cc,_v,_de)
_fx(simple int len)=>
	_sw=ta.percentile_linear_interpolation(high,len,_dz)
	_oz=ta.percentile_linear_interpolation(low,len,100.0-_dz)
	_sl=ta.highest(high,len)
	_ou=ta.lowest(low,len)
	_rf=ta.highest(math.max(open,close),len)
	_mm=ta.lowest(math.min(open,close),len)
	top=_bo=='Absolute extremes'?_sl:_bo=='Body extremes'?_rf:_sw
	_js=_bo=='Absolute extremes'?_ou:_bo=='Body extremes'?_mm:_oz
	_dh=top-_js
	_mw=_jw and _dh > 0?_dh/(_cd*math.sqrt(len)):99.0
	_rg=bar_index < 1?_dt:int(math.max(1,math.min(_dt,bar_index-_kd)))
	_vu=ta.percentrank(_mw,_rg)
	_va=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_vc=_dh > 0?math.abs(_va)*len/_dh:99.0
	_co=math.avg(top,_js)
	_cj=_dv*nz(_cd)
	_ma=0
	_oj=0
	_hj=0
	_mf=0
	for i=0 to len-1
		if(close[i]> _co)!=(close[i+1]> _co)
			_ma+=1
		_my=_jv?high[i]>=top-_cj:close[i]>=top-_cj
		_ja=_jv?low[i]<=_js+_cj:close[i]<=_js+_cj
		if _my
			_oj+=1
		if _ja
			_hj+=1
		if close[i]<=top and close[i]>=_js
			_mf+=1
	_ng=_mf/float(len)
	_io=_jw and not na(_vu)and bar_index > len+5 and _vu <=_if and _ma >=math.max(3,math.round(_lp*len))and _oj >=_hi and _hj >=_hi and _vc <=_qp and _ng >=_dr
	[_io,top,_js]
bool _iw=false
bool _hr=false
bool _ho=false
float _uf=na
float _ty=na
float _tq=na
float _nx=na
float _oa=na
float _op=na
if _ci
	[qa,ta_,ba]=_fx(_bh)
	_iw:=qa
	_uf:=ta_
	_nx:=ba
	if _cl !='Base only'
		[qb,tb,bb]=_fx(_bh*2)
		_hr:=qb
		_ty:=tb
		_oa:=bb
	if _cl=='Base + 2x + 3x'
		[qc,tc,bc]=_fx(_bh*3)
		_ho:=qc
		_tq:=tc
		_op:=bc
_ec=_cl !='Base only' and _hr
_ef=_cl=='Base + 2x + 3x' and _ho
_io=_iw or _ec or _ef
_ns=_ef?_bh*3:_ec?_bh*2:_bh
_of=_ef?_tq:_ec?_ty:_uf
_ix=_ef?_op:_ec?_oa:_nx
var array<box> _ap=array.new<box>()
var box _s=na
var line _g=na
var line _k=na
var line _w=na
var label _x=na
var label _ar=na
var float _f=na
var float _a=na
var int _c=na
var int _gd=na
var bool _t=false
var bool _l=false
var bool _at=false
var int _di=na
var int _o=0
var float _p=na
var int _au=na
var int _as=0
_bw=false
_cf=false
_bg=false
_by=false
if _fh and _as > 0
	_as-=1
if _fh and not _t and not _at and _as <=0 and _io
	_nd=_ow(_ns,_of,_ix,_dv*_cd)
	_c:=bar_index-_nd+1
	_gd:=bar_index
	_f:=_of
	_a:=_ix
	_t:=true
	_l:=false
	_co=math.avg(_f,_a)
	_bp=_a+(_f-_a)*0.25
	_aw=_a+(_f-_a)*0.75
	_s:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_pf(_ap,_c,_f,_a)
	if _gh
		_g:=line.new(_c,_co,bar_index,_co,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jf
		_k:=line.new(_c,_bp,bar_index,_bp,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_aw,bar_index,_aw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gl
		_x:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bx,style=label.style_label_down,textcolor=color.new(_r,10),size=_fm)
	_bw:=true
if _t and _fh
	_ck=_ik*_cd
	_fl=_le*_cd
	if _gn and not _fp and close <=_f and close >=_a
		if high > _f and high <=_f+_fl
			_f:=high
		if low < _a and low >=_a-_fl
			_a:=low
	_or=_fp?high > _f+_ck:close > _f+_ck
	_jq=_fp?low < _a-_ck:close < _a-_ck
	_pe=_ff > 0 and bar_index-_gd+1 >=_ff
	if _or or _jq or _pe
		_b=_or?1:_jq?-1:0
		_qn=_b !=0?bar_index-_c:bar_index-_c+1
		_lz=_a !=0?(_f-_a)/_a*100.0:0.0
		_iz=_gj and _b !=0 and _l
		if _l
			_eq=_b==1?_ex:_b==-1?_ey:_r
			_ml=_b==1?_et:_b==-1?_fd:_gm
			_ha=_b==1?_cb:_b==-1?_cc:_ep
			box.set_lefttop(_s,_c,_f)
			box.set_rightbottom(_s,bar_index,_a)
			box.set_border_color(_s,color.new(_eq,30))
			box.set_border_style(_s,line.style_dotted)
			_ft(_ap,_f,_a,_c,bar_index,na)
			_bf.push(Rango.new(_c,bar_index,_f,_a,_ml))
			if _bf.size()> 8
				_bf.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_x)
				label.set_xy(_x,int(math.avg(_c,bar_index)),_f)
				label.set_text(_x,'RANGE   '+str.tostring(_qn)+' BARS   '+_hn(_lz))
				label.set_textcolor(_x,color.new(_eq,10))
			if _jd and _b !=0
				_mt=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _el
					_ar:=label.new(bar_index,_b==1?low:high,_b==1?'▲':'▼',xloc=xloc.bar_index,yloc=yloc.price,color=_bx,style=_b==1?label.style_label_up:label.style_label_down,textcolor=color.new(_eq,20),size=_ke,tooltip='Breakout del rango')
				else
					_ar:=label.new(bar_index,_b==1?low:high,_mt,xloc=xloc.bar_index,yloc=yloc.price,color=color.new(_ha,10),style=_b==1?label.style_label_up:label.style_label_down,textcolor=_dy(_ha),size=_fm)
			if _b==1
				_cf:=true
			else if _b==-1
				_bg:=true
		else
			box.delete(_s)
			_nq(_ap)
			line.delete(_g)
			line.delete(_k)
			line.delete(_w)
			label.delete(_x)
		if _iz
			_at:=true
			_di:=bar_index
			_o:=_b
			_p:=_b==1?high:low
			_au:=bar_index
		else
			array.clear(_ap)
			_s:=na
			_g:=na
			_k:=na
			_w:=na
			_x:=na
			_ar:=na
		_t:=false
		_l:=false
		_as:=_kq
	else
		_l:=bar_index-_c+1 >=_jh
if _at and _fh
	if _o==1 and high > _p
		_p:=high
		_au:=bar_index
	if _o==-1 and low < _p
		_p:=low
		_au:=bar_index
	_qo=_o==1?close <=_f:close >=_a
	_sr=bar_index-_di >=_gk
	if _qo and bar_index > _di
		_cs=_o==1?_cc:_cb
