type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gf(Zona z,float hi,float lo)=>
	_fg=z.dir==1?lo <=z._ad:hi >=z._ac
	if not _fg
		_bc=na(z._bc)?(z.dir==1?z._ac:z._ad):z._bc
		if z.dir==1?lo < _bc:hi > _bc
			z._bc:=z.dir==1?lo:hi
	_fg
_br(array<Zona> fvg,array<Zona> _sb,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _vs,float _pj)=>
	_ry=false
	if ah.size()> 0
		_ek=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _sb
				n=s.n-z._qk
				if not z._ku and n >=1 and n <=_ge and h1 >=z._ad and l1 <=z._ac
					if k <=_ek
						z._ku:=true
					_ry:=true
			if k <=_ek
				if _sb.size()> 0
					for i=_sb.size()-1 to 0
						if _gf(_sb.get(i),h1,l1)
							_sb.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bc)and(z.dir==1?(o1 >=z._ac and c1 < z._ad):(o1 <=z._ad and c1 > z._ac))
						if inv
							fvg.remove(i)
							_sb.push(Zona.new(z.x1,z._ac,z._ad,-z.dir,na,s.n))
							if _sb.size()> _vs
								_sb.shift()
						else if _gf(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_pj
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_pj
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _vs
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_ry
