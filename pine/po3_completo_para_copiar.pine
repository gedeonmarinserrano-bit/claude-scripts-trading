_la=_ao
_kj=_ao
_jo=_ao
_ri=_ap
_mr=_ap
_ne=_ap
_kh=_ap
_kp=_ap
_jj=_ap
_jt=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pk)
_qo=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pk)
_kl=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pk)
_jw=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pk)
_ql=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pk)
_lb=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pk)
_ld=input.color(#8D6E63,"Color niveles H1",group=_pk)
_qw=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_pk)
_du=input.color(#424242,"Color niveles clave",group=_pk)
_nj=input.color(#757575,"Color horas",group=_pk)
_ei=input.bool(true,"Mostrar EMAs",group="EMAs")
_ow=input.int(9,"EMA rápida",minval=1,group="EMAs")
_oq=input.int(20,"EMA media",minval=1,group="EMAs")
_pe=input.int(200,"EMA lenta",minval=1,group="EMAs")
_nr=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_oa=input.color(#9E9D24,"Color EMA media",group="EMAs")
_pc=input.color(color.black,"Color EMA lenta",group="EMAs")
_jk=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_im=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_ft=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kx=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ur=14
_rs=50
_tn=0.15
_qq=2.5
_qy=30
_qa=1.0
_mc=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_ox="Colores"
_ab=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_ox)
_t=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_ox)
_np=input.bool(true,"Marcar la vela del OB",group=_ox)
_ho=input.color(#FF00C8,"IFVG (magenta)",group=_ox)
_mn=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_ox)
_ku=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_ox)
type Zona
	int x1
	float _ah
	float _ai
	int dir
	float _bi=na
	int _rq=na
	bool _ma=false
var _hi=array.new<Zona>()
var _iv=array.new<Zona>()
var obs=array.new<Zona>()
var _xo=array.new<Zona>()
var _vt=array.new<Zona>()
var _qx=array.new<Zona>()
var _qr=array.new<Zona>()
var _ko=array.new<Zona>()
var _wl=array.new<Zona>()
var _sy=array.new<Zona>()
var _pn=array.new<Zona>()
var _qi=array.new<Zona>()
var _lw=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ai
	color col
var _bk=array.new<Rango>()
_eu(Zona z)=>
	_fq=z.dir==1?low <=z._ai:high >=z._ah
	if not _fq
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ai):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fq
type Marca
	label lb
	line ln
	int bar
var _hx=array.new<Marca>()
var array<string> _fe=array.from("")
var array<int> _ez=array.from(0)
_ak(label lb,line ln,int bar)=>
	_hx.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fe.set(0,lb.get_text())
		_ez.set(0,bar)
	if _hx.size()> 500
		_hx.shift()
_qs=ta.ema(close,_ow)
_rd=ta.ema(close,_oq)
_hq=ta.ema(close,_pe)
_cq=ta.atr(_ur)
var string _tz='════════ Detection ════════'
var string _sf='════════ Structure Filters ════════'
var string _vh='════════ Range Behavior ════════'
var string _uc='════════ Visual Settings ════════'
_cu='Base + 2x + 3x'
_oo='Rangos'
_bl=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_oo)
_bs='Percentile band'
_en=90.0
_mb='Bar close'
_ki=200
_ji=40.0
_ek=500
_mo=0.18
_om='Wick reaches'
_ij=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_oo)
_ef=0.10
_re=0.45
_ej=0.70
_id='Extend to containment'
_jd=300
_jy=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_oo)
_hc=true
_lz=0.25
_ly='Close beyond'
_ia=0.15
_hg=true
_hb=10
_lr=3
_fp=0
_mv='Custom'
_li=#00A651
_ll=#E4002B
_fh=input.color(#F9A825,'Color del rango (neutral)',group=_oo)
_jx=4
_gg=93
_hf=true
_jv=true
_hd=input.bool(true,'Mostrar etiqueta del rango',group=_oo)
_kd=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_oo)
_ja=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_oo)
_io='Small'
_fd=true
_kc='Small'
[_ch,_cg]=switch _mv
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_li,_ll]
var color _cc=color.new(color.black,100)
var float _cf=3.0
var float _dr=1.6
_ic(string _vz)=>
	switch _vz
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ff(color _df)=>
	_ht=color.r(_df)/255.0
	_ik=color.g(_df)/255.0
	_iy=color.b(_df)/255.0
	_sz=_ht <=0.03928?_ht/12.92:math.pow((_ht+0.055)/1.055,2.4)
	_sr=_ik <=0.03928?_ik/12.92:math.pow((_ik+0.055)/1.055,2.4)
	_ta=_iy <=0.03928?_iy/12.92:math.pow((_iy+0.055)/1.055,2.4)
	0.2126*_sz+0.7152*_sr+0.0722*_ta
_mi(color _nu,color _mp)=>
	_nk=_ff(_nu)
	_kq=_ff(_mp)
	(math.max(_nk,_kq)+0.05)/(math.min(_nk,_kq)+0.05)
_ep(color _hn)=>
	_ff(_hn)> 0.179?#000000:#ffffff
_of(color _df,color _no,float _rw)=>
	color.rgb(color.r(_df)+(color.r(_no)-color.r(_df))*_rw,color.g(_df)+(color.g(_no)-color.g(_df))*_rw,color.b(_df)+(color.b(_no)-color.b(_df))*_rw)
_bn(color _df,color _hn,float _pd)=>
	_no=_ep(_hn)
	_lh=_df
	for step=1 to 10
		if _mi(_lh,_hn)>=_pd
			break
		_lh:=_of(_df,_no,step/10.0)
	_lh
_jc(float _xq)=>
	str.tostring(_xq,'#.##')+'%'
_qm(array<box> _ju,int _me,float _bc,float _am)=>
	array.clear(_ju)
	if not _ku
		for i=0 to _jx-1
			array.push(_ju,box.new(_me,_bc,bar_index,_am,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_ge(array<box> _ju,float _bc,float _am,int _me,int _rg,color _nw)=>
	_ph=array.size(_ju)
	if _ph > 0 and _bc > _am
		_gu=(_bc-_am)/_ph
		for i=0 to _ph-1
			_in=array.get(_ju,i)
			_ok=math.abs((i+0.5)/_ph-0.5)*2.0
			_oj=int(math.min(99,math.max(0,_gg+(1.0-_ok)*10)))
			box.set_lefttop(_in,_me,_bc-_gu*i)
			box.set_rightbottom(_in,_rg,_bc-_gu*(i+1))
			box.set_bgcolor(_in,color.new(_nw,_oj))
_ny(array<box> _ju)=>
	if array.size(_ju)> 0
		for i=0 to array.size(_ju)-1
			box.delete(array.get(_ju,i))
	array.clear(_ju)
_ra(int _so,float _bc,float _am,float _co)=>
	_yd=_so
	if _id=='Extend to containment'
		_xm=math.min(_jd,bar_index)
		_up=math.max(2,math.round((1.0-_ej)*_so))
		_lg=0
		_gs=0
		while _gs < _xm and _lg <=_up
			_mx=close[_gs]<=_bc and close[_gs]>=_am
			_sw=_mx and high[_gs]<=_bc+_co and low[_gs]>=_am-_co
			if _mx
				_lg:=math.max(0,_lg-1)
				if _sw and _gs+1 >=_so
					_yd:=_gs+1
			else
				_lg+=1
			_gs+=1
	_yd
_cj=ta.atr(_ki)
_kf=not na(_cj)and _cj > 0
_gf=_ly=='Wick beyond'
_ks=_om=='Wick reaches'
_oz=_mb=='Live bar'
_fs=_oz or barstate.isconfirmed
_gi=_ic(_io)
_kt=_ic(_kc)
_w=chart.bg_color
_r=_bn(_fh,_w,_cf)
_fn=_bn(_ch,_w,_cf)
_fy=_bn(_cg,_w,_cf)
_ha=_bn(_fh,_w,_dr)
_fv=_bn(_ch,_w,_dr)
_gb=_bn(_cg,_w,_dr)
_gj(simple int len)=>
	_uv=ta.percentile_linear_interpolation(high,len,_en)
	_qk=ta.percentile_linear_interpolation(low,len,100.0-_en)
	_vd=ta.highest(high,len)
	_qz=ta.lowest(low,len)
	_td=ta.highest(math.max(open,close),len)
	_ov=ta.lowest(math.min(open,close),len)
	top=_bs=='Absolute extremes'?_vd:_bs=='Body extremes'?_td:_uv
	_kg=_bs=='Absolute extremes'?_qz:_bs=='Body extremes'?_ov:_qk
	_do=top-_kg
	_ol=_kf and _do > 0?_do/(_cj*math.sqrt(len)):99.0
	_tm=bar_index < 1?_ek:int(math.max(1,math.min(_ek,bar_index-_ki)))
	_yk=ta.percentrank(_ol,_tm)
	_xr=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xu=_do > 0?math.abs(_xr)*len/_do:99.0
	_cs=math.avg(top,_kg)
	_co=_ef*nz(_cj)
	_mw=0
	_qf=0
	_iu=0
	_na=0
	for i=0 to len-1
		if(close[i]> _cs)!=(close[i+1]> _cs)
			_mw+=1
		_nx=_ks?high[i]>=top-_co:close[i]>=top-_co
		_ka=_ks?low[i]<=_kg+_co:close[i]<=_kg+_co
		if _nx
			_qf+=1
		if _ka
			_iu+=1
		if close[i]<=top and close[i]>=_kg
			_na+=1
	_nv=_na/float(len)
	_hs=_kf and not na(_yk)and bar_index > len+5 and _yk <=_ji and _mw >=math.max(3,math.round(_mo*len))and _qf >=_ij and _iu >=_ij and _xu <=_re and _nv >=_ej
	[_hs,top,_kg]
bool _hv=false
bool _ig=false
bool _js=false
float _ww=na
float _we=na
float _wp=na
float _pr=na
float _qj=na
float _pv=na
if _bg
	[qa,ta_,ba]=_gj(_bl)
	_hv:=qa
	_ww:=ta_
	_pr:=ba
	if _cu !='Base only'
		[qb,tb,bb]=_gj(_bl*2)
		_ig:=qb
		_we:=tb
		_qj:=bb
	if _cu=='Base + 2x + 3x'
		[qc,tc,bc]=_gj(_bl*3)
		_js:=qc
		_wp:=tc
		_pv:=bc
_et=_cu !='Base only' and _ig
_es=_cu=='Base + 2x + 3x' and _js
_hs=_hv or _et or _es
_ob=_es?_bl*3:_et?_bl*2:_bl
_ps=_es?_wp:_et?_we:_ww
_jg=_es?_pv:_et?_qj:_pr
var array<box> _as=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _v=na
var label _y=na
var label _au=na
var float _f=na
var float _a=na
var int _c=na
var int _gr=na
var bool _s=false
var bool _m=false
var bool _az=false
var int _ds=na
var int _p=0
var float _o=na
var int _ba=na
var int _bd=0
_cb=false
_ci=false
_bj=false
_cd=false
if _fs and _bd > 0
	_bd-=1
if _fs and not _s and not _az and _bd <=0 and _hs
	_pa=_ra(_ob,_ps,_jg,_ef*_cj)
	_c:=bar_index-_pa+1
	_gr:=bar_index
	_f:=_ps
	_a:=_jg
	_s:=true
	_m:=false
	_cs=math.avg(_f,_a)
	_by=_a+(_f-_a)*0.25
	_aw=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qm(_as,_c,_f,_a)
	if _hf
		_g:=line.new(_c,_cs,bar_index,_cs,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jv
		_k:=line.new(_c,_by,bar_index,_by,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_v:=line.new(_c,_aw,bar_index,_aw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hd
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cc,style=label.style_label_down,textcolor=color.new(_r,10),size=_gi)
	_cb:=true
if _s and _fs
	_cw=_ia*_cj
	_fo=_lz*_cj
	if _hc and not _gf and close <=_f and close >=_a
		if high > _f and high <=_f+_fo
			_f:=high
		if low < _a and low >=_a-_fo
			_a:=low
	_pw=_gf?high > _f+_cw:close > _f+_cw
	_kn=_gf?low < _a-_cw:close < _a-_cw
	_qv=_fp > 0 and bar_index-_gr+1 >=_fp
	if _pw or _kn or _qv
		_b=_pw?1:_kn?-1:0
		_rt=_b !=0?bar_index-_c:bar_index-_c+1
		_nf=_a !=0?(_f-_a)/_a*100.0:0.0
		_jz=_hg and _b !=0 and _m
		if _m
			_fg=_b==1?_fn:_b==-1?_fy:_r
			_oe=_b==1?_fv:_b==-1?_gb:_ha
			_jn=_b==1?_ch:_b==-1?_cg:_fh
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_fg,30))
			box.set_border_style(_u,line.style_dotted)
			_ge(_as,_f,_a,_c,bar_index,na)
			_bk.push(Rango.new(_c,bar_index,_f,_a,_oe))
			if _bk.size()> 8
				_bk.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_v,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_rt)+' BARS   '+_jc(_nf))
				label.set_textcolor(_y,color.new(_fg,10))
			if _kd and _b !=0
				_ou=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fd
