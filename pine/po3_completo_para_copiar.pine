_jg(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_dh(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_wa=(dir==1?"Máx. ":"Mín. ")+ses
	o=_gh.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _n.size()> 0
			for i=_n.size()-1 to 0
				q=_n.get(i)
				if q.k==k
					_n.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_jg(bar_index,v,_wa,col)
		_gh.set(k,NivelSes.new(ln,lb,v,k))
	else if not na(o)
		if en and not na(o.ln)
			o._bd:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if dir==1?high > o._bd:low < o._bd
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._bd)
			o.lb.set_text((dir==1?"Máx. manip. ":"Mín. manip. ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			if _n.size()> 0
				for i=_n.size()-1 to 0
					q=_n.get(i)
					if q.k==k
						_n.remove(i)
						q.ln.delete()
						q.lb.delete()
			_n.push(o)
			if _n.size()> 24
				q=_n.shift()
				q.ln.delete()
				q.lb.delete()
			_gh.set(k,na)
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._bd)
_ll=timeframe.change("D")
if _nd and _ga and _aq
	if _ll
