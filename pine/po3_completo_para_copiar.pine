_kv=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_qh)
_up="Colores FVG"
_am=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_up)
_an=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_up)
_rt=_am
_ny=_am
_nn=_am
_la=_am
_kz=_am
_jb=_am
_rr=_an
_nm=_an
_mz=_an
_lf=_an
_ks=_an
_io=_an
_kd=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qh)
_rk=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qh)
_km=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qh)
_kl=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_qh)
_re=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_qh)
_lj=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_qh)
_ku=input.color(#8D6E63,"Color niveles H1",group=_qh)
_qx=input.bool(false,"Niveles clave: alto/bajo del día anterior",group=_qh)
_dv=input.color(#424242,"Color niveles clave",group=_qh)
_nr=input.color(#757575,"Color horas",group=_qh)
_ei=input.bool(true,"Mostrar EMAs",group="EMAs")
_oq=input.int(9,"EMA rápida",minval=1,group="EMAs")
_oi=input.int(20,"EMA media",minval=1,group="EMAs")
_oo=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ou=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_ok=input.color(#2962FF,"Color EMA media",group="EMAs")
_of=input.color(#363A45,"Color EMA lenta",group="EMAs")
_im=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_iw=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fu=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kq=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vj=14
_rx=50
_tv=0.15
_rc=2.5
_qy=30
_qj=1.0
_lo=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pi="Colores"
_v=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pi)
_p=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pi)
_oa=input.bool(true,"Marcar la vela del OB",group=_pi)
_hp=input.color(#FF00C8,"IFVG (magenta)",group=_pi)
_nz=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pi)
_qw=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pi)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _be=na
	int _sn=na
	bool _lt=false
var _hl=array.new<Zona>()
var _jx=array.new<Zona>()
var obs=array.new<Zona>()
var _yl=array.new<Zona>()
var _wo=array.new<Zona>()
var _ra=array.new<Zona>()
var _rd=array.new<Zona>()
var _kr=array.new<Zona>()
var _yd=array.new<Zona>()
var _ts=array.new<Zona>()
var _qk=array.new<Zona>()
var _pp=array.new<Zona>()
var _lm=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bh=array.new<Rango>()
_ev(Zona z)=>
	_fy=z.dir==1?low <=z._ah:high >=z._ag
	if not _fy
		_be=na(z._be)?(z.dir==1?z._ag:z._ah):z._be
		if z.dir==1?low < _be:high > _be
			z._be:=z.dir==1?low:high
	_fy
type Marca
	label lb
	line ln
	int bar
var _jo=array.new<Marca>()
var array<string> _fd=array.from("")
var array<int> _fc=array.from(0)
_ak(label lb,line ln,int bar)=>
	_jo.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fd.set(0,lb.get_text())
		_fc.set(0,bar)
	if _jo.size()> 500
		_jo.shift()
_rl=ta.ema(close,_oq)
_ru=ta.ema(close,_oi)
_hx=ta.ema(close,_oo)
_cu=ta.atr(_vj)
var string _uk='════════ Detection ════════'
var string _ta='════════ Structure Filters ════════'
var string _wi='════════ Range Behavior ════════'
var string _uo='════════ Visual Settings ════════'
_cn='Base + 2x + 3x'
_op='Rangos'
_bg=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_op)
_bk='Percentile band'
_ep=90.0
_me='Bar close'
_kx=200
_je=40.0
_eh=500
_mx=0.18
_oj='Wick reaches'
_ir=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_op)
_ej=0.10
_tc=0.45
_en=0.70
_jf='Extend to containment'
_jd=300
_kg=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_op)
_hf=true
_mg=0.25
_lx='Close beyond'
_it=0.15
_hk=true
_hh=10
_mu=3
_fl=0
_md=#00A651
_mc=#E4002B
_fg=input.color(#F9A825,'Color del rango (neutral)',group=_op)
_he=true
_kb=true
_hi=input.bool(true,'Mostrar etiqueta del rango',group=_op)
_kj=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_op)
_id=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_op)
_jz='Small'
_ey=true
_ka='Small'
_ce=_md
_cd=_mc
var color _bx=color.new(color.black,100)
var float _cc=3.0
var float _dr=1.6
_ig(string _yh)=>
	switch _yh
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fh(color _di)=>
	_ic=color.r(_di)/255.0
	_jl=color.g(_di)/255.0
	_jw=color.b(_di)/255.0
	_ua=_ic <=0.03928?_ic/12.92:math.pow((_ic+0.055)/1.055,2.4)
	_tu=_jl <=0.03928?_jl/12.92:math.pow((_jl+0.055)/1.055,2.4)
	_tf=_jw <=0.03928?_jw/12.92:math.pow((_jw+0.055)/1.055,2.4)
	0.2126*_ua+0.7152*_tu+0.0722*_tf
_ly(color _oc,color _nx)=>
	_mw=_fh(_oc)
	_ky=_fh(_nx)
	(math.max(_mw,_ky)+0.05)/(math.min(_mw,_ky)+0.05)
_em(color _hu)=>
	_fh(_hu)> 0.179?#000000:#ffffff
_pf(color _di,color _nv,float _rn)=>
	color.rgb(color.r(_di)+(color.r(_nv)-color.r(_di))*_rn,color.g(_di)+(color.g(_nv)-color.g(_di))*_rn,color.b(_di)+(color.b(_nv)-color.b(_di))*_rn)
_bi(color _di,color _hu,float _on)=>
	_nv=_em(_hu)
	_mo=_di
	for step=1 to 10
		if _ly(_mo,_hu)>=_on
			break
		_mo:=_pf(_di,_nv,step/10.0)
	_mo
_hv(float _yx)=>
	str.tostring(_yx,'#.##')+'%'
_qz(int _rz,float _nw,float _gy,float _ch)=>
	_zf=_rz
	if _jf=='Extend to containment'
		_yy=math.min(_jd,bar_index)
		_va=math.max(2,math.round((1.0-_en)*_rz))
		_ms=0
		_gx=0
		while _gx < _yy and _ms <=_va
			_nu=close[_gx]<=_nw and close[_gx]>=_gy
			_tz=_nu and high[_gx]<=_nw+_ch and low[_gx]>=_gy-_ch
			if _nu
				_ms:=math.max(0,_ms-1)
				if _tz and _gx+1 >=_rz
					_zf:=_gx+1
			else
				_ms+=1
			_gx+=1
	_zf
_cl=ta.atr(_kx)
_lh=not na(_cl)and _cl > 0
_go=_lx=='Wick beyond'
_ld=_oj=='Wick reaches'
_os=_me=='Live bar'
_fv=_os or barstate.isconfirmed
_gm=_ig(_jz)
_ko=_ig(_ka)
_y=chart.bg_color
_s=_bi(_fg,_y,_cc)
_fx=_bi(_ce,_y,_cc)
_gf=_bi(_cd,_y,_cc)
_hg=_bi(_fg,_y,_dr)
_gc=_bi(_ce,_y,_dr)
_gd=_bi(_cd,_y,_dr)
_gp(simple int len)=>
	_wd=ta.percentile_linear_interpolation(high,len,_ep)
	_rf=ta.percentile_linear_interpolation(low,len,100.0-_ep)
	_vr=ta.highest(high,len)
	_rg=ta.lowest(low,len)
	_uc=ta.highest(math.max(open,close),len)
	_oy=ta.lowest(math.min(open,close),len)
	top=_bk=='Absolute extremes'?_vr:_bk=='Body extremes'?_uc:_wd
	_lg=_bk=='Absolute extremes'?_rg:_bk=='Body extremes'?_oy:_rf
	_dk=top-_lg
	_ox=_lh and _dk > 0?_dk/(_cl*math.sqrt(len)):99.0
	_th=bar_index < 1?_eh:int(math.max(1,math.min(_eh,bar_index-_kx)))
	_zd=ta.percentrank(_ox,_th)
	_yv=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_ys=_dk > 0?math.abs(_yv)*len/_dk:99.0
	_cr=math.avg(top,_lg)
	_ch=_ej*nz(_cl)
	_ni=0
	_qr=0
	_ik=0
	_nl=0
	for i=0 to len-1
		if(close[i]> _cr)!=(close[i+1]> _cr)
			_ni+=1
		_pm=_ld?high[i]>=top-_ch:close[i]>=top-_ch
		_kc=_ld?low[i]<=_lg+_ch:close[i]<=_lg+_ch
		if _pm
			_qr+=1
		if _kc
			_ik+=1
		if close[i]<=top and close[i]>=_lg
			_nl+=1
	_pc=_nl/float(len)
	_ib=_lh and not na(_zd)and bar_index > len+5 and _zd <=_je and _ni >=math.max(3,math.round(_mx*len))and _qr >=_ir and _ik >=_ir and _ys <=_tc and _pc >=_en
	[_ib,top,_lg]
bool _iv=false
bool _jt=false
bool _ii=false
float _xb=na
float _xl=na
float _wx=na
float _qf=na
float _px=na
float _pv=na
if _aq
	[qa,ta_,ba]=_gp(_bg)
	_iv:=qa
	_xb:=ta_
	_qf:=ba
	if _cn !='Base only'
		[qb,tb,bb]=_gp(_bg*2)
		_jt:=qb
		_xl:=tb
		_px:=bb
	if _cn=='Base + 2x + 3x'
		[qc,tc,bc]=_gp(_bg*3)
		_ii:=qc
		_wx:=tc
		_pv:=bc
_er=_cn !='Base only' and _jt
_ex=_cn=='Base + 2x + 3x' and _ii
_ib=_iv or _er or _ex
_pb=_ex?_bg*3:_er?_bg*2:_bg
_qo=_ex?_wx:_er?_xl:_xb
_jq=_ex?_pv:_er?_px:_qf
var box _w=na
var line _g=na
var line _k=na
var line _z=na
var label _aa=na
var label _as=na
var float _f=na
var float _a=na
var int _d=na
var int _gz=na
var bool _u=false
var bool _m=false
var bool _ay=false
var int _dy=na
var int _r=0
var float _q=na
var int _aw=na
var int _ax=0
_bz=false
_cm=false
_bj=false
_by=false
if _fv and _ax > 0
	_ax-=1
if _fv and not _u and not _ay and _ax <=0 and _ib
	_od=_qz(_pb,_qo,_jq,_ej*_cl)
	_d:=bar_index-_od+1
	_gz:=bar_index
	_f:=_qo
	_a:=_jq
	_u:=true
	_m:=false
	_cr=math.avg(_f,_a)
	_br=_a+(_f-_a)*0.25
	_av=_a+(_f-_a)*0.75
	_w:=box.new(_d,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	if _he
		_g:=line.new(_d,_cr,bar_index,_cr,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kb
		_k:=line.new(_d,_br,bar_index,_br,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_z:=line.new(_d,_av,bar_index,_av,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hi
		_aa:=label.new(_d,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bx,style=label.style_label_down,textcolor=color.new(_s,10),size=_gm)
	_bz:=true
if _u and _fv
	_cq=_it*_cl
	_fq=_mg*_cl
	if _hf and not _go and close <=_f and close >=_a
		if high > _f and high <=_f+_fq
			_f:=high
		if low < _a and low >=_a-_fq
			_a:=low
	_py=_go?high > _f+_cq:close > _f+_cq
	_kn=_go?low < _a-_cq:close < _a-_cq
	_rb=_fl > 0 and bar_index-_gz+1 >=_fl
	if _py or _kn or _rb
		_b=_py?1:_kn?-1:0
		_sg=_b !=0?bar_index-_d:bar_index-_d+1
		_na=_a !=0?(_f-_a)/_a*100.0:0.0
		_ki=_hk and _b !=0 and _m
		if _m
			_fi=_b==1?_fx:_b==-1?_gf:_s
			_om=_b==1?_gc:_b==-1?_gd:_hg
			_ih=_b==1?_ce:_b==-1?_cd:_fg
			box.set_lefttop(_w,_d,_f)
			box.set_rightbottom(_w,bar_index,_a)
			box.set_border_color(_w,color.new(_fi,30))
			box.set_border_style(_w,line.style_dotted)
			_bh.push(Rango.new(_d,bar_index,_f,_a,_om))
			if _bh.size()> 8
				_bh.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_z,bar_index)
			if not na(_aa)
				label.set_xy(_aa,int(math.avg(_d,bar_index)),_f)
				label.set_text(_aa,'RANGE   '+str.tostring(_sg)+' BARS   '+_hv(_na))
				label.set_textcolor(_aa,color.new(_fi,10))
			if _kj and _b !=0
				_pe=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _ey
					_as:=label.new(bar_index,_b==1?low:high,_b==1?'▲':'▼',xloc=xloc.bar_index,yloc=yloc.price,color=_bx,style=_b==1?label.style_label_up:label.style_label_down,textcolor=color.new(_fi,20),size=_ko,tooltip='Breakout del rango')
				else
					_as:=label.new(bar_index,_b==1?low:high,_pe,xloc=xloc.bar_index,yloc=yloc.price,color=color.new(_ih,10),style=_b==1?label.style_label_up:label.style_label_down,textcolor=_em(_ih),size=_gm)
			if _b==1
				_cm:=true
			else if _b==-1
				_bj:=true
		else
			box.delete(_w)
			line.delete(_g)
			line.delete(_k)
			line.delete(_z)
			label.delete(_aa)
		if _ki
			_ay:=true
