	_vx=not _dm?"(apagada)":na(_ck)?"Ninguna reciente":(_dz==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_ck)+" velas"
	_qh(_ej,f,"SMT",_vx,not _dm or na(_ck)?#757575:_dz==1?_hx:_iw,tam)
