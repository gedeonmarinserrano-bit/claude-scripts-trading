	if not na(_bh)
		_gt(Pieza.new(x1,x2,dir==1?_ag:_bh,dir==1?_bh:_ah),_of,dir)
	if txt !="" and _ft.size()< 60
		_ft.push(Letrero.new(x2,(_yi+_yh)/2,txt,_xf,true,_rs))
	if not na(_pm)
		m=(_ag+_ah)/2
		for q in _ql(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nu(q.x1,q.x2,m,_pm)
	_gm.push(Pieza.new(x1,x2,_ag,_ah,dir))
_bb(array<Zona> arr,color _xo,color _xp,int _ud,string txt,bool _yf,bool _tr,color _of,bool _rs)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xo:_xp
			t=txt
			_zb=z._ah > close?z._ah-close:close > z._ag?close-z._ag:0.0
			if uso.get(0)< 440 and _gm.size()< _li and(_py==0 or _zb/close*100 <=_py)
				_nq(z.x1,bar_index+1,z._ag,z._ah,z.dir,z._bh,color.new(c,_mx),t,c,_tr?color.new(color.white,30):na,_of,_rs)
