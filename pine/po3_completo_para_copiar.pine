		d2=_re and _ok and _dq(_mz,_fo,_oz,_il,false)
		if d1 or d2
			_hr:=true
			_ci:=bar_index
			_de:=1
			_hm=_mz < _fo
			xv=_hm?_qk:bar_index+int(d1?_qt:_rr)
			t1=_fk(_rn,_pl,_hy)
			t2=_fk(_qw,_oz,_il)
			_kf(_hf,_fo,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ho,false)
		_hf:=_qk
		_fo:=_mz
		_hy:=_pl
		_il:=_oz
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ee=array.new<box>()
var array<line> _cy=array.new<line>()
var array<label> _bv=array.new<label>()
var array<int> uso=array.from(0,0,0)
_pv(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ee.size()
		b=_ee.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ee.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_oe(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _cy.size()
		l=_cy.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_cy.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lc(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bv.size()
		e=_bv.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bv.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _wp
	bool _rj
var array<Letrero> _fi=array.new<Letrero>()
_oa=nz(ta.atr(50))*0.5
_tt=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_ng)
_ea=nz(ta.atr(50))*_tt/100
var array<Pieza> _fy=array.new<Pieza>()
_ve(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pk(Pieza p)=>
	res=array.from(p)
	if _jy and _fy.size()> 0
		for o in _fy
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_vm=array.new<Pieza>()
				for q in res
					for r in _ve(q,o)
						_vm.push(r)
				res:=_vm
				if res.size()==0 or res.size()> 10
					break
	res
_gp(Pieza p,color col,int dir)=>
	for q in _pk(p)
		top=q.top
		bot=q.bot
		if _ea > 0 and dir !=0
			for o in _fy
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ea
						top:=math.min(top,o.bot-_ea)
					if math.abs(bot-o.top)<=_ea
						bot:=math.max(bot,o.top+_ea)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_pv(q.x1,top,q.x2,bot,col)
_me(int _tp,int x2,float _af,float _ag,int dir,float _be,color col,string txt,color _vj,color _pa,color _nd,bool _rj)=>
	x1=math.max(_tp,bar_index-1000)
	_xf=na(_be)?_af:(dir==1?_be:_af)
	_xm=na(_be)?_ag:(dir==1?_ag:_be)
	_gp(Pieza.new(x1,x2,_xf,_xm),col,dir)
	if not na(_be)
		_gp(Pieza.new(x1,x2,dir==1?_af:_be,dir==1?_be:_ag),_nd,dir)
	if txt !="" and _fi.size()< 30
		_fi.push(Letrero.new(x2,(_xf+_xm)/2,txt,_vj,true,_rj))
	if not na(_pa)
		m=(_af+_ag)/2
		for q in _pk(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_oe(q.x1,q.x2,m,_pa)
	_fy.push(Pieza.new(x1,x2,_af,_ag,dir))
_au(array<Zona> arr,color _wm,color _wr,int _ti,string txt,bool _xh,bool _sw,color _nd,bool _rj)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_wm:_wr
			t=txt
			_xx=z._ag > close?z._ag-close:close > z._af?close-z._af:0.0
			if uso.get(0)< 440 and _fy.size()< _ln and(_pi==0 or _xx/close*100 <=_pi)
				_me(z.x1,bar_index+1,z._af,z._ag,z.dir,z._be,color.new(c,_my),t,c,_sw?color.new(color.white,30):na,_nd,_rj)
_at()=>
	if _pt
		_au(_ip,_hc,_hc,88,"IFVG "+_dp,true,false,_aj,false)
		_au(_gr,_se,_st,80,"FVG "+_dp,true,false,_aj,true)
	_au(obs,_jx,_kq,90,"OB "+_dp,true,false,_aj,false)
_cz(bool ver,int _uz,array<Zona> f,array<Zona> fi,color ca,color cb,int _ti,string nom)=>
	if ver and not _l and _d !=_uz*60
		_au(fi,_hc,_hc,88,"IFVG "+nom,true,false,_aj,false)
		_au(f,ca,cb,_ti,"FVG "+nom,true,_uz >=15,_aj,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fi.clear()
	_fy.clear()
	_ae=false
	if _d <=60
		_at()
		_ae:=true
	_cz(_cm,1,_wo,_wc,_mm,_ly,84,"M1")
	if not _ae and _d <=300
		_at()
		_ae:=true
	_cz(_bw,5,_uy,_sf,_na,_mn,84,"M5")
	if not _ae and _d <=900
		_at()
		_ae:=true
	_cz(_av,15,_qb,_ot,_jz,_kh,84,"M15")
	if not _ae and _d <=3600
		_at()
		_ae:=true
	_cz(_az,60,_qc,_ox,_kp,_kg,82,"H1")
	if not _ae and _d <=14400
		_at()
		_ae:=true
	_cz(_ap,240,_kn,_lu,_ii,_ia,80,"H4")
	if not _ae
		_at()
	if _fi.size()> 0
		_ms=array.new<Letrero>()
		for l in _fi
			x=l.x
			_wq=str.length(l.txt)+2
			for _wz=0 to 3
				_vn=false
				for c in _ms
					_rk=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _oa and x > c.x-_rk and x-_wq < c.x
						x:=c.x-_rk
						_vn:=true
				if not _vn
					break
			_ms.push(Letrero.new(x,l.y,l.txt,l.col,true,l._rj))
			_lc(x,l.y,l.txt,color.white)
	while _ee.size()> uso.get(0)
		_ee.pop().delete()
	while _cy.size()> uso.get(1)
		_cy.pop().delete()
	while _bv.size()> uso.get(2)
		_bv.pop().delete()
_ph()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bg(array<Zona> arr,string nom,bool _wj)=>
	float _sb=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._be)?z._ag:z._be
		hi=z.dir==-1 or na(z._be)?z._af:z._be
		d=close >=lo and close <=hi?0.0:_wj?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sb)or d < _sb)
			_sb:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sb,txt]
_pc(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_lt(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_lf(int b)=>
	b==1?_z:b==-1?_u:#757575
_vo(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wk(string n)=>
	str.contains(n,"alcista")?_z:str.contains(n,"bajista")?_u:#757575
_rg(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ei=na
if barstate.islast and _ls
	pos=_in=="Arriba izquierda"?position.top_left:_in=="Abajo derecha"?position.bottom_right:_in=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_lv=="Muy pequeño"?size.tiny:_lv=="Normal"?size.normal:size.small
	if na(_ei)
		_ei:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ei.clear(0,0,1,13)
	int f=0
	int _vl=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_vl:=request.security(syminfo.tickerid,"240",_ph(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_ph(),lookahead=barmerge.lookahead_on)
	_pc(_ei,f,"Bias H4",_d < 14400?_lt(_vl):"(gráfico ≥ H4)",_lf(_vl),tam)
	f+=1
	_pc(_ei,f,"Bias H1",_d < 3600?_lt(b60):"(gráfico ≥ H1)",_lf(b60),tam)
	f+=1
	ev=_ev.get(0)
	_vq=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ep.get(0))+" velas"
	_pc(_ei,f,"Estructura "+_dp,_lt(_i)+_vq,_lf(_i),tam)
	f+=1
	tz="America/New_York"
	_vy=hour(timenow,tz)*60+minute(timenow,tz)
	_xl=dayofweek(timenow,tz)
	_xe=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_xv=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_vv=_xl==dayofweek.saturday or _xl==dayofweek.sunday
	_up=570-_vy
	ses=_vv?"Cerrada (fin de semana)":_vy < 570?"Abre a las "+str.format_time(_xe,"HH:mm","Europe/Madrid")+" (en "+(_up >=60?str.tostring(int(_up/60))+" h ":"")+str.tostring(_up%60)+" min)":_vy < 960?"● Abierta (cierra "+str.format_time(_xv,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_xe,"HH:mm","Europe/Madrid")+")"
	_pc(_ei,f,"Sesión NY",ses,not _vv and _vy >=570 and _vy < 960?_z:#424242,tam)
	f+=1
	float _rx=na
	string _wi=""
	float _rv=na
	string _vu=""
	if _pt
		[d1,t1]=_bg(_gr,"FVG "+_dp,true)
		[d2,t2]=_bg(_ip,"IFVG "+_dp,true)
		[d3,t3]=_bg(_gr,"FVG "+_dp,false)
		[d4,t4]=_bg(_ip,"IFVG "+_dp,false)
		if not na(d1)and(na(_rx)or d1 < _rx)
			_rx:=d1
			_wi:=t1
		if not na(d2)and(na(_rx)or d2 < _rx)
			_rx:=d2
			_wi:=t2
		if not na(d3)and(na(_rv)or d3 < _rv)
			_rv:=d3
			_vu:=t3
		if not na(d4)and(na(_rv)or d4 < _rv)
			_rv:=d4
			_vu:=t4
	if not _l
		for k=0 to 4
			arr=k==0?_wo:k==1?_uy:k==2?_qb:k==3?_qc:_kn
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cm:k==1?_bw:k==2?_av:k==3?_az:_ap
			if ver
				[da,ta_]=_bg(arr,nom,true)
				[db,tb]=_bg(arr,nom,false)
				if not na(da)and(na(_rx)or da < _rx)
					_rx:=da
					_wi:=ta_
				if not na(db)and(na(_rv)or db < _rv)
					_rv:=db
					_vu:=tb
	_pc(_ei,f,"FVG por arriba",_vo(_rx,_wi),_wk(_wi),tam)
	f+=1
	_pc(_ei,f,"FVG por abajo",_vo(_rv,_vu),_wk(_vu),tam)
	f+=1
	_uo=not _dk?"(apagada)":na(_ci)?"Ninguna reciente":(_de==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_ci)+" velas"
	_pc(_ei,f,"SMT",_uo,not _dk or na(_ci)?#757575:_de==1?_ho:_je,tam)
	f+=1
	if _nc
		_ob=request.security(_tq,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mj,_wd,_vk]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_ob/16
		pts=_mj*pct/100
		_sh=pts > 0?(_wd-_vk)/pts*100:na
		_uk=na(_ob)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_ob,"#.#")+") · hoy "+str.tostring(_wd-_vk,"#")+" pts = "+str.tostring(_sh,"#")+" %"
		_pc(_ei,f,"Mov. esperado",_uk,na(_sh)?#757575:_sh >=100?_u:_sh >=75?#EF6C00:#424242,tam)
		f+=1
	if _lq and _mv
		_pc(_ei,f,"Asia",_rg(_gj,_ik,_ex,_ir,_hv),#5E35B1,tam)
		f+=1
		_pc(_ei,f,"Londres",_rg(_mb,_on,_hu,_mx,_mw),#1E88E5,tam)
		f+=1
	if _ps or _fg
		[_vs,_uj,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _ps
			rng=d_h-d_l
			_lp=_uj > 0?rng/_uj*100:na
			_pc(_ei,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_uj,"#")+" pts ("+str.tostring(_lp,"#")+" %)",na(_lp)?#757575:_lp >=100?_u:_lp >=75?#EF6C00:#424242,tam)
			f+=1
		if _fg
			dif=close-_vs
			_pc(_ei,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_u:_z,tam)
			f+=1
	if _kz
		float _uw=na
		string _vf=""
		float _ux=na
		string _we=""
		_pe=array.from(pdh,pdl,_ir?na:_gj,_hv?na:_ik,_mx?na:_mb,_mw?na:_on)
		_pp=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _as
			_pe.push(nv._dr)
			_pp.push(nv.dir==1?"Alto H4":"Bajo H4")
		for q in _dn
			_pe.push(q._dr)
			_pp.push(q.dir==1?"EQH":"EQL")
		for i=0 to _pe.size()-1
			pv=_pe.get(i)
			if not na(pv)
				if pv > close and(na(_uw)or pv < _uw)
					_uw:=pv
					_vf:=_pp.get(i)
				if pv < close and(na(_ux)or pv > _ux)
					_ux:=pv
					_we:=_pp.get(i)
		_ue=(na(_uw)?"↑ —":"↑ "+_vf+" "+str.tostring(_uw,format.mintick)+" (+"+str.tostring(_uw-close,format.mintick)+")")+"  ·  "+(na(_ux)?"↓ —":"↓ "+_we+" "+str.tostring(_ux,format.mintick)+" (−"+str.tostring(close-_ux,format.mintick)+")")
		_pc(_ei,f,"Liquidez",_ue,#424242,tam)
		f+=1
	if _ow !=""
		_pc(_ei,f,"Noticias hoy",_ow,#EF6C00,tam)
		f+=1
alertcondition(_hs,"SMT bajista","SMT bajista (divergencia en altos entre índices) en {{ticker}} ({{interval}})")
alertcondition(_hr,"SMT alcista","SMT alcista (divergencia en bajos entre índices) en {{ticker}} ({{interval}})")
