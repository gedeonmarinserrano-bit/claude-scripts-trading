type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _et=array.new<box>()
var array<line> _di=array.new<line>()
var array<label> _by=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qr(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _et.size()
		b=_et.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_et.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_or(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _di.size()
		l=_di.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_di.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_mi(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _by.size()
		e=_by.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_by.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xw
	bool _sq
var array<Letrero> _fl=array.new<Letrero>()
_fj=nz(ta.atr(50))*0.5
_uo=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_pf)
_eg=nz(ta.atr(50))*_uo/100
var array<Pieza> _gl=array.new<Pieza>()
_wd(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_ps(Pieza p)=>
	res=array.from(p)
	if _kx and _gl.size()> 0
		for o in _gl
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xh=array.new<Pieza>()
				for q in res
					for r in _wd(q,o)
						_xh.push(r)
				res:=_xh
				if res.size()==0 or res.size()> 10
					break
	res
_gu(Pieza p,color col,int dir)=>
	for q in _ps(p)
		top=q.top
		bot=q.bot
		if _eg > 0 and dir !=0
			for o in _gl
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_eg
						top:=math.min(top,o.bot-_eg)
					if math.abs(bot-o.top)<=_eg
						bot:=math.max(bot,o.top+_eg)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qr(q.x1,top,q.x2,bot,col)
_ml(int _vm,int x2,float _ah,float _ai,int dir,float _bi,color col,string txt,color _wo,color _qf,color _oi,bool _sq)=>
