	uso.set(1,i+1)
_lo(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bx.size()
		e=_bx.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
