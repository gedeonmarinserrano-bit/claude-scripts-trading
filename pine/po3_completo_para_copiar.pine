			t1=_fk(_rn,_pu,_iw)
			t2=_fk(_qw,_pm,_id)
			_kf(_ha,_fb,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_je,true)
		_ha:=_qk
		_fb:=_md
		_iw:=_pu
		_id:=_pm
	if not na(_mz)
		_re=not na(_hf)and _qk-_hf <=_pg
