	_dh(0,_bm,_bm and not _bm[1],_fz,1,"Asia",#5E35B1)
	_dh(1,_bm,_bm and not _bm[1],_gz,-1,"Asia",#5E35B1)
	_dh(2,_dk,_dk and not _dk[1],_me,1,"Londres",#1E88E5)
	_dh(3,_dk,_dk and not _dk[1],_ne,-1,"Londres",#1E88E5)
