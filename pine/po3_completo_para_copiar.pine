		_hl:=_ra
		_gd:=_nf
		_iq:=_pr
		_jb:=_qf
	if not na(_nr)
		_rp=not na(_hp)and _ra-_hp <=_ps
		d1=_rp and _pd and _do(_nr,_fv,_qj,_iw,false)
		d2=_rp and _oc and _do(_nr,_fv,_qh,_jj,false)
		if d1 or d2
			_io:=true
			_ci:=bar_index
			_du:=1
			_ip=_nr < _fv
			xv=_ip?_ra:bar_index+int(d1?_sg:_rq)
			t1=_fx(_se,_qj,_iw)
			t2=_fx(_rz,_qh,_jj)
			_la(_hp,_fv,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ik,false)
		_hp:=_ra
		_fv:=_nr
		_iw:=_qj
		_jj:=_qh
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _eq=array.new<box>()
var array<line> _dg=array.new<line>()
var array<label> _bv=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qq(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eq.size()
		b=_eq.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eq.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_pc(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dg.size()
		l=_dg.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dg.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_me(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bv.size()
		e=_bv.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
