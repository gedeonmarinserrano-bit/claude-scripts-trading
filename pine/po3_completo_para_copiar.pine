	_eq.clear(0,0,1,13)
	int f=0
	int _xa=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_xa:=request.security(syminfo.tickerid,"240",_qb(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_qb(),lookahead=barmerge.lookahead_on)
	_qf(_eq,f,"Bias H4",_d < 14400?_lj(_xa):"(gráfico ≥ H4)",_lx(_xa),tam)
	f+=1
	_qf(_eq,f,"Bias H1",_d < 3600?_lj(b60):"(gráfico ≥ H1)",_lx(b60),tam)
	f+=1
	ev=_fd.get(0)
	_xk=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_fc.get(0))+" velas"
	_qf(_eq,f,"Estructura "+_dv,_lj(_i)+_xk,_lx(_i),tam)
	f+=1
	tz="America/New_York"
	_wv=hour(timenow,tz)*60+minute(timenow,tz)
	_yn=dayofweek(timenow,tz)
	_yh=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yr=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_ws=_yn==dayofweek.saturday or _yn==dayofweek.sunday
	_vd=570-_wv
	ses=_ws?"Cerrada (fin de semana)":_wv < 570?"Abre a las "+str.format_time(_yh,"HH:mm","Europe/Madrid")+" (en "+(_vd >=60?str.tostring(int(_vd/60))+" h ":"")+str.tostring(_vd%60)+" min)":_wv < 960?"● Abierta (cierra "+str.format_time(_yr,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yh,"HH:mm","Europe/Madrid")+")"
	_qf(_eq,f,"Sesión NY",ses,not _ws and _wv >=570 and _wv < 960?_ad:#424242,tam)
	f+=1
	float _su=na
	string _xm=""
	float _sv=na
	string _xf=""
	if _pk
		[d1,t1]=_bl(_hd,"FVG "+_dv,true)
		[d2,t2]=_bl(_hy,"IFVG "+_dv,true)
		[d3,t3]=_bl(_hd,"FVG "+_dv,false)
		[d4,t4]=_bl(_hy,"IFVG "+_dv,false)
		if not na(d1)and(na(_su)or d1 < _su)
			_su:=d1
			_xm:=t1
		if not na(d2)and(na(_su)or d2 < _su)
			_su:=d2
			_xm:=t2
		if not na(d3)and(na(_sv)or d3 < _sv)
			_sv:=d3
			_xf:=t3
		if not na(d4)and(na(_sv)or d4 < _sv)
			_sv:=d4
			_xf:=t4
	if not _l
		for k=0 to 4
			arr=k==0?_xt:k==1?_wb:k==2?_qw:k==3?_qv:_kq
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cs:k==1?_bw:k==2?_ax:k==3?_bc:_aq
			if ver
				[da,ta_]=_bl(arr,nom,true)
				[db,tb]=_bl(arr,nom,false)
				if not na(da)and(na(_su)or da < _su)
					_su:=da
					_xm:=ta_
				if not na(db)and(na(_sv)or db < _sv)
					_sv:=db
					_xf:=tb
	_qf(_eq,f,"FVG por arriba",_xd(_su,_xm),_xl(_xm),tam)
	f+=1
	_qf(_eq,f,"FVG por abajo",_xd(_sv,_xf),_xl(_xf),tam)
	f+=1
	_us=not _dy?"(apagada)":na(_cn)?"Ninguna reciente":(_do==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cn)+" velas"
	_qf(_eq,f,"SMT",_us,not _dy or na(_cn)?#757575:_do==1?_jq:_in,tam)
	f+=1
