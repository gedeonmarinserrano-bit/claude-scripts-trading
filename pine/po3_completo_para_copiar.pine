	_fo
_bw(array<Zona> fvg,array<Zona> _tt,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xg,float _rv)=>
	_tu=false
	if ah.size()> 0
		_fd=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tt
				n=s.n-z._ri
				if not z._lw and n >=1 and n <=_gv and h1 >=z._ag and l1 <=z._ah
					if k <=_fd
						z._lw:=true
					_tu:=true
			if k <=_fd
				if _tt.size()> 0
					for i=_tt.size()-1 to 0
						if _gq(_tt.get(i),h1,l1)
							_tt.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ah and c1 < z._ag):(o1 <=z._ag and c1 > z._ah))
						if inv
							fvg.remove(i)
							_tt.push(Zona.new(z.x1,z._ah,z._ag,-z.dir,na,s.n))
							if _tt.size()> _xg
								_tt.shift()
						else if _gq(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rv
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rv
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xg
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_tu
