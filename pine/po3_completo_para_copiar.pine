_cv=input.bool(false,"FVG M1",inline="fvgtf2",group=_cz)
_pb=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_cz)
_l=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_cz)
_gn=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cz)
_ls=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cz)
_pz=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cz)
_nq="Estructura (CHoCH / BOS)"
_cc=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_nq)
_te=1.1
_us=2.0
_vj=20
_ss=2
_nj=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_nq)
_is=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_nq)
_id=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_nq)
_je=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_nq)
_eq=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_nq)
_qu=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_nq)
_ba=bar_index >=last_bar_index-_qu
_ck=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mz=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_am=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_ut="Order Blocks"
_la=input.bool(true,"Mostrar Order Blocks",group=_ut)
_fv=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_ut)
_nf=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_ut)
_wy=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_ut)
_mk=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_ut)
_kl=input.color(#1565C0,"OB alcista (demanda)",group=_ut)
_kq=input.color(#EF6C00,"OB bajista (oferta)",group=_ut)
_pl="Estrategia NY (Bias + PO3)"
_ma=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_pl)
_ky=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_pl)
_tv="Colores FVG"
_ao=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_tv)
_an=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_tv)
_rl=_ao
_mr=_ao
_nh=_ao
_kg=_ao
_ke=_ao
_hr=_ao
_sk=_an
_mo=_an
_nk=_an
_lc=_an
_kr=_an
_jf=_an
_jx=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pl)
_qr=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pl)
_kw=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pl)
_js=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pl)
_ql=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pl)
_kp=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pl)
_kn=input.color(#8D6E63,"Color niveles H1",group=_pl)
_qq=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_pl)
_dr=input.color(#424242,"Color niveles clave",group=_pl)
_mm=input.color(#757575,"Color horas",group=_pl)
_en=input.bool(true,"Mostrar EMAs",group="EMAs")
_oo=input.int(9,"EMA rápida",minval=1,group="EMAs")
_oh=input.int(20,"EMA media",minval=1,group="EMAs")
_ob=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oy=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_of=input.color(#9E9D24,"Color EMA media",group="EMAs")
_ow=input.color(color.black,"Color EMA lenta",group="EMAs")
_ii=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hz=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fm=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kj=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vg=14
_sj=50
_tp=0.15
_qm=2.5
_qs=30
_pf=1.0
_lk=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oe="Colores"
_z=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oe)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oe)
_nb=input.bool(true,"Marcar la vela del OB",group=_oe)
_hi=input.color(#FF00C8,"IFVG (magenta)",group=_oe)
_mv=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oe)
_kd=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oe)
type Zona
	int x1
	float _ah
	float _ag
	int dir
	float _bi=na
	int _ri=na
	bool _lw=false
var _gz=array.new<Zona>()
var _hq=array.new<Zona>()
var obs=array.new<Zona>()
var _xk=array.new<Zona>()
var _vq=array.new<Zona>()
var _qo=array.new<Zona>()
var _qj=array.new<Zona>()
var _kx=array.new<Zona>()
var _wp=array.new<Zona>()
var _td=array.new<Zona>()
var _pk=array.new<Zona>()
var _pn=array.new<Zona>()
var _lf=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ag
	color col
var _bm=array.new<Rango>()
_ew(Zona z)=>
	_fo=z.dir==1?low <=z._ag:high >=z._ah
	if not _fo
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ag):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fo
type Marca
	label lb
	line ln
	int bar
var _ie=array.new<Marca>()
var array<string> _ey=array.from("")
var array<int> _fa=array.from(0)
_al(label lb,line ln,int bar)=>
	_ie.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ey.set(0,lb.get_text())
		_fa.set(0,bar)
	if _ie.size()> 500
		_ie.shift()
_qy=ta.ema(close,_oo)
_sd=ta.ema(close,_oh)
_ia=ta.ema(close,_ob)
_dd=ta.atr(_vg)
var string _tx='════════ Detection ════════'
var string _rw='════════ Structure Filters ════════'
var string _vi='════════ Range Behavior ════════'
var string _ts='════════ Visual Settings ════════'
_cq='Base + 2x + 3x'
_pc='Rangos'
_bn=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_pc)
_br='Percentile band'
_ej=90.0
_lt='Bar close'
_kt=200
_ja=40.0
_eo=500
_mt=0.18
_ou='Wick reaches'
_jl=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_pc)
_ee=0.10
_rs=0.45
_ep=0.70
_ip='Extend to containment'
_hs=300
_jr=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_pc)
_he=true
_lu=0.25
_mb='Close beyond'
_ik=0.15
_hd=true
_hb=10
_lj=3
_fx=0
_ne='Custom'
_lz=#00A651
_li=#E4002B
_fg=input.color(#F9A825,'Color del rango (neutral)',group=_pc)
_jz=4
_gi=93
_hg=true
_jw=true
_gy=input.bool(true,'Mostrar etiqueta del rango',group=_pc)
_ka=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_pc)
_jg=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_pc)
_jc='Small'
_ex=true
_kb='Small'
[_ch,_cf]=switch _ne
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lz,_li]
var color _cb=color.new(color.black,100)
var float _cg=3.0
var float _dt=1.6
_if(string _xe)=>
	switch _xe
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fe(color _dh)=>
	_jd=color.r(_dh)/255.0
	_iw=color.g(_dh)/255.0
	_ij=color.b(_dh)/255.0
	_tn=_jd <=0.03928?_jd/12.92:math.pow((_jd+0.055)/1.055,2.4)
	_ta=_iw <=0.03928?_iw/12.92:math.pow((_iw+0.055)/1.055,2.4)
	_su=_ij <=0.03928?_ij/12.92:math.pow((_ij+0.055)/1.055,2.4)
	0.2126*_tn+0.7152*_ta+0.0722*_su
_me(color _nv,color _ng)=>
	_mn=_fe(_nv)
	_kz=_fe(_ng)
	(math.max(_mn,_kz)+0.05)/(math.min(_mn,_kz)+0.05)
_eg(color _hm)=>
	_fe(_hm)> 0.179?#000000:#ffffff
_or(color _dh,color _no,float _rq)=>
	color.rgb(color.r(_dh)+(color.r(_no)-color.r(_dh))*_rq,color.g(_dh)+(color.g(_no)-color.g(_dh))*_rq,color.b(_dh)+(color.b(_no)-color.b(_dh))*_rq)
_bk(color _dh,color _hm,float _od)=>
	_no=_eg(_hm)
	_lr=_dh
	for step=1 to 10
		if _me(_lr,_hm)>=_od
			break
		_lr:=_or(_dh,_no,step/10.0)
	_lr
_jm(float _xs)=>
	str.tostring(_xs,'#.##')+'%'
_qp(array<box> _jy,int _le,float _bc,float _ai)=>
	array.clear(_jy)
	if not _kd
		for i=0 to _jz-1
			array.push(_jy,box.new(_le,_bc,bar_index,_ai,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gf(array<box> _jy,float _bc,float _ai,int _le,int _rg,color _nr)=>
	_pr=array.size(_jy)
	if _pr > 0 and _bc > _ai
		_gp=(_bc-_ai)/_pr
		for i=0 to _pr-1
			_iu=array.get(_jy,i)
			_nz=math.abs((i+0.5)/_pr-0.5)*2.0
			_ot=int(math.min(99,math.max(0,_gi+(1.0-_nz)*10)))
			box.set_lefttop(_iu,_le,_bc-_gp*i)
			box.set_rightbottom(_iu,_rg,_bc-_gp*(i+1))
			box.set_bgcolor(_iu,color.new(_nr,_ot))
_om(array<box> _jy)=>
	if array.size(_jy)> 0
		for i=0 to array.size(_jy)-1
			box.delete(array.get(_jy,i))
	array.clear(_jy)
_qx(int _sa,float _bc,float _ai,float _cn)=>
	_ya=_sa
	if _ip=='Extend to containment'
		_xi=math.min(_hs,bar_index)
		_ux=math.max(2,math.round((1.0-_ep)*_sa))
		_lp=0
		_gw=0
		while _gw < _xi and _lp <=_ux
			_np=close[_gw]<=_bc and close[_gw]>=_ai
			_ti=_np and high[_gw]<=_bc+_cn and low[_gw]>=_ai-_cn
			if _np
				_lp:=math.max(0,_lp-1)
				if _ti and _gw+1 >=_sa
					_ya:=_gw+1
			else
				_lp+=1
			_gw+=1
	_ya
_cj=ta.atr(_kt)
_kk=not na(_cj)and _cj > 0
_gg=_mb=='Wick beyond'
_kf=_ou=='Wick reaches'
_oi=_lt=='Live bar'
_fk=_oi or barstate.isconfirmed
_gk=_if(_jc)
_ku=_if(_kb)
_v=chart.bg_color
_r=_bk(_fg,_v,_cg)
_fz=_bk(_ch,_v,_cg)
_fw=_bk(_cf,_v,_cg)
_hh=_bk(_fg,_v,_dt)
_fq=_bk(_ch,_v,_dt)
_ga=_bk(_cf,_v,_dt)
_gm(simple int len)=>
	_ur=ta.percentile_linear_interpolation(high,len,_ej)
	_qn=ta.percentile_linear_interpolation(low,len,100.0-_ej)
	_uk=ta.highest(high,len)
	_qk=ta.lowest(low,len)
	_tj=ta.highest(math.max(open,close),len)
	_on=ta.lowest(math.min(open,close),len)
	top=_br=='Absolute extremes'?_uk:_br=='Body extremes'?_tj:_ur
	_kv=_br=='Absolute extremes'?_qk:_br=='Body extremes'?_on:_qn
	_dz=top-_kv
	_oj=_kk and _dz > 0?_dz/(_cj*math.sqrt(len)):99.0
	_tl=bar_index < 1?_eo:int(math.max(1,math.min(_eo,bar_index-_kt)))
	_yd=ta.percentrank(_oj,_tl)
	_xn=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xj=_dz > 0?math.abs(_xn)*len/_dz:99.0
	_ct=math.avg(top,_kv)
	_cn=_ee*nz(_cj)
	_mj=0
	_pg=0
	_jn=0
	_nd=0
	for i=0 to len-1
		if(close[i]> _ct)!=(close[i+1]> _ct)
			_mj+=1
		_nx=_kf?high[i]>=top-_cn:close[i]>=top-_cn
		_jv=_kf?low[i]<=_kv+_cn:close[i]<=_kv+_cn
		if _nx
			_pg+=1
		if _jv
			_jn+=1
		if close[i]<=top and close[i]>=_kv
			_nd+=1
	_ov=_nd/float(len)
	_hw=_kk and not na(_yd)and bar_index > len+5 and _yd <=_ja and _mj >=math.max(3,math.round(_mt*len))and _pg >=_jl and _jn >=_jl and _xj <=_rs and _ov >=_ep
	[_hw,top,_kv]
bool _ht=false
bool _jb=false
bool _iy=false
float _vx=na
float _xa=na
float _wf=na
float _qb=na
float _qd=na
float _ph=na
if _ba
	[qa,ta_,ba]=_gm(_bn)
	_ht:=qa
	_vx:=ta_
	_qb:=ba
	if _cq !='Base only'
		[qb,tb,bb]=_gm(_bn*2)
		_jb:=qb
		_xa:=tb
		_qd:=bb
	if _cq=='Base + 2x + 3x'
		[qc,tc,bc]=_gm(_bn*3)
		_iy:=qc
		_wf:=tc
		_ph:=bc
_es=_cq !='Base only' and _jb
_er=_cq=='Base + 2x + 3x' and _iy
_hw=_ht or _es or _er
_ox=_er?_bn*3:_es?_bn*2:_bn
_ps=_er?_wf:_es?_xa:_vx
_it=_er?_ph:_es?_qd:_qb
var array<box> _at=array.new<box>()
var box _s=na
var line _g=na
var line _k=na
var line _w=na
var label _y=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gu=na
var bool _t=false
var bool _m=false
var bool _bd=false
var int _ds=na
var int _o=0
var float _p=na
var int _az=na
var int _ay=0
_cd=false
_ci=false
_bl=false
_ca=false
if _fk and _ay > 0
	_ay-=1
if _fk and not _t and not _bd and _ay <=0 and _hw
	_ns=_qx(_ox,_ps,_it,_ee*_cj)
	_c:=bar_index-_ns+1
	_gu:=bar_index
	_f:=_ps
	_a:=_it
	_t:=true
	_m:=false
	_ct=math.avg(_f,_a)
	_by=_a+(_f-_a)*0.25
	_bg=_a+(_f-_a)*0.75
	_s:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qp(_at,_c,_f,_a)
	if _hg
		_g:=line.new(_c,_ct,bar_index,_ct,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jw
		_k:=line.new(_c,_by,bar_index,_by,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_bg,bar_index,_bg,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gy
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cb,style=label.style_label_down,textcolor=color.new(_r,10),size=_gk)
	_cd:=true
if _t and _fk
	_cs=_ik*_cj
	_gc=_lu*_cj
	if _he and not _gg and close <=_f and close >=_a
		if high > _f and high <=_f+_gc
			_f:=high
		if low < _a and low >=_a-_gc
			_a:=low
	_pq=_gg?high > _f+_cs:close > _f+_cs
	_ki=_gg?low < _a-_cs:close < _a-_cs
	_qv=_fx > 0 and bar_index-_gu+1 >=_fx
	if _pq or _ki or _qv
		_b=_pq?1:_ki?-1:0
		_sb=_b !=0?bar_index-_c:bar_index-_c+1
		_nn=_a !=0?(_f-_a)/_a*100.0:0.0
		_jt=_hd and _b !=0 and _m
		if _m
			_ff=_b==1?_fz:_b==-1?_fw:_r
			_ny=_b==1?_fq:_b==-1?_ga:_hh
			_iz=_b==1?_ch:_b==-1?_cf:_fg
			box.set_lefttop(_s,_c,_f)
			box.set_rightbottom(_s,bar_index,_a)
			box.set_border_color(_s,color.new(_ff,30))
			box.set_border_style(_s,line.style_dotted)
			_gf(_at,_f,_a,_c,bar_index,na)
			_bm.push(Rango.new(_c,bar_index,_f,_a,_ny))
			if _bm.size()> 8
				_bm.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_sb)+' BARS   '+_jm(_nn))
				label.set_textcolor(_y,color.new(_ff,10))
			if _ka and _b !=0
				_ok=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _ex
