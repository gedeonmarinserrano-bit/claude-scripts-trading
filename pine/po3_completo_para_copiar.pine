_dg(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_rn=(dir==1?"Máximo ":"Mínimo ")+ses
	o=_no.get(k)
	if ini
		if not na(o)
			o.ln.delete()
			o.lb.delete()
		if _ae.size()> 0
			for i=_ae.size()-1 to 0
				q=_ae.get(i)
				if q.k==k
					q.ln.delete()
					q.lb.delete()
					_ae.remove(i)
		o:=NivelSes.new(line.new(bar_index,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,_rn,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny),v,na,k)
		_no.set(k,o)
	else if not na(o)
		if en
			o._ar:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
		else if not na(o._wd)and bar_index-o._wd <=5
			nv=dir==1?math.max(o._ar,high):math.min(o._ar,low)
			o._ar:=nv
			o.ln.set_y1(nv)
			o.ln.set_y2(nv)
		else if dir==1?high > o._ar:low < o._ar
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._ar)
			o.lb.set_text((dir==1?"Máximo manipulado ":"Mínimo manipulado ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			_ae.push(o)
			if _ae.size()> 24
				q=_ae.shift()
				q.ln.delete()
				q.lb.delete()
			nv=dir==1?high:low
			o:=NivelSes.new(line.new(bar_index,nv,bar_index,nv,color=color.new(col,15),width=1),label.new(bar_index,nv,_rn,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny),nv,bar_index,k)
			_no.set(k,o)
		o.ln.set_x2(bar_index)
		o.lb.set_xy(bar_index,o._ar)
if _mr and _jl and _ba
	if((_as and not _as[1])or(_cn and not _cn[1])or(_en and not _en[1]))and _ae.size()> 0
