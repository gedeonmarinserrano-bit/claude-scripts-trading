		d1=_sd and _oq and _dw(_nm,_gc,_qg,_jr,false)
		d2=_sd and _of and _dw(_nm,_gc,_qa,_jf,false)
		if d1 or d2
			_ih:=true
			_ci:=bar_index
			_dv:=1
			_ja=_nm < _gc
			xv=_ja?_qw:bar_index+int(d1?_sp:_sc)
			t1=_fy(_ry,_qg,_jr)
			t2=_fy(_rr,_qa,_jf)
			_kv(_hl,_gc,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jg,false)
		_hl:=_qw
		_gc:=_nm
		_jr:=_qg
		_jf:=_qa
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ek=array.new<box>()
var array<line> _dk=array.new<line>()
var array<label> _bw=array.new<label>()
var array<int> uso=array.from(0,0,0)
_rb(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ek.size()
		b=_ek.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ek.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_ow(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dk.size()
		l=_dk.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dk.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lj(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bw.size()
		e=_bw.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bw.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xp
	bool _rh
var array<Letrero> _ft=array.new<Letrero>()
_if=nz(ta.atr(50))*0.5
_vn=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_pf)
_en=nz(ta.atr(50))*_vn/100
var array<Pieza> _gm=array.new<Pieza>()
_wc(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pj(Pieza p)=>
	res=array.from(p)
	if _le and _gm.size()> 0
		for o in _gm
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xg=array.new<Pieza>()
				for q in res
					for r in _wc(q,o)
						_xg.push(r)
				res:=_xg
				if res.size()==0 or res.size()> 10
					break
	res
_gy(Pieza p,color col,int dir)=>
	for q in _pj(p)
		top=q.top
		bot=q.bot
		if _en > 0 and dir !=0
			for o in _gm
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_en
						top:=math.min(top,o.bot-_en)
					if math.abs(bot-o.top)<=_en
						bot:=math.max(bot,o.top+_en)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_rb(q.x1,top,q.x2,bot,col)
_mt(int _up,int x2,float _ah,float _ai,int dir,float _bi,color col,string txt,color _wx,color _pq,color _ol,bool _rh)=>
	x1=math.max(_up,bar_index-1000)
	_yj=na(_bi)?_ah:(dir==1?_bi:_ah)
	_yl=na(_bi)?_ai:(dir==1?_ai:_bi)
	_gy(Pieza.new(x1,x2,_yj,_yl),col,dir)
	if not na(_bi)
		_gy(Pieza.new(x1,x2,dir==1?_ah:_bi,dir==1?_bi:_ai),_ol,dir)
	if txt !="" and _ft.size()< 60
		_ft.push(Letrero.new(x2,(_yj+_yl)/2,txt,_wx,true,_rh))
	if not na(_pq)
		m=(_ah+_ai)/2
		for q in _pj(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_ow(q.x1,q.x2,m,_pq)
	_gm.push(Pieza.new(x1,x2,_ah,_ai,dir))
_ay(array<Zona> arr,color _xr,color _xy,int _tx,string txt,bool _ym,bool _ti,color _ol,bool _rh)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xr:_xy
			t=txt
			_yw=z._ai > close?z._ai-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gm.size()< _mf and(_pn==0 or _yw/close*100 <=_pn)
				_mt(z.x1,bar_index+1,z._ah,z._ai,z.dir,z._bi,color.new(c,_nc),t,c,_ti?color.new(color.white,30):na,_ol,_rh)
