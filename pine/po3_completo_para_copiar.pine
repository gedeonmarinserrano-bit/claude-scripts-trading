			xv=_jc?_qt:bar_index+int(d1?_rp:_sj)
			t1=_fo(_sr,_px,_ib)
			t2=_fo(_ry,_qh,_jl)
			_kk(_hl,_ge,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jg,true)
		_hl:=_qt
