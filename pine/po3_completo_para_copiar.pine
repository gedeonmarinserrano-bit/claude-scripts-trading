_dq(float y,float _vs,float c,float _ns,bool _ny)=>
	_vi=_ny?y > _vs:y < _vs
	_uv=_ny?c > _ns:c < _ns
	not na(_vs)and not na(_ns)and not na(c)and _vi !=_uv
_gb(string t,float c,float _ns)=>
	t+(c > _ns?" ↑":c < _ns?" ↓":" =")
_ky(int x1,float y1,int xv,string txt,color col,bool _ny)=>
	yv=_ny?high[bar_index-xv]:low[bar_index-xv]
