_mw=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_io)
_cz="FVG por temporalidad (solo se ven los activados)"
_ar=input.bool(true,"FVG H4",inline="fvgtf1",group=_cz)
_ax=input.bool(true,"FVG H1",inline="fvgtf1",group=_cz)
_aw=input.bool(true,"FVG M15",inline="fvgtf1",group=_cz)
