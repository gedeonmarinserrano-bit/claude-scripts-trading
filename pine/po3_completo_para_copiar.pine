	if not na(_mo)
		_rk=not na(_hk)and _qo-_hk <=_ph
		d1=_rk and _oq and _dp(_mo,_fi,_pz,_hy,false)
		d2=_rk and _nn and _dp(_mo,_fi,_px,_ir,false)
		if d1 or d2
			_ht:=true
			_cj:=bar_index
			_du:=1
			_jb=_mo < _fi
			xv=_jb?_qo:bar_index+int(d1?_ro:_rb)
			t1=_ft(_rd,_pz,_hy)
			t2=_ft(_rf,_px,_ir)
			_la(_hk,_fi,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jn,false)
		_hk:=_qo
