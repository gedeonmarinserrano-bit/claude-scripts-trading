	if _ed(_aj+45)
		_db(_ef(_aj+45),false)
	if _ed(_aj+60)
		_db(_ef(_aj+60),true)
_ke()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_rn(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_bn(array<Zona> arr,float _an,float _al,int dir,int _sa)=>
	z=Zona.new(_rn(_sa),_an,_al,dir)
	if not _ec(z)
		arr.push(z)
		if arr.size()> _fq
			arr.shift()
_bk(array<Zona> arr,array<Zona> _dg)=>
	_sr=false
	if _dg.size()> 0
		for i=_dg.size()-1 to 0
			if _ec(_dg.get(i))
				_dg.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_qw=(z._an+z._al)/2
			if low <=_qw and high >=_qw
				_sr:=true
			_hr=na(z._bz)and(z.dir==1?(open >=z._an and close < z._al):(open <=z._al and close > z._an))
			if _hr
				arr.remove(i)
				_dg.push(Zona.new(z.x1,z._an,z._al,-z.dir,na,bar_index))
				if _dg.size()> _fq
					_dg.shift()
			else if _ec(z)
				arr.remove(i)
	_sr
_rp=timeframe.change("5")
_qe=timeframe.change("15")
_qi=timeframe.change("60")
_le=timeframe.change("240")
_on=false
_hg=false
_jk=false
_jh=false
if _bu and timeframe.isintraday and _ch
	if _cl and not _p and _jq < 300
		_on:=_bk(_su,_qc)
		if _rp
			[a5,b5,_sz,_ss,_si,_td,t5]=request.security(syminfo.tickerid,"5",_ke(),lookahead=barmerge.lookahead_on)
			if a5
				_bn(_su,_sz,_ss,1,t5)
			else if b5
				_bn(_su,_td,_si,-1,t5)
	if _cc and not _p and _jq < 900
		_hg:=_bk(_pn,_nx)
		if _qe
			[a15,b15,_rr,_rl,_rm,_rs,t15]=request.security(syminfo.tickerid,"15",_ke(),lookahead=barmerge.lookahead_on)
			if a15
				_bn(_pn,_rr,_rl,1,t15)
			else if b15
				_bn(_pn,_rs,_rm,-1,t15)
	if _ca and not _p and _jq < 3600
		_jk:=_bk(_py,_nu)
		if _qi
			[a60,b60,_rq,_rk,_rw,_rz,t60]=request.security(syminfo.tickerid,"60",_ke(),lookahead=barmerge.lookahead_on)
			if a60
				_bn(_py,_rq,_rk,1,t60)
			else if b60
				_bn(_py,_rz,_rw,-1,t60)
	if _bi and not _p and _jq < 14400
		_jh:=_bk(_lc,_km)
		if _le
			[_uk,_uq,_qj,_qu,_qo,_qr,_ua]=request.security(syminfo.tickerid,"240",_ke(),lookahead=barmerge.lookahead_on)
			if _uk
				_bn(_lc,_qj,_qu,1,_ua)
			else if _uq
				_bn(_lc,_qr,_qo,-1,_ua)
type Nivel
	line ln
	label lb
	float _if
	int dir
var _bc=array.new<Nivel>()
_tf()=>
	[ta.pivothigh(high,_cz,_cz)[1],ta.pivotlow(low,_cz,_cz)[1],time[1+_cz]]
[ph4,pl4,tp4]=request.security(syminfo.tickerid,"240",_tf(),lookahead=barmerge.lookahead_on)
_gy(float _if,int dir,int _sa)=>
	ln=line.new(_sa,_if,time,_if,xloc=xloc.bar_time,color=color.new(_dd,20),width=1)
	lb=label.new(time,_if,dir==1?"Alto H4":"Bajo H4",xloc=xloc.bar_time,style=label.style_label_left,color=color.new(color.white,100),textcolor=color.new(_dd,10),size=size.tiny)
	_bc.push(Nivel.new(ln,lb,_if,dir))
	if _bc.size()> _ok
		n=_bc.shift()
		n.ln.delete()
		n.lb.delete()
if _bu and _iv and timeframe.isintraday and _jq < 14400
	if _bc.size()> 0
		for i=_bc.size()-1 to 0
			n=_bc.get(i)
			if(n.dir==1 and close > n._if)or(n.dir==-1 and close < n._if)
				n.ln.delete()
				n.lb.delete()
				_bc.remove(i)
			else
				n.ln.set_x2(time)
				n.lb.set_x(time)
	if _le
		if not na(ph4)
			_gy(ph4,1,tp4)
		if not na(pl4)
			_gy(pl4,-1,tp4)
[pdh,pdl]=request.security(syminfo.tickerid,"D",[high[1],low[1]],lookahead=barmerge.lookahead_on)
_qz=_oq and timeframe.isintraday and not timeframe.change("D")
plot(_qz?pdh:na,"Alto día anterior",color=color.new(_dd,30),style=plot.style_linebr,linewidth=1)
plot(_qz?pdl:na,"Bajo día anterior",color=color.new(_dd,30),style=plot.style_linebr,linewidth=1)
_gd="SMT (divergencias entre índices)"
_ib=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_gd)
_ki=input.bool(true,"Mostrar etiquetas de la SMT",group=_gd)
_pb=input.bool(true,"Mostrar línea de la SMT",group=_gd)
_qd=input.bool(true,"Comparar con",inline="smt1",group=_gd)
_ob=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_gd)
_qm=input.bool(true,"Comparar con",inline="smt2",group=_gd)
_ny=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_gd)
_fl=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_gd)
_ni=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_gd)
_pu=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_gd)
_nc=input.color(#ff1100,"SMT bajista (en altos)",group=_gd)
_nd=input.color(#2157f3,"SMT alcista (en bajos)",group=_gd)
_jj(string s)=>
	_rf=str.split(s,":")
	_rf.size()> 0?_rf.last():s
_oy=_jj(_ob)
_ox=_jj(_ny)
_st=str.replace(_oy,"1!","")
_te=str.replace(_ox,"1!","")
_rg=str.replace(syminfo.ticker,"1!","")
_ng=_ib and _qd and _st !=_rg
_mh=_ib and _qm and _te !=_rg
_pd()=>
	w=2*_fl+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _ns=na
float _nn=na
int _pl=na
int _os=na
float _nw=na
float _np=na
int _pp=na
int _pq=na
if _ng and _ch
	[h_,l_,hb_,lb_]=request.security(_ob,timeframe.period,_pd(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_ns:=h_
	_nn:=l_
	_pl:=hb_
	_os:=lb_
if _mh and _ch
	[h_,l_,hb_,lb_]=request.security(_ny,timeframe.period,_pd(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_nw:=h_
	_np:=l_
	_pp:=hb_
	_pq:=lb_
_lm=ta.pivothigh(high,_fl,_fl)
_ls=ta.pivotlow(low,_fl,_fl)
_oe=bar_index-_fl
var int _gp=na
var float _et=na
var float _hh=na
var float _hn=na
var int _go=na
var float _fc=na
var float _hj=na
var float _gw=na
var array<line> _fk=array.new<line>()
var array<label> _fo=array.new<label>()
_dk(float y,float _ru,float c,float _op,bool _mw)=>
	_ry=_mw?y > _ru:y < _ru
	_sc=_mw?c > _op:c < _op
	not na(_ru)and not na(_op)and not na(c)and _ry !=_sc
_es(string t,float c,float _op)=>
	t+(c > _op?" ↑":c < _op?" ↓":" =")
_jo(int x1,float y1,int xv,string txt,color col,bool _mw)=>
	yv=_mw?high[bar_index-xv]:low[bar_index-xv]
	if _pb
		_fk.push(line.new(x1,y1,xv,yv,color=col))
	if _ki
		_fo.push(label.new(xv,yv,txt,style=_mw?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_mw?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_mw?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _fk.size()> _pu
		_fk.shift().delete()
	if _fo.size()> _pu
		_fo.shift().delete()
_ii=false
_gu=false
if barstate.isconfirmed
	if not na(_lm)
		_pe=not na(_gp)and _oe-_gp <=_ni
		d1=_pe and _ng and _dk(_lm,_et,_ns,_hh,true)
		d2=_pe and _mh and _dk(_lm,_et,_nw,_hn,true)
		if d1 or d2
			_ii:=true
			_hc=_lm > _et
			xv=_hc?_oe:bar_index+int(d1?_pl:_pp)
			t1=_es(_oy,_ns,_hh)
			t2=_es(_ox,_nw,_hn)
			_jo(_gp,_et,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_nc,true)
		_gp:=_oe
		_et:=_lm
		_hh:=_ns
		_hn:=_nw
	if not na(_ls)
		_pe=not na(_go)and _oe-_go <=_ni
		d1=_pe and _ng and _dk(_ls,_fc,_nn,_hj,false)
		d2=_pe and _mh and _dk(_ls,_fc,_np,_gw,false)
		if d1 or d2
			_gu:=true
			_hc=_ls < _fc
			xv=_hc?_oe:bar_index+int(d1?_os:_pq)
			t1=_es(_oy,_nn,_hj)
			t2=_es(_ox,_np,_gw)
			_jo(_go,_fc,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_nd,false)
		_go:=_oe
		_fc:=_ls
		_hj:=_nn
		_gw:=_np
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _dt=array.new<box>()
var array<line> _cu=array.new<line>()
var array<label> _bp=array.new<label>()
var array<int> uso=array.from(0,0,0)
_oh(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _dt.size()
		b=_dt.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_dt.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_me(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _cu.size()
		l=_cu.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_cu.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_kf(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bp.size()
		e=_bp.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bp.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _tq
	bool _ot
var array<Letrero> _eq=array.new<Letrero>()
_lx=nz(ta.atr(50))*0.5
_sf=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_mv)
_dq=nz(ta.atr(50))*_sf/100
var array<Pieza> _fp=array.new<Pieza>()
_sv(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_oc(Pieza p)=>
	res=array.from(p)
	if _jm and _fp.size()> 0
		for o in _fp
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_so=array.new<Pieza>()
				for q in res
					for r in _sv(q,o)
						_so.push(r)
				res:=_so
				if res.size()==0 or res.size()> 10
					break
	res
_fy(Pieza p,color col,int dir)=>
	for q in _oc(p)
		top=q.top
		bot=q.bot
		if _dq > 0 and dir !=0
			for o in _fp
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_dq
						top:=math.min(top,o.bot-_dq)
					if math.abs(bot-o.top)<=_dq
						bot:=math.max(bot,o.top+_dq)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_oh(q.x1,top,q.x2,bot,col)
_kx(int _rx,int x2,float _an,float _al,int dir,float _bz,color col,string txt,color _tc,color _nq,color _mo,bool _ot)=>
	x1=math.max(_rx,bar_index-1000)
	_ty=na(_bz)?_an:(dir==1?_bz:_an)
	_tz=na(_bz)?_al:(dir==1?_al:_bz)
	_fy(Pieza.new(x1,x2,_ty,_tz),col,dir)
	if not na(_bz)
		_fy(Pieza.new(x1,x2,dir==1?_an:_bz,dir==1?_bz:_al),_mo,dir)
	if txt !="" and _eq.size()< 30
		_eq.push(Letrero.new(x2,(_ty+_tz)/2,txt,_tc,true,_ot))
	if not na(_nq)
		m=(_an+_al)/2
		for q in _oc(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_me(q.x1,q.x2,m,_nq)
	_fp.push(Pieza.new(x1,x2,_an,_al,dir))
_aw(array<Zona> arr,color _tm,color _tn,int _qy,string txt,bool _uc,bool _qw,color _mo,bool _ot)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_tm:_tn
			t=txt
			_uo=z._al > close?z._al-close:close > z._an?close-z._an:0.0
			if uso.get(0)< 440 and _fp.size()< _kp and(_nr==0 or _uo/close*100 <=_nr)
				_kx(z.x1,bar_index+1,z._an,z._al,z.dir,z._bz,color.new(c,_ku),t,c,_qw?color.new(color.white,30):na,_mo,_ot)
_as()=>
	if _ql
		_aw(_kc,_gm,_gm,88,"IFVG "+_kq,true,false,_af,false)
		_aw(_ix,_qv,_qs,80,"FVG "+_kq,true,false,_af,true)
	_aw(obs,_jd,_jc,90,"OB "+_kq,true,false,_af,false)
_cw(bool ver,int _uf,array<Zona> f,array<Zona> fi,color ca,color cb,int _qy,string nom)=>
	if ver and not _p and _f !=_uf*60
		_aw(fi,_gm,_gm,88,"IFVG "+nom,true,false,_af,false)
		_aw(f,ca,cb,_qy,"FVG "+nom,true,_uf >=15,_af,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_eq.clear()
	_fp.clear()
	_ad=false
	if _f <=60
		_as()
		_ad:=true
	_cw(_du,1,_ub,_sk,_ky,_ld,84,"M1")
	if not _ad and _f <=300
		_as()
		_ad:=true
	_cw(_cl,5,_su,_qc,_kw,_lo,84,"M5")
	if not _ad and _f <=900
		_as()
		_ad:=true
	_cw(_cc,15,_pn,_nx,_ju,_jf,84,"M15")
	if not _ad and _f <=3600
		_as()
		_ad:=true
	_cw(_ca,60,_py,_nu,_jp,_jg,82,"H1")
	if not _ad and _f <=14400
		_as()
		_ad:=true
	_cw(_bi,240,_lc,_km,_ih,_hs,80,"H4")
	if not _ad
		_as()
	if _eq.size()> 0
		_lb=array.new<Letrero>()
		for l in _eq
			x=l.x
			_th=str.length(l.txt)+2
			for _tk=0 to 3
				_sx=false
				for c in _lb
					_pz=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _lx and x > c.x-_pz and x-_th < c.x
						x:=c.x-_pz
						_sx:=true
				if not _sx
					break
			_lb.push(Letrero.new(x,l.y,l.txt,l.col,true,l._ot))
			_kf(x,l.y,l.txt,color.white)
	while _dt.size()> uso.get(0)
		_dt.pop().delete()
	while _cu.size()> uso.get(1)
		_cu.pop().delete()
	while _bp.size()> uso.get(2)
		_bp.pop().delete()
alertcondition(_ii,"SMT bajista","SMT bajista (divergencia en altos entre índices) en {{ticker}} ({{interval}})")
alertcondition(_gu,"SMT alcista","SMT alcista (divergencia en bajos entre índices) en {{ticker}} ({{interval}})")
alertcondition(_kh,"CHoCH alcista","CHoCH alcista en {{ticker}} ({{interval}})")
alertcondition(_kn,"CHoCH bajista","CHoCH bajista en {{ticker}} ({{interval}})")
alertcondition(_dn,"CHoCH alcista de riesgo (⚠)","CHoCH alcista con riesgo de fallo en {{ticker}} ({{interval}})")
alertcondition(_dm,"CHoCH bajista de riesgo (⚠)","CHoCH bajista con riesgo de fallo en {{ticker}} ({{interval}})")
alertcondition(_cv,"CHoCH alcista fallido (✗)","CHoCH alcista fallido: posible reversión bajista en {{ticker}} ({{interval}})")
alertcondition(_cy,"CHoCH bajista fallido (✗)","CHoCH bajista fallido: posible reversión alcista en {{ticker}} ({{interval}})")
alertcondition(_cp,"Tendencia alcista reactivada","Tendencia alcista reactivada tras CHoCH fallido en {{ticker}} ({{interval}})")
alertcondition(_co,"Tendencia bajista reactivada","Tendencia bajista reactivada tras CHoCH fallido en {{ticker}} ({{interval}})")
alertcondition(_hu,"Retesteo de IFVG (velas siguientes)","El precio toca un IFVG en las velas siguientes a su creación en {{ticker}} ({{interval}})")
alertcondition(_eg,"IFVG alcista","Un FVG bajista se ha invertido (IFVG alcista) en {{ticker}} ({{interval}})")
alertcondition(_ei,"IFVG bajista","Un FVG alcista se ha invertido (IFVG bajista) en {{ticker}} ({{interval}})")
alertcondition(_hx,"FVG alcista","Nuevo FVG alcista en {{ticker}} ({{interval}})")
alertcondition(_hd,"FVG bajista","Nuevo FVG bajista en {{ticker}} ({{interval}})")
alertcondition(_bv,title='Range Detected',message='Auto Range Detector: new RANGE detected on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_ce,title='Range Breakout Up',message='Auto Range Detector: range broken to the UPSIDE on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_be,title='Range Breakdown',message='Auto Range Detector: range broken to the DOWNSIDE on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_gj,title='Any Range Break',message='Auto Range Detector: range break on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_br,title='Range Deviation',message='Auto Range Detector: failed break, price returned INSIDE the range on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_hg,"Precio en el 50% de un FVG M15","Precio tocando el 50% de un FVG de M15 en {{ticker}} ({{interval}})")
alertcondition(_jk,"Precio en el 50% de un FVG H1","Precio tocando el 50% de un FVG de H1 en {{ticker}} ({{interval}})")
alertcondition(_jh,"Precio en el 50% de un FVG H4","Precio tocando el 50% de un FVG de H4 en {{ticker}} ({{interval}})")
