	_su:=lb_
_my=ta.pivothigh(high,_gn,_gn)
_ng=ta.pivotlow(low,_gn,_gn)
_qs=bar_index-_gn
var int _hm=na
var float _fk=na
var float _iz=na
var float _ib=na
var int _hk=na
var float _fn=na
var float _jg=na
var float _jr=na
var array<line> _go=array.new<line>()
var array<label> _gk=array.new<label>()
_do(float y,float _vb,float c,float _mo,bool _ob)=>
	_vd=_ob?y > _vb:y < _vb
	_um=_ob?c > _mo:c < _mo
	not na(_vb)and not na(_mo)and not na(c)and _vd !=_um
_fu(string t,float c,float _mo)=>
	t+(c > _mo?" ↑":c < _mo?" ↓":" =")
_kr(int x1,float y1,int xv,string txt,color col,bool _ob)=>
	yv=_ob?high[bar_index-xv]:low[bar_index-xv]
	if _rx
		_go.push(line.new(x1,y1,xv,yv,color=col))
	if _lp
