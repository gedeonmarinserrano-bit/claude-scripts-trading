type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gs(Zona z,float hi,float lo)=>
	_fu=z.dir==1?lo <=z._ag:hi >=z._ah
	if not _fu
		_bh=na(z._bh)?(z.dir==1?z._ah:z._ag):z._bh
		if z.dir==1?lo < _bh:hi > _bh
			z._bh:=z.dir==1?lo:hi
	_fu
_bu(array<Zona> fvg,array<Zona> _um,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xq,float _rz)=>
	_ui=false
	if ah.size()> 0
		_fe=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _um
				n=s.n-z._rr
				if not z._lx and n >=1 and n <=_gv and h1 >=z._ag and l1 <=z._ah
					if k <=_fe
						z._lx:=true
					_ui:=true
			if k <=_fe
				if _um.size()> 0
					for i=_um.size()-1 to 0
						if _gs(_um.get(i),h1,l1)
							_um.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bh)and(z.dir==1?(o1 >=z._ah and c1 < z._ag):(o1 <=z._ag and c1 > z._ah))
						if inv
							fvg.remove(i)
							_um.push(Zona.new(z.x1,z._ah,z._ag,-z.dir,na,s.n))
							if _um.size()> _xq
								_um.shift()
						else if _gs(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rz
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rz
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xq
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_ui
