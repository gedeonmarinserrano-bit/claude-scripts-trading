		_bd(f,ca,cb,_uk,"FVG "+nom,true,_wb >=15,_am,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fz.clear()
	_gm.clear()
	_ag=false
	if _d <=60
		_au()
		_ag:=true
	_de(_ct,1,_xq,_wr,_mv,_mr,84,"M1")
	if not _ag and _d <=300
		_au()
		_ag:=true
	_de(_bw,5,_vz,_tv,_mx,_nc,84,"M5")
	if not _ag and _d <=900
		_au()
		_ag:=true
	_de(_bc,15,_qy,_qj,_lb,_kr,84,"M15")
	if not _ag and _d <=3600
		_au()
		_ag:=true
	_de(_az,60,_qt,_pz,_la,_ko,82,"H1")
	if not _ag and _d <=14400
		_au()
		_ag:=true
	_de(_aq,240,_kf,_mg,_iz,_jl,80,"H4")
	if not _ag
		_au()
	if _fz.size()> 0
		_mm=array.new<Letrero>()
		for l in _fz
			x=l.x
			_rm=str.length(l.txt)+2
			for _ut=0 to 3
				_rv=false
				for c in _mm
					_rt=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _fk and x > c.x-_rt and x-_rm < c.x
						x:=c.x-_rt
						_rv:=true
				if not _rv
					break
			_mm.push(Letrero.new(x,l.y,l.txt,l.col,true,l._rq))
			_lp(x,l.y,l.txt,color.white)
	while _es.size()> uso.get(0)
		_es.pop().delete()
	while _di.size()> uso.get(1)
		_di.pop().delete()
	while _bu.size()> uso.get(2)
		_bu.pop().delete()
_po()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bj(array<Zona> arr,string nom,bool _wp)=>
	float _sz=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bi)?z._ah:z._bi
		hi=z.dir==-1 or na(z._bi)?z._ai:z._bi
		d=close >=lo and close <=hi?0.0:_wp?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sz)or d < _sz)
			_sz:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sz,txt]
_qd(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_md(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_mc(int b)=>
	b==1?_ad:b==-1?_u:#757575
_xg(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wo(string n)=>
	str.contains(n,"alcista")?_ad:str.contains(n,"bajista")?_u:#757575
_rj(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ej=na
if barstate.islast and _lq
