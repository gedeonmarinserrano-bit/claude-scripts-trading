			xv=_jh?_ra:bar_index+int(d1?_rm:_se)
			t1=_fo(_sj,_pz,_ij)
			t2=_fo(_so,_qj,_jo)
			_la(_hq,_fy,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ia,true)
		_hq:=_ra
		_fy:=_mo
		_ij:=_pz
		_jo:=_qj
	if not na(_mz)
		_sb=not na(_hn)and _ra-_hn <=_qd
		d1=_sb and _ob and _dw(_mz,_fn,_qk,_jm,false)
		d2=_sb and _on and _dw(_mz,_fn,_qm,_ig,false)
		if d1 or d2
			_hx:=true
			_cm:=bar_index
			_dv:=1
			_jh=_mz < _fn
			xv=_jh?_ra:bar_index+int(d1?_sm:_rk)
			t1=_fo(_sj,_qk,_jm)
			t2=_fo(_so,_qm,_ig)
			_la(_hn,_fn,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_it,false)
		_hn:=_ra
