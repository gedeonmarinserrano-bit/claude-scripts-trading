_ha="SMT (divergencias entre índices)"
_dx=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_ha)
_ls=input.bool(true,"Mostrar etiquetas de la SMT",group=_ha)
_so=input.bool(true,"Mostrar línea de la SMT",group=_ha)
_ts=input.bool(true,"Comparar con",inline="smt1",group=_ha)
_pz=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_ha)
_ti=input.bool(true,"Comparar con",inline="smt2",group=_ha)
_pj=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_ha)
_gj=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_ha)
_ps=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_ha)
_sd=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_ha)
_jq=input.color(#ff1100,"SMT bajista (en altos)",group=_ha)
_ik=input.color(#2157f3,"SMT alcista (en bajos)",group=_ha)
_kn(string s)=>
	_uk=str.split(s,":")
	_uk.size()> 0?_uk.last():s
_se=_kn(_pz)
_rz=_kn(_pj)
_xh=str.replace(_se,"1!","")
_xm=str.replace(_rz,"1!","")
_uf=str.replace(syminfo.ticker,"1!","")
_pd=_dx and _ts and _xh !=_uf
_oc=_dx and _ti and _xm !=_uf
_rh()=>
	w=2*_gj+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pr=na
float _qj=na
int _rf=na
int _sg=na
float _qf=na
float _qh=na
int _sf=na
int _rq=na
if _pd and _ba
