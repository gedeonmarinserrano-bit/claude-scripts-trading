if _om and _av
	[h_,l_,hb_,lb_]=request.security(_pq,timeframe.period,_sf(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_qf:=h_
	_qa:=l_
	_rf:=hb_
	_ri:=lb_
