	_pb:=l_
	_rw:=hb_
	_rj:=lb_
if _nz and _ba
	[h_,l_,hb_,lb_]=request.security(_pf,timeframe.period,_qq(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pw:=h_
	_pe:=l_
	_rh:=hb_
	_rd:=lb_
_mb=ta.pivothigh(high,_ga,_ga)
_ne=ta.pivotlow(low,_ga,_ga)
_qk=bar_index-_ga
var int _hh=na
var float _fp=na
var float _jc=na
var float _ho=na
var int _hj=na
var float _fg=na
var float _ik=na
var float _jk=na
var array<line> _gj=array.new<line>()
var array<label> _ge=array.new<label>()
_dr(float y,float _us,float c,float _mf,bool _oh)=>
	_ue=_oh?y > _us:y < _us
	_ut=_oh?c > _mf:c < _mf
	not na(_us)and not na(_mf)and not na(c)and _ue !=_ut
_ft(string t,float c,float _mf)=>
	t+(c > _mf?" ↑":c < _mf?" ↓":" =")
_kv(int x1,float y1,int xv,string txt,color col,bool _oh)=>
	yv=_oh?high[bar_index-xv]:low[bar_index-xv]
	if _qu
		_gj.push(line.new(x1,y1,xv,yv,color=col))
	if _lh
		_ge.push(label.new(xv,yv,txt,style=_oh?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_oh?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_oh?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gj.size()> _ra
		_gj.shift().delete()
	if _ge.size()> _ra
		_ge.shift().delete()
var int _cl=na
var int _dq=0
_hz=false
_ja=false
if barstate.isconfirmed
	if not na(_mb)
		_qx=not na(_hh)and _qk-_hh <=_pt
		d1=_qx and _oj and _dr(_mb,_fp,_px,_jc,true)
		d2=_qx and _nz and _dr(_mb,_fp,_pw,_ho,true)
		if d1 or d2
			_hz:=true
			_cl:=bar_index
			_dq:=-1
			_ie=_mb > _fp
			xv=_ie?_qk:bar_index+int(d1?_rw:_rh)
			t1=_ft(_rs,_px,_jc)
			t2=_ft(_rc,_pw,_ho)
			_kv(_hh,_fp,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_in,true)
		_hh:=_qk
		_fp:=_mb
		_jc:=_px
		_ho:=_pw
	if not na(_ne)
		_qx=not na(_hj)and _qk-_hj <=_pt
		d1=_qx and _oj and _dr(_ne,_fg,_pb,_ik,false)
		d2=_qx and _nz and _dr(_ne,_fg,_pe,_jk,false)
		if d1 or d2
			_ja:=true
			_cl:=bar_index
			_dq:=1
			_ie=_ne < _fg
			xv=_ie?_qk:bar_index+int(d1?_rj:_rd)
			t1=_ft(_rs,_pb,_ik)
			t2=_ft(_rc,_pe,_jk)
			_kv(_hj,_fg,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_hp,false)
		_hj:=_qk
		_fg:=_ne
		_ik:=_pb
		_jk:=_pe
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ee=array.new<box>()
var array<line> _de=array.new<line>()
var array<label> _bw=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qj(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ee.size()
		b=_ee.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ee.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_nk(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _de.size()
		l=_de.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_de.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lc(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bw.size()
		e=_bw.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bw.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xf
	bool _rr
var array<Letrero> _fv=array.new<Letrero>()
_np=nz(ta.atr(50))*0.5
_uh=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oi)
_eh=nz(ta.atr(50))*_uh/100
var array<Pieza> _gg=array.new<Pieza>()
_vi(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pq(Pieza p)=>
	res=array.from(p)
	if _kj and _gg.size()> 0
		for o in _gg
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_vr=array.new<Pieza>()
				for q in res
					for r in _vi(q,o)
						_vr.push(r)
				res:=_vr
				if res.size()==0 or res.size()> 10
					break
	res
_gl(Pieza p,color col,int dir)=>
	for q in _pq(p)
		top=q.top
		bot=q.bot
		if _eh > 0 and dir !=0
			for o in _gg
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_eh
						top:=math.min(top,o.bot-_eh)
					if math.abs(bot-o.top)<=_eh
						bot:=math.max(bot,o.top+_eh)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qj(q.x1,top,q.x2,bot,col)
_ml(int _uv,int x2,float _ag,float _ah,int dir,float _bi,color col,string txt,color _wg,color _pm,color _nu,bool _rr)=>
	x1=math.max(_uv,bar_index-1000)
	_xu=na(_bi)?_ag:(dir==1?_bi:_ag)
	_xl=na(_bi)?_ah:(dir==1?_ah:_bi)
	_gl(Pieza.new(x1,x2,_xu,_xl),col,dir)
	if not na(_bi)
		_gl(Pieza.new(x1,x2,dir==1?_ag:_bi,dir==1?_bi:_ah),_nu,dir)
	if txt !="" and _fv.size()< 60
		_fv.push(Letrero.new(x2,(_xu+_xl)/2,txt,_wg,true,_rr))
	if not na(_pm)
		m=(_ag+_ah)/2
		for q in _pq(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nk(q.x1,q.x2,m,_pm)
	_gg.push(Pieza.new(x1,x2,_ag,_ah,dir))
_be(array<Zona> arr,color _wx,color _wt,int _to,string txt,bool _xq,bool _sl,color _nu,bool _rr)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_wx:_wt
			t=txt
			_yh=z._ah > close?z._ah-close:close > z._ag?close-z._ag:0.0
			if uso.get(0)< 440 and _gg.size()< _lq and(_po==0 or _yh/close*100 <=_po)
				_ml(z.x1,bar_index+1,z._ag,z._ah,z.dir,z._bi,color.new(c,_nf),t,c,_sl?color.new(color.white,30):na,_nu,_rr)
_aw()=>
	if _pl
		_be(_jm,_hi,_hi,88,"IFVG "+_dn,true,false,_ak,false)
		_be(_gw,_se,_ta,80,"FVG "+_dn,true,false,_ak,true)
	_be(obs,_ko,_kl,90,"OB "+_dn,true,false,_ak,false)
_di(bool ver,int _vd,array<Zona> f,array<Zona> fi,color ca,color cb,int _to,string nom)=>
	if ver and not _m and _d !=_vd*60
		_be(fi,_hi,_hi,88,"IFVG "+nom,true,false,_ak,false)
		_be(f,ca,cb,_to,"FVG "+nom,true,_vd >=15,_ak,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fv.clear()
	_gg.clear()
	_ad=false
	if _d <=60
		_aw()
		_ad:=true
	_di(_cu,1,_xb,_wr,_mh,_mx,84,"M1")
	if not _ad and _d <=300
		_aw()
		_ad:=true
	_di(_bv,5,_vc,_sw,_mo,_mw,84,"M5")
	if not _ad and _d <=900
		_aw()
		_ad:=true
	_di(_bd,15,_qh,_ov,_jz,_kr,84,"M15")
	if not _ad and _d <=3600
		_aw()
		_ad:=true
	_di(_ay,60,_qf,_pd,_jy,_ks,82,"H1")
	if not _ad and _d <=14400
		_aw()
		_ad:=true
	_di(_aq,240,_kd,_lm,_ji,_ib,80,"H4")
	if not _ad
		_aw()
	if _fv.size()> 0
		_mn=array.new<Letrero>()
		for l in _fv
			x=l.x
			_ww=str.length(l.txt)+2
			for _xh=0 to 3
				_wa=false
				for c in _mn
					_rf=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _np and x > c.x-_rf and x-_ww < c.x
						x:=c.x-_rf
						_wa:=true
				if not _wa
					break
			_mn.push(Letrero.new(x,l.y,l.txt,l.col,true,l._rr))
			_lc(x,l.y,l.txt,color.white)
	while _ee.size()> uso.get(0)
		_ee.pop().delete()
	while _de.size()> uso.get(1)
		_de.pop().delete()
	while _bw.size()> uso.get(2)
		_bw.pop().delete()
_pv()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bn(array<Zona> arr,string nom,bool _vp)=>
	float _ss=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bi)?z._ah:z._bi
		hi=z.dir==-1 or na(z._bi)?z._ag:z._bi
		d=close >=lo and close <=hi?0.0:_vp?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_ss)or d < _ss)
			_ss:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_ss,txt]
_pg(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_ky(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_ls(int b)=>
	b==1?_ab:b==-1?_s:#757575
_wp(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_vq(string n)=>
	str.contains(n,"alcista")?_ab:str.contains(n,"bajista")?_s:#757575
_rz(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _eo=na
if barstate.islast and _lf
	pos=_hv=="Arriba izquierda"?position.top_left:_hv=="Abajo derecha"?position.bottom_right:_hv=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_mm=="Muy pequeño"?size.tiny:_mm=="Normal"?size.normal:size.small
	if na(_eo)
		_eo:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_eo.clear(0,0,1,13)
	int f=0
	int _wm=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_wm:=request.security(syminfo.tickerid,"240",_pv(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_pv(),lookahead=barmerge.lookahead_on)
	_pg(_eo,f,"Bias H4",_d < 14400?_ky(_wm):"(gráfico ≥ H4)",_ls(_wm),tam)
	f+=1
	_pg(_eo,f,"Bias H1",_d < 3600?_ky(b60):"(gráfico ≥ H1)",_ls(b60),tam)
	f+=1
	ev=_ev.get(0)
	_vg=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ey.get(0))+" velas"
	_pg(_eo,f,"Estructura "+_dn,_ky(_i)+_vg,_ls(_i),tam)
	f+=1
	tz="America/New_York"
	_vz=hour(timenow,tz)*60+minute(timenow,tz)
	_xj=dayofweek(timenow,tz)
	_xm=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_xz=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_vj=_xj==dayofweek.saturday or _xj==dayofweek.sunday
	_uw=570-_vz
	ses=_vj?"Cerrada (fin de semana)":_vz < 570?"Abre a las "+str.format_time(_xm,"HH:mm","Europe/Madrid")+" (en "+(_uw >=60?str.tostring(int(_uw/60))+" h ":"")+str.tostring(_uw%60)+" min)":_vz < 960?"● Abierta (cierra "+str.format_time(_xz,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_xm,"HH:mm","Europe/Madrid")+")"
	_pg(_eo,f,"Sesión NY",ses,not _vj and _vz >=570 and _vz < 960?_ab:#424242,tam)
	f+=1
	float _sc=na
	string _wf=""
	float _sd=na
	string _wc=""
	if _pl
		[d1,t1]=_bn(_gw,"FVG "+_dn,true)
		[d2,t2]=_bn(_jm,"IFVG "+_dn,true)
		[d3,t3]=_bn(_gw,"FVG "+_dn,false)
		[d4,t4]=_bn(_jm,"IFVG "+_dn,false)
		if not na(d1)and(na(_sc)or d1 < _sc)
			_sc:=d1
			_wf:=t1
		if not na(d2)and(na(_sc)or d2 < _sc)
			_sc:=d2
			_wf:=t2
		if not na(d3)and(na(_sd)or d3 < _sd)
			_sd:=d3
			_wc:=t3
		if not na(d4)and(na(_sd)or d4 < _sd)
			_sd:=d4
			_wc:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_xb:k==1?_vc:k==2?_qh:k==3?_qf:_kd
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cu:k==1?_bv:k==2?_bd:k==3?_ay:_aq
			if ver
				[da,ta_]=_bn(arr,nom,true)
				[db,tb]=_bn(arr,nom,false)
				if not na(da)and(na(_sc)or da < _sc)
					_sc:=da
					_wf:=ta_
				if not na(db)and(na(_sd)or db < _sd)
					_sd:=db
					_wc:=tb
	_pg(_eo,f,"FVG por arriba",_wp(_sc,_wf),_vq(_wf),tam)
	f+=1
	_pg(_eo,f,"FVG por abajo",_wp(_sd,_wc),_vq(_wc),tam)
	f+=1
	_tw=not _dt?"(apagada)":na(_cl)?"Ninguna reciente":(_dq==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cl)+" velas"
	_pg(_eo,f,"SMT",_tw,not _dt or na(_cl)?#757575:_dq==1?_hp:_in,tam)
	f+=1
	if _ng
		_oo=request.security(_uc,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mf,_vh,_wi]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_oo/16
		pts=_mf*pct/100
		_st=pts > 0?(_vh-_wi)/pts*100:na
		_tu=na(_oo)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_oo,"#.#")+") · hoy "+str.tostring(_vh-_wi,"#")+" pts = "+str.tostring(_st,"#")+" %"
		_pg(_eo,f,"Mov. esperado",_tu,na(_st)?#757575:_st >=100?_s:_st >=75?#EF6C00:#424242,tam)
		f+=1
	if _ly and _jl
		_pg(_eo,f,"Asia",_rz(_fq,_gn,_as,_jf,_ht),#5E35B1,tam)
		f+=1
		_pg(_eo,f,"Londres",_rz(_lk,_ms,_cn,_me,_md),#1E88E5,tam)
		f+=1
	if _pi or _fi
		[_wl,_tz,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _pi
			rng=d_h-d_l
			_kw=_tz > 0?rng/_tz*100:na
			_pg(_eo,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_tz,"#")+" pts ("+str.tostring(_kw,"#")+" %)",na(_kw)?#757575:_kw >=100?_s:_kw >=75?#EF6C00:#424242,tam)
			f+=1
		if _fi
			dif=close-_wl
			_pg(_eo,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_s:_ab,tam)
			f+=1
	if _kz
		float _vf=na
		string _vk=""
		float _vb=na
		string _vn=""
		_ox=array.from(pdh,pdl,_jf?na:_fq,_ht?na:_gn,_me?na:_lk,_md?na:_ms)
		_ph=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _au
			_ox.push(nv._ar)
			_ph.push(nv.dir==1?"Alto H4":"Bajo H4")
		for q in _dm
			_ox.push(q._ar)
			_ph.push(q.dir==1?"EQH":"EQL")
		for i=0 to _ox.size()-1
			pv=_ox.get(i)
			if not na(pv)
				if pv > close and(na(_vf)or pv < _vf)
					_vf:=pv
					_vk:=_ph.get(i)
				if pv < close and(na(_vb)or pv > _vb)
					_vb:=pv
					_vn:=_ph.get(i)
		_uq=(na(_vf)?"↑ —":"↑ "+_vk+" "+str.tostring(_vf,format.mintick)+" (+"+str.tostring(_vf-close,format.mintick)+")")+"  ·  "+(na(_vb)?"↓ —":"↓ "+_vn+" "+str.tostring(_vb,format.mintick)+" (−"+str.tostring(close-_vb,format.mintick)+")")
		_pg(_eo,f,"Liquidez",_uq,#424242,tam)
		f+=1
	if _oy !=""
		_pg(_eo,f,"Noticias hoy",_oy,#EF6C00,tam)
		f+=1
alertcondition(_hz,"SMT bajista","SMT bajista (divergencia en altos entre índices) en {{ticker}} ({{interval}})")
alertcondition(_ja,"SMT alcista","SMT alcista (divergencia en bajos entre índices) en {{ticker}} ({{interval}})")
