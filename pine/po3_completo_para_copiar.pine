type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gv(Zona z,float hi,float lo)=>
	_fv=z.dir==1?lo <=z._ag:hi >=z._ah
	if not _fv
		_bh=na(z._bh)?(z.dir==1?z._ah:z._ag):z._bh
		if z.dir==1?lo < _bh:hi > _bh
			z._bh:=z.dir==1?lo:hi
	_fv
_bx(array<Zona> fvg,array<Zona> _uc,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xn,float _sq)=>
	_tz=false
	if ah.size()> 0
		_fc=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _uc
				n=s.n-z._sb
				if not z._lh and n >=1 and n <=_gw and h1 >=z._ag and l1 <=z._ah
					if k <=_fc
						z._lh:=true
					_tz:=true
			if k <=_fc
				if _uc.size()> 0
					for i=_uc.size()-1 to 0
						if _gv(_uc.get(i),h1,l1)
							_uc.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bh)and(z.dir==1?(o1 >=z._ah and c1 < z._ag):(o1 <=z._ag and c1 > z._ah))
						if inv
							fvg.remove(i)
							_uc.push(Zona.new(z.x1,z._ah,z._ag,-z.dir,na,s.n))
							if _uc.size()> _xn
								_uc.shift()
						else if _gv(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_sq
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_sq
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xn
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_tz
