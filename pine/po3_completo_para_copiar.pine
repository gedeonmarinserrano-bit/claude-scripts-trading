_si=input.bool(true,"Altos y bajos iguales sin barrer (EQH / EQL)",group=_er)
_mj=input.bool(false,"Marcar barridos de niveles (pasa el nivel y cierra de vuelta)",group=_er)
_rc=input.session("1800-0200","Sesión de Asia (hora de Nueva York)",group=_er)
_sk=input.session("0200-0930","Sesión de Londres (hora de Nueva York)",group=_er)
_tv=input.session("0930-1600","Sesión de Nueva York (hora de Nueva York)",group=_er)
_nb=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_er)
_dc="FVG por temporalidad (solo se ven los activados)"
_aq=input.bool(true,"FVG H4",inline="fvgtf1",group=_dc)
_av=input.bool(true,"FVG H1",inline="fvgtf1",group=_dc)
_be=input.bool(true,"FVG M15",inline="fvgtf1",group=_dc)
_bw=input.bool(true,"FVG M5",inline="fvgtf2",group=_dc)
_cp=input.bool(true,"FVG M1",inline="fvgtf2",group=_dc)
_ol=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_dc)
_l=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_dc)
_gm=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_dc)
_lg=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_dc)
_qo=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_dc)
_oo="Estructura (CHoCH / BOS)"
_cd=input.int(1,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_oo)
_tq=1.1
_ut=2.0
_uz=20
_tt=2
_mw=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oo)
_hy=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oo)
_jn=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oo)
_iv=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oo)
_el=input.bool(false,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oo)
_qv=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oo)
_bf=bar_index >=last_bar_index-_qv
_cj=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_nn=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_am=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_us="Order Blocks"
