type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_go(Zona z,float hi,float lo)=>
	_fx=z.dir==1?lo <=z._ag:hi >=z._ah
	if not _fx
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ag):z._bi
		if z.dir==1?lo < _bi:hi > _bi
			z._bi:=z.dir==1?lo:hi
	_fx
_bw(array<Zona> fvg,array<Zona> _tv,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _wz,float _rp)=>
	_tw=false
	if ah.size()> 0
		_fd=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tv
				n=s.n-z._re
				if not z._lg and n >=1 and n <=_gu and h1 >=z._ag and l1 <=z._ah
					if k <=_fd
						z._lg:=true
					_tw:=true
			if k <=_fd
				if _tv.size()> 0
					for i=_tv.size()-1 to 0
						if _go(_tv.get(i),h1,l1)
							_tv.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ah and c1 < z._ag):(o1 <=z._ag and c1 > z._ah))
						if inv
							fvg.remove(i)
							_tv.push(Zona.new(z.x1,z._ah,z._ag,-z.dir,na,s.n))
							if _tv.size()> _wz
								_tv.shift()
						else if _go(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rp
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rp
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _wz
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_tw
