_sr=_ld(_qk)
_ry=_ld(_pj)
_wz=str.replace(_sr,"1!","")
_wp=str.replace(_ry,"1!","")
_ui=str.replace(syminfo.ticker,"1!","")
_pg=_dt and _tr and _wz !=_ui
_nz=_dt and _tq and _wp !=_ui
_st()=>
	w=2*_gk+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _px=na
float _pl=na
