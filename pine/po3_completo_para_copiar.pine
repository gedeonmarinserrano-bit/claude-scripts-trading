_po=input.string("","Noticias de hoy (texto libre, p. ej. «CPI 14:30»; vacío = no se muestra)",group=_cx)
_ii="Información en el gráfico"
_lx=input.bool(true,"Fondo suave en las sesiones de Asia, Londres y apertura de Nueva York",group=_ii)
_vf=input.bool(true,"Línea del 50 % del día anterior (por encima premium, por debajo descuento)",group=_ii)
_rc=input.bool(true,"Altos y bajos iguales sin barrer (EQH / EQL)",group=_ii)
