indicator("Po3 + CHoCH PRO - High Contrast + FVG + Rangos + OB",overlay=true,max_labels_count=500,max_lines_count=500,max_boxes_count=500,max_bars_back=2000,behind_chart=true)
_nr="Panel de información"
_kj=input.bool(true,"Mostrar panel",group=_nr)
_is=input.string("Arriba derecha","Posición",options=["Arriba derecha","Arriba izquierda","Abajo derecha","Abajo izquierda"],group=_nr)
_ly=input.string("Pequeño","Tamaño del texto",options=["Muy pequeño","Pequeño","Normal"],group=_nr)
_cs="FVG por temporalidad (solo se ven los activados)"
_an=input.bool(true,"FVG H4",inline="fvgtf1",group=_cs)
_ba=input.bool(true,"FVG H1",inline="fvgtf1",group=_cs)
_av=input.bool(true,"FVG M15",inline="fvgtf1",group=_cs)
_br=input.bool(true,"FVG M5",inline="fvgtf2",group=_cs)
_ck=input.bool(false,"FVG M1",inline="fvgtf2",group=_cs)
_mq=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_cs)
_m=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_cs)
_fs=input.int(10,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=50,group=_cs)
_kt=input.int(35,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=120,group=_cs)
_ob=input.float(1.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cs)
_na="Estructura (CHoCH / BOS)"
_fr=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_na)
_rd=1.1
_sm=2.0
_sw=20
_qs=2
_ll=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_na)
_ic=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_na)
_ie=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_na)
_iu=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_na)
_dz=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_na)
_ox=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_na)
_cd=bar_index >=last_bar_index-_ox
_er=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_lj=input.int(20,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_ah=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_sp="Order Blocks"
_jo=input.bool(true,"Mostrar Order Blocks",group=_sp)
_fk=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_sp)
_lh=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_sp)
_tv=input.int(10,"Máx. Order Blocks vigentes",minval=1,maxval=50,group=_sp)
_ma=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_sp)
_jr=input.color(#1565C0,"OB alcista (demanda)",group=_sp)
_jz=input.color(#EF6C00,"OB bajista (oferta)",group=_sp)
_qq="Estrategia NY (Bias + PO3)"
_km=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_qq)
_jx=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_qq)
_rz="Colores FVG"
_ak=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_rz)
_al=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_rz)
_pt=_ak
_lk=_ak
_lm=_ak
_jp=_ak
_ju=_ak
_ik=_ak
_qg=_al
_lv=_al
_lt=_al
_jj=_al
_jn=_al
_hx=_al
_jd=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qq)
_cy=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qq)
_pb=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qq)
_ou=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qq)
_dj=input.color(#424242,"Color niveles clave",group=_qq)
_lx=input.color(#757575,"Color horas",group=_qq)
_dr=input.bool(true,"Mostrar EMAs",group="EMAs")
_nf=input.int(9,"EMA rápida",minval=1,group="EMAs")
_mn=input.int(20,"EMA media",minval=1,group="EMAs")
_mm=input.int(200,"EMA lenta",minval=1,group="EMAs")
_mi=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_ms=input.color(#9E9D24,"Color EMA media",group="EMAs")
_mp=input.color(color.black,"Color EMA lenta",group="EMAs")
_hn=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hd=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fj=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_jw=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ta=14
_pn=50
_qw=0.15
_pf=2.5
_pe=30
_oi=1.0
_kl=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_nq="Colores"
_aj=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_nq)
_az=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_nq)
_md=input.bool(true,"Marcar la vela del OB",group=_nq)
_gs=input.color(#FF00C8,"IFVG (magenta)",group=_nq)
_mb=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_nq)
_kf=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_nq)
type Zona
	int x1
	float _ad
	float _ac
	int dir
	float _bc=na
	int _po=na
	bool _lb=false
var _gm=array.new<Zona>()
var _ih=array.new<Zona>()
var obs=array.new<Zona>()
var _uy=array.new<Zona>()
var _tf=array.new<Zona>()
var _oz=array.new<Zona>()
var _os=array.new<Zona>()
var _jk=array.new<Zona>()
var _uc=array.new<Zona>()
var _re=array.new<Zona>()
var _og=array.new<Zona>()
var _of=array.new<Zona>()
var _ku=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ad
	float _ac
	color col
var _be=array.new<Rango>()
_ef(Zona z)=>
	_fg=z.dir==1?low <=z._ac:high >=z._ad
	if not _fg
		_bc=na(z._bc)?(z.dir==1?z._ad:z._ac):z._bc
		if z.dir==1?low < _bc:high > _bc
			z._bc:=z.dir==1?low:high
	_fg
type Marca
	label lb
	line ln
	int bar
var _ia=array.new<Marca>()
var array<string> _ej=array.from("")
var array<int> _ek=array.from(0)
_af(label lb,line ln,int bar)=>
	_ia.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ej.set(0,lb.get_text())
		_ek.set(0,bar)
	if _ia.size()> 500
		_ia.shift()
_pg=ta.ema(close,_nf)
_qk=ta.ema(close,_mn)
_hg=ta.ema(close,_mm)
_es=ta.atr(_ta)
var string _rt='════════ Detection ════════'
var string _qm='════════ Structure Filters ════════'
var string _ss='════════ Range Behavior ════════'
var string _rp='════════ Visual Settings ════════'
_cl='Base + 2x + 3x'
_mx='Rangos'
_bg=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_mx)
_bn='Percentile band'
_dv=90.0
_ky='Bar close'
_jq=200
_hb=40.0
_du=500
_lg=0.18
_nj='Wick reaches'
_hf=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_mx)
_ds=0.10
_qn=0.45
_ea=0.70
_hj='Extend to containment'
_hc=300
_jf=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_mx)
_gi=true
_lc=0.25
_kn='Close beyond'
_gx=0.15
_gk=true
_gl=10
_kx=3
_ev=0
_li='Custom'
_ks=#00A651
_kz=#E4002B
_eq=input.color(#F9A825,'Color del rango (neutral)',group=_mx)
_ja=4
_fx=93
_gq=true
_je=true
_gj=input.bool(true,'Mostrar etiqueta del rango',group=_mx)
_jb=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_mx)
_if=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_mx)
_it='Small'
_em=true
_iw='Small'
[_cb,_cc]=switch _li
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_ks,_kz]
var color _bv=color.new(color.black,100)
var float _ca=3.0
var float _dg=1.6
_hz(string _ud)=>
	switch _ud
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ep(color _cx)=>
	_ha=color.r(_cx)/255.0
	_im=color.g(_cx)/255.0
	_hy=color.b(_cx)/255.0
	_rh=_ha <=0.03928?_ha/12.92:math.pow((_ha+0.055)/1.055,2.4)
	_ri=_im <=0.03928?_im/12.92:math.pow((_im+0.055)/1.055,2.4)
	_rk=_hy <=0.03928?_hy/12.92:math.pow((_hy+0.055)/1.055,2.4)
	0.2126*_rh+0.7152*_ri+0.0722*_rk
_kw(color _mo,color _lf)=>
	_lp=_ep(_mo)
	_jl=_ep(_lf)
	(math.max(_lp,_jl)+0.05)/(math.min(_lp,_jl)+0.05)
_dw(color _gr)=>
	_ep(_gr)> 0.179?#000000:#ffffff
_mu(color _cx,color _ls,float _pz)=>
	color.rgb(color.r(_cx)+(color.r(_ls)-color.r(_cx))*_pz,color.g(_cx)+(color.g(_ls)-color.g(_cx))*_pz,color.b(_cx)+(color.b(_ls)-color.b(_cx))*_pz)
_bd(color _cx,color _gr,float _nc)=>
	_ls=_dw(_gr)
	_kh=_cx
	for step=1 to 10
		if _kw(_kh,_gr)>=_nc
			break
		_kh:=_mu(_cx,_ls,step/10.0)
	_kh
_hl(float _uu)=>
	str.tostring(_uu,'#.##')+'%'
_pc(array<box> _iz,int _kq,float _ar,float _ae)=>
	array.clear(_iz)
	if not _kf
		for i=0 to _ja-1
			array.push(_iz,box.new(_kq,_ar,bar_index,_ae,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_fp(array<box> _iz,float _ar,float _ae,int _kq,int _qd,color _ni)=>
	_nw=array.size(_iz)
	if _nw > 0 and _ar > _ae
		_fy=(_ar-_ae)/_nw
		for i=0 to _nw-1
			_ht=array.get(_iz,i)
			_nd=math.abs((i+0.5)/_nw-0.5)*2.0
			_mh=int(math.min(99,math.max(0,_fx+(1.0-_nd)*10)))
			box.set_lefttop(_ht,_kq,_ar-_fy*i)
			box.set_rightbottom(_ht,_qd,_ar-_fy*(i+1))
			box.set_bgcolor(_ht,color.new(_ni,_mh))
_nk(array<box> _iz)=>
	if array.size(_iz)> 0
		for i=0 to array.size(_iz)-1
			box.delete(array.get(_iz,i))
	array.clear(_iz)
_ot(int _pu,float _ar,float _ae,float _cg)=>
	_vj=_pu
	if _hj=='Extend to containment'
		_uv=math.min(_hc,bar_index)
		_te=math.max(2,math.round((1.0-_ea)*_pu))
		_ld=0
		_fz=0
		while _fz < _uv and _ld <=_te
			_lz=close[_fz]<=_ar and close[_fz]>=_ae
			_rj=_lz and high[_fz]<=_ar+_cg and low[_fz]>=_ae-_cg
			if _lz
				_ld:=math.max(0,_ld-1)
				if _rj and _fz+1 >=_pu
					_vj:=_fz+1
			else
				_ld+=1
			_fz+=1
	_vj
_ce=ta.atr(_jq)
_jm=not na(_ce)and _ce > 0
_fn=_kn=='Wick beyond'
_jy=_nj=='Wick reaches'
_mg=_ky=='Live bar'
_ey=_mg or barstate.isconfirmed
_fv=_hz(_it)
_js=_hz(_iw)
_u=chart.bg_color
_q=_bd(_eq,_u,_ca)
_ez=_bd(_cb,_u,_ca)
_ff=_bd(_cc,_u,_ca)
_gn=_bd(_eq,_u,_dg)
_fd=_bd(_cb,_u,_dg)
_ew=_bd(_cc,_u,_dg)
_fu(simple int len)=>
	_si=ta.percentile_linear_interpolation(high,len,_dv)
	_or=ta.percentile_linear_interpolation(low,len,100.0-_dv)
	_tc=ta.highest(high,len)
	_pd=ta.lowest(low,len)
	_rl=ta.highest(math.max(open,close),len)
	_nm=ta.lowest(math.min(open,close),len)
	top=_bn=='Absolute extremes'?_tc:_bn=='Body extremes'?_rl:_si
	_kc=_bn=='Absolute extremes'?_pd:_bn=='Body extremes'?_nm:_or
	_db=top-_kc
	_np=_jm and _db > 0?_db/(_ce*math.sqrt(len)):99.0
	_rb=bar_index < 1?_du:int(math.max(1,math.min(_du,bar_index-_jq)))
	_vl=ta.percentrank(_np,_rb)
	_uz=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_va=_db > 0?math.abs(_uz)*len/_db:99.0
	_cm=math.avg(top,_kc)
	_cg=_ds*nz(_ce)
	_lq=0
	_od=0
	_hq=0
	_me=0
	for i=0 to len-1
		if(close[i]> _cm)!=(close[i+1]> _cm)
			_lq+=1
		_mt=_jy?high[i]>=top-_cg:close[i]>=top-_cg
		_iy=_jy?low[i]<=_kc+_cg:close[i]<=_kc+_cg
		if _mt
			_od+=1
		if _iy
			_hq+=1
		if close[i]<=top and close[i]>=_kc
			_me+=1
	_mv=_me/float(len)
	_hk=_jm and not na(_vl)and bar_index > len+5 and _vl <=_hb and _lq >=math.max(3,math.round(_lg*len))and _od >=_hf and _hq >=_hf and _va <=_qn and _mv >=_ea
	[_hk,top,_kc]
bool _id=false
bool _hv=false
bool _ib=false
float _tp=na
float _tk=na
float _tt=na
float _ok=na
float _oo=na
float _oh=na
if _cd
	[qa,ta_,ba]=_fu(_bg)
	_id:=qa
	_tp:=ta_
	_ok:=ba
	if _cl !='Base only'
		[qb,tb,bb]=_fu(_bg*2)
		_hv:=qb
		_tk:=tb
		_oo:=bb
	if _cl=='Base + 2x + 3x'
		[qc,tc,bc]=_fu(_bg*3)
		_ib:=qc
		_tt:=tc
		_oh:=bc
_eb=_cl !='Base only' and _hv
_ec=_cl=='Base + 2x + 3x' and _ib
_hk=_id or _eb or _ec
_nb=_ec?_bg*3:_eb?_bg*2:_bg
_ns=_ec?_tt:_eb?_tk:_tp
_ii=_ec?_oh:_eb?_oo:_ok
var array<box> _ao=array.new<box>()
var box _s=na
var line _g=na
var line _k=na
var line _w=na
var label _x=na
var label _aq=na
var float _f=na
var float _a=na
var int _c=na
var int _gb=na
var bool _t=false
var bool _l=false
var bool _ax=false
var int _dl=na
var int _o=0
var float _p=na
var int _at=na
var int _aw=0
_bx=false
_cf=false
_bi=false
_bw=false
if _ey and _aw > 0
	_aw-=1
if _ey and not _t and not _ax and _aw <=0 and _hk
	_mf=_ot(_nb,_ns,_ii,_ds*_ce)
	_c:=bar_index-_mf+1
	_gb:=bar_index
	_f:=_ns
	_a:=_ii
	_t:=true
	_l:=false
	_cm=math.avg(_f,_a)
	_bt=_a+(_f-_a)*0.25
	_ay=_a+(_f-_a)*0.75
	_s:=box.new(_c,_f,bar_index,_a,border_color=color.new(_q,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_pc(_ao,_c,_f,_a)
	if _gq
		_g:=line.new(_c,_cm,bar_index,_cm,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _je
		_k:=line.new(_c,_bt,bar_index,_bt,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_ay,bar_index,_ay,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gj
		_x:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bv,style=label.style_label_down,textcolor=color.new(_q,10),size=_fv)
	_bx:=true
if _t and _ey
	_cn=_gx*_ce
	_eu=_lc*_ce
	if _gi and not _fn and close <=_f and close >=_a
		if high > _f and high <=_f+_eu
			_f:=high
		if low < _a and low >=_a-_eu
			_a:=low
	_oa=_fn?high > _f+_cn:close > _f+_cn
	_kb=_fn?low < _a-_cn:close < _a-_cn
	_pa=_ev > 0 and bar_index-_gb+1 >=_ev
	if _oa or _kb or _pa
		_b=_oa?1:_kb?-1:0
		_ql=_b !=0?bar_index-_c:bar_index-_c+1
		_lr=_a !=0?(_f-_a)/_a*100.0:0.0
		_jc=_gk and _b !=0 and _l
		if _l
			_eo=_b==1?_ez:_b==-1?_ff:_q
			_my=_b==1?_fd:_b==-1?_ew:_gn
			_hu=_b==1?_cb:_b==-1?_cc:_eq
			box.set_lefttop(_s,_c,_f)
			box.set_rightbottom(_s,bar_index,_a)
			box.set_border_color(_s,color.new(_eo,30))
			box.set_border_style(_s,line.style_dotted)
			_fp(_ao,_f,_a,_c,bar_index,na)
			_be.push(Rango.new(_c,bar_index,_f,_a,_my))
			if _be.size()> 8
				_be.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_x)
				label.set_xy(_x,int(math.avg(_c,bar_index)),_f)
				label.set_text(_x,'RANGE   '+str.tostring(_ql)+' BARS   '+_hl(_lr))
				label.set_textcolor(_x,color.new(_eo,10))
			if _jb and _b !=0
				_nh=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _em
					_aq:=label.new(bar_index,_b==1?low:high,_b==1?'▲':'▼',xloc=xloc.bar_index,yloc=yloc.price,color=_bv,style=_b==1?label.style_label_up:label.style_label_down,textcolor=color.new(_eo,20),size=_js,tooltip='Breakout del rango')
				else
					_aq:=label.new(bar_index,_b==1?low:high,_nh,xloc=xloc.bar_index,yloc=yloc.price,color=color.new(_hu,10),style=_b==1?label.style_label_up:label.style_label_down,textcolor=_dw(_hu),size=_fv)
			if _b==1
				_cf:=true
			else if _b==-1
				_bi:=true
		else
			box.delete(_s)
			_nk(_ao)
			line.delete(_g)
			line.delete(_k)
			line.delete(_w)
			label.delete(_x)
		if _jc
			_ax:=true
			_dl:=bar_index
			_o:=_b
			_p:=_b==1?high:low
			_at:=bar_index
		else
			array.clear(_ao)
			_s:=na
			_g:=na
			_k:=na
			_w:=na
			_x:=na
			_aq:=na
		_t:=false
		_l:=false
		_aw:=_kx
	else
		_l:=bar_index-_c+1 >=_jf
if _ax and _ey
	if _o==1 and high > _p
		_p:=high
		_at:=bar_index
	if _o==-1 and low < _p
		_p:=low
		_at:=bar_index
	_ps=_o==1?close <=_f:close >=_a
	_sd=bar_index-_dl >=_gl
	if _ps and bar_index > _dl
		_cp=_o==1?_cc:_cb
		_ix=(_o==1?'⤵  ':'⤴  ')+'Deviation'
		if _if
			if _em
