		_ro.set(k,o)
	else if not na(o)and not na(o.ln)
		if en
			o._bt:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
		else if na(o._lo)and(dir==1?high > o._bt:low < o._bt)
			o._lo:=bar_index
		if not en and not na(o._lo)and bar_index-o._lo >=5
			o.ln.delete()
			o.lb.delete()
			o.ln:=na
			o.lb:=na
