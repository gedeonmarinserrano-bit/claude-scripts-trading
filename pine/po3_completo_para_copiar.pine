type NivelSes
	line ln
	label lb
	float _bd
	int _uv=na
	int k=0
	int _zb=na
var array<NivelSes> _gh=array.new<NivelSes>(6)
var array<NivelSes> _n=array.new<NivelSes>()
_ir(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_dh(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_vg=(dir==1?"Máx. ":"Mín. ")+ses
	o=_gh.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _n.size()> 0
			for i=_n.size()-1 to 0
				q=_n.get(i)
				if q.k==k
					_n.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_ir(bar_index,v,_vg,col)
		_gh.set(k,NivelSes.new(ln,lb,v,na,k,bar_index))
	else if not na(o)
		if en and not na(o.ln)
			o._bd:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if dir==1?high > o._bd:low < o._bd
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._bd)
			o.lb.set_text((dir==1?"Máx. manip. ":"Mín. manip. ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			if _n.size()> 0
				for i=_n.size()-1 to 0
					q=_n.get(i)
					if q.k==k
						_n.remove(i)
						q.ln.delete()
						q.lb.delete()
			_n.push(o)
			if _n.size()> 24
				q=_n.shift()
				q.ln.delete()
				q.lb.delete()
			_gh.set(k,na)
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._bd)
_mf=timeframe.change("D")
if _mq and _fs and _bg
	if _mf
		for k=0 to 5
			o=_gh.get(k)
			if not na(o)and not na(o.ln)
				o.ln.delete()
				o.lb.delete()
			_gh.set(k,na)
		for q in _n
			q.ln.delete()
			q.lb.delete()
		_n.clear()
	_dh(0,_bz,_bz and not _bz[1],_fo,1,"Asia",#5E35B1)
	_dh(1,_bz,_bz and not _bz[1],_gu,-1,"Asia",#5E35B1)
	_dh(2,_dz,_dz and not _dz[1],_lr,1,"Londres",#1E88E5)
	_dh(3,_dz,_dz and not _dz[1],_mu,-1,"Londres",#1E88E5)
	_dh(4,_fv,_fv and not _fv[1],_yh,1,"NY",#EF6C00)
	_dh(5,_fv,_fv and not _fv[1],_xw,-1,"NY",#EF6C00)
var array<bool> _aa=array.new<bool>(6,false)
var array<label> _eg=array.new<label>()
if timeframe.change("D")
	_aa.fill(false)
if _bz and not _bz[1]
	_aa.set(2,false)
	_aa.set(3,false)
if _dz and not _dz[1]
	_aa.set(4,false)
	_aa.set(5,false)
if _ls and _ba and _fs and _bg
	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_fo:k==3?_gu:k==4?_lr:_mu
		_yz=k < 2 or(k < 4?not _bz:not _dz)
		_wh=k%2==0
		if _yz and not na(nv)and not _aa.get(k)and(_wh?high > nv and close < nv:low < nv and close > nv)
			_aa.set(k,true)
			nom=(k < 2?(_wh?"PDH":"PDL"):k < 4?(_wh?"Alto Asia":"Bajo Asia"):(_wh?"Alto Londres":"Bajo Londres"))
			_eg.push(label.new(bar_index,_wh?high:low,"Barrido "+nom,style=_wh?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _eg.size()> 20
				_eg.shift().delete()
type Igual
	line ln
	label lb
	float _bd
	int dir
var array<Igual> _dl=array.new<Igual>()
var float _td=na
var int _py=na
var float _th=na
var int _qn=na
_um=nz(_db)*0.1
_tt=ta.pivothigh(high,_ca,_ca)
_tl=ta.pivotlow(low,_ca,_ca)
if _rj and _bg and timeframe.isintraday
	if not na(_tt)
		x=bar_index-_ca
		if not na(_td)and math.abs(_tt-_td)<=_um and x-_py <=150
			nv=math.max(_tt,_td)
			_dl.push(Igual.new(line.new(_py,nv,bar_index,nv,color=color.new(#6A1B9A,20),style=line.style_dotted,width=1),label.new(_py,nv,"EQH",style=label.style_label_down,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny),nv,1))
		_td:=_tt
		_py:=x
	if not na(_tl)
		x=bar_index-_ca
		if not na(_th)and math.abs(_tl-_th)<=_um and x-_qn <=150
			nv=math.min(_tl,_th)
			_dl.push(Igual.new(line.new(_qn,nv,bar_index,nv,color=color.new(#6A1B9A,20),style=line.style_dotted,width=1),label.new(_qn,nv,"EQL",style=label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny),nv,-1))
		_th:=_tl
		_qn:=x
	if _dl.size()> 8
		q=_dl.shift()
		q.ln.delete()
		q.lb.delete()
	if _dl.size()> 0
		for i=_dl.size()-1 to 0
			q=_dl.get(i)
			if q.dir==1?high > q._bd:low < q._bd
				_dl.remove(i)
				q.ln.delete()
				q.lb.delete()
			else
				q.ln.set_x2(bar_index)
_hf="SMT (divergencias entre índices)"
_dy=input.bool(true,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hf)
_mb=input.bool(true,"Mostrar etiquetas de la SMT",group=_hf)
_st=input.bool(true,"Mostrar línea de la SMT",group=_hf)
_ua=input.bool(true,"Comparar con",inline="smt1",group=_hf)
_qj=input.symbol("CME_MINI:MES1!","",inline="smt1",group=_hf)
_te=input.bool(true,"Comparar con",inline="smt2",group=_hf)
_pz=input.symbol("CME_MINI:MNQ1!","",inline="smt2",group=_hf)
_go=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hf)
_qm=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hf)
_si=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hf)
_jb=input.color(#ff1100,"SMT bajista (en altos)",group=_hf)
_ix=input.color(#2157f3,"SMT alcista (en bajos)",group=_hf)
_lb(string s)=>
	_ug=str.split(s,":")
	_ug.size()> 0?_ug.last():s
_sr=_lb(_qj)
_sx=_lb(_pz)
_wy=str.replace(_sr,"1!","")
_xj=str.replace(_sx,"1!","")
_ud=str.replace(syminfo.ticker,"1!","")
_nw=_dy and _ua and _wy !=_ud
_os=_dy and _te and _xj !=_ud
_sd()=>
	w=2*_go+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pw=na
float _pq=na
int _ri=na
int _sj=na
float _ps=na
float _qb=na
int _sq=na
int _sf=na
if _nw and _bg
	[h_,l_,hb_,lb_]=request.security(_qj,timeframe.period,_sd(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pw:=h_
	_pq:=l_
	_ri:=hb_
	_sj:=lb_
if _os and _bg
	[h_,l_,hb_,lb_]=request.security(_pz,timeframe.period,_sd(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_ps:=h_
	_qb:=l_
	_sq:=hb_
	_sf:=lb_
_nj=ta.pivothigh(high,_go,_go)
_mz=ta.pivotlow(low,_go,_go)
_qv=bar_index-_go
var int _hm=na
var float _gb=na
var float _ia=na
var float _ib=na
var int _hn=na
var float _fj=na
var float _im=na
var float _jf=na
var array<line> _gg=array.new<line>()
var array<label> _gp=array.new<label>()
_du(float y,float _vu,float c,float _mp,bool _pf)=>
	_vr=_pf?y > _vu:y < _vu
	_ut=_pf?c > _mp:c < _mp
	not na(_vu)and not na(_mp)and not na(c)and _vr !=_ut
_gf(string t,float c,float _mp)=>
	t+(c > _mp?" ↑":c < _mp?" ↓":" =")
_ks(int x1,float y1,int xv,string txt,color col,bool _pf)=>
	yv=_pf?high[bar_index-xv]:low[bar_index-xv]
	if _st
		_gg.push(line.new(x1,y1,xv,yv,color=col))
	if _mb
		_gp.push(label.new(xv,yv,txt,style=_pf?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_pf?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_pf?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gg.size()> _si
		_gg.shift().delete()
	if _gp.size()> _si
		_gp.shift().delete()
var int _ck=na
var int _dr=0
_hy=false
_ji=false
if barstate.isconfirmed
	if not na(_nj)
		_sy=not na(_hm)and _qv-_hm <=_qm
		d1=_sy and _nw and _du(_nj,_gb,_pw,_ia,true)
		d2=_sy and _os and _du(_nj,_gb,_ps,_ib,true)
		if d1 or d2
			_hy:=true
			_ck:=bar_index
			_dr:=-1
			_iz=_nj > _gb
			xv=_iz?_qv:bar_index+int(d1?_ri:_sq)
			t1=_gf(_sr,_pw,_ia)
			t2=_gf(_sx,_ps,_ib)
			_ks(_hm,_gb,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jb,true)
		_hm:=_qv
		_gb:=_nj
		_ia:=_pw
		_ib:=_ps
	if not na(_mz)
		_sy=not na(_hn)and _qv-_hn <=_qm
		d1=_sy and _nw and _du(_mz,_fj,_pq,_im,false)
		d2=_sy and _os and _du(_mz,_fj,_qb,_jf,false)
		if d1 or d2
			_ji:=true
			_ck:=bar_index
			_dr:=1
			_iz=_mz < _fj
			xv=_iz?_qv:bar_index+int(d1?_sj:_sf)
			t1=_gf(_sr,_pq,_im)
			t2=_gf(_sx,_qb,_jf)
			_ks(_hn,_fj,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ix,false)
		_hn:=_qv
		_fj:=_mz
		_im:=_pq
		_jf:=_qb
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _eq=array.new<box>()
var array<line> _dg=array.new<line>()
var array<label> _bt=array.new<label>()
var array<int> uso=array.from(0,0,0)
_ra(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eq.size()
		b=_eq.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eq.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_nt(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dg.size()
		l=_dg.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dg.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_ma(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bt.size()
		e=_bt.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bt.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _yc
	bool _sm
var array<Letrero> _fk=array.new<Letrero>()
_ff=nz(ta.atr(50))*0.5
_uz=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oo)
_ef=nz(ta.atr(50))*_uz/100
var array<Pieza> _gn=array.new<Pieza>()
_wn(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pt(Pieza p)=>
	res=array.from(p)
	if _ld and _gn.size()> 0
		for o in _gn
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xm=array.new<Pieza>()
				for q in res
					for r in _wn(q,o)
						_xm.push(r)
				res:=_xm
				if res.size()==0 or res.size()> 10
					break
	res
_gw(Pieza p,color col,int dir)=>
	for q in _pt(p)
		top=q.top
		bot=q.bot
		if _ef > 0 and dir !=0
			for o in _gn
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ef
						top:=math.min(top,o.bot-_ef)
					if math.abs(bot-o.top)<=_ef
						bot:=math.max(bot,o.top+_ef)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_ra(q.x1,top,q.x2,bot,col)
_nm(int _us,int x2,float _ag,float _ah,int dir,float _bh,color col,string txt,color _xd,color _qo,color _oz,bool _sm)=>
	x1=math.max(_us,bar_index-1000)
	_yw=na(_bh)?_ag:(dir==1?_bh:_ag)
	_yk=na(_bh)?_ah:(dir==1?_ah:_bh)
	_gw(Pieza.new(x1,x2,_yw,_yk),col,dir)
	if not na(_bh)
		_gw(Pieza.new(x1,x2,dir==1?_ag:_bh,dir==1?_bh:_ah),_oz,dir)
	if txt !="" and _fk.size()< 60
		_fk.push(Letrero.new(x2,(_yw+_yk)/2,txt,_xd,true,_sm))
	if not na(_qo)
		m=(_ag+_ah)/2
		for q in _pt(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nt(q.x1,q.x2,m,_qo)
	_gn.push(Pieza.new(x1,x2,_ag,_ah,dir))
_az(array<Zona> arr,color _yg,color _xz,int _up,string txt,bool _yq,bool _tf,color _oz,bool _sm)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_yg:_xz
			t=txt
			_zi=z._ah > close?z._ah-close:close > z._ag?close-z._ag:0.0
			if uso.get(0)< 440 and _gn.size()< _md and(_pm==0 or _zi/close*100 <=_pm)
				_nm(z.x1,bar_index+1,z._ag,z._ah,z.dir,z._bh,color.new(c,_np),t,c,_tf?color.new(color.white,30):na,_oz,_sm)
_as()=>
	if _qc
		_az(_if,_ho,_ho,88,"IFVG "+_dx,true,false,_al,false)
		_az(_hd,_tu,_tp,80,"FVG "+_dx,true,false,_al,true)
	_az(obs,_kl,_kq,90,"OB "+_dx,true,false,_al,false)
_df(bool ver,int _wf,array<Zona> f,array<Zona> fi,color ca,color cb,int _up,string nom)=>
	if ver and not _l and _d !=_wf*60
		_az(fi,_ho,_ho,88,"IFVG "+nom,true,false,_al,false)
		_az(f,ca,cb,_up,"FVG "+nom,true,_wf >=15,_al,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fk.clear()
	_gn.clear()
	_af=false
	if _d <=60
		_as()
		_af:=true
	_df(_cu,1,_yj,_xp,_ng,_nb,84,"M1")
	if not _af and _d <=300
		_as()
		_af:=true
	_df(_bv,5,_wg,_tc,_mn,_mx,84,"M5")
	if not _af and _d <=900
		_as()
		_af:=true
	_df(_ax,15,_rd,_pl,_kr,_lc,84,"M15")
	if not _af and _d <=3600
		_as()
		_af:=true
	_df(_au,60,_qs,_qk,_ky,_ku,82,"H1")
	if not _af and _d <=14400
		_as()
		_af:=true
	_df(_ap,240,_kk,_lg,_je,_jp,80,"H4")
	if not _af
		_as()
	if _fk.size()> 0
		_na=array.new<Letrero>()
		for l in _fk
			x=l.x
			_rw=str.length(l.txt)+2
			for _ux=0 to 3
				_ss=false
				for c in _na
					_su=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _ff and x > c.x-_su and x-_rw < c.x
						x:=c.x-_su
						_ss:=true
				if not _ss
					break
			_na.push(Letrero.new(x,l.y,l.txt,l.col,true,l._sm))
			_ma(x,l.y,l.txt,color.white)
	while _eq.size()> uso.get(0)
		_eq.pop().delete()
	while _dg.size()> uso.get(1)
		_dg.pop().delete()
	while _bt.size()> uso.get(2)
		_bt.pop().delete()
_qp()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bl(array<Zona> arr,string nom,bool _wv)=>
	float _ub=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bh)?z._ah:z._bh
		hi=z.dir==-1 or na(z._bh)?z._ag:z._bh
		d=close >=lo and close <=hi?0.0:_wv?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_ub)or d < _ub)
			_ub:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_ub,txt]
_qd(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_ll(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_mk(int b)=>
	b==1?_ac:b==-1?_t:#757575
_xn(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wm(string n)=>
	str.contains(n,"alcista")?_ac:str.contains(n,"bajista")?_t:#757575
_sa(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ep=na
if barstate.islast and _lh
	pos=_hv=="Arriba izquierda"?position.top_left:_hv=="Abajo derecha"?position.bottom_right:_hv=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_mr=="Muy pequeño"?size.tiny:_mr=="Normal"?size.normal:size.small
	if na(_ep)
		_ep:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ep.clear(0,0,1,13)
	int f=0
	int _xk=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_xk:=request.security(syminfo.tickerid,"240",_qp(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_qp(),lookahead=barmerge.lookahead_on)
	_qd(_ep,f,"Bias H4",_d < 14400?_ll(_xk):"(gráfico ≥ H4)",_mk(_xk),tam)
	f+=1
	_qd(_ep,f,"Bias H1",_d < 3600?_ll(b60):"(gráfico ≥ H1)",_mk(b60),tam)
	f+=1
	ev=_fd.get(0)
	_wj=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_fc.get(0))+" velas"
	_qd(_ep,f,"Estructura "+_dx,_ll(_i)+_wj,_mk(_i),tam)
	f+=1
	tz="America/New_York"
	_wq=hour(timenow,tz)*60+minute(timenow,tz)
	_yo=dayofweek(timenow,tz)
	_yx=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_zh=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_wp=_yo==dayofweek.saturday or _yo==dayofweek.sunday
	_vx=570-_wq
	ses=_wp?"Cerrada (fin de semana)":_wq < 570?"Abre a las "+str.format_time(_yx,"HH:mm","Europe/Madrid")+" (en "+(_vx >=60?str.tostring(int(_vx/60))+" h ":"")+str.tostring(_vx%60)+" min)":_wq < 960?"● Abierta (cierra "+str.format_time(_zh,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yx,"HH:mm","Europe/Madrid")+")"
	_qd(_ep,f,"Sesión NY",ses,not _wp and _wq >=570 and _wq < 960?_ac:#424242,tam)
	f+=1
	float _ta=na
	string _ws=""
	float _sz=na
	string _xf=""
	if _qc
		[d1,t1]=_bl(_hd,"FVG "+_dx,true)
		[d2,t2]=_bl(_if,"IFVG "+_dx,true)
		[d3,t3]=_bl(_hd,"FVG "+_dx,false)
		[d4,t4]=_bl(_if,"IFVG "+_dx,false)
		if not na(d1)and(na(_ta)or d1 < _ta)
			_ta:=d1
			_ws:=t1
		if not na(d2)and(na(_ta)or d2 < _ta)
			_ta:=d2
			_ws:=t2
		if not na(d3)and(na(_sz)or d3 < _sz)
			_sz:=d3
			_xf:=t3
		if not na(d4)and(na(_sz)or d4 < _sz)
			_sz:=d4
			_xf:=t4
	if not _l
		for k=0 to 4
			arr=k==0?_yj:k==1?_wg:k==2?_rd:k==3?_qs:_kk
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cu:k==1?_bv:k==2?_ax:k==3?_au:_ap
			if ver
				[da,ta_]=_bl(arr,nom,true)
				[db,tb]=_bl(arr,nom,false)
				if not na(da)and(na(_ta)or da < _ta)
					_ta:=da
					_ws:=ta_
				if not na(db)and(na(_sz)or db < _sz)
					_sz:=db
					_xf:=tb
	_qd(_ep,f,"FVG por arriba",_xn(_ta,_ws),_wm(_ws),tam)
	f+=1
	_qd(_ep,f,"FVG por abajo",_xn(_sz,_xf),_wm(_xf),tam)
	f+=1
	_vh=not _dy?"(apagada)":na(_ck)?"Ninguna reciente":(_dr==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_ck)+" velas"
	_qd(_ep,f,"SMT",_vh,not _dy or na(_ck)?#757575:_dr==1?_ix:_jb,tam)
	f+=1
	if _ot
		_pa=request.security(_uq,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mp,_xh,_xo]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_pa/16
		pts=_mp*pct/100
		_uc=pts > 0?(_xh-_xo)/pts*100:na
		_uu=na(_pa)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_pa,"#.#")+") · hoy "+str.tostring(_xh-_xo,"#")+" pts = "+str.tostring(_uc,"#")+" %"
		_qd(_ep,f,"Mov. esperado",_uu,na(_uc)?#757575:_uc >=100?_t:_uc >=75?#EF6C00:#424242,tam)
		f+=1
	if _mi and _fs
		_qd(_ep,f,"Asia",_sa(_fo,_gu,_bz,_io,_ie),#5E35B1,tam)
		f+=1
		_qd(_ep,f,"Londres",_sa(_lr,_mu,_dz,_mw,_my),#1E88E5,tam)
		f+=1
	if _qg or _fz
		[_xb,_va,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _qg
			rng=d_h-d_l
			_li=_va > 0?rng/_va*100:na
			_qd(_ep,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_va,"#")+" pts ("+str.tostring(_li,"#")+" %)",na(_li)?#757575:_li >=100?_t:_li >=75?#EF6C00:#424242,tam)
			f+=1
		if _fz
			dif=close-_xb
			_qd(_ep,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_t:_ac,tam)
			f+=1
	if _lv
		float _we=na
		string _ww=""
		float _wi=na
		string _xq=""
		_ms=array.from(pdh,pdl,_io?na:_fo,_ie?na:_gu,_mw?na:_lr,_my?na:_mu)
		_mm=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _dd
			_ms.push(nv._bd)
			_mm.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _de
			_ms.push(nv._bd)
			_mm.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dl
			_ms.push(q._bd)
			_mm.push(q.dir==1?"EQH":"EQL")
		for i=0 to _ms.size()-1
			pv=_ms.get(i)
			if not na(pv)
				if pv > close and(na(_we)or pv < _we)
					_we:=pv
					_ww:=_mm.get(i)
				if pv < close and(na(_wi)or pv > _wi)
					_wi:=pv
					_xq:=_mm.get(i)
		_ur=(na(_we)?"↑ —":"↑ "+_ww+" "+str.tostring(_we,format.mintick)+" (+"+str.tostring(_we-close,format.mintick)+")")+"  ·  "+(na(_wi)?"↓ —":"↓ "+_xq+" "+str.tostring(_wi,format.mintick)+" (−"+str.tostring(close-_wi,format.mintick)+")")
		_qd(_ep,f,"Liquidez",_ur,#424242,tam)
		f+=1
	if _pv !=""
		_qd(_ep,f,"Noticias hoy",_pv,#EF6C00,tam)
		f+=1
_eb(array<label> etq,array<line> lns,bool _rn,int _uv,float sep)=>
	_og=_uv
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_ye=ys.sort_indices()
		_tj=array.new<float>()
		_rs=array.new<int>()
		_pj=array.new<int>()
		_so=timeframe.in_seconds()*1000
		for j in _ye
			e=etq.get(j)
			y=e.get_y()
			_rw=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_uv
			for _ux=0 to 6
				_ss=false
				if _tj.size()> 0
					for c=0 to _tj.size()-1
						if math.abs(_tj.get(c)-y)< sep and ini < _pj.get(c)and ini+_rw > _rs.get(c)
							ini:=_pj.get(c)
							_ss:=true
				if not _ss
					break
			_tj.push(y)
			_rs.push(ini)
			_pj.push(ini+_rw)
			_og:=math.max(_og,ini+_rw)
			if _rn
				e.set_x(time+ini*_so)
				lns.get(j).set_x2(time+ini*_so)
			else
				e.set_x(bar_index+ini)
				lns.get(j).set_x2(bar_index+ini)
	_og
if barstate.islast
	_lu=array.new<label>()
	_ov=array.new<line>()
	for o in _gh
		if not na(o)and not na(o.lb)
			_lu.push(o.lb)
			_ov.push(o.ln)
	for q in _n
		_lu.push(q.lb)
		_ov.push(q.ln)
	_ol=array.new<label>()
	_nv=array.new<line>()
	for n in _dd
		_ol.push(n.lb)
		_nv.push(n.ln)
	for n in _de
		_ol.push(n.lb)
		_nv.push(n.ln)
	_vl=_eb(_lu,_ov,false,1,_ff*0.35)
	_eb(_ol,_nv,true,_lu.size()> 0?_vl:1,_ff*0.35)
