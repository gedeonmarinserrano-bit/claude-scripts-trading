	_de(0,_as,_as and not _as[1],_fn,1,"Asia",#5E35B1)
	_de(1,_as,_as and not _as[1],_gr,-1,"Asia",#5E35B1)
	_de(2,_ck,_ck and not _ck[1],_lh,1,"Londres",#1E88E5)
	_de(3,_ck,_ck and not _ck[1],_nb,-1,"Londres",#1E88E5)
