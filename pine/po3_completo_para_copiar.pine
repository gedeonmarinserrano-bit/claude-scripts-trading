_bo(array<Zona> arr,array<Zona> _dr)=>
	_vk=false
	if _dr.size()> 0
		for i=_dr.size()-1 to 0
			if _el(_dr.get(i))
				_dr.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_sw=(z._af+z._ag)/2
			if low <=_sw and high >=_sw
				_vk:=true
			_iz=na(z._be)and(z.dir==1?(open >=z._af and close < z._ag):(open <=z._ag and close > z._af))
			if _iz
				arr.remove(i)
				_dr.push(Zona.new(z.x1,z._af,z._ag,-z.dir,na,bar_index))
				if _dr.size()> _gb
					_dr.shift()
			else if _el(z)
				arr.remove(i)
	_vk
