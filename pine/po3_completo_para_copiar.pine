	if _ge.size()> _qu
		_ge.shift().delete()
	if _fz.size()> _qu
		_fz.shift().delete()
var int _ci=na
var int _de=0
_hs=false
_hr=false
if barstate.isconfirmed
	if not na(_md)
		_re=not na(_ha)and _qk-_ha <=_pg
		d1=_re and _nv and _dq(_md,_fb,_pu,_iw,true)
