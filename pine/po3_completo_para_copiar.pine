_ry=_kz(_pz)
_rr=_kz(_qi)
_xf=str.replace(_ry,"1!","")
_wd=str.replace(_rr,"1!","")
_tu=str.replace(syminfo.ticker,"1!","")
_oq=_dz and _tk and _xf !=_tu
_of=_dz and _tl and _wd !=_tu
_sk()=>
	w=2*_gj+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pk=na
float _qg=na
int _sm=na
int _sp=na
