_pn=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cy)
_oh="Estructura (CHoCH / BOS)"
_ca=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_oh)
_td=1.1
_uj=2.0
_ul=20
_st=2
_mx=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oh)
_ig=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oh)
_hu=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oh)
_jj=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oh)
_eq=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oh)
_ra=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oh)
_bg=bar_index >=last_bar_index-_ra
_cq=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_ng=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
