_kc=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qn)
_qo=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qn)
_ku=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qn)
_kb=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_qn)
_qr=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_qn)
_kq=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_qn)
_kj=input.color(#8D6E63,"Color niveles H1",group=_qn)
_qq=input.bool(false,"Niveles clave: alto/bajo del día anterior",group=_qn)
_dw=input.color(#424242,"Color niveles clave",group=_qn)
_nb=input.color(#757575,"Color horas",group=_qn)
_em=input.bool(true,"Mostrar EMAs",group="EMAs")
_oc=input.int(9,"EMA rápida",minval=1,group="EMAs")
_pa=input.int(20,"EMA media",minval=1,group="EMAs")
_pd=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ph=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_pc=input.color(#2962FF,"Color EMA media",group="EMAs")
_oi=input.color(#363A45,"Color EMA lenta",group="EMAs")
_jk=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ia=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fs=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kw=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vl=14
_rj=50
_ti=0.15
_qu=2.5
_rc=30
_qa=1.0
_lv=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_om="Colores"
_ac=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_om)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_om)
_nl=input.bool(true,"Marcar la vela del OB",group=_om)
_ho=input.color(#FF00C8,"IFVG (magenta)",group=_om)
_my=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_om)
_kk=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_om)
type Zona
	int x1
	float _ah
	float _ag
	int dir
	float _bh=na
	int _rr=na
	bool _lx=false
var _hg=array.new<Zona>()
var _hw=array.new<Zona>()
var obs=array.new<Zona>()
var _yf=array.new<Zona>()
var _wb=array.new<Zona>()
var _rf=array.new<Zona>()
var _rd=array.new<Zona>()
var _ks=array.new<Zona>()
var _xk=array.new<Zona>()
var _te=array.new<Zona>()
var _py=array.new<Zona>()
var _pq=array.new<Zona>()
var _ln=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ag
	color col
var _bn=array.new<Rango>()
_eu(Zona z)=>
	_fu=z.dir==1?low <=z._ag:high >=z._ah
	if not _fu
		_bh=na(z._bh)?(z.dir==1?z._ah:z._ag):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_fu
type Marca
	label lb
	line ln
	int bar
var _jo=array.new<Marca>()
var array<string> _fb=array.from("")
var array<int> _ez=array.from(0)
_aj(label lb,line ln,int bar)=>
	_jo.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fb.set(0,lb.get_text())
		_ez.set(0,bar)
	if _jo.size()> 500
		_jo.shift()
_qx=ta.ema(close,_oc)
_sl=ta.ema(close,_pa)
_hy=ta.ema(close,_pd)
_db=ta.atr(_vl)
var string _ub='════════ Detection ════════'
var string _si='════════ Structure Filters ════════'
var string _vv='════════ Range Behavior ════════'
var string _uf='════════ Visual Settings ════════'
_cp='Base + 2x + 3x'
_ow='Rangos'
_bj=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_ow)
_bo='Percentile band'
_eo=90.0
_mi='Bar close'
_kz=200
_ie=40.0
_en=500
_nd=0.18
_og='Wick reaches'
_jh=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_ow)
_eh=0.10
_rt=0.45
_ei=0.70
_js='Extend to containment'
_id=300
_jz=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_ow)
_hb=true
_lo=0.25
_md='Close beyond'
_jc=0.15
_he=true
_hk=10
_li=3
_gc=0
_nj='Custom'
_mf=#00A651
_lf=#E4002B
_fg=input.color(#F9A825,'Color del rango (neutral)',group=_ow)
_jy=4
_gk=93
_hf=true
_ka=true
_hd=input.bool(true,'Mostrar etiqueta del rango',group=_ow)
_ju=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_ow)
_ib=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_ow)
_ig='Small'
_fc=true
_kd='Small'
[_cf,_ch]=switch _nj
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_mf,_lf]
var color _ca=color.new(color.black,100)
var float _cg=3.0
var float _dv=1.6
_jq(string _xo)=>
	switch _xo
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fi(color _dl)=>
	_iv=color.r(_dl)/255.0
	_jg=color.g(_dl)/255.0
	_jr=color.b(_dl)/255.0
	_tq=_iv <=0.03928?_iv/12.92:math.pow((_iv+0.055)/1.055,2.4)
	_tr=_jg <=0.03928?_jg/12.92:math.pow((_jg+0.055)/1.055,2.4)
	_tc=_jr <=0.03928?_jr/12.92:math.pow((_jr+0.055)/1.055,2.4)
	0.2126*_tq+0.7152*_tr+0.0722*_tc
_mj(color _nz,color _mv)=>
	_nr=_fi(_nz)
	_lb=_fi(_mv)
	(math.max(_nr,_lb)+0.05)/(math.min(_nr,_lb)+0.05)
_el(color _hn)=>
	_fi(_hn)> 0.179?#000000:#ffffff
_nv(color _dl,color _ml,float _rh)=>
	color.rgb(color.r(_dl)+(color.r(_ml)-color.r(_dl))*_rh,color.g(_dl)+(color.g(_ml)-color.g(_dl))*_rh,color.b(_dl)+(color.b(_ml)-color.b(_dl))*_rh)
_bl(color _dl,color _hn,float _ny)=>
	_ml=_el(_hn)
	_ls=_dl
	for step=1 to 10
		if _mj(_ls,_hn)>=_ny
			break
		_ls:=_nv(_dl,_ml,step/10.0)
	_ls
_ik(float _yd)=>
	str.tostring(_yd,'#.##')+'%'
_qv(array<box> _jv,int _lm,float _bf,float _ak)=>
	array.clear(_jv)
	if not _kk
		for i=0 to _jy-1
			array.push(_jv,box.new(_lm,_bf,bar_index,_ak,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gm(array<box> _jv,float _bf,float _ak,int _lm,int _sr,color _ob)=>
	_px=array.size(_jv)
	if _px > 0 and _bf > _ak
		_ha=(_bf-_ak)/_px
		for i=0 to _px-1
			_jf=array.get(_jv,i)
			_oo=math.abs((i+0.5)/_px-0.5)*2.0
			_nw=int(math.min(99,math.max(0,_gk+(1.0-_oo)*10)))
			box.set_lefttop(_jf,_lm,_bf-_ha*i)
			box.set_rightbottom(_jf,_sr,_bf-_ha*(i+1))
			box.set_bgcolor(_jf,color.new(_ob,_nw))
_od(array<box> _jv)=>
	if array.size(_jv)> 0
		for i=0 to array.size(_jv)-1
			box.delete(array.get(_jv,i))
	array.clear(_jv)
_re(int _sd,float _bf,float _ak,float _ck)=>
	_ym=_sd
	if _js=='Extend to containment'
		_ya=math.min(_id,bar_index)
		_uy=math.max(2,math.round((1.0-_ei)*_sd))
		_lj=0
		_gw=0
		while _gw < _ya and _lj <=_uy
			_mp=close[_gw]<=_bf and close[_gw]>=_ak
			_sz=_mp and high[_gw]<=_bf+_ck and low[_gw]>=_ak-_ck
			if _mp
				_lj:=math.max(0,_lj-1)
				if _sz and _gw+1 >=_sd
					_ym:=_gw+1
			else
				_lj+=1
			_gw+=1
	_ym
_cl=ta.atr(_kz)
_kr=not na(_cl)and _cl > 0
_gf=_md=='Wick beyond'
_kv=_og=='Wick reaches'
_ok=_mi=='Live bar'
_fn=_ok or barstate.isconfirmed
_go=_jq(_ig)
_ky=_jq(_kd)
_x=chart.bg_color
_s=_bl(_fg,_x,_cg)
_fy=_bl(_cf,_x,_cg)
_gd=_bl(_ch,_x,_cg)
_hi=_bl(_fg,_x,_dv)
_fv=_bl(_cf,_x,_dv)
_gb=_bl(_ch,_x,_dv)
_gl(simple int len)=>
	_vr=ta.percentile_linear_interpolation(high,len,_eo)
	_qy=ta.percentile_linear_interpolation(low,len,100.0-_eo)
	_wa=ta.highest(high,len)
	_qw=ta.lowest(low,len)
	_tx=ta.highest(math.max(open,close),len)
	_ox=ta.lowest(math.min(open,close),len)
	top=_bo=='Absolute extremes'?_wa:_bo=='Body extremes'?_tx:_vr
	_kx=_bo=='Absolute extremes'?_qw:_bo=='Body extremes'?_ox:_qy
	_dy=top-_kx
	_on=_kr and _dy > 0?_dy/(_cl*math.sqrt(len)):99.0
	_tz=bar_index < 1?_en:int(math.max(1,math.min(_en,bar_index-_kz)))
	_yo=ta.percentrank(_on,_tz)
	_xs=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xr=_dy > 0?math.abs(_xs)*len/_dy:99.0
	_cr=math.avg(top,_kx)
	_ck=_eh*nz(_cl)
	_nh=0
	_qc=0
	_ij=0
	_mo=0
	for i=0 to len-1
		if(close[i]> _cr)!=(close[i+1]> _cr)
			_nh+=1
		_pi=_kv?high[i]>=top-_ck:close[i]>=top-_ck
		_ke=_kv?low[i]<=_kx+_ck:close[i]<=_kx+_ck
		if _pi
			_qc+=1
		if _ke
			_ij+=1
		if close[i]<=top and close[i]>=_kx
			_mo+=1
	_or=_mo/float(len)
	_iu=_kr and not na(_yo)and bar_index > len+5 and _yo <=_ie and _nh >=math.max(3,math.round(_nd*len))and _qc >=_jh and _ij >=_jh and _xr <=_rt and _or >=_ei
	[_iu,top,_kx]
bool _jl=false
bool _hx=false
bool _ji=false
float _wm=na
float _xj=na
float _xg=na
float _pr=na
float _pj=na
float _ql=na
if _az
	[qa,ta_,ba]=_gl(_bj)
	_jl:=qa
	_wm:=ta_
	_pr:=ba
	if _cp !='Base only'
		[qb,tb,bb]=_gl(_bj*2)
		_hx:=qb
		_xj:=tb
		_pj:=bb
	if _cp=='Base + 2x + 3x'
		[qc,tc,bc]=_gl(_bj*3)
		_ji:=qc
		_xg:=tc
		_ql:=bc
_et=_cp !='Base only' and _hx
_es=_cp=='Base + 2x + 3x' and _ji
_iu=_jl or _et or _es
_oh=_es?_bj*3:_et?_bj*2:_bj
_qj=_es?_xg:_et?_xj:_wm
_hs=_es?_ql:_et?_pj:_pr
var array<box> _ar=array.new<box>()
var box _v=na
var line _g=na
var line _k=na
var line _y=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _gr=na
var bool _t=false
var bool _l=false
var bool _aw=false
var int _do=na
var int _p=0
var float _q=na
var int _av=na
var int _au=0
_cc=false
_cm=false
_bi=false
_cd=false
if _fn and _au > 0
	_au-=1
if _fn and not _t and not _aw and _au <=0 and _iu
	_oa=_re(_oh,_qj,_hs,_eh*_cl)
	_c:=bar_index-_oa+1
	_gr:=bar_index
	_f:=_qj
	_a:=_hs
	_t:=true
	_l:=false
	_cr=math.avg(_f,_a)
	_bx=_a+(_f-_a)*0.25
	_ay=_a+(_f-_a)*0.75
	_v:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qv(_ar,_c,_f,_a)
	if _hf
		_g:=line.new(_c,_cr,bar_index,_cr,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _ka
		_k:=line.new(_c,_bx,bar_index,_bx,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_y:=line.new(_c,_ay,bar_index,_ay,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hd
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_ca,style=label.style_label_down,textcolor=color.new(_s,10),size=_go)
	_cc:=true
if _t and _fn
	_ct=_jc*_cl
	_fo=_lo*_cl
	if _hb and not _gf and close <=_f and close >=_a
		if high > _f and high <=_f+_fo
			_f:=high
		if low < _a and low >=_a-_fo
			_a:=low
	_ps=_gf?high > _f+_ct:close > _f+_ct
	_kg=_gf?low < _a-_ct:close < _a-_ct
	_rb=_gc > 0 and bar_index-_gr+1 >=_gc
	if _ps or _kg or _rb
		_b=_ps?1:_kg?-1:0
		_sf=_b !=0?bar_index-_c:bar_index-_c+1
		_mz=_a !=0?(_f-_a)/_a*100.0:0.0
		_jt=_he and _b !=0 and _l
		if _l
			_fh=_b==1?_fy:_b==-1?_gd:_s
			_pe=_b==1?_fv:_b==-1?_gb:_hi
			_hr=_b==1?_cf:_b==-1?_ch:_fg
			box.set_lefttop(_v,_c,_f)
			box.set_rightbottom(_v,bar_index,_a)
			box.set_border_color(_v,color.new(_fh,30))
			box.set_border_style(_v,line.style_dotted)
			_gm(_ar,_f,_a,_c,bar_index,na)
			_bn.push(Rango.new(_c,bar_index,_f,_a,_pe))
			if _bn.size()> 8
				_bn.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_y,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
