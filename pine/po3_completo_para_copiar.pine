		f+=1
_ea(array<label> etq,bool _sf,int _up,float sep)=>
	_oj=_up
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xx=ys.sort_indices()
		_sy=array.new<float>()
		_sp=array.new<int>()
		_ol=array.new<int>()
		_vi=timeframe.in_seconds()*1000
		for j in _xx
			e=etq.get(j)
			y=e.get_y()
			_ry=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_up
			for _vs=0 to 6
				_rt=false
				if _sy.size()> 0
					for c=0 to _sy.size()-1
						if math.abs(_sy.get(c)-y)< sep and ini < _ol.get(c)and ini+_ry > _sp.get(c)
							ini:=_ol.get(c)
							_rt:=true
				if not _rt
					break
			_sy.push(y)
			_sp.push(ini)
			_ol.push(ini+_ry)
			_oj:=math.max(_oj,ini+_ry)
			if _sf
				e.set_x(time+ini*_vi)
			else
				e.set_x(bar_index+ini)
	_oj
if barstate.islast
	_lv=array.new<label>()
	for o in _gj
		if not na(o)and not na(o.lb)
			_lv.push(o.lb)
	for q in _n
		q.ln.set_x2(bar_index)
		_lv.push(q.lb)
	_pb=array.new<label>()
	for n in _de
		_pb.push(n.lb)
	for n in _dk
		_pb.push(n.lb)
	_uz=_ea(_lv,false,1,_fh*0.35)
	_ea(_pb,true,_lv.size()> 0?_uz:1,_fh*0.35)
