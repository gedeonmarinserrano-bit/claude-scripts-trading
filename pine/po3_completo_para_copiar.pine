_hd="SMT (divergencias entre índices)"
_dx=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hd)
_lr=input.bool(true,"Mostrar etiquetas de la SMT",group=_hd)
_rr=input.bool(true,"Mostrar línea de la SMT",group=_hd)
_tb=input.bool(true,"Comparar con",inline="smt1",group=_hd)
_ql=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_hd)
_tr=input.bool(true,"Comparar con",inline="smt2",group=_hd)
_po=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_hd)
_gi=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hd)
_pk=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hd)
_rj=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hd)
_iv=input.color(#ff1100,"SMT bajista (en altos)",group=_hd)
_jc=input.color(#2157f3,"SMT alcista (en bajos)",group=_hd)
_kl(string s)=>
	_ud=str.split(s,":")
	_ud.size()> 0?_ud.last():s
_rv=_kl(_ql)
_rm=_kl(_po)
_xd=str.replace(_rv,"1!","")
_xb=str.replace(_rm,"1!","")
_tx=str.replace(syminfo.ticker,"1!","")
_oo=_dx and _tb and _xd !=_tx
_ow=_dx and _tr and _xb !=_tx
_rn()=>
	w=2*_gi+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _qg=na
float _qj=na
int _sf=na
int _so=na
float _pn=na
float _pv=na
int _ry=na
int _rp=na
if _oo and _bh
	[h_,l_,hb_,lb_]=request.security(_ql,timeframe.period,_rn(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_qg:=h_
	_qj:=l_
	_sf:=hb_
	_so:=lb_
if _ow and _bh
	[h_,l_,hb_,lb_]=request.security(_po,timeframe.period,_rn(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pn:=h_
	_pv:=l_
	_ry:=hb_
	_rp:=lb_
_ms=ta.pivothigh(high,_gi,_gi)
_nf=ta.pivotlow(low,_gi,_gi)
_qr=bar_index-_gi
var int _hp=na
var float _ft=na
var float _hs=na
var float _im=na
var int _hl=na
var float _fz=na
var float _iq=na
var float _ik=na
var array<line> _gl=array.new<line>()
var array<label> _gn=array.new<label>()
_dm(float y,float _vx,float c,float _mx,bool _oa)=>
	_vu=_oa?y > _vx:y < _vx
	_un=_oa?c > _mx:c < _mx
	not na(_vx)and not na(_mx)and not na(c)and _vu !=_un
_fj(string t,float c,float _mx)=>
	t+(c > _mx?" ↑":c < _mx?" ↓":" =")
_kz(int x1,float y1,int xv,string txt,color col,bool _oa)=>
	yv=_oa?high[bar_index-xv]:low[bar_index-xv]
	if _rr
		_gl.push(line.new(x1,y1,xv,yv,color=col))
	if _lr
		_gn.push(label.new(xv,yv,txt,style=_oa?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_oa?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_oa?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gl.size()> _rj
		_gl.shift().delete()
	if _gn.size()> _rj
		_gn.shift().delete()
var int _cj=na
var int _du=0
_ia=false
_il=false
if barstate.isconfirmed
	if not na(_ms)
		_sl=not na(_hp)and _qr-_hp <=_pk
		d1=_sl and _oo and _dm(_ms,_ft,_qg,_hs,true)
		d2=_sl and _ow and _dm(_ms,_ft,_pn,_im,true)
		if d1 or d2
			_ia:=true
