_hg="SMT (divergencias entre índices)"
_dz=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hg)
_lq=input.bool(true,"Mostrar etiquetas de la SMT",group=_hg)
_sf=input.bool(true,"Mostrar línea de la SMT",group=_hg)
_te=input.bool(true,"Comparar con",inline="smt1",group=_hg)
_ql=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_hg)
_tb=input.bool(true,"Comparar con",inline="smt2",group=_hg)
_pj=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_hg)
_gk=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hg)
_qm=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hg)
_sr=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hg)
_jd=input.color(#ff1100,"SMT bajista (en altos)",group=_hg)
_js=input.color(#2157f3,"SMT alcista (en bajos)",group=_hg)
_kz(string s)=>
	_ug=str.split(s,":")
	_ug.size()> 0?_ug.last():s
_sm=_kz(_ql)
_ry=_kz(_pj)
_wp=str.replace(_sm,"1!","")
_xm=str.replace(_ry,"1!","")
_uj=str.replace(syminfo.ticker,"1!","")
_oo=_dz and _te and _wp !=_uj
_ox=_dz and _tb and _xm !=_uj
_sq()=>
	w=2*_gk+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _py=na
float _qf=na
int _si=na
int _rt=na
float _pk=na
float _pr=na
int _rn=na
int _rq=na
if _oo and _be
	[h_,l_,hb_,lb_]=request.security(_ql,timeframe.period,_sq(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_py:=h_
	_qf:=l_
	_si:=hb_
	_rt:=lb_
if _ox and _be
	[h_,l_,hb_,lb_]=request.security(_pj,timeframe.period,_sq(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pk:=h_
	_pr:=l_
	_rn:=hb_
	_rq:=lb_
_nq=ta.pivothigh(high,_gk,_gk)
_ng=ta.pivotlow(low,_gk,_gk)
_qy=bar_index-_gk
var int _hn=na
var float _fm=na
var float _jm=na
var float _ix=na
var int _hm=na
var float _fs=na
var float _iy=na
var float _hv=na
var array<line> _gq=array.new<line>()
var array<label> _gn=array.new<label>()
_ds(float y,float _vw,float c,float _ms,bool _ov)=>
	_vf=_ov?y > _vw:y < _vw
	_uu=_ov?c > _ms:c < _ms
	not na(_vw)and not na(_ms)and not na(c)and _vf !=_uu
_fz(string t,float c,float _ms)=>
	t+(c > _ms?" ↑":c < _ms?" ↓":" =")
_la(int x1,float y1,int xv,string txt,color col,bool _ov)=>
	yv=_ov?high[bar_index-xv]:low[bar_index-xv]
	if _sf
		_gq.push(line.new(x1,y1,xv,yv,color=col))
	if _lq
		_gn.push(label.new(xv,yv,txt,style=_ov?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_ov?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_ov?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gq.size()> _sr
		_gq.shift().delete()
	if _gn.size()> _sr
		_gn.shift().delete()
var int _cm=na
var int _dy=0
_id=false
_ig=false
if barstate.isconfirmed
	if not na(_nq)
		_rx=not na(_hn)and _qy-_hn <=_qm
		d1=_rx and _oo and _ds(_nq,_fm,_py,_jm,true)
		d2=_rx and _ox and _ds(_nq,_fm,_pk,_ix,true)
		if d1 or d2
			_id:=true
			_cm:=bar_index
			_dy:=-1
			_in=_nq > _fm
			xv=_in?_qy:bar_index+int(d1?_si:_rn)
			t1=_fz(_sm,_py,_jm)
			t2=_fz(_ry,_pk,_ix)
			_la(_hn,_fm,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jd,true)
		_hn:=_qy
		_fm:=_nq
		_jm:=_py
		_ix:=_pk
	if not na(_ng)
		_rx=not na(_hm)and _qy-_hm <=_qm
		d1=_rx and _oo and _ds(_ng,_fs,_qf,_iy,false)
		d2=_rx and _ox and _ds(_ng,_fs,_pr,_hv,false)
		if d1 or d2
			_ig:=true
			_cm:=bar_index
			_dy:=1
			_in=_ng < _fs
			xv=_in?_qy:bar_index+int(d1?_rt:_rq)
			t1=_fz(_sm,_qf,_iy)
			t2=_fz(_ry,_pr,_hv)
			_la(_hm,_fs,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_js,false)
		_hm:=_qy
		_fs:=_ng
		_iy:=_qf
		_hv:=_pr
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _eh=array.new<box>()
var array<line> _dg=array.new<line>()
var array<label> _bv=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qs(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eh.size()
		b=_eh.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eh.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_nv(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dg.size()
		l=_dg.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dg.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lo(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bv.size()
		e=_bv.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bv.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _yb
	bool _rp
var array<Letrero> _ge=array.new<Letrero>()
_fj=nz(ta.atr(50))*0.5
_vv=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oh)
_et=nz(ta.atr(50))*_vv/100
var array<Pieza> _gh=array.new<Pieza>()
_xn(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pt(Pieza p)=>
	res=array.from(p)
	if _kf and _gh.size()> 0
		for o in _gh
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wj=array.new<Pieza>()
				for q in res
					for r in _xn(q,o)
						_wj.push(r)
				res:=_wj
				if res.size()==0 or res.size()> 10
					break
	res
_gs(Pieza p,color col,int dir)=>
	for q in _pt(p)
		top=q.top
		bot=q.bot
		if _et > 0 and dir !=0
			for o in _gh
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_et
						top:=math.min(top,o.bot-_et)
					if math.abs(bot-o.top)<=_et
						bot:=math.max(bot,o.top+_et)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qs(q.x1,top,q.x2,bot,col)
_np(int _uy,int x2,float _ah,float _ai,int dir,float _bi,color col,string txt,color _xd,color _pp,color _pg,bool _rp)=>
	x1=math.max(_uy,bar_index-1000)
	_yr=na(_bi)?_ah:(dir==1?_bi:_ah)
	_ym=na(_bi)?_ai:(dir==1?_ai:_bi)
	_gs(Pieza.new(x1,x2,_yr,_ym),col,dir)
	if not na(_bi)
		_gs(Pieza.new(x1,x2,dir==1?_ah:_bi,dir==1?_bi:_ai),_pg,dir)
	if txt !="" and _ge.size()< 60
		_ge.push(Letrero.new(x2,(_yr+_ym)/2,txt,_xd,true,_rp))
	if not na(_pp)
		m=(_ah+_ai)/2
		for q in _pt(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nv(q.x1,q.x2,m,_pp)
	_gh.push(Pieza.new(x1,x2,_ah,_ai,dir))
_bd(array<Zona> arr,color _xv,color _xp,int _ue,string txt,bool _yk,bool _tg,color _pg,bool _rp)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xv:_xp
			t=txt
			_yw=z._ai > close?z._ai-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gh.size()< _lg and(_qa==0 or _yw/close*100 <=_qa)
				_np(z.x1,bar_index+1,z._ah,z._ai,z.dir,z._bi,color.new(c,_nn),t,c,_tg?color.new(color.white,30):na,_pg,_rp)
