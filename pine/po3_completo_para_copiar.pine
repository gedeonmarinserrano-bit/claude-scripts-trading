		_qb(_eo,f,"Mov. esperado",_uw,na(_ti)?#757575:_ti >=100?_v:_ti >=75?#EF6C00:#424242,tam)
		f+=1
	if _ls and _hr
		_qb(_eo,f,"Asia",_rg(_gd,_gw,_as,_jq,_ir),#5E35B1,tam)
		f+=1
		_qb(_eo,f,"Londres",_rg(_lk,_mp,_cn,_mv,_mr),#1E88E5,tam)
		f+=1
	if _qi or _fl
		[_wm,_vs,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _qi
			rng=d_h-d_l
			_ma=_vs > 0?rng/_vs*100:na
			_qb(_eo,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_vs,"#")+" pts ("+str.tostring(_ma,"#")+" %)",na(_ma)?#757575:_ma >=100?_v:_ma >=75?#EF6C00:#424242,tam)
			f+=1
		if _fl
