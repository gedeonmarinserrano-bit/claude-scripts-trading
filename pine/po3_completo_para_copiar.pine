_he="SMT (divergencias entre índices)"
_dy=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_he)
_lp=input.bool(true,"Mostrar etiquetas de la SMT",group=_he)
_sc=input.bool(true,"Mostrar línea de la SMT",group=_he)
_tb=input.bool(true,"Comparar con",inline="smt1",group=_he)
_qh=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_he)
_st=input.bool(true,"Comparar con",inline="smt2",group=_he)
_pm=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_he)
_gn=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_he)
_po=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_he)
_ry=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_he)
_hw=input.color(#ff1100,"SMT bajista (en altos)",group=_he)
_ir=input.color(#2157f3,"SMT alcista (en bajos)",group=_he)
_le(string s)=>
	_tt=str.split(s,":")
	_tt.size()> 0?_tt.last():s
_rj=_le(_qh)
_sh=_le(_pm)
_wx=str.replace(_rj,"1!","")
_xd=str.replace(_sh,"1!","")
_tu=str.replace(syminfo.ticker,"1!","")
_os=_dy and _tb and _wx !=_tu
_pb=_dy and _st and _xd !=_tu
_sk()=>
	w=2*_gn+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _qd=na
float _qb=na
int _rn=na
int _sd=na
float _pj=na
float _pi=na
int _rh=na
int _sj=na
if _os and _bg
