_hb="SMT (divergencias entre índices)"
_dz=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hb)
_mh=input.bool(true,"Mostrar etiquetas de la SMT",group=_hb)
_rp=input.bool(true,"Mostrar línea de la SMT",group=_hb)
_tk=input.bool(true,"Comparar con",inline="smt1",group=_hb)
_pz=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_hb)
_tl=input.bool(true,"Comparar con",inline="smt2",group=_hb)
_qi=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_hb)
_gj=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hb)
_qf=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hb)
_rj=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hb)
_hr=input.color(#ff1100,"SMT bajista (en altos)",group=_hb)
_jg=input.color(#2157f3,"SMT alcista (en bajos)",group=_hb)
_kz(string s)=>
