		[_ns,_wt,_wh]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_ou/16
		pts=_ns*pct/100
		_tq=pts > 0?(_wt-_wh)/pts*100:na
		_vv=na(_ou)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_ou,"#.#")+") · hoy "+str.tostring(_wt-_wh,"#")+" pts = "+str.tostring(_tq,"#")+" %"
		_qf(_eq,f,"Mov. esperado",_vv,na(_tq)?#757575:_tq >=100?_u:_tq >=75?#EF6C00:#424242,tam)
		f+=1
	if _lq and _jh
		_qf(_eq,f,"Asia",_rq(_fq,_gr,_bj,_ir,_ix),#5E35B1,tam)
		f+=1
		_qf(_eq,f,"Londres",_rq(_lm,_mz,_dj,_np,_mx),#1E88E5,tam)
		f+=1
	if _qa or _gd
		[_wj,_vg,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _qa
			rng=d_h-d_l
			_mi=_vg > 0?rng/_vg*100:na
			_qf(_eq,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_vg,"#")+" pts ("+str.tostring(_mi,"#")+" %)",na(_mi)?#757575:_mi >=100?_u:_mi >=75?#EF6C00:#424242,tam)
			f+=1
		if _gd
			dif=close-_wj
			_qf(_eq,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_u:_ad,tam)
			f+=1
	if _mg
		float _wc=na
		string _wx=""
		float _wa=na
		string _xi=""
		_nd=array.from(pdh,pdl,_ir?na:_fq,_ix?na:_gr,_np?na:_lm,_mx?na:_mz)
		_mq=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _di
			_nd.push(nv._bf)
			_mq.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _dg
			_nd.push(nv._bf)
			_mq.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dt
			_nd.push(q._bf)
			_mq.push(q.dir==1?"EQH":"EQL")
		for i=0 to _nd.size()-1
			pv=_nd.get(i)
			if not na(pv)
				if pv > close and(na(_wc)or pv < _wc)
					_wc:=pv
					_wx:=_mq.get(i)
				if pv < close and(na(_wa)or pv > _wa)
					_wa:=pv
					_xi:=_mq.get(i)
		_vu=(na(_wc)?"↑ —":"↑ "+_wx+" "+str.tostring(_wc,format.mintick)+" (+"+str.tostring(_wc-close,format.mintick)+")")+"  ·  "+(na(_wa)?"↓ —":"↓ "+_xi+" "+str.tostring(_wa,format.mintick)+" (−"+str.tostring(close-_wa,format.mintick)+")")
		_qf(_eq,f,"Liquidez",_vu,#424242,tam)
		f+=1
	if _pp !=""
		_qf(_eq,f,"Noticias hoy",_pp,#EF6C00,tam)
		f+=1
_ec(array<label> etq,bool _rr,int _uu,float sep)=>
	_pd=_uu
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xq=ys.sort_indices()
		_te=array.new<float>()
		_sc=array.new<int>()
		_pe=array.new<int>()
		_un=timeframe.in_seconds()*1000
		for j in _xq
			e=etq.get(j)
			y=e.get_y()
			_ry=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_uu
			for _vl=0 to 6
				_rl=false
				if _te.size()> 0
					for c=0 to _te.size()-1
						if math.abs(_te.get(c)-y)< sep and ini < _pe.get(c)and ini+_ry > _sc.get(c)
							ini:=_pe.get(c)
							_rl:=true
				if not _rl
					break
			_te.push(y)
			_sc.push(ini)
			_pe.push(ini+_ry)
			_pd:=math.max(_pd,ini+_ry)
			if _rr
				e.set_x(time+ini*_un)
			else
				e.set_x(bar_index+ini)
	_pd
if barstate.islast
	_mh=array.new<label>()
	for o in _ge
		if not na(o)and not na(o.lb)
			_mh.push(o.lb)
	for q in _n
		q.ln.set_x2(bar_index)
		_mh.push(q.lb)
	_of=array.new<label>()
	for n in _di
		_of.push(n.lb)
	for n in _dg
		_of.push(n.lb)
	_vc=_ec(_mh,false,1,_fg*0.35)
	_ec(_of,true,_mh.size()> 0?_vc:1,_fg*0.35)
