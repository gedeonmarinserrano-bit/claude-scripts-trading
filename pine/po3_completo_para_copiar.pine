			_em.push(label.new(bar_index,_wa?high:low,"Barrido "+nom,style=_wa?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _em.size()> 20
