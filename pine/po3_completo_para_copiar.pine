_jz=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qg)
_ra=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qg)
_kp=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qg)
_kd=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_qg)
_qp=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_qg)
_le=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_qg)
_ky=input.color(#8D6E63,"Color niveles H1",group=_qg)
_qq=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qg)
_dy=input.color(#424242,"Color niveles clave",group=_qg)
_ms=input.color(#757575,"Color horas",group=_qg)
_eq=input.bool(true,"Mostrar EMAs",group="EMAs")
_od=input.int(9,"EMA rápida",minval=1,group="EMAs")
_oi=input.int(20,"EMA media",minval=1,group="EMAs")
_nz=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oq=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_ok=input.color(#9E9D24,"Color EMA media",group="EMAs")
_ot=input.color(color.black,"Color EMA lenta",group="EMAs")
_ir=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ja=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fl=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kz=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_uu=14
_rk=50
_tx=0.15
_qz=2.5
_qr=30
_qk=1.0
_li=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pa="Colores"
_ad=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pa)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pa)
_mn=input.bool(true,"Marcar la vela del OB",group=_pa)
_hp=input.color(#FF00C8,"IFVG (magenta)",group=_pa)
_ni=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pa)
_ku=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pa)
type Zona
	int x1
	float _ai
	float _ah
	int dir
	float _bi=na
	int _sr=na
	bool _ma=false
var _hh=array.new<Zona>()
var _iv=array.new<Zona>()
var obs=array.new<Zona>()
var _xq=array.new<Zona>()
var _vz=array.new<Zona>()
var _qy=array.new<Zona>()
var _qt=array.new<Zona>()
var _kf=array.new<Zona>()
var _wr=array.new<Zona>()
var _tv=array.new<Zona>()
var _qj=array.new<Zona>()
var _pz=array.new<Zona>()
var _mg=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ai
	float _ah
	color col
var _bl=array.new<Rango>()
_ex(Zona z)=>
	_ft=z.dir==1?low <=z._ah:high >=z._ai
	if not _ft
		_bi=na(z._bi)?(z.dir==1?z._ai:z._ah):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_ft
type Marca
	label lb
	line ln
	int bar
var _ic=array.new<Marca>()
var array<string> _ff=array.from("")
var array<int> _fc=array.from(0)
_aj(label lb,line ln,int bar)=>
	_ic.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ff.set(0,lb.get_text())
		_fc.set(0,bar)
	if _ic.size()> 500
		_ic.shift()
_rb=ta.ema(close,_od)
_ri=ta.ema(close,_oi)
_jp=ta.ema(close,_nz)
_ck=ta.atr(_uu)
var string _ub='════════ Detection ════════'
var string _ry='════════ Structure Filters ════════'
var string _ve='════════ Range Behavior ════════'
var string _uh='════════ Visual Settings ════════'
_cr='Base + 2x + 3x'
_ow='Rangos'
_bn=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_ow)
_bp='Percentile band'
_er=90.0
_mb='Bar close'
_kg=200
_je=40.0
_ee=500
_mp=0.18
_og='Wick reaches'
_if=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_ow)
_en=0.10
_rp=0.45
_eo=0.70
_hy='Extend to containment'
_ix=300
_kb=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_ow)
_he=true
_mk=0.25
_mj='Close beyond'
_js=0.15
_hj=true
_hg=10
_lj=3
_fo=0
_ml='Custom'
_ly=#00A651
_lf=#E4002B
_fj=input.color(#F9A825,'Color del rango (neutral)',group=_ow)
_jx=4
_gi=93
_hb=true
_ke=true
_hi=input.bool(true,'Mostrar etiqueta del rango',group=_ow)
_ka=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_ow)
_jf=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_ow)
_ip='Small'
_fd=true
_kc='Small'
[_ch,_cg]=switch _ml
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_ly,_lf]
var color _cd=color.new(color.black,100)
var float _cf=3.0
var float _dv=1.6
_il(string _wi)=>
	switch _wi
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fh(color _dl)=>
	_is=color.r(_dl)/255.0
	_iu=color.g(_dl)/255.0
	_jh=color.b(_dl)/255.0
	_tj=_is <=0.03928?_is/12.92:math.pow((_is+0.055)/1.055,2.4)
	_td=_iu <=0.03928?_iu/12.92:math.pow((_iu+0.055)/1.055,2.4)
	_tp=_jh <=0.03928?_jh/12.92:math.pow((_jh+0.055)/1.055,2.4)
	0.2126*_tj+0.7152*_td+0.0722*_tp
_ln(color _nt,color _mu)=>
	_ne=_fh(_nt)
	_ki=_fh(_mu)
	(math.max(_ne,_ki)+0.05)/(math.min(_ne,_ki)+0.05)
_eh(color _hm)=>
	_fh(_hm)> 0.179?#000000:#ffffff
_oh(color _dl,color _nl,float _sg)=>
	color.rgb(color.r(_dl)+(color.r(_nl)-color.r(_dl))*_sg,color.g(_dl)+(color.g(_nl)-color.g(_dl))*_sg,color.b(_dl)+(color.b(_nl)-color.b(_dl))*_sg)
_bm(color _dl,color _hm,float _pe)=>
	_nl=_eh(_hm)
	_lk=_dl
	for step=1 to 10
		if _ln(_lk,_hm)>=_pe
			break
		_lk:=_oh(_dl,_nl,step/10.0)
	_lk
_jg(float _xt)=>
	str.tostring(_xt,'#.##')+'%'
_re(array<box> _ju,int _mi,float _bf,float _al)=>
	array.clear(_ju)
	if not _ku
		for i=0 to _jx-1
			array.push(_ju,box.new(_mi,_bf,bar_index,_al,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gh(array<box> _ju,float _bf,float _al,int _mi,int _sh,color _pg)=>
	_pn=array.size(_ju)
	if _pn > 0 and _bf > _al
		_gt=(_bf-_al)/_pn
		for i=0 to _pn-1
			_hx=array.get(_ju,i)
			_pb=math.abs((i+0.5)/_pn-0.5)*2.0
			_ox=int(math.min(99,math.max(0,_gi+(1.0-_pb)*10)))
			box.set_lefttop(_hx,_mi,_bf-_gt*i)
			box.set_rightbottom(_hx,_sh,_bf-_gt*(i+1))
			box.set_bgcolor(_hx,color.new(_pg,_ox))
_oe(array<box> _ju)=>
	if array.size(_ju)> 0
		for i=0 to array.size(_ju)-1
			box.delete(array.get(_ju,i))
	array.clear(_ju)
_qv(int _rg,float _bf,float _al,float _cl)=>
	_yr=_rg
	if _hy=='Extend to containment'
		_yd=math.min(_ix,bar_index)
		_vp=math.max(2,math.round((1.0-_eo)*_rg))
		_lm=0
		_gy=0
		while _gy < _yd and _lm <=_vp
			_nm=close[_gy]<=_bf and close[_gy]>=_al
			_th=_nm and high[_gy]<=_bf+_cl and low[_gy]>=_al-_cl
			if _nm
				_lm:=math.max(0,_lm-1)
				if _th and _gy+1 >=_rg
					_yr:=_gy+1
			else
				_lm+=1
			_gy+=1
	_yr
_ci=ta.atr(_kg)
_kw=not na(_ci)and _ci > 0
_gl=_mj=='Wick beyond'
_kx=_og=='Wick reaches'
_op=_mb=='Live bar'
_fq=_op or barstate.isconfirmed
_gq=_il(_ip)
_lc=_il(_kc)
_w=chart.bg_color
_s=_bm(_fj,_w,_cf)
_ge=_bm(_ch,_w,_cf)
_fu=_bm(_cg,_w,_cf)
_hk=_bm(_fj,_w,_dv)
_gd=_bm(_ch,_w,_dv)
_fn=_bm(_cg,_w,_dv)
_gp(simple int len)=>
	_vh=ta.percentile_linear_interpolation(high,len,_er)
	_qo=ta.percentile_linear_interpolation(low,len,100.0-_er)
	_vq=ta.highest(high,len)
	_rc=ta.lowest(low,len)
	_ts=ta.highest(math.max(open,close),len)
	_nv=ta.lowest(math.min(open,close),len)
	top=_bp=='Absolute extremes'?_vq:_bp=='Body extremes'?_ts:_vh
	_kq=_bp=='Absolute extremes'?_rc:_bp=='Body extremes'?_nv:_qo
	_du=top-_kq
	_oo=_kw and _du > 0?_du/(_ci*math.sqrt(len)):99.0
	_tb=bar_index < 1?_ee:int(math.max(1,math.min(_ee,bar_index-_kg)))
	_yg=ta.percentrank(_oo,_tb)
	_xw=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_yc=_du > 0?math.abs(_xw)*len/_du:99.0
	_cw=math.avg(top,_kq)
	_cl=_en*nz(_ci)
	_ns=0
	_pw=0
	_jr=0
	_nb=0
	for i=0 to len-1
		if(close[i]> _cw)!=(close[i+1]> _cw)
			_ns+=1
		_ou=_kx?high[i]>=top-_cl:close[i]>=top-_cl
		_jt=_kx?low[i]<=_kq+_cl:close[i]<=_kq+_cl
		if _ou
			_pw+=1
		if _jt
			_jr+=1
		if close[i]<=top and close[i]>=_kq
			_nb+=1
	_nx=_nb/float(len)
	_jm=_kw and not na(_yg)and bar_index > len+5 and _yg <=_je and _ns >=math.max(3,math.round(_mp*len))and _pw >=_if and _jr >=_if and _yc <=_rp and _nx >=_eo
	[_jm,top,_kq]
bool _jd=false
bool _ia=false
bool _jn=false
float _wf=na
float _wd=na
float _xm=na
float _qe=na
float _qm=na
float _qa=na
if _bb
	[qa,ta_,ba]=_gp(_bn)
	_jd:=qa
	_wf:=ta_
	_qe:=ba
	if _cr !='Base only'
		[qb,tb,bb]=_gp(_bn*2)
		_ia:=qb
		_wd:=tb
		_qm:=bb
	if _cr=='Base + 2x + 3x'
		[qc,tc,bc]=_gp(_bn*3)
		_jn:=qc
		_xm:=tc
		_qa:=bc
_ew=_cr !='Base only' and _ia
_ez=_cr=='Base + 2x + 3x' and _jn
_jm=_jd or _ew or _ez
_nw=_ez?_bn*3:_ew?_bn*2:_bn
_pj=_ez?_xm:_ew?_wd:_wf
_jq=_ez?_qa:_ew?_qm:_qe
var array<box> _at=array.new<box>()
var box _v=na
var line _g=na
var line _l=na
var line _y=na
var label _z=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _ha=na
var bool _t=false
var bool _m=false
var bool _ba=false
var int _dq=na
var int _q=0
var float _p=na
var int _ay=na
var int _aw=0
_bz=false
_cq=false
_bk=false
_ca=false
if _fq and _aw > 0
	_aw-=1
if _fq and not _t and not _ba and _aw <=0 and _jm
	_oy=_qv(_nw,_pj,_jq,_en*_ci)
	_c:=bar_index-_oy+1
	_ha:=bar_index
	_f:=_pj
	_a:=_jq
	_t:=true
	_m:=false
	_cw=math.avg(_f,_a)
	_bv=_a+(_f-_a)*0.25
	_ax=_a+(_f-_a)*0.75
	_v:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_re(_at,_c,_f,_a)
	if _hb
		_g:=line.new(_c,_cw,bar_index,_cw,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _ke
		_l:=line.new(_c,_bv,bar_index,_bv,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_y:=line.new(_c,_ax,bar_index,_ax,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hi
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cd,style=label.style_label_down,textcolor=color.new(_s,10),size=_gq)
	_bz:=true
if _t and _fq
	_cv=_js*_ci
	_fx=_mk*_ci
	if _he and not _gl and close <=_f and close >=_a
		if high > _f and high <=_f+_fx
			_f:=high
		if low < _a and low >=_a-_fx
			_a:=low
	_pv=_gl?high > _f+_cv:close > _f+_cv
	_kn=_gl?low < _a-_cv:close < _a-_cv
	_qx=_fo > 0 and bar_index-_ha+1 >=_fo
	if _pv or _kn or _qx
		_b=_pv?1:_kn?-1:0
		_rr=_b !=0?bar_index-_c:bar_index-_c+1
		_nf=_a !=0?(_f-_a)/_a*100.0:0.0
		_jw=_hj and _b !=0 and _m
		if _m
			_fi=_b==1?_ge:_b==-1?_fu:_s
			_oc=_b==1?_gd:_b==-1?_fn:_hk
			_ji=_b==1?_ch:_b==-1?_cg:_fj
			box.set_lefttop(_v,_c,_f)
			box.set_rightbottom(_v,bar_index,_a)
			box.set_border_color(_v,color.new(_fi,30))
			box.set_border_style(_v,line.style_dotted)
			_gh(_at,_f,_a,_c,bar_index,na)
			_bl.push(Rango.new(_c,bar_index,_f,_a,_oc))
			if _bl.size()> 8
				_bl.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_l)
				line.set_x2(_l,bar_index)
				line.set_x2(_y,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_rr)+' BARS   '+_jg(_nf))
				label.set_textcolor(_z,color.new(_fi,10))
			if _ka and _b !=0
				_pd=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fd
