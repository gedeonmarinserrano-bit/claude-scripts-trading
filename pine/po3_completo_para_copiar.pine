int _ru=na
float _qh=na
float _pp=na
int _sj=na
int _sl=na
if _pg and _be
	[h_,l_,hb_,lb_]=request.security(_qk,timeframe.period,_st(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_px:=h_
	_pl:=l_
	_rp:=hb_
	_ru:=lb_
if _nz and _be
	[h_,l_,hb_,lb_]=request.security(_pj,timeframe.period,_st(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_qh:=h_
	_pp:=l_
	_sj:=hb_
	_sl:=lb_
_mv=ta.pivothigh(high,_gk,_gk)
_nm=ta.pivotlow(low,_gk,_gk)
_qt=bar_index-_gk
var int _hl=na
var float _ge=na
var float _ib=na
var float _jl=na
var int _hm=na
var float _fw=na
var float _hw=na
var float _ig=na
var array<line> _gp=array.new<line>()
var array<label> _gi=array.new<label>()
_dv(float y,float _up,float c,float _ne,bool _oa)=>
	_vi=_oa?y > _up:y < _up
	_vx=_oa?c > _ne:c < _ne
	not na(_up)and not na(_ne)and not na(c)and _vi !=_vx
_fo(string t,float c,float _ne)=>
	t+(c > _ne?" ↑":c < _ne?" ↓":" =")
_kk(int x1,float y1,int xv,string txt,color col,bool _oa)=>
	yv=_oa?high[bar_index-xv]:low[bar_index-xv]
	if _rl
		_gp.push(line.new(x1,y1,xv,yv,color=col))
	if _lt
		_gi.push(label.new(xv,yv,txt,style=_oa?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_oa?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_oa?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gp.size()> _rn
		_gp.shift().delete()
	if _gi.size()> _rn
		_gi.shift().delete()
var int _ck=na
var int _dq=0
_ie=false
_ip=false
if barstate.isconfirmed
	if not na(_mv)
		_rr=not na(_hl)and _qt-_hl <=_qg
		d1=_rr and _pg and _dv(_mv,_ge,_px,_ib,true)
