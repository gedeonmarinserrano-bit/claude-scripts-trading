type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gp(Zona z,float hi,float lo)=>
	_fh=z.dir==1?lo <=z._ah:hi >=z._ag
	if not _fh
		_bi=na(z._bi)?(z.dir==1?z._ag:z._ah):z._bi
		if z.dir==1?lo < _bi:hi > _bi
			z._bi:=z.dir==1?lo:hi
	_fh
_bx(array<Zona> fvg,array<Zona> _tp,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xs,float _rx)=>
	_tq=false
	if ah.size()> 0
		_fb=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tp
				n=s.n-z._sa
				if not z._ln and n >=1 and n <=_gt and h1 >=z._ah and l1 <=z._ag
					if k <=_fb
						z._ln:=true
					_tq:=true
			if k <=_fb
				if _tp.size()> 0
					for i=_tp.size()-1 to 0
						if _gp(_tp.get(i),h1,l1)
							_tp.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ag and c1 < z._ah):(o1 <=z._ah and c1 > z._ag))
						if inv
							fvg.remove(i)
							_tp.push(Zona.new(z.x1,z._ag,z._ah,-z.dir,na,s.n))
							if _tp.size()> _xs
								_tp.shift()
						else if _gp(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rx
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rx
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xs
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_tq
