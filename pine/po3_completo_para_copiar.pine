	if _aq and not _m and _hx < 14400
		_kd:=_bo(_kf,_me)
		if _mz
			[_yh,_vu,_sq,_tc,_ti,_sm,_yc]=request.security(syminfo.tickerid,"240",_ma(),lookahead=barmerge.lookahead_on)
			if _yh
				_by(_kf,_sq,_tc,1,_yc,240)
