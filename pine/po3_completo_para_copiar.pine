_ln=input.int(35,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=120,group=_cv)
_pi=input.float(1.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cv)
_oi="Estructura (CHoCH / BOS)"
_bx=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_oi)
_sg=1.1
_ug=2.0
_tn=20
_sj=2
_mc=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oi)
_it=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oi)
_ij=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oi)
_ic=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oi)
_dx=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oi)
_qh=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oi)
_bj=bar_index >=last_bar_index-_qh
_ey=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mu=input.int(20,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_aj=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_ua="Order Blocks"
_ko=input.bool(true,"Mostrar Order Blocks",group=_ua)
_fp=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_ua)
_mr=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_ua)
_wh=input.int(10,"Máx. Order Blocks vigentes",minval=1,maxval=50,group=_ua)
_ma=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_ua)
_jx=input.color(#1565C0,"OB alcista (demanda)",group=_ua)
_kq=input.color(#EF6C00,"OB bajista (oferta)",group=_ua)
_rw="Estrategia NY (Bias + PO3)"
