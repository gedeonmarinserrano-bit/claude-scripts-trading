_ov="Estructura (CHoCH / BOS)"
_cc=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_ov)
_sx=1.1
_vt=2.0
_uw=20
_tq=2
_nq=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_ov)
_jb=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_ov)
_hv=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_ov)
_hw=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_ov)
_ef=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_ov)
_rd=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_ov)
_bb=bar_index >=last_bar_index-_rd
_cm=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_na=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_am=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
