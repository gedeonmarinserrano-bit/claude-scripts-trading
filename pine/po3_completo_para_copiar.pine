type NivelSes
	line ln
	label lb
	float _aa
	int _th=na
	int k=0
	int _wq=na
var array<NivelSes> _eg=array.new<NivelSes>(6)
var array<NivelSes> _o=array.new<NivelSes>()
_es(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_dh(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_se=(dir==1?"Máx. ":"Mín. ")+ses
	o=_eg.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _o.size()> 0
			for i=_o.size()-1 to 0
				q=_o.get(i)
				if q.k==k
					_o.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_es(bar_index,v,_se,col)
		_eg.set(k,NivelSes.new(ln,lb,v,na,k,bar_index))
	else if not na(o)
		if en and not na(o.ln)
			o._aa:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if na(o.ln)
			if dir==1?high > o._aa:low < o._aa
				o._aa:=dir==1?high:low
				o._wq:=bar_index
			if bar_index-o._th >=5
				dup=false
				for j=0 to 5
					p=_eg.get(j)
					if j !=k and not na(p)and not na(p.ln)and math.abs(p._aa-o._aa)<=0.1*nz(_ck)
						dup:=true
				if dup
					_eg.set(k,na)
				else
					[ln,lb]=_es(o._wq,o._aa,_se,col)
					o.ln:=ln
					o.lb:=lb
					o.lb.set_xy(bar_index,o._aa)
		else if dir==1?high > o._aa:low < o._aa
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._aa)
			o.lb.set_text((dir==1?"Máx. manip. ":"Mín. manip. ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			_o.push(o)
			if _o.size()> 24
				q=_o.shift()
				q.ln.delete()
				q.lb.delete()
			_eg.set(k,NivelSes.new(na,na,dir==1?high:low,bar_index,k,bar_index))
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._aa)
_lr=timeframe.change("D")
if _no and _hr and _be
	if _lr
		for k=0 to 5
			o=_eg.get(k)
			if not na(o)and not na(o.ln)
				o.ln.delete()
				o.lb.delete()
			_eg.set(k,na)
		for q in _o
			q.ln.delete()
			q.lb.delete()
