			_ep.push(label.new(bar_index,_vz?high:low,"Barrido "+nom,style=_vz?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _ep.size()> 20
				_ep.shift().delete()
type Igual
	line ln
