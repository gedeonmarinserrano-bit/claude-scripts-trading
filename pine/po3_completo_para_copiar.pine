_ke=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_qg)
_tu="Colores FVG"
_ao=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_tu)
_an=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_tu)
_ra=_ao
_mf=_ao
_nd=_ao
_ko=_ao
_ki=_ao
_in=_ao
_rh=_an
_nj=_an
_ng=_an
_kd=_an
_kk=_an
_ic=_an
_jy=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qg)
_qx=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qg)
_kw=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qg)
_ju=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_qg)
_qw=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_qg)
_la=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_qg)
_kv=input.color(#8D6E63,"Color niveles H1",group=_qg)
_qj=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qg)
_dx=input.color(#424242,"Color niveles clave",group=_qg)
_mh=input.color(#757575,"Color horas",group=_qg)
_ek=input.bool(true,"Mostrar EMAs",group="EMAs")
_nx=input.int(9,"EMA rápida",minval=1,group="EMAs")
_oo=input.int(20,"EMA media",minval=1,group="EMAs")
_nn=input.int(200,"EMA lenta",minval=1,group="EMAs")
_no=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_oj=input.color(#9E9D24,"Color EMA media",group="EMAs")
_oz=input.color(color.black,"Color EMA lenta",group="EMAs")
_il=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hn=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_gb=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kr=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ur=14
_rp=50
_ti=0.15
_qh=2.5
_qv=30
_pg=1.0
_lx=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_os="Colores"
_z=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_os)
_s=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_os)
_my=input.bool(true,"Marcar la vela del OB",group=_os)
_hi=input.color(#FF00C8,"IFVG (magenta)",group=_os)
_mq=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_os)
_kf=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_os)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _bi=na
	int _si=na
	bool _li=false
var _hf=array.new<Zona>()
var _hp=array.new<Zona>()
var obs=array.new<Zona>()
var _xm=array.new<Zona>()
var _vk=array.new<Zona>()
var _qq=array.new<Zona>()
var _qp=array.new<Zona>()
var _kx=array.new<Zona>()
var _we=array.new<Zona>()
var _tb=array.new<Zona>()
var _pw=array.new<Zona>()
var _pd=array.new<Zona>()
var _me=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bj=array.new<Rango>()
_ev(Zona z)=>
	_fq=z.dir==1?low <=z._ah:high >=z._ag
	if not _fq
		_bi=na(z._bi)?(z.dir==1?z._ag:z._ah):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fq
type Marca
	label lb
	line ln
	int bar
var _it=array.new<Marca>()
var array<string> _fc=array.from("")
var array<int> _ex=array.from(0)
_am(label lb,line ln,int bar)=>
	_it.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fc.set(0,lb.get_text())
		_ex.set(0,bar)
	if _it.size()> 500
		_it.shift()
_qs=ta.ema(close,_nx)
_qz=ta.ema(close,_oo)
_jh=ta.ema(close,_nn)
_dd=ta.atr(_ur)
var string _tt='════════ Detection ════════'
var string _rv='════════ Structure Filters ════════'
var string _ua='════════ Range Behavior ════════'
var string _ty='════════ Visual Settings ════════'
_cr='Base + 2x + 3x'
_on='Rangos'
_bn=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_on)
_bs='Percentile band'
_ed=90.0
_lu='Bar close'
_kc=200
_ih=40.0
_ee=500
_na=0.18
_pa='Wick reaches'
_ig=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_on)
_em=0.10
_se=0.45
_ej=0.70
_ip='Extend to containment'
_ie=300
_jx=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_on)
_ha=true
_lz=0.25
_ly='Close beyond'
_jd=0.15
_gy=true
_he=10
_lk=3
_fj=0
_ni='Custom'
_lw=#00A651
_lo=#E4002B
_fg=input.color(#F9A825,'Color del rango (neutral)',group=_on)
_jt=4
_gc=93
_hd=true
_jp=true
_hc=input.bool(true,'Mostrar etiqueta del rango',group=_on)
_jw=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_on)
_hu=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_on)
_iz='Small'
_fa=true
_jq='Small'
[_cg,_ch]=switch _ni
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lw,_lo]
var color _cb=color.new(color.black,100)
var float _cf=3.0
var float _dt=1.6
_jj(string _vs)=>
	switch _vs
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ff(color _di)=>
	_jo=color.r(_di)/255.0
	_hr=color.g(_di)/255.0
	_je=color.b(_di)/255.0
	_sv=_jo <=0.03928?_jo/12.92:math.pow((_jo+0.055)/1.055,2.4)
	_tk=_hr <=0.03928?_hr/12.92:math.pow((_hr+0.055)/1.055,2.4)
	_so=_je <=0.03928?_je/12.92:math.pow((_je+0.055)/1.055,2.4)
	0.2126*_sv+0.7152*_tk+0.0722*_so
_lv(color _ob,color _mz)=>
	_ms=_ff(_ob)
	_ks=_ff(_mz)
	(math.max(_ms,_ks)+0.05)/(math.min(_ms,_ks)+0.05)
_ec(color _hj)=>
	_ff(_hj)> 0.179?#000000:#ffffff
_oh(color _di,color _ne,float _sc)=>
	color.rgb(color.r(_di)+(color.r(_ne)-color.r(_di))*_sc,color.g(_di)+(color.g(_ne)-color.g(_di))*_sc,color.b(_di)+(color.b(_ne)-color.b(_di))*_sc)
_bl(color _di,color _hj,float _oq)=>
	_ne=_ec(_hj)
	_ls=_di
	for step=1 to 10
		if _lv(_ls,_hj)>=_oq
			break
		_ls:=_oh(_di,_ne,step/10.0)
	_ls
_jg(float _xd)=>
	str.tostring(_xd,'#.##')+'%'
_qt(array<box> _jz,int _lh,float _aw,float _ak)=>
	array.clear(_jz)
	if not _kf
		for i=0 to _jt-1
			array.push(_jz,box.new(_lh,_aw,bar_index,_ak,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gk(array<box> _jz,float _aw,float _ak,int _lh,int _rg,color _oa)=>
	_qd=array.size(_jz)
	if _qd > 0 and _aw > _ak
		_gp=(_aw-_ak)/_qd
		for i=0 to _qd-1
			_hv=array.get(_jz,i)
			_ox=math.abs((i+0.5)/_qd-0.5)*2.0
			_or=int(math.min(99,math.max(0,_gc+(1.0-_ox)*10)))
			box.set_lefttop(_hv,_lh,_aw-_gp*i)
			box.set_rightbottom(_hv,_rg,_aw-_gp*(i+1))
			box.set_bgcolor(_hv,color.new(_oa,_or))
_ny(array<box> _jz)=>
	if array.size(_jz)> 0
		for i=0 to array.size(_jz)-1
			box.delete(array.get(_jz,i))
	array.clear(_jz)
_qo(int _rb,float _aw,float _ak,float _cl)=>
	_xz=_rb
	if _ip=='Extend to containment'
		_xl=math.min(_ie,bar_index)
		_vc=math.max(2,math.round((1.0-_ej)*_rb))
		_lc=0
		_gq=0
		while _gq < _xl and _lc <=_vc
			_mx=close[_gq]<=_aw and close[_gq]>=_ak
			_st=_mx and high[_gq]<=_aw+_cl and low[_gq]>=_ak-_cl
			if _mx
				_lc:=math.max(0,_lc-1)
				if _st and _gq+1 >=_rb
					_xz:=_gq+1
			else
				_lc+=1
			_gq+=1
	_xz
_ck=ta.atr(_kc)
_kg=not na(_ck)and _ck > 0
_gi=_ly=='Wick beyond'
_kz=_pa=='Wick reaches'
_oy=_lu=='Live bar'
_fn=_oy or barstate.isconfirmed
_gl=_jj(_iz)
_kl=_jj(_jq)
_x=chart.bg_color
_r=_bl(_fg,_x,_cf)
_fl=_bl(_cg,_x,_cf)
_ga=_bl(_ch,_x,_cf)
_gz=_bl(_fg,_x,_dt)
_fu=_bl(_cg,_x,_dt)
_fi=_bl(_ch,_x,_dt)
_gf(simple int len)=>
	_uj=ta.percentile_linear_interpolation(high,len,_ed)
	_qr=ta.percentile_linear_interpolation(low,len,100.0-_ed)
	_ut=ta.highest(high,len)
	_qk=ta.lowest(low,len)
	_td=ta.highest(math.max(open,close),len)
	_nu=ta.lowest(math.min(open,close),len)
	top=_bs=='Absolute extremes'?_ut:_bs=='Body extremes'?_td:_uj
	_kj=_bs=='Absolute extremes'?_qk:_bs=='Body extremes'?_nu:_qr
	_du=top-_kj
	_om=_kg and _du > 0?_du/(_ck*math.sqrt(len)):99.0
	_sz=bar_index < 1?_ee:int(math.max(1,math.min(_ee,bar_index-_kc)))
	_xq=ta.percentrank(_om,_sz)
	_xo=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xh=_du > 0?math.abs(_xo)*len/_du:99.0
	_cu=math.avg(top,_kj)
	_cl=_em*nz(_ck)
	_nk=0
	_px=0
	_id=0
	_mm=0
	for i=0 to len-1
		if(close[i]> _cu)!=(close[i+1]> _cu)
			_nk+=1
		_nv=_kz?high[i]>=top-_cl:close[i]>=top-_cl
		_ka=_kz?low[i]<=_kj+_cl:close[i]<=_kj+_cl
		if _nv
			_px+=1
		if _ka
			_id+=1
		if close[i]<=top and close[i]>=_kj
			_mm+=1
	_ow=_mm/float(len)
	_ij=_kg and not na(_xq)and bar_index > len+5 and _xq <=_ih and _nk >=math.max(3,math.round(_na*len))and _px >=_ig and _id >=_ig and _xh <=_se and _ow >=_ej
	[_ij,top,_kj]
bool _ia=false
bool _ii=false
bool _io=false
float _ws=na
float _vo=na
float _wo=na
float _pe=na
float _qa=na
float _pj=na
if _az
	[qa,ta_,ba]=_gf(_bn)
	_ia:=qa
	_ws:=ta_
	_pe:=ba
	if _cr !='Base only'
		[qb,tb,bb]=_gf(_bn*2)
		_ii:=qb
		_vo:=tb
		_qa:=bb
	if _cr=='Base + 2x + 3x'
		[qc,tc,bc]=_gf(_bn*3)
		_io:=qc
		_wo:=tc
		_pj:=bc
_eu=_cr !='Base only' and _ii
_eq=_cr=='Base + 2x + 3x' and _io
_ij=_ia or _eu or _eq
_oe=_eq?_bn*3:_eu?_bn*2:_bn
_pk=_eq?_wo:_eu?_vo:_ws
_jk=_eq?_pj:_eu?_qa:_pe
var array<box> _at=array.new<box>()
var box _t=na
var line _g=na
var line _k=na
var line _w=na
var label _y=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gn=na
var bool _u=false
var bool _m=false
var bool _bb=false
var int _dp=na
var int _p=0
var float _o=na
var int _bc=na
var int _bh=0
_cd=false
_co=false
_bk=false
_bz=false
if _fn and _bh > 0
	_bh-=1
if _fn and not _u and not _bb and _bh <=0 and _ij
	_ov=_qo(_oe,_pk,_jk,_em*_ck)
	_c:=bar_index-_ov+1
	_gn:=bar_index
	_f:=_pk
	_a:=_jk
	_u:=true
	_m:=false
	_cu=math.avg(_f,_a)
	_bw=_a+(_f-_a)*0.25
	_ay=_a+(_f-_a)*0.75
	_t:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qt(_at,_c,_f,_a)
	if _hd
		_g:=line.new(_c,_cu,bar_index,_cu,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jp
		_k:=line.new(_c,_bw,bar_index,_bw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_ay,bar_index,_ay,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hc
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cb,style=label.style_label_down,textcolor=color.new(_r,10),size=_gl)
	_cd:=true
if _u and _fn
	_cq=_jd*_ck
	_fx=_lz*_ck
	if _ha and not _gi and close <=_f and close >=_a
		if high > _f and high <=_f+_fx
			_f:=high
		if low < _a and low >=_a-_fx
			_a:=low
	_pf=_gi?high > _f+_cq:close > _f+_cq
	_kt=_gi?low < _a-_cq:close < _a-_cq
	_qu=_fj > 0 and bar_index-_gn+1 >=_fj
	if _pf or _kt or _qu
		_b=_pf?1:_kt?-1:0
		_sg=_b !=0?bar_index-_c:bar_index-_c+1
		_mj=_a !=0?(_f-_a)/_a*100.0:0.0
		_jr=_gy and _b !=0 and _m
		if _m
			_fe=_b==1?_fl:_b==-1?_ga:_r
			_ot=_b==1?_fu:_b==-1?_fi:_gz
			_ho=_b==1?_cg:_b==-1?_ch:_fg
			box.set_lefttop(_t,_c,_f)
			box.set_rightbottom(_t,bar_index,_a)
			box.set_border_color(_t,color.new(_fe,30))
			box.set_border_style(_t,line.style_dotted)
			_gk(_at,_f,_a,_c,bar_index,na)
			_bj.push(Rango.new(_c,bar_index,_f,_a,_ot))
			if _bj.size()> 8
				_bj.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_sg)+' BARS   '+_jg(_mj))
				label.set_textcolor(_y,color.new(_fe,10))
			if _jw and _b !=0
				_np=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fa
