_gs="SMT (divergencias entre índices)"
_do=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_gs)
_lu=input.bool(true,"Mostrar etiquetas de la SMT",group=_gs)
_qt=input.bool(true,"Mostrar línea de la SMT",group=_gs)
_sk=input.bool(true,"Comparar con",inline="smt1",group=_gs)
_ph=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_gs)
_so=input.bool(true,"Comparar con",inline="smt2",group=_gs)
_pk=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_gs)
_fv=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_gs)
_pg=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_gs)
_qr=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_gs)
_hp=input.color(#ff1100,"SMT bajista (en altos)",group=_gs)
_ip=input.color(#2157f3,"SMT alcista (en bajos)",group=_gs)
_kn(string s)=>
	_th=str.split(s,":")
	_th.size()> 0?_th.last():s
_qs=_kn(_ph)
_rn=_kn(_pk)
_vi=str.replace(_qs,"1!","")
_vx=str.replace(_rn,"1!","")
_ti=str.replace(syminfo.ticker,"1!","")
_op=_do and _sk and _vi !=_ti
_nm=_do and _so and _vx !=_ti
_qu()=>
	w=2*_fv+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _os=na
float _ot=na
int _rp=na
int _ql=na
float _ou=na
float _pu=na
int _qw=na
int _rm=na
if _op and _bf
	[h_,l_,hb_,lb_]=request.security(_ph,timeframe.period,_qu(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_os:=h_
	_ot:=l_
	_rp:=hb_
	_ql:=lb_
if _nm and _bf
	[h_,l_,hb_,lb_]=request.security(_pk,timeframe.period,_qu(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_ou:=h_
	_pu:=l_
	_qw:=hb_
	_rm:=lb_
_ml=ta.pivothigh(high,_fv,_fv)
_mk=ta.pivotlow(low,_fv,_fv)
_qe=bar_index-_fv
var int _hb=na
var float _fm=na
var float _jf=na
var float _im=na
var int _hf=na
var float _fq=na
var float _in=na
var float _iw=na
var array<line> _gf=array.new<line>()
var array<label> _ge=array.new<label>()
_dn(float y,float _tx,float c,float _ma,bool _nl)=>
	_uo=_nl?y > _tx:y < _tx
	_ua=_nl?c > _ma:c < _ma
	not na(_tx)and not na(_ma)and not na(c)and _uo !=_ua
_fc(string t,float c,float _ma)=>
	t+(c > _ma?" ↑":c < _ma?" ↓":" =")
_kf(int x1,float y1,int xv,string txt,color col,bool _nl)=>
	yv=_nl?high[bar_index-xv]:low[bar_index-xv]
	if _qt
		_gf.push(line.new(x1,y1,xv,yv,color=col))
	if _lu
		_ge.push(label.new(xv,yv,txt,style=_nl?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_nl?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_nl?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gf.size()> _qr
		_gf.shift().delete()
	if _ge.size()> _qr
		_ge.shift().delete()
var int _cj=na
var int _dm=0
_hj=false
_jd=false
if barstate.isconfirmed
	if not na(_ml)
		_rl=not na(_hb)and _qe-_hb <=_pg
		d1=_rl and _op and _dn(_ml,_fm,_os,_jf,true)
		d2=_rl and _nm and _dn(_ml,_fm,_ou,_im,true)
		if d1 or d2
			_hj:=true
			_cj:=bar_index
			_dm:=-1
			_hy=_ml > _fm
			xv=_hy?_qe:bar_index+int(d1?_rp:_qw)
			t1=_fc(_qs,_os,_jf)
			t2=_fc(_rn,_ou,_im)
			_kf(_hb,_fm,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_hp,true)
		_hb:=_qe
		_fm:=_ml
		_jf:=_os
		_im:=_ou
	if not na(_mk)
		_rl=not na(_hf)and _qe-_hf <=_pg
		d1=_rl and _op and _dn(_mk,_fq,_ot,_in,false)
		d2=_rl and _nm and _dn(_mk,_fq,_pu,_iw,false)
		if d1 or d2
			_jd:=true
			_cj:=bar_index
			_dm:=1
			_hy=_mk < _fq
			xv=_hy?_qe:bar_index+int(d1?_ql:_rm)
			t1=_fc(_qs,_ot,_in)
			t2=_fc(_rn,_pu,_iw)
			_kf(_hf,_fq,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ip,false)
		_hf:=_qe
		_fq:=_mk
		_in:=_ot
		_iw:=_pu
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _eb=array.new<box>()
var array<line> _dd=array.new<line>()
var array<label> _bs=array.new<label>()
var array<int> uso=array.from(0,0,0)
_px(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eb.size()
		b=_eb.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eb.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_ne(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dd.size()
		l=_dd.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dd.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lt(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bs.size()
		e=_bs.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bs.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _wt
	bool _rh
var array<Letrero> _fs=array.new<Letrero>()
_oa=nz(ta.atr(50))*0.5
_ut=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_nj)
_ei=nz(ta.atr(50))*_ut/100
var array<Pieza> _gc=array.new<Pieza>()
_vp(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pb(Pieza p)=>
	res=array.from(p)
	if _kb and _gc.size()> 0
		for o in _gc
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wj=array.new<Pieza>()
				for q in res
					for r in _vp(q,o)
						_wj.push(r)
				res:=_wj
				if res.size()==0 or res.size()> 10
					break
	res
_gk(Pieza p,color col,int dir)=>
	for q in _pb(p)
		top=q.top
		bot=q.bot
		if _ei > 0 and dir !=0
			for o in _gc
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ei
						top:=math.min(top,o.bot-_ei)
					if math.abs(bot-o.top)<=_ei
						bot:=math.max(bot,o.top+_ei)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_px(q.x1,top,q.x2,bot,col)
_md(int _tw,int x2,float _af,float _ag,int dir,float _be,color col,string txt,color _ve,color _pl,color _oc,bool _rh)=>
	x1=math.max(_tw,bar_index-1000)
	_xe=na(_be)?_af:(dir==1?_be:_af)
	_xh=na(_be)?_ag:(dir==1?_ag:_be)
	_gk(Pieza.new(x1,x2,_xe,_xh),col,dir)
	if not na(_be)
		_gk(Pieza.new(x1,x2,dir==1?_af:_be,dir==1?_be:_ag),_oc,dir)
	if txt !="" and _fs.size()< 60
		_fs.push(Letrero.new(x2,(_xe+_xh)/2,txt,_ve,true,_rh))
	if not na(_pl)
		m=(_af+_ag)/2
		for q in _pb(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_ne(q.x1,q.x2,m,_pl)
	_gc.push(Pieza.new(x1,x2,_af,_ag,dir))
_bb(array<Zona> arr,color _wm,color _wn,int _tl,string txt,bool _xd,bool _sw,color _oc,bool _rh)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_wm:_wn
			t=txt
			_xv=z._ag > close?z._ag-close:close > z._af?close-z._af:0.0
			if uso.get(0)< 440 and _gc.size()< _lh and(_pt==0 or _xv/close*100 <=_pt)
				_md(z.x1,bar_index+1,z._af,z._ag,z.dir,z._be,color.new(c,_mt),t,c,_sw?color.new(color.white,30):na,_oc,_rh)
_at()=>
	if _pd
		_bb(_id,_hd,_hd,88,"IFVG "+_dh,true,false,_ah,false)
		_bb(_gt,_se,_su,80,"FVG "+_dh,true,false,_ah,true)
	_bb(obs,_ju,_jz,90,"OB "+_dh,true,false,_ah,false)
_da(bool ver,int _uv,array<Zona> f,array<Zona> fi,color ca,color cb,int _tl,string nom)=>
	if ver and not _m and _d !=_uv*60
		_bb(fi,_hd,_hd,88,"IFVG "+nom,true,false,_ah,false)
		_bb(f,ca,cb,_tl,"FVG "+nom,true,_uv >=15,_ah,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fs.clear()
	_gc.clear()
	_ae=false
	if _d <=60
		_at()
		_ae:=true
	_da(_cr,1,_wy,_vh,_mn,_ly,84,"M1")
	if not _ae and _d <=300
		_at()
		_ae:=true
	_da(_bt,5,_ux,_sj,_lx,_mp,84,"M5")
	if not _ae and _d <=900
		_at()
		_ae:=true
	_da(_aw,15,_pv,_ow,_jv,_kj,84,"M15")
	if not _ae and _d <=3600
		_at()
		_ae:=true
	_da(_az,60,_qb,_pa,_ke,_ko,82,"H1")
	if not _ae and _d <=14400
		_at()
		_ae:=true
	_da(_ao,240,_kg,_kw,_is,_ht,80,"H4")
	if not _ae
		_at()
	if _fs.size()> 0
		_mx=array.new<Letrero>()
		for l in _fs
			x=l.x
			_ww=str.length(l.txt)+2
			for _wv=0 to 3
				_wl=false
				for c in _mx
					_ru=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _oa and x > c.x-_ru and x-_ww < c.x
						x:=c.x-_ru
						_wl:=true
				if not _wl
					break
			_mx.push(Letrero.new(x,l.y,l.txt,l.col,true,l._rh))
			_lt(x,l.y,l.txt,color.white)
	while _eb.size()> uso.get(0)
		_eb.pop().delete()
	while _dd.size()> uso.get(1)
		_dd.pop().delete()
	while _bs.size()> uso.get(2)
		_bs.pop().delete()
_ox()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bi(array<Zona> arr,string nom,bool _we)=>
	float _sa=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._be)?z._ag:z._be
		hi=z.dir==-1 or na(z._be)?z._af:z._be
		d=close >=lo and close <=hi?0.0:_we?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sa)or d < _sa)
			_sa:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sa,txt]
_pc(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_lc(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_ll(int b)=>
	b==1?_aa:b==-1?_s:#757575
_wd(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wi(string n)=>
	str.contains(n,"alcista")?_aa:str.contains(n,"bajista")?_s:#757575
_qv(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _ee=na
if barstate.islast and _ln
	pos=_hl=="Arriba izquierda"?position.top_left:_hl=="Abajo derecha"?position.bottom_right:_hl=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_mb=="Muy pequeño"?size.tiny:_mb=="Normal"?size.normal:size.small
	if na(_ee)
		_ee:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ee.clear(0,0,1,13)
	int f=0
	int _vl=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_vl:=request.security(syminfo.tickerid,"240",_ox(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_ox(),lookahead=barmerge.lookahead_on)
	_pc(_ee,f,"Bias H4",_d < 14400?_lc(_vl):"(gráfico ≥ H4)",_ll(_vl),tam)
	f+=1
	_pc(_ee,f,"Bias H1",_d < 3600?_lc(b60):"(gráfico ≥ H1)",_ll(b60),tam)
	f+=1
	ev=_et.get(0)
	_wf=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_er.get(0))+" velas"
	_pc(_ee,f,"Estructura "+_dh,_lc(_i)+_wf,_ll(_i),tam)
	f+=1
	tz="America/New_York"
	_wk=hour(timenow,tz)*60+minute(timenow,tz)
	_xb=dayofweek(timenow,tz)
	_xl=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_xx=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_vg=_xb==dayofweek.saturday or _xb==dayofweek.sunday
	_ui=570-_wk
	ses=_vg?"Cerrada (fin de semana)":_wk < 570?"Abre a las "+str.format_time(_xl,"HH:mm","Europe/Madrid")+" (en "+(_ui >=60?str.tostring(int(_ui/60))+" h ":"")+str.tostring(_ui%60)+" min)":_wk < 960?"● Abierta (cierra "+str.format_time(_xx,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_xl,"HH:mm","Europe/Madrid")+")"
	_pc(_ee,f,"Sesión NY",ses,not _vg and _wk >=570 and _wk < 960?_aa:#424242,tam)
	f+=1
	float _rv=na
	string _wh=""
	float _rx=na
	string _vo=""
	if _pd
		[d1,t1]=_bi(_gt,"FVG "+_dh,true)
		[d2,t2]=_bi(_id,"IFVG "+_dh,true)
		[d3,t3]=_bi(_gt,"FVG "+_dh,false)
		[d4,t4]=_bi(_id,"IFVG "+_dh,false)
		if not na(d1)and(na(_rv)or d1 < _rv)
			_rv:=d1
			_wh:=t1
		if not na(d2)and(na(_rv)or d2 < _rv)
			_rv:=d2
			_wh:=t2
		if not na(d3)and(na(_rx)or d3 < _rx)
			_rx:=d3
			_vo:=t3
		if not na(d4)and(na(_rx)or d4 < _rx)
			_rx:=d4
			_vo:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_wy:k==1?_ux:k==2?_pv:k==3?_qb:_kg
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cr:k==1?_bt:k==2?_aw:k==3?_az:_ao
			if ver
				[da,ta_]=_bi(arr,nom,true)
				[db,tb]=_bi(arr,nom,false)
				if not na(da)and(na(_rv)or da < _rv)
					_rv:=da
					_wh:=ta_
				if not na(db)and(na(_rx)or db < _rx)
					_rx:=db
					_vo:=tb
	_pc(_ee,f,"FVG por arriba",_wd(_rv,_wh),_wi(_wh),tam)
	f+=1
	_pc(_ee,f,"FVG por abajo",_wd(_rx,_vo),_wi(_vo),tam)
	f+=1
	_uq=not _do?"(apagada)":na(_cj)?"Ninguna reciente":(_dm==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cj)+" velas"
	_pc(_ee,f,"SMT",_uq,not _do or na(_cj)?#757575:_dm==1?_ip:_hp,tam)
	f+=1
	if _od
		_nk=request.security(_ts,"D",close[1],lookahead=barmerge.lookahead_on)
		[_ma,_vn,_vu]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_nk/16
		pts=_ma*pct/100
		_si=pts > 0?(_vn-_vu)/pts*100:na
		_uh=na(_nk)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_nk,"#.#")+") · hoy "+str.tostring(_vn-_vu,"#")+" pts = "+str.tostring(_si,"#")+" %"
		_pc(_ee,f,"Mov. esperado",_uh,na(_si)?#757575:_si >=100?_s:_si >=75?#EF6C00:#424242,tam)
		f+=1
	if _kt and _mf
		_pc(_ee,f,"Asia",_qv(_gp,_hq,_ey,_iu,_ia),#5E35B1,tam)
		f+=1
		_pc(_ee,f,"Londres",_qv(_me,_no,_ie,_ms,_mh),#1E88E5,tam)
		f+=1
	if _oy or _fd
		[_vt,_ud,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _oy
			rng=d_h-d_l
			_lk=_ud > 0?rng/_ud*100:na
			_pc(_ee,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_ud,"#")+" pts ("+str.tostring(_lk,"#")+" %)",na(_lk)?#757575:_lk >=100?_s:_lk >=75?#EF6C00:#424242,tam)
			f+=1
		if _fd
			dif=close-_vt
			_pc(_ee,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_s:_aa,tam)
			f+=1
	if _kr
		float _uw=na
		string _vj=""
		float _uy=na
		string _wb=""
		_pf=array.from(pdh,pdl,_iu?na:_gp,_ia?na:_hq,_ms?na:_me,_mh?na:_no)
		_pr=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _ar
			_pf.push(nv._dw)
			_pr.push(nv.dir==1?"Alto H4":"Bajo H4")
		for q in _dp
			_pf.push(q._dw)
			_pr.push(q.dir==1?"EQH":"EQL")
		for i=0 to _pf.size()-1
			pv=_pf.get(i)
			if not na(pv)
				if pv > close and(na(_uw)or pv < _uw)
					_uw:=pv
					_vj:=_pr.get(i)
				if pv < close and(na(_uy)or pv > _uy)
					_uy:=pv
					_wb:=_pr.get(i)
		_ub=(na(_uw)?"↑ —":"↑ "+_vj+" "+str.tostring(_uw,format.mintick)+" (+"+str.tostring(_uw-close,format.mintick)+")")+"  ·  "+(na(_uy)?"↓ —":"↓ "+_wb+" "+str.tostring(_uy,format.mintick)+" (−"+str.tostring(close-_uy,format.mintick)+")")
		_pc(_ee,f,"Liquidez",_ub,#424242,tam)
		f+=1
	if _pq !=""
		_pc(_ee,f,"Noticias hoy",_pq,#EF6C00,tam)
		f+=1
alertcondition(_hj,"SMT bajista","SMT bajista (divergencia en altos entre índices) en {{ticker}} ({{interval}})")
alertcondition(_jd,"SMT alcista","SMT alcista (divergencia en bajos entre índices) en {{ticker}} ({{interval}})")
