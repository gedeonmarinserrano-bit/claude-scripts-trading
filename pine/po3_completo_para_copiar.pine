_in=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oq)
_ja=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oq)
_ee=input.bool(false,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oq)
_qx=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oq)
