	_mh:=_mh or low < _no
var array<bool> _z=array.new<bool>(6,false)
var array<label> _dy=array.new<label>()
if timeframe.change("D")
	_z.fill(false)
if _ey and not _ey[1]
	_z.set(2,false)
	_z.set(3,false)
if _ie and not _ie[1]
	_z.set(4,false)
	_z.set(5,false)
if _lr and _bh and _mf and _bf
	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_gp:k==3?_hq:k==4?_me:_no
