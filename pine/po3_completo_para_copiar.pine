	_qd(_ej,f,"Bias H4",_d < 14400?_md(_xh):"(gráfico ≥ H4)",_mc(_xh),tam)
	f+=1
	_qd(_ej,f,"Bias H1",_d < 3600?_md(b60):"(gráfico ≥ H1)",_mc(b60),tam)
	f+=1
	ev=_ff.get(0)
