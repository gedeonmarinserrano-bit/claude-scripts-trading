_eb(array<label> etq,bool _rt,int _tf,float sep)=>
	_ov=_tf
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xq=ys.sort_indices()
		_sy=array.new<float>()
		_rh=array.new<int>()
		_pa=array.new<int>()
		_us=timeframe.in_seconds()*1000
		for j in _xq
			e=etq.get(j)
			y=e.get_y()
			_rm=str.length(e.get_text())+2
			ini=_tf
			for _uy=0 to 6
				_ss=false
				if _sy.size()> 0
					for c=0 to _sy.size()-1
						if math.abs(_sy.get(c)-y)< sep and ini < _pa.get(c)and ini+_rm > _rh.get(c)
							ini:=_pa.get(c)
							_ss:=true
				if not _ss
					break
			_sy.push(y)
			_rh.push(ini)
			_pa.push(ini+_rm)
			_ov:=math.max(_ov,ini+_rm)
			if _rt
				e.set_x(time+ini*_us)
			else
				e.set_x(bar_index+ini)
	_ov
if barstate.islast
	_lu=array.new<label>()
	for o in _eh
		if not na(o)and not na(o.lb)
			_lu.push(o.lb)
	for q in _o
		q.ln.set_x2(bar_index)
		_lu.push(q.lb)
	_oy=array.new<label>()
	for n in _dg
		_oy.push(n.lb)
	for n in _de
		_oy.push(n.lb)
	_vg=_eb(_lu,false,1,_fj*0.35)
	_eb(_oy,true,_lu.size()> 0?_vg:1,_fj*0.35)
