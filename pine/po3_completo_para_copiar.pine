_xm=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_vh)
_ml=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_vh)
_lc=input.color(#1565C0,"OB alcista (demanda)",group=_vh)
_kv=input.color(#EF6C00,"OB bajista (oferta)",group=_vh)
_pt="Estrategia NY (Bias + PO3)"
