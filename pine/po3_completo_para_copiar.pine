type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gc(Zona z,float hi,float lo)=>
	_fg=z.dir==1?lo <=z._ac:hi >=z._ad
	if not _fg
		_bc=na(z._bc)?(z.dir==1?z._ad:z._ac):z._bc
		if z.dir==1?lo < _bc:hi > _bc
			z._bc:=z.dir==1?lo:hi
	_fg
_bq(array<Zona> fvg,array<Zona> _rq,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _vp,float _pv)=>
	_ro=false
	if ah.size()> 0
		_eh=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _rq
				n=s.n-z._po
				if not z._lb and n >=1 and n <=_gg and h1 >=z._ac and l1 <=z._ad
					if k <=_eh
						z._lb:=true
					_ro:=true
			if k <=_eh
				if _rq.size()> 0
					for i=_rq.size()-1 to 0
						if _gc(_rq.get(i),h1,l1)
							_rq.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bc)and(z.dir==1?(o1 >=z._ad and c1 < z._ac):(o1 <=z._ac and c1 > z._ad))
						if inv
							fvg.remove(i)
							_rq.push(Zona.new(z.x1,z._ad,z._ac,-z.dir,na,s.n))
							if _rq.size()> _vp
								_rq.shift()
						else if _gc(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_pv
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_pv
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _vp
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_ro
