_gy="SMT (divergencias entre índices)"
_dt=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_gy)
_lh=input.bool(true,"Mostrar etiquetas de la SMT",group=_gy)
_qu=input.bool(true,"Mostrar línea de la SMT",group=_gy)
_sv=input.bool(true,"Comparar con",inline="smt1",group=_gy)
_ps=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_gy)
_su=input.bool(true,"Comparar con",inline="smt2",group=_gy)
_pf=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_gy)
_ga=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_gy)
_pt=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_gy)
_ra=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_gy)
_in=input.color(#ff1100,"SMT bajista (en altos)",group=_gy)
_hp=input.color(#2157f3,"SMT alcista (en bajos)",group=_gy)
_ki(string s)=>
	_tl=str.split(s,":")
	_tl.size()> 0?_tl.last():s
_rs=_ki(_ps)
_rc=_ki(_pf)
_ws=str.replace(_rs,"1!","")
_wo=str.replace(_rc,"1!","")
_tf=str.replace(syminfo.ticker,"1!","")
_oj=_dt and _sv and _ws !=_tf
_nz=_dt and _su and _wo !=_tf
_qq()=>
	w=2*_ga+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _px=na
float _pb=na
int _rw=na
int _rj=na
float _pw=na
float _pe=na
int _rh=na
int _rd=na
if _oj and _ba
	[h_,l_,hb_,lb_]=request.security(_ps,timeframe.period,_qq(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
