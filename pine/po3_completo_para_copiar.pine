_ec(array<label> etq,array<line> lns,bool _sj,int _ww,float sep)=>
	_pk=_ww
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_yp=ys.sort_indices()
		_tt=array.new<float>()
		_so=array.new<int>()
		_oe=array.new<int>()
		_su=timeframe.in_seconds()*1000
		for j in _yp
			e=etq.get(j)
			y=e.get_y()
			_rm=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_ww
			for _we=0 to 6
				_rp=false
				if _tt.size()> 0
					for c=0 to _tt.size()-1
						if math.abs(_tt.get(c)-y)< sep and ini < _oe.get(c)and ini+_rm > _so.get(c)
							ini:=_oe.get(c)
							_rp:=true
				if not _rp
					break
			_tt.push(y)
			_so.push(ini)
			_oe.push(ini+_rm)
			_pk:=math.max(_pk,ini+_rm)
			if _sj
				e.set_x(time+ini*_su)
				lns.get(j).set_x2(time+ini*_su)
			else
				e.set_x(bar_index+ini)
				lns.get(j).set_x2(bar_index+ini)
	_pk
if barstate.islast
	_mq=array.new<label>()
	_pn=array.new<line>()
	for o in _gh
		if not na(o)and not na(o.lb)
			_mq.push(o.lb)
			_pn.push(o.ln)
	for q in _n
		_mq.push(q.lb)
		_pn.push(q.ln)
	_mf=array.new<label>()
	_mr=array.new<line>()
	for n in _de
		_mf.push(n.lb)
		_mr.push(n.ln)
	for n in _dd
		_mf.push(n.lb)
		_mr.push(n.ln)
	for k=0 to 3
		lb=k==0?_sb:k==1?_rs:k==2?_lu:_ht
		ln=k==0?_nb:k==1?_qi:k==2?_gr:_ew
		if not na(lb)and not na(ln)
			_mf.push(lb)
			_mr.push(ln)
	_vi=_ec(_mq,_pn,false,1,_ff*0.35)
	_ec(_mf,_mr,true,_mq.size()> 0?_vi:1,_ff*0.35)
