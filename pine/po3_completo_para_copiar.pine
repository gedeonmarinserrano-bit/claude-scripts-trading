			z=arr.get(i)
			_ti=(z._ah+z._ai)/2
			if low <=_ti and high >=_ti
				_vy:=true
			_ir=na(z._bi)and(z.dir==1?(open >=z._ah and close < z._ai):(open <=z._ai and close > z._ah))
			if _ir
				arr.remove(i)
				_dq.push(Zona.new(z.x1,z._ah,z._ai,-z.dir,na,bar_index))
