			_eq.push(label.new(bar_index,_wc?high:low,"Barrido "+nom,style=_wc?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _eq.size()> 20
				_eq.shift().delete()
type Igual
	line ln
	label lb
	float _ax
	int dir
var array<Igual> _dp=array.new<Igual>()
var float _tf=na
var int _qd=na
var float _tl=na
var int _pu=na
_ul=nz(_db)*0.1
_tt=ta.pivothigh(high,_cb,_cb)
_tp=ta.pivotlow(low,_cb,_cb)
if _ro and _az and timeframe.isintraday
	if not na(_tt)
