_wr=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_vc)
_no=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_vc)
_kw=input.color(#1565C0,"OB alcista (demanda)",group=_vc)
