_sp=1.1
_ue=2.0
_vc=20
_tb=2
_ms=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oh)
_hs=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oh)
_jg=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oh)
_ij=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oh)
_ec=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oh)
_qp=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oh)
_bc=bar_index >=last_bar_index-_qp
_ci=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mv=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
