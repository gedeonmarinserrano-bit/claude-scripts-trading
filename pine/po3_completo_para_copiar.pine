_gp=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cz)
_mh=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cz)
_qc=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cz)
_oc="Estructura (CHoCH / BOS)"
_bz=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_oc)
_ti=1.1
_vm=2.0
_uy=20
_tj=2
_my=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oc)
_if=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oc)
_il=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oc)
_ih=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oc)
_el=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oc)
_qu=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oc)
_bg=bar_index >=last_bar_index-_qu
_cl=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_nn=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_al=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_vc="Order Blocks"
