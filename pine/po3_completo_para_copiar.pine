_gq(Zona z,float hi,float lo)=>
	_fo=z.dir==1?lo <=z._ag:hi >=z._ah
	if not _fo
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ag):z._bi
		if z.dir==1?lo < _bi:hi > _bi
