type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gh(Zona z,float hi,float lo)=>
	_fg=z.dir==1?lo <=z._ag:hi >=z._af
	if not _fg
		_be=na(z._be)?(z.dir==1?z._af:z._ag):z._be
		if z.dir==1?lo < _be:hi > _be
			z._be:=z.dir==1?lo:hi
	_fg
_bv(array<Zona> fvg,array<Zona> _tj,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xk,float _rd)=>
	_ta=false
	if ah.size()> 0
		_es=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tj
				n=s.n-z._rt
				if not z._kz and n >=1 and n <=_gj and h1 >=z._ag and l1 <=z._af
					if k <=_es
						z._kz:=true
					_ta:=true
			if k <=_es
				if _tj.size()> 0
					for i=_tj.size()-1 to 0
						if _gh(_tj.get(i),h1,l1)
							_tj.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._be)and(z.dir==1?(o1 >=z._af and c1 < z._ag):(o1 <=z._ag and c1 > z._af))
						if inv
							fvg.remove(i)
							_tj.push(Zona.new(z.x1,z._af,z._ag,-z.dir,na,s.n))
							if _tj.size()> _xk
								_tj.shift()
						else if _gh(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rd
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rd
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xk
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_ta
