	_qb(_eo,f,"FVG por arriba",_wv(_sw,_wk),_wx(_wk),tam)
	f+=1
	_qb(_eo,f,"FVG por abajo",_wv(_sv,_wu),_wx(_wu),tam)
	f+=1
	_vj=not _dz?"(apagada)":na(_cm)?"Ninguna reciente":(_dy==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cm)+" velas"
	_qb(_eo,f,"SMT",_vj,not _dz or na(_cm)?#757575:_dy==1?_js:_jd,tam)
	f+=1
