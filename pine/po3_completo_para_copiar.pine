_ln=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_da)
_pr=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_da)
_oi="Estructura (CHoCH / BOS)"
_cc=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_oi)
_sx=1.1
_vg=2.0
_ve=20
_tj=2
_nf=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oi)
_ht=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oi)
_is=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oi)
_ib=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oi)
_eg=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oi)
_qi=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oi)
_az=bar_index >=last_bar_index-_qi
_cn=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mg=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_al=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_uz="Order Blocks"
