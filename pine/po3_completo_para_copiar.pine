var array<bool> _aa=array.new<bool>(6,false)
var array<label> _ej=array.new<label>()
if timeframe.change("D")
	_aa.fill(false)
if _bl and not _bl[1]
	_aa.set(2,false)
	_aa.set(3,false)
if _dg and not _dg[1]
	_aa.set(4,false)
	_aa.set(5,false)
if _lo and _au and _ht and _ba
	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_gd:k==3?_gx:k==4?_lz:_nl
		_yr=k < 2 or(k < 4?not _bl:not _dg)
		_vy=k%2==0
		if _yr and not na(nv)and not _aa.get(k)and(_vy?high > nv and close < nv:low < nv and close > nv)
			_aa.set(k,true)
			nom=(k < 2?(_vy?"PDH":"PDL"):k < 4?(_vy?"Alto Asia":"Bajo Asia"):(_vy?"Alto Londres":"Bajo Londres"))
			_ej.push(label.new(bar_index,_vy?high:low,"Barrido "+nom,style=_vy?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _ej.size()> 20
				_ej.shift().delete()
type Igual
	line ln
	label lb
	float _av
	int dir
var array<Igual> _du=array.new<Igual>()
var float _ts=na
var int _po=na
