[pdh,pdl]=request.security(syminfo.tickerid,"D",[high[1],low[1]],lookahead=barmerge.lookahead_on)
_tf=_qh and timeframe.isintraday and not timeframe.change("D")
plot(_tf?pdh:na,"Alto día anterior",color=color.new(_dg,30),style=plot.style_linebr,linewidth=1)
plot(_tf?pdl:na,"Bajo día anterior",color=color.new(_dg,30),style=plot.style_linebr,linewidth=1)
plot(_to and timeframe.isintraday and not timeframe.change("D")?(pdh+pdl)/2:na,"50 % día anterior",color=color.new(#7E57C2,25),style=plot.style_linebr,linewidth=1)
_mf=timeframe.isintraday and _d <=3600
_ey=_mf and not na(time(timeframe.period,"2000-0000","America/New_York"))
_ie=_mf and not na(time(timeframe.period,"0200-0500","America/New_York"))
_vb=_mf and not na(time(timeframe.period,"0930-1100","America/New_York"))
bgcolor(_ld?(_ey?color.new(#7E57C2,94):_ie?color.new(#1E88E5,94):_vb?color.new(#F9A825,90):na):na,title="Sesiones")
var float _gp=na
var float _hq=na
var float _me=na
var float _no=na
var bool _iu=false
var bool _ia=false
var bool _ms=false
var bool _mh=false
if _ey
	if not _ey[1]
		_gp:=high
		_hq:=low
		_iu:=false
		_ia:=false
	else
		_gp:=math.max(_gp,high)
		_hq:=math.min(_hq,low)
else if not na(_gp)
	_iu:=_iu or high > _gp
	_ia:=_ia or low < _hq
if _ie
	if not _ie[1]
		_me:=high
		_no:=low
		_ms:=false
