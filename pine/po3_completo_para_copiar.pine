_ms=_an
_ku=_an
_ld=_an
_jg=_an
_jx=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qi)
_qv=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qi)
_la=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qi)
_kc=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_qi)
_re=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_qi)
_km=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_qi)
_ki=input.color(#8D6E63,"Color niveles H1",group=_qi)
_qs=input.bool(false,"Niveles clave: alto/bajo del día anterior",group=_qi)
_dv=input.color(#424242,"Color niveles clave",group=_qi)
_ns=input.color(#757575,"Color horas",group=_qi)
_ee=input.bool(true,"Mostrar EMAs",group="EMAs")
_or=input.int(9,"EMA rápida",minval=1,group="EMAs")
_of=input.int(20,"EMA media",minval=1,group="EMAs")
_oe=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ot=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_pe=input.color(#2962FF,"Color EMA media",group="EMAs")
_oa=input.color(#363A45,"Color EMA lenta",group="EMAs")
_ix=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ji=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fi=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kp=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_uz=14
_rv=50
_tk=0.15
_rd=2.5
_qz=30
_ps=1.0
_lu=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pi="Colores"
_ab=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pi)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pi)
_nd=input.bool(true,"Marcar la vela del OB",group=_pi)
_hk=input.color(#FF00C8,"IFVG (magenta)",group=_pi)
_mq=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pi)
_lb=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pi)
type Zona
	int x1
	float _ah
	float _ag
	int dir
	float _bh=na
	int _sc=na
	bool _mf=false
var _hf=array.new<Zona>()
var _jp=array.new<Zona>()
var obs=array.new<Zona>()
var _xu=array.new<Zona>()
var _wa=array.new<Zona>()
var _qu=array.new<Zona>()
var _qy=array.new<Zona>()
var _kg=array.new<Zona>()
var _xc=array.new<Zona>()
var _tl=array.new<Zona>()
var _ql=array.new<Zona>()
var _pv=array.new<Zona>()
var _lv=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ag
	color col
var _bn=array.new<Rango>()
_ew(Zona z)=>
	_gd=z.dir==1?low <=z._ag:high >=z._ah
	if not _gd
		_bh=na(z._bh)?(z.dir==1?z._ah:z._ag):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_gd
type Marca
	label lb
	line ln
	int bar
var _ip=array.new<Marca>()
var array<string> _fc=array.from("")
var array<int> _fb=array.from(0)
_ai(label lb,line ln,int bar)=>
	_ip.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fc.set(0,lb.get_text())
		_fb.set(0,bar)
	if _ip.size()> 500
		_ip.shift()
_rb=ta.ema(close,_or)
_se=ta.ema(close,_of)
_jf=ta.ema(close,_oe)
_cv=ta.atr(_uz)
var string _ty='════════ Detection ════════'
var string _sq='════════ Structure Filters ════════'
var string _uu='════════ Range Behavior ════════'
var string _ui='════════ Visual Settings ════════'
_cp='Base + 2x + 3x'
_on='Rangos'
_bl=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_on)
_bs='Percentile band'
_eq=90.0
_lg='Bar close'
_kh=200
_iq=40.0
_ei=500
_mp=0.18
_op='Wick reaches'
_iu=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_on)
_ep=0.10
_rk=0.45
_ek=0.70
_ij='Extend to containment'
_ir=300
_jv=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_on)
_hj=true
_lq=0.25
_lx='Close beyond'
_je=0.15
_hi=true
_hb=10
_lt=3
_fo=0
_nm='Custom'
_mk=#00A651
_lj=#E4002B
_fg=input.color(#F9A825,'Color del rango (neutral)',group=_on)
_jz=4
_ge=93
_ha=true
_kb=true
_he=input.bool(true,'Mostrar etiqueta del rango',group=_on)
_ka=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_on)
_in=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_on)
_hw='Small'
_ez=true
_ke='Small'
[_cg,_cf]=switch _nm
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_mk,_lj]
var color _ca=color.new(color.black,100)
var float _ch=3.0
var float _dz=1.6
_ja(string _wl)=>
	switch _wl
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ff(color _di)=>
	_if=color.r(_di)/255.0
	_hr=color.g(_di)/255.0
	_jn=color.b(_di)/255.0
	_te=_if <=0.03928?_if/12.92:math.pow((_if+0.055)/1.055,2.4)
	_tg=_hr <=0.03928?_hr/12.92:math.pow((_hr+0.055)/1.055,2.4)
	_sw=_jn <=0.03928?_jn/12.92:math.pow((_jn+0.055)/1.055,2.4)
	0.2126*_te+0.7152*_tg+0.0722*_sw
_ma(color _oq,color _mm)=>
	_mr=_ff(_oq)
	_kx=_ff(_mm)
	(math.max(_mr,_kx)+0.05)/(math.min(_mr,_kx)+0.05)
_em(color _ho)=>
	_ff(_ho)> 0.179?#000000:#ffffff
_oc(color _di,color _ni,float _rn)=>
	color.rgb(color.r(_di)+(color.r(_ni)-color.r(_di))*_rn,color.g(_di)+(color.g(_ni)-color.g(_di))*_rn,color.b(_di)+(color.b(_ni)-color.b(_di))*_rn)
_bm(color _di,color _ho,float _pc)=>
	_ni=_em(_ho)
	_ls=_di
	for step=1 to 10
		if _ma(_ls,_ho)>=_pc
			break
		_ls:=_oc(_di,_ni,step/10.0)
	_ls
_jq(float _yb)=>
	str.tostring(_yb,'#.##')+'%'
_qq(array<box> _ju,int _lk,float _ax,float _am)=>
	array.clear(_ju)
	if not _lb
		for i=0 to _jz-1
			array.push(_ju,box.new(_lk,_ax,bar_index,_am,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_go(array<box> _ju,float _ax,float _am,int _lk,int _rt,color _om)=>
	_qm=array.size(_ju)
	if _qm > 0 and _ax > _am
		_gx=(_ax-_am)/_qm
		for i=0 to _qm-1
			_ik=array.get(_ju,i)
			_pd=math.abs((i+0.5)/_qm-0.5)*2.0
			_nw=int(math.min(99,math.max(0,_ge+(1.0-_pd)*10)))
			box.set_lefttop(_ik,_lk,_ax-_gx*i)
			box.set_rightbottom(_ik,_rt,_ax-_gx*(i+1))
			box.set_bgcolor(_ik,color.new(_om,_nw))
_nx(array<box> _ju)=>
	if array.size(_ju)> 0
		for i=0 to array.size(_ju)-1
			box.delete(array.get(_ju,i))
	array.clear(_ju)
_qr(int _so,float _ax,float _am,float _cn)=>
	_yo=_so
	if _ij=='Extend to containment'
		_xy=math.min(_ir,bar_index)
		_ve=math.max(2,math.round((1.0-_ek)*_so))
		_mg=0
		_gy=0
		while _gy < _xy and _mg <=_ve
			_nc=close[_gy]<=_ax and close[_gy]>=_am
			_ts=_nc and high[_gy]<=_ax+_cn and low[_gy]>=_am-_cn
			if _nc
				_mg:=math.max(0,_mg-1)
				if _ts and _gy+1 >=_so
					_yo:=_gy+1
			else
				_mg+=1
			_gy+=1
	_yo
_cj=ta.atr(_kh)
_kj=not na(_cj)and _cj > 0
_gg=_lx=='Wick beyond'
_ks=_op=='Wick reaches'
_ox=_lg=='Live bar'
_fq=_ox or barstate.isconfirmed
_gf=_ja(_hw)
_kr=_ja(_ke)
_y=chart.bg_color
_s=_bm(_fg,_y,_ch)
_fy=_bm(_cg,_y,_ch)
_ga=_bm(_cf,_y,_ch)
_hg=_bm(_fg,_y,_dz)
_fl=_bm(_cg,_y,_dz)
_gb=_bm(_cf,_y,_dz)
_gk(simple int len)=>
	_vs=ta.percentile_linear_interpolation(high,len,_eq)
	_qt=ta.percentile_linear_interpolation(low,len,100.0-_eq)
	_va=ta.highest(high,len)
	_rc=ta.lowest(low,len)
	_tu=ta.highest(math.max(open,close),len)
	_nz=ta.lowest(math.min(open,close),len)
	top=_bs=='Absolute extremes'?_va:_bs=='Body extremes'?_tu:_vs
	_kl=_bs=='Absolute extremes'?_rc:_bs=='Body extremes'?_nz:_qt
	_dm=top-_kl
	_oj=_kj and _dm > 0?_dm/(_cj*math.sqrt(len)):99.0
	_tv=bar_index < 1?_ei:int(math.max(1,math.min(_ei,bar_index-_kh)))
	_ye=ta.percentrank(_oj,_tv)
	_yc=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xw=_dm > 0?math.abs(_yc)*len/_dm:99.0
	_cs=math.avg(top,_kl)
	_cn=_ep*nz(_cj)
	_nb=0
	_qb=0
	_hs=0
	_nl=0
	for i=0 to len-1
		if(close[i]> _cs)!=(close[i+1]> _cs)
			_nb+=1
		_nt=_ks?high[i]>=top-_cn:close[i]>=top-_cn
		_jw=_ks?low[i]<=_kl+_cn:close[i]<=_kl+_cn
		if _nt
			_qb+=1
		if _jw
			_hs+=1
		if close[i]<=top and close[i]>=_kl
			_nl+=1
	_oy=_nl/float(len)
	_id=_kj and not na(_ye)and bar_index > len+5 and _ye <=_iq and _nb >=math.max(3,math.round(_mp*len))and _qb >=_iu and _hs >=_iu and _xw <=_rk and _oy >=_ek
	[_id,top,_kl]
bool _ih=false
bool _iz=false
bool _ic=false
float _ws=na
float _wq=na
float _xm=na
float _px=na
float _qe=na
float _po=na
if _bd
	[qa,ta_,ba]=_gk(_bl)
	_ih:=qa
	_ws:=ta_
	_px:=ba
	if _cp !='Base only'
		[qb,tb,bb]=_gk(_bl*2)
		_iz:=qb
		_wq:=tb
		_qe:=bb
	if _cp=='Base + 2x + 3x'
		[qc,tc,bc]=_gk(_bl*3)
		_ic:=qc
		_xm:=tc
		_po:=bc
_es=_cp !='Base only' and _iz
_ev=_cp=='Base + 2x + 3x' and _ic
_id=_ih or _es or _ev
_pf=_ev?_bl*3:_es?_bl*2:_bl
_qn=_ev?_xm:_es?_wq:_ws
_ii=_ev?_po:_es?_qe:_px
var array<box> _ar=array.new<box>()
var box _v=na
var line _g=na
var line _k=na
var line _x=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _gq=na
var bool _t=false
var bool _l=false
var bool _bb=false
var int _du=na
var int _q=0
var float _p=na
var int _az=na
var int _av=0
_cc=false
_cl=false
_bj=false
_bz=false
if _fq and _av > 0
	_av-=1
if _fq and not _t and not _bb and _av <=0 and _id
	_nu=_qr(_pf,_qn,_ii,_ep*_cj)
	_c:=bar_index-_nu+1
	_gq:=bar_index
	_f:=_qn
	_a:=_ii
	_t:=true
	_l:=false
	_cs=math.avg(_f,_a)
	_bx=_a+(_f-_a)*0.25
	_aw=_a+(_f-_a)*0.75
	_v:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qq(_ar,_c,_f,_a)
	if _ha
		_g:=line.new(_c,_cs,bar_index,_cs,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kb
		_k:=line.new(_c,_bx,bar_index,_bx,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_x:=line.new(_c,_aw,bar_index,_aw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _he
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_ca,style=label.style_label_down,textcolor=color.new(_s,10),size=_gf)
	_cc:=true
if _t and _fq
	_cu=_je*_cj
	_fz=_lq*_cj
	if _hj and not _gg and close <=_f and close >=_a
		if high > _f and high <=_f+_fz
			_f:=high
		if low < _a and low >=_a-_fz
			_a:=low
	_qd=_gg?high > _f+_cu:close > _f+_cu
	_kk=_gg?low < _a-_cu:close < _a-_cu
	_qx=_fo > 0 and bar_index-_gq+1 >=_fo
	if _qd or _kk or _qx
		_b=_qd?1:_kk?-1:0
		_rr=_b !=0?bar_index-_c:bar_index-_c+1
		_nn=_a !=0?(_f-_a)/_a*100.0:0.0
		_jy=_hi and _b !=0 and _l
		if _l
			_fe=_b==1?_fy:_b==-1?_ga:_s
			_pb=_b==1?_fl:_b==-1?_gb:_hg
			_hq=_b==1?_cg:_b==-1?_cf:_fg
			box.set_lefttop(_v,_c,_f)
			box.set_rightbottom(_v,bar_index,_a)
			box.set_border_color(_v,color.new(_fe,30))
			box.set_border_style(_v,line.style_dotted)
			_go(_ar,_f,_a,_c,bar_index,na)
			_bn.push(Rango.new(_c,bar_index,_f,_a,_pb))
			if _bn.size()> 8
				_bn.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_x,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_rr)+' BARS   '+_jq(_nn))
				label.set_textcolor(_z,color.new(_fe,10))
			if _ka and _b !=0
				_oo=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _ez
