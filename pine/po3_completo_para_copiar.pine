_jn=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_qa)
_re="Colores FVG"
_am=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_re)
_ak=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_re)
_pc=_am
_ky=_am
_kw=_am
_ju=_am
_jp=_am
_ih=_am
_pv=_ak
_ld=_ak
_lo=_ak
_jf=_ak
_jg=_ak
_hs=_ak
_iv=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_qa)
_cz=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_qa)
_ok=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_qa)
_oq=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_qa)
_dd=input.color(#424242,"Color niveles clave",group=_qa)
_lh=input.color(#757575,"Color horas",group=_qa)
_dp=input.bool(true,"Mostrar EMAs",group="EMAs")
_mf=input.int(9,"EMA rápida",minval=1,group="EMAs")
_na=input.int(20,"EMA media",minval=1,group="EMAs")
