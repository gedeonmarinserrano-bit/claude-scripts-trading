_kk=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_po)
_tx="Colores FVG"
_an=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_tx)
