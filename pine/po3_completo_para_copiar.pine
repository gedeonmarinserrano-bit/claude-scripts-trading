_ns=input.string("Pequeño","Tamaño del texto",options=["Muy pequeño","Pequeño","Normal"],group=_cx)
_oh=input.bool(true,"Movimiento esperado del día (VIX / 16)",group=_cx)
_vv=input.symbol("CBOE:VIX","Índice de volatilidad (para el Nasdaq también vale CBOE:VXN)",group=_cx)
