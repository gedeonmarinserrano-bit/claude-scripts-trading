_lx()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_uu(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_bx(array<Zona> arr,float _ah,float _ai,int dir,int _uk,int _vr)=>
	if _ah-_ai >=_go(_vr)
		z=Zona.new(_uu(_uk),_ah,_ai,dir)
		if not _eu(z)
			arr.push(z)
			if arr.size()> _gp
