_dj(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_vr=(dir==1?"Máx. ":"Mín. ")+ses
	o=_gj.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _n.size()> 0
			for i=_n.size()-1 to 0
				q=_n.get(i)
