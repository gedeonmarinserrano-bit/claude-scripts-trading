int _rb=na
if _oq and _bc
	[h_,l_,hb_,lb_]=request.security(_qc,timeframe.period,_qy(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pj:=h_
	_pz:=l_
	_ru:=hb_
	_ro:=lb_
if _nn and _bc
	[h_,l_,hb_,lb_]=request.security(_pr,timeframe.period,_qy(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_qf:=h_
	_px:=l_
	_ry:=hb_
	_rb:=lb_
_nj=ta.pivothigh(high,_gf,_gf)
_mo=ta.pivotlow(low,_gf,_gf)
_qo=bar_index-_gf
var int _hj=na
var float _fj=na
var float _je=na
var float _hr=na
var int _hk=na
var float _fi=na
var float _hy=na
var float _ir=na
var array<line> _gh=array.new<line>()
var array<label> _ge=array.new<label>()
_dp(float y,float _uw,float c,float _mp,bool _ok)=>
	_us=_ok?y > _uw:y < _uw
	_uk=_ok?c > _mp:c < _mp
	not na(_uw)and not na(_mp)and not na(c)and _us !=_uk
_ft(string t,float c,float _mp)=>
	t+(c > _mp?" ↑":c < _mp?" ↓":" =")
_la(int x1,float y1,int xv,string txt,color col,bool _ok)=>
	yv=_ok?high[bar_index-xv]:low[bar_index-xv]
	if _sh
		_gh.push(line.new(x1,y1,xv,yv,color=col))
