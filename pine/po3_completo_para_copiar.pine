_pg=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_gx)
_qu=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_gx)
_je=input.color(#ff1100,"SMT bajista (en altos)",group=_gx)
_ho=input.color(#2157f3,"SMT alcista (en bajos)",group=_gx)
_jw(string s)=>
	_ta=str.split(s,":")
	_ta.size()> 0?_ta.last():s
_rn=_jw(_oq)
_qw=_jw(_or)
_wg=str.replace(_rn,"1!","")
_vz=str.replace(_qw,"1!","")
_sz=str.replace(syminfo.ticker,"1!","")
_nv=_dk and _sn and _wg !=_sz
_ok=_dk and _sv and _vz !=_sz
_qn()=>
	w=2*_gd+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pu=na
float _pl=na
int _rf=na
int _qt=na
float _pm=na
float _oz=na
int _ro=na
int _rr=na
if _nv and _bj
	[h_,l_,hb_,lb_]=request.security(_oq,timeframe.period,_qn(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pu:=h_
	_pl:=l_
	_rf:=hb_
	_qt:=lb_
if _ok and _bj
	[h_,l_,hb_,lb_]=request.security(_or,timeframe.period,_qn(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pm:=h_
	_oz:=l_
	_ro:=hb_
	_rr:=lb_
_md=ta.pivothigh(high,_gd,_gd)
_mz=ta.pivotlow(low,_gd,_gd)
_qk=bar_index-_gd
var int _ha=na
var float _fb=na
var float _iw=na
var float _id=na
var int _hf=na
var float _fo=na
var float _hy=na
var float _il=na
var array<line> _ge=array.new<line>()
var array<label> _fz=array.new<label>()
_dq(float y,float _ur,float c,float _mj,bool _og)=>
	_tu=_og?y > _ur:y < _ur
	_to=_og?c > _mj:c < _mj
	not na(_ur)and not na(_mj)and not na(c)and _tu !=_to
_fk(string t,float c,float _mj)=>
	t+(c > _mj?" ↑":c < _mj?" ↓":" =")
_kf(int x1,float y1,int xv,string txt,color col,bool _og)=>
	yv=_og?high[bar_index-xv]:low[bar_index-xv]
	if _qp
		_ge.push(line.new(x1,y1,xv,yv,color=col))
	if _lj
