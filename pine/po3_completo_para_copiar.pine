[pdh,pdl]=request.security(syminfo.tickerid,"D",[high[1],low[1]],lookahead=barmerge.lookahead_on)
_rs=_pi and timeframe.isintraday and not timeframe.change("D")
plot(_rs?pdh:na,"Alto día anterior",color=color.new(_dd,30),style=plot.style_linebr,linewidth=1)
plot(_rs?pdl:na,"Bajo día anterior",color=color.new(_dd,30),style=plot.style_linebr,linewidth=1)
_gp="SMT (divergencias entre índices)"
_dm=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_gp)
_kn=input.bool(true,"Mostrar etiquetas de la SMT",group=_gp)
_qg=input.bool(true,"Mostrar línea de la SMT",group=_gp)
_rm=input.bool(true,"Comparar con",inline="smt1",group=_gp)
_nv=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_gp)
_ri=input.bool(true,"Comparar con",inline="smt2",group=_gp)
_ol=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_gp)
_fn=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_gp)
_oi=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_gp)
_pp=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_gp)
_iu=input.color(#ff1100,"SMT bajista (en altos)",group=_gp)
_gx=input.color(#2157f3,"SMT alcista (en bajos)",group=_gp)
_kc(string s)=>
	_rz=str.split(s,":")
	_rz.size()> 0?_rz.last():s
_ps=_kc(_nv)
_qi=_kc(_ol)
_tp=str.replace(_ps,"1!","")
_uh=str.replace(_qi,"1!","")
_sa=str.replace(syminfo.ticker,"1!","")
_nj=_dm and _rm and _tp !=_sa
_nm=_dm and _ri and _uh !=_sa
_qf()=>
	w=2*_fn+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _ob=na
float _ny=na
int _pk=na
int _pw=na
float _oe=na
float _os=na
int _pt=na
int _pn=na
if _nj and _ci
	[h_,l_,hb_,lb_]=request.security(_nv,timeframe.period,_qf(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
