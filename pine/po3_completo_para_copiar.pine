		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pu(Pieza p)=>
	res=array.from(p)
	if _ku and _gm.size()> 0
		for o in _gm
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xa=array.new<Pieza>()
				for q in res
					for r in _wk(q,o)
						_xa.push(r)
				res:=_xa
				if res.size()==0 or res.size()> 10
					break
	res
_gr(Pieza p,color col,int dir)=>
	for q in _pu(p)
		top=q.top
		bot=q.bot
		if _ek > 0 and dir !=0
			for o in _gm
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ek
						top:=math.min(top,o.bot-_ek)
					if math.abs(bot-o.top)<=_ek
						bot:=math.max(bot,o.top+_ek)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qw(q.x1,top,q.x2,bot,col)
_mt(int _vl,int x2,float _ai,float _ah,int dir,float _bi,color col,string txt,color _xb,color _ql,color _om,bool _rq)=>
	x1=math.max(_vl,bar_index-1000)
	_yf=na(_bi)?_ai:(dir==1?_bi:_ai)
	_yo=na(_bi)?_ah:(dir==1?_ah:_bi)
	_gr(Pieza.new(x1,x2,_yf,_yo),col,dir)
	if not na(_bi)
		_gr(Pieza.new(x1,x2,dir==1?_ai:_bi,dir==1?_bi:_ah),_om,dir)
	if txt !="" and _fz.size()< 60
		_fz.push(Letrero.new(x2,(_yf+_yo)/2,txt,_xb,true,_rq))
	if not na(_ql)
		m=(_ai+_ah)/2
		for q in _pu(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_pi(q.x1,q.x2,m,_ql)
	_gm.push(Pieza.new(x1,x2,_ai,_ah,dir))
_bd(array<Zona> arr,color _xs,color _xr,int _uk,string txt,bool _yh,bool _tw,color _om,bool _rq)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xs:_xr
			t=txt
			_yt=z._ah > close?z._ah-close:close > z._ai?close-z._ai:0.0
			if uso.get(0)< 440 and _gm.size()< _ls and(_pr==0 or _yt/close*100 <=_pr)
				_mt(z.x1,bar_index+1,z._ai,z._ah,z.dir,z._bi,color.new(c,_ni),t,c,_tw?color.new(color.white,30):na,_om,_rq)
_au()=>
