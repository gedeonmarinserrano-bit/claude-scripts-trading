_kw=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_pp)
_uj="Colores FVG"
_an=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_uj)
_ao=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_uj)
_sd=_an
_nk=_an
_nc=_an
_km=_an
_kg=_an
_jr=_an
_rv=_ao
_mt=_ao
_np=_ao
_kv=_ao
_ks=_ao
_hq=_ao
_jv=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pp)
_qz=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pp)
_la=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pp)
_jz=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pp)
_qs=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pp)
_kx=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pp)
_kt=input.color(#8D6E63,"Color niveles H1",group=_pp)
_ra=input.bool(false,"Niveles clave: alto/bajo del día anterior",group=_pp)
_do=input.color(#424242,"Color niveles clave",group=_pp)
_mm=input.color(#757575,"Color horas",group=_pp)
_ek=input.bool(true,"Mostrar EMAs",group="EMAs")
_nx=input.int(9,"EMA rápida",minval=1,group="EMAs")
_oh=input.int(20,"EMA media",minval=1,group="EMAs")
_ob=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oa=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_nt=input.color(#2962FF,"Color EMA media",group="EMAs")
_oz=input.color(#363A45,"Color EMA lenta",group="EMAs")
_hr=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_iq=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fm=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_ki=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vm=14
_rp=50
_tu=0.15
_qv=2.5
_re=30
_qe=1.0
_lg=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oo="Colores"
_ad=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oo)
_t=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oo)
_ms=input.bool(true,"Marcar la vela del OB",group=_oo)
_hm=input.color(#FF00C8,"IFVG (magenta)",group=_oo)
_nh=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oo)
_ku=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oo)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _bh=na
	int _sh=na
	bool _mc=false
var _hi=array.new<Zona>()
var _ia=array.new<Zona>()
var obs=array.new<Zona>()
var _xw=array.new<Zona>()
var _wa=array.new<Zona>()
var _qq=array.new<Zona>()
var _qt=array.new<Zona>()
var _kj=array.new<Zona>()
var _wg=array.new<Zona>()
var _tg=array.new<Zona>()
var _qm=array.new<Zona>()
var _pv=array.new<Zona>()
var _lu=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bi=array.new<Rango>()
_er(Zona z)=>
	_fr=z.dir==1?low <=z._ah:high >=z._ag
	if not _fr
		_bh=na(z._bh)?(z.dir==1?z._ag:z._ah):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_fr
type Marca
	label lb
	line ln
	int bar
var _ic=array.new<Marca>()
var array<string> _fc=array.from("")
var array<int> _ey=array.from(0)
_ak(label lb,line ln,int bar)=>
	_ic.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fc.set(0,lb.get_text())
		_ey.set(0,bar)
	if _ic.size()> 500
		_ic.shift()
_qo=ta.ema(close,_nx)
_ru=ta.ema(close,_oh)
_hx=ta.ema(close,_ob)
_cv=ta.atr(_vm)
var string _uc='════════ Detection ════════'
var string _sm='════════ Structure Filters ════════'
var string _ut='════════ Range Behavior ════════'
var string _uf='════════ Visual Settings ════════'
_ct='Base + 2x + 3x'
_pg='Rangos'
_bm=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_pg)
_bq='Percentile band'
_em=90.0
_lx='Bar close'
_kn=200
_if=40.0
_ei=500
_nq=0.18
_ok='Wick reaches'
_jb=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_pg)
_eq=0.10
_rh=0.45
_eg=0.70
_ip='Extend to containment'
_jd=300
_jt=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_pg)
_hb=true
_mg=0.25
_mi='Close beyond'
_jk=0.15
_hg=true
_hj=10
_lk=3
_fl=0
_my='Custom'
_lh=#00A651
_ll=#E4002B
_ff=input.color(#F9A825,'Color del rango (neutral)',group=_pg)
_kb=4
_gh=93
_hc=true
_kd=true
_he=input.bool(true,'Mostrar etiqueta del rango',group=_pg)
_ju=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_pg)
_iu=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_pg)
_ix='Small'
_fa=true
_kc='Small'
[_ch,_cg]=switch _my
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lh,_ll]
var color _bz=color.new(color.black,100)
var float _cf=3.0
var float _dx=1.6
_ii(string _wf)=>
	switch _wf
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fh(color _dj)=>
	_im=color.r(_dj)/255.0
	_ie=color.g(_dj)/255.0
	_jo=color.b(_dj)/255.0
	_sw=_im <=0.03928?_im/12.92:math.pow((_im+0.055)/1.055,2.4)
	_tk=_ie <=0.03928?_ie/12.92:math.pow((_ie+0.055)/1.055,2.4)
	_td=_jo <=0.03928?_jo/12.92:math.pow((_jo+0.055)/1.055,2.4)
	0.2126*_sw+0.7152*_tk+0.0722*_td
_lp(color _nz,color _no)=>
	_nb=_fh(_nz)
	_ky=_fh(_no)
	(math.max(_nb,_ky)+0.05)/(math.min(_nb,_ky)+0.05)
_en(color _hk)=>
	_fh(_hk)> 0.179?#000000:#ffffff
_os(color _dj,color _ne,float _ry)=>
	color.rgb(color.r(_dj)+(color.r(_ne)-color.r(_dj))*_ry,color.g(_dj)+(color.g(_ne)-color.g(_dj))*_ry,color.b(_dj)+(color.b(_ne)-color.b(_dj))*_ry)
_bn(color _dj,color _hk,float _pe)=>
	_ne=_en(_hk)
	_ln=_dj
	for step=1 to 10
		if _lp(_ln,_hk)>=_pe
			break
		_ln:=_os(_dj,_ne,step/10.0)
	_ln
_il(float _xq)=>
	str.tostring(_xq,'#.##')+'%'
_qp(array<box> _jy,int _mb,float _bd,float _al)=>
	array.clear(_jy)
	if not _ku
		for i=0 to _kb-1
			array.push(_jy,box.new(_mb,_bd,bar_index,_al,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gl(array<box> _jy,float _bd,float _al,int _mb,int _sf,color _pf)=>
	_qj=array.size(_jy)
	if _qj > 0 and _bd > _al
		_gq=(_bd-_al)/_qj
		for i=0 to _qj-1
			_jq=array.get(_jy,i)
			_nw=math.abs((i+0.5)/_qj-0.5)*2.0
			_ou=int(math.min(99,math.max(0,_gh+(1.0-_nw)*10)))
			box.set_lefttop(_jq,_mb,_bd-_gq*i)
			box.set_rightbottom(_jq,_sf,_bd-_gq*(i+1))
			box.set_bgcolor(_jq,color.new(_pf,_ou))
_od(array<box> _jy)=>
	if array.size(_jy)> 0
		for i=0 to array.size(_jy)-1
			box.delete(array.get(_jy,i))
	array.clear(_jy)
_qy(int _sn,float _bd,float _al,float _cj)=>
	_yg=_sn
	if _ip=='Extend to containment'
		_xo=math.min(_jd,bar_index)
		_vd=math.max(2,math.round((1.0-_eg)*_sn))
		_lm=0
		_gv=0
		while _gv < _xo and _lm <=_vd
			_mo=close[_gv]<=_bd and close[_gv]>=_al
			_tj=_mo and high[_gv]<=_bd+_cj and low[_gv]>=_al-_cj
			if _mo
				_lm:=math.max(0,_lm-1)
				if _tj and _gv+1 >=_sn
					_yg:=_gv+1
			else
				_lm+=1
			_gv+=1
	_yg
_cl=ta.atr(_kn)
_lb=not na(_cl)and _cl > 0
_gj=_mi=='Wick beyond'
_lc=_ok=='Wick reaches'
_oq=_lx=='Live bar'
_fw=_oq or barstate.isconfirmed
_gn=_ii(_ix)
_kp=_ii(_kc)
_x=chart.bg_color
_r=_bn(_ff,_x,_cf)
_ft=_bn(_ch,_x,_cf)
_fv=_bn(_cg,_x,_cf)
_hd=_bn(_ff,_x,_dx)
_fq=_bn(_ch,_x,_dx)
_fk=_bn(_cg,_x,_dx)
_ge(simple int len)=>
	_uz=ta.percentile_linear_interpolation(high,len,_em)
	_qw=ta.percentile_linear_interpolation(low,len,100.0-_em)
	_vo=ta.highest(high,len)
	_qx=ta.lowest(low,len)
	_sx=ta.highest(math.max(open,close),len)
	_ny=ta.lowest(math.min(open,close),len)
	top=_bq=='Absolute extremes'?_vo:_bq=='Body extremes'?_sx:_uz
	_le=_bq=='Absolute extremes'?_qx:_bq=='Body extremes'?_ny:_qw
	_dv=top-_le
	_ov=_lb and _dv > 0?_dv/(_cl*math.sqrt(len)):99.0
	_ti=bar_index < 1?_ei:int(math.max(1,math.min(_ei,bar_index-_kn)))
	_ye=ta.percentrank(_ov,_ti)
	_xx=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_yc=_dv > 0?math.abs(_xx)*len/_dv:99.0
	_cr=math.avg(top,_le)
	_cj=_eq*nz(_cl)
	_nj=0
	_pw=0
	_jg=0
	_nr=0
	for i=0 to len-1
		if(close[i]> _cr)!=(close[i+1]> _cr)
			_nj+=1
		_og=_lc?high[i]>=top-_cj:close[i]>=top-_cj
		_ke=_lc?low[i]<=_le+_cj:close[i]<=_le+_cj
		if _og
			_pw+=1
		if _ke
			_jg+=1
		if close[i]<=top and close[i]>=_le
			_nr+=1
	_nv=_nr/float(len)
	_js=_lb and not na(_ye)and bar_index > len+5 and _ye <=_if and _nj >=math.max(3,math.round(_nq*len))and _pw >=_jb and _jg >=_jb and _yc <=_rh and _nv >=_eg
	[_js,top,_le]
bool _iz=false
bool _ir=false
bool _jj=false
float _wl=na
float _xg=na
float _wz=na
float _qc=na
float _pu=na
float _py=na
if _ba
	[qa,ta_,ba]=_ge(_bm)
	_iz:=qa
	_wl:=ta_
	_qc:=ba
	if _ct !='Base only'
		[qb,tb,bb]=_ge(_bm*2)
		_ir:=qb
		_xg:=tb
		_pu:=bb
	if _ct=='Base + 2x + 3x'
		[qc,tc,bc]=_ge(_bm*3)
		_jj:=qc
		_wz:=tc
		_py:=bc
_eu=_ct !='Base only' and _ir
_ev=_ct=='Base + 2x + 3x' and _jj
_js=_iz or _eu or _ev
_pc=_ev?_bm*3:_eu?_bm*2:_bm
_qh=_ev?_wz:_eu?_xg:_wl
_jn=_ev?_py:_eu?_pu:_qc
var array<box> _ar=array.new<box>()
var box _v=na
var line _g=na
var line _k=na
var line _w=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _gw=na
var bool _u=false
var bool _l=false
var bool _bf=false
var int _dp=na
var int _q=0
var float _p=na
var int _bb=na
var int _ax=0
_cd=false
_cm=false
_bk=false
_cb=false
if _fw and _ax > 0
	_ax-=1
if _fw and not _u and not _bf and _ax <=0 and _js
	_ow=_qy(_pc,_qh,_jn,_eq*_cl)
	_c:=bar_index-_ow+1
	_gw:=bar_index
	_f:=_qh
	_a:=_jn
	_u:=true
	_l:=false
	_cr=math.avg(_f,_a)
	_bw=_a+(_f-_a)*0.25
	_be=_a+(_f-_a)*0.75
	_v:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qp(_ar,_c,_f,_a)
	if _hc
		_g:=line.new(_c,_cr,bar_index,_cr,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kd
		_k:=line.new(_c,_bw,bar_index,_bw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_be,bar_index,_be,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _he
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bz,style=label.style_label_down,textcolor=color.new(_r,10),size=_gn)
	_cd:=true
if _u and _fw
	_cp=_jk*_cl
	_fp=_mg*_cl
	if _hb and not _gj and close <=_f and close >=_a
		if high > _f and high <=_f+_fp
			_f:=high
		if low < _a and low >=_a-_fp
			_a:=low
	_pl=_gj?high > _f+_cp:close > _f+_cp
	_ko=_gj?low < _a-_cp:close < _a-_cp
	_rd=_fl > 0 and bar_index-_gw+1 >=_fl
	if _pl or _ko or _rd
		_b=_pl?1:_ko?-1:0
		_sc=_b !=0?bar_index-_c:bar_index-_c+1
		_ng=_a !=0?(_f-_a)/_a*100.0:0.0
		_jw=_hg and _b !=0 and _l
		if _l
			_fe=_b==1?_ft:_b==-1?_fv:_r
			_nu=_b==1?_fq:_b==-1?_fk:_hd
			_ih=_b==1?_ch:_b==-1?_cg:_ff
			box.set_lefttop(_v,_c,_f)
			box.set_rightbottom(_v,bar_index,_a)
			box.set_border_color(_v,color.new(_fe,30))
			box.set_border_style(_v,line.style_dotted)
			_gl(_ar,_f,_a,_c,bar_index,na)
			_bi.push(Rango.new(_c,bar_index,_f,_a,_nu))
			if _bi.size()> 8
				_bi.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sc)+' BARS   '+_il(_ng))
				label.set_textcolor(_z,color.new(_fe,10))
			if _ju and _b !=0
				_op=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fa
