	_qb(_eo,f,"Bias H4",_d < 14400?_lh(_wz):"(gráfico ≥ H4)",_lz(_wz),tam)
	f+=1
	_qb(_eo,f,"Bias H1",_d < 3600?_lh(b60):"(gráfico ≥ H1)",_lz(b60),tam)
	f+=1
	ev=_fg.get(0)
