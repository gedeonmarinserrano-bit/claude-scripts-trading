			z=arr.get(i)
			_ro=(z._ac+z._ad)/2
			if low <=_ro and high >=_ro
				_ua:=true
			_ig=na(z._bc)and(z.dir==1?(open >=z._ac and close < z._ad):(open <=z._ad and close > z._ac))
			if _ig
				arr.remove(i)
				_dl.push(Zona.new(z.x1,z._ac,z._ad,-z.dir,na,bar_index))
