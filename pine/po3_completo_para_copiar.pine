			_mz.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dq
			_nf.push(q._aa)
			_mz.push(q.dir==1?"EQH":"EQL")
		for i=0 to _nf.size()-1
			pv=_nf.get(i)
