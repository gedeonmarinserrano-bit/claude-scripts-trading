_ju=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pu)
_ra=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pu)
_kt=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pu)
_kd=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pu)
_qw=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pu)
_lb=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pu)
_ky=input.color(#8D6E63,"Color niveles H1",group=_pu)
_re=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_pu)
_dz=input.color(#424242,"Color niveles clave",group=_pu)
_mv=input.color(#757575,"Color horas",group=_pu)
_en=input.bool(true,"Mostrar EMAs",group="EMAs")
_pg=input.int(9,"EMA rápida",minval=1,group="EMAs")
_pa=input.int(20,"EMA media",minval=1,group="EMAs")
_ox=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oy=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_od=input.color(#9E9D24,"Color EMA media",group="EMAs")
_nu=input.color(color.black,"Color EMA lenta",group="EMAs")
_hy=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_if=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_gd=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kq=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vt=14
_rf=50
_to=0.15
_qv=2.5
_qt=30
_pz=1.0
_ll=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pc="Colores"
_ab=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pc)
_t=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pc)
_mo=input.bool(true,"Marcar la vela del OB",group=_pc)
_hm=input.color(#FF00C8,"IFVG (magenta)",group=_pc)
_ml=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pc)
_ld=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pc)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _bi=na
	int _rh=na
	bool _lz=false
var _hc=array.new<Zona>()
var _ji=array.new<Zona>()
var obs=array.new<Zona>()
var _xp=array.new<Zona>()
var _wa=array.new<Zona>()
var _rc=array.new<Zona>()
var _qu=array.new<Zona>()
var _kp=array.new<Zona>()
var _wu=array.new<Zona>()
var _ts=array.new<Zona>()
var _qd=array.new<Zona>()
var _qi=array.new<Zona>()
var _li=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bl=array.new<Rango>()
_ev(Zona z)=>
	_fp=z.dir==1?low <=z._ah:high >=z._ag
	if not _fp
		_bi=na(z._bi)?(z.dir==1?z._ag:z._ah):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fp
type Marca
	label lb
	line ln
	int bar
var _iy=array.new<Marca>()
var array<string> _ey=array.from("")
var array<int> _fe=array.from(0)
_aj(label lb,line ln,int bar)=>
	_iy.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ey.set(0,lb.get_text())
		_fe.set(0,bar)
	if _iy.size()> 500
		_iy.shift()
_qp=ta.ema(close,_pg)
_sm=ta.ema(close,_pa)
_id=ta.ema(close,_ox)
_db=ta.atr(_vt)
var string _ua='════════ Detection ════════'
var string _sh='════════ Structure Filters ════════'
var string _um='════════ Range Behavior ════════'
var string _tz='════════ Visual Settings ════════'
_cs='Base + 2x + 3x'
_on='Rangos'
_bm=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_on)
_bp='Percentile band'
_ei=90.0
_mc='Bar close'
_km=200
_jf=40.0
_ee=500
_nm=0.18
_oi='Wick reaches'
_jr=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_on)
_eq=0.10
_sp=0.45
_ek=0.70
_ig='Extend to containment'
_ht=300
_jw=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_on)
_ha=true
_ly=0.25
_lu='Close beyond'
_ii=0.15
_he=true
_hb=10
_mk=3
_fy=0
_mw='Custom'
_mj=#00A651
_ma=#E4002B
_fh=input.color(#F9A825,'Color del rango (neutral)',group=_on)
_kb=4
_gk=93
_hj=true
_ka=true
_hh=input.bool(true,'Mostrar etiqueta del rango',group=_on)
_jy=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_on)
_in=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_on)
_jb='Small'
_fc=true
_ke='Small'
[_ch,_cg]=switch _mw
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_mj,_ma]
var color _cc=color.new(color.black,100)
var float _cf=3.0
var float _dp=1.6
_jm(string _xi)=>
	switch _xi
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fi(color _df)=>
	_jp=color.r(_df)/255.0
	_jl=color.g(_df)/255.0
	_ie=color.b(_df)/255.0
	_ti=_jp <=0.03928?_jp/12.92:math.pow((_jp+0.055)/1.055,2.4)
	_sz=_jl <=0.03928?_jl/12.92:math.pow((_jl+0.055)/1.055,2.4)
	_tk=_ie <=0.03928?_ie/12.92:math.pow((_ie+0.055)/1.055,2.4)
	0.2126*_ti+0.7152*_sz+0.0722*_tk
_md(color _pb,color _mn)=>
	_na=_fi(_pb)
	_kx=_fi(_mn)
	(math.max(_na,_kx)+0.05)/(math.min(_na,_kx)+0.05)
_ef(color _ho)=>
	_fi(_ho)> 0.179?#000000:#ffffff
_nz(color _df,color _mp,float _st)=>
	color.rgb(color.r(_df)+(color.r(_mp)-color.r(_df))*_st,color.g(_df)+(color.g(_mp)-color.g(_df))*_st,color.b(_df)+(color.b(_mp)-color.b(_df))*_st)
_bn(color _df,color _ho,float _oc)=>
	_mp=_ef(_ho)
	_ls=_df
	for step=1 to 10
		if _md(_ls,_ho)>=_oc
			break
		_ls:=_nz(_df,_mp,step/10.0)
	_ls
_ir(float _yb)=>
	str.tostring(_yb,'#.##')+'%'
_rd(array<box> _jz,int _me,float _aw,float _al)=>
	array.clear(_jz)
	if not _ld
		for i=0 to _kb-1
			array.push(_jz,box.new(_me,_aw,bar_index,_al,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gg(array<box> _jz,float _aw,float _al,int _me,int _rx,color _oj)=>
	_pm=array.size(_jz)
	if _pm > 0 and _aw > _al
		_gx=(_aw-_al)/_pm
		for i=0 to _pm-1
			_hv=array.get(_jz,i)
			_oe=math.abs((i+0.5)/_pm-0.5)*2.0
			_nv=int(math.min(99,math.max(0,_gk+(1.0-_oe)*10)))
			box.set_lefttop(_hv,_me,_aw-_gx*i)
			box.set_rightbottom(_hv,_rx,_aw-_gx*(i+1))
			box.set_bgcolor(_hv,color.new(_oj,_nv))
_ol(array<box> _jz)=>
	if array.size(_jz)> 0
		for i=0 to array.size(_jz)-1
			box.delete(array.get(_jz,i))
	array.clear(_jz)
_qs(int _rw,float _aw,float _al,float _cl)=>
	_yq=_rw
	if _ig=='Extend to containment'
		_xy=math.min(_ht,bar_index)
		_uq=math.max(2,math.round((1.0-_ek)*_rw))
		_mh=0
		_gt=0
		while _gt < _xy and _mh <=_uq
			_nj=close[_gt]<=_aw and close[_gt]>=_al
			_tg=_nj and high[_gt]<=_aw+_cl and low[_gt]>=_al-_cl
			if _nj
				_mh:=math.max(0,_mh-1)
				if _tg and _gt+1 >=_rw
					_yq:=_gt+1
			else
				_mh+=1
			_gt+=1
	_yq
_co=ta.atr(_km)
_ko=not na(_co)and _co > 0
_gf=_lu=='Wick beyond'
_kg=_oi=='Wick reaches'
_ph=_mc=='Live bar'
_fr=_ph or barstate.isconfirmed
_go=_jm(_jb)
_le=_jm(_ke)
_y=chart.bg_color
_r=_bn(_fh,_y,_cf)
_fl=_bn(_ch,_y,_cf)
_fk=_bn(_cg,_y,_cf)
_hi=_bn(_fh,_y,_dp)
_fu=_bn(_ch,_y,_dp)
_gc=_bn(_cg,_y,_dp)
_gh(simple int len)=>
	_vv=ta.percentile_linear_interpolation(high,len,_ei)
	_qo=ta.percentile_linear_interpolation(low,len,100.0-_ei)
	_vc=ta.highest(high,len)
	_qq=ta.lowest(low,len)
	_tc=ta.highest(math.max(open,close),len)
	_om=ta.lowest(math.min(open,close),len)
	top=_bp=='Absolute extremes'?_vc:_bp=='Body extremes'?_tc:_vv
	_ku=_bp=='Absolute extremes'?_qq:_bp=='Body extremes'?_om:_qo
	_dt=top-_ku
	_nw=_ko and _dt > 0?_dt/(_co*math.sqrt(len)):99.0
	_tn=bar_index < 1?_ee:int(math.max(1,math.min(_ee,bar_index-_km)))
	_yo=ta.percentrank(_nw,_tn)
	_xt=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xw=_dt > 0?math.abs(_xt)*len/_dt:99.0
	_cu=math.avg(top,_ku)
	_cl=_eq*nz(_co)
	_mz=0
	_pt=0
	_jo=0
	_nq=0
	for i=0 to len-1
		if(close[i]> _cu)!=(close[i+1]> _cu)
			_mz+=1
		_ou=_kg?high[i]>=top-_cl:close[i]>=top-_cl
		_jv=_kg?low[i]<=_ku+_cl:close[i]<=_ku+_cl
		if _ou
			_pt+=1
		if _jv
			_jo+=1
		if close[i]<=top and close[i]>=_ku
			_nq+=1
	_ny=_nq/float(len)
	_ib=_ko and not na(_yo)and bar_index > len+5 and _yo <=_jf and _mz >=math.max(3,math.round(_nm*len))and _pt >=_jr and _jo >=_jr and _xw <=_sp and _ny >=_ek
	[_ib,top,_ku]
bool _je=false
bool _iu=false
bool _iw=false
float _xe=na
float _xa=na
float _wd=na
float _qb=na
float _qn=na
float _qa=na
if _bh
	[qa,ta_,ba]=_gh(_bm)
	_je:=qa
	_xe:=ta_
	_qb:=ba
	if _cs !='Base only'
		[qb,tb,bb]=_gh(_bm*2)
		_iu:=qb
		_xa:=tb
		_qn:=bb
	if _cs=='Base + 2x + 3x'
		[qc,tc,bc]=_gh(_bm*3)
		_iw:=qc
		_wd:=tc
		_qa:=bc
_eu=_cs !='Base only' and _iu
_ex=_cs=='Base + 2x + 3x' and _iw
_ib=_je or _eu or _ex
_oh=_ex?_bm*3:_eu?_bm*2:_bm
_qe=_ex?_wd:_eu?_xa:_xe
_jk=_ex?_qa:_eu?_qn:_qb
var array<box> _ar=array.new<box>()
var box _v=na
var line _g=na
var line _l=na
var line _w=na
var label _z=na
var label _au=na
var float _f=na
var float _a=na
var int _c=na
var int _gy=na
var bool _u=false
var bool _n=false
var bool _bb=false
var int _dq=na
var int _p=0
var float _q=na
var int _bf=na
var int _bc=0
_cb=false
_ci=false
_bk=false
_ca=false
if _fr and _bc > 0
	_bc-=1
if _fr and not _u and not _bb and _bc <=0 and _ib
	_og=_qs(_oh,_qe,_jk,_eq*_co)
	_c:=bar_index-_og+1
	_gy:=bar_index
	_f:=_qe
	_a:=_jk
	_u:=true
	_n:=false
	_cu=math.avg(_f,_a)
	_by=_a+(_f-_a)*0.25
	_ay=_a+(_f-_a)*0.75
	_v:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_rd(_ar,_c,_f,_a)
	if _hj
		_g:=line.new(_c,_cu,bar_index,_cu,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _ka
		_l:=line.new(_c,_by,bar_index,_by,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_ay,bar_index,_ay,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hh
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cc,style=label.style_label_down,textcolor=color.new(_r,10),size=_go)
	_cb:=true
if _u and _fr
	_ct=_ii*_co
	_ga=_ly*_co
	if _ha and not _gf and close <=_f and close >=_a
		if high > _f and high <=_f+_ga
			_f:=high
		if low < _a and low >=_a-_ga
			_a:=low
	_pr=_gf?high > _f+_ct:close > _f+_ct
	_ki=_gf?low < _a-_ct:close < _a-_ct
	_qz=_fy > 0 and bar_index-_gy+1 >=_fy
	if _pr or _ki or _qz
		_b=_pr?1:_ki?-1:0
		_sk=_b !=0?bar_index-_c:bar_index-_c+1
		_mm=_a !=0?(_f-_a)/_a*100.0:0.0
		_jx=_he and _b !=0 and _n
		if _n
			_fg=_b==1?_fl:_b==-1?_fk:_r
			_nt=_b==1?_fu:_b==-1?_gc:_hi
			_ih=_b==1?_ch:_b==-1?_cg:_fh
			box.set_lefttop(_v,_c,_f)
			box.set_rightbottom(_v,bar_index,_a)
			box.set_border_color(_v,color.new(_fg,30))
			box.set_border_style(_v,line.style_dotted)
			_gg(_ar,_f,_a,_c,bar_index,na)
			_bl.push(Rango.new(_c,bar_index,_f,_a,_nt))
			if _bl.size()> 8
				_bl.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_l)
				line.set_x2(_l,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sk)+' BARS   '+_ir(_mm))
				label.set_textcolor(_z,color.new(_fg,10))
			if _jy and _b !=0
				_op=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fc
