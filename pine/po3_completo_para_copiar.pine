_mq=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_vn)
_wr=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_vn)
_mx=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_vn)
_kz=input.color(#1565C0,"OB alcista (demanda)",group=_vn)
_kh=input.color(#EF6C00,"OB bajista (oferta)",group=_vn)
_pp="Estrategia NY (Bias + PO3)"
