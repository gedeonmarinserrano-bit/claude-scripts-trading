type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gk(Zona z,float hi,float lo)=>
	_fw=z.dir==1?lo <=z._af:hi >=z._ag
	if not _fw
		_bf=na(z._bf)?(z.dir==1?z._ag:z._af):z._bf
		if z.dir==1?lo < _bf:hi > _bf
			z._bf:=z.dir==1?lo:hi
	_fw
_by(array<Zona> fvg,array<Zona> _tg,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xs,float _rl)=>
	_tq=false
	if ah.size()> 0
		_ex=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tg
				n=s.n-z._qs
				if not z._lm and n >=1 and n <=_gp and h1 >=z._af and l1 <=z._ag
					if k <=_ex
						z._lm:=true
					_tq:=true
			if k <=_ex
				if _tg.size()> 0
					for i=_tg.size()-1 to 0
						if _gk(_tg.get(i),h1,l1)
							_tg.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bf)and(z.dir==1?(o1 >=z._ag and c1 < z._af):(o1 <=z._af and c1 > z._ag))
						if inv
							fvg.remove(i)
							_tg.push(Zona.new(z.x1,z._ag,z._af,-z.dir,na,s.n))
							if _tg.size()> _xs
								_tg.shift()
						else if _gk(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rl
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rl
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xs
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_tq
