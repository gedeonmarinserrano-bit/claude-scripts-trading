_eo=nz(ta.atr(50))*_ve/100
var array<Pieza> _gi=array.new<Pieza>()
_wl(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_qj(Pieza p)=>
	res=array.from(p)
	if _ki and _gi.size()> 0
		for o in _gi
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wy=array.new<Pieza>()
				for q in res
					for r in _wl(q,o)
						_wy.push(r)
				res:=_wy
				if res.size()==0 or res.size()> 10
					break
	res
_gw(Pieza p,color col,int dir)=>
	for q in _qj(p)
		top=q.top
		bot=q.bot
		if _eo > 0 and dir !=0
			for o in _gi
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_eo
						top:=math.min(top,o.bot-_eo)
					if math.abs(bot-o.top)<=_eo
						bot:=math.max(bot,o.top+_eo)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_ra(q.x1,top,q.x2,bot,col)
_nf(int _vq,int x2,float _ah,float _ai,int dir,float _bi,color col,string txt,color _xe,color _pq,color _pb,bool _sf)=>
	x1=math.max(_vq,bar_index-1000)
	_yk=na(_bi)?_ah:(dir==1?_bi:_ah)
	_yl=na(_bi)?_ai:(dir==1?_ai:_bi)
	_gw(Pieza.new(x1,x2,_yk,_yl),col,dir)
	if not na(_bi)
		_gw(Pieza.new(x1,x2,dir==1?_ah:_bi,dir==1?_bi:_ai),_pb,dir)
	if txt !="" and _fs.size()< 60
		_fs.push(Letrero.new(x2,(_yk+_yl)/2,txt,_xe,true,_sf))
	if not na(_pq)
		m=(_ah+_ai)/2
		for q in _qj(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nw(q.x1,q.x2,m,_pq)
	_gi.push(Pieza.new(x1,x2,_ah,_ai,dir))
_az(array<Zona> arr,color _ya,color _xv,int _ui,string txt,bool _yj,bool _to,color _pb,bool _sf)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_ya:_xv
			t=txt
			_ys=z._ai > close?z._ai-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gi.size()< _mh and(_pk==0 or _ys/close*100 <=_pk)
				_nf(z.x1,bar_index+1,z._ah,z._ai,z.dir,z._bi,color.new(c,_ni),t,c,_to?color.new(color.white,30):na,_pb,_sf)
