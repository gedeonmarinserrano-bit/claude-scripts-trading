_no=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_jl)
_dd="FVG por temporalidad (solo se ven los activados)"
_ar=input.bool(true,"FVG H4",inline="fvgtf1",group=_dd)
