type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gt(Zona z,float hi,float lo)=>
	_fq=z.dir==1?lo <=z._ah:hi >=z._ag
	if not _fq
		_bi=na(z._bi)?(z.dir==1?z._ag:z._ah):z._bi
		if z.dir==1?lo < _bi:hi > _bi
			z._bi:=z.dir==1?lo:hi
	_fq
_bv(array<Zona> fvg,array<Zona> _tr,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _wz,float _rd)=>
	_to=false
	if ah.size()> 0
		_ey=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _tr
				n=s.n-z._si
				if not z._li and n >=1 and n <=_gs and h1 >=z._ah and l1 <=z._ag
					if k <=_ey
						z._li:=true
					_to:=true
			if k <=_ey
				if _tr.size()> 0
					for i=_tr.size()-1 to 0
						if _gt(_tr.get(i),h1,l1)
							_tr.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ag and c1 < z._ah):(o1 <=z._ah and c1 > z._ag))
						if inv
							fvg.remove(i)
							_tr.push(Zona.new(z.x1,z._ag,z._ah,-z.dir,na,s.n))
							if _tr.size()> _wz
								_tr.shift()
						else if _gt(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_rd
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_rd
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _wz
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_to
