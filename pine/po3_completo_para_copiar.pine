_lv=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_nf=input.color(#9E9D24,"Color EMA media",group="EMAs")
_mm=input.color(color.black,"Color EMA lenta",group="EMAs")
_hf=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hp=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fe=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_jl=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_rt=input.int(14,"Longitud ATR",minval=1,group="CHoCH fallido / riesgo")
_ps=input.float(50,"Mecha de rechazo ≥ (% del rango)",minval=0,maxval=100,group="CHoCH fallido / riesgo")
_qg=input.float(0.15,"Ruptura corta < (× ATR)",minval=0,step=0.05,group="CHoCH fallido / riesgo")
_og=input.float(2.5,"Vela de clímax > (× ATR)",minval=0,step=0.1,group="CHoCH fallido / riesgo")
_ol=input.float(30,"Cuerpo pequeño < (% del rango)",minval=0,maxval=100,group="CHoCH fallido / riesgo")
_nh=input.float(1.0,"FVG contrario a < (× ATR)",minval=0,step=0.1,group="CHoCH fallido / riesgo")
_kb=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_mv="Colores"
_de=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_mv)
_dj=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_mv)
_lk=input.bool(true,"Marcar la vela del OB",group=_mv)
_gm=input.color(#FF00C8,"IFVG (magenta)",group=_mv)
_ku=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_mv)
_jm=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_mv)
type Zona
	int x1
	float _an
	float _al
	int dir
	float _bz=na
	int _ou=na
	bool _kk=false
var _ix=array.new<Zona>()
var _kc=array.new<Zona>()
var obs=array.new<Zona>()
var _ub=array.new<Zona>()
var _su=array.new<Zona>()
var _pn=array.new<Zona>()
var _py=array.new<Zona>()
var _lc=array.new<Zona>()
var _sk=array.new<Zona>()
var _qc=array.new<Zona>()
var _nx=array.new<Zona>()
var _nu=array.new<Zona>()
var _km=array.new<Zona>()
type Rango
	int x1
	int x2
	float _an
	float _al
	color col
var _bb=array.new<Rango>()
_ec(Zona z)=>
	_fg=z.dir==1?low <=z._al:high >=z._an
	if not _fg
		_bz=na(z._bz)?(z.dir==1?z._an:z._al):z._bz
		if z.dir==1?low < _bz:high > _bz
			z._bz:=z.dir==1?low:high
	_fg
type Marca
	label lb
	line ln
	int bar
var _hw=array.new<Marca>()
_ag(label lb,line ln,int bar)=>
	_hw.push(Marca.new(lb,ln,bar))
	if _hw.size()> 500
		_hw.shift()
_om=ta.ema(close,_mf)
_pk=ta.ema(close,_na)
_id=ta.ema(close,_my)
_ka=ta.atr(_rt)
var string _ar='════════ Detection ════════'
var string _n='════════ Structure Filters ════════'
var string _s='════════ Range Behavior ════════'
var string _g='════════ Visual Settings ════════'
_cm=input.string('Base + 2x + 3x','Scan Scaling',options=['Base only','Base + 2x','Base + 2x + 3x'],group=_ar)
_bf=input.int(20,'Base Scan Length',minval=8,maxval=100,group=_ar)
_bl=input.string('Percentile band','Boundary Basis',options=['Percentile band','Absolute extremes','Body extremes'],group=_ar)
_dv=input.float(90.0,'Boundary Percentile',minval=70.0,maxval=100.0,step=1.0,group=_ar)
_jz=input.string('Bar close','Signal Timing',options=['Bar close','Live bar'],group=_ar)
_ji=input.int(200,'ATR Length',minval=14,maxval=1000,group=_ar)
_hm=input.float(40.0,'Compression Percentile',minval=5.0,maxval=95.0,step=5.0,group=_n)
_ds=input.int(500,'Calibration Lookback',minval=100,maxval=2000,group=_n)
_ln=input.float(0.18,'Min Rotation Rate',minval=0.05,maxval=0.60,step=0.01,group=_n)
_mq=input.string('Wick reaches','Touch Definition',options=['Wick reaches','Close reaches'],group=_n)
_gx=input.int(2,'Min Boundary Touches',minval=1,maxval=10,group=_n)
_dy=input.float(0.10,'Touch Tolerance (ATR)',minval=0.02,maxval=1.0,step=0.02,group=_n)
_ow=input.float(0.45,'Max Drift',minval=0.05,maxval=2.0,step=0.05,group=_n)
_do=input.float(0.70,'Min Containment',minval=0.40,maxval=1.0,step=0.05,group=_n)
_hz=input.string('Extend to containment','Range Anchoring',options=['Scan window only','Extend to containment'],group=_s)
_he=input.int(300,'Anchor Lookback',minval=20,maxval=500,group=_s)
_iw=input.int(10,'Minimum Range Bars',minval=2,maxval=200,group=_s)
_gf=input.bool(true,'Absorb Overshoot',group=_s)
_jy=input.float(0.25,'Overshoot Tolerance (ATR)',minval=0.05,maxval=1.0,step=0.05,group=_s)
_kg=input.string('Close beyond','Break Confirmation',options=['Close beyond','Wick beyond'],group=_s)
_hl=input.float(0.15,'Breakout Buffer (ATR)',minval=0.0,maxval=2.0,step=0.05,group=_s)
_ge=input.bool(true,'Merge Deviations',group=_s)
_gg=input.int(10,'Deviation Window',minval=1,maxval=100,group=_s)
_kr=input.int(3,'Cooldown Bars',minval=0,maxval=100,group=_s)
_ep=input.int(0,'Max Range Age',minval=0,maxval=2000,group=_s)
_lr=input.string('Custom','Color Preset',options=['Classic','Aqua','Cosmic','Cyber','Neon','Custom'],group=_g)
_kd=input.color(#00A651,'Bullish Color',group=_g)
_ks=input.color(#E4002B,'Bearish Color',group=_g)
_en=input.color(#F9A825,'Range Color',group=_g)
_ip=input.int(4,'Gradient Steps',minval=1,maxval=10,group=_g)
_fn=input.int(93,'Fill Transparency',minval=50,maxval=100,group=_g)
_gb=input.bool(true,'Show Equilibrium Line',group=_g)
_is=input.bool(true,'Show Quartile Levels',group=_g)
_gc=input.bool(true,'Show Range Labels',group=_g)
_it=input.bool(true,'Show Breakout Markers',group=_g)
_hv=input.bool(true,'Show Deviation Markers',group=_g)
_ij=input.string('Small','Label Text Size',options=['Tiny','Small','Normal','Large'],group=_g)
_ek=input.bool(true,'Marcas Breakout/Deviation sutiles (solo flecha)',group=_g)
_ir=input.string('Small','Tamaño flechas Breakout/Deviation',options=['Tiny','Small','Normal','Large'],group=_g)
[_by,_cb]=switch _lr
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_kd,_ks]
var color _bs=color.new(color.black,100)
var float _bx=3.0
var float _dc=1.6
_ht(string _sq)=>
	switch _sq
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_el(color _cx)=>
	_hk=color.r(_cx)/255.0
	_ik=color.g(_cx)/255.0
	_gs=color.b(_cx)/255.0
	_qh=_hk <=0.03928?_hk/12.92:math.pow((_hk+0.055)/1.055,2.4)
	_qn=_ik <=0.03928?_ik/12.92:math.pow((_ik+0.055)/1.055,2.4)
	_qb=_gs <=0.03928?_gs/12.92:math.pow((_gs+0.055)/1.055,2.4)
	0.2126*_qh+0.7152*_qn+0.0722*_qb
_kt(color _mb,color _ll)=>
	_li=_el(_mb)
	_jb=_el(_ll)
	(math.max(_li,_jb)+0.05)/(math.min(_li,_jb)+0.05)
_dz(color _gk)=>
	_el(_gk)> 0.179?#000000:#ffffff
_mj(color _cx,color _lq,float _pa)=>
	color.rgb(color.r(_cx)+(color.r(_lq)-color.r(_cx))*_pa,color.g(_cx)+(color.g(_lq)-color.g(_cx))*_pa,color.b(_cx)+(color.b(_lq)-color.b(_cx))*_pa)
_bd(color _cx,color _gk,float _mg)=>
	_lq=_dz(_gk)
	_jx=_cx
	for step=1 to 10
		if _kt(_jx,_gk)>=_mg
			break
		_jx:=_mj(_cx,_lq,step/10.0)
	_jx
_ho(float _tl)=>
	str.tostring(_tl,'#.##')+'%'
_of(array<box> _iu,int _ko,float _ay,float _ah)=>
	array.clear(_iu)
	if not _jm
		for i=0 to _ip-1
			array.push(_iu,box.new(_ko,_ay,bar_index,_ah,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_fm(array<box> _iu,float _ay,float _ah,int _ko,int _po,color _md)=>
	_nt=array.size(_iu)
	if _nt > 0 and _ay > _ah
		_fs=(_ay-_ah)/_nt
		for i=0 to _nt-1
			_gt=array.get(_iu,i)
			_ms=math.abs((i+0.5)/_nt-0.5)*2.0
			_mk=int(math.min(99,math.max(0,_fn+(1.0-_ms)*10)))
			box.set_lefttop(_gt,_ko,_ay-_fs*i)
			box.set_rightbottom(_gt,_po,_ay-_fs*(i+1))
			box.set_bgcolor(_gt,color.new(_md,_mk))
_mt(array<box> _iu)=>
	if array.size(_iu)> 0
		for i=0 to array.size(_iu)-1
			box.delete(array.get(_iu,i))
	array.clear(_iu)
_od(int _ph,float _ay,float _ah,float _cg)=>
	_tx=_ph
	if _hz=='Extend to containment'
		_tj=math.min(_he,bar_index)
		_se=math.max(2,math.round((1.0-_do)*_ph))
		_kl=0
		_fw=0
		while _fw < _tj and _kl <=_se
			_lg=close[_fw]<=_ay and close[_fw]>=_ah
			_qp=_lg and high[_fw]<=_ay+_cg and low[_fw]>=_ah-_cg
			if _lg
				_kl:=math.max(0,_kl-1)
				if _qp and _fw+1 >=_ph
					_tx:=_fw+1
			else
				_kl+=1
			_fw+=1
	_tx
_cf=ta.atr(_ji)
_ja=not na(_cf)and _cf > 0
_fr=_kg=='Wick beyond'
_js=_mq=='Wick reaches'
_mp=_jz=='Live bar'
_ez=_mp or barstate.isconfirmed
_fi=_ht(_ij)
_jt=_ht(_ir)
_x=chart.bg_color
_u=_bd(_en,_x,_bx)
_ey=_bd(_by,_x,_bx)
_ev=_bd(_cb,_x,_bx)
_gh=_bd(_en,_x,_dc)
_ex=_bd(_by,_x,_dc)
_eu=_bd(_cb,_x,_dc)
_fh(simple int len)=>
	_ro=ta.percentile_linear_interpolation(high,len,_dv)
	_or=ta.percentile_linear_interpolation(low,len,100.0-_dv)
	_rh=ta.highest(high,len)
	_oo=ta.lowest(low,len)
	_qq=ta.highest(math.max(open,close),len)
	_mi=ta.lowest(math.min(open,close),len)
	top=_bl=='Absolute extremes'?_rh:_bl=='Body extremes'?_qq:_ro
	_jr=_bl=='Absolute extremes'?_oo:_bl=='Body extremes'?_mi:_or
	_dh=top-_jr
	_mc=_ja and _dh > 0?_dh/(_cf*math.sqrt(len)):99.0
	_qf=bar_index < 1?_ds:int(math.max(1,math.min(_ds,bar_index-_ji)))
	_tv=ta.percentrank(_mc,_qf)
	_ts=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_to=_dh > 0?math.abs(_ts)*len/_dh:99.0
	_cj=math.avg(top,_jr)
	_cg=_dy*nz(_cf)
	_kz=0
	_oa=0
	_hy=0
	_kv=0
	for i=0 to len-1
		if(close[i]> _cj)!=(close[i+1]> _cj)
			_kz+=1
		_lw=_js?high[i]>=top-_cg:close[i]>=top-_cg
		_in=_js?low[i]<=_jr+_cg:close[i]<=_jr+_cg
		if _lw
			_oa+=1
		if _in
			_hy+=1
		if close[i]<=top and close[i]>=_jr
			_kv+=1
	_ml=_kv/float(len)
	_hb=_ja and not na(_tv)and bar_index > len+5 and _tv <=_hm and _kz >=math.max(3,math.round(_ln*len))and _oa >=_gx and _hy >=_gx and _to <=_ow and _ml >=_do
	[_hb,top,_jr]
bool _hi=false
bool _ig=false
bool _ha=false
float _sm=na
float _sw=na
float _sn=na
float _nv=na
float _nm=na
float _nz=na
if _ch
	[qa,ta_,ba]=_fh(_bf)
	_hi:=qa
	_sm:=ta_
	_nv:=ba
	if _cm !='Base only'
		[qb,tb,bb]=_fh(_bf*2)
		_ig:=qb
		_sw:=tb
		_nm:=bb
	if _cm=='Base + 2x + 3x'
		[qc,tc,bc]=_fh(_bf*3)
		_ha:=qc
		_sn:=tc
		_nz:=bc
_ee=_cm !='Base only' and _ig
_eb=_cm=='Base + 2x + 3x' and _ha
_hb=_hi or _ee or _eb
_mr=_eb?_bf*3:_ee?_bf*2:_bf
_nl=_eb?_sn:_ee?_sw:_sm
_ic=_eb?_nz:_ee?_nm:_nv
var array<box> _ap=array.new<box>()
var box _v=na
var line _h=na
var line _k=na
var line _z=na
var label _aa=na
var label _aq=na
var float _e=na
var float _a=na
var int _c=na
var int _ft=na
var bool _w=false
var bool _l=false
var bool _ax=false
var int _di=na
var int _r=0
var float _q=na
var int _av=na
var int _at=0
_bv=false
_ce=false
_be=false
_br=false
if _ez and _at > 0
	_at-=1
if _ez and not _w and not _ax and _at <=0 and _hb
	_mu=_od(_mr,_nl,_ic,_dy*_cf)
	_c:=bar_index-_mu+1
	_ft:=bar_index
	_e:=_nl
	_a:=_ic
	_w:=true
	_l:=false
	_cj=math.avg(_e,_a)
	_bo=_a+(_e-_a)*0.25
	_au=_a+(_e-_a)*0.75
	_v:=box.new(_c,_e,bar_index,_a,border_color=color.new(_u,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_of(_ap,_c,_e,_a)
	if _gb
		_h:=line.new(_c,_cj,bar_index,_cj,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _is
		_k:=line.new(_c,_bo,bar_index,_bo,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_z:=line.new(_c,_au,bar_index,_au,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gc
		_aa:=label.new(_c,_e,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bs,style=label.style_label_down,textcolor=color.new(_u,10),size=_fi)
	_bv:=true
if _w and _ez
	_cn=_hl*_cf
	_ew=_jy*_cf
	if _gf and not _fr and close <=_e and close >=_a
		if high > _e and high <=_e+_ew
			_e:=high
		if low < _a and low >=_a-_ew
			_a:=low
	_nk=_fr?high > _e+_cn:close > _e+_cn
	_jv=_fr?low < _a-_cn:close < _a-_cn
	_oi=_ep > 0 and bar_index-_ft+1 >=_ep
	if _nk or _jv or _oi
		_b=_nk?1:_jv?-1:0
		_pg=_b !=0?bar_index-_c:bar_index-_c+1
		_lu=_a !=0?(_e-_a)/_a*100.0:0.0
		_io=_ge and _b !=0 and _l
		if _l
			_em=_b==1?_ey:_b==-1?_ev:_u
			_mn=_b==1?_ex:_b==-1?_eu:_gh
			_gv=_b==1?_by:_b==-1?_cb:_en
			box.set_lefttop(_v,_c,_e)
			box.set_rightbottom(_v,bar_index,_a)
			box.set_border_color(_v,color.new(_em,30))
			box.set_border_style(_v,line.style_dotted)
			_fm(_ap,_e,_a,_c,bar_index,na)
			_bb.push(Rango.new(_c,bar_index,_e,_a,_mn))
			if _bb.size()> 8
				_bb.shift()
			if not na(_h)
				line.set_x2(_h,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
