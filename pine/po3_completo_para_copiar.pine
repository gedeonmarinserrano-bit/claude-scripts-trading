var float _ik=na
var float _jr=na
var int _ho=na
var float _ga=na
var float _ig=na
var float _ih=na
var array<line> _gj=array.new<line>()
var array<label> _gk=array.new<label>()
_dr(float y,float _vj,float c,float _no,bool _od)=>
	_us=_od?y > _vj:y < _vj
	_vg=_od?c > _no:c < _no
	not na(_vj)and not na(_no)and not na(c)and _us !=_vg
_gc(string t,float c,float _no)=>
	t+(c > _no?" ↑":c < _no?" ↓":" =")
_kt(int x1,float y1,int xv,string txt,color col,bool _od)=>
	yv=_od?high[bar_index-xv]:low[bar_index-xv]
	if _rm
		_gj.push(line.new(x1,y1,xv,yv,color=col))
