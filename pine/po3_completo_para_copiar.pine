_kj=input.color(#8D6E63,"Color niveles H1",group=_pn)
_qw=input.bool(false,"Niveles clave: alto/bajo del día anterior",group=_pn)
_dn=input.color(#424242,"Color niveles clave",group=_pn)
_ns=input.color(#757575,"Color horas",group=_pn)
_eg=input.bool(true,"Mostrar EMAs",group="EMAs")
_ny=input.int(9,"EMA rápida",minval=1,group="EMAs")
_ou=input.int(20,"EMA media",minval=1,group="EMAs")
_or=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oh=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_pg=input.color(#2962FF,"Color EMA media",group="EMAs")
_ow=input.color(#363A45,"Color EMA lenta",group="EMAs")
_ih=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_is=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fv=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kq=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_um=14
_sr=50
_tn=0.15
_qx=2.5
_qr=30
_pu=1.0
_lh=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_pf="Colores"
_ad=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_pf)
_t=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_pf)
_nb=input.bool(true,"Marcar la vela del OB",group=_pf)
_hm=input.color(#FF00C8,"IFVG (magenta)",group=_pf)
_mx=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_pf)
_ku=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_pf)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _bh=na
	int _sd=na
	bool _lt=false
var _hh=array.new<Zona>()
var _iy=array.new<Zona>()
var obs=array.new<Zona>()
var _xq=array.new<Zona>()
var _wa=array.new<Zona>()
var _qz=array.new<Zona>()
var _qq=array.new<Zona>()
var _ky=array.new<Zona>()
var _xm=array.new<Zona>()
var _tq=array.new<Zona>()
var _qb=array.new<Zona>()
var _pj=array.new<Zona>()
var _mc=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bk=array.new<Rango>()
_et(Zona z)=>
	_fl=z.dir==1?low <=z._ah:high >=z._ag
	if not _fl
		_bh=na(z._bh)?(z.dir==1?z._ag:z._ah):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_fl
type Marca
	label lb
	line ln
	int bar
var _hs=array.new<Marca>()
var array<string> _fc=array.from("")
var array<int> _fb=array.from(0)
_ai(label lb,line ln,int bar)=>
	_hs.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fc.set(0,lb.get_text())
		_fb.set(0,bar)
	if _hs.size()> 500
		_hs.shift()
_ra=ta.ema(close,_ny)
_rh=ta.ema(close,_ou)
_jk=ta.ema(close,_or)
_cz=ta.atr(_um)
var string _ty='════════ Detection ════════'
var string _rf='════════ Structure Filters ════════'
var string _vt='════════ Range Behavior ════════'
var string _ua='════════ Visual Settings ════════'
_cp='Base + 2x + 3x'
_os='Rangos'
_bj=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_os)
_bp='Percentile band'
_ej=90.0
_mi='Bar close'
_ks=200
_jp=40.0
_ep=500
_nf=0.18
_oo='Wick reaches'
_jq=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_os)
_ef=0.10
_sa=0.45
_eo=0.70
_ip='Extend to containment'
_hu=300
_kd=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_os)
_hf=true
_ly=0.25
_lw='Close beyond'
_jb=0.15
_hd=true
_hb=10
_mk=3
_fy=0
_mq='Custom'
_mf=#00A651
_mg=#E4002B
_fe=input.color(#F9A825,'Color del rango (neutral)',group=_os)
_jx=4
_gk=93
_hj=true
_ka=true
_hg=input.bool(true,'Mostrar etiqueta del rango',group=_os)
_jt=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_os)
_jh=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_os)
_in='Small'
_fa=true
_kc='Small'
[_ch,_cf]=switch _mq
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_mf,_mg]
var color _cc=color.new(color.black,100)
var float _cg=3.0
var float _dr=1.6
_ig(string _wk)=>
	switch _wk
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ff(color _di)=>
	_js=color.r(_di)/255.0
	_jd=color.g(_di)/255.0
	_if=color.b(_di)/255.0
	_tu=_js <=0.03928?_js/12.92:math.pow((_js+0.055)/1.055,2.4)
	_te=_jd <=0.03928?_jd/12.92:math.pow((_jd+0.055)/1.055,2.4)
	_tw=_if <=0.03928?_if/12.92:math.pow((_if+0.055)/1.055,2.4)
	0.2126*_tu+0.7152*_te+0.0722*_tw
_lq(color _ox,color _mp)=>
	_ne=_ff(_ox)
	_kl=_ff(_mp)
	(math.max(_ne,_kl)+0.05)/(math.min(_ne,_kl)+0.05)
_eq(color _hp)=>
	_ff(_hp)> 0.179?#000000:#ffffff
_oc(color _di,color _mt,float _so)=>
	color.rgb(color.r(_di)+(color.r(_mt)-color.r(_di))*_so,color.g(_di)+(color.g(_mt)-color.g(_di))*_so,color.b(_di)+(color.b(_mt)-color.b(_di))*_so)
_bn(color _di,color _hp,float _nx)=>
	_mt=_eq(_hp)
	_lj=_di
	for step=1 to 10
		if _lq(_lj,_hp)>=_nx
			break
		_lj:=_oc(_di,_mt,step/10.0)
	_lj
_jl(float _yb)=>
	str.tostring(_yb,'#.##')+'%'
_qo(array<box> _jy,int _lg,float _bg,float _aj)=>
	array.clear(_jy)
	if not _ku
		for i=0 to _jx-1
			array.push(_jy,box.new(_lg,_bg,bar_index,_aj,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_ge(array<box> _jy,float _bg,float _aj,int _lg,int _sk,color _nw)=>
	_pk=array.size(_jy)
	if _pk > 0 and _bg > _aj
		_gu=(_bg-_aj)/_pk
		for i=0 to _pk-1
			_io=array.get(_jy,i)
			_oi=math.abs((i+0.5)/_pk-0.5)*2.0
			_on=int(math.min(99,math.max(0,_gk+(1.0-_oi)*10)))
			box.set_lefttop(_io,_lg,_bg-_gu*i)
			box.set_rightbottom(_io,_sk,_bg-_gu*(i+1))
			box.set_bgcolor(_io,color.new(_nw,_on))
_pd(array<box> _jy)=>
	if array.size(_jy)> 0
		for i=0 to array.size(_jy)-1
			box.delete(array.get(_jy,i))
	array.clear(_jy)
_rd(int _sh,float _bg,float _aj,float _co)=>
	_yg=_sh
	if _ip=='Extend to containment'
		_xy=math.min(_hu,bar_index)
		_vn=math.max(2,math.round((1.0-_eo)*_sh))
		_ll=0
		_gr=0
		while _gr < _xy and _ll <=_vn
			_mr=close[_gr]<=_bg and close[_gr]>=_aj
			_tp=_mr and high[_gr]<=_bg+_co and low[_gr]>=_aj-_co
			if _mr
				_ll:=math.max(0,_ll-1)
				if _tp and _gr+1 >=_sh
					_yg:=_gr+1
			else
				_ll+=1
			_gr+=1
	_yg
_cn=ta.atr(_ks)
_kt=not na(_cn)and _cn > 0
_gp=_lw=='Wick beyond'
_kr=_oo=='Wick reaches'
_ot=_mi=='Live bar'
_fp=_ot or barstate.isconfirmed
_gl=_ig(_in)
_le=_ig(_kc)
_w=chart.bg_color
_r=_bn(_fe,_w,_cg)
_fm=_bn(_ch,_w,_cg)
_fu=_bn(_cf,_w,_cg)
_ha=_bn(_fe,_w,_dr)
_fq=_bn(_ch,_w,_dr)
_fo=_bn(_cf,_w,_dr)
_gi(simple int len)=>
	_uq=ta.percentile_linear_interpolation(high,len,_ej)
	_qu=ta.percentile_linear_interpolation(low,len,100.0-_ej)
	_ve=ta.highest(high,len)
	_qy=ta.lowest(low,len)
	_sz=ta.highest(math.max(open,close),len)
	_oa=ta.lowest(math.min(open,close),len)
	top=_bp=='Absolute extremes'?_ve:_bp=='Body extremes'?_sz:_uq
	_kp=_bp=='Absolute extremes'?_qy:_bp=='Body extremes'?_oa:_qu
	_dw=top-_kp
	_nv=_kt and _dw > 0?_dw/(_cn*math.sqrt(len)):99.0
	_tg=bar_index < 1?_ep:int(math.max(1,math.min(_ep,bar_index-_ks)))
	_yq=ta.percentrank(_nv,_tg)
	_xs=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_yc=_dw > 0?math.abs(_xs)*len/_dw:99.0
	_ct=math.avg(top,_kp)
	_co=_ef*nz(_cn)
	_nc=0
	_ps=0
	_ht=0
	_nk=0
	for i=0 to len-1
		if(close[i]> _ct)!=(close[i+1]> _ct)
			_nc+=1
		_pi=_kr?high[i]>=top-_co:close[i]>=top-_co
		_jw=_kr?low[i]<=_kp+_co:close[i]<=_kp+_co
		if _pi
			_ps+=1
		if _jw
			_ht+=1
		if close[i]<=top and close[i]>=_kp
			_nk+=1
	_op=_nk/float(len)
	_jo=_kt and not na(_yq)and bar_index > len+5 and _yq <=_jp and _nc >=math.max(3,math.round(_nf*len))and _ps >=_jq and _ht >=_jq and _yc <=_sa and _op >=_eo
	[_jo,top,_kp]
bool _hy=false
bool _ic=false
bool _jc=false
float _wi=na
float _xc=na
float _wf=na
float _qa=na
float _qd=na
float _pw=na
if _au
	[qa,ta_,ba]=_gi(_bj)
	_hy:=qa
	_wi:=ta_
	_qa:=ba
	if _cp !='Base only'
		[qb,tb,bb]=_gi(_bj*2)
		_ic:=qb
		_xc:=tb
		_qd:=bb
	if _cp=='Base + 2x + 3x'
		[qc,tc,bc]=_gi(_bj*3)
		_jc:=qc
		_wf:=tc
		_pw:=bc
_ev=_cp !='Base only' and _ic
_eu=_cp=='Base + 2x + 3x' and _jc
_jo=_hy or _ev or _eu
_ph=_eu?_bj*3:_ev?_bj*2:_bj
_pv=_eu?_wf:_ev?_xc:_wi
_ir=_eu?_pw:_ev?_qd:_qa
var array<box> _ar=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _x=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _gq=na
var bool _v=false
var bool _m=false
var bool _bc=false
var int _ds=na
var int _p=0
var float _q=na
var int _aw=na
var int _ay=0
_cd=false
_cl=false
_bl=false
_cb=false
if _fp and _ay > 0
	_ay-=1
if _fp and not _v and not _bc and _ay <=0 and _jo
	_oe=_rd(_ph,_pv,_ir,_ef*_cn)
	_c:=bar_index-_oe+1
	_gq:=bar_index
	_f:=_pv
	_a:=_ir
	_v:=true
	_m:=false
	_ct=math.avg(_f,_a)
	_bw=_a+(_f-_a)*0.25
	_bd=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qo(_ar,_c,_f,_a)
	if _hj
		_g:=line.new(_c,_ct,bar_index,_ct,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _ka
		_k:=line.new(_c,_bw,bar_index,_bw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_x:=line.new(_c,_bd,bar_index,_bd,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hg
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cc,style=label.style_label_down,textcolor=color.new(_r,10),size=_gl)
	_cd:=true
if _v and _fp
	_cq=_jb*_cn
	_fs=_ly*_cn
	if _hf and not _gp and close <=_f and close >=_a
		if high > _f and high <=_f+_fs
			_f:=high
		if low < _a and low >=_a-_fs
			_a:=low
	_qj=_gp?high > _f+_cq:close > _f+_cq
	_kk=_gp?low < _a-_cq:close < _a-_cq
	_qs=_fy > 0 and bar_index-_gq+1 >=_fy
	if _qj or _kk or _qs
		_b=_qj?1:_kk?-1:0
		_sc=_b !=0?bar_index-_c:bar_index-_c+1
		_no=_a !=0?(_f-_a)/_a*100.0:0.0
		_kb=_hd and _b !=0 and _m
		if _m
			_fg=_b==1?_fm:_b==-1?_fu:_r
			_pe=_b==1?_fq:_b==-1?_fo:_ha
			_hw=_b==1?_ch:_b==-1?_cf:_fe
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_fg,30))
			box.set_border_style(_u,line.style_dotted)
			_ge(_ar,_f,_a,_c,bar_index,na)
			_bk.push(Rango.new(_c,bar_index,_f,_a,_pe))
			if _bk.size()> 8
				_bk.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_x,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sc)+' BARS   '+_jl(_no))
				label.set_textcolor(_z,color.new(_fg,10))
			if _jt and _b !=0
				_ob=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fa
