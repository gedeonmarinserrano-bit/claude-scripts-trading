_mh()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_vp(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_bw(array<Zona> arr,float _ag,float _ah,int dir,int _vn,int _wf)=>
	if _ag-_ah >=_gm(_wf)
		z=Zona.new(_vp(_vn),_ag,_ah,dir)
		if not _es(z)
			arr.push(z)
			if arr.size()> _gi
				arr.shift()
_bp(array<Zona> arr,array<Zona> _dv)=>
	_xt=false
	if _dv.size()> 0
		for i=_dv.size()-1 to 0
			if _es(_dv.get(i))
				_dv.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_tf=(z._ag+z._ah)/2
			if low <=_tf and high >=_tf
				_xt:=true
			_jg=na(z._bh)and(z.dir==1?(open >=z._ag and close < z._ah):(open <=z._ah and close > z._ag))
			if _jg
				arr.remove(i)
				_dv.push(Zona.new(z.x1,z._ag,z._ah,-z.dir,na,bar_index))
				if _dv.size()> _gi
					_dv.shift()
			else if _es(z)
				arr.remove(i)
	_xt
