_eb(array<label> etq,bool _ri,int _tr)=>
	_oz=_tr
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xx=ys.sort_indices()
		_tl=array.new<float>()
		_sj=array.new<int>()
		_pi=array.new<int>()
		_ux=timeframe.in_seconds()*1000
		for j in _xx
			e=etq.get(j)
			y=e.get_y()
			_su=str.length(e.get_text())+2
			ini=_tr
			for _vf=0 to 6
				_sm=false
				if _tl.size()> 0
					for c=0 to _tl.size()-1
						if math.abs(_tl.get(c)-y)< _ir and ini < _pi.get(c)and ini+_su > _sj.get(c)
							ini:=_pi.get(c)
							_sm:=true
				if not _sm
					break
			_tl.push(y)
			_sj.push(ini)
			_pi.push(ini+_su)
			_oz:=math.max(_oz,ini+_su)
			if _ri
				e.set_x(time+ini*_ux)
			else
				e.set_x(bar_index+ini)
	_oz
if barstate.islast
	_ma=array.new<label>()
	for o in _en
		if not na(o)and not na(o.lb)
			_ma.push(o.lb)
	for q in _o
		q.ln.set_x2(bar_index)
		_ma.push(q.lb)
	_pf=array.new<label>()
	for n in _df
		_pf.push(n.lb)
	for n in _de
		_pf.push(n.lb)
	_uq=_eb(_ma,false,1)
	_eb(_pf,true,_ma.size()> 0?_uq:1)
