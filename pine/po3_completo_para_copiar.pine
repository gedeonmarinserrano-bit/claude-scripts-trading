indicator("Po3 + CHoCH PRO - High Contrast + FVG + Rangos + OB",overlay=true,max_labels_count=500,max_lines_count=500,max_boxes_count=500,max_bars_back=2000,behind_chart=true)
_cw="Panel de información"
_ln=input.bool(true,"Mostrar panel",group=_cw)
_hl=input.string("Arriba derecha","Posición",options=["Arriba derecha","Arriba izquierda","Abajo derecha","Abajo izquierda"],group=_cw)
_mb=input.string("Pequeño","Tamaño del texto",options=["Muy pequeño","Pequeño","Normal"],group=_cw)
_od=input.bool(true,"Movimiento esperado del día (VIX / 16)",group=_cw)
_ts=input.symbol("CBOE:VIX","Índice de volatilidad (para el Nasdaq también vale CBOE:VXN)",group=_cw)
_kt=input.bool(true,"Rangos de Asia y Londres (alto, bajo y si se han barrido)",group=_cw)
_oy=input.bool(true,"Rango de hoy frente al ATR diario",group=_cw)
_fd=input.bool(true,"Precio frente a la apertura del día (premium / descuento)",group=_cw)
_kr=input.bool(true,"Liquidez más cercana por arriba y por abajo",group=_cw)
_pq=input.string("","Noticias de hoy (texto libre, p. ej. «CPI 14:30»; vacío = no se muestra)",group=_cw)
_lp="Información en el gráfico"
_ld=input.bool(true,"Fondo suave en las sesiones de Asia, Londres y apertura de Nueva York",group=_lp)
_to=input.bool(true,"Línea del 50 % del día anterior (por encima premium, por debajo descuento)",group=_lp)
_rj=input.bool(true,"Altos y bajos iguales sin barrer (EQH / EQL)",group=_lp)
_lr=input.bool(true,"Marcar barridos de niveles (pasa el nivel y cierra de vuelta)",group=_lp)
_cu="FVG por temporalidad (solo se ven los activados)"
_ao=input.bool(true,"FVG H4",inline="fvgtf1",group=_cu)
_az=input.bool(true,"FVG H1",inline="fvgtf1",group=_cu)
_aw=input.bool(true,"FVG M15",inline="fvgtf1",group=_cu)
_bt=input.bool(true,"FVG M5",inline="fvgtf2",group=_cu)
_cr=input.bool(false,"FVG M1",inline="fvgtf2",group=_cu)
_nt=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_cu)
_m=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_cu)
_gb=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cu)
_lh=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cu)
_pt=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cu)
_ny="Estructura (CHoCH / BOS)"
_cb=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_ny)
_sp=1.1
_ty=2.0
_uj=20
_sg=2
_mq=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_ny)
_it=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_ny)
_hx=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_ny)
_ii=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_ny)
_eh=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_ny)
_qf=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_ny)
_bf=bar_index >=last_bar_index-_qf
_ck=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mv=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_ah=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_uf="Order Blocks"
_kp=input.bool(true,"Mostrar Order Blocks",group=_uf)
_fe=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_uf)
_lw=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_uf)
_vw=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_uf)
_mj=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_uf)
_ju=input.color(#1565C0,"OB alcista (demanda)",group=_uf)
_jz=input.color(#EF6C00,"OB bajista (oferta)",group=_uf)
_rw="Estrategia NY (Bias + PO3)"
_kx=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_rw)
_kk=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_rw)
_tb="Colores FVG"
_an=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_tb)
_am=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_tb)
_rf=_an
_mn=_an
_lx=_an
_jv=_an
_ke=_an
_is=_an
_ri=_am
_ly=_am
_mp=_am
_kj=_am
_ko=_am
_ht=_am
_jo=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_rw)
_df=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_rw)
_pw=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_rw)
_qh=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_rw)
_dg=input.color(#424242,"Color niveles clave",group=_rw)
_mi=input.color(#757575,"Color horas",group=_rw)
_ej=input.bool(true,"Mostrar EMAs",group="EMAs")
_og=input.int(9,"EMA rápida",minval=1,group="EMAs")
_nn=input.int(20,"EMA media",minval=1,group="EMAs")
_ob=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oi=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_nv=input.color(#9E9D24,"Color EMA media",group="EMAs")
_ok=input.color(color.black,"Color EMA lenta",group="EMAs")
_hn=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_je=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fk=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_jy=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_tv=14
_qz=50
_sb=0.15
_py=2.5
_qc=30
_pm=1.0
_la=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_nj="Colores"
_aa=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_nj)
_s=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_nj)
_lv=input.bool(true,"Marcar la vela del OB",group=_nj)
_hd=input.color(#FF00C8,"IFVG (magenta)",group=_nj)
_mt=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_nj)
_kb=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_nj)
type Zona
	int x1
	float _af
	float _ag
	int dir
	float _be=na
	int _rt=na
	bool _kz=false
var _gt=array.new<Zona>()
var _id=array.new<Zona>()
var obs=array.new<Zona>()
var _wy=array.new<Zona>()
var _ux=array.new<Zona>()
var _pv=array.new<Zona>()
var _qb=array.new<Zona>()
var _kg=array.new<Zona>()
var _vh=array.new<Zona>()
var _sj=array.new<Zona>()
var _ow=array.new<Zona>()
var _pa=array.new<Zona>()
var _kw=array.new<Zona>()
type Rango
	int x1
	int x2
	float _af
	float _ag
	color col
var _bk=array.new<Rango>()
_el(Zona z)=>
	_fg=z.dir==1?low <=z._ag:high >=z._af
	if not _fg
		_be=na(z._be)?(z.dir==1?z._af:z._ag):z._be
		if z.dir==1?low < _be:high > _be
			z._be:=z.dir==1?low:high
	_fg
type Marca
	label lb
	line ln
	int bar
var _ic=array.new<Marca>()
var array<string> _et=array.from("")
var array<int> _er=array.from(0)
_aj(label lb,line ln,int bar)=>
	_ic.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_et.set(0,lb.get_text())
		_er.set(0,bar)
	if _ic.size()> 500
		_ic.shift()
_pz=ta.ema(close,_og)
_rg=ta.ema(close,_nn)
_hu=ta.ema(close,_ob)
_cz=ta.atr(_tv)
var string _tg='════════ Detection ════════'
var string _qo='════════ Structure Filters ════════'
var string _tp='════════ Range Behavior ════════'
var string _td='════════ Visual Settings ════════'
_cq='Base + 2x + 3x'
_om='Rangos'
_bl=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_om)
_bq='Percentile band'
_ef=90.0
_ku='Bar close'
_jt=200
_ib=40.0
_dz=500
_mo=0.18
_nz='Wick reaches'
_ij=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_om)
_eg=0.10
_qy=0.45
_ec=0.70
_hi='Extend to containment'
_if=300
_jj=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_om)
_gu=true
_ks=0.25
_lm='Close beyond'
_ja=0.15
_gq=true
_gr=10
_kv=3
_fr=0
_mc='Custom'
_ky=#00A651
_lo=#E4002B
_fa=input.color(#F9A825,'Color del rango (neutral)',group=_om)
_jp=4
_gd=93
_gy=true
_js=true
_gz=input.bool(true,'Mostrar etiqueta del rango',group=_om)
_ji=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_om)
_hh=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_om)
_ih='Small'
_eq=true
_jn='Small'
[_ce,_cd]=switch _mc
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_ky,_lo]
var color _ca=color.new(color.black,100)
var float _cf=3.0
var float _ds=1.6
_iq(string _vs)=>
	switch _vs
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ez(color _de)=>
	_ix=color.r(_de)/255.0
	_hg=color.g(_de)/255.0
	_hk=color.b(_de)/255.0
	_ry=_ix <=0.03928?_ix/12.92:math.pow((_ix+0.055)/1.055,2.4)
	_sh=_hg <=0.03928?_hg/12.92:math.pow((_hg+0.055)/1.055,2.4)
	_st=_hk <=0.03928?_hk/12.92:math.pow((_hk+0.055)/1.055,2.4)
	0.2126*_ry+0.7152*_sh+0.0722*_st
_lq(color _nq,color _lz)=>
	_my=_ez(_nq)
	_jx=_ez(_lz)
	(math.max(_my,_jx)+0.05)/(math.min(_my,_jx)+0.05)
_dx(color _hc)=>
	_ez(_hc)> 0.179?#000000:#ffffff
_nc(color _de,color _na,float _qp)=>
	color.rgb(color.r(_de)+(color.r(_na)-color.r(_de))*_qp,color.g(_de)+(color.g(_na)-color.g(_de))*_qp,color.b(_de)+(color.b(_na)-color.b(_de))*_qp)
_bg(color _de,color _hc,float _ol)=>
	_na=_dx(_hc)
	_lf=_de
	for step=1 to 10
		if _lq(_lf,_hc)>=_ol
			break
		_lf:=_nc(_de,_na,step/10.0)
	_lf
_jc(float _wp)=>
	str.tostring(_wp,'#.##')+'%'
_qa(array<box> _jl,int _li,float _av,float _ai)=>
	array.clear(_jl)
	if not _kb
		for i=0 to _jp-1
			array.push(_jl,box.new(_li,_av,bar_index,_ai,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_fw(array<box> _jl,float _av,float _ai,int _li,int _qx,color _on)=>
	_ov=array.size(_jl)
	if _ov > 0 and _av > _ai
		_gg=(_av-_ai)/_ov
		for i=0 to _ov-1
			_jb=array.get(_jl,i)
			_oj=math.abs((i+0.5)/_ov-0.5)*2.0
			_nw=int(math.min(99,math.max(0,_gd+(1.0-_oj)*10)))
			box.set_lefttop(_jb,_li,_av-_gg*i)
			box.set_rightbottom(_jb,_qx,_av-_gg*(i+1))
			box.set_bgcolor(_jb,color.new(_on,_nw))
_oh(array<box> _jl)=>
	if array.size(_jl)> 0
		for i=0 to array.size(_jl)-1
			box.delete(array.get(_jl,i))
	array.clear(_jl)
_qd(int _qm,float _av,float _ai,float _cl)=>
	_xn=_qm
	if _hi=='Extend to containment'
		_wz=math.min(_if,bar_index)
		_tm=math.max(2,math.round((1.0-_ec)*_qm))
		_ls=0
		_gl=0
		while _gl < _wz and _ls <=_tm
			_mw=close[_gl]<=_av and close[_gl]>=_ai
			_sq=_mw and high[_gl]<=_av+_cl and low[_gl]>=_ai-_cl
			if _mw
				_ls:=math.max(0,_ls-1)
				if _sq and _gl+1 >=_qm
					_xn:=_gl+1
			else
				_ls+=1
			_gl+=1
	_xn
_cm=ta.atr(_jt)
_kq=not na(_cm)and _cm > 0
_fx=_lm=='Wick beyond'
_kh=_nz=='Wick reaches'
_nh=_ku=='Live bar'
_fo=_nh or barstate.isconfirmed
_fy=_iq(_ih)
_kd=_iq(_jn)
_x=chart.bg_color
_r=_bg(_fa,_x,_cf)
_fl=_bg(_ce,_x,_cf)
_fi=_bg(_cd,_x,_cf)
_gv=_bg(_fa,_x,_ds)
_ft=_bg(_ce,_x,_ds)
_fu=_bg(_cd,_x,_ds)
_ga(simple int len)=>
	_ur=ta.percentile_linear_interpolation(high,len,_ef)
	_qg=ta.percentile_linear_interpolation(low,len,100.0-_ef)
	_un=ta.highest(high,len)
	_qi=ta.lowest(low,len)
	_sm=ta.highest(math.max(open,close),len)
	_ns=ta.lowest(math.min(open,close),len)
	top=_bq=='Absolute extremes'?_un:_bq=='Body extremes'?_sm:_ur
	_km=_bq=='Absolute extremes'?_qi:_bq=='Body extremes'?_ns:_qg
	_di=top-_km
	_oo=_kq and _di > 0?_di/(_cm*math.sqrt(len)):99.0
	_sy=bar_index < 1?_dz:int(math.max(1,math.min(_dz,bar_index-_jt)))
	_xa=ta.percentrank(_oo,_sy)
	_wu=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_wx=_di > 0?math.abs(_wu)*len/_di:99.0
	_co=math.avg(top,_km)
	_cl=_eg*nz(_cm)
	_mz=0
	_pn=0
	_hr=0
	_mu=0
	for i=0 to len-1
		if(close[i]> _co)!=(close[i+1]> _co)
			_mz+=1
		_ng=_kh?high[i]>=top-_cl:close[i]>=top-_cl
		_jm=_kh?low[i]<=_km+_cl:close[i]<=_km+_cl
		if _ng
			_pn+=1
		if _jm
			_hr+=1
		if close[i]<=top and close[i]>=_km
			_mu+=1
	_nr=_mu/float(len)
	_jg=_kq and not na(_xa)and bar_index > len+5 and _xa <=_ib and _mz >=math.max(3,math.round(_mo*len))and _pn >=_ij and _hr >=_ij and _wx <=_qy and _nr >=_ec
	[_jg,top,_km]
bool _ig=false
bool _ik=false
bool _hs=false
float _vm=na
float _vq=na
float _vy=na
float _ps=na
float _po=na
float _oq=na
if _bf
	[qa,ta_,ba]=_ga(_bl)
	_ig:=qa
	_vm:=ta_
	_ps:=ba
	if _cq !='Base only'
		[qb,tb,bb]=_ga(_bl*2)
		_ik:=qb
		_vq:=tb
		_po:=bb
	if _cq=='Base + 2x + 3x'
		[qc,tc,bc]=_ga(_bl*3)
		_hs:=qc
		_vy:=tc
		_oq:=bc
_em=_cq !='Base only' and _ik
_ep=_cq=='Base + 2x + 3x' and _hs
_jg=_ig or _em or _ep
_nf=_ep?_bl*3:_em?_bl*2:_bl
_pi=_ep?_vy:_em?_vq:_vm
_iy=_ep?_oq:_em?_po:_ps
var array<box> _aq=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _w=na
var label _y=na
var label _as=na
var float _f=na
var float _a=na
var int _c=na
var int _gm=na
var bool _t=false
var bool _l=false
var bool _ba=false
var int _dq=na
var int _p=0
var float _o=na
var int _bc=na
var int _bd=0
_bx=false
_ci=false
_bj=false
_bz=false
if _fo and _bd > 0
	_bd-=1
if _fo and not _t and not _ba and _bd <=0 and _jg
	_oe=_qd(_nf,_pi,_iy,_eg*_cm)
	_c:=bar_index-_oe+1
	_gm:=bar_index
	_f:=_pi
	_a:=_iy
	_t:=true
	_l:=false
	_co=math.avg(_f,_a)
	_bw=_a+(_f-_a)*0.25
	_ay=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qa(_aq,_c,_f,_a)
	if _gy
		_g:=line.new(_c,_co,bar_index,_co,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _js
		_k:=line.new(_c,_bw,bar_index,_bw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_ay,bar_index,_ay,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gz
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_ca,style=label.style_label_down,textcolor=color.new(_r,10),size=_fy)
	_bx:=true
if _t and _fo
	_cp=_ja*_cm
	_fn=_ks*_cm
	if _gu and not _fx and close <=_f and close >=_a
		if high > _f and high <=_f+_fn
			_f:=high
		if low < _a and low >=_a-_fn
			_a:=low
	_pe=_fx?high > _f+_cp:close > _f+_cp
	_ka=_fx?low < _a-_cp:close < _a-_cp
	_qk=_fr > 0 and bar_index-_gm+1 >=_fr
	if _pe or _ka or _qk
		_b=_pe?1:_ka?-1:0
		_rs=_b !=0?bar_index-_c:bar_index-_c+1
		_mm=_a !=0?(_f-_a)/_a*100.0:0.0
		_jq=_gq and _b !=0 and _l
		if _l
			_ex=_b==1?_fl:_b==-1?_fi:_r
			_nb=_b==1?_ft:_b==-1?_fu:_gv
			_hz=_b==1?_ce:_b==-1?_cd:_fa
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_ex,30))
			box.set_border_style(_u,line.style_dotted)
			_fw(_aq,_f,_a,_c,bar_index,na)
			_bk.push(Rango.new(_c,bar_index,_f,_a,_nb))
			if _bk.size()> 8
				_bk.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_rs)+' BARS   '+_jc(_mm))
				label.set_textcolor(_y,color.new(_ex,10))
			if _ji and _b !=0
				_of=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _eq
					_as:=label.new(bar_index,_b==1?low:high,_b==1?'▲':'▼',xloc=xloc.bar_index,yloc=yloc.price,color=_ca,style=_b==1?label.style_label_up:label.style_label_down,textcolor=color.new(_ex,20),size=_kd,tooltip='Breakout del rango')
				else
					_as:=label.new(bar_index,_b==1?low:high,_of,xloc=xloc.bar_index,yloc=yloc.price,color=color.new(_hz,10),style=_b==1?label.style_label_up:label.style_label_down,textcolor=_dx(_hz),size=_fy)
			if _b==1
				_ci:=true
