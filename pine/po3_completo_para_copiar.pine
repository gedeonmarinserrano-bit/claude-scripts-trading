type NivelSes
	line ln
	label lb
	float _aa
	int _xo=na
	int k=0
	int _wi=na
var array<NivelSes> _es=array.new<NivelSes>(6)
var array<NivelSes> _s=array.new<NivelSes>()
_ej(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_de(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_ro=(dir==1?"Máximo ":"Mínimo ")+ses
	o=_es.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _s.size()> 0
			for i=_s.size()-1 to 0
				q=_s.get(i)
				if q.k==k
					_s.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_ej(bar_index,v,_ro,col)
		_es.set(k,NivelSes.new(ln,lb,v,na,k,bar_index))
	else if not na(o)
		if en and not na(o.ln)
			o._aa:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if na(o.ln)
			if dir==1?high > o._aa:low < o._aa
				o._aa:=dir==1?high:low
				o._wi:=bar_index
			if bar_index-o._xo >=5
				dup=false
				for j=0 to 5
					p=_es.get(j)
					if j !=k and not na(p)and not na(p.ln)and math.abs(p._aa-o._aa)<=0.1*nz(_cj)
						dup:=true
				if dup
					_es.set(k,na)
				else
					[ln,lb]=_ej(o._wi,o._aa,_ro,col)
					o.ln:=ln
					o.lb:=lb
					o.lb.set_xy(bar_index,o._aa)
		else if dir==1?high > o._aa:low < o._aa
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._aa)
			o.lb.set_text((dir==1?"Máximo manipulado ":"Mínimo manipulado ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			_s.push(o)
			if _s.size()> 24
				q=_s.shift()
				q.ln.delete()
				q.lb.delete()
			_es.set(k,NivelSes.new(na,na,dir==1?high:low,bar_index,k,bar_index))
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._aa)
_md=timeframe.change("D")
if _no and _jp and _bg
	if _md
		for k=0 to 5
			o=_es.get(k)
			if not na(o)and not na(o.ln)
				o.ln.delete()
				o.lb.delete()
			_es.set(k,na)
		for q in _s
			q.ln.delete()
			q.lb.delete()
