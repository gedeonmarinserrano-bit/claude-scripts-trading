		n.ln.delete()
		n.lb.delete()
_ct(array<Nivel> arr)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			n=arr.get(i)
			if(n.dir==1 and close > n._bd)or(n.dir==-1 and close < n._bd)
				arr.remove(i)
				n.ln.delete()
				n.lb.delete()
			else
				n.ln.set_x2(time)
				n.lb.set_x(time)
if _ba and _kd and timeframe.isintraday and _iy < 14400
