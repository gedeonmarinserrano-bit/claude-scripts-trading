_kf=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_pt)
_ue="Colores FVG"
_ap=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_ue)
_ao=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_ue)
_rl=_ap
_no=_ap
