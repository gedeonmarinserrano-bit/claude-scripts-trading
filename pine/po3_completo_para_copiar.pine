_sy=1.1
_ut=2.0
_vc=20
_to=2
_mt=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oq)
_jd=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oq)
_iw=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oq)
_hv=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oq)
_ee=input.bool(false,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oq)
_qs=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oq)
_az=bar_index >=last_bar_index-_qs
_cj=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_nq=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
