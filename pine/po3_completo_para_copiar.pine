	_ny:=l_
	_pk:=hb_
	_pw:=lb_
if _nm and _ci
	[h_,l_,hb_,lb_]=request.security(_ol,timeframe.period,_qf(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_oe:=h_
	_os:=l_
	_pt:=hb_
	_pn:=lb_
_lw=ta.pivothigh(high,_fn,_fn)
_me=ta.pivotlow(low,_fn,_fn)
_ox=bar_index-_fn
var int _gv=na
var float _ez=na
var float _hk=na
var float _hw=na
var int _gt=na
var float _fj=na
var float _hc=na
var float _hs=na
var array<line> _fo=array.new<line>()
var array<label> _fu=array.new<label>()
_dg(float y,float _ti,float c,float _lf,bool _mr)=>
	_sf=_mr?y > _ti:y < _ti
	_tc=_mr?c > _lf:c < _lf
	not na(_ti)and not na(_lf)and not na(c)and _sf !=_tc
_eu(string t,float c,float _lf)=>
	t+(c > _lf?" ↑":c < _lf?" ↓":" =")
_jr(int x1,float y1,int xv,string txt,color col,bool _mr)=>
	yv=_mr?high[bar_index-xv]:low[bar_index-xv]
	if _qg
		_fo.push(line.new(x1,y1,xv,yv,color=col))
	if _kn
		_fu.push(label.new(xv,yv,txt,style=_mr?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_mr?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_mr?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _fo.size()> _pp
		_fo.shift().delete()
	if _fu.size()> _pp
		_fu.shift().delete()
var int _cg=na
var int _df=0
_ij=false
_iv=false
if barstate.isconfirmed
	if not na(_lw)
		_pz=not na(_gv)and _ox-_gv <=_oi
		d1=_pz and _nj and _dg(_lw,_ez,_ob,_hk,true)
		d2=_pz and _nm and _dg(_lw,_ez,_oe,_hw,true)
		if d1 or d2
			_ij:=true
			_cg:=bar_index
			_df:=-1
			_hy=_lw > _ez
			xv=_hy?_ox:bar_index+int(d1?_pk:_pt)
			t1=_eu(_ps,_ob,_hk)
			t2=_eu(_qi,_oe,_hw)
			_jr(_gv,_ez,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_iu,true)
		_gv:=_ox
		_ez:=_lw
		_hk:=_ob
		_hw:=_oe
	if not na(_me)
		_pz=not na(_gt)and _ox-_gt <=_oi
		d1=_pz and _nj and _dg(_me,_fj,_ny,_hc,false)
		d2=_pz and _nm and _dg(_me,_fj,_os,_hs,false)
		if d1 or d2
			_iv:=true
			_cg:=bar_index
			_df:=1
			_hy=_me < _fj
			xv=_hy?_ox:bar_index+int(d1?_pw:_pn)
			t1=_eu(_ps,_ny,_hc)
			t2=_eu(_qi,_os,_hs)
			_jr(_gt,_fj,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_gx,false)
		_gt:=_ox
		_fj:=_me
		_hc:=_ny
		_hs:=_os
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ea=array.new<box>()
var array<line> _cv=array.new<line>()
var array<label> _bs=array.new<label>()
var array<int> uso=array.from(0,0,0)
_pa(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ea.size()
		b=_ea.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ea.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_nb(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _cv.size()
		l=_cv.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_cv.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_kw(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bs.size()
		e=_bs.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bs.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _vb
	bool _qm
var array<Letrero> _fe=array.new<Letrero>()
_nr=nz(ta.atr(50))*0.5
_sq=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_mj)
_dx=nz(ta.atr(50))*_sq/100
var array<Pieza> _fr=array.new<Pieza>()
_uo(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_og(Pieza p)=>
	res=array.from(p)
	if _kb and _fr.size()> 0
		for o in _fr
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_uc=array.new<Pieza>()
				for q in res
					for r in _uo(q,o)
						_uc.push(r)
				res:=_uc
				if res.size()==0 or res.size()> 10
					break
	res
_gg(Pieza p,color col,int dir)=>
	for q in _og(p)
		top=q.top
		bot=q.bot
		if _dx > 0 and dir !=0
			for o in _fr
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_dx
						top:=math.min(top,o.bot-_dx)
					if math.abs(bot-o.top)<=_dx
						bot:=math.max(bot,o.top+_dx)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_pa(q.x1,top,q.x2,bot,col)
_mg(int _sn,int x2,float _ac,float _ad,int dir,float _bc,color col,string txt,color _tx,color _oo,color _mx,bool _qm)=>
	x1=math.max(_sn,bar_index-1000)
	_vv=na(_bc)?_ac:(dir==1?_bc:_ac)
	_vk=na(_bc)?_ad:(dir==1?_ad:_bc)
	_gg(Pieza.new(x1,x2,_vv,_vk),col,dir)
	if not na(_bc)
		_gg(Pieza.new(x1,x2,dir==1?_ac:_bc,dir==1?_bc:_ad),_mx,dir)
	if txt !="" and _fe.size()< 30
		_fe.push(Letrero.new(x2,(_vv+_vk)/2,txt,_tx,true,_qm))
	if not na(_oo)
		m=(_ac+_ad)/2
		for q in _og(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_nb(q.x1,q.x2,m,_oo)
	_fr.push(Pieza.new(x1,x2,_ac,_ad,dir))
_az(array<Zona> arr,color _uy,color _vg,int _ru,string txt,bool _vw,bool _ro,color _mx,bool _qm)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_uy:_vg
			t=txt
			_vz=z._ad > close?z._ad-close:close > z._ac?close-z._ac:0.0
			if uso.get(0)< 440 and _fr.size()< _ko and(_od==0 or _vz/close*100 <=_od)
				_mg(z.x1,bar_index+1,z._ac,z._ad,z.dir,z._bc,color.new(c,_lq),t,c,_ro?color.new(color.white,30):na,_mx,_qm)
_aq()=>
	if _nz
		_az(_hq,_gw,_gw,88,"IFVG "+_dc,true,false,_ag,false)
		_az(_gi,_rc,_rk,80,"FVG "+_dc,true,false,_ag,true)
	_az(obs,_kg,_jy,90,"OB "+_dc,true,false,_ag,false)
_da(bool ver,int _tl,array<Zona> f,array<Zona> fi,color ca,color cb,int _ru,string nom)=>
	if ver and not _m and _d !=_tl*60
		_az(fi,_gw,_gw,88,"IFVG "+nom,true,false,_ag,false)
		_az(f,ca,cb,_ru,"FVG "+nom,true,_tl >=15,_ag,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fe.clear()
	_fr.clear()
	_ab=false
	if _d <=60
		_aq()
		_ab:=true
	_da(_cm,1,_vd,_ur,_li,_lu,84,"M1")
	if not _ab and _d <=300
		_aq()
		_ab:=true
	_da(_bq,5,_tk,_qx,_lt,_lj,84,"M5")
	if not _ab and _d <=900
		_aq()
		_ab:=true
	_da(_ba,15,_oy,_oh,_jk,_jz,84,"M15")
	if not _ab and _d <=3600
		_aq()
		_ab:=true
	_da(_ax,60,_ph,_ok,_jl,_jt,82,"H1")
	if not _ab and _d <=14400
		_aq()
		_ab:=true
	_da(_ao,240,_jo,_kl,_hu,_id,80,"H4")
	if not _ab
		_aq()
	if _fe.size()> 0
		_mc=array.new<Letrero>()
		for l in _fe
			x=l.x
			_uz=str.length(l.txt)+2
			for _uw=0 to 3
				_tm=false
				for c in _mc
					_po=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _nr and x > c.x-_po and x-_uz < c.x
						x:=c.x-_po
						_tm:=true
				if not _tm
					break
			_mc.push(Letrero.new(x,l.y,l.txt,l.col,true,l._qm))
			_kw(x,l.y,l.txt,color.white)
	while _ea.size()> uso.get(0)
		_ea.pop().delete()
	while _cv.size()> uso.get(1)
		_cv.pop().delete()
	while _bs.size()> uso.get(2)
		_bs.pop().delete()
_oq()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bi(array<Zona> arr,string nom,bool _ud)=>
	float _qv=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bc)?z._ad:z._bc
		hi=z.dir==-1 or na(z._bc)?z._ac:z._bc
		d=close >=lo and close <=hi?0.0:_ud?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_qv)or d < _qv)
			_qv:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_qv,txt]
_rr(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_kr(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_kz(int b)=>
	b==1?_al:b==-1?_aj:#757575
_up(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_uk(string n)=>
	str.contains(n,"alcista")?_al:str.contains(n,"bajista")?_aj:#757575
var table _ia=na
if barstate.islast and _kk
	pos=_in=="Arriba izquierda"?position.top_left:_in=="Abajo derecha"?position.bottom_right:_in=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_lo=="Muy pequeño"?size.tiny:_lo=="Normal"?size.normal:size.small
	if na(_ia)
		_ia:=table.new(pos,2,8,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_ia.clear(0,0,1,7)
	int _tu=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_tu:=request.security(syminfo.tickerid,"240",_oq(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_oq(),lookahead=barmerge.lookahead_on)
	_rr(_ia,0,"Bias H4",_d < 14400?_kr(_tu):"(gráfico ≥ H4)",_kz(_tu),tam)
	_rr(_ia,1,"Bias H1",_d < 3600?_kr(b60):"(gráfico ≥ H1)",_kz(b60),tam)
	ev=_ej.get(0)
	_un=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_em.get(0))+" velas"
	_rr(_ia,2,"Estructura "+_dc,_kr(_i)+_un,_kz(_i),tam)
	tz="America/New_York"
	_uq=hour(timenow,tz)*60+minute(timenow,tz)
	_vp=dayofweek(timenow,tz)
	_vl=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_wf=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_ui=_vp==dayofweek.saturday or _vp==dayofweek.sunday
	_sk=570-_uq
	ses=_ui?"Cerrada (fin de semana)":_uq < 570?"Abre a las "+str.format_time(_vl,"HH:mm","Europe/Madrid")+" (en "+(_sk >=60?str.tostring(int(_sk/60))+" h ":"")+str.tostring(_sk%60)+" min)":_uq < 960?"● Abierta (cierra "+str.format_time(_wf,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_vl,"HH:mm","Europe/Madrid")+")"
	_rr(_ia,3,"Sesión NY",ses,not _ui and _uq >=570 and _uq < 960?_al:#424242,tam)
	float _qr=na
	string _tz=""
	float _qs=na
	string _uj=""
	if _nz
		[d1,t1]=_bi(_gi,"FVG "+_dc,true)
		[d2,t2]=_bi(_hq,"IFVG "+_dc,true)
		[d3,t3]=_bi(_gi,"FVG "+_dc,false)
		[d4,t4]=_bi(_hq,"IFVG "+_dc,false)
		if not na(d1)and(na(_qr)or d1 < _qr)
			_qr:=d1
			_tz:=t1
		if not na(d2)and(na(_qr)or d2 < _qr)
			_qr:=d2
			_tz:=t2
		if not na(d3)and(na(_qs)or d3 < _qs)
			_qs:=d3
			_uj:=t3
		if not na(d4)and(na(_qs)or d4 < _qs)
			_qs:=d4
			_uj:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_vd:k==1?_tk:k==2?_oy:k==3?_ph:_jo
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cm:k==1?_bq:k==2?_ba:k==3?_ax:_ao
			if ver
				[da,ta_]=_bi(arr,nom,true)
				[db,tb]=_bi(arr,nom,false)
				if not na(da)and(na(_qr)or da < _qr)
					_qr:=da
					_tz:=ta_
				if not na(db)and(na(_qs)or db < _qs)
					_qs:=db
					_uj:=tb
	_rr(_ia,4,"FVG por arriba",_up(_qr,_tz),_uk(_tz),tam)
	_rr(_ia,5,"FVG por abajo",_up(_qs,_uj),_uk(_uj),tam)
	_td=not _dm?"(apagada)":na(_cg)?"Ninguna reciente":(_df==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cg)+" velas"
	_rr(_ia,6,"SMT",_td,not _dm or na(_cg)?#757575:_df==1?_gx:_iu,tam)
	if _mq
		_nf=request.security(_th,"D",close[1],lookahead=barmerge.lookahead_on)
		[_lf,_ue,_um]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_nf/16
		pts=_lf*pct/100
		_re=pts > 0?(_ue-_um)/pts*100:na
		_sx=na(_nf)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_nf,"#.#")+") · hoy "+str.tostring(_ue-_um,"#")+" pts = "+str.tostring(_re,"#")+" %"
		_rr(_ia,7,"Mov. esperado",_sx,na(_re)?#757575:_re >=100?_aj:_re >=75?#EF6C00:#424242,tam)
