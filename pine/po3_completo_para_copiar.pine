_mr=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_ia)
_cz="FVG por temporalidad (solo se ven los activados)"
_aq=input.bool(true,"FVG H4",inline="fvgtf1",group=_cz)
_ay=input.bool(true,"FVG H1",inline="fvgtf1",group=_cz)
_bd=input.bool(true,"FVG M15",inline="fvgtf1",group=_cz)
_bv=input.bool(true,"FVG M5",inline="fvgtf2",group=_cz)
_cu=input.bool(false,"FVG M1",inline="fvgtf2",group=_cz)
_ns=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_cz)
_m=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_cz)
_gh=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cz)
_lq=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cz)
_po=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cz)
_nt="Estructura (CHoCH / BOS)"
_cd=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_nt)
_tc=1.1
_ui=2.0
_tt=20
_tb=2
_mv=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_nt)
_hy=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_nt)
_ic=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_nt)
_iq=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_nt)
_ej=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_nt)
_qg=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_nt)
_ba=bar_index >=last_bar_index-_qg
_cj=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mc=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_ak=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_uo="Order Blocks"
_kk=input.bool(true,"Mostrar Order Blocks",group=_uo)
_fm=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_uo)
_ma=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_uo)
_vx=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_uo)
_nc=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_uo)
_ko=input.color(#1565C0,"OB alcista (demanda)",group=_uo)
_kl=input.color(#EF6C00,"OB bajista (oferta)",group=_uo)
_sb="Estrategia NY (Bias + PO3)"
_le=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_sb)
_kf=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_sb)
_tn="Colores FVG"
_ao=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_tn)
_an=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_tn)
_rm=_ao
_mh=_ao
_mo=_ao
_jz=_ao
