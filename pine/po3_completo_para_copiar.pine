_fz(int dir,float _pr)=>
	_ss=math.max(high-low,syminfo.mintick)
	_to=math.abs(close-open)
	_ve=dir==1?high-math.max(open,close):math.min(open,close)-low
	int _ht=0
	string _ch=""
