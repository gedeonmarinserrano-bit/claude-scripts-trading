type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ep=array.new<box>()
var array<line> _di=array.new<line>()
var array<label> _bx=array.new<label>()
var array<int> uso=array.from(0,0,0)
_rb(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ep.size()
		b=_ep.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ep.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_oz(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _di.size()
		l=_di.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_di.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lx(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bx.size()
		e=_bx.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bx.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _ya
	bool _sj
var array<Letrero> _fq=array.new<Letrero>()
_ff=nz(ta.atr(50))*0.5
_up=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_pc)
_eo=nz(ta.atr(50))*_up/100
var array<Pieza> _gj=array.new<Pieza>()
_wq(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pl(Pieza p)=>
	res=array.from(p)
	if _ld and _gj.size()> 0
		for o in _gj
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_xj=array.new<Pieza>()
				for q in res
					for r in _wq(q,o)
						_xj.push(r)
				res:=_xj
				if res.size()==0 or res.size()> 10
					break
	res
_gu(Pieza p,color col,int dir)=>
	for q in _pl(p)
		top=q.top
		bot=q.bot
		if _eo > 0 and dir !=0
			for o in _gj
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_eo
						top:=math.min(top,o.bot-_eo)
					if math.abs(bot-o.top)<=_eo
						bot:=math.max(bot,o.top+_eo)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_rb(q.x1,top,q.x2,bot,col)
_ne(int _ul,int x2,float _ag,float _ah,int dir,float _bi,color col,string txt,color _xk,color _qc,color _oq,bool _sj)=>
	x1=math.max(_ul,bar_index-1000)
	_yh=na(_bi)?_ag:(dir==1?_bi:_ag)
