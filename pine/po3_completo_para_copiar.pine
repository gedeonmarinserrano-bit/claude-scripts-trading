		d2=_se and _ph and _do(_ng,_fn,_qc,_jr,false)
		if d1 or d2
			_ie:=true
			_ck:=bar_index
			_dz:=1
			_jh=_ng < _fn
			xv=_jh?_qs:bar_index+int(d1?_so:_su)
			t1=_fu(_sl,_qn,_jg)
			t2=_fu(_sm,_qc,_jr)
			_kr(_hk,_fn,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_hx,false)
		_hk:=_qs
