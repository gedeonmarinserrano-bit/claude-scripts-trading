_hf="SMT (divergencias entre índices)"
_dw=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hf)
_me=input.bool(true,"Mostrar etiquetas de la SMT",group=_hf)
_so=input.bool(true,"Mostrar línea de la SMT",group=_hf)
_tw=input.bool(true,"Comparar con",inline="smt1",group=_hf)
_qf=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_hf)
_tn=input.bool(true,"Comparar con",inline="smt2",group=_hf)
_ql=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_hf)
_go=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hf)
_qg=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hf)
_rk=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hf)
_hw=input.color(#ff1100,"SMT bajista (en altos)",group=_hf)
_jf=input.color(#2157f3,"SMT alcista (en bajos)",group=_hf)
_kf(string s)=>
	_ua=str.split(s,":")
	_ua.size()> 0?_ua.last():s
_rj=_kf(_qf)
_se=_kf(_ql)
_wj=str.replace(_rj,"1!","")
_wh=str.replace(_se,"1!","")
_ue=str.replace(syminfo.ticker,"1!","")
_ot=_dw and _tw and _wj !=_ue
_ox=_dw and _tn and _wh !=_ue
_rr()=>
	w=2*_go+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pq=na
float _pm=na
int _rm=na
int _rz=na
float _pn=na
float _qb=na
int _rw=na
int _sp=na
if _ot and _ba
	[h_,l_,hb_,lb_]=request.security(_qf,timeframe.period,_rr(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pq:=h_
	_pm:=l_
	_rm:=hb_
	_rz:=lb_
if _ox and _ba
	[h_,l_,hb_,lb_]=request.security(_ql,timeframe.period,_rr(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pn:=h_
	_qb:=l_
	_rw:=hb_
	_sp:=lb_
_mp=ta.pivothigh(high,_go,_go)
_nd=ta.pivotlow(low,_go,_go)
_rc=bar_index-_go
var int _hp=na
var float _fi=na
var float _ja=na
var float _iv=na
var int _ho=na
var float _gb=na
var float _id=na
var float _is=na
var array<line> _gm=array.new<line>()
var array<label> _gf=array.new<label>()
_dm(float y,float _us,float c,float _ns,bool _pb)=>
	_vw=_pb?y > _us:y < _us
	_uy=_pb?c > _ns:c < _ns
	not na(_us)and not na(_ns)and not na(c)and _vw !=_uy
_fn(string t,float c,float _ns)=>
	t+(c > _ns?" ↑":c < _ns?" ↓":" =")
_kq(int x1,float y1,int xv,string txt,color col,bool _pb)=>
	yv=_pb?high[bar_index-xv]:low[bar_index-xv]
	if _so
		_gm.push(line.new(x1,y1,xv,yv,color=col))
	if _me
		_gf.push(label.new(xv,yv,txt,style=_pb?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_pb?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_pb?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gm.size()> _rk
		_gm.shift().delete()
	if _gf.size()> _rk
		_gf.shift().delete()
var int _cn=na
var int _ds=0
_iw=false
_ik=false
if barstate.isconfirmed
	if not na(_mp)
		_rx=not na(_hp)and _rc-_hp <=_qg
		d1=_rx and _ot and _dm(_mp,_fi,_pq,_ja,true)
		d2=_rx and _ox and _dm(_mp,_fi,_pn,_iv,true)
		if d1 or d2
			_iw:=true
			_cn:=bar_index
			_ds:=-1
			_hy=_mp > _fi
			xv=_hy?_rc:bar_index+int(d1?_rm:_rw)
			t1=_fn(_rj,_pq,_ja)
			t2=_fn(_se,_pn,_iv)
			_kq(_hp,_fi,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_hw,true)
		_hp:=_rc
		_fi:=_mp
		_ja:=_pq
		_iv:=_pn
	if not na(_nd)
		_rx=not na(_ho)and _rc-_ho <=_qg
		d1=_rx and _ot and _dm(_nd,_gb,_pm,_id,false)
		d2=_rx and _ox and _dm(_nd,_gb,_qb,_is,false)
		if d1 or d2
			_ik:=true
			_cn:=bar_index
			_ds:=1
			_hy=_nd < _gb
			xv=_hy?_rc:bar_index+int(d1?_rz:_sp)
			t1=_fn(_rj,_pm,_id)
			t2=_fn(_se,_qb,_is)
			_kq(_ho,_gb,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jf,false)
		_ho:=_rc
		_gb:=_nd
		_id:=_pm
		_is:=_qb
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _eh=array.new<box>()
var array<line> _df=array.new<line>()
var array<label> _bx=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qu(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eh.size()
		b=_eh.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eh.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_pd(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _df.size()
		l=_df.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_df.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lj(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bx.size()
		e=_bx.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bx.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xv
	bool _sb
var array<Letrero> _ga=array.new<Letrero>()
_fg=nz(ta.atr(50))*0.5
_uq=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_oo)
_el=nz(ta.atr(50))*_uq/100
var array<Pieza> _gk=array.new<Pieza>()
_xd(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_qi(Pieza p)=>
	res=array.from(p)
	if _ku and _gk.size()> 0
		for o in _gk
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wo=array.new<Pieza>()
				for q in res
					for r in _xd(q,o)
						_wo.push(r)
				res:=_wo
				if res.size()==0 or res.size()> 10
					break
	res
_gr(Pieza p,color col,int dir)=>
	for q in _qi(p)
		top=q.top
		bot=q.bot
		if _el > 0 and dir !=0
			for o in _gk
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_el
						top:=math.min(top,o.bot-_el)
					if math.abs(bot-o.top)<=_el
						bot:=math.max(bot,o.top+_el)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qu(q.x1,top,q.x2,bot,col)
_mz(int _up,int x2,float _ag,float _ah,int dir,float _bh,color col,string txt,color _wy,color _pj,color _oe,bool _sb)=>
	x1=math.max(_up,bar_index-1000)
	_ym=na(_bh)?_ag:(dir==1?_bh:_ag)
	_yh=na(_bh)?_ah:(dir==1?_ah:_bh)
	_gr(Pieza.new(x1,x2,_ym,_yh),col,dir)
	if not na(_bh)
		_gr(Pieza.new(x1,x2,dir==1?_ag:_bh,dir==1?_bh:_ah),_oe,dir)
	if txt !="" and _ga.size()< 60
		_ga.push(Letrero.new(x2,(_ym+_yh)/2,txt,_wy,true,_sb))
	if not na(_pj)
		m=(_ag+_ah)/2
		for q in _qi(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_pd(q.x1,q.x2,m,_pj)
	_gk.push(Pieza.new(x1,x2,_ag,_ah,dir))
_bg(array<Zona> arr,color _ya,color _xy,int _tx,string txt,bool _yf,bool _tv,color _oe,bool _sb)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_ya:_xy
			t=txt
			_yy=z._ah > close?z._ah-close:close > z._ag?close-z._ag:0.0
			if uso.get(0)< 440 and _gk.size()< _lw and(_qd==0 or _yy/close*100 <=_qd)
				_mz(z.x1,bar_index+1,z._ag,z._ah,z.dir,z._bh,color.new(c,_nh),t,c,_tv?color.new(color.white,30):na,_oe,_sb)
_as()=>
	if _pz
