var array<int> uso=array.from(0,0,0)
_qy(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ef.size()
		b=_ef.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
