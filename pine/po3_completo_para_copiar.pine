		_uu=(na(_vu)?"↑ —":"↑ "+_wl+" "+str.tostring(_vu,format.mintick)+" (+"+str.tostring(_vu-close,format.mintick)+")")+"  ·  "+(na(_vw)?"↓ —":"↓ "+_wy+" "+str.tostring(_vw,format.mintick)+" (−"+str.tostring(close-_vw,format.mintick)+")")
		_py(_em,f,"Liquidez",_uu,#424242,tam)
