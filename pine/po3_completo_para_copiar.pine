_ri=input.float(2.0,"Mult. Alto Volumen (🔥)",step=0.1)
_rj=input.int(20,"Media de Volumen",minval=1)
_qt=input.int(2,"Desplazamiento Texto",minval=0)
_lf=input.bool(true,"Fondo blanco")
_im=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)")
_ia=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)")
_gq=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0)
_dw=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)")
_oj=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000)
_ch=bar_index >=last_bar_index-_oj
_gz=input.float(0.0,"Tamaño mínimo FVG (% precio)",minval=0,step=0.05,group="FVG")
_lt=input.int(20,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
