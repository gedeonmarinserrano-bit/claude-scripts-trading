				if pv < close and(na(_wa)or pv > _wa)
					_wa:=pv
					_xc:=_mz.get(i)
		_uv=(na(_vy)?"↑ —":"↑ "+_xh+" "+str.tostring(_vy,format.mintick)+" (+"+str.tostring(_vy-close,format.mintick)+")")+"  ·  "+(na(_wa)?"↓ —":"↓ "+_xc+" "+str.tostring(_wa,format.mintick)+" (−"+str.tostring(close-_wa,format.mintick)+")")
		_qb(_eo,f,"Liquidez",_uv,#424242,tam)
		f+=1
	if _qk !=""
		_qb(_eo,f,"Noticias hoy",_qk,#EF6C00,tam)
		f+=1
_eb(array<label> etq,bool _ru,int _th,float sep)=>
	_oz=_th
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xr=ys.sort_indices()
		_tm=array.new<float>()
		_ro=array.new<int>()
		_nu=array.new<int>()
		_uo=timeframe.in_seconds()*1000
		for j in _xr
			e=etq.get(j)
			y=e.get_y()
			_ri=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_th
			for _vg=0 to 6
				_rs=false
				if _tm.size()> 0
					for c=0 to _tm.size()-1
						if math.abs(_tm.get(c)-y)< sep and ini < _nu.get(c)and ini+_ri > _ro.get(c)
							ini:=_nu.get(c)
							_rs:=true
				if not _rs
					break
			_tm.push(y)
			_ro.push(ini)
			_nu.push(ini+_ri)
			_oz:=math.max(_oz,ini+_ri)
			if _ru
				e.set_x(time+ini*_uo)
			else
				e.set_x(bar_index+ini)
	_oz
if barstate.islast
	_lt=array.new<label>()
	for o in _eg
		if not na(o)and not na(o.lb)
			_lt.push(o.lb)
	for q in _o
		q.ln.set_x2(bar_index)
		_lt.push(q.lb)
	_of=array.new<label>()
	for n in _dk
		_of.push(n.lb)
	for n in _dl
		_of.push(n.lb)
	_up=_eb(_lt,false,1,_fj*0.35)
	_eb(_of,true,_lt.size()> 0?_up:1,_fj*0.35)
