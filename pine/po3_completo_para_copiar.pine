	f+=1
	ev=_fc.get(0)
	_xj=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ey.get(0))+" velas"
	_qk(_ef,f,"Estructura "+_dn,_ls(_i)+_xj,_mj(_i),tam)
	f+=1
	tz="America/New_York"
	_wd=hour(timenow,tz)*60+minute(timenow,tz)
	_yd=dayofweek(timenow,tz)
	_yi=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yz=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_wu=_yd==dayofweek.saturday or _yd==dayofweek.sunday
	_ul=570-_wd
	ses=_wu?"Cerrada (fin de semana)":_wd < 570?"Abre a las "+str.format_time(_yi,"HH:mm","Europe/Madrid")+" (en "+(_ul >=60?str.tostring(int(_ul/60))+" h ":"")+str.tostring(_ul%60)+" min)":_wd < 960?"● Abierta (cierra "+str.format_time(_yz,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yi,"HH:mm","Europe/Madrid")+")"
	_qk(_ef,f,"Sesión NY",ses,not _wu and _wd >=570 and _wd < 960?_ad:#424242,tam)
	f+=1
	float _sv=na
	string _wt=""
	float _su=na
	string _wp=""
	if _pz
		[d1,t1]=_bj(_hi,"FVG "+_dn,true)
		[d2,t2]=_bj(_ia,"IFVG "+_dn,true)
		[d3,t3]=_bj(_hi,"FVG "+_dn,false)
		[d4,t4]=_bj(_ia,"IFVG "+_dn,false)
		if not na(d1)and(na(_sv)or d1 < _sv)
