_gm=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cy)
_lf=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cy)
_py=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cy)
_og="Estructura (CHoCH / BOS)"
_cd=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_og)
_tj=1.1
_uy=2.0
_vj=20
_sy=2
_np=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_og)
_hz=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_og)
_il=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_og)
_js=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_og)
_eo=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_og)
_qp=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_og)
_bd=bar_index >=last_bar_index-_qp
_ck=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_nq=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_aj=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
