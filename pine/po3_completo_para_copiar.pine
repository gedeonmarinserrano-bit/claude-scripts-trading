var array<int> uso=array.from(0,0,0)
_ra(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ej.size()
		b=_ej.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ej.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_ow(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dk.size()
		l=_dk.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
