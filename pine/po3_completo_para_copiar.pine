_lq()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_up(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_by(array<Zona> arr,float _ah,float _ag,int dir,int _vt,int _wc)=>
	if _ah-_ag >=_gn(_wc)
		z=Zona.new(_up(_vt),_ah,_ag,dir)
		if not _eu(z)
			arr.push(z)
			if arr.size()> _gg
				arr.shift()
_bq(array<Zona> arr,array<Zona> _dq)=>
	_wg=false
	if _dq.size()> 0
		for i=_dq.size()-1 to 0
			if _eu(_dq.get(i))
				_dq.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_th=(z._ah+z._ag)/2
			if low <=_th and high >=_th
				_wg:=true
			_jp=na(z._bh)and(z.dir==1?(open >=z._ah and close < z._ag):(open <=z._ag and close > z._ah))
			if _jp
				arr.remove(i)
				_dq.push(Zona.new(z.x1,z._ah,z._ag,-z.dir,na,bar_index))
				if _dq.size()> _gg
					_dq.shift()
			else if _eu(z)
				arr.remove(i)
	_wg
