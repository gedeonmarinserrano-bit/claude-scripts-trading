	_bg(obs,_kz,_kh,90,"OB "+_dn,true,false,_aj,false)
_di(bool ver,int _wc,array<Zona> f,array<Zona> fi,color ca,color cb,int _tx,string nom)=>
	if ver and not _m and _d !=_wc*60
