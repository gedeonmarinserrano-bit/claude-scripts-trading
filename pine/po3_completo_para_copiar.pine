_ep(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_dh(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_rw=(dir==1?"Máx. ":"Mín. ")+ses
	o=_ei.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _h.size()> 0
			for i=_h.size()-1 to 0
				q=_h.get(i)
				if q.k==k
					_h.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_ep(bar_index,v,_rw,col)
		_ei.set(k,NivelSes.new(ln,lb,v,na,k,bar_index))
	else if not na(o)
		if en and not na(o.ln)
			o._aa:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if na(o.ln)
			if dir==1?high > o._aa:low < o._aa
				o._aa:=dir==1?high:low
				o._xi:=bar_index
			if bar_index-o._tk >=5
				dup=false
				for j=0 to 5
					p=_ei.get(j)
					if j !=k and not na(p)and not na(p.ln)and math.abs(p._aa-o._aa)<=0.1*nz(_ck)
						dup:=true
				if dup
					_ei.set(k,na)
