	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _ya
	bool _rp
var array<Letrero> _fw=array.new<Letrero>()
_fh=nz(ta.atr(50))*0.5
_vr=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_pi)
_el=nz(ta.atr(50))*_vr/100
var array<Pieza> _gj=array.new<Pieza>()
_xj(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pr(Pieza p)=>
	res=array.from(p)
	if _lb and _gj.size()> 0
		for o in _gj
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wp=array.new<Pieza>()
				for q in res
					for r in _xj(q,o)
						_wp.push(r)
				res:=_wp
				if res.size()==0 or res.size()> 10
					break
	res
_gu(Pieza p,color col,int dir)=>
	for q in _pr(p)
		top=q.top
		bot=q.bot
		if _el > 0 and dir !=0
			for o in _gj
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_el
						top:=math.min(top,o.bot-_el)
					if math.abs(bot-o.top)<=_el
						bot:=math.max(bot,o.top+_el)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_ra(q.x1,top,q.x2,bot,col)
_nk(int _vn,int x2,float _ah,float _ag,int dir,float _bh,color col,string txt,color _wm,color _qa,color _pa,bool _rp)=>
	x1=math.max(_vn,bar_index-1000)
	_yq=na(_bh)?_ah:(dir==1?_bh:_ah)
	_yi=na(_bh)?_ag:(dir==1?_ag:_bh)
	_gu(Pieza.new(x1,x2,_yq,_yi),col,dir)
	if not na(_bh)
		_gu(Pieza.new(x1,x2,dir==1?_ah:_bh,dir==1?_bh:_ag),_pa,dir)
	if txt !="" and _fw.size()< 60
		_fw.push(Letrero.new(x2,(_yq+_yi)/2,txt,_wm,true,_rp))
	if not na(_qa)
		m=(_ah+_ag)/2
		for q in _pr(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_ow(q.x1,q.x2,m,_qa)
	_gj.push(Pieza.new(x1,x2,_ah,_ag,dir))
_bg(array<Zona> arr,color _xs,color _xx,int _tx,string txt,bool _yk,bool _tm,color _pa,bool _rp)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xs:_xx
			t=txt
			_yt=z._ag > close?z._ag-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gj.size()< _lf and(_py==0 or _yt/close*100 <=_py)
				_nk(z.x1,bar_index+1,z._ah,z._ag,z.dir,z._bh,color.new(c,_mq),t,c,_tm?color.new(color.white,30):na,_pa,_rp)
