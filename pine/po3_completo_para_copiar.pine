	uso.set(1,i+1)
_lt(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bu.size()
		e=_bu.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bu.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xp
	bool _sf
var array<Letrero> _fm=array.new<Letrero>()
_pb=nz(ta.atr(50))*0.5
_vd=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_os)
_ei=nz(ta.atr(50))*_vd/100
var array<Pieza> _gd=array.new<Pieza>()
_wu(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_qb(Pieza p)=>
	res=array.from(p)
	if _kf and _gd.size()> 0
		for o in _gd
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_vy=array.new<Pieza>()
				for q in res
					for r in _wu(q,o)
						_vy.push(r)
				res:=_vy
				if res.size()==0 or res.size()> 10
					break
	res
_gv(Pieza p,color col,int dir)=>
	for q in _qb(p)
		top=q.top
		bot=q.bot
		if _ei > 0 and dir !=0
			for o in _gd
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_ei
						top:=math.min(top,o.bot-_ei)
					if math.abs(bot-o.top)<=_ei
						bot:=math.max(bot,o.top+_ei)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qm(q.x1,top,q.x2,bot,col)
_mo(int _un,int x2,float _ag,float _ah,int dir,float _bi,color col,string txt,color _vu,color _qc,color _nq,bool _sf)=>
	x1=math.max(_un,bar_index-1000)
	_xr=na(_bi)?_ag:(dir==1?_bi:_ag)
	_xu=na(_bi)?_ah:(dir==1?_ah:_bi)
	_gv(Pieza.new(x1,x2,_xr,_xu),col,dir)
	if not na(_bi)
		_gv(Pieza.new(x1,x2,dir==1?_ag:_bi,dir==1?_bi:_ah),_nq,dir)
	if txt !="" and _fm.size()< 60
		_fm.push(Letrero.new(x2,(_xr+_xu)/2,txt,_vu,true,_sf))
	if not na(_qc)
		m=(_ag+_ah)/2
		for q in _qb(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_op(q.x1,q.x2,m,_qc)
	_gd.push(Pieza.new(x1,x2,_ag,_ah,dir))
_bf(array<Zona> arr,color _xc,color _xi,int _tv,string txt,bool _xy,bool _sq,color _nq,bool _sf)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xc:_xi
			t=txt
			_yh=z._ah > close?z._ah-close:close > z._ag?close-z._ag:0.0
			if uso.get(0)< 440 and _gd.size()< _ln and(_pr==0 or _yh/close*100 <=_pr)
				_mo(z.x1,bar_index+1,z._ag,z._ah,z.dir,z._bi,color.new(c,_mq),t,c,_sq?color.new(color.white,30):na,_nq,_sf)
_au()=>
	if _pm
		_bf(_hp,_hi,_hi,88,"IFVG "+_dq,true,false,_al,false)
		_bf(_hf,_tl,_su,80,"FVG "+_dq,true,false,_al,true)
	_bf(obs,_ky,_kn,90,"OB "+_dq,true,false,_al,false)
_de(bool ver,int _vj,array<Zona> f,array<Zona> fi,color ca,color cb,int _tv,string nom)=>
	if ver and not _l and _d !=_vj*60
		_bf(fi,_hi,_hi,88,"IFVG "+nom,true,false,_al,false)
		_bf(f,ca,cb,_tv,"FVG "+nom,true,_vj >=15,_al,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fm.clear()
	_gd.clear()
	_af=false
	if _d <=60
		_au()
		_af:=true
	_de(_cv,1,_xm,_we,_mf,_nj,84,"M1")
	if not _af and _d <=300
		_au()
		_af:=true
	_de(_bx,5,_vk,_tb,_nd,_ng,84,"M5")
	if not _af and _d <=900
		_au()
		_af:=true
	_de(_ba,15,_qq,_pw,_ko,_kd,84,"M15")
	if not _af and _d <=3600
		_au()
		_af:=true
	_de(_bd,60,_qp,_pd,_ki,_kk,82,"H1")
	if not _af and _d <=14400
		_au()
		_af:=true
	_de(_ar,240,_kx,_me,_in,_ic,80,"H4")
	if not _af
		_au()
	if _fm.size()> 0
		_nl=array.new<Letrero>()
		for l in _fm
			x=l.x
			_xj=str.length(l.txt)+2
			for _xg=0 to 3
				_wk=false
				for c in _nl
					_ro=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _pb and x > c.x-_ro and x-_xj < c.x
						x:=c.x-_ro
						_wk:=true
				if not _wk
					break
			_nl.push(Letrero.new(x,l.y,l.txt,l.col,true,l._sf))
			_lt(x,l.y,l.txt,color.white)
	while _ef.size()> uso.get(0)
		_ef.pop().delete()
	while _dj.size()> uso.get(1)
		_dj.pop().delete()
	while _bu.size()> uso.get(2)
		_bu.pop().delete()
_pi()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bm(array<Zona> arr,string nom,bool _wi)=>
	float _sn=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bi)?z._ah:z._bi
		hi=z.dir==-1 or na(z._bi)?z._ag:z._bi
		d=close >=lo and close <=hi?0.0:_wi?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sn)or d < _sn)
			_sn:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sn,txt]
_pz(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_mb(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_lr(int b)=>
	b==1?_z:b==-1?_s:#757575
_vp(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wl(string n)=>
	str.contains(n,"alcista")?_z:str.contains(n,"bajista")?_s:#757575
_rz(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _eh=na
if barstate.islast and _ma
	pos=_iy=="Arriba izquierda"?position.top_left:_iy=="Abajo derecha"?position.bottom_right:_iy=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_nh=="Muy pequeño"?size.tiny:_nh=="Normal"?size.normal:size.small
	if na(_eh)
		_eh:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_eh.clear(0,0,1,13)
	int f=0
	int _ww=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_ww:=request.security(syminfo.tickerid,"240",_pi(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_pi(),lookahead=barmerge.lookahead_on)
	_pz(_eh,f,"Bias H4",_d < 14400?_mb(_ww):"(gráfico ≥ H4)",_lr(_ww),tam)
	f+=1
	_pz(_eh,f,"Bias H1",_d < 3600?_mb(b60):"(gráfico ≥ H1)",_lr(b60),tam)
	f+=1
	ev=_fc.get(0)
	_vt=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ex.get(0))+" velas"
	_pz(_eh,f,"Estructura "+_dq,_mb(_i)+_vt,_lr(_i),tam)
	f+=1
	tz="America/New_York"
	_wx=hour(timenow,tz)*60+minute(timenow,tz)
	_xs=dayofweek(timenow,tz)
	_ya=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yk=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_wg=_xs==dayofweek.saturday or _xs==dayofweek.sunday
	_ux=570-_wx
	ses=_wg?"Cerrada (fin de semana)":_wx < 570?"Abre a las "+str.format_time(_ya,"HH:mm","Europe/Madrid")+" (en "+(_ux >=60?str.tostring(int(_ux/60))+" h ":"")+str.tostring(_ux%60)+" min)":_wx < 960?"● Abierta (cierra "+str.format_time(_yk,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_ya,"HH:mm","Europe/Madrid")+")"
	_pz(_eh,f,"Sesión NY",ses,not _wg and _wx >=570 and _wx < 960?_z:#424242,tam)
	f+=1
	float _sl=na
	string _wp=""
	float _sk=na
	string _vq=""
	if _pm
		[d1,t1]=_bm(_hf,"FVG "+_dq,true)
		[d2,t2]=_bm(_hp,"IFVG "+_dq,true)
		[d3,t3]=_bm(_hf,"FVG "+_dq,false)
		[d4,t4]=_bm(_hp,"IFVG "+_dq,false)
		if not na(d1)and(na(_sl)or d1 < _sl)
			_sl:=d1
			_wp:=t1
		if not na(d2)and(na(_sl)or d2 < _sl)
			_sl:=d2
			_wp:=t2
		if not na(d3)and(na(_sk)or d3 < _sk)
			_sk:=d3
			_vq:=t3
		if not na(d4)and(na(_sk)or d4 < _sk)
			_sk:=d4
			_vq:=t4
	if not _l
		for k=0 to 4
			arr=k==0?_xm:k==1?_vk:k==2?_qq:k==3?_qp:_kx
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cv:k==1?_bx:k==2?_ba:k==3?_bd:_ar
			if ver
				[da,ta_]=_bm(arr,nom,true)
				[db,tb]=_bm(arr,nom,false)
				if not na(da)and(na(_sl)or da < _sl)
					_sl:=da
					_wp:=ta_
				if not na(db)and(na(_sk)or db < _sk)
					_sk:=db
					_vq:=tb
	_pz(_eh,f,"FVG por arriba",_vp(_sl,_wp),_wl(_wp),tam)
	f+=1
	_pz(_eh,f,"FVG por abajo",_vp(_sk,_vq),_wl(_vq),tam)
	f+=1
	_uk=not _do?"(apagada)":na(_cm)?"Ninguna reciente":(_dk==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cm)+" velas"
	_pz(_eh,f,"SMT",_uk,not _do or na(_cm)?#757575:_dk==1?_jm:_jb,tam)
	f+=1
	if _ns
		_nt=request.security(_uf,"D",close[1],lookahead=barmerge.lookahead_on)
		[_mr,_wa,_wr]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_nt/16
		pts=_mr*pct/100
		_sw=pts > 0?(_wa-_wr)/pts*100:na
		_ue=na(_nt)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_nt,"#.#")+") · hoy "+str.tostring(_wa-_wr,"#")+" pts = "+str.tostring(_sw,"#")+" %"
		_pz(_eh,f,"Mov. esperado",_ue,na(_sw)?#757575:_sw >=100?_s:_sw >=75?#EF6C00:#424242,tam)
		f+=1
	if _lq and _jl
		_pz(_eh,f,"Asia",_rz(_ft,_go,_as,_hx,_im),#5E35B1,tam)
		f+=1
		_pz(_eh,f,"Londres",_rz(_lf,_mk,_cj,_mv,_mi),#1E88E5,tam)
		f+=1
	if _qf or _fp
		[_wm,_ul,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _qf
			rng=d_h-d_l
			_lp=_ul > 0?rng/_ul*100:na
			_pz(_eh,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_ul,"#")+" pts ("+str.tostring(_lp,"#")+" %)",na(_lp)?#757575:_lp >=100?_s:_lp >=75?#EF6C00:#424242,tam)
			f+=1
		if _fp
			dif=close-_wm
			_pz(_eh,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_s:_z,tam)
			f+=1
	if _lb
		float _vm=na
		string _wq=""
		float _vi=na
		string _wj=""
		_nb=array.from(pdh,pdl,_hx?na:_ft,_im?na:_go,_mv?na:_lf,_mi?na:_mk)
		_mp=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _et
			_nb.push(nv._ap)
			_mp.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _ep
			_nb.push(nv._ap)
			_mp.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _ds
			_nb.push(q._ap)
			_mp.push(q.dir==1?"EQH":"EQL")
		for i=0 to _nb.size()-1
			pv=_nb.get(i)
			if not na(pv)
				if pv > close and(na(_vm)or pv < _vm)
					_vm:=pv
					_wq:=_mp.get(i)
				if pv < close and(na(_vi)or pv > _vi)
					_vi:=pv
					_wj:=_mp.get(i)
		_uv=(na(_vm)?"↑ —":"↑ "+_wq+" "+str.tostring(_vm,format.mintick)+" (+"+str.tostring(_vm-close,format.mintick)+")")+"  ·  "+(na(_vi)?"↓ —":"↓ "+_wj+" "+str.tostring(_vi,format.mintick)+" (−"+str.tostring(close-_vi,format.mintick)+")")
		_pz(_eh,f,"Liquidez",_uv,#424242,tam)
		f+=1
	if _pl !=""
		_pz(_eh,f,"Noticias hoy",_pl,#EF6C00,tam)
		f+=1
