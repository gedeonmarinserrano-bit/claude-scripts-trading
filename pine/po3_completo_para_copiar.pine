type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_fv(Zona z,float hi,float lo)=>
	_fg=z.dir==1?lo <=z._al:hi >=z._an
	if not _fg
		_bz=na(z._bz)?(z.dir==1?z._an:z._al):z._bz
		if z.dir==1?lo < _bz:hi > _bz
			z._bz:=z.dir==1?lo:hi
	_fg
_bq(array<Zona> fvg,array<Zona> _ra,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _ue)=>
	_qx=false
	if ah.size()> 0
		_ej=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _ra
				n=s.n-z._ou
				if not z._kk and n >=1 and n <=_fz and h1 >=z._al and l1 <=z._an
					if k <=_ej
						z._kk:=true
					_qx:=true
			if k <=_ej
				if _ra.size()> 0
					for i=_ra.size()-1 to 0
						if _fv(_ra.get(i),h1,l1)
							_ra.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bz)and(z.dir==1?(o1 >=z._an and c1 < z._al):(o1 <=z._al and c1 > z._an))
						if inv
							fvg.remove(i)
							_ra.push(Zona.new(z.x1,z._an,z._al,-z.dir,na,s.n))
							if _ra.size()> _ue
								_ra.shift()
						else if _fv(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _ue
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_qx
