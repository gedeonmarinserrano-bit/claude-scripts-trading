plot(_uk?pdh:na,"Alto día anterior",color=color.new(_dm,30),style=plot.style_linebr,linewidth=1)
plot(_uk?pdl:na,"Bajo día anterior",color=color.new(_dm,30),style=plot.style_linebr,linewidth=1)
