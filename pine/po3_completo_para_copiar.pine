_ko=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_pl)
_uh="Colores FVG"
_ao=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_uh)
_ap=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_uh)
_sn=_ao
_nm=_ao
_mu=_ao
_ky=_ao
_ks=_ao
_hw=_ao
_rl=_ap
_nb=_ap
_nr=_ap
_kt=_ap
_kg=_ap
_jp=_ap
_ke=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pl)
_qx=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pl)
_ld=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pl)
_jv=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pl)
_rc=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pl)
_lb=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pl)
_kr=input.color(#8D6E63,"Color niveles H1",group=_pl)
_qr=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_pl)
_dm=input.color(#424242,"Color niveles clave",group=_pl)
_mt=input.color(#757575,"Color horas",group=_pl)
_ee=input.bool(true,"Mostrar EMAs",group="EMAs")
_nz=input.int(9,"EMA rápida",minval=1,group="EMAs")
_op=input.int(20,"EMA media",minval=1,group="EMAs")
_oq=input.int(200,"EMA lenta",minval=1,group="EMAs")
_oj=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_oe=input.color(#9E9D24,"Color EMA media",group="EMAs")
_oa=input.color(color.black,"Color EMA lenta",group="EMAs")
_ip=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ik=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fn=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_le=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vn=14
_sl=50
_tc=0.15
_qq=2.5
_rb=30
_pm=1.0
_lw=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oh="Colores"
_ae=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oh)
_v=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oh)
_ni=input.bool(true,"Marcar la vela del OB",group=_oh)
_ho=input.color(#FF00C8,"IFVG (magenta)",group=_oh)
_nn=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oh)
_kf=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oh)
type Zona
	int x1
	float _ah
	float _ai
	int dir
	float _bi=na
	int _sp=na
	bool _ln=false
var _hj=array.new<Zona>()
var _ic=array.new<Zona>()
var obs=array.new<Zona>()
var _xz=array.new<Zona>()
var _wb=array.new<Zona>()
var _qp=array.new<Zona>()
var _re=array.new<Zona>()
var _kv=array.new<Zona>()
var _xe=array.new<Zona>()
var _sx=array.new<Zona>()
var _pz=array.new<Zona>()
var _qc=array.new<Zona>()
var _ly=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ah
	float _ai
	color col
var _bj=array.new<Rango>()
_ey(Zona z)=>
	_fw=z.dir==1?low <=z._ai:high >=z._ah
	if not _fw
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ai):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fw
type Marca
	label lb
	line ln
	int bar
var _ji=array.new<Marca>()
var array<string> _fg=array.from("")
var array<int> _fb=array.from(0)
_am(label lb,line ln,int bar)=>
	_ji.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fg.set(0,lb.get_text())
		_fb.set(0,bar)
	if _ji.size()> 500
		_ji.shift()
_rd=ta.ema(close,_nz)
_sk=ta.ema(close,_op)
_jr=ta.ema(close,_oq)
_ck=ta.atr(_vn)
var string _uf='════════ Detection ════════'
var string _rr='════════ Structure Filters ════════'
var string _uz='════════ Range Behavior ════════'
var string _ua='════════ Visual Settings ════════'
_cw='Base + 2x + 3x'
_ph='Rangos'
_bn=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_ph)
_bq='Percentile band'
_eq=90.0
_mc='Bar close'
_kl=200
_ij=40.0
_em=500
_nd=0.18
_og='Wick reaches'
_iq=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_ph)
_ej=0.10
_rh=0.45
_ef=0.70
_jb='Extend to containment'
_jk=300
_ka=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_ph)
_he=true
_ll=0.25
_me='Close beyond'
_it=0.15
_hd=true
_hh=10
_mb=3
_fq=0
_nh='Custom'
_mf=#00A651
_lm=#E4002B
_fk=input.color(#F9A825,'Color del rango (neutral)',group=_ph)
_jx=4
_gp=93
_hc=true
_kb=true
_hi=input.bool(true,'Mostrar etiqueta del rango',group=_ph)
_kc=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_ph)
_is=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_ph)
_im='Small'
_fe=true
_jy='Small'
[_ch,_cf]=switch _nh
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_mf,_lm]
var color _bz=color.new(color.black,100)
var float _cg=3.0
var float _dr=1.6
_iv(string _wr)=>
	switch _wr
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fi(color _df)=>
	_ie=color.r(_df)/255.0
	_if=color.g(_df)/255.0
	_jn=color.b(_df)/255.0
	_td=_ie <=0.03928?_ie/12.92:math.pow((_ie+0.055)/1.055,2.4)
	_tl=_if <=0.03928?_if/12.92:math.pow((_if+0.055)/1.055,2.4)
	_tj=_jn <=0.03928?_jn/12.92:math.pow((_jn+0.055)/1.055,2.4)
	0.2126*_td+0.7152*_tl+0.0722*_tj
_mh(color _ok,color _ml)=>
	_ns=_fi(_ok)
	_kp=_fi(_ml)
	(math.max(_ns,_kp)+0.05)/(math.min(_ns,_kp)+0.05)
_ei(color _hq)=>
	_fi(_hq)> 0.179?#000000:#ffffff
_ny(color _df,color _mo,float _sa)=>
	color.rgb(color.r(_df)+(color.r(_mo)-color.r(_df))*_sa,color.g(_df)+(color.g(_mo)-color.g(_df))*_sa,color.b(_df)+(color.b(_mo)-color.b(_df))*_sa)
_bl(color _df,color _hq,float _on)=>
	_mo=_ei(_hq)
	_lu=_df
	for step=1 to 10
		if _mh(_lu,_hq)>=_on
			break
		_lu:=_ny(_df,_mo,step/10.0)
	_lu
_hx(float _xt)=>
	str.tostring(_xt,'#.##')+'%'
_qw(array<box> _kd,int _li,float _ax,float _an)=>
	array.clear(_kd)
	if not _kf
		for i=0 to _jx-1
			array.push(_kd,box.new(_li,_ax,bar_index,_an,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gi(array<box> _kd,float _ax,float _an,int _li,int _su,color _ob)=>
	_pu=array.size(_kd)
	if _pu > 0 and _ax > _an
		_gu=(_ax-_an)/_pu
		for i=0 to _pu-1
			_hs=array.get(_kd,i)
			_od=math.abs((i+0.5)/_pu-0.5)*2.0
			_ot=int(math.min(99,math.max(0,_gp+(1.0-_od)*10)))
			box.set_lefttop(_hs,_li,_ax-_gu*i)
			box.set_rightbottom(_hs,_su,_ax-_gu*(i+1))
			box.set_bgcolor(_hs,color.new(_ob,_ot))
_pf(array<box> _kd)=>
	if array.size(_kd)> 0
		for i=0 to array.size(_kd)-1
			box.delete(array.get(_kd,i))
	array.clear(_kd)
_qt(int _sd,float _ax,float _an,float _ci)=>
	_yi=_sd
	if _jb=='Extend to containment'
		_xw=math.min(_jk,bar_index)
		_vb=math.max(2,math.round((1.0-_ef)*_sd))
		_lv=0
		_gz=0
		while _gz < _xw and _lv <=_vb
			_nl=close[_gz]<=_ax and close[_gz]>=_an
			_sz=_nl and high[_gz]<=_ax+_ci and low[_gz]>=_an-_ci
			if _nl
				_lv:=math.max(0,_lv-1)
				if _sz and _gz+1 >=_sd
					_yi:=_gz+1
			else
				_lv+=1
			_gz+=1
	_yi
_cp=ta.atr(_kl)
_kx=not na(_cp)and _cp > 0
_go=_me=='Wick beyond'
_kh=_og=='Wick reaches'
_oi=_mc=='Live bar'
_gc=_oi or barstate.isconfirmed
_gl=_iv(_im)
_lc=_iv(_jy)
_x=chart.bg_color
_r=_bl(_fk,_x,_cg)
_gb=_bl(_ch,_x,_cg)
_fv=_bl(_cf,_x,_cg)
_hf=_bl(_fk,_x,_dr)
_fo=_bl(_ch,_x,_dr)
_fx=_bl(_cf,_x,_dr)
_gm(simple int len)=>
	_vp=ta.percentile_linear_interpolation(high,len,_eq)
	_qz=ta.percentile_linear_interpolation(low,len,100.0-_eq)
	_vr=ta.highest(high,len)
	_ra=ta.lowest(low,len)
	_tu=ta.highest(math.max(open,close),len)
	_or=ta.lowest(math.min(open,close),len)
	top=_bq=='Absolute extremes'?_vr:_bq=='Body extremes'?_tu:_vp
	_kw=_bq=='Absolute extremes'?_ra:_bq=='Body extremes'?_or:_qz
	_dp=top-_kw
	_om=_kx and _dp > 0?_dp/(_cp*math.sqrt(len)):99.0
	_tn=bar_index < 1?_em:int(math.max(1,math.min(_em,bar_index-_kl)))
	_yq=ta.percentrank(_om,_tn)
	_xx=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_ya=_dp > 0?math.abs(_xx)*len/_dp:99.0
	_cv=math.avg(top,_kw)
	_ci=_ej*nz(_cp)
	_nc=0
	_pn=0
	_io=0
	_na=0
	for i=0 to len-1
		if(close[i]> _cv)!=(close[i+1]> _cv)
			_nc+=1
		_pi=_kh?high[i]>=top-_ci:close[i]>=top-_ci
		_jz=_kh?low[i]<=_kw+_ci:close[i]<=_kw+_ci
		if _pi
			_pn+=1
		if _jz
			_io+=1
		if close[i]<=top and close[i]>=_kw
			_na+=1
	_nw=_na/float(len)
	_je=_kx and not na(_yq)and bar_index > len+5 and _yq <=_ij and _nc >=math.max(3,math.round(_nd*len))and _pn >=_iq and _io >=_iq and _ya <=_rh and _nw >=_ef
	[_je,top,_kw]
bool _ii=false
bool _iz=false
bool _jc=false
float _wf=na
float _wi=na
float _wt=na
float _qg=na
float _ps=na
float _pq=na
if _be
	[qa,ta_,ba]=_gm(_bn)
	_ii:=qa
	_wf:=ta_
	_qg:=ba
	if _cw !='Base only'
		[qb,tb,bb]=_gm(_bn*2)
		_iz:=qb
		_wi:=tb
		_ps:=bb
	if _cw=='Base + 2x + 3x'
		[qc,tc,bc]=_gm(_bn*3)
		_jc:=qc
		_wt:=tc
		_pq:=bc
_ew=_cw !='Base only' and _iz
_ev=_cw=='Base + 2x + 3x' and _jc
_je=_ii or _ew or _ev
_oy=_ev?_bn*3:_ew?_bn*2:_bn
_qe=_ev?_wt:_ew?_wi:_wf
_ih=_ev?_pq:_ew?_ps:_qg
var array<box> _at=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _w=na
var label _z=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gv=na
var bool _t=false
var bool _l=false
var bool _aw=false
var int _dx=na
var int _q=0
var float _p=na
var int _bc=na
var int _bg=0
_cc=false
_cq=false
_bk=false
_cb=false
if _gc and _bg > 0
	_bg-=1
if _gc and not _t and not _aw and _bg <=0 and _je
	_pc=_qt(_oy,_qe,_ih,_ej*_cp)
	_c:=bar_index-_pc+1
	_gv:=bar_index
	_f:=_qe
	_a:=_ih
	_t:=true
	_l:=false
	_cv=math.avg(_f,_a)
	_bw=_a+(_f-_a)*0.25
	_bf=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qw(_at,_c,_f,_a)
	if _hc
		_g:=line.new(_c,_cv,bar_index,_cv,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kb
		_k:=line.new(_c,_bw,bar_index,_bw,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_bf,bar_index,_bf,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hi
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bz,style=label.style_label_down,textcolor=color.new(_r,10),size=_gl)
	_cc:=true
if _t and _gc
	_ct=_it*_cp
	_ft=_ll*_cp
	if _he and not _go and close <=_f and close >=_a
		if high > _f and high <=_f+_ft
			_f:=high
		if low < _a and low >=_a-_ft
			_a:=low
	_po=_go?high > _f+_ct:close > _f+_ct
	_kq=_go?low < _a-_ct:close < _a-_ct
	_qo=_fq > 0 and bar_index-_gv+1 >=_fq
	if _po or _kq or _qo
		_b=_po?1:_kq?-1:0
		_rk=_b !=0?bar_index-_c:bar_index-_c+1
		_mx=_a !=0?(_f-_a)/_a*100.0:0.0
		_ju=_hd and _b !=0 and _l
		if _l
			_fh=_b==1?_gb:_b==-1?_fv:_r
			_oc=_b==1?_fo:_b==-1?_fx:_hf
			_il=_b==1?_ch:_b==-1?_cf:_fk
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_fh,30))
			box.set_border_style(_u,line.style_dotted)
			_gi(_at,_f,_a,_c,bar_index,na)
			_bj.push(Rango.new(_c,bar_index,_f,_a,_oc))
			if _bj.size()> 8
				_bj.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_rk)+' BARS   '+_hx(_mx))
				label.set_textcolor(_z,color.new(_fh,10))
			if _kc and _b !=0
				_ou=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fe
