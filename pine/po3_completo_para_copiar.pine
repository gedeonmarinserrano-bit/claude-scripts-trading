		for q in _pm(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_pc(q.x1,q.x2,m,_qd)
	_gi.push(Pieza.new(x1,x2,_ai,_ah,dir))
_bb(array<Zona> arr,color _xq,color _xs,int _uc,string txt,bool _yq,bool _tm,color _oh,bool _rr)=>
	if arr.size()> 0
