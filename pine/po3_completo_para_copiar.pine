	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_ga:k==3?_gv:k==4?_lu:_mj
		_yo=k < 2 or(k < 4?not _at:not _ck)
		_vs=k%2==0
		if _yo and not na(nv)and not _ac.get(k)and(_vs?high > nv and close < nv:low < nv and close > nv)
			_ac.set(k,true)
			nom=(k < 2?(_vs?"PDH":"PDL"):k < 4?(_vs?"Alto Asia":"Bajo Asia"):(_vs?"Alto Londres":"Bajo Londres"))
			_eg.push(label.new(bar_index,_vs?high:low,"Barrido "+nom,style=_vs?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _eg.size()> 20
				_eg.shift().delete()
type Igual
	line ln
