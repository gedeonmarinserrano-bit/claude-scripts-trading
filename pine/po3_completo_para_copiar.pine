_ia=_am
_jl=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_rw)
_db=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_rw)
_qe=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_rw)
_qg=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_rw)
_dg=input.color(#424242,"Color niveles clave",group=_rw)
_mk=input.color(#757575,"Color horas",group=_rw)
_dv=input.bool(true,"Mostrar EMAs",group="EMAs")
_oc=input.int(9,"EMA rápida",minval=1,group="EMAs")
_np=input.int(20,"EMA media",minval=1,group="EMAs")
_nz=input.int(200,"EMA lenta",minval=1,group="EMAs")
_nw=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_nl=input.color(#9E9D24,"Color EMA media",group="EMAs")
_of=input.color(color.black,"Color EMA lenta",group="EMAs")
_im=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ht=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fe=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_ju=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_tw=14
_rt=50
_ry=0.15
_px=2.5
_py=30
_pb=1.0
_lb=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_ng="Colores"
_z=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_ng)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_ng)
_mi=input.bool(true,"Marcar la vela del OB",group=_ng)
_hc=input.color(#FF00C8,"IFVG (magenta)",group=_ng)
_my=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_ng)
_jy=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_ng)
type Zona
	int x1
	float _af
	float _ag
	int dir
	float _be=na
	int _rh=na
	bool _kv=false
var _gr=array.new<Zona>()
var _ip=array.new<Zona>()
var obs=array.new<Zona>()
var _wo=array.new<Zona>()
var _uy=array.new<Zona>()
var _qb=array.new<Zona>()
var _qc=array.new<Zona>()
var _kn=array.new<Zona>()
var _wc=array.new<Zona>()
var _sf=array.new<Zona>()
var _ot=array.new<Zona>()
var _ox=array.new<Zona>()
var _lu=array.new<Zona>()
type Rango
	int x1
	int x2
	float _af
	float _ag
	color col
var _bf=array.new<Rango>()
_eo(Zona z)=>
	_ff=z.dir==1?low <=z._ag:high >=z._af
	if not _ff
		_be=na(z._be)?(z.dir==1?z._af:z._ag):z._be
		if z.dir==1?low < _be:high > _be
			z._be:=z.dir==1?low:high
	_ff
type Marca
	label lb
	line ln
	int bar
var _is=array.new<Marca>()
var array<string> _ev=array.from("")
var array<int> _ep=array.from(0)
_ai(label lb,line ln,int bar)=>
	_is.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_ev.set(0,lb.get_text())
		_ep.set(0,bar)
	if _is.size()> 500
		_is.shift()
_pz=ta.ema(close,_oc)
_qz=ta.ema(close,_np)
_ih=ta.ema(close,_nz)
_eh=ta.atr(_tw)
var string _tj='════════ Detection ════════'
var string _ql='════════ Structure Filters ════════'
var string _uu='════════ Range Behavior ════════'
var string _te='════════ Visual Settings ════════'
_co='Base + 2x + 3x'
_ns='Rangos'
_bi=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_ns)
_bm='Percentile band'
_ef=90.0
_la='Bar close'
_jv=200
_io=40.0
_dz=500
_mp=0.18
_nt='Wick reaches'
_hw=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_ns)
_eg=0.10
_qy=0.45
_ec=0.70
_jf='Extend to containment'
_ig=300
_jo=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_ns)
_gy=true
_kx=0.25
_ld='Close beyond'
_hi=0.15
_gt=true
_gs=10
_lh=3
_ft=0
_mf='Custom'
_kt=#00A651
_ky=#E4002B
_fa=input.color(#F9A825,'Color del rango (neutral)',group=_ns)
_jq=4
_fv=93
_gu=true
_jp=true
_gv=input.bool(true,'Mostrar etiqueta del rango',group=_ns)
_jk=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_ns)
_hz=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_ns)
_if='Small'
_es=true
_jj='Small'
[_cf,_ce]=switch _mf
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_kt,_ky]
var color _bz=color.new(color.black,100)
var float _cd=3.0
var float _dl=1.6
_jh(string _vh)=>
	switch _vh
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_ew(color _dd)=>
	_hh=color.r(_dd)/255.0
	_hq=color.g(_dd)/255.0
	_hl=color.b(_dd)/255.0
	_sy=_hh <=0.03928?_hh/12.92:math.pow((_hh+0.055)/1.055,2.4)
	_ss=_hq <=0.03928?_hq/12.92:math.pow((_hq+0.055)/1.055,2.4)
	_sl=_hl <=0.03928?_hl/12.92:math.pow((_hl+0.055)/1.055,2.4)
	0.2126*_sy+0.7152*_ss+0.0722*_sl
_ks(color _nf,color _mt)=>
	_lw=_ew(_nf)
	_kd=_ew(_mt)
	(math.max(_lw,_kd)+0.05)/(math.min(_lw,_kd)+0.05)
_ed(color _hd)=>
	_ew(_hd)> 0.179?#000000:#ffffff
_nb(color _dd,color _mg,float _ri)=>
	color.rgb(color.r(_dd)+(color.r(_mg)-color.r(_dd))*_ri,color.g(_dd)+(color.g(_mg)-color.g(_dd))*_ri,color.b(_dd)+(color.b(_mg)-color.b(_dd))*_ri)
_bl(color _dd,color _hd,float _od)=>
	_mg=_ed(_hd)
	_lr=_dd
	for step=1 to 10
		if _ks(_lr,_hd)>=_od
			break
		_lr:=_nb(_dd,_mg,step/10.0)
	_lr
_iy(float _ws)=>
	str.tostring(_ws,'#.##')+'%'
_pw(array<box> _jn,int _ll,float _bb,float _ah)=>
	array.clear(_jn)
	if not _jy
		for i=0 to _jq-1
			array.push(_jn,box.new(_ll,_bb,bar_index,_ah,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_fw(array<box> _jn,float _bb,float _ah,int _ll,int _ru,color _oh)=>
	_ou=array.size(_jn)
	if _ou > 0 and _bb > _ah
		_gm=(_bb-_ah)/_ou
		for i=0 to _ou-1
			_iq=array.get(_jn,i)
			_nr=math.abs((i+0.5)/_ou-0.5)*2.0
			_nn=int(math.min(99,math.max(0,_fv+(1.0-_nr)*10)))
			box.set_lefttop(_iq,_ll,_bb-_gm*i)
			box.set_rightbottom(_iq,_ru,_bb-_gm*(i+1))
			box.set_bgcolor(_iq,color.new(_oh,_nn))
_nk(array<box> _jn)=>
	if array.size(_jn)> 0
		for i=0 to array.size(_jn)-1
			box.delete(array.get(_jn,i))
	array.clear(_jn)
_qf(int _rc,float _bb,float _ah,float _cl)=>
	_xd=_rc
	if _jf=='Extend to containment'
		_wy=math.min(_ig,bar_index)
		_tm=math.max(2,math.round((1.0-_ec)*_rc))
		_lg=0
		_gh=0
		while _gh < _wy and _lg <=_tm
			_lz=close[_gh]<=_bb and close[_gh]>=_ah
			_sr=_lz and high[_gh]<=_bb+_cl and low[_gh]>=_ah-_cl
			if _lz
				_lg:=math.max(0,_lg-1)
				if _sr and _gh+1 >=_rc
					_xd:=_gh+1
			else
				_lg+=1
			_gh+=1
	_xd
_cg=ta.atr(_jv)
_kb=not na(_cg)and _cg > 0
_fx=_ld=='Wick beyond'
_ka=_nt=='Wick reaches'
_nj=_la=='Live bar'
_fm=_nj or barstate.isconfirmed
_ga=_jh(_if)
_jt=_jh(_jj)
_v=chart.bg_color
_r=_bl(_fa,_v,_cd)
_fl=_bl(_cf,_v,_cd)
_fs=_bl(_ce,_v,_cd)
_gq=_bl(_fa,_v,_dl)
_fd=_bl(_cf,_v,_dl)
_fq=_bl(_ce,_v,_dl)
_gf(simple int len)=>
	_tz=ta.percentile_linear_interpolation(high,len,_ef)
	_qj=ta.percentile_linear_interpolation(low,len,100.0-_ef)
	_ts=ta.highest(high,len)
	_qa=ta.lowest(low,len)
	_sq=ta.highest(math.max(open,close),len)
	_oo=ta.lowest(math.min(open,close),len)
	top=_bm=='Absolute extremes'?_ts:_bm=='Body extremes'?_sq:_tz
	_ke=_bm=='Absolute extremes'?_qa:_bm=='Body extremes'?_oo:_qj
	_di=top-_ke
	_om=_kb and _di > 0?_di/(_cg*math.sqrt(len)):99.0
	_sp=bar_index < 1?_dz:int(math.max(1,math.min(_dz,bar_index-_jv)))
	_xa=ta.percentrank(_om,_sp)
	_wv=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_wt=_di > 0?math.abs(_wv)*len/_di:99.0
	_cn=math.avg(top,_ke)
	_cl=_eg*nz(_cg)
	_mh=0
	_po=0
	_hj=0
	_lx=0
	for i=0 to len-1
		if(close[i]> _cn)!=(close[i+1]> _cn)
			_mh+=1
		_nh=_ka?high[i]>=top-_cl:close[i]>=top-_cl
		_js=_ka?low[i]<=_ke+_cl:close[i]<=_ke+_cl
		if _nh
			_po+=1
		if _js
			_hj+=1
		if close[i]<=top and close[i]>=_ke
			_lx+=1
	_nq=_lx/float(len)
	_iv=_kb and not na(_xa)and bar_index > len+5 and _xa <=_io and _mh >=math.max(3,math.round(_mp*len))and _po >=_hw and _hj >=_hw and _wt <=_qy and _nq >=_ec
	[_iv,top,_ke]
bool _jd=false
bool _iz=false
bool _hn=false
float _vd=na
float _wf=na
float _va=na
float _pj=na
float _pr=na
float _pf=na
if _bj
	[qa,ta_,ba]=_gf(_bi)
	_jd:=qa
	_vd:=ta_
	_pj:=ba
	if _co !='Base only'
		[qb,tb,bb]=_gf(_bi*2)
		_iz:=qb
		_wf:=tb
		_pr:=bb
	if _co=='Base + 2x + 3x'
		[qc,tc,bc]=_gf(_bi*3)
		_hn:=qc
		_va:=tc
		_pf:=bc
_el=_co !='Base only' and _iz
_ej=_co=='Base + 2x + 3x' and _hn
_iv=_jd or _el or _ej
_nx=_ej?_bi*3:_el?_bi*2:_bi
_ov=_ej?_va:_el?_wf:_vd
_hk=_ej?_pf:_el?_pr:_pj
var array<box> _aq=array.new<box>()
var box _s=na
var line _g=na
var line _k=na
var line _w=na
var label _y=na
var label _ar=na
var float _f=na
var float _a=na
var int _c=na
var int _gk=na
var bool _t=false
var bool _m=false
var bool _aw=false
var int _dm=na
var int _o=0
var float _p=na
var int _bd=na
var int _ax=0
_cb=false
_ch=false
_bk=false
_by=false
if _fm and _ax > 0
	_ax-=1
if _fm and not _t and not _aw and _ax <=0 and _iv
	_ol=_qf(_nx,_ov,_hk,_eg*_cg)
	_c:=bar_index-_ol+1
	_gk:=bar_index
	_f:=_ov
	_a:=_hk
	_t:=true
	_m:=false
	_cn=math.avg(_f,_a)
	_bs=_a+(_f-_a)*0.25
	_ay=_a+(_f-_a)*0.75
	_s:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_pw(_aq,_c,_f,_a)
	if _gu
		_g:=line.new(_c,_cn,bar_index,_cn,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jp
		_k:=line.new(_c,_bs,bar_index,_bs,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_ay,bar_index,_ay,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gv
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_bz,style=label.style_label_down,textcolor=color.new(_r,10),size=_ga)
	_cb:=true
if _t and _fm
	_cp=_hi*_cg
	_fj=_kx*_cg
	if _gy and not _fx and close <=_f and close >=_a
		if high > _f and high <=_f+_fj
			_f:=high
		if low < _a and low >=_a-_fj
			_a:=low
	_pn=_fx?high > _f+_cp:close > _f+_cp
	_km=_fx?low < _a-_cp:close < _a-_cp
	_qi=_ft > 0 and bar_index-_gk+1 >=_ft
	if _pn or _km or _qi
		_b=_pn?1:_km?-1:0
		_qx=_b !=0?bar_index-_c:bar_index-_c+1
		_mq=_a !=0?(_f-_a)/_a*100.0:0.0
		_jr=_gt and _b !=0 and _m
		if _m
			_ez=_b==1?_fl:_b==-1?_fs:_r
			_ny=_b==1?_fd:_b==-1?_fq:_gq
			_ib=_b==1?_cf:_b==-1?_ce:_fa
			box.set_lefttop(_s,_c,_f)
			box.set_rightbottom(_s,bar_index,_a)
			box.set_border_color(_s,color.new(_ez,30))
			box.set_border_style(_s,line.style_dotted)
			_fw(_aq,_f,_a,_c,bar_index,na)
			_bf.push(Rango.new(_c,bar_index,_f,_a,_ny))
			if _bf.size()> 8
				_bf.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_qx)+' BARS   '+_iy(_mq))
				label.set_textcolor(_y,color.new(_ez,10))
			if _jk and _b !=0
				_ne=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _es
					_ar:=label.new(bar_index,_b==1?low:high,_b==1?'▲':'▼',xloc=xloc.bar_index,yloc=yloc.price,color=_bz,style=_b==1?label.style_label_up:label.style_label_down,textcolor=color.new(_ez,20),size=_jt,tooltip='Breakout del rango')
				else
					_ar:=label.new(bar_index,_b==1?low:high,_ne,xloc=xloc.bar_index,yloc=yloc.price,color=color.new(_ib,10),style=_b==1?label.style_label_up:label.style_label_down,textcolor=_ed(_ib),size=_ga)
			if _b==1
				_ch:=true
			else if _b==-1
				_bk:=true
		else
