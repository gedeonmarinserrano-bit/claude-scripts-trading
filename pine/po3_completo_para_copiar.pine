	if not na(_nj)
		_rr=not na(_hl)and _qo-_hl <=_qk
		d1=_rr and _pb and _dn(_nj,_fx,_qg,_ip,false)
		d2=_rr and _ns and _dn(_nj,_fx,_px,_hx,false)
		if d1 or d2
			_ja:=true
			_co:=bar_index
			_do:=1
			_jl=_nj < _fx
			xv=_jl?_qo:bar_index+int(d1?_ro:_rg)
			t1=_fv(_sm,_qg,_ip)
			t2=_fv(_se,_px,_hx)
			_kp(_hl,_fx,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jq,false)
		_hl:=_qo
		_fx:=_nj
		_ip:=_qg
		_hx:=_px
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _em=array.new<box>()
var array<line> _de=array.new<line>()
var array<label> _bw=array.new<label>()
var array<int> uso=array.from(0,0,0)
_ra(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _em.size()
		b=_em.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_em.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_ox(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _de.size()
		l=_de.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_de.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_mj(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bw.size()
