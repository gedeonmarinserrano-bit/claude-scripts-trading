		m=(_ag+_ah)/2
		for q in _pl(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_oz(q.x1,q.x2,m,_qc)
	_gj.push(Pieza.new(x1,x2,_ag,_ah,dir))
_bd(array<Zona> arr,color _xu,color _xq,int _uj,string txt,bool _yd,bool _sy,color _oq,bool _sj)=>
	if arr.size()> 0
