			_em.push(label.new(bar_index,_ve?high:low,"Barrido "+nom,style=_ve?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _em.size()> 20
