	_dg(1,_bj,_bj and not _bj[1],_gt,-1,"Asia",#5E35B1)
	_dg(2,_di,_di and not _di[1],_ma,1,"Londres",#1E88E5)
	_dg(3,_di,_di and not _di[1],_ms,-1,"Londres",#1E88E5)
