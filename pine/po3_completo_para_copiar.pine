_er(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_df(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_sc=(dir==1?"Máximo ":"Mínimo ")+ses
	o=_eh.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _o.size()> 0
			for i=_o.size()-1 to 0
				q=_o.get(i)
				if q.k==k
					_o.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_er(bar_index,v,_sc,col)
		_eh.set(k,NivelSes.new(ln,lb,v,na,k,bar_index))
	else if not na(o)
		if en and not na(o.ln)
			o._aa:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if na(o.ln)
			if dir==1?high > o._aa:low < o._aa
				o._aa:=dir==1?high:low
				o._xj:=bar_index
			if bar_index-o._tf >=5
				dup=false
				for j=0 to 5
					p=_eh.get(j)
					if j !=k and not na(p)and not na(p.ln)and math.abs(p._aa-o._aa)<=0.1*nz(_cl)
						dup:=true
				if dup
					_eh.set(k,na)
				else
					[ln,lb]=_er(o._xj,o._aa,_sc,col)
					o.ln:=ln
					o.lb:=lb
					o.lb.set_xy(bar_index,o._aa)
		else if dir==1?high > o._aa:low < o._aa
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._aa)
			o.lb.set_text((dir==1?"Máximo manipulado ":"Mínimo manipulado ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			_o.push(o)
			if _o.size()> 24
				q=_o.shift()
				q.ln.delete()
				q.lb.delete()
			_eh.set(k,NivelSes.new(na,na,dir==1?high:low,bar_index,k,bar_index))
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._aa)
_ly=timeframe.change("D")
if _mr and _ji and _be
