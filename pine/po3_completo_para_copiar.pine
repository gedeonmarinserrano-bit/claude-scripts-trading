_ha="SMT (divergencias entre índices)"
_du=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_ha)
_ld=input.bool(true,"Mostrar etiquetas de la SMT",group=_ha)
_rt=input.bool(true,"Mostrar línea de la SMT",group=_ha)
_tb=input.bool(true,"Comparar con",inline="smt1",group=_ha)
_pf=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_ha)
_ta=input.bool(true,"Comparar con",inline="smt2",group=_ha)
_pn=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_ha)
_ge=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_ha)
_pu=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_ha)
_re=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_ha)
_ic=input.color(#ff1100,"SMT bajista (en altos)",group=_ha)
_hw=input.color(#2157f3,"SMT alcista (en bajos)",group=_ha)
_ko(string s)=>
	_tn=str.split(s,":")
	_tn.size()> 0?_tn.last():s
_rc=_ko(_pf)
_rk=_ko(_pn)
_vh=str.replace(_rc,"1!","")
_vu=str.replace(_rk,"1!","")
_tk=str.replace(syminfo.ticker,"1!","")
_nj=_du and _tb and _vh !=_tk
_nm=_du and _ta and _vu !=_tk
_rb()=>
	w=2*_ge+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _ox=na
float _pq=na
int _qu=na
int _rw=na
float _pl=na
float _pg=na
int _rn=na
int _rd=na
if _nj and _au
	[h_,l_,hb_,lb_]=request.security(_pf,timeframe.period,_rb(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_ox:=h_
	_pq:=l_
	_qu:=hb_
	_rw:=lb_
if _nm and _au
	[h_,l_,hb_,lb_]=request.security(_pn,timeframe.period,_rb(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pl:=h_
	_pg:=l_
	_rn:=hb_
	_rd:=lb_
_ne=ta.pivothigh(high,_ge,_ge)
_mp=ta.pivotlow(low,_ge,_ge)
_qa=bar_index-_ge
var int _hi=na
var float _ft=na
var float _jk=na
var float _jb=na
var int _hj=na
var float _fe=na
var float _ji=na
var float _jc=na
var array<line> _ga=array.new<line>()
var array<label> _gi=array.new<label>()
_dl(float y,float _ui,float c,float _ms,bool _nw)=>
	_up=_nw?y > _ui:y < _ui
	_ug=_nw?c > _ms:c < _ms
	not na(_ui)and not na(_ms)and not na(c)and _up !=_ug
_fu(string t,float c,float _ms)=>
	t+(c > _ms?" ↑":c < _ms?" ↓":" =")
_kg(int x1,float y1,int xv,string txt,color col,bool _nw)=>
	yv=_nw?high[bar_index-xv]:low[bar_index-xv]
	if _rt
		_ga.push(line.new(x1,y1,xv,yv,color=col))
	if _ld
		_gi.push(label.new(xv,yv,txt,style=_nw?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_nw?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_nw?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _ga.size()> _re
		_ga.shift().delete()
	if _gi.size()> _re
		_gi.shift().delete()
var int _cl=na
var int _dn=0
_if=false
_iv=false
if barstate.isconfirmed
	if not na(_ne)
		_qz=not na(_hi)and _qa-_hi <=_pu
		d1=_qz and _nj and _dl(_ne,_ft,_ox,_jk,true)
		d2=_qz and _nm and _dl(_ne,_ft,_pl,_jb,true)
		if d1 or d2
			_if:=true
			_cl:=bar_index
			_dn:=-1
			_ht=_ne > _ft
			xv=_ht?_qa:bar_index+int(d1?_qu:_rn)
			t1=_fu(_rc,_ox,_jk)
			t2=_fu(_rk,_pl,_jb)
			_kg(_hi,_ft,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ic,true)
		_hi:=_qa
		_ft:=_ne
		_jk:=_ox
		_jb:=_pl
	if not na(_mp)
		_qz=not na(_hj)and _qa-_hj <=_pu
		d1=_qz and _nj and _dl(_mp,_fe,_pq,_ji,false)
		d2=_qz and _nm and _dl(_mp,_fe,_pg,_jc,false)
		if d1 or d2
			_iv:=true
			_cl:=bar_index
			_dn:=1
			_ht=_mp < _fe
			xv=_ht?_qa:bar_index+int(d1?_rw:_rd)
			t1=_fu(_rc,_pq,_ji)
			t2=_fu(_rk,_pg,_jc)
			_kg(_hj,_fe,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_hw,false)
		_hj:=_qa
		_fe:=_mp
		_ji:=_pq
		_jc:=_pg
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _ek=array.new<box>()
var array<line> _df=array.new<line>()
var array<label> _bu=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qc(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _ek.size()
		b=_ek.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_ek.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_ol(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _df.size()
		l=_df.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_df.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_kx(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bu.size()
		e=_bu.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bu.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _wz
	bool _rm
var array<Letrero> _fl=array.new<Letrero>()
_nq=nz(ta.atr(50))*0.5
_ul=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_od)
_eb=nz(ta.atr(50))*_ul/100
var array<Pieza> _fz=array.new<Pieza>()
_we(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_oy(Pieza p)=>
	res=array.from(p)
	if _kh and _fz.size()> 0
		for o in _fz
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_vl=array.new<Pieza>()
				for q in res
					for r in _we(q,o)
						_vl.push(r)
				res:=_vl
				if res.size()==0 or res.size()> 10
					break
	res
_gn(Pieza p,color col,int dir)=>
	for q in _oy(p)
		top=q.top
		bot=q.bot
		if _eb > 0 and dir !=0
			for o in _fz
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_eb
						top:=math.min(top,o.bot-_eb)
					if math.abs(bot-o.top)<=_eb
						bot:=math.max(bot,o.top+_eb)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qc(q.x1,top,q.x2,bot,col)
_mx(int _us,int x2,float _ag,float _af,int dir,float _bf,color col,string txt,color _vj,color _oz,color _nt,bool _rm)=>
	x1=math.max(_us,bar_index-1000)
	_xo=na(_bf)?_ag:(dir==1?_bf:_ag)
	_xj=na(_bf)?_af:(dir==1?_af:_bf)
	_gn(Pieza.new(x1,x2,_xo,_xj),col,dir)
	if not na(_bf)
		_gn(Pieza.new(x1,x2,dir==1?_ag:_bf,dir==1?_bf:_af),_nt,dir)
	if txt !="" and _fl.size()< 60
		_fl.push(Letrero.new(x2,(_xo+_xj)/2,txt,_vj,true,_rm))
	if not na(_oz)
		m=(_ag+_af)/2
		for q in _oy(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_ol(q.x1,q.x2,m,_oz)
	_fz.push(Pieza.new(x1,x2,_ag,_af,dir))
_ba(array<Zona> arr,color _xb,color _wy,int _tl,string txt,bool _xt,bool _sm,color _nt,bool _rm)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xb:_wy
			t=txt
			_ye=z._af > close?z._af-close:close > z._ag?close-z._ag:0.0
			if uso.get(0)< 440 and _fz.size()< _lb and(_po==0 or _ye/close*100 <=_po)
				_mx(z.x1,bar_index+1,z._ag,z._af,z.dir,z._bf,color.new(c,_my),t,c,_sm?color.new(color.white,30):na,_nt,_rm)
_at()=>
	if _ow
		_ba(_hk,_hh,_hh,88,"IFVG "+_dt,true,false,_al,false)
		_ba(_hb,_sh,_sz,80,"FVG "+_dt,true,false,_al,true)
	_ba(obs,_ke,_jz,90,"OB "+_dt,true,false,_al,false)
_dj(bool ver,int _ve,array<Zona> f,array<Zona> fi,color ca,color cb,int _tl,string nom)=>
	if ver and not _m and _d !=_ve*60
		_ba(fi,_hh,_hh,88,"IFVG "+nom,true,false,_al,false)
		_ba(f,ca,cb,_tl,"FVG "+nom,true,_ve >=15,_al,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fl.clear()
	_fz.clear()
	_ad=false
	if _d <=60
		_at()
		_ad:=true
	_dj(_cq,1,_wt,_wm,_mq,_mb,84,"M1")
	if not _ad and _d <=300
		_at()
		_ad:=true
	_dj(_bw,5,_va,_sd,_nd,_md,84,"M5")
	if not _ad and _d <=900
		_at()
		_ad:=true
	_dj(_bd,15,_qg,_px,_kr,_kf,84,"M15")
	if not _ad and _d <=3600
		_at()
		_ad:=true
	_dj(_av,60,_qb,_pk,_kk,_kj,82,"H1")
	if not _ad and _d <=14400
		_at()
		_ad:=true
	_dj(_ap,240,_kb,_ln,_hm,_iq,80,"H4")
	if not _ad
		_at()
	if _fl.size()> 0
		_mf=array.new<Letrero>()
		for l in _fl
			x=l.x
			_wu=str.length(l.txt)+2
			for _wx=0 to 3
				_vs=false
				for c in _mf
					_rq=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _nq and x > c.x-_rq and x-_wu < c.x
						x:=c.x-_rq
						_vs:=true
				if not _vs
					break
			_mf.push(Letrero.new(x,l.y,l.txt,l.col,true,l._rm))
			_kx(x,l.y,l.txt,color.white)
	while _ek.size()> uso.get(0)
		_ek.pop().delete()
	while _df.size()> uso.get(1)
		_df.pop().delete()
	while _bu.size()> uso.get(2)
		_bu.pop().delete()
_pc()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bm(array<Zona> arr,string nom,bool _wa)=>
	float _si=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bf)?z._af:z._bf
		hi=z.dir==-1 or na(z._bf)?z._ag:z._bf
		d=close >=lo and close <=hi?0.0:_wa?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_si)or d < _si)
			_si:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_si,txt]
_ps(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_lx(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_lg(int b)=>
	b==1?_ac:b==-1?_u:#757575
_vt(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wh(string n)=>
	str.contains(n,"alcista")?_ac:str.contains(n,"bajista")?_u:#757575
_rf(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _eg=na
if barstate.islast and _lv
	pos=_ig=="Arriba izquierda"?position.top_left:_ig=="Abajo derecha"?position.bottom_right:_ig=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_mn=="Muy pequeño"?size.tiny:_mn=="Normal"?size.normal:size.small
	if na(_eg)
		_eg:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_eg.clear(0,0,1,13)
	int f=0
	int _vx=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_vx:=request.security(syminfo.tickerid,"240",_pc(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_pc(),lookahead=barmerge.lookahead_on)
	_ps(_eg,f,"Bias H4",_d < 14400?_lx(_vx):"(gráfico ≥ H4)",_lg(_vx),tam)
	f+=1
	_ps(_eg,f,"Bias H1",_d < 3600?_lx(b60):"(gráfico ≥ H1)",_lg(b60),tam)
	f+=1
	ev=_et.get(0)
	_vw=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ey.get(0))+" velas"
	_ps(_eg,f,"Estructura "+_dt,_lx(_i)+_vw,_lg(_i),tam)
	f+=1
	tz="America/New_York"
	_wg=hour(timenow,tz)*60+minute(timenow,tz)
	_xu=dayofweek(timenow,tz)
	_xm=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yd=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_wd=_xu==dayofweek.saturday or _xu==dayofweek.sunday
	_uz=570-_wg
	ses=_wd?"Cerrada (fin de semana)":_wg < 570?"Abre a las "+str.format_time(_xm,"HH:mm","Europe/Madrid")+" (en "+(_uz >=60?str.tostring(int(_uz/60))+" h ":"")+str.tostring(_uz%60)+" min)":_wg < 960?"● Abierta (cierra "+str.format_time(_yd,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_xm,"HH:mm","Europe/Madrid")+")"
	_ps(_eg,f,"Sesión NY",ses,not _wd and _wg >=570 and _wg < 960?_ac:#424242,tam)
	f+=1
	float _sc=na
	string _wi=""
	float _sa=na
	string _vk=""
	if _ow
		[d1,t1]=_bm(_hb,"FVG "+_dt,true)
		[d2,t2]=_bm(_hk,"IFVG "+_dt,true)
		[d3,t3]=_bm(_hb,"FVG "+_dt,false)
		[d4,t4]=_bm(_hk,"IFVG "+_dt,false)
		if not na(d1)and(na(_sc)or d1 < _sc)
			_sc:=d1
			_wi:=t1
		if not na(d2)and(na(_sc)or d2 < _sc)
			_sc:=d2
			_wi:=t2
		if not na(d3)and(na(_sa)or d3 < _sa)
			_sa:=d3
			_vk:=t3
		if not na(d4)and(na(_sa)or d4 < _sa)
			_sa:=d4
			_vk:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_wt:k==1?_va:k==2?_qg:k==3?_qb:_kb
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cq:k==1?_bw:k==2?_bd:k==3?_av:_ap
			if ver
				[da,ta_]=_bm(arr,nom,true)
				[db,tb]=_bm(arr,nom,false)
				if not na(da)and(na(_sc)or da < _sc)
					_sc:=da
					_wi:=ta_
				if not na(db)and(na(_sa)or db < _sa)
					_sa:=db
					_vk:=tb
	_ps(_eg,f,"FVG por arriba",_vt(_sc,_wi),_wh(_wi),tam)
	f+=1
	_ps(_eg,f,"FVG por abajo",_vt(_sa,_vk),_wh(_vk),tam)
	f+=1
	_uc=not _du?"(apagada)":na(_cl)?"Ninguna reciente":(_dn==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cl)+" velas"
	_ps(_eg,f,"SMT",_uc,not _du or na(_cl)?#757575:_dn==1?_hw:_ic,tam)
	f+=1
	if _oo
		_oj=request.security(_tu,"D",close[1],lookahead=barmerge.lookahead_on)
		[_ms,_vy,_vv]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_oj/16
		pts=_ms*pct/100
		_sk=pts > 0?(_vy-_vv)/pts*100:na
		_tx=na(_oj)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_oj,"#.#")+") · hoy "+str.tostring(_vy-_vv,"#")+" pts = "+str.tostring(_sk,"#")+" %"
		_ps(_eg,f,"Mov. esperado",_tx,na(_sk)?#757575:_sk >=100?_u:_sk >=75?#EF6C00:#424242,tam)
		f+=1
	if _ly and _ho
		_ps(_eg,f,"Asia",_rf(_fs,_gq,_bg,_jd,_ij),#5E35B1,tam)
		f+=1
		_ps(_eg,f,"Londres",_rf(_lw,_mh,_dc,_mi,_mj),#1E88E5,tam)
		f+=1
	if _ph or _fi
		[_wb,_uk,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _ph
			rng=d_h-d_l
			_ky=_uk > 0?rng/_uk*100:na
			_ps(_eg,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_uk,"#")+" pts ("+str.tostring(_ky,"#")+" %)",na(_ky)?#757575:_ky >=100?_u:_ky >=75?#EF6C00:#424242,tam)
			f+=1
		if _fi
			dif=close-_wb
			_ps(_eg,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_u:_ac,tam)
			f+=1
	if _le
		float _vd=na
		string _wl=""
		float _vc=na
		string _vq=""
		_ou=array.from(pdh,pdl,_jd?na:_fs,_ij?na:_gq,_mi?na:_lw,_mj?na:_mh)
		_ov=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _ar
			_ou.push(nv._bt)
			_ov.push(nv.dir==1?"Alto H4":"Bajo H4")
		for q in _dr
			_ou.push(q._bt)
			_ov.push(q.dir==1?"EQH":"EQL")
		for i=0 to _ou.size()-1
			pv=_ou.get(i)
			if not na(pv)
				if pv > close and(na(_vd)or pv < _vd)
					_vd:=pv
					_wl:=_ov.get(i)
				if pv < close and(na(_vc)or pv > _vc)
					_vc:=pv
					_vq:=_ov.get(i)
		_ts=(na(_vd)?"↑ —":"↑ "+_wl+" "+str.tostring(_vd,format.mintick)+" (+"+str.tostring(_vd-close,format.mintick)+")")+"  ·  "+(na(_vc)?"↓ —":"↓ "+_vq+" "+str.tostring(_vc,format.mintick)+" (−"+str.tostring(close-_vc,format.mintick)+")")
		_ps(_eg,f,"Liquidez",_ts,#424242,tam)
		f+=1
	if _pm !=""
		_ps(_eg,f,"Noticias hoy",_pm,#EF6C00,tam)
		f+=1
alertcondition(_if,"SMT bajista","SMT bajista (divergencia en altos entre índices) en {{ticker}} ({{interval}})")
alertcondition(_iv,"SMT alcista","SMT alcista (divergencia en bajos entre índices) en {{ticker}} ({{interval}})")
alertcondition(_lf,"CHoCH alcista","CHoCH alcista en {{ticker}} ({{interval}})")
alertcondition(_lr,"CHoCH bajista","CHoCH bajista en {{ticker}} ({{interval}})")
alertcondition(_dz,"CHoCH alcista de riesgo (⚠)","CHoCH alcista con riesgo de fallo en {{ticker}} ({{interval}})")
alertcondition(_dy,"CHoCH bajista de riesgo (⚠)","CHoCH bajista con riesgo de fallo en {{ticker}} ({{interval}})")
alertcondition(_dd,"CHoCH alcista fallido (✗)","CHoCH alcista fallido: posible reversión bajista en {{ticker}} ({{interval}})")
alertcondition(_dh,"CHoCH bajista fallido (✗)","CHoCH bajista fallido: posible reversión alcista en {{ticker}} ({{interval}})")
alertcondition(_cz,"Tendencia alcista reactivada","Tendencia alcista reactivada tras CHoCH fallido en {{ticker}} ({{interval}})")
alertcondition(_cv,"Tendencia bajista reactivada","Tendencia bajista reactivada tras CHoCH fallido en {{ticker}} ({{interval}})")
alertcondition(_in,"Retesteo de IFVG (velas siguientes)","El precio toca un IFVG en las velas siguientes a su creación en {{ticker}} ({{interval}})")
alertcondition(_ez,"IFVG alcista","Un FVG bajista se ha invertido (IFVG alcista) en {{ticker}} ({{interval}})")
alertcondition(_eu,"IFVG bajista","Un FVG alcista se ha invertido (IFVG bajista) en {{ticker}} ({{interval}})")
alertcondition(_hv,"FVG alcista","Nuevo FVG alcista en {{ticker}} ({{interval}})")
alertcondition(_hq,"FVG bajista","Nuevo FVG bajista en {{ticker}} ({{interval}})")
alertcondition(_cc,title='Range Detected',message='Auto Range Detector: new RANGE detected on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_cn,title='Range Breakout Up',message='Auto Range Detector: range broken to the UPSIDE on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_bl,title='Range Breakdown',message='Auto Range Detector: range broken to the DOWNSIDE on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_gw,title='Any Range Break',message='Auto Range Detector: range break on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_cb,title='Range Deviation',message='Auto Range Detector: failed break, price returned INSIDE the range on {{exchange}}:{{ticker}} - {{interval}}')
alertcondition(_il,"Precio en el 50% de un FVG M15","Precio tocando el 50% de un FVG de M15 en {{ticker}} ({{interval}})")
alertcondition(_ka,"Precio en el 50% de un FVG H1","Precio tocando el 50% de un FVG de H1 en {{ticker}} ({{interval}})")
alertcondition(_kt,"Precio en el 50% de un FVG H4","Precio tocando el 50% de un FVG de H4 en {{ticker}} ({{interval}})")
