indicator("Po3 + CHoCH PRO - High Contrast + FVG + Rangos + OB",overlay=true,max_labels_count=500,max_lines_count=500,max_boxes_count=500,max_bars_back=2000,behind_chart=true)
_cx="Panel de información"
_lv=input.bool(true,"Mostrar panel",group=_cx)
_ig=input.string("Arriba derecha","Posición",options=["Arriba derecha","Arriba izquierda","Abajo derecha","Abajo izquierda"],group=_cx)
_mn=input.string("Pequeño","Tamaño del texto",options=["Muy pequeño","Pequeño","Normal"],group=_cx)
_oo=input.bool(true,"Movimiento esperado del día (VIX / 16)",group=_cx)
_tu=input.symbol("CBOE:VIX","Índice de volatilidad (para el Nasdaq también vale CBOE:VXN)",group=_cx)
_ly=input.bool(true,"Rangos de Asia y Londres (alto, bajo y si se han barrido)",group=_cx)
_ph=input.bool(true,"Rango de hoy frente al ATR diario",group=_cx)
_fi=input.bool(true,"Precio frente a la apertura del día (premium / descuento)",group=_cx)
_le=input.bool(true,"Liquidez más cercana por arriba y por abajo",group=_cx)
_pm=input.string("","Noticias de hoy (texto libre, p. ej. «CPI 14:30»; vacío = no se muestra)",group=_cx)
_ir="Información en el gráfico"
_ls=input.bool(true,"Fondo suave en las sesiones de Asia, Londres y apertura de Nueva York",group=_ir)
_ud=input.bool(true,"Línea del 50 % del día anterior (por encima premium, por debajo descuento)",group=_ir)
_qx=input.bool(true,"Altos y bajos iguales sin barrer (EQH / EQL)",group=_ir)
_lz=input.bool(true,"Marcar barridos de niveles (pasa el nivel y cierra de vuelta)",group=_ir)
_ml=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (se quitan 5 velas después de ser barridos)",group=_ir)
_cy="FVG por temporalidad (solo se ven los activados)"
_ap=input.bool(true,"FVG H4",inline="fvgtf1",group=_cy)
_av=input.bool(true,"FVG H1",inline="fvgtf1",group=_cy)
_bd=input.bool(true,"FVG M15",inline="fvgtf1",group=_cy)
_bw=input.bool(true,"FVG M5",inline="fvgtf2",group=_cy)
_cq=input.bool(false,"FVG M1",inline="fvgtf2",group=_cy)
_nz=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_cy)
_m=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_cy)
_gd=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cy)
_lb=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cy)
_po=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cy)
_op="Estructura (CHoCH / BOS)"
_bz=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_op)
_sr=1.1
_uu=2.0
_uf=20
_se=2
_mk=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_op)
_hz=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_op)
_ix=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_op)
_jl=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_op)
_ej=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_op)
_qi=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_op)
_au=bar_index >=last_bar_index-_qi
_ck=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mo=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_al=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_tz="Order Blocks"
_kn=input.bool(true,"Mostrar Order Blocks",group=_tz)
_fj=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_tz)
_nf=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_tz)
_wf=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_tz)
_na=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_tz)
_ke=input.color(#1565C0,"OB alcista (demanda)",group=_tz)
_jz=input.color(#EF6C00,"OB bajista (oferta)",group=_tz)
_sb="Estrategia NY (Bias + PO3)"
_lh=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_sb)
_jx=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_sb)
_ti="Colores FVG"
_an=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_ti)
_am=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_ti)
_rz=_an
_mq=_an
_nd=_an
_kr=_an
_kk=_an
_hm=_an
_rg=_am
_mb=_am
_md=_am
_kf=_am
_kj=_am
_iq=_am
_jn=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_sb)
_de=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_sb)
_qo=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_sb)
_ql=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_sb)
_dp=input.color(#424242,"Color niveles clave",group=_sb)
_nc=input.color(#757575,"Color horas",group=_sb)
_ef=input.bool(true,"Mostrar EMAs",group="EMAs")
_nn=input.int(9,"EMA rápida",minval=1,group="EMAs")
_or=input.int(20,"EMA media",minval=1,group="EMAs")
_ok=input.int(200,"EMA lenta",minval=1,group="EMAs")
_nv=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_nl=input.color(#9E9D24,"Color EMA media",group="EMAs")
_on=input.color(color.black,"Color EMA lenta",group="EMAs")
_ia=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hu=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fo=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kd=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ua=14
_rs=50
_ss=0.15
_qn=2.5
_qm=30
_pw=1.0
_lj=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_od="Colores"
_ac=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_od)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_od)
_mm=input.bool(true,"Marcar la vela del OB",group=_od)
_hh=input.color(#FF00C8,"IFVG (magenta)",group=_od)
_my=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_od)
_kh=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_od)
type Zona
	int x1
	float _ag
	float _af
	int dir
	float _bf=na
	int _qs=na
	bool _lm=false
var _hb=array.new<Zona>()
var _hk=array.new<Zona>()
var obs=array.new<Zona>()
var _wt=array.new<Zona>()
var _va=array.new<Zona>()
var _qg=array.new<Zona>()
var _qb=array.new<Zona>()
var _kb=array.new<Zona>()
var _wm=array.new<Zona>()
var _sd=array.new<Zona>()
var _px=array.new<Zona>()
var _pk=array.new<Zona>()
var _ln=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _af
	color col
var _bi=array.new<Rango>()
_er(Zona z)=>
	_fw=z.dir==1?low <=z._af:high >=z._ag
	if not _fw
		_bf=na(z._bf)?(z.dir==1?z._ag:z._af):z._bf
		if z.dir==1?low < _bf:high > _bf
			z._bf:=z.dir==1?low:high
	_fw
type Marca
	label lb
	line ln
	int bar
var _hy=array.new<Marca>()
var array<string> _et=array.from("")
var array<int> _ey=array.from(0)
_ai(label lb,line ln,int bar)=>
	_hy.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_et.set(0,lb.get_text())
		_ey.set(0,bar)
	if _hy.size()> 500
		_hy.shift()
_qk=ta.ema(close,_nn)
_qv=ta.ema(close,_or)
_id=ta.ema(close,_ok)
_cw=ta.atr(_ua)
var string _tp='════════ Detection ════════'
var string _rh='════════ Structure Filters ════════'
var string _un='════════ Range Behavior ════════'
var string _tm='════════ Visual Settings ════════'
_cs='Base + 2x + 3x'
_oq='Rangos'
_bj=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_oq)
_br='Percentile band'
_ee=90.0
_ll='Bar close'
_km=200
_iu=40.0
_ea=500
_mw=0.18
_og='Wick reaches'
_ja=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_oq)
_ed=0.10
_ri=0.45
_em=0.70
_iz='Extend to containment'
_jf=300
_jv=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_oq)
_gu=true
_lp=0.25
_lk='Close beyond'
_hp=0.15
_gy=true
_gv=10
_lu=3
_fk=0
_mt='Custom'
_lt=#00A651
_lc=#E4002B
_fa=input.color(#F9A825,'Color del rango (neutral)',group=_oq)
_jt=4
_gc=93
_hd=true
_jo=true
_gx=input.bool(true,'Mostrar etiqueta del rango',group=_oq)
_jr=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_oq)
_ik=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_oq)
_je='Small'
_ew=true
_jw='Small'
[_cg,_ch]=switch _mt
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lt,_lc]
var color _cd=color.new(color.black,100)
var float _cf=3.0
var float _do=1.6
_ii(string _vg)=>
	switch _vg
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fb(color _dg)=>
	_hn=color.r(_dg)/255.0
	_iy=color.g(_dg)/255.0
	_hr=color.b(_dg)/255.0
	_sg=_hn <=0.03928?_hn/12.92:math.pow((_hn+0.055)/1.055,2.4)
	_sp=_iy <=0.03928?_iy/12.92:math.pow((_iy+0.055)/1.055,2.4)
	_sq=_hr <=0.03928?_hr/12.92:math.pow((_hr+0.055)/1.055,2.4)
	0.2126*_sg+0.7152*_sp+0.0722*_sq
_lq(color _ns,color _mg)=>
	_mz=_fb(_ns)
	_kp=_fb(_mg)
	(math.max(_mz,_kp)+0.05)/(math.min(_mz,_kp)+0.05)
_ec(color _he)=>
	_fb(_he)> 0.179?#000000:#ffffff
_ni(color _dg,color _nb,float _qp)=>
	color.rgb(color.r(_dg)+(color.r(_nb)-color.r(_dg))*_qp,color.g(_dg)+(color.g(_nb)-color.g(_dg))*_qp,color.b(_dg)+(color.b(_nb)-color.b(_dg))*_qp)
_bk(color _dg,color _he,float _nu)=>
	_nb=_ec(_he)
	_kv=_dg
	for step=1 to 10
		if _lq(_kv,_he)>=_nu
			break
		_kv:=_ni(_dg,_nb,step/10.0)
	_kv
_iw(float _xf)=>
	str.tostring(_xf,'#.##')+'%'
_qh(array<box> _js,int _kw,float _be,float _aj)=>
	array.clear(_js)
	if not _kh
		for i=0 to _jt-1
			array.push(_js,box.new(_kw,_be,bar_index,_aj,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gg(array<box> _js,float _be,float _aj,int _kw,int _qt,color _oa)=>
	_pd=array.size(_js)
	if _pd > 0 and _be > _aj
		_gl=(_be-_aj)/_pd
		for i=0 to _pd-1
			_ie=array.get(_js,i)
			_ny=math.abs((i+0.5)/_pd-0.5)*2.0
			_oc=int(math.min(99,math.max(0,_gc+(1.0-_ny)*10)))
			box.set_lefttop(_ie,_kw,_be-_gl*i)
			box.set_rightbottom(_ie,_qt,_be-_gl*(i+1))
			box.set_bgcolor(_ie,color.new(_oa,_oc))
_nh(array<box> _js)=>
	if array.size(_js)> 0
		for i=0 to array.size(_js)-1
			box.delete(array.get(_js,i))
	array.clear(_js)
_qe(int _rj,float _be,float _aj,float _cm)=>
	_xi=_rj
	if _iz=='Extend to containment'
		_wv=math.min(_jf,bar_index)
		_ur=math.max(2,math.round((1.0-_em)*_rj))
		_kz=0
		_gr=0
		while _gr < _wv and _kz <=_ur
			_mc=close[_gr]<=_be and close[_gr]>=_aj
			_tc=_mc and high[_gr]<=_be+_cm and low[_gr]>=_aj-_cm
			if _mc
				_kz:=math.max(0,_kz-1)
				if _tc and _gr+1 >=_rj
					_xi:=_gr+1
			else
				_kz+=1
			_gr+=1
	_xi
_cj=ta.atr(_km)
_ku=not na(_cj)and _cj > 0
_gb=_lk=='Wick beyond'
_kc=_og=='Wick reaches'
_np=_ll=='Live bar'
_fx=_np or barstate.isconfirmed
_gh=_ii(_je)
_ks=_ii(_jw)
_x=chart.bg_color
_r=_bk(_fa,_x,_cf)
_fy=_bk(_cg,_x,_cf)
_fv=_bk(_ch,_x,_cf)
_hc=_bk(_fa,_x,_do)
_fd=_bk(_cg,_x,_do)
_ff=_bk(_ch,_x,_do)
_gj(simple int len)=>
	_tv=ta.percentile_linear_interpolation(high,len,_ee)
	_qd=ta.percentile_linear_interpolation(low,len,100.0-_ee)
	_ub=ta.highest(high,len)
	_pz=ta.lowest(low,len)
	_sl=ta.highest(math.max(open,close),len)
	_nx=ta.lowest(math.min(open,close),len)
	top=_br=='Absolute extremes'?_ub:_br=='Body extremes'?_sl:_tv
	_kq=_br=='Absolute extremes'?_pz:_br=='Body extremes'?_nx:_qd
	_dq=top-_kq
	_ng=_ku and _dq > 0?_dq/(_cj*math.sqrt(len)):99.0
	_sx=bar_index < 1?_ea:int(math.max(1,math.min(_ea,bar_index-_km)))
	_xp=ta.percentrank(_ng,_sx)
	_xg=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_ww=_dq > 0?math.abs(_xg)*len/_dq:99.0
	_cp=math.avg(top,_kq)
	_cm=_ed*nz(_cj)
	_me=0
	_pt=0
	_jj=0
	_mu=0
	for i=0 to len-1
		if(close[i]> _cp)!=(close[i+1]> _cp)
			_me+=1
		_oh=_kc?high[i]>=top-_cm:close[i]>=top-_cm
		_ju=_kc?low[i]<=_kq+_cm:close[i]<=_kq+_cm
		if _oh
			_pt+=1
		if _ju
			_jj+=1
		if close[i]<=top and close[i]>=_kq
			_mu+=1
	_oe=_mu/float(len)
	_io=_ku and not na(_xp)and bar_index > len+5 and _xp <=_iu and _me >=math.max(3,math.round(_mw*len))and _pt >=_ja and _jj >=_ja and _ww <=_ri and _oe >=_em
	[_io,top,_kq]
bool _ih=false
bool _hl=false
bool _ip=false
float _wp=na
float _vo=na
float _vz=na
float _pj=na
float _pv=na
float _pe=na
if _au
	[qa,ta_,ba]=_gj(_bj)
	_ih:=qa
	_wp:=ta_
	_pj:=ba
	if _cs !='Base only'
		[qb,tb,bb]=_gj(_bj*2)
		_hl:=qb
		_vo:=tb
		_pv:=bb
	if _cs=='Base + 2x + 3x'
		[qc,tc,bc]=_gj(_bj*3)
		_ip:=qc
		_vz:=tc
		_pe:=bc
_ep=_cs !='Base only' and _hl
_es=_cs=='Base + 2x + 3x' and _ip
_io=_ih or _ep or _es
_no=_es?_bj*3:_ep?_bj*2:_bj
_pi=_es?_vz:_ep?_vo:_wp
_jh=_es?_pe:_ep?_pv:_pj
var array<box> _aq=array.new<box>()
var box _t=na
var line _g=na
var line _k=na
var line _v=na
var label _y=na
var label _as=na
var float _f=na
var float _a=na
var int _c=na
var int _gt=na
var bool _s=false
var bool _l=false
var bool _bc=false
var int _dw=na
var int _p=0
var float _o=na
var int _ax=na
var int _bb=0
_cc=false
_cn=false
_bl=false
_cb=false
if _fx and _bb > 0
	_bb-=1
if _fx and not _s and not _bc and _bb <=0 and _io
	_ob=_qe(_no,_pi,_jh,_ed*_cj)
	_c:=bar_index-_ob+1
	_gt:=bar_index
	_f:=_pi
	_a:=_jh
	_s:=true
	_l:=false
	_cp=math.avg(_f,_a)
	_bv=_a+(_f-_a)*0.25
	_az=_a+(_f-_a)*0.75
	_t:=box.new(_c,_f,bar_index,_a,border_color=color.new(_r,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qh(_aq,_c,_f,_a)
	if _hd
		_g:=line.new(_c,_cp,bar_index,_cp,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jo
		_k:=line.new(_c,_bv,bar_index,_bv,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_v:=line.new(_c,_az,bar_index,_az,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _gx
		_y:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cd,style=label.style_label_down,textcolor=color.new(_r,10),size=_gh)
	_cc:=true
if _s and _fx
	_cr=_hp*_cj
	_fr=_lp*_cj
	if _gu and not _gb and close <=_f and close >=_a
		if high > _f and high <=_f+_fr
			_f:=high
		if low < _a and low >=_a-_fr
			_a:=low
	_pr=_gb?high > _f+_cr:close > _f+_cr
	_ki=_gb?low < _a-_cr:close < _a-_cr
	_qf=_fk > 0 and bar_index-_gt+1 >=_fk
	if _pr or _ki or _qf
		_b=_pr?1:_ki?-1:0
		_ry=_b !=0?bar_index-_c:bar_index-_c+1
		_mv=_a !=0?(_f-_a)/_a*100.0:0.0
		_jm=_gy and _b !=0 and _l
		if _l
			_fc=_b==1?_fy:_b==-1?_fv:_r
			_ot=_b==1?_fd:_b==-1?_ff:_hc
			_im=_b==1?_cg:_b==-1?_ch:_fa
			box.set_lefttop(_t,_c,_f)
			box.set_rightbottom(_t,bar_index,_a)
			box.set_border_color(_t,color.new(_fc,30))
			box.set_border_style(_t,line.style_dotted)
			_gg(_aq,_f,_a,_c,bar_index,na)
			_bi.push(Rango.new(_c,bar_index,_f,_a,_ot))
			if _bi.size()> 8
				_bi.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_v,bar_index)
			if not na(_y)
				label.set_xy(_y,int(math.avg(_c,bar_index)),_f)
				label.set_text(_y,'RANGE   '+str.tostring(_ry)+' BARS   '+_iw(_mv))
				label.set_textcolor(_y,color.new(_fc,10))
			if _jr and _b !=0
				_om=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _ew
					_as:=label.new(bar_index,_b==1?low:high,_b==1?'▲':'▼',xloc=xloc.bar_index,yloc=yloc.price,color=_cd,style=_b==1?label.style_label_up:label.style_label_down,textcolor=color.new(_fc,20),size=_ks,tooltip='Breakout del rango')
				else
