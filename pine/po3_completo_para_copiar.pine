				o.lb.delete()
			_gp.set(k,na)
		for q in _n
			q.ln.delete()
			q.lb.delete()
		_n.clear()
	_de(0,_bl,_bl and not _bl[1],_gd,1,"Asia",#5E35B1)
	_de(1,_bl,_bl and not _bl[1],_gx,-1,"Asia",#5E35B1)
	_de(2,_dg,_dg and not _dg[1],_lz,1,"Londres",#1E88E5)
	_de(3,_dg,_dg and not _dg[1],_nl,-1,"Londres",#1E88E5)
