_mh=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_da)
_pk=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_da)
_on="Estructura (CHoCH / BOS)"
_ca=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_on)
_tc=1.1
_vr=2.0
_uu=20
_sz=2
_ms=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_on)
_ip=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_on)
_hr=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_on)
_hy=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_on)
_em=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_on)
_qp=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_on)
_ay=bar_index >=last_bar_index-_qp
_cj=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_mm=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_aj=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
