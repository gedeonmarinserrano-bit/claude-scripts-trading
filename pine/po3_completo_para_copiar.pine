type NivelSes
	line ln
	label lb
	float _ap
	int _we=na
	int k=0
var array<NivelSes> _of=array.new<NivelSes>(6)
var array<NivelSes> _ae=array.new<NivelSes>()
_dg(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_rx=(dir==1?"Máximo ":"Mínimo ")+ses
	o=_of.get(k)
	if ini
		if not na(o)
			o.ln.delete()
			o.lb.delete()
		if _ae.size()> 0
			for i=_ae.size()-1 to 0
				q=_ae.get(i)
				if q.k==k
					q.ln.delete()
					q.lb.delete()
					_ae.remove(i)
		o:=NivelSes.new(line.new(bar_index,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,_rx,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny),v,na,k)
		_of.set(k,o)
	else if not na(o)
		if en
			o._ap:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
		else if not na(o._we)and bar_index-o._we <=5
			nv=dir==1?math.max(o._ap,high):math.min(o._ap,low)
			o._ap:=nv
			o.ln.set_y1(nv)
			o.ln.set_y2(nv)
		else if dir==1?high > o._ap:low < o._ap
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._ap)
			o.lb.set_text((dir==1?"Máximo manipulado ":"Mínimo manipulado ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			_ae.push(o)
			if _ae.size()> 24
				q=_ae.shift()
				q.ln.delete()
				q.lb.delete()
			nv=dir==1?high:low
			o:=NivelSes.new(line.new(bar_index,nv,bar_index,nv,color=color.new(col,15),width=1),label.new(bar_index,nv,_rx,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny),nv,bar_index,k)
			_of.set(k,o)
		o.ln.set_x2(bar_index)
		o.lb.set_xy(bar_index,o._ap)
if _nc and _ig and _bc
	if((_as and not _as[1])or(_ck and not _ck[1])or(_el and not _el[1]))and _ae.size()> 0
		for q in _ae
			q.ln.delete()
			q.lb.delete()
		_ae.clear()
	_dg(0,_as,_as and not _as[1],_fl,1,"Asia",#5E35B1)
	_dg(1,_as,_as and not _as[1],_gw,-1,"Asia",#5E35B1)
	_dg(2,_ck,_ck and not _ck[1],_lv,1,"Londres",#1E88E5)
	_dg(3,_ck,_ck and not _ck[1],_mk,-1,"Londres",#1E88E5)
	_dg(4,_el,_el and not _el[1],_xi,1,"NY",#EF6C00)
	_dg(5,_el,_el and not _el[1],_xh,-1,"NY",#EF6C00)
var array<bool> _ac=array.new<bool>(6,false)
var array<label> _ej=array.new<label>()
if timeframe.change("D")
	_ac.fill(false)
if _as and not _as[1]
	_ac.set(2,false)
	_ac.set(3,false)
if _ck and not _ck[1]
	_ac.set(4,false)
	_ac.set(5,false)
if _ld and _bb and _ig and _bc
	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_fl:k==3?_gw:k==4?_lv:_mk
		_ye=k < 2 or(k < 4?not _as:not _ck)
		_vk=k%2==0
		if _ye and not na(nv)and not _ac.get(k)and(_vk?high > nv and close < nv:low < nv and close > nv)
			_ac.set(k,true)
			nom=(k < 2?(_vk?"PDH":"PDL"):k < 4?(_vk?"Alto Asia":"Bajo Asia"):(_vk?"Alto Londres":"Bajo Londres"))
			_ej.push(label.new(bar_index,_vk?high:low,"Barrido "+nom,style=_vk?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _ej.size()> 20
				_ej.shift().delete()
type Igual
	line ln
