					[ln,lb]=_ep(o._xi,o._aa,_rw,col)
					o.ln:=ln
					o.lb:=lb
					o.lb.set_xy(bar_index,o._aa)
		else if dir==1?high > o._aa:low < o._aa
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._aa)
			o.lb.set_text((dir==1?"Máx. manip. ":"Mín. manip. ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			if _h.size()> 0
				for i=_h.size()-1 to 0
					q=_h.get(i)
					if q.k==k
						_h.remove(i)
						q.ln.delete()
						q.lb.delete()
			_h.push(o)
			if _h.size()> 24
				q=_h.shift()
				q.ln.delete()
				q.lb.delete()
			_ei.set(k,NivelSes.new(na,na,dir==1?high:low,bar_index,k,bar_index))
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._aa)
