		_gj.shift().delete()
	if _gk.size()> _sg
		_gk.shift().delete()
var int _cl=na
var int _dx=0
_ix=false
_io=false
if barstate.isconfirmed
	if not na(_nj)
		_rv=not na(_hk)and _rd-_hk <=_ql
