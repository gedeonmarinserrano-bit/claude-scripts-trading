		_vl=(na(_wc)?"↑ —":"↑ "+_xd+" "+str.tostring(_wc,format.mintick)+" (+"+str.tostring(_wc-close,format.mintick)+")")+"  ·  "+(na(_wb)?"↓ —":"↓ "+_wn+" "+str.tostring(_wb,format.mintick)+" (−"+str.tostring(close-_wb,format.mintick)+")")
		_qk(_ee,f,"Liquidez",_vl,#424242,tam)
