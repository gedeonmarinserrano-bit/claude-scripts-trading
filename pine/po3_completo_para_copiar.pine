		_im:=_pn
	if not na(_nf)
		_sl=not na(_hl)and _qr-_hl <=_pk
		d1=_sl and _oo and _dm(_nf,_fz,_qj,_iq,false)
		d2=_sl and _ow and _dm(_nf,_fz,_pv,_ik,false)
		if d1 or d2
			_il:=true
			_cj:=bar_index
			_du:=1
			_hz=_nf < _fz
			xv=_hz?_qr:bar_index+int(d1?_so:_rp)
			t1=_fj(_rv,_qj,_iq)
			t2=_fj(_rm,_pv,_ik)
			_kz(_hl,_fz,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_jc,false)
		_hl:=_qr
