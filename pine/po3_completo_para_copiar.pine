	if _eq(_ak+60)
		_dn(_ev(_ak+60),true)
_ma()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_uj(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_by(array<Zona> arr,float _ah,float _ag,int dir,int _vg,int _vj)=>
	if _ah-_ag >=_gg(_vj)
		z=Zona.new(_uj(_vg),_ah,_ag,dir)
		if not _et(z)
			arr.push(z)
			if arr.size()> _gm
				arr.shift()
_bo(array<Zona> arr,array<Zona> _dq)=>
	_vr=false
	if _dq.size()> 0
		for i=_dq.size()-1 to 0
			if _et(_dq.get(i))
				_dq.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_st=(z._ah+z._ag)/2
			if low <=_st and high >=_st
				_vr:=true
			_id=na(z._bi)and(z.dir==1?(open >=z._ah and close < z._ag):(open <=z._ag and close > z._ah))
			if _id
				arr.remove(i)
				_dq.push(Zona.new(z.x1,z._ah,z._ag,-z.dir,na,bar_index))
				if _dq.size()> _gm
					_dq.shift()
			else if _et(z)
				arr.remove(i)
	_vr
