_jw=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_px)
_rb=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_px)
_la=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_px)
_kh=input.color(#8D6E63,"Color niveles H1",group=_px)
_rh=input.bool(false,"Niveles clave: alto/bajo del día anterior",group=_px)
_dw=input.color(#424242,"Color niveles clave",group=_px)
_nk=input.color(#757575,"Color horas",group=_px)
_eo=input.bool(true,"Mostrar EMAs",group="EMAs")
_om=input.int(9,"EMA rápida",minval=1,group="EMAs")
_pg=input.int(20,"EMA media",minval=1,group="EMAs")
_oj=input.int(200,"EMA lenta",minval=1,group="EMAs")
_nu=input.color(#4CAF50,"Color EMA rápida",group="EMAs")
_pd=input.color(#2962FF,"Color EMA media",group="EMAs")
_ok=input.color(#363A45,"Color EMA lenta",group="EMAs")
_jl=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_hz=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_gc=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_ki=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_vv=14
_rq=50
_ts=0.15
_qu=2.5
_qt=30
_qa=1.0
_lj=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oo="Colores"
_ac=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oo)
_t=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oo)
_nn=input.bool(true,"Marcar la vela del OB",group=_oo)
_ho=input.color(#FF00C8,"IFVG (magenta)",group=_oo)
_np=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oo)
_ld=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oo)
type Zona
	int x1
	float _ag
	float _ah
	int dir
	float _bh=na
	int _ro=na
	bool _lo=false
var _hd=array.new<Zona>()
var _if=array.new<Zona>()
var obs=array.new<Zona>()
var _yj=array.new<Zona>()
var _wg=array.new<Zona>()
var _rd=array.new<Zona>()
var _qs=array.new<Zona>()
var _kk=array.new<Zona>()
var _xp=array.new<Zona>()
var _tc=array.new<Zona>()
var _pl=array.new<Zona>()
var _qk=array.new<Zona>()
var _lg=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ag
	float _ah
	color col
var _bm=array.new<Rango>()
_es(Zona z)=>
	_fl=z.dir==1?low <=z._ah:high >=z._ag
	if not _fl
		_bh=na(z._bh)?(z.dir==1?z._ag:z._ah):z._bh
		if z.dir==1?low < _bh:high > _bh
			z._bh:=z.dir==1?low:high
	_fl
type Marca
	label lb
	line ln
	int bar
var _id=array.new<Marca>()
var array<string> _fd=array.from("")
var array<int> _fc=array.from(0)
_aj(label lb,line ln,int bar)=>
	_id.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fd.set(0,lb.get_text())
		_fc.set(0,bar)
	if _id.size()> 500
		_id.shift()
_qz=ta.ema(close,_om)
_sn=ta.ema(close,_pg)
_jq=ta.ema(close,_oj)
_db=ta.atr(_vv)
var string _uk='════════ Detection ════════'
var string _sb='════════ Structure Filters ════════'
var string _vk='════════ Range Behavior ════════'
var string _uh='════════ Visual Settings ════════'
_cs='Base + 2x + 3x'
_pe='Rangos'
_bj=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_pe)
_br='Percentile band'
_er=90.0
_ln='Bar close'
_kx=200
_ij=40.0
_en=500
_nl=0.18
_oh='Wick reaches'
_ig=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_pe)
_el=0.10
_sv=0.45
_em=0.70
_iv='Extend to containment'
_it=300
_kc=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_pe)
_he=true
_lw=0.25
_mc='Close beyond'
_hs=0.15
_hc=true
_hi=10
_ly=3
_fn=0
_ne='Custom'
_lk=#00A651
_lf=#E4002B
_fh=input.color(#F9A825,'Color del rango (neutral)',group=_pe)
_ke=4
_gr=93
_hj=true
_jz=true
_hl=input.bool(true,'Mostrar etiqueta del rango',group=_pe)
_ju=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_pe)
_il=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_pe)
_is='Small'
_ey=true
_jy='Small'
[_cg,_cf]=switch _ne
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lk,_lf]
var color _cb=color.new(color.black,100)
var float _ch=3.0
var float _dq=1.6
_js(string _xe)=>
	switch _xe
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fg(color _di)=>
	_jj=color.r(_di)/255.0
	_jm=color.g(_di)/255.0
	_ht=color.b(_di)/255.0
	_tr=_jj <=0.03928?_jj/12.92:math.pow((_jj+0.055)/1.055,2.4)
	_tx=_jm <=0.03928?_jm/12.92:math.pow((_jm+0.055)/1.055,2.4)
	_tk=_ht <=0.03928?_ht/12.92:math.pow((_ht+0.055)/1.055,2.4)
	0.2126*_tr+0.7152*_tx+0.0722*_tk
_lz(color _ny,color _nh)=>
	_mt=_fg(_ny)
	_km=_fg(_nh)
	(math.max(_mt,_km)+0.05)/(math.min(_mt,_km)+0.05)
_ej(color _hp)=>
	_fg(_hp)> 0.179?#000000:#ffffff
_nz(color _di,color _nd,float _rt)=>
	color.rgb(color.r(_di)+(color.r(_nd)-color.r(_di))*_rt,color.g(_di)+(color.g(_nd)-color.g(_di))*_rt,color.b(_di)+(color.b(_nd)-color.b(_di))*_rt)
_bi(color _di,color _hp,float _pb)=>
	_nd=_ej(_hp)
	_lq=_di
	for step=1 to 10
		if _lz(_lq,_hp)>=_pb
			break
		_lq:=_nz(_di,_nd,step/10.0)
	_lq
_jc(float _ya)=>
	str.tostring(_ya,'#.##')+'%'
_qy(array<box> _kb,int _lp,float _aw,float _ai)=>
	array.clear(_kb)
	if not _ld
		for i=0 to _ke-1
			array.push(_kb,box.new(_lp,_aw,bar_index,_ai,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_gl(array<box> _kb,float _aw,float _ai,int _lp,int _rv,color _op)=>
	_pn=array.size(_kb)
	if _pn > 0 and _aw > _ai
		_gy=(_aw-_ai)/_pn
		for i=0 to _pn-1
			_hu=array.get(_kb,i)
			_pk=math.abs((i+0.5)/_pn-0.5)*2.0
			_pi=int(math.min(99,math.max(0,_gr+(1.0-_pk)*10)))
			box.set_lefttop(_hu,_lp,_aw-_gy*i)
			box.set_rightbottom(_hu,_rv,_aw-_gy*(i+1))
			box.set_bgcolor(_hu,color.new(_op,_pi))
_ow(array<box> _kb)=>
	if array.size(_kb)> 0
		for i=0 to array.size(_kb)-1
			box.delete(array.get(_kb,i))
	array.clear(_kb)
_qr(int _ry,float _aw,float _ai,float _co)=>
	_yp=_ry
	if _iv=='Extend to containment'
		_xv=math.min(_it,bar_index)
		_vf=math.max(2,math.round((1.0-_em)*_ry))
		_mg=0
		_gz=0
		while _gz < _xv and _mg <=_vf
			_nc=close[_gz]<=_aw and close[_gz]>=_ai
			_tb=_nc and high[_gz]<=_aw+_co and low[_gz]>=_ai-_co
			if _nc
				_mg:=math.max(0,_mg-1)
				if _tb and _gz+1 >=_ry
					_yp:=_gz+1
			else
				_mg+=1
			_gz+=1
	_yp
_ci=ta.atr(_kx)
_kn=not na(_ci)and _ci > 0
_gj=_mc=='Wick beyond'
_kt=_oh=='Wick reaches'
_ou=_ln=='Live bar'
_fu=_ou or barstate.isconfirmed
_gk=_js(_is)
_kz=_js(_jy)
_x=chart.bg_color
_s=_bi(_fh,_x,_ch)
_fr=_bi(_cg,_x,_ch)
_fm=_bi(_cf,_x,_ch)
_hg=_bi(_fh,_x,_dq)
_fp=_bi(_cg,_x,_dq)
_fw=_bi(_cf,_x,_dq)
_gq(simple int len)=>
	_wa=ta.percentile_linear_interpolation(high,len,_er)
	_re=ta.percentile_linear_interpolation(low,len,100.0-_er)
	_vm=ta.highest(high,len)
	_rg=ta.lowest(low,len)
	_tv=ta.highest(math.max(open,close),len)
	_pc=ta.lowest(math.min(open,close),len)
	top=_br=='Absolute extremes'?_vm:_br=='Body extremes'?_tv:_wa
	_kw=_br=='Absolute extremes'?_rg:_br=='Body extremes'?_pc:_re
	_do=top-_kw
	_on=_kn and _do > 0?_do/(_ci*math.sqrt(len)):99.0
	_to=bar_index < 1?_en:int(math.max(1,math.min(_en,bar_index-_kx)))
	_yu=ta.percentrank(_on,_to)
	_xx=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_yb=_do > 0?math.abs(_xx)*len/_do:99.0
	_cr=math.avg(top,_kw)
	_co=_el*nz(_ci)
	_ml=0
	_ql=0
	_hw=0
	_nq=0
	for i=0 to len-1
		if(close[i]> _cr)!=(close[i+1]> _cr)
			_ml+=1
		_ob=_kt?high[i]>=top-_co:close[i]>=top-_co
		_jv=_kt?low[i]<=_kw+_co:close[i]<=_kw+_co
		if _ob
			_ql+=1
		if _jv
			_hw+=1
		if close[i]<=top and close[i]>=_kw
			_nq+=1
	_od=_nq/float(len)
	_ih=_kn and not na(_yu)and bar_index > len+5 and _yu <=_ij and _ml >=math.max(3,math.round(_nl*len))and _ql >=_ig and _hw >=_ig and _yb <=_sv and _od >=_em
	[_ih,top,_kw]
bool _jr=false
bool _iw=false
bool _jo=false
float _xa=na
float _xc=na
float _xi=na
float _qe=na
float _pu=na
float _qh=na
if _bg
	[qa,ta_,ba]=_gq(_bj)
	_jr:=qa
	_xa:=ta_
	_qe:=ba
	if _cs !='Base only'
		[qb,tb,bb]=_gq(_bj*2)
		_iw:=qb
		_xc:=tb
		_pu:=bb
	if _cs=='Base + 2x + 3x'
		[qc,tc,bc]=_gq(_bj*3)
		_jo:=qc
		_xi:=tc
		_qh:=bc
_et=_cs !='Base only' and _iw
_ex=_cs=='Base + 2x + 3x' and _jo
_ih=_jr or _et or _ex
_oi=_ex?_bj*3:_et?_bj*2:_bj
_qi=_ex?_xi:_et?_xc:_xa
_jh=_ex?_qh:_et?_pu:_qe
var array<box> _ar=array.new<box>()
var box _u=na
var line _g=na
var line _k=na
var line _w=na
var label _z=na
var label _at=na
var float _f=na
var float _a=na
var int _c=na
var int _hb=na
var bool _v=false
var bool _m=false
var bool _be=false
var int _dt=na
var int _p=0
var float _q=na
var int _bc=na
var int _av=0
_cc=false
_cn=false
_bk=false
_by=false
if _fu and _av > 0
	_av-=1
if _fu and not _v and not _be and _av <=0 and _ih
	_oy=_qr(_oi,_qi,_jh,_el*_ci)
	_c:=bar_index-_oy+1
	_hb:=bar_index
	_f:=_qi
	_a:=_jh
	_v:=true
	_m:=false
	_cr=math.avg(_f,_a)
	_bx=_a+(_f-_a)*0.25
	_ay=_a+(_f-_a)*0.75
	_u:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qy(_ar,_c,_f,_a)
	if _hj
		_g:=line.new(_c,_cr,bar_index,_cr,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _jz
		_k:=line.new(_c,_bx,bar_index,_bx,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_ay,bar_index,_ay,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hl
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cb,style=label.style_label_down,textcolor=color.new(_s,10),size=_gk)
	_cc:=true
if _v and _fu
	_cq=_hs*_ci
	_fy=_lw*_ci
	if _he and not _gj and close <=_f and close >=_a
		if high > _f and high <=_f+_fy
			_f:=high
		if low < _a and low >=_a-_fy
			_a:=low
	_po=_gj?high > _f+_cq:close > _f+_cq
	_kg=_gj?low < _a-_cq:close < _a-_cq
	_qw=_fn > 0 and bar_index-_hb+1 >=_fn
	if _po or _kg or _qw
		_b=_po?1:_kg?-1:0
		_sl=_b !=0?bar_index-_c:bar_index-_c+1
		_mv=_a !=0?(_f-_a)/_a*100.0:0.0
		_jt=_hc and _b !=0 and _m
		if _m
			_fi=_b==1?_fr:_b==-1?_fm:_s
			_oe=_b==1?_fp:_b==-1?_fw:_hg
			_hx=_b==1?_cg:_b==-1?_cf:_fh
			box.set_lefttop(_u,_c,_f)
			box.set_rightbottom(_u,bar_index,_a)
			box.set_border_color(_u,color.new(_fi,30))
			box.set_border_style(_u,line.style_dotted)
			_gl(_ar,_f,_a,_c,bar_index,na)
			_bm.push(Rango.new(_c,bar_index,_f,_a,_oe))
			if _bm.size()> 8
				_bm.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sl)+' BARS   '+_jc(_mv))
