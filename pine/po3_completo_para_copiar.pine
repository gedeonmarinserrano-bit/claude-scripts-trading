	if txt !="" and _gc.size()< 60
		_gc.push(Letrero.new(x2,(_yl+_ym)/2,txt,_wa,true,_rz))
	if not na(_pv)
		m=(_ai+_ah)/2
		for q in _pn(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_ox(q.x1,q.x2,m,_pv)
	_gn.push(Pieza.new(x1,x2,_ai,_ah,dir))
_be(array<Zona> arr,color _xy,color _xj,int _uf,string txt,bool _yj,bool _tg,color _ot,bool _rz)=>
	if arr.size()> 0
