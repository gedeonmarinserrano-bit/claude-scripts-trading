			_el.push(label.new(bar_index,_vv?high:low,"Barrido "+nom,style=_vv?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _el.size()> 20
				_el.shift().delete()
type Igual
	line ln
