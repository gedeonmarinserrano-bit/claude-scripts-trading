_jn(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_dl(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_uu=(dir==1?"Máx. ":"Mín. ")+ses
	o=_gm.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _i.size()> 0
			for i=_i.size()-1 to 0
				q=_i.get(i)
				if q.k==k
					_i.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_jn(bar_index,v,_uu,col)
		_gm.set(k,NivelSes.new(ln,lb,v,na,k,bar_index))
	else if not na(o)
		if en and not na(o.ln)
			o._ax:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if dir==1?high > o._ax:low < o._ax
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._ax)
			o.lb.set_text((dir==1?"Máx. manip. ":"Mín. manip. ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			if _i.size()> 0
				for i=_i.size()-1 to 0
					q=_i.get(i)
					if q.k==k
						_i.remove(i)
						q.ln.delete()
						q.lb.delete()
			_i.push(o)
			if _i.size()> 24
				q=_i.shift()
				q.ln.delete()
				q.lb.delete()
			_gm.set(k,na)
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._ax)
_lf=timeframe.change("D")
if _nk and _jd and _bh
