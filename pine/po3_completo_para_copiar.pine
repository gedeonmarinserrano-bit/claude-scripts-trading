[ph4,pl4,tp4]=request.security(syminfo.tickerid,"240",_sh(_qo),lookahead=barmerge.lookahead_on)
[ph1,pl1,tp1]=request.security(syminfo.tickerid,"60",_sh(_qr),lookahead=barmerge.lookahead_on)
_ds(array<Nivel> arr,float _ax,int dir,int _uu,string tf,int _xq,color col)=>
