_hd="SMT (divergencias entre índices)"
_du=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hd)
_lg=input.bool(true,"Mostrar etiquetas de la SMT",group=_hd)
_rm=input.bool(true,"Mostrar línea de la SMT",group=_hd)
_tj=input.bool(true,"Comparar con",inline="smt1",group=_hd)
