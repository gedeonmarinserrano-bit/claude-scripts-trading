_pz=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_db)
_ke="Estructura (CHoCH / BOS)"
_ca=input.int(1,"Estructura interna: sensibilidad (velas a cada lado)",minval=1,group=_ke)
_ix=input.bool(true,"Mostrar estructura interna (pequeña y discreta)",group=_ke)
