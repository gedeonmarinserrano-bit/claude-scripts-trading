_df(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_ro=(dir==1?"Máximo ":"Mínimo ")+ses
	o=_lm.get(k)
	if ini
		if not na(o)
			o.ln.delete()
			o.lb.delete()
		if _ad.size()> 0
			for i=_ad.size()-1 to 0
				q=_ad.get(i)
				if q.k==k
					_ad.remove(i)
					q.ln.delete()
					q.lb.delete()
		o:=NivelSes.new(line.new(bar_index,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,_ro,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny),v,na,k)
		_lm.set(k,o)
	else if not na(o)
