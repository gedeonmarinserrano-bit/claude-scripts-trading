_ha="SMT (divergencias entre índices)"
_do=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_ha)
_ld=input.bool(true,"Mostrar etiquetas de la SMT",group=_ha)
_rd=input.bool(true,"Mostrar línea de la SMT",group=_ha)
_sw=input.bool(true,"Comparar con",inline="smt1",group=_ha)
_qi=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_ha)
_sx=input.bool(true,"Comparar con",inline="smt2",group=_ha)
_px=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_ha)
