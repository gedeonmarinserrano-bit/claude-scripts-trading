			xv=_ii?_qn:bar_index+int(d1?_rn:_rh)
			t1=_fx(_rj,_qd,_iq)
			t2=_fx(_sh,_pj,_je)
			_kz(_hm,_fj,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_hw,true)
		_hm:=_qn
		_fj:=_nb
		_iq:=_qd
		_je:=_pj
	if not na(_nq)
		_sl=not na(_hp)and _qn-_hp <=_po
		d1=_sl and _os and _dv(_nq,_fw,_qb,_ip,false)
		d2=_sl and _pb and _dv(_nq,_fw,_pi,_jf,false)
		if d1 or d2
			_hz:=true
			_cp:=bar_index
			_dq:=1
			_ii=_nq < _fw
			xv=_ii?_qn:bar_index+int(d1?_sd:_sj)
			t1=_fx(_rj,_qb,_ip)
			t2=_fx(_sh,_pi,_jf)
			_kz(_hp,_fw,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_ir,false)
		_hp:=_qn
		_fw:=_nq
		_ip:=_qb
		_jf:=_pi
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _eo=array.new<box>()
var array<line> _dg=array.new<line>()
var array<label> _bu=array.new<label>()
var array<int> uso=array.from(0,0,0)
_qt(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eo.size()
		b=_eo.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eo.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_or(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _dg.size()
		l=_dg.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_dg.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_lf(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bu.size()
		e=_bu.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bu.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _xx
	bool _ro
var array<Letrero> _fu=array.new<Letrero>()
_ie=nz(ta.atr(50))*0.5
_vn=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_ox)
_er=nz(ta.atr(50))*_vn/100
var array<Pieza> _gm=array.new<Pieza>()
_wm(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_pq(Pieza p)=>
	res=array.from(p)
	if _ku and _gm.size()> 0
		for o in _gm
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_wy=array.new<Pieza>()
				for q in res
					for r in _wm(q,o)
						_wy.push(r)
				res:=_wy
				if res.size()==0 or res.size()> 10
					break
	res
_gw(Pieza p,color col,int dir)=>
	for q in _pq(p)
		top=q.top
		bot=q.bot
		if _er > 0 and dir !=0
			for o in _gm
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_er
						top:=math.min(top,o.bot-_er)
					if math.abs(bot-o.top)<=_er
						bot:=math.max(bot,o.top+_er)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_qt(q.x1,top,q.x2,bot,col)
_ml(int _vk,int x2,float _ah,float _ai,int dir,float _bi,color col,string txt,color _vw,color _pg,color _op,bool _ro)=>
	x1=math.max(_vk,bar_index-1000)
	_yf=na(_bi)?_ah:(dir==1?_bi:_ah)
	_yh=na(_bi)?_ai:(dir==1?_ai:_bi)
	_gw(Pieza.new(x1,x2,_yf,_yh),col,dir)
	if not na(_bi)
		_gw(Pieza.new(x1,x2,dir==1?_ah:_bi,dir==1?_bi:_ai),_op,dir)
	if txt !="" and _fu.size()< 60
		_fu.push(Letrero.new(x2,(_yf+_yh)/2,txt,_vw,true,_ro))
	if not na(_pg)
		m=(_ah+_ai)/2
		for q in _pq(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_or(q.x1,q.x2,m,_pg)
	_gm.push(Pieza.new(x1,x2,_ah,_ai,dir))
_ax(array<Zona> arr,color _xl,color _xj,int _tv,string txt,bool _yg,bool _tf,color _op,bool _ro)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_xl:_xj
			t=txt
			_yr=z._ai > close?z._ai-close:close > z._ah?close-z._ah:0.0
			if uso.get(0)< 440 and _gm.size()< _mh and(_qc==0 or _yr/close*100 <=_qc)
				_ml(z.x1,bar_index+1,z._ah,z._ai,z.dir,z._bi,color.new(c,_mn),t,c,_tf?color.new(color.white,30):na,_op,_ro)
_av()=>
	if _pf
		_ax(_iv,_ho,_ho,88,"IFVG "+_dm,true,false,_al,false)
		_ax(_hi,_sx,_ts,80,"FVG "+_dm,true,false,_al,true)
	_ax(obs,_km,_kr,90,"OB "+_dm,true,false,_al,false)
_dh(bool ver,int _vr,array<Zona> f,array<Zona> fi,color ca,color cb,int _tv,string nom)=>
	if ver and not _l and _d !=_vr*60
		_ax(fi,_ho,_ho,88,"IFVG "+nom,true,false,_al,false)
		_ax(f,ca,cb,_tv,"FVG "+nom,true,_vr >=15,_al,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fu.clear()
	_gm.clear()
	_ag=false
	if _d <=60
		_av()
		_ag:=true
	_dh(_cv,1,_xo,_wl,_mt,_mr,84,"M1")
	if not _ag and _d <=300
		_av()
		_ag:=true
	_dh(_bw,5,_vt,_sy,_mk,_ne,84,"M5")
	if not _ag and _d <=900
		_av()
		_ag:=true
	_dh(_bf,15,_qx,_pn,_la,_kh,84,"M15")
	if not _ag and _d <=3600
		_av()
		_ag:=true
	_dh(_bh,60,_qr,_qi,_kj,_kp,82,"H1")
	if not _ag and _d <=14400
		_av()
		_ag:=true
	_dh(_aq,240,_ko,_lw,_jo,_jj,80,"H4")
	if not _ag
		_av()
	if _fu.size()> 0
		_ms=array.new<Letrero>()
		for l in _fu
			x=l.x
			_ss=str.length(l.txt)+2
			for _vb=0 to 3
				_rv=false
				for c in _ms
					_si=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _ie and x > c.x-_si and x-_ss < c.x
						x:=c.x-_si
						_rv:=true
				if not _rv
					break
			_ms.push(Letrero.new(x,l.y,l.txt,l.col,true,l._ro))
			_lf(x,l.y,l.txt,color.white)
	while _eo.size()> uso.get(0)
		_eo.pop().delete()
	while _dg.size()> uso.get(1)
		_dg.pop().delete()
	while _bu.size()> uso.get(2)
		_bu.pop().delete()
_pt()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bm(array<Zona> arr,string nom,bool _wb)=>
	float _tq=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bi)?z._ai:z._bi
		hi=z.dir==-1 or na(z._bi)?z._ah:z._bi
		d=close >=lo and close <=hi?0.0:_wb?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_tq)or d < _tq)
			_tq:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_tq,txt]
_py(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_lt(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_ls(int b)=>
	b==1?_ab:b==-1?_t:#757575
_xa(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_wq(string n)=>
	str.contains(n,"alcista")?_ab:str.contains(n,"bajista")?_t:#757575
_rp(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _eq=na
if barstate.islast and _lk
	pos=_jr=="Arriba izquierda"?position.top_left:_jr=="Abajo derecha"?position.bottom_right:_jr=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_ni=="Muy pequeño"?size.tiny:_ni=="Normal"?size.normal:size.small
	if na(_eq)
		_eq:=table.new(pos,2,14,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_eq.clear(0,0,1,13)
	int f=0
	int _wa=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_wa:=request.security(syminfo.tickerid,"240",_pt(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_pt(),lookahead=barmerge.lookahead_on)
	_py(_eq,f,"Bias H4",_d < 14400?_lt(_wa):"(gráfico ≥ H4)",_ls(_wa),tam)
	f+=1
	_py(_eq,f,"Bias H1",_d < 3600?_lt(b60):"(gráfico ≥ H1)",_ls(b60),tam)
	f+=1
	ev=_fe.get(0)
	_xb=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ez.get(0))+" velas"
	_py(_eq,f,"Estructura "+_dm,_lt(_i)+_xb,_ls(_i),tam)
	f+=1
	tz="America/New_York"
	_vx=hour(timenow,tz)*60+minute(timenow,tz)
	_ye=dayofweek(timenow,tz)
	_xy=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_yp=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_wi=_ye==dayofweek.saturday or _ye==dayofweek.sunday
	_ux=570-_vx
	ses=_wi?"Cerrada (fin de semana)":_vx < 570?"Abre a las "+str.format_time(_xy,"HH:mm","Europe/Madrid")+" (en "+(_ux >=60?str.tostring(int(_ux/60))+" h ":"")+str.tostring(_ux%60)+" min)":_vx < 960?"● Abierta (cierra "+str.format_time(_yp,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_xy,"HH:mm","Europe/Madrid")+")"
	_py(_eq,f,"Sesión NY",ses,not _wi and _vx >=570 and _vx < 960?_ab:#424242,tam)
	f+=1
	float _sp=na
	string _wj=""
	float _sq=na
	string _wr=""
	if _pf
		[d1,t1]=_bm(_hi,"FVG "+_dm,true)
		[d2,t2]=_bm(_iv,"IFVG "+_dm,true)
		[d3,t3]=_bm(_hi,"FVG "+_dm,false)
		[d4,t4]=_bm(_iv,"IFVG "+_dm,false)
		if not na(d1)and(na(_sp)or d1 < _sp)
			_sp:=d1
			_wj:=t1
		if not na(d2)and(na(_sp)or d2 < _sp)
			_sp:=d2
			_wj:=t2
		if not na(d3)and(na(_sq)or d3 < _sq)
			_sq:=d3
			_wr:=t3
		if not na(d4)and(na(_sq)or d4 < _sq)
			_sq:=d4
			_wr:=t4
	if not _l
		for k=0 to 4
			arr=k==0?_xo:k==1?_vt:k==2?_qx:k==3?_qr:_ko
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cv:k==1?_bw:k==2?_bf:k==3?_bh:_aq
			if ver
				[da,ta_]=_bm(arr,nom,true)
				[db,tb]=_bm(arr,nom,false)
				if not na(da)and(na(_sp)or da < _sp)
					_sp:=da
					_wj:=ta_
				if not na(db)and(na(_sq)or db < _sq)
					_sq:=db
					_wr:=tb
	_py(_eq,f,"FVG por arriba",_xa(_sp,_wj),_wq(_wj),tam)
	f+=1
	_py(_eq,f,"FVG por abajo",_xa(_sq,_wr),_wq(_wr),tam)
	f+=1
	_uh=not _dy?"(apagada)":na(_cp)?"Ninguna reciente":(_dq==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cp)+" velas"
	_py(_eq,f,"SMT",_uh,not _dy or na(_cp)?#757575:_dq==1?_ir:_hw,tam)
	f+=1
	if _og
		_ot=request.security(_ug,"D",close[1],lookahead=barmerge.lookahead_on)
		[_nh,_wg,_wn]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_ot/16
		pts=_nh*pct/100
		_te=pts > 0?(_wg-_wn)/pts*100:na
		_vl=na(_ot)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_ot,"#.#")+") · hoy "+str.tostring(_wg-_wn,"#")+" pts = "+str.tostring(_te,"#")+" %"
		_py(_eq,f,"Mov. esperado",_vl,na(_te)?#757575:_te >=100?_t:_te >=75?#EF6C00:#424242,tam)
		f+=1
	if _mf and _hu
		_py(_eq,f,"Asia",_rp(_ga,_gv,_at,_hy,_jh),#5E35B1,tam)
		f+=1
		_py(_eq,f,"Londres",_rp(_lu,_mj,_ck,_mq,_mu),#1E88E5,tam)
		f+=1
	if _qg or _fk
		[_vy,_ut,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _qg
			rng=d_h-d_l
			_lq=_ut > 0?rng/_ut*100:na
			_py(_eq,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_ut,"#")+" pts ("+str.tostring(_lq,"#")+" %)",na(_lq)?#757575:_lq >=100?_t:_lq >=75?#EF6C00:#424242,tam)
			f+=1
		if _fk
			dif=close-_vy
			_py(_eq,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_t:_ab,tam)
			f+=1
	if _lo
		float _vu=na
		string _xc=""
		float _vv=na
		string _wd=""
		_nc=array.from(pdh,pdl,_hy?na:_ga,_jh?na:_gv,_mq?na:_lu,_mu?na:_mj)
		_nm=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _dk
			_nc.push(nv._z)
			_nm.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _dl
			_nc.push(nv._z)
			_nm.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _dz
			_nc.push(q._z)
			_nm.push(q.dir==1?"EQH":"EQL")
		for i=0 to _nc.size()-1
			pv=_nc.get(i)
			if not na(pv)
				if pv > close and(na(_vu)or pv < _vu)
					_vu:=pv
					_xc:=_nm.get(i)
				if pv < close and(na(_vv)or pv > _vv)
					_vv:=pv
					_wd:=_nm.get(i)
		_um=(na(_vu)?"↑ —":"↑ "+_xc+" "+str.tostring(_vu,format.mintick)+" (+"+str.tostring(_vu-close,format.mintick)+")")+"  ·  "+(na(_vv)?"↓ —":"↓ "+_wd+" "+str.tostring(_vv,format.mintick)+" (−"+str.tostring(close-_vv,format.mintick)+")")
		_py(_eq,f,"Liquidez",_um,#424242,tam)
		f+=1
	if _qe !=""
		_py(_eq,f,"Noticias hoy",_qe,#EF6C00,tam)
		f+=1
if barstate.islast
	etq=array.new<label>()
	_gc=array.new<bool>()
	for o in _gl
		if not na(o)and not na(o.lb)
			etq.push(o.lb)
			_gc.push(false)
	for n in _dk
		etq.push(n.lb)
		_gc.push(true)
	for n in _dl
		etq.push(n.lb)
		_gc.push(true)
	if etq.size()> 1
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xi=ys.sort_indices()
		_tg=array.new<float>()
		_sm=array.new<int>()
		_oy=array.new<int>()
		_ui=timeframe.in_seconds()*1000
		for j in _xi
			e=etq.get(j)
			y=e.get_y()
			_ss=str.length(e.get_text())+2
			ini=0
			for _vb=0 to 6
				_rv=false
				if _tg.size()> 0
					for c=0 to _tg.size()-1
						if math.abs(_tg.get(c)-y)< _ie and ini < _oy.get(c)and ini+_ss > _sm.get(c)
							ini:=_oy.get(c)
							_rv:=true
				if not _rv
					break
			_tg.push(y)
			_sm.push(ini)
			_oy.push(ini+_ss)
			if _gc.get(j)
				e.set_x(time+ini*_ui)
			else
				e.set_x(bar_index+ini)
