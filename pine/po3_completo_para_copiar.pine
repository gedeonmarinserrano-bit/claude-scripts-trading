	ses=_wj?"Cerrada (fin de semana)":_wt < 570?"Abre a las "+str.format_time(_yl,"HH:mm","Europe/Madrid")+" (en "+(_vx >=60?str.tostring(int(_vx/60))+" h ":"")+str.tostring(_vx%60)+" min)":_wt < 960?"● Abierta (cierra "+str.format_time(_yv,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_yl,"HH:mm","Europe/Madrid")+")"
	_qd(_ej,f,"Sesión NY",ses,not _wj and _wt >=570 and _wt < 960?_ad:#424242,tam)
	f+=1
	float _sw=na
	string _xd=""
	float _sv=na
	string _xf=""
	if _pl
		[d1,t1]=_bj(_hh,"FVG "+_dm,true)
		[d2,t2]=_bj(_iv,"IFVG "+_dm,true)
		[d3,t3]=_bj(_hh,"FVG "+_dm,false)
		[d4,t4]=_bj(_iv,"IFVG "+_dm,false)
		if not na(d1)and(na(_sw)or d1 < _sw)
			_sw:=d1
			_xd:=t1
		if not na(d2)and(na(_sw)or d2 < _sw)
			_sw:=d2
			_xd:=t2
		if not na(d3)and(na(_sv)or d3 < _sv)
			_sv:=d3
			_xf:=t3
		if not na(d4)and(na(_sv)or d4 < _sv)
			_sv:=d4
			_xf:=t4
	if not _n
		for k=0 to 4
			arr=k==0?_xq:k==1?_vz:k==2?_qy:k==3?_qt:_kf
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_ct:k==1?_bw:k==2?_bc:k==3?_az:_aq
			if ver
				[da,ta_]=_bj(arr,nom,true)
				[db,tb]=_bj(arr,nom,false)
				if not na(da)and(na(_sw)or da < _sw)
					_sw:=da
					_xd:=ta_
				if not na(db)and(na(_sv)or db < _sv)
					_sv:=db
					_xf:=tb
	_qd(_ej,f,"FVG por arriba",_xg(_sw,_xd),_wo(_xd),tam)
	f+=1
	_qd(_ej,f,"FVG por abajo",_xg(_sv,_xf),_wo(_xf),tam)
	f+=1
	_vf=not _dn?"(apagada)":na(_cj)?"Ninguna reciente":(_dw==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cj)+" velas"
	_qd(_ej,f,"SMT",_vf,not _dn or na(_cj)?#757575:_dw==1?_iw:_ii,tam)
	f+=1
	if _oz
		_ol=request.security(_uy,"D",close[1],lookahead=barmerge.lookahead_on)
		[_nr,_wh,_xc]=request.security(syminfo.tickerid,"D",[close[1],high,low],lookahead=barmerge.lookahead_on)
		pct=_ol/16
		pts=_nr*pct/100
		_ti=pts > 0?(_wh-_xc)/pts*100:na
		_vd=na(_ol)?"Sin datos del VIX":"±"+str.tostring(pct,"#.##")+" % · ±"+str.tostring(pts,"#")+" pts (VIX "+str.tostring(_ol,"#.#")+") · hoy "+str.tostring(_wh-_xc,"#")+" pts = "+str.tostring(_ti,"#")+" %"
		_qd(_ej,f,"Mov. esperado",_vd,na(_ti)?#757575:_ti >=100?_u:_ti >=75?#EF6C00:#424242,tam)
		f+=1
	if _lz and _iq
		_qd(_ej,f,"Asia",_rj(_fv,_gv,_as,_jk,_ib),#5E35B1,tam)
		f+=1
		_qd(_ej,f,"Londres",_rj(_lx,_nj,_co,_np,_my),#1E88E5,tam)
		f+=1
	if _qc or _fm
		[_xl,_vs,d_h,d_l]=request.security(syminfo.tickerid,"D",[open,ta.atr(14)[1],high,low],lookahead=barmerge.lookahead_on)
		if _qc
			rng=d_h-d_l
			_mf=_vs > 0?rng/_vs*100:na
			_qd(_ej,f,"Rango hoy / ATR D",str.tostring(rng,"#")+" de "+str.tostring(_vs,"#")+" pts ("+str.tostring(_mf,"#")+" %)",na(_mf)?#757575:_mf >=100?_u:_mf >=75?#EF6C00:#424242,tam)
			f+=1
		if _fm
			dif=close-_xl
			_qd(_ej,f,"vs apertura del día",(dif >=0?"Por encima +":"Por debajo ")+str.tostring(dif,format.mintick)+" pts"+(dif >=0?" · premium":" · descuento"),dif >=0?_u:_ad,tam)
			f+=1
	if _lh
		float _wc=na
		string _xn=""
		float _vy=na
		string _xk=""
		_mw=array.from(pdh,pdl,_jk?na:_fv,_ib?na:_gv,_np?na:_lx,_my?na:_nj)
		_ng=array.from("PDH","PDL","Alto Asia","Bajo Asia","Alto Londres","Bajo Londres")
		for nv in _dj
			_mw.push(nv._aa)
			_ng.push(nv.dir==1?"Alto H4":"Bajo H4")
		for nv in _df
			_mw.push(nv._aa)
			_ng.push(nv.dir==1?"Alto H1":"Bajo H1")
		for q in _ds
			_mw.push(q._aa)
			_ng.push(q.dir==1?"EQH":"EQL")
		for i=0 to _mw.size()-1
			pv=_mw.get(i)
			if not na(pv)
				if pv > close and(na(_wc)or pv < _wc)
					_wc:=pv
					_xn:=_ng.get(i)
				if pv < close and(na(_vy)or pv > _vy)
					_vy:=pv
					_xk:=_ng.get(i)
		_up=(na(_wc)?"↑ —":"↑ "+_xn+" "+str.tostring(_wc,format.mintick)+" (+"+str.tostring(_wc-close,format.mintick)+")")+"  ·  "+(na(_vy)?"↓ —":"↓ "+_xk+" "+str.tostring(_vy,format.mintick)+" (−"+str.tostring(close-_vy,format.mintick)+")")
		_qd(_ej,f,"Liquidez",_up,#424242,tam)
		f+=1
	if _ps !=""
		_qd(_ej,f,"Noticias hoy",_ps,#EF6C00,tam)
		f+=1
_ed(array<label> etq,bool _rz,int _tk,float sep)=>
	_of=_tk
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_ya=ys.sort_indices()
		_sy=array.new<float>()
		_sf=array.new<int>()
		_pf=array.new<int>()
		_vi=timeframe.in_seconds()*1000
		for j in _ya
			e=etq.get(j)
			y=e.get_y()
			_rm=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_tk
			for _ut=0 to 6
				_rv=false
				if _sy.size()> 0
					for c=0 to _sy.size()-1
						if math.abs(_sy.get(c)-y)< sep and ini < _pf.get(c)and ini+_rm > _sf.get(c)
							ini:=_pf.get(c)
							_rv:=true
				if not _rv
					break
			_sy.push(y)
			_sf.push(ini)
			_pf.push(ini+_rm)
			_of:=math.max(_of,ini+_rm)
			if _rz
				e.set_x(time+ini*_vi)
			else
				e.set_x(bar_index+ini)
	_of
if barstate.islast
	_lu=array.new<label>()
	for o in _ei
		if not na(o)and not na(o.lb)
			_lu.push(o.lb)
	for q in _h
		q.ln.set_x2(bar_index)
		_lu.push(q.lb)
	_pc=array.new<label>()
	for n in _dj
		_pc.push(n.lb)
	for n in _df
		_pc.push(n.lb)
	_va=_ed(_lu,false,1,_fk*0.35)
	_ed(_pc,true,_lu.size()> 0?_va:1,_fk*0.35)
