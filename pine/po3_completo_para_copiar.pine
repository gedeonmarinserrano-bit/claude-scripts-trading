_nm=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_ii)
_cz="FVG por temporalidad (solo se ven los activados)"
_aq=input.bool(true,"FVG H4",inline="fvgtf1",group=_cz)
_aw=input.bool(true,"FVG H1",inline="fvgtf1",group=_cz)
_bf=input.bool(true,"FVG M15",inline="fvgtf1",group=_cz)
_bx=input.bool(true,"FVG M5",inline="fvgtf2",group=_cz)
_cs=input.bool(true,"FVG M1",inline="fvgtf2",group=_cz)
_nt=input.bool(true,"FVG del gráfico si no es ninguna de las 5 (M3, M30, D…)",group=_cz)
_l=input.bool(true,"Cada FVG solo en el gráfico de su temporalidad (sin mezclar)",group=_cz)
_gl=input.int(25,"Máx. FVG por temporalidad (M5, M15, H1, H4)",minval=1,maxval=60,group=_cz)
_ll=input.int(100,"Máx. zonas dibujadas a la vez (menos = más rápido)",minval=5,maxval=150,group=_cz)
_pp=input.float(0.0,"Dibujar solo zonas a menos de este % del precio (0 = todas)",minval=0,step=0.5,group=_cz)
_oe="Estructura (CHoCH / BOS)"
_ca=input.int(4,"Sensibilidad de los pivotes (velas a cada lado)",minval=1,group=_oe)
_tb=1.1
_vk=2.0
_uw=20
_sw=2
_mp=input.bool(true,"Fondo blanco (colores de alto contraste)",group=_oe)
_iz=input.bool(true,"Mostrar BOS (salvo con tendencia invalidada)",group=_oe)
_hu=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_oe)
_im=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_oe)
_ed=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_oe)
_qv=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_oe)
_bc=bar_index >=last_bar_index-_qv
_cj=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_nb=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
_al=input.color(color.new(#B0B0B0,75),"Parte consumida (todas las zonas)",group="FVG")
_ve="Order Blocks"
_kl=input.bool(true,"Mostrar Order Blocks",group=_ve)
_gb=input.bool(false,"Solo los que originan un CHoCH (no los de BOS)",group=_ve)
_nr=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_ve)
_wr=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_ve)
_no=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_ve)
_kw=input.color(#1565C0,"OB alcista (demanda)",group=_ve)
_km=input.color(#EF6C00,"OB bajista (oferta)",group=_ve)
_pk="Estrategia NY (Bias + PO3)"
_mg=input.bool(true,"Marcar horas de la apertura de Nueva York (hora de Madrid)",group=_pk)
_kk=input.string("Automático (según la apertura de Nueva York)","Horario de las marcas",options=["Verano (15:00 / 15:30 / 15:45 / 16:00)","Invierno (14:00 / 14:30 / 14:45 / 15:00)","Automático (según la apertura de Nueva York)"],group=_pk)
_tx="Colores FVG"
_ap=input.color(#00A651,"FVG alcista (todas las temporalidades)",group=_tx)
_ao=input.color(#E4002B,"FVG bajista (todas las temporalidades)",group=_tx)
_sb=_ap
_ni=_ap
_mu=_ap
_ks=_ap
_lb=_ap
_ig=_ap
_sf=_ao
_nh=_ao
_ml=_ao
_le=_ao
_kz=_ao
_jj=_ao
_jv=input.bool(true,"Niveles clave: altos/bajos relevantes de H4",group=_pk)
_qn=input.int(3,"Sensibilidad altos/bajos H4",minval=1,maxval=10,group=_pk)
_kg=input.int(6,"Máx. niveles H4 vigentes",minval=1,maxval=20,group=_pk)
_ju=input.bool(true,"Niveles clave: altos/bajos relevantes de H1",group=_pk)
_qq=input.int(3,"Sensibilidad altos/bajos H1",minval=1,maxval=10,group=_pk)
_ld=input.int(6,"Máx. niveles H1 vigentes",minval=1,maxval=20,group=_pk)
_ki=input.color(#8D6E63,"Color niveles H1",group=_pk)
_qu=input.bool(true,"Niveles clave: alto/bajo del día anterior",group=_pk)
_du=input.color(#424242,"Color niveles clave",group=_pk)
_mr=input.color(#757575,"Color horas",group=_pk)
_eq=input.bool(true,"Mostrar EMAs",group="EMAs")
_pe=input.int(9,"EMA rápida",minval=1,group="EMAs")
_on=input.int(20,"EMA media",minval=1,group="EMAs")
_od=input.int(200,"EMA lenta",minval=1,group="EMAs")
_ov=input.color(#546E7A,"Color EMA rápida",group="EMAs")
_om=input.color(#9E9D24,"Color EMA media",group="EMAs")
_oq=input.color(color.black,"Color EMA lenta",group="EMAs")
_ir=input.bool(true,"Marcar CHoCH fallidos (✗)",group="CHoCH fallido / riesgo")
_ht=input.bool(true,"Anular tendencia si el CHoCH falla",group="CHoCH fallido / riesgo")
_fw=input.bool(true,"Marcar CHoCH de riesgo (⚠)",group="CHoCH fallido / riesgo")
_kq=input.int(2,"Puntuación mínima para ⚠",minval=1,maxval=6,group="CHoCH fallido / riesgo")
_ut=14
_sg=50
_tm=0.15
_rb=2.5
_qp=30
_qa=1.0
_lk=input.color(color.gray,"Color CHoCH fallido",group="CHoCH fallido / riesgo")
_oz="Colores"
_ac=input.color(#00A651,"Estructura y FVG alcista (verde)",group=_oz)
_u=input.color(#E4002B,"Estructura y FVG bajista (rojo)",group=_oz)
_na=input.bool(true,"Marcar la vela del OB",group=_oz)
_hm=input.color(#FF00C8,"IFVG (magenta)",group=_oz)
_ne=input.int(40,"Transparencia de las zonas (0 = color pleno, tapa las EMAs)",minval=0,maxval=95,step=5,group=_oz)
_kf=input.bool(true,"Zonas sin solaparse (la más concreta encima, la mayor alrededor)",group=_oz)
type Zona
	int x1
	float _ai
	float _ah
	int dir
	float _bi=na
	int _rk=na
	bool _ma=false
var _hj=array.new<Zona>()
var _hs=array.new<Zona>()
var obs=array.new<Zona>()
var _xk=array.new<Zona>()
var _vs=array.new<Zona>()
var _qx=array.new<Zona>()
var _qs=array.new<Zona>()
var _la=array.new<Zona>()
var _wk=array.new<Zona>()
var _tc=array.new<Zona>()
var _pt=array.new<Zona>()
var _qb=array.new<Zona>()
var _me=array.new<Zona>()
type Rango
	int x1
	int x2
	float _ai
	float _ah
	color col
var _bj=array.new<Rango>()
_ey(Zona z)=>
	_fo=z.dir==1?low <=z._ah:high >=z._ai
	if not _fo
		_bi=na(z._bi)?(z.dir==1?z._ai:z._ah):z._bi
		if z.dir==1?low < _bi:high > _bi
			z._bi:=z.dir==1?low:high
	_fo
type Marca
	label lb
	line ln
	int bar
var _in=array.new<Marca>()
var array<string> _fa=array.from("")
var array<int> _fd=array.from(0)
_aj(label lb,line ln,int bar)=>
	_in.push(Marca.new(lb,ln,bar))
	if not na(lb)
		_fa.set(0,lb.get_text())
		_fd.set(0,bar)
	if _in.size()> 500
		_in.shift()
_qr=ta.ema(close,_pe)
_rh=ta.ema(close,_on)
_iw=ta.ema(close,_od)
_ci=ta.atr(_ut)
var string _tw='════════ Detection ════════'
var string _sn='════════ Structure Filters ════════'
var string _vo='════════ Range Behavior ════════'
var string _uc='════════ Visual Settings ════════'
_cv='Base + 2x + 3x'
_ok='Rangos'
_bm=input.int(20,'Velas mínimas para buscar un rango',minval=8,maxval=100,group=_ok)
_bo='Percentile band'
_er=90.0
_lm='Bar close'
_kv=200
_jg=40.0
_ep=500
_np=0.18
_nz='Wick reaches'
_ic=input.int(2,'Toques mínimos en cada borde del rango',minval=1,maxval=10,group=_ok)
_eo=0.10
_sj=0.45
_ej=0.70
_jb='Extend to containment'
_iq=300
_jw=input.int(10,'Duración mínima del rango (velas)',minval=2,maxval=200,group=_ok)
_hc=true
_lv=0.25
_lr='Close beyond'
_id=0.15
_ha=true
_he=10
_mf=3
_fu=0
_nf='Custom'
_lw=#00A651
_mi=#E4002B
_fi=input.color(#F9A825,'Color del rango (neutral)',group=_ok)
_kc=4
_gj=93
_hb=true
_kb=true
_hh=input.bool(true,'Mostrar etiqueta del rango',group=_ok)
_ka=input.bool(true,'Mostrar flechas de ruptura (breakout)',group=_ok)
_ik=input.bool(true,'Mostrar marcas de ruptura fallida (deviation)',group=_ok)
_is='Small'
_fc=true
_jy='Small'
[_cf,_ch]=switch _nf
	'Classic'=> [#00ff00,#ff0000]
	'Aqua'=> [#00d4ff,#ff8c00]
	'Cosmic'=> [#49ffce,#9932cc]
	'Cyber'=> [#00cccc,#ff6600]
	'Neon'=> [#ffff00,#ff00ff]
	=> [_lw,_mi]
var color _cb=color.new(color.black,100)
var float _cg=3.0
var float _dv=1.6
_hv(string _wi)=>
	switch _wi
		'Tiny'=> size.tiny
		'Normal'=> size.normal
		'Large'=> size.large
		=> size.small
_fh(color _dg)=>
	_jc=color.r(_dg)/255.0
	_js=color.g(_dg)/255.0
	_jr=color.b(_dg)/255.0
	_sx=_jc <=0.03928?_jc/12.92:math.pow((_jc+0.055)/1.055,2.4)
	_td=_js <=0.03928?_js/12.92:math.pow((_js+0.055)/1.055,2.4)
	_tr=_jr <=0.03928?_jr/12.92:math.pow((_jr+0.055)/1.055,2.4)
	0.2126*_sx+0.7152*_td+0.0722*_tr
_lt(color _oy,color _mw)=>
	_mn=_fh(_oy)
	_ku=_fh(_mw)
	(math.max(_mn,_ku)+0.05)/(math.min(_mn,_ku)+0.05)
_en(color _hn)=>
	_fh(_hn)> 0.179?#000000:#ffffff
_ow(color _dg,color _my,float _rj)=>
	color.rgb(color.r(_dg)+(color.r(_my)-color.r(_dg))*_rj,color.g(_dg)+(color.g(_my)-color.g(_dg))*_rj,color.b(_dg)+(color.b(_my)-color.b(_dg))*_rj)
_bn(color _dg,color _hn,float _nv)=>
	_my=_en(_hn)
	_lz=_dg
	for step=1 to 10
		if _lt(_lz,_hn)>=_nv
			break
		_lz:=_ow(_dg,_my,step/10.0)
	_lz
_ib(float _xq)=>
	str.tostring(_xq,'#.##')+'%'
_qy(array<box> _kd,int _lg,float _bg,float _an)=>
	array.clear(_kd)
	if not _kf
		for i=0 to _kc-1
			array.push(_kd,box.new(_lg,_bg,bar_index,_an,border_color=na,border_width=0,bgcolor=na,xloc=xloc.bar_index))
_go(array<box> _kd,float _bg,float _an,int _lg,int _sl,color _og)=>
	_pl=array.size(_kd)
	if _pl > 0 and _bg > _an
		_gz=(_bg-_an)/_pl
		for i=0 to _pl-1
			_ix=array.get(_kd,i)
			_ob=math.abs((i+0.5)/_pl-0.5)*2.0
			_oa=int(math.min(99,math.max(0,_gj+(1.0-_ob)*10)))
			box.set_lefttop(_ix,_lg,_bg-_gz*i)
			box.set_rightbottom(_ix,_sl,_bg-_gz*(i+1))
			box.set_bgcolor(_ix,color.new(_og,_oa))
_op(array<box> _kd)=>
	if array.size(_kd)> 0
		for i=0 to array.size(_kd)-1
			box.delete(array.get(_kd,i))
	array.clear(_kd)
_qz(int _rs,float _bg,float _an,float _cp)=>
	_ye=_rs
	if _jb=='Extend to containment'
		_xs=math.min(_iq,bar_index)
		_uy=math.max(2,math.round((1.0-_ej)*_rs))
		_md=0
		_gs=0
		while _gs < _xs and _md <=_uy
			_mk=close[_gs]<=_bg and close[_gs]>=_an
			_tl=_mk and high[_gs]<=_bg+_cp and low[_gs]>=_an-_cp
			if _mk
				_md:=math.max(0,_md-1)
				if _tl and _gs+1 >=_rs
					_ye:=_gs+1
			else
				_md+=1
			_gs+=1
	_ye
_cq=ta.atr(_kv)
_kr=not na(_cq)and _cq > 0
_gg=_lr=='Wick beyond'
_ky=_nz=='Wick reaches'
_oc=_lm=='Live bar'
_fj=_oc or barstate.isconfirmed
_gm=_hv(_is)
_kt=_hv(_jy)
_x=chart.bg_color
_s=_bn(_fi,_x,_cg)
_fn=_bn(_cf,_x,_cg)
_fl=_bn(_ch,_x,_cg)
_hd=_bn(_fi,_x,_dv)
_fk=_bn(_cf,_x,_dv)
_gd=_bn(_ch,_x,_dv)
_gh(simple int len)=>
	_ul=ta.percentile_linear_interpolation(high,len,_er)
	_ql=ta.percentile_linear_interpolation(low,len,100.0-_er)
	_uk=ta.highest(high,len)
	_qw=ta.lowest(low,len)
	_tf=ta.highest(math.max(open,close),len)
	_oi=ta.lowest(math.min(open,close),len)
	top=_bo=='Absolute extremes'?_uk:_bo=='Body extremes'?_tf:_ul
	_kn=_bo=='Absolute extremes'?_qw:_bo=='Body extremes'?_oi:_ql
	_dw=top-_kn
	_pc=_kr and _dw > 0?_dw/(_cq*math.sqrt(len)):99.0
	_tj=bar_index < 1?_ep:int(math.max(1,math.min(_ep,bar_index-_kv)))
	_xz=ta.percentrank(_pc,_tj)
	_xl=ta.linreg(close,len,0)-ta.linreg(close,len,1)
	_xw=_dw > 0?math.abs(_xl)*len/_dw:99.0
	_cu=math.avg(top,_kn)
	_cp=_eo*nz(_cq)
	_nn=0
	_qe=0
	_ji=0
	_mq=0
	for i=0 to len-1
		if(close[i]> _cu)!=(close[i+1]> _cu)
			_nn+=1
		_ny=_ky?high[i]>=top-_cp:close[i]>=top-_cp
		_jx=_ky?low[i]<=_kn+_cp:close[i]<=_kn+_cp
		if _ny
			_qe+=1
		if _jx
			_ji+=1
		if close[i]<=top and close[i]>=_kn
			_mq+=1
	_pf=_mq/float(len)
	_ie=_kr and not na(_xz)and bar_index > len+5 and _xz <=_jg and _nn >=math.max(3,math.round(_np*len))and _qe >=_ic and _ji >=_ic and _xw <=_sj and _pf >=_ej
	[_ie,top,_kn]
bool _jh=false
bool _ij=false
bool _jo=false
float _wz=na
float _wo=na
float _xf=na
float _qd=na
float _pr=na
float _pu=na
if _bc
	[qa,ta_,ba]=_gh(_bm)
	_jh:=qa
	_wz:=ta_
	_qd:=ba
	if _cv !='Base only'
		[qb,tb,bb]=_gh(_bm*2)
		_ij:=qb
		_wo:=tb
		_pr:=bb
	if _cv=='Base + 2x + 3x'
		[qc,tc,bc]=_gh(_bm*3)
		_jo:=qc
		_xf:=tc
		_pu:=bc
_eu=_cv !='Base only' and _ij
_ev=_cv=='Base + 2x + 3x' and _jo
_ie=_jh or _eu or _ev
_oj=_ev?_bm*3:_eu?_bm*2:_bm
_qj=_ev?_xf:_eu?_wo:_wz
_hq=_ev?_pu:_eu?_pr:_qd
var array<box> _at=array.new<box>()
var box _t=na
var line _g=na
var line _k=na
var line _w=na
var label _z=na
var label _av=na
var float _f=na
var float _a=na
var int _c=na
var int _gy=na
var bool _v=false
var bool _m=false
var bool _bb=false
var int _dq=na
var int _p=0
var float _o=na
var int _bh=na
var int _bd=0
_cc=false
_cl=false
_bk=false
_bz=false
if _fj and _bd > 0
	_bd-=1
if _fj and not _v and not _bb and _bd <=0 and _ie
	_os=_qz(_oj,_qj,_hq,_eo*_cq)
	_c:=bar_index-_os+1
	_gy:=bar_index
	_f:=_qj
	_a:=_hq
	_v:=true
	_m:=false
	_cu=math.avg(_f,_a)
	_bu=_a+(_f-_a)*0.25
	_ba=_a+(_f-_a)*0.75
	_t:=box.new(_c,_f,bar_index,_a,border_color=color.new(_s,55),border_width=2,border_style=line.style_dotted,bgcolor=na,xloc=xloc.bar_index)
	_qy(_at,_c,_f,_a)
	if _hb
		_g:=line.new(_c,_cu,bar_index,_cu,xloc.bar_index,extend.none,color.new(color.gray,45),line.style_dotted,1)
	if _kb
		_k:=line.new(_c,_bu,bar_index,_bu,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
		_w:=line.new(_c,_ba,bar_index,_ba,xloc.bar_index,extend.none,color.new(color.gray,70),line.style_dotted,1)
	if _hh
		_z:=label.new(_c,_f,'',xloc=xloc.bar_index,yloc=yloc.price,color=_cb,style=label.style_label_down,textcolor=color.new(_s,10),size=_gm)
	_cc:=true
if _v and _fj
	_cw=_id*_cq
	_fs=_lv*_cq
	if _hc and not _gg and close <=_f and close >=_a
		if high > _f and high <=_f+_fs
			_f:=high
		if low < _a and low >=_a-_fs
			_a:=low
	_pq=_gg?high > _f+_cw:close > _f+_cw
	_kx=_gg?low < _a-_cw:close < _a-_cw
	_qt=_fu > 0 and bar_index-_gy+1 >=_fu
	if _pq or _kx or _qt
		_b=_pq?1:_kx?-1:0
		_sd=_b !=0?bar_index-_c:bar_index-_c+1
		_ng=_a !=0?(_f-_a)/_a*100.0:0.0
		_ke=_ha and _b !=0 and _m
		if _m
			_fg=_b==1?_fn:_b==-1?_fl:_s
			_nw=_b==1?_fk:_b==-1?_gd:_hd
			_hz=_b==1?_cf:_b==-1?_ch:_fi
			box.set_lefttop(_t,_c,_f)
			box.set_rightbottom(_t,bar_index,_a)
			box.set_border_color(_t,color.new(_fg,30))
			box.set_border_style(_t,line.style_dotted)
			_go(_at,_f,_a,_c,bar_index,na)
			_bj.push(Rango.new(_c,bar_index,_f,_a,_nw))
			if _bj.size()> 8
				_bj.shift()
			if not na(_g)
				line.set_x2(_g,bar_index)
			if not na(_k)
				line.set_x2(_k,bar_index)
				line.set_x2(_w,bar_index)
			if not na(_z)
				label.set_xy(_z,int(math.avg(_c,bar_index)),_f)
				label.set_text(_z,'RANGE   '+str.tostring(_sd)+' BARS   '+_ib(_ng))
				label.set_textcolor(_z,color.new(_fg,10))
			if _ka and _b !=0
				_oo=(_b==1?'▲  ':'▼  ')+'Breakout'
				if _fc
