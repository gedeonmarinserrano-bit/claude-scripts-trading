var array<int> uso=array.from(0,0,0)
_qz(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _eh.size()
		b=_eh.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_eh.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_pd(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _di.size()
		l=_di.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
