type NivelSes
	line ln
	label lb
	float _z
	int _xn=na
	int k=0
	int _wz=na
var array<NivelSes> _gl=array.new<NivelSes>(6)
var array<NivelSes> _ae=array.new<NivelSes>()
_em(int x,float v,string nom,color col)=>
	[line.new(x,v,bar_index,v,color=color.new(col,15),width=1),label.new(bar_index,v,nom,style=label.style_label_left,color=color.new(color.white,100),textcolor=col,size=size.tiny)]
_di(int k,bool en,bool ini,float v,int dir,string ses,color col)=>
	_sg=(dir==1?"Máximo ":"Mínimo ")+ses
	o=_gl.get(k)
	if ini
		if not na(o)and not na(o.ln)
			o.ln.delete()
			o.lb.delete()
		if _ae.size()> 0
			for i=_ae.size()-1 to 0
				q=_ae.get(i)
				if q.k==k
					_ae.remove(i)
					q.ln.delete()
					q.lb.delete()
		[ln,lb]=_em(bar_index,v,_sg,col)
		_gl.set(k,NivelSes.new(ln,lb,v,na,k,bar_index))
	else if not na(o)
		if en and not na(o.ln)
			o._z:=v
			o.ln.set_y1(v)
			o.ln.set_y2(v)
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,v)
		else if na(o.ln)
			if dir==1?high > o._z:low < o._z
				o._z:=dir==1?high:low
				o._wz:=bar_index
			if bar_index-o._xn >=5
				dup=false
				for j=0 to 5
					p=_gl.get(j)
					if j !=k and not na(p)and not na(p.ln)and math.abs(p._z-o._z)<=0.1*nz(_cq)
						dup:=true
				if dup
					_gl.set(k,na)
				else
					[ln,lb]=_em(o._wz,o._z,_sg,col)
					o.ln:=ln
					o.lb:=lb
					o.lb.set_xy(bar_index,o._z)
		else if dir==1?high > o._z:low < o._z
			o.ln.set_x2(bar_index)
			o.ln.set_color(color.new(#9E9E9E,20))
			o.ln.set_style(line.style_dashed)
			o.lb.set_xy(bar_index,o._z)
			o.lb.set_text((dir==1?"Máximo manipulado ":"Mínimo manipulado ")+ses)
			o.lb.set_textcolor(#9E9E9E)
			_ae.push(o)
			if _ae.size()> 24
				q=_ae.shift()
				q.ln.delete()
				q.lb.delete()
			_gl.set(k,NivelSes.new(na,na,dir==1?high:low,bar_index,k,bar_index))
		else
			o.ln.set_x2(bar_index)
			o.lb.set_xy(bar_index,o._z)
if _nd and _hu and _bg
	if((_at and not _at[1])or(_ck and not _ck[1])or(_ee and not _ee[1]))and _ae.size()> 0
		for q in _ae
			q.ln.delete()
			q.lb.delete()
		_ae.clear()
	_di(0,_at,_at and not _at[1],_ga,1,"Asia",#5E35B1)
	_di(1,_at,_at and not _at[1],_gv,-1,"Asia",#5E35B1)
	_di(2,_ck,_ck and not _ck[1],_lu,1,"Londres",#1E88E5)
	_di(3,_ck,_ck and not _ck[1],_mj,-1,"Londres",#1E88E5)
	_di(4,_ee,_ee and not _ee[1],_xp,1,"NY",#EF6C00)
