_ed(array<label> etq,bool _se,int _uv,float sep)=>
	_ov=_uv
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xv=ys.sort_indices()
		_tm=array.new<float>()
		_ri=array.new<int>()
		_or=array.new<int>()
		_vm=timeframe.in_seconds()*1000
		for j in _xv
			e=etq.get(j)
			y=e.get_y()
			_sr=int(math.ceil(str.length(e.get_text())*0.8))+1
			ini=_uv
			for _vp=0 to 6
				_rk=false
				if _tm.size()> 0
					for c=0 to _tm.size()-1
						if math.abs(_tm.get(c)-y)< sep and ini < _or.get(c)and ini+_sr > _ri.get(c)
							ini:=_or.get(c)
							_rk:=true
				if not _rk
					break
			_tm.push(y)
			_ri.push(ini)
			_or.push(ini+_sr)
			_ov:=math.max(_ov,ini+_sr)
			if _se
				e.set_x(time+ini*_vm)
			else
				e.set_x(bar_index+ini)
	_ov
if barstate.islast
	_lp=array.new<label>()
	for o in _gm
		if not na(o)and not na(o.lb)
			_lp.push(o.lb)
	for q in _i
		q.ln.set_x2(bar_index)
		_lp.push(q.lb)
	_nx=array.new<label>()
	for n in _dg
		_nx.push(n.lb)
	for n in _dk
		_nx.push(n.lb)
	_uo=_ed(_lp,false,1,_ff*0.35)
	_ed(_nx,true,_lp.size()> 0?_uo:1,_ff*0.35)
