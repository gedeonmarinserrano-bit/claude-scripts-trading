_hv=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_nt)
_ik=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_nt)
_em=input.bool(false,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_nt)
