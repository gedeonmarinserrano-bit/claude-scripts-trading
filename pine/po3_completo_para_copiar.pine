		_ae.clear()
	_dg(0,_as,_as and not _as[1],_fq,1,"Asia",#5E35B1)
	_dg(1,_as,_as and not _as[1],_gn,-1,"Asia",#5E35B1)
	_dg(2,_cn,_cn and not _cn[1],_lk,1,"Londres",#1E88E5)
	_dg(3,_cn,_cn and not _cn[1],_ms,-1,"Londres",#1E88E5)
	_dg(4,_en,_en and not _en[1],_xd,1,"NY",#EF6C00)
	_dg(5,_en,_en and not _en[1],_xc,-1,"NY",#EF6C00)
