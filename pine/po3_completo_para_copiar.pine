				_bs(_tf,_uf,_ts,1,t5,5)
			else if b5
				_bs(_tf,_uh,_ug,-1,t5,5)
	if _av and not _m and _ji < 900
		_ij:=_bk(_oz,_og)
		if _rg
			[a15,b15,_st,_td,_sj,_sa,t15]=request.security(syminfo.tickerid,"15",_kg(),lookahead=barmerge.lookahead_on)
			if a15
				_bs(_oz,_st,_td,1,t15,15)
			else if b15
				_bs(_oz,_sa,_sj,-1,t15,15)
	if _ba and not _m and _ji < 3600
		_jv:=_bk(_os,_of)
		if _qy
			[a60,b60,_tb,_sl,_su,_sv,t60]=request.security(syminfo.tickerid,"60",_kg(),lookahead=barmerge.lookahead_on)
			if a60
				_bs(_os,_tb,_sl,1,t60,60)
			else if b60
				_bs(_os,_sv,_su,-1,t60,60)
	if _an and not _m and _ji < 14400
		_ke:=_bk(_jk,_ku)
		if _lu
			[_vy,_uj,_qu,_qx,_rn,_qz,_vb]=request.security(syminfo.tickerid,"240",_kg(),lookahead=barmerge.lookahead_on)
			if _vy
				_bs(_jk,_qu,_qx,1,_vb,240)
			else if _uj
				_bs(_jk,_qz,_rn,-1,_vb,240)
type Nivel
	line ln
	label lb
	float _il
	int dir
var _bf=array.new<Nivel>()
_tq()=>
	[ta.pivothigh(high,_cy,_cy)[1],ta.pivotlow(low,_cy,_cy)[1],time[1+_cy]]
[ph4,pl4,tp4]=request.security(syminfo.tickerid,"240",_tq(),lookahead=barmerge.lookahead_on)
_in(float _il,int dir,int _sq)=>
	ln=line.new(_sq,_il,time,_il,xloc=xloc.bar_time,color=color.new(_dj,20),width=1)
	lb=label.new(time,_il,dir==1?"Alto H4":"Bajo H4",xloc=xloc.bar_time,style=label.style_label_left,color=color.new(color.white,100),textcolor=color.new(_dj,10),size=size.tiny)
	_bf.push(Nivel.new(ln,lb,_il,dir))
	if _bf.size()> _pb
		n=_bf.shift()
		n.ln.delete()
		n.lb.delete()
if _bu and _jd and timeframe.isintraday and _ji < 14400
	if _bf.size()> 0
		for i=_bf.size()-1 to 0
			n=_bf.get(i)
			if(n.dir==1 and close > n._il)or(n.dir==-1 and close < n._il)
				n.ln.delete()
				n.lb.delete()
				_bf.remove(i)
			else
				n.ln.set_x2(time)
				n.lb.set_x(time)
	if _lu
		if not na(ph4)
			_in(ph4,1,tp4)
		if not na(pl4)
			_in(pl4,-1,tp4)
[pdh,pdl]=request.security(syminfo.tickerid,"D",[high[1],low[1]],lookahead=barmerge.lookahead_on)
_rv=_ou and timeframe.isintraday and not timeframe.change("D")
plot(_rv?pdh:na,"Alto día anterior",color=color.new(_dj,30),style=plot.style_linebr,linewidth=1)
plot(_rv?pdl:na,"Bajo día anterior",color=color.new(_dj,30),style=plot.style_linebr,linewidth=1)
_go="SMT (divergencias entre índices)"
_de=input.bool(false,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_go)
_kr=input.bool(true,"Mostrar etiquetas de la SMT",group=_go)
_pl=input.bool(true,"Mostrar línea de la SMT",group=_go)
_rm=input.bool(true,"Comparar con",inline="smt1",group=_go)
_nv=input.symbol("CME_MINI:ES1!","",inline="smt1",group=_go)
_qv=input.bool(true,"Comparar con",inline="smt2",group=_go)
_om=input.symbol("CBOT_MINI:YM1!","",inline="smt2",group=_go)
_ft=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_go)
_nx=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_go)
_qc=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_go)
_hp=input.color(#ff1100,"SMT bajista (en altos)",group=_go)
_he=input.color(#2157f3,"SMT alcista (en bajos)",group=_go)
_ka(string s)=>
	_ru=str.split(s,":")
	_ru.size()> 0?_ru.last():s
_pm=_ka(_nv)
_qe=_ka(_om)
_tl=str.replace(_pm,"1!","")
_th=str.replace(_qe,"1!","")
_ry=str.replace(syminfo.ticker,"1!","")
_mr=_de and _rm and _tl !=_ry
_ne=_de and _qv and _th !=_ry
_pk()=>
	w=2*_ft+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _oc=na
float _ol=na
int _pj=na
int _pr=na
float _oj=na
float _nt=na
int _px=na
int _pi=na
if _mr and _cd
	[h_,l_,hb_,lb_]=request.security(_nv,timeframe.period,_pk(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_oc:=h_
	_ol:=l_
	_pj:=hb_
	_pr:=lb_
if _ne and _cd
	[h_,l_,hb_,lb_]=request.security(_om,timeframe.period,_pk(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_oj:=h_
	_nt:=l_
	_px:=hb_
	_pi:=lb_
_mc=ta.pivothigh(high,_ft,_ft)
_le=ta.pivotlow(low,_ft,_ft)
_oq=bar_index-_ft
var int _gv=na
var float _fh=na
var float _hh=na
var float _hw=na
var int _gt=na
var float _fi=na
var float _iq=na
var float _ho=na
var array<line> _fw=array.new<line>()
var array<label> _fo=array.new<label>()
_dc(float y,float _sx,float c,float _oy,bool _nn)=>
	_sf=_nn?y > _sx:y < _sx
	_sc=_nn?c > _oy:c < _oy
	not na(_sx)and not na(_oy)and not na(c)and _sf !=_sc
_fe(string t,float c,float _oy)=>
	t+(c > _oy?" ↑":c < _oy?" ↓":" =")
_kd(int x1,float y1,int xv,string txt,color col,bool _nn)=>
	yv=_nn?high[bar_index-xv]:low[bar_index-xv]
	if _pl
		_fw.push(line.new(x1,y1,xv,yv,color=col))
	if _kr
		_fo.push(label.new(xv,yv,txt,style=_nn?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_nn?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_nn?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _fw.size()> _qc
		_fw.shift().delete()
	if _fo.size()> _qc
		_fo.shift().delete()
var int _ch=na
var int _dm=0
_gz=false
_hm=false
if barstate.isconfirmed
	if not na(_mc)
		_qa=not na(_gv)and _oq-_gv <=_nx
		d1=_qa and _mr and _dc(_mc,_fh,_oc,_hh,true)
		d2=_qa and _ne and _dc(_mc,_fh,_oj,_hw,true)
		if d1 or d2
			_gz:=true
			_ch:=bar_index
			_dm:=-1
			_ip=_mc > _fh
			xv=_ip?_oq:bar_index+int(d1?_pj:_px)
			t1=_fe(_pm,_oc,_hh)
			t2=_fe(_qe,_oj,_hw)
			_kd(_gv,_fh,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_hp,true)
		_gv:=_oq
		_fh:=_mc
		_hh:=_oc
		_hw:=_oj
	if not na(_le)
		_qa=not na(_gt)and _oq-_gt <=_nx
		d1=_qa and _mr and _dc(_le,_fi,_ol,_iq,false)
		d2=_qa and _ne and _dc(_le,_fi,_nt,_ho,false)
		if d1 or d2
			_hm:=true
			_ch:=bar_index
			_dm:=1
			_ip=_le < _fi
			xv=_ip?_oq:bar_index+int(d1?_pr:_pi)
			t1=_fe(_pm,_ol,_iq)
			t2=_fe(_qe,_nt,_ho)
			_kd(_gt,_fi,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_he,false)
		_gt:=_oq
		_fi:=_le
		_iq:=_ol
		_ho:=_nt
type Pieza
	int x1
	int x2
	float top
	float bot
	int dir=0
var array<box> _dy=array.new<box>()
var array<line> _cw=array.new<line>()
var array<label> _bp=array.new<label>()
var array<int> uso=array.from(0,0,0)
_ow(int x1,float top,int x2,float bot,color col)=>
	i=uso.get(0)
	if i < _dy.size()
		b=_dy.get(i)
		b.set_lefttop(x1,top)
		b.set_rightbottom(x2,bot)
		b.set_bgcolor(col)
	else
		_dy.push(box.new(x1,top,x2,bot,border_color=na,bgcolor=col))
	uso.set(0,i+1)
_mk(int x1,int x2,float y,color col)=>
	i=uso.get(1)
	if i < _cw.size()
		l=_cw.get(i)
		l.set_xy1(x1,y)
		l.set_xy2(x2,y)
		l.set_color(col)
	else
		_cw.push(line.new(x1,y,x2,y,color=col,style=line.style_dashed,width=1))
	uso.set(1,i+1)
_kp(int x,float y,string txt,color col)=>
	i=uso.get(2)
	if i < _bp.size()
		e=_bp.get(i)
		e.set_xy(x,y)
		e.set_text(txt)
		e.set_textcolor(col)
	else
		_bp.push(label.new(x,y,txt,style=label.style_label_right,color=color.new(color.white,100),textcolor=col,size=size.tiny))
	uso.set(2,i+1)
type Letrero
	int x
	float y
	string txt
	color col
	bool _ur
	bool _qi
var array<Letrero> _fl=array.new<Letrero>()
_mz=nz(ta.atr(50))*0.5
_se=input.float(8.0,"Separación entre zonas alcistas y bajistas que se tocan (% del ATR, 0 = sin hueco)",minval=0,maxval=50,step=1,group=_nq)
_dq=nz(ta.atr(50))*_se/100
var array<Pieza> _fm=array.new<Pieza>()
_tx(Pieza p,Pieza o)=>
	out=array.new<Pieza>()
	if o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot
		out.push(p)
	else
		if o.x1 > p.x1
			out.push(Pieza.new(p.x1,o.x1,p.top,p.bot))
		if o.x2 < p.x2
			out.push(Pieza.new(o.x2,p.x2,p.top,p.bot))
		cx1=math.max(p.x1,o.x1)
		cx2=math.min(p.x2,o.x2)
		if o.top < p.top
			out.push(Pieza.new(cx1,cx2,p.top,o.top))
		if o.bot > p.bot
			out.push(Pieza.new(cx1,cx2,o.bot,p.bot))
	out
_nu(Pieza p)=>
	res=array.from(p)
	if _kf and _fm.size()> 0
		for o in _fm
			if not(o.x2 <=p.x1 or o.x1 >=p.x2 or o.bot >=p.top or o.top <=p.bot)
				_to=array.new<Pieza>()
				for q in res
					for r in _tx(q,o)
						_to.push(r)
				res:=_to
				if res.size()==0 or res.size()> 10
					break
	res
_gf(Pieza p,color col,int dir)=>
	for q in _nu(p)
		top=q.top
		bot=q.bot
		if _dq > 0 and dir !=0
			for o in _fm
				if o.dir==-dir and not(o.x2 <=q.x1 or o.x1 >=q.x2)
					if math.abs(top-o.bot)<=_dq
						top:=math.min(top,o.bot-_dq)
					if math.abs(bot-o.top)<=_dq
						bot:=math.max(bot,o.top+_dq)
		if q.x2 > q.x1 and top > bot and uso.get(0)< 440
			_ow(q.x1,top,q.x2,bot,col)
_ln(int _sy,int x2,float _ad,float _ac,int dir,float _bc,color col,string txt,color _ul,color _ny,color _ml,bool _qi)=>
	x1=math.max(_sy,bar_index-1000)
	_ve=na(_bc)?_ad:(dir==1?_bc:_ad)
	_vm=na(_bc)?_ac:(dir==1?_ac:_bc)
	_gf(Pieza.new(x1,x2,_ve,_vm),col,dir)
	if not na(_bc)
		_gf(Pieza.new(x1,x2,dir==1?_ad:_bc,dir==1?_bc:_ac),_ml,dir)
	if txt !="" and _fl.size()< 30
		_fl.push(Letrero.new(x2,(_ve+_vm)/2,txt,_ul,true,_qi))
	if not na(_ny)
		m=(_ad+_ac)/2
		for q in _nu(Pieza.new(x1,x2,m,m))
			if q.x2 > q.x1
				_mk(q.x1,q.x2,m,_ny)
	_fm.push(Pieza.new(x1,x2,_ad,_ac,dir))
_as(array<Zona> arr,color _up,color _ut,int _rw,string txt,bool _vi,bool _qt,color _ml,bool _qi)=>
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			c=z.dir==1?_up:_ut
			t=txt
			_vw=z._ac > close?z._ac-close:close > z._ad?close-z._ad:0.0
			if uso.get(0)< 440 and _fm.size()< _kt and(_ob==0 or _vw/close*100 <=_ob)
				_ln(z.x1,bar_index+1,z._ad,z._ac,z.dir,z._bc,color.new(c,_mb),t,c,_qt?color.new(color.white,30):na,_ml,_qi)
_ap()=>
	if _op
		_as(_ih,_gs,_gs,88,"IFVG "+_dh,true,false,_ah,false)
		_as(_gm,_rc,_ra,80,"FVG "+_dh,true,false,_ah,true)
	_as(obs,_jr,_jz,90,"OB "+_dh,true,false,_ah,false)
_da(bool ver,int _tg,array<Zona> f,array<Zona> fi,color ca,color cb,int _rw,string nom)=>
	if ver and not _m and _d !=_tg*60
		_as(fi,_gs,_gs,88,"IFVG "+nom,true,false,_ah,false)
		_as(f,ca,cb,_rw,"FVG "+nom,true,_tg >=15,_ah,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fl.clear()
	_fm.clear()
	_ab=false
	if _d <=60
		_ap()
		_ab:=true
	_da(_ck,1,_uy,_uc,_lk,_lv,84,"M1")
	if not _ab and _d <=300
		_ap()
		_ab:=true
	_da(_br,5,_tf,_re,_lm,_lt,84,"M5")
	if not _ab and _d <=900
		_ap()
		_ab:=true
	_da(_av,15,_oz,_og,_jp,_jj,84,"M15")
	if not _ab and _d <=3600
		_ap()
		_ab:=true
	_da(_ba,60,_os,_of,_ju,_jn,82,"H1")
	if not _ab and _d <=14400
		_ap()
		_ab:=true
	_da(_an,240,_jk,_ku,_ik,_hx,80,"H4")
	if not _ab
		_ap()
	if _fl.size()> 0
		_lo=array.new<Letrero>()
		for l in _fl
			x=l.x
			_uq=str.length(l.txt)+2
			for _un=0 to 3
				_tn=false
				for c in _lo
					_py=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _mz and x > c.x-_py and x-_uq < c.x
						x:=c.x-_py
						_tn:=true
				if not _tn
					break
			_lo.push(Letrero.new(x,l.y,l.txt,l.col,true,l._qi))
			_kp(x,l.y,l.txt,color.white)
	while _dy.size()> uso.get(0)
		_dy.pop().delete()
	while _cw.size()> uso.get(1)
		_cw.pop().delete()
	while _bp.size()> uso.get(2)
		_bp.pop().delete()
_oe()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bh(array<Zona> arr,string nom,bool _um)=>
	float _rf=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bc)?z._ac:z._bc
		hi=z.dir==-1 or na(z._bc)?z._ad:z._bc
		d=close >=lo and close <=hi?0.0:_um?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_rf)or d < _rf)
			_rf:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_rf,txt]
_sn(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_kk(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_ko(int b)=>
	b==1?_aj:b==-1?_az:#757575
_ub(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_ui(string n)=>
	str.contains(n,"alcista")?_aj:str.contains(n,"bajista")?_az:#757575
var table _jh=na
if barstate.islast and _kj
	pos=_is=="Arriba izquierda"?position.top_left:_is=="Abajo derecha"?position.bottom_right:_is=="Abajo izquierda"?position.bottom_left:position.top_right
	tam=_ly=="Muy pequeño"?size.tiny:_ly=="Normal"?size.normal:size.small
	if na(_jh)
		_jh:=table.new(pos,2,7,bgcolor=color.new(color.white,8),border_color=color.new(#9E9E9E,60),border_width=1,frame_color=color.new(#9E9E9E,30),frame_width=1)
	_jh.clear(0,0,1,6)
	int _uj=0
	int b60=0
	if timeframe.isintraday and _d < 14400
		_uj:=request.security(syminfo.tickerid,"240",_oe(),lookahead=barmerge.lookahead_on)
	if timeframe.isintraday and _d < 3600
		b60:=request.security(syminfo.tickerid,"60",_oe(),lookahead=barmerge.lookahead_on)
	_sn(_jh,0,"Bias H4",_d < 14400?_kk(_uj):"(gráfico ≥ H4)",_ko(_uj),tam)
	_sn(_jh,1,"Bias H1",_d < 3600?_kk(b60):"(gráfico ≥ H1)",_ko(b60),tam)
	ev=_ej.get(0)
	_tz=ev==""?"":" · "+ev+" hace "+str.tostring(bar_index-_ek.get(0))+" velas"
	_sn(_jh,2,"Estructura "+_dh,_kk(_i)+_tz,_ko(_i),tam)
	tz="America/New_York"
	_ue=hour(timenow,tz)*60+minute(timenow,tz)
	_vk=dayofweek(timenow,tz)
	_vg=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),9,30)
	_vs=timestamp(tz,year(timenow,tz),month(timenow,tz),dayofmonth(timenow,tz),16,0)
	_tu=_vk==dayofweek.saturday or _vk==dayofweek.sunday
	_sr=570-_ue
	ses=_tu?"Cerrada (fin de semana)":_ue < 570?"Abre a las "+str.format_time(_vg,"HH:mm","Europe/Madrid")+" (en "+(_sr >=60?str.tostring(int(_sr/60))+" h ":"")+str.tostring(_sr%60)+" min)":_ue < 960?"● Abierta (cierra "+str.format_time(_vs,"HH:mm","Europe/Madrid")+")":"Cerrada (abre mañana "+str.format_time(_vg,"HH:mm","Europe/Madrid")+")"
	_sn(_jh,3,"Sesión NY",ses,not _tu and _ue >=570 and _ue < 960?_aj:#424242,tam)
	float _qp=na
	string _ti=""
	float _qr=na
	string _tw=""
	if _op
		[d1,t1]=_bh(_gm,"FVG "+_dh,true)
		[d2,t2]=_bh(_ih,"IFVG "+_dh,true)
		[d3,t3]=_bh(_gm,"FVG "+_dh,false)
		[d4,t4]=_bh(_ih,"IFVG "+_dh,false)
		if not na(d1)and(na(_qp)or d1 < _qp)
			_qp:=d1
			_ti:=t1
		if not na(d2)and(na(_qp)or d2 < _qp)
			_qp:=d2
			_ti:=t2
		if not na(d3)and(na(_qr)or d3 < _qr)
			_qr:=d3
			_tw:=t3
		if not na(d4)and(na(_qr)or d4 < _qr)
			_qr:=d4
			_tw:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_uy:k==1?_tf:k==2?_oz:k==3?_os:_jk
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_ck:k==1?_br:k==2?_av:k==3?_ba:_an
			if ver
				[da,ta_]=_bh(arr,nom,true)
				[db,tb]=_bh(arr,nom,false)
				if not na(da)and(na(_qp)or da < _qp)
					_qp:=da
					_ti:=ta_
				if not na(db)and(na(_qr)or db < _qr)
					_qr:=db
					_tw:=tb
	_sn(_jh,4,"FVG por arriba",_ub(_qp,_ti),_ui(_ti),tam)
	_sn(_jh,5,"FVG por abajo",_ub(_qr,_tw),_ui(_tw),tam)
	_sb=not _de?"(apagada)":na(_ch)?"Ninguna reciente":(_dm==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_ch)+" velas"
	_sn(_jh,6,"SMT",_sb,not _de or na(_ch)?#757575:_dm==1?_he:_hp,tam)
