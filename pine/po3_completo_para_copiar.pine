	if _es(_ak+60)
		_ds(_ew(_ak+60),true)
_lt()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_ve(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_bu(array<Zona> arr,float _ag,float _ah,int dir,int _vs,int _vy)=>
	if _ag-_ah >=_gp(_vy)
		z=Zona.new(_ve(_vs),_ag,_ah,dir)
		if not _ev(z)
			arr.push(z)
			if arr.size()> _ge
				arr.shift()
_bs(array<Zona> arr,array<Zona> _do)=>
	_wr=false
	if _do.size()> 0
		for i=_do.size()-1 to 0
			if _ev(_do.get(i))
				_do.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_sy=(z._ag+z._ah)/2
			if low <=_sy and high >=_sy
				_wr:=true
			_ja=na(z._bi)and(z.dir==1?(open >=z._ag and close < z._ah):(open <=z._ah and close > z._ag))
			if _ja
				arr.remove(i)
				_do.push(Zona.new(z.x1,z._ag,z._ah,-z.dir,na,bar_index))
				if _do.size()> _ge
					_do.shift()
			else if _ev(z)
				arr.remove(i)
	_wr
