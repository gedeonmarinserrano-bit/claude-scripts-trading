_jc=input.bool(true,"Borrar el BOS contrario previo al CHoCH (modifica el pasado)",group=_nx)
_ja=input.int(0,"Borrar BOS previo al CHoCH: máx. velas (0 = sin límite)",minval=0,group=_nx)
_el=input.bool(true,"Sin CHoCH ni BOS dentro de un rango (hasta el breakout)",group=_nx)
_qw=input.int(2000,"Velas de historial a calcular (menos = más rápido)",minval=300,maxval=20000,group=_nx)
_av=bar_index >=last_bar_index-_qw
_cn=input.float(0.15,"Tamaño mínimo FVG (× ATR; 0 = todos)",minval=0,step=0.05,group="FVG")
_na=input.int(50,"Máx. zonas vigiladas",minval=1,maxval=250,group="FVG")
