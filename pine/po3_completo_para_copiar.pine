if _as and not _as[1]
	_ac.set(2,false)
	_ac.set(3,false)
if _ck and not _ck[1]
	_ac.set(4,false)
	_ac.set(5,false)
if _lu and _be and _jp and _bg
	for k=0 to 5
		nv=k==0?pdh:k==1?pdl:k==2?_fn:k==3?_gr:k==4?_lh:_nb
		_yn=k < 2 or(k < 4?not _as:not _ck)
		_vv=k%2==0
		if _yn and not na(nv)and not _ac.get(k)and(_vv?high > nv and close < nv:low < nv and close > nv)
			_ac.set(k,true)
