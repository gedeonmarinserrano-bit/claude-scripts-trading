	if _qm !=""
		_qh(_ej,f,"Noticias hoy",_qm,#EF6C00,tam)
		f+=1
_ea(array<label> etq,bool _rw,int _th)=>
	_ny=_th
	if etq.size()> 0
		ys=array.new<float>()
		for e in etq
			ys.push(e.get_y())
		_xs=ys.sort_indices()
		_sx=array.new<float>()
		_rr=array.new<int>()
		_pd=array.new<int>()
		_uy=timeframe.in_seconds()*1000
		for j in _xs
			e=etq.get(j)
			y=e.get_y()
			_sg=str.length(e.get_text())+2
			ini=_th
			for _us=0 to 6
				_rt=false
				if _sx.size()> 0
					for c=0 to _sx.size()-1
						if math.abs(_sx.get(c)-y)< _hz and ini < _pd.get(c)and ini+_sg > _rr.get(c)
							ini:=_pd.get(c)
							_rt:=true
				if not _rt
					break
			_sx.push(y)
			_rr.push(ini)
			_pd.push(ini+_sg)
			_ny:=math.max(_ny,ini+_sg)
			if _rw
				e.set_x(time+ini*_uy)
			else
				e.set_x(bar_index+ini)
	_ny
if barstate.islast
	_nt=array.new<label>()
	for o in _et
		if not na(o)and not na(o.lb)
			_nt.push(o.lb)
	_pi=array.new<label>()
	for n in _dj
		_pi.push(n.lb)
	for n in _df
		_pi.push(n.lb)
	_uw=_ea(_nt,false,1)
	_ea(_pi,true,_nt.size()> 0?_uw:1)
