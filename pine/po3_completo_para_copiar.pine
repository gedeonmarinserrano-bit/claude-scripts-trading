[ph1,pl1,tp1]=request.security(syminfo.tickerid,"60",_rk(_rb),lookahead=barmerge.lookahead_on)
_ds(array<Nivel> arr,float _bd,int dir,int _vn,string tf,int _xu,color col)=>
	ln=line.new(_vn,_bd,time,_bd,xloc=xloc.bar_time,color=color.new(col,20),width=1)
	lb=label.new(time,_bd,(dir==1?"Alto ":"Bajo ")+tf,xloc=xloc.bar_time,style=label.style_label_left,color=color.new(color.white,100),textcolor=color.new(col,10),size=size.tiny)
