			nv=math.min(_uc,_tn)
			_do.push(Igual.new(line.new(_qe,nv,bar_index,nv,color=color.new(#6A1B9A,20),style=line.style_dotted,width=1),label.new(_qe,nv,"EQL",style=label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny),nv,-1))
		_tn:=_uc
		_qe:=x
	if _do.size()> 8
		q=_do.shift()
		q.ln.delete()
