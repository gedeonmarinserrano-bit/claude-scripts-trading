		nv=k==0?pdh:k==1?pdl:k==2?_fz:k==3?_gz:k==4?_me:_ne
		_yy=k < 2 or(k < 4?not _bm:not _dk)
		_wc=k%2==0
		if _yy and not na(nv)and not _aa.get(k)and(_wc?high > nv and close < nv:low < nv and close > nv)
			_aa.set(k,true)
