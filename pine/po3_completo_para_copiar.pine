type Nivel
	line ln
	label lb
	float _im
	int dir
var _bd=array.new<Nivel>()
_ts()=>
	[ta.pivothigh(high,_cx,_cx)[1],ta.pivotlow(low,_cx,_cx)[1],time[1+_cx]]
[ph4,pl4,tp4]=request.security(syminfo.tickerid,"240",_ts(),lookahead=barmerge.lookahead_on)
_it(float _im,int dir,int _sp)=>
	ln=line.new(_sp,_im,time,_im,xloc=xloc.bar_time,color=color.new(_dd,20),width=1)
	lb=label.new(time,_im,dir==1?"Alto H4":"Bajo H4",xloc=xloc.bar_time,style=label.style_label_left,color=color.new(color.white,100),textcolor=color.new(_dd,10),size=size.tiny)
	_bd.push(Nivel.new(ln,lb,_im,dir))
