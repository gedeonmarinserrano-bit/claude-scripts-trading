_nd=input.bool(true,"Máximos y mínimos de Asia, Londres y Nueva York (los manipulados quedan en gris)",group=_jm)
_cz="FVG por temporalidad (solo se ven los activados)"
_aq=input.bool(true,"FVG H4",inline="fvgtf1",group=_cz)
_bh=input.bool(true,"FVG H1",inline="fvgtf1",group=_cz)
