_rd=_ku(_qc)
_rf=_ku(_pr)
_wn=str.replace(_rd,"1!","")
_vq=str.replace(_rf,"1!","")
_ty=str.replace(syminfo.ticker,"1!","")
_oq=_dx and _sz and _wn !=_ty
_nn=_dx and _sv and _vq !=_ty
_qy()=>
	w=2*_gf+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pj=na
float _pz=na
int _ru=na
int _ro=na
float _qf=na
float _px=na
