			if uso.get(0)< 440 and _gn.size()< _ll and(_pp==0 or _yo/close*100 <=_pp)
				_mt(z.x1,bar_index+1,z._ai,z._ah,z.dir,z._bi,color.new(c,_ne),t,c,_tg?color.new(color.white,30):na,_ot,_rz)
