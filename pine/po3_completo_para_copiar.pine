			_du:=-1
			_hz=_ms > _ft
			xv=_hz?_qr:bar_index+int(d1?_sf:_ry)
			t1=_fj(_rv,_qg,_hs)
			t2=_fj(_rm,_pn,_im)
			_kz(_hp,_ft,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_iv,true)
		_hp:=_qr
