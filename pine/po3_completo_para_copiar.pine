			else
				q.ln.set_x2(bar_index)
_hg="SMT (divergencias entre índices)"
_dn=input.bool(true,"Mostrar SMT (pide datos de ES/YM: hace el indicador más lento)",group=_hg)
_lu=input.bool(true,"Mostrar etiquetas de la SMT",group=_hg)
_rr=input.bool(true,"Mostrar línea de la SMT",group=_hg)
_to=input.bool(true,"Comparar con",inline="smt1",group=_hg)
_qg=input.symbol("CME_MINI:MES1!","",inline="smt1",group=_hg)
_tm=input.bool(true,"Comparar con",inline="smt2",group=_hg)
_pt=input.symbol("CME_MINI:MNQ1!","",inline="smt2",group=_hg)
_gf=input.int(5,"Sensibilidad pivotes SMT (velas a cada lado)",minval=2,maxval=20,group=_hg)
_qd=input.int(60,"Máx. velas entre los dos altos/bajos comparados",minval=5,maxval=400,group=_hg)
_sa=input.int(20,"Máx. SMT en el gráfico",minval=1,maxval=60,group=_hg)
_ia=input.color(#ff1100,"SMT bajista (en altos)",group=_hg)
_it=input.color(#2157f3,"SMT alcista (en bajos)",group=_hg)
_kg(string s)=>
	_uh=str.split(s,":")
	_uh.size()> 0?_uh.last():s
_sj=_kg(_qg)
_so=_kg(_pt)
_xi=str.replace(_sj,"1!","")
_wi=str.replace(_so,"1!","")
_ui=str.replace(syminfo.ticker,"1!","")
_ob=_dn and _to and _xi !=_ui
_on=_dn and _tm and _wi !=_ui
_rz()=>
	w=2*_gf+1
	[ta.highest(high,w),ta.lowest(low,w),ta.highestbars(high,w),ta.lowestbars(low,w)]
float _pz=na
float _qk=na
int _rm=na
int _sm=na
float _qj=na
float _qm=na
int _se=na
int _rk=na
if _ob and _bf
	[h_,l_,hb_,lb_]=request.security(_qg,timeframe.period,_rz(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_pz:=h_
	_qk:=l_
	_rm:=hb_
	_sm:=lb_
if _on and _bf
	[h_,l_,hb_,lb_]=request.security(_pt,timeframe.period,_rz(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
	_qj:=h_
	_qm:=l_
	_se:=hb_
	_rk:=lb_
_mo=ta.pivothigh(high,_gf,_gf)
_mz=ta.pivotlow(low,_gf,_gf)
_ra=bar_index-_gf
var int _hq=na
var float _fy=na
var float _ij=na
var float _jo=na
var int _hn=na
var float _fn=na
var float _jm=na
var float _ig=na
var array<line> _gk=array.new<line>()
var array<label> _gi=array.new<label>()
_dw(float y,float _vo,float c,float _mp,bool _oi)=>
	_vm=_oi?y > _vo:y < _vo
	_uy=_oi?c > _mp:c < _mp
	not na(_vo)and not na(_mp)and not na(c)and _vm !=_uy
_fo(string t,float c,float _mp)=>
	t+(c > _mp?" ↑":c < _mp?" ↓":" =")
_la(int x1,float y1,int xv,string txt,color col,bool _oi)=>
	yv=_oi?high[bar_index-xv]:low[bar_index-xv]
	if _rr
		_gk.push(line.new(x1,y1,xv,yv,color=col))
	if _lu
		_gi.push(label.new(xv,yv,txt,style=_oi?label.style_label_down:label.style_label_up,color=col,textcolor=color.white,size=size.tiny,tooltip="SMT "+(_oi?"bajista":"alcista")+". Flecha = dónde quedó ese índice respecto a su "+(_oi?"alto":"bajo")+" anterior: ↑ más alto, ↓ más bajo, = igual"))
	if _gk.size()> _sa
		_gk.shift().delete()
	if _gi.size()> _sa
		_gi.shift().delete()
var int _cm=na
var int _dv=0
_iq=false
_hx=false
if barstate.isconfirmed
	if not na(_mo)
		_sb=not na(_hq)and _ra-_hq <=_qd
		d1=_sb and _ob and _dw(_mo,_fy,_pz,_ij,true)
		d2=_sb and _on and _dw(_mo,_fy,_qj,_jo,true)
