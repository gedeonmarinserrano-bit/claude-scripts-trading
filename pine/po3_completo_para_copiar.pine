_dh(bool ver,int _vz,array<Zona> f,array<Zona> fi,color ca,color cb,int _ud,string nom)=>
	if ver and not _l and _d !=_vz*60
		_av(fi,_hl,_hl,88,"IFVG "+nom,true,false,_am,false)
		_av(f,ca,cb,_ud,"FVG "+nom,true,_vz >=15,_am,true)
if barstate.islast
	uso.set(0,0)
	uso.set(1,0)
	uso.set(2,0)
	_fy.clear()
	_gk.clear()
	_af=false
	if _d <=60
		_as()
		_af:=true
	_dh(_cs,1,_xt,_wm,_nl,_mm,84,"M1")
	if not _af and _d <=300
		_as()
		_af:=true
	_dh(_bw,5,_wb,_tp,_nj,_mw,84,"M5")
	if not _af and _d <=900
		_as()
		_af:=true
	_dh(_ax,15,_qw,_ql,_le,_ku,84,"M15")
	if not _af and _d <=3600
		_as()
		_af:=true
	_dh(_bc,60,_qv,_qk,_kl,_kp,82,"H1")
	if not _af and _d <=14400
		_as()
		_af:=true
	_dh(_aq,240,_kq,_mc,_iy,_ig,80,"H4")
	if not _af
		_as()
	if _fy.size()> 0
		_mn=array.new<Letrero>()
		for l in _fy
			x=l.x
			_ry=str.length(l.txt)+2
			for _vl=0 to 3
				_rl=false
				for c in _mn
					_sm=str.length(c.txt)+2
					if math.abs(c.y-l.y)< _fg and x > c.x-_sm and x-_ry < c.x
						x:=c.x-_sm
						_rl:=true
				if not _rl
					break
			_mn.push(Letrero.new(x,l.y,l.txt,l.col,true,l._rv))
			_lr(x,l.y,l.txt,color.white)
	while _el.size()> uso.get(0)
		_el.pop().delete()
	while _df.size()> uso.get(1)
		_df.pop().delete()
	while _bv.size()> uso.get(2)
		_bv.pop().delete()
_qb()=>
	var int t=0
	var float uh=na
	var float ul=na
	ph=ta.pivothigh(high,3,3)
	pl=ta.pivotlow(low,3,3)
	if not na(ph)
		uh:=ph
	if not na(pl)
		ul:=pl
	if not na(uh)and close > uh
		t:=1
		uh:=na
	else if not na(ul)and close < ul
		t:=-1
		ul:=na
	t[1]
_bl(array<Zona> arr,string nom,bool _wi)=>
	float _sx=na
	string txt=""
	for z in arr
		lo=z.dir==1 or na(z._bh)?z._ag:z._bh
		hi=z.dir==-1 or na(z._bh)?z._ah:z._bh
		d=close >=lo and close <=hi?0.0:_wi?(lo > close?lo-close:na):(hi < close?close-hi:na)
		if not na(d)and(na(_sx)or d < _sx)
			_sx:=d
			txt:=nom+(z.dir==1?" alcista":" bajista")
	[_sx,txt]
_qf(table t,int f,string a,string b,color cb,string tam)=>
	t.cell(0,f,a,text_color=#424242,text_size=tam,text_halign=text.align_left)
	t.cell(1,f,b,text_color=cb,text_size=tam,text_halign=text.align_left)
_lj(int b)=>
	b==1?"▲ Alcista":b==-1?"▼ Bajista":"—"
_lx(int b)=>
	b==1?_ad:b==-1?_u:#757575
_xd(float d,string n)=>
	na(d)?"—":d==0?"Precio dentro de "+n:n+" · a "+str.tostring(d,format.mintick)+" pts"
_xl(string n)=>
	str.contains(n,"alcista")?_ad:str.contains(n,"bajista")?_u:#757575
_rq(float h,float l,bool en,bool bh,bool bl)=>
	na(h)?"—":str.tostring(l,format.mintick)+" – "+str.tostring(h,format.mintick)+(en?" (en curso)":bh and bl?" · barridos los dos":bh?" · barrido el alto":bl?" · barrido el bajo":" · sin barrer")
var table _eq=na
if barstate.islast and _lk
