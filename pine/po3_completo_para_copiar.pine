_lh()=>
	[low[1]> high[3],high[1]< low[3],low[1],high[3],high[1],low[3],time[3]]
_vh(int t)=>
	int k=0
	while k < 1500 and time[k]> t
		k+=1
	bar_index-k
_by(array<Zona> arr,float _ah,float _ag,int dir,int _uu,int _we)=>
	if _ah-_ag >=_gp(_we)
		z=Zona.new(_vh(_uu),_ah,_ag,dir)
		if not _eu(z)
			arr.push(z)
			if arr.size()> _gg
				arr.shift()
_bs(array<Zona> arr,array<Zona> _dr)=>
	_xi=false
	if _dr.size()> 0
		for i=_dr.size()-1 to 0
			if _eu(_dr.get(i))
				_dr.remove(i)
	if arr.size()> 0
		for i=arr.size()-1 to 0
			z=arr.get(i)
			_tw=(z._ah+z._ag)/2
			if low <=_tw and high >=_tw
				_xi:=true
			_ix=na(z._bh)and(z.dir==1?(open >=z._ah and close < z._ag):(open <=z._ag and close > z._ah))
			if _ix
				arr.remove(i)
				_dr.push(Zona.new(z.x1,z._ah,z._ag,-z.dir,na,bar_index))
				if _dr.size()> _gg
					_dr.shift()
			else if _eu(z)
				arr.remove(i)
	_xi
