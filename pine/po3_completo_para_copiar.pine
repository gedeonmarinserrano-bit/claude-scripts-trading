			_dy.push(label.new(bar_index,_uz?high:low,"Barrido "+nom,style=_uz?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _dy.size()> 20
				_dy.shift().delete()
type Igual
	line ln
	label lb
	float _dw
	int dir
var array<Igual> _dp=array.new<Igual>()
var float _sx=na
var int _or=na
var float _sc=na
var int _pj=na
_sz=nz(_cz)*0.1
_sv=ta.pivothigh(high,_cb,_cb)
_sd=ta.pivotlow(low,_cb,_cb)
if _rj and _bf and timeframe.isintraday
	if not na(_sv)
