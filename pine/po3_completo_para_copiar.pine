		_ut=(na(_vz)?"↑ —":"↑ "+_wi+" "+str.tostring(_vz,format.mintick)+" (+"+str.tostring(_vz-close,format.mintick)+")")+"  ·  "+(na(_wc)?"↓ —":"↓ "+_xd+" "+str.tostring(_wc,format.mintick)+" (−"+str.tostring(close-_wc,format.mintick)+")")
		_qh(_ej,f,"Liquidez",_ut,#424242,tam)
