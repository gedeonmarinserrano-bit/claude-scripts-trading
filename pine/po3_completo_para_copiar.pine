			_ek.push(label.new(bar_index,_wp?high:low,"Barrido "+nom,style=_wp?label.style_label_down:label.style_label_up,color=color.new(color.white,100),textcolor=#6A1B9A,size=size.tiny))
			if _ek.size()> 20
				_ek.shift().delete()
type Igual
	line ln
