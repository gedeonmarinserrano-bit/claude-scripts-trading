plot(_tn?pdh:na,"Alto día anterior",color=color.new(_dr,30),style=plot.style_linebr,linewidth=1)
plot(_tn?pdl:na,"Bajo día anterior",color=color.new(_dr,30),style=plot.style_linebr,linewidth=1)
