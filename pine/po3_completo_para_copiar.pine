	if _ax and not _m and _ju < 3600
		_jx:=_bl(_ph,_ok)
		if _rp
			[a60,b60,_sg,_sm,_tg,_so,t60]=request.security(syminfo.tickerid,"60",_lb(),lookahead=barmerge.lookahead_on)
			if a60
