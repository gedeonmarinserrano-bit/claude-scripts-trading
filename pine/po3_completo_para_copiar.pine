			_wt:=t1
		if not na(d2)and(na(_sv)or d2 < _sv)
			_sv:=d2
			_wt:=t2
		if not na(d3)and(na(_su)or d3 < _su)
			_su:=d3
			_wp:=t3
		if not na(d4)and(na(_su)or d4 < _su)
			_su:=d4
			_wp:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_xw:k==1?_wa:k==2?_qq:k==3?_qt:_kj
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cq:k==1?_bv:k==2?_az:k==3?_aw:_ap
			if ver
				[da,ta_]=_bj(arr,nom,true)
				[db,tb]=_bj(arr,nom,false)
				if not na(da)and(na(_sv)or da < _sv)
					_sv:=da
					_wt:=ta_
				if not na(db)and(na(_su)or db < _su)
					_su:=db
					_wp:=tb
	_qk(_ef,f,"FVG por arriba",_wn(_sv,_wt),_xl(_wt),tam)
	f+=1
	_qk(_ef,f,"FVG por abajo",_wn(_su,_wp),_xl(_wp),tam)
	f+=1
	_um=not _dw?"(apagada)":na(_cn)?"Ninguna reciente":(_ds==1?"▲ Alcista":"▼ Bajista")+" hace "+str.tostring(bar_index-_cn)+" velas"
	_qk(_ef,f,"SMT",_um,not _dw or na(_cn)?#757575:_ds==1?_jf:_hw,tam)
