		_ib:=_px
		_jl:=_qh
	if not na(_nm)
		_rr=not na(_hm)and _qt-_hm <=_qg
		d1=_rr and _pg and _dv(_nm,_fw,_pl,_hw,false)
		d2=_rr and _nz and _dv(_nm,_fw,_pp,_ig,false)
		if d1 or d2
			_ip:=true
			_ck:=bar_index
			_dq:=1
			_jc=_nm < _fw
			xv=_jc?_qt:bar_index+int(d1?_ru:_sl)
			t1=_fo(_sr,_pl,_hw)
			t2=_fo(_ry,_pp,_ig)
			_kk(_hm,_fw,xv,d1 and d2?t1+" | "+t2:d1?t1:t2,_id,false)
		_hm:=_qt
		_fw:=_nm
		_hw:=_pl
