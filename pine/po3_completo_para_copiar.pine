_mm=input.bool(false,"Usar solo el cuerpo de la vela (sin mechas)",group=_vc)
_xe=input.int(25,"Máx. Order Blocks vigentes",minval=1,maxval=60,group=_vc)
_mz=input.int(1,"El imbalance (FVG) debe empezar en las N velas siguientes al OB",minval=1,maxval=5,group=_vc)
_km=input.color(#1565C0,"OB alcista (demanda)",group=_vc)
_kr=input.color(#EF6C00,"OB bajista (oferta)",group=_vc)
_pk="Estrategia NY (Bias + PO3)"
