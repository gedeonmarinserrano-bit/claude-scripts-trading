			_wu:=t4
	if not _m
		for k=0 to 4
			arr=k==0?_xz:k==1?_wb:k==2?_qp:k==3?_re:_kv
			nom=k==0?"FVG M1":k==1?"FVG M5":k==2?"FVG M15":k==3?"FVG H1":"FVG H4"
			ver=k==0?_cu:k==1?_by:k==2?_bb:k==3?_ba:_ar
			if ver
				[da,ta_]=_bm(arr,nom,true)
				[db,tb]=_bm(arr,nom,false)
