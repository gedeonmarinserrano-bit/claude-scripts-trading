type EstadoLTF
	float h2
	float l2
	float h1
	float l1
	int n=0
_gs(Zona z,float hi,float lo)=>
	_fu=z.dir==1?lo <=z._ai:hi >=z._ah
	if not _fu
		_bi=na(z._bi)?(z.dir==1?z._ah:z._ai):z._bi
		if z.dir==1?lo < _bi:hi > _bi
			z._bi:=z.dir==1?lo:hi
	_fu
_bx(array<Zona> fvg,array<Zona> _ua,EstadoLTF s,array<float> ao,array<float> ah,array<float> al,array<float> ac,int _xo,float _sn)=>
	_uf=false
	if ah.size()> 0
		_fc=barstate.isconfirmed?ah.size()-1:ah.size()-2
		for k=0 to ah.size()-1
			o1=ao.get(k)
			h1=ah.get(k)
			l1=al.get(k)
			c1=ac.get(k)
			for z in _ua
				n=s.n-z._su
				if not z._md and n >=1 and n <=_gr and h1 >=z._ai and l1 <=z._ah
					if k <=_fc
						z._md:=true
					_uf:=true
			if k <=_fc
				if _ua.size()> 0
					for i=_ua.size()-1 to 0
						if _gs(_ua.get(i),h1,l1)
							_ua.remove(i)
				if fvg.size()> 0
					for i=fvg.size()-1 to 0
						z=fvg.get(i)
						inv=na(z._bi)and(z.dir==1?(o1 >=z._ah and c1 < z._ai):(o1 <=z._ai and c1 > z._ah))
						if inv
							fvg.remove(i)
							_ua.push(Zona.new(z.x1,z._ah,z._ai,-z.dir,na,s.n))
							if _ua.size()> _xo
								_ua.shift()
						else if _gs(z,h1,l1)
							fvg.remove(i)
				if not na(s.h2)
					if l1 > s.h2 and l1-s.h2 >=_sn
						fvg.push(Zona.new(bar_index,l1,s.h2,1))
					else if h1 < s.l2 and s.l2-h1 >=_sn
						fvg.push(Zona.new(bar_index,s.l2,h1,-1))
					if fvg.size()> _xo
						fvg.shift()
				s.h2:=s.h1
				s.l2:=s.l1
				s.h1:=h1
				s.l1:=l1
				s.n:=s.n+1
	_uf
