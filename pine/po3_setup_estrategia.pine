// Po3 Setup NY (estrategia)
// Señal de confluencia de la estrategia Bias + PO3 en la apertura de Nueva York, como estrategia de
// TradingView para poder medirla en el Probador de estrategias. Es un script aparte: no depende del
// indicador "Po3 + CHoCH PRO" ni lo modifica.
//
// Compra (la venta es el espejo):
//   1. Bias: H1 alcista y H4 que no vaya en contra.
//   2. Horario: por defecto todo el horario de mercado; opcionalmente solo la apertura de Nueva York
//      (09:30-11:00 NY = 15:30-17:00 Madrid).
//   3. Manipulación: barrido de un bajo relevante (día anterior, semana anterior, Asia, Londres o
//      Nueva York ya cerradas, bajos iguales, último bajo de H1 o H4) o toque del 50 % de un FVG
//      alcista de M15 o H1. Las sesiones son las mismas que en el indicador (Asia 18:00-02:00,
//      Londres 02:00-09:30 y Nueva York 09:30-16:00, hora de Nueva York).
//   4. Confirmación: CHoCH alcista después de la manipulación que no falla en la vela siguiente.
//   5. Filtros: precio en descuento y rango del día por debajo del ATR diario (y opcionalmente del
//      movimiento esperado VIX/16).
//   Nunca se opera dentro de un rango (caja lateral recordada o Choppiness alto): ni señales ni órdenes
//   pendientes; solo se vuelve a operar cuando una vela cierra fuera de la caja con margen.
//   6. Punto extra: SMT alcista con MES (o el índice que se elija).
// Entrada en el FVG que deja el impulso (orden límite), SL bajo el mínimo de la manipulación y TP en la
// siguiente liquidez por arriba con un riesgo/beneficio mínimo. Todo se calcula con velas cerradas.
// Segunda entrada (opcional): FVG respetado. Cuando el precio vuelve a un FVG del gráfico por primera
// vez, mete la mecha dentro y la vela cierra fuera, a favor del FVG, se entra a mercado con el SL bajo
// el FVG (compra) o sobre él (venta) y el TP en la siguiente liquidez. Solo a favor del último CHoCH del
// gráfico (opcional). Respeta el bias de H1, los rangos
// y los límites de riesgo igual que el setup.
// Franja sin operar (por defecto 12:00-16:00 Madrid = 06:00-10:00 NY), con botón para quitarla.
// Tras 2 SL seguidos en el mismo día no se opera más hasta el día siguiente (se puede desactivar).
// Riesgo diario: ninguna operación queda abierta al terminar la sesión de Nueva York (16:00 NY = 22:00
// Madrid) y la pérdida del día no puede pasar de 300 $ (no se abre una operación cuyo SL la haría pasar
// del límite y, si se llega a él, se cierra todo y no se opera más ese día).

//@version=6
strategy("Po3 Setup NY (estrategia)", shorttitle="Po3 Setup", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.5, slippage=1, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false, max_labels_count=500, max_lines_count=500)

// ─────────────────────────────
// AJUSTES
// ─────────────────────────────
g_s        = "Señal"
dir_op     = input.string("Compras y ventas", "Operar", options=["Compras y ventas", "Solo compras", "Solo ventas"], group=g_s)
horario    = input.string("Todo el horario de mercado", "Horario de las señales", options=["Todo el horario de mercado", "Solo apertura de Nueva York (15:30-17:00 Madrid)"], group=g_s)
bloq_on    = input.bool(true, "No abrir operaciones de", group=g_s, inline="bloq")
bloq_h     = input.session("0600-1000", "", group=g_s, inline="bloq", tooltip="Hora de Nueva York. Por defecto 06:00-10:00 NY = 12:00-16:00 Madrid: mediodía de Londres, datos de las 14:30 y primera media hora de NY. En la prueba de 130 operaciones esa franja perdió 1.091 $ en 26 operaciones. Las operaciones ya abiertas siguen con su gestión; las órdenes pendientes se cancelan.")
punt_min   = input.int(5, "Puntuación mínima (de 6)", minval=4, maxval=6, group=g_s, tooltip="Bias, horario, manipulación y CHoCH son siempre obligatorios (4 puntos; con todo el horario de mercado, el horario se cumple siempre). Los filtros y la SMT suman uno cada uno. Dentro de un rango nunca hay señal.")
piv_len    = input.int(3, "Sensibilidad de los pivotes (velas a cada lado)", minval=2, maxval=10, group=g_s)
vent_manip = input.int(20, "Velas máximas entre la manipulación y el CHoCH", minval=3, maxval=60, group=g_s)
min_rr     = input.float(1.5, "Riesgo/beneficio mínimo", minval=0.5, step=0.1, group=g_s)
sl_buf     = input.float(0.1, "Margen del SL más allá de la manipulación (× ATR)", minval=0, step=0.05, group=g_s)
vence_lim  = input.int(10, "Velas para que el precio vuelva a la entrada (si no, se cancela)", minval=1, maxval=50, group=g_s)
max_dia    = input.int(2, "Máx. operaciones por día", minval=1, maxval=10, group=g_s)

// Gestión del riesgo: limitar las pérdidas grandes
g_rg       = "Gestión del riesgo"
max_sl_atr = input.float(0, "SL máximo (× ATR): si el SL queda más lejos no se opera (0 = sin límite)", minval=0, step=0.25, group=g_rg)
max_sl_pts = input.float(0, "SL máximo en puntos (0 = sin límite)", minval=0, step=1, group=g_rg)
tp_max_r   = input.float(0, "TP máximo (R): si la liquidez está más lejos, el TP se pone aquí (0 = sin límite)", minval=0, step=0.5, group=g_rg)
be_r       = input.float(1.0, "Mover el SL a la entrada (break even) al ir ganando … R (0 = no)", minval=0, step=0.25, group=g_rg)
max_velas_op = input.int(0, "Cerrar la operación tras … velas abierta (0 = no)", minval=0, maxval=500, group=g_rg)
cerrar_ses = input.bool(true, "No dejar nada abierto al terminar la sesión de Nueva York (16:00 NY = 22:00 Madrid)", group=g_rg, tooltip="En la última vela antes de las 16:00 NY se cierra la operación abierta y se cancela la orden pendiente. Esa vela ya no da señales.")
parar_sl   = input.bool(true, "Dejar de operar hasta el día siguiente tras varios SL seguidos", group=g_rg, inline="psl")
n_sl_seg   = input.int(2, "SL seguidos", minval=1, maxval=10, group=g_rg, inline="psl", tooltip="Cuenta solo las operaciones que terminan en su SL. Una operación ganadora o cerrada en break even corta la racha. Al empezar el día (18:00 NY) la cuenta vuelve a cero.")
max_perd_dia = input.float(300, "Pérdida máxima por día ($, 0 = sin límite)", minval=0, step=25, group=g_rg, tooltip="Cuenta lo perdido hoy (operaciones cerradas y la abierta). No se abre una operación si su SL, con comisiones y deslizamiento, haría pasar la pérdida del día de este límite. Si aun así se llega al límite (hueco de precio), se cierra todo y no se opera más ese día.")

g_f        = "Filtros (suman un punto si se cumplen todos los activados)"
usar_h4    = input.bool(true, "H4 no puede ir en contra", group=g_f)
usar_desc  = input.bool(true, "Comprar en descuento y vender en premium", group=g_f)
usar_atr   = input.bool(true, "El rango de hoy no ha pasado el ATR diario", group=g_f)
usar_vix   = input.bool(false, "El rango de hoy no ha pasado el movimiento esperado (VIX / 16)", group=g_f)
vix_sym    = input.symbol("CBOE:VIX", "Índice de volatilidad (para el Nasdaq también vale CBOE:VXN)", group=g_f)

g_r        = "Rangos"
usar_rango  = input.bool(true, "No operar dentro de un rango", group=g_r, tooltip="Activado: dentro de un rango no hay señales y se cancelan las órdenes pendientes. Desactivado: los rangos no se tienen en cuenta.")
rango_velas = input.int(30, "Velas que se miran para detectar el rango", minval=10, maxval=200, group=g_r)
rango_atr   = input.float(3.0, "Es rango si su altura no pasa de (× ATR)", minval=1.0, step=0.5, group=g_r)
rango_rot   = input.int(4, "Y el precio cruza su mitad al menos (veces)", minval=2, maxval=20, group=g_r)
rango_marg  = input.float(0.5, "Para salir del rango hay que cerrar fuera de la caja al menos (× ATR)", minval=0, step=0.25, group=g_r, tooltip="Una vez detectado, el rango se recuerda (su caja crece si el precio sigue lateral) y no se opera hasta que una vela cierra fuera de la caja con este margen. Así no se entra en las falsas rupturas del borde.")
usar_chop   = input.bool(true, "También es rango si el Choppiness Index pasa del límite", group=g_r, inline="chop")
chop_lim    = input.float(61.8, "", minval=40, maxval=80, step=0.1, group=g_r, inline="chop", tooltip="Choppiness Index de 14 velas: por encima de 61,8 el mercado va lateral; por debajo de 38,2 tiene tendencia.")

g_m        = "Manipulación válida"
usar_pd    = input.bool(true, "Barrido del alto/bajo del día anterior", group=g_m)
usar_ses   = input.bool(true, "Barrido del alto/bajo de Asia, Londres y Nueva York (sesión ya cerrada)", group=g_m)
usar_sem   = input.bool(true, "Barrido del alto/bajo de la semana anterior", group=g_m)
usar_htf   = input.bool(true, "Barrido del último alto/bajo relevante de H1 y H4", group=g_m)
// Mismas sesiones que el indicador (hora de Nueva York, seguidas, sin huecos)
ses_asia_h = input.session("1800-0200", "Sesión de Asia (hora de Nueva York)", group=g_m)
ses_lon_h  = input.session("0200-0930", "Sesión de Londres (hora de Nueva York)", group=g_m)
ses_ny_h   = input.session("0930-1600", "Sesión de Nueva York (hora de Nueva York)", group=g_m)
usar_eq    = input.bool(true, "Barrido de altos/bajos iguales (EQH / EQL)", group=g_m)
usar_fvg50 = input.bool(true, "Toque del 50 % de un FVG de M15 o H1", group=g_m)

g_fr       = "Entrada por FVG respetado"
usar_fr    = input.bool(true, "Entrar cuando un FVG se respeta", group=g_fr, tooltip="Primer regreso del precio a un FVG del gráfico: la mecha entra en el hueco y la vela cierra fuera, a favor del FVG (sin cerrar dentro ni al otro lado). Entrada a mercado, SL al otro lado del FVG y TP en la siguiente liquidez.")
fr_bias    = input.bool(true, "Solo a favor del bias de H1 (y que H4 no vaya en contra)", group=g_fr)
fr_estr    = input.bool(true, "Solo a favor de la estructura del gráfico (último CHoCH)", group=g_fr, tooltip="El bias de H1 tarda en girar. Si en el gráfico ya hay un CHoCH alcista (el precio ha roto estructura al alza), no se vende en FVG bajistas aunque H1 siga bajista, y al revés con las compras.")
fr_min_atr = input.float(0.15, "Tamaño mínimo del FVG (× ATR)", minval=0, step=0.05, group=g_fr)
fr_vida    = input.int(100, "El FVG deja de valer tras … velas", minval=5, maxval=500, group=g_fr)

g_smt      = "SMT (punto extra)"
usar_smt   = input.bool(true, "Sumar un punto si hay SMT con el otro índice", group=g_smt)
smt_sym    = input.symbol("CME_MINI:MES1!", "Comparar con", group=g_smt)

g_v        = "Visual"
col_c      = input.color(#00A651, "Compra", group=g_v)
col_v      = input.color(#E4002B, "Venta", group=g_v)
ver_lineas = input.bool(true, "Dibujar entrada, SL y TP de cada señal", group=g_v)
sep_etq    = input.float(2.0, "Separación de la etiqueta respecto a las velas (× ATR)", minval=0.5, step=0.5, group=g_v)

// ─────────────────────────────
// DATOS BASE
// ─────────────────────────────
tz        = "America/New_York"
atr       = ta.atr(14)
operable  = timeframe.isintraday and timeframe.in_seconds() <= 900   // M1 a M15
cerrada   = barstate.isconfirmed
min_ny    = hour(time, tz) * 60 + minute(time, tz)
en_ny     = min_ny >= 570 and min_ny < 660          // 09:30-11:00 NY
// Horario válido para las señales: cualquier vela con mercado abierto, o solo la apertura de NY
en_horario = horario == "Todo el horario de mercado" ? true : en_ny
en_asia   = not na(time(timeframe.period, ses_asia_h, tz))
en_lon    = not na(time(timeframe.period, ses_lon_h, tz))
en_nys    = not na(time(timeframe.period, ses_ny_h, tz))
nuevo_dia = timeframe.change("D")
en_bloq   = bloq_on and not na(time(timeframe.period, bloq_h, tz))
// Última vela de la sesión de Nueva York: la que termina a las 16:00 NY o después
min_ny_fin = hour(time_close, tz) * 60 + minute(time_close, tz)
fin_ny    = min_ny < 960 and (min_ny_fin >= 960 or min_ny_fin < min_ny)

// Pérdida máxima por día: la propia de TradingView cierra todo y para el día si se llega al límite
strategy.risk.max_intraday_loss(max_perd_dia > 0 ? max_perd_dia : 1e12, strategy.cash, "Pérdida máxima del día")
// Resultado de hoy (cerradas y abierta), para no abrir operaciones que puedan pasar del límite
var float neto_ini_dia = 0.0
if nuevo_dia
    neto_ini_dia := strategy.netprofit
cts = strategy.default_entry_qty(close)   // contratos por operación (los de Propiedades)
res_hoy = strategy.netprofit - neto_ini_dia + strategy.openprofit
// Lo que costaría en $ que saltara el SL: puntos × valor del punto × contratos, más comisión y
// deslizamiento de entrada y salida
coste_sl(float riesgo) =>
    riesgo * syminfo.pointvalue * cts + 2 * 0.5 * cts + 2 * syminfo.mintick * syminfo.pointvalue * cts
cabe_riesgo(float riesgo) =>
    max_perd_dia == 0 or -math.min(res_hoy, 0) + coste_sl(riesgo) <= max_perd_dia

// Bias de una temporalidad superior: dirección de la última ruptura de estructura, con su vela ya
// cerrada (no repinta)
bias_htf() =>
    var int t = 0
    var float uh = na
    var float ul = na
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    if not na(ph)
        uh := ph
    if not na(pl)
        ul := pl
    if not na(uh) and close > uh
        t := 1
        uh := na
    else if not na(ul) and close < ul
        t := -1
        ul := na
    t[1]
b4 = request.security(syminfo.tickerid, "240", bias_htf(), lookahead=barmerge.lookahead_on)
b1 = request.security(syminfo.tickerid, "60", bias_htf(), lookahead=barmerge.lookahead_on)

// Día anterior y día actual
[pdh, pdl, pdc, d_open, d_atr] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open, ta.atr(14)[1]], lookahead=barmerge.lookahead_on)
var float dh = na
var float dl = na
if nuevo_dia
    dh := high
    dl := low
else
    dh := math.max(nz(dh, high), high)
    dl := math.min(nz(dl, low), low)
float vix_ant = na
if usar_vix
    vix_ant := request.security(vix_sym, "D", close[1], lookahead=barmerge.lookahead_on)

// Rangos de Asia y Londres (solo cuentan como nivel cuando la sesión ya ha terminado)
var float asia_h = na
var float asia_l = na
var float lon_h  = na
var float lon_l  = na
if en_asia
    asia_h := en_asia[1] ? math.max(asia_h, high) : high
    asia_l := en_asia[1] ? math.min(asia_l, low) : low
if en_lon
    lon_h := en_lon[1] ? math.max(lon_h, high) : high
    lon_l := en_lon[1] ? math.min(lon_l, low) : low
var float ny_h = na
var float ny_l = na
if en_nys
    ny_h := en_nys[1] ? math.max(ny_h, high) : high
    ny_l := en_nys[1] ? math.min(ny_l, low) : low
// Al empezar el día (18:00 NY) los rangos de sesión son los del día nuevo
if nuevo_dia
    lon_h := na
    lon_l := na
    ny_h  := na
    ny_l  := na
asia_hv = en_asia ? na : asia_h
asia_lv = en_asia ? na : asia_l
lon_hv  = en_lon ? na : lon_h
lon_lv  = en_lon ? na : lon_l
ny_hv   = en_nys ? na : ny_h
ny_lv   = en_nys ? na : ny_l

// Semana anterior y último alto/bajo relevante (pivote de 3 velas) de H1 y H4, con su vela cerrada
float pwh = na
float pwl = na
if usar_sem
    [a_w, b_w] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
    pwh := a_w
    pwl := b_w
piv_ult() =>
    ph_ = ta.pivothigh(high, 3, 3)
    pl_ = ta.pivotlow(low, 3, 3)
    [ta.valuewhen(not na(ph_), ph_, 0)[1], ta.valuewhen(not na(pl_), pl_, 0)[1]]
float h1_ph = na
float h1_pl = na
float h4_ph = na
float h4_pl = na
if usar_htf
    [a1, b1_] = request.security(syminfo.tickerid, "60", piv_ult(), lookahead=barmerge.lookahead_on)
    [a4, b4_] = request.security(syminfo.tickerid, "240", piv_ult(), lookahead=barmerge.lookahead_on)
    h1_ph := a1
    h1_pl := b1_
    h4_ph := a4
    h4_pl := b4_

// Último FVG alcista y bajista sin rellenar de una temporalidad superior (vela cerrada)
fvg_ult() =>
    var float bt = na
    var float bb = na
    var float st = na
    var float sb = na
    if not na(bb) and low <= bb
        bt := na
        bb := na
    if not na(st) and high >= st
        st := na
        sb := na
    if low > high[2]
        bt := low
        bb := high[2]
    if high < low[2]
        st := low[2]
        sb := high
    [bt[1], bb[1], st[1], sb[1]]
[m15_bt, m15_bb, m15_st, m15_sb] = request.security(syminfo.tickerid, "15", fvg_ult(), lookahead=barmerge.lookahead_on)
[h1_bt, h1_bb, h1_st, h1_sb] = request.security(syminfo.tickerid, "60", fvg_ult(), lookahead=barmerge.lookahead_on)

// FVG del gráfico para la entrada por FVG respetado: se guardan los que siguen sin tocar
var array<float> fa_top = array.new<float>()
var array<float> fa_bot = array.new<float>()
var array<int>   fa_bar = array.new<int>()
var array<float> fb_top = array.new<float>()
var array<float> fb_bot = array.new<float>()
var array<int>   fb_bar = array.new<int>()
bool  fr_c = false
bool  fr_v = false
float fr_c_bot = na
float fr_v_top = na
if usar_fr and cerrada
    // Alcistas: si el precio vuelve por primera vez, el FVG se respeta (cierra por encima) o se
    // descarta (cierra dentro o por debajo); también caduca tras fr_vida velas
    for i = fa_top.size() - 1 to 0
        if fa_top.size() == 0
            break
        t_ = fa_top.get(i)
        b_ = fa_bot.get(i)
        if low <= t_
            if close > t_ and low >= b_ and not fr_c
                fr_c := true
                fr_c_bot := b_
            fa_top.remove(i)
            fa_bot.remove(i)
            fa_bar.remove(i)
        else if bar_index - fa_bar.get(i) > fr_vida
            fa_top.remove(i)
            fa_bot.remove(i)
            fa_bar.remove(i)
    for i = fb_top.size() - 1 to 0
        if fb_top.size() == 0
            break
        t_ = fb_top.get(i)
        b_ = fb_bot.get(i)
        if high >= b_
            if close < b_ and high <= t_ and not fr_v
                fr_v := true
                fr_v_top := t_
            fb_top.remove(i)
            fb_bot.remove(i)
            fb_bar.remove(i)
        else if bar_index - fb_bar.get(i) > fr_vida
            fb_top.remove(i)
            fb_bot.remove(i)
            fb_bar.remove(i)
    // FVG nuevos (la vela actual cierra el hueco de tres velas)
    if low > high[2] and low - high[2] >= fr_min_atr * atr
        fa_top.push(low)
        fa_bot.push(high[2])
        fa_bar.push(bar_index)
        if fa_top.size() > 20
            fa_top.shift()
            fa_bot.shift()
            fa_bar.shift()
    if high < low[2] and low[2] - high >= fr_min_atr * atr
        fb_top.push(low[2])
        fb_bot.push(high)
        fb_bar.push(bar_index)
        if fb_top.size() > 20
            fb_top.shift()
            fb_bot.shift()
            fb_bar.shift()

// ─────────────────────────────
// ESTRUCTURA DEL GRÁFICO: pivotes, CHoCH y altos/bajos iguales
// ─────────────────────────────
ph = ta.pivothigh(high, piv_len, piv_len)
pl = ta.pivotlow(low, piv_len, piv_len)
var float lph = na      // último alto de swing sin romper
var float lpl = na      // último bajo de swing sin romper
var int   tend = 0
var float prev_ph = na
var float prev_pl = na
var float eqh = na
var float eql = na
if not na(ph)
    if not na(prev_ph) and math.abs(ph - prev_ph) <= 0.1 * atr
        eqh := math.max(ph, prev_ph)
    prev_ph := ph
    lph := ph
if not na(pl)
    if not na(prev_pl) and math.abs(pl - prev_pl) <= 0.1 * atr
        eql := math.min(pl, prev_pl)
    prev_pl := pl
    lpl := pl

choch_alc = false
choch_baj = false
float nivel_choch = na
if cerrada and not na(lph) and close > lph
    choch_alc := tend <= 0
    nivel_choch := lph
    tend := 1
    lph := na
else if cerrada and not na(lpl) and close < lpl
    choch_baj := tend >= 0
    nivel_choch := lpl
    tend := -1
    lpl := na

// ─────────────────────────────
// MANIPULACIÓN: barridos de liquidez o toque del 50 % de un FVG de M15/H1
// ─────────────────────────────
barre_bajo(float nv) =>
    not na(nv) and low < nv and close > nv
barre_alto(float nv) =>
    not na(nv) and high > nv and close < nv

string man_c = ""
if cerrada
    if usar_pd and barre_bajo(pdl)
        man_c := "PDL"
    else if usar_ses and barre_bajo(asia_lv)
        man_c := "bajo de Asia"
    else if usar_ses and barre_bajo(lon_lv)
        man_c := "bajo de Londres"
    else if usar_ses and barre_bajo(ny_lv)
        man_c := "bajo de NY"
    else if usar_sem and barre_bajo(pwl)
        man_c := "bajo semana ant."
    else if usar_htf and barre_bajo(h4_pl)
        man_c := "bajo H4"
    else if usar_htf and barre_bajo(h1_pl)
        man_c := "bajo H1"
    else if usar_eq and barre_bajo(eql)
        man_c := "EQL"
    else if usar_fvg50 and not na(m15_bb) and low <= (m15_bt + m15_bb) / 2 and close > m15_bb
        man_c := "50 % FVG M15"
    else if usar_fvg50 and not na(h1_bb) and low <= (h1_bt + h1_bb) / 2 and close > h1_bb
        man_c := "50 % FVG H1"
string man_v = ""
if cerrada
    if usar_pd and barre_alto(pdh)
        man_v := "PDH"
    else if usar_ses and barre_alto(asia_hv)
        man_v := "alto de Asia"
    else if usar_ses and barre_alto(lon_hv)
        man_v := "alto de Londres"
    else if usar_ses and barre_alto(ny_hv)
        man_v := "alto de NY"
    else if usar_sem and barre_alto(pwh)
        man_v := "alto semana ant."
    else if usar_htf and barre_alto(h4_ph)
        man_v := "alto H4"
    else if usar_htf and barre_alto(h1_ph)
        man_v := "alto H1"
    else if usar_eq and barre_alto(eqh)
        man_v := "EQH"
    else if usar_fvg50 and not na(m15_st) and high >= (m15_st + m15_sb) / 2 and close < m15_st
        man_v := "50 % FVG M15"
    else if usar_fvg50 and not na(h1_st) and high >= (h1_st + h1_sb) / 2 and close < h1_st
        man_v := "50 % FVG H1"
// Los altos/bajos iguales dejan de ser liquidez cuando se barren
if not na(eql) and low < eql
    eql := na
if not na(eqh) and high > eqh
    eqh := na

// Última manipulación de cada lado, el extremo alcanzado desde entonces (para el SL) y el último FVG
// que deja el impulso posterior (para la entrada)
var int    mc_bar = na
var float  mc_ext = na
var string mc_txt = ""
var float  mc_fvg = na
var int    mv_bar = na
var float  mv_ext = na
var string mv_txt = ""
var float  mv_fvg = na
if man_c != ""
    mc_bar := bar_index
    mc_ext := low
    mc_txt := man_c
    mc_fvg := na
else if not na(mc_bar)
    mc_ext := math.min(mc_ext, low)
if man_v != ""
    mv_bar := bar_index
    mv_ext := high
    mv_txt := man_v
    mv_fvg := na
else if not na(mv_bar)
    mv_ext := math.max(mv_ext, high)
if cerrada and not na(mc_bar) and bar_index > mc_bar and low > high[2]
    mc_fvg := low
if cerrada and not na(mv_bar) and bar_index > mv_bar and high < low[2]
    mv_fvg := high

// ─────────────────────────────
// SMT con el otro índice (punto extra)
// ─────────────────────────────
var int smt_c_bar = na
var int smt_v_bar = na
if usar_smt
    [o_l, o_h] = request.security(smt_sym, timeframe.period, [ta.lowest(low, 2 * piv_len + 1), ta.highest(high, 2 * piv_len + 1)], gaps=barmerge.gaps_off)
    var float ant_pl = na
    var float ant_ol = na
    var float ant_ph = na
    var float ant_oh = na
    if not na(pl)
        if not na(ant_pl) and not na(o_l) and not na(ant_ol) and (pl < ant_pl) != (o_l < ant_ol)
            smt_c_bar := bar_index
        ant_pl := pl
        ant_ol := o_l
    if not na(ph)
        if not na(ant_ph) and not na(o_h) and not na(ant_oh) and (ph > ant_ph) != (o_h > ant_oh)
            smt_v_bar := bar_index
        ant_ph := ph
        ant_oh := o_h

// ─────────────────────────────
// CONFIRMACIÓN: el CHoCH no puede fallar en la vela siguiente
// ─────────────────────────────
var int   pc_bar = na
var float pc_lvl = na
var int   pv_bar = na
var float pv_lvl = na
conf_c = false
conf_v = false
if cerrada and not na(pc_bar) and bar_index == pc_bar + 1
    conf_c := close > pc_lvl
    pc_bar := na
if cerrada and not na(pv_bar) and bar_index == pv_bar + 1
    conf_v := close < pv_lvl
    pv_bar := na
if choch_alc and not na(mc_bar) and bar_index - mc_bar <= vent_manip
    pc_bar := bar_index
    pc_lvl := nivel_choch
if choch_baj and not na(mv_bar) and bar_index - mv_bar <= vent_manip
    pv_bar := bar_index
    pv_lvl := nivel_choch

// ─────────────────────────────
// PUNTUACIÓN Y SEÑAL
// ─────────────────────────────
var int ops_hoy = 0
if nuevo_dia
    ops_hoy := 0

// SL seguidos de hoy: se revisan las operaciones que se acaban de cerrar
var int sl_seg = 0
var int n_cerr = 0
if nuevo_dia
    sl_seg := 0
if strategy.closedtrades > n_cerr
    for i = n_cerr to strategy.closedtrades - 1
        sl_seg := strategy.closedtrades.exit_comment(i) == "SL" ? sl_seg + 1 : 0
    n_cerr := strategy.closedtrades
parado_sl = parar_sl and sl_seg >= n_sl_seg

rango_hoy = dh - dl
// Rango: las últimas velas (sin contar la actual) caben en poca altura y el precio rota alrededor de
// su mitad. Mientras la vela actual cierre dentro de esa caja no puede haber señal; al cerrar fuera
// (breakout) vuelve a estar permitida.
r_alto = ta.highest(high, rango_velas)[1]
r_bajo = ta.lowest(low, rango_velas)[1]
r_mid  = (r_alto + r_bajo) / 2
int cruces = 0
for i = 1 to rango_velas - 1
    if (close[i] > r_mid) != (close[i + 1] > r_mid)
        cruces += 1
es_rango = not na(r_alto) and r_alto - r_bajo <= rango_atr * atr and cruces >= rango_rot
// El rango se recuerda: su caja se amplía mientras se siga detectando y solo se sale de él cuando
// una vela cierra fuera con margen (ruptura de verdad)
var float rg_alto = na
var float rg_bajo = na
if es_rango
    solapa = not na(rg_alto) and r_bajo <= rg_alto and r_alto >= rg_bajo
    rg_alto := solapa ? math.max(rg_alto, r_alto) : r_alto
    rg_bajo := solapa ? math.min(rg_bajo, r_bajo) : r_bajo
if not na(rg_alto) and (close > rg_alto + rango_marg * atr or close < rg_bajo - rango_marg * atr)
    rg_alto := na
    rg_bajo := na
// Choppiness Index: mide si el precio se mueve lateral (alto) o con tendencia (bajo)
chop = 100 * math.log10(math.sum(ta.atr(1), 14) / (ta.highest(high, 14) - ta.lowest(low, 14))) / math.log10(14)
dentro_rango = usar_rango and (not na(rg_alto) or (usar_chop and chop > chop_lim))
mitad_ant = (pdh + pdl) / 2
filtros_comunes = (not usar_atr or na(d_atr) or rango_hoy < d_atr) and (not usar_vix or na(vix_ant) or rango_hoy < pdc * vix_ant / 16 / 100)
filtros_c = filtros_comunes and (not usar_desc or close < mitad_ant or close < d_open)
filtros_v = filtros_comunes and (not usar_desc or close > mitad_ant or close > d_open)
bias_c = b1 == 1 and (not usar_h4 or b4 != -1)
bias_v = b1 == -1 and (not usar_h4 or b4 != 1)
smt_c  = usar_smt and not na(smt_c_bar) and bar_index - smt_c_bar <= vent_manip + piv_len
smt_v  = usar_smt and not na(smt_v_bar) and bar_index - smt_v_bar <= vent_manip + piv_len
man_ok_c = not na(mc_bar) and bar_index - mc_bar <= vent_manip + 1
man_ok_v = not na(mv_bar) and bar_index - mv_bar <= vent_manip + 1

punt_c = (bias_c ? 1 : 0) + (en_horario ? 1 : 0) + (man_ok_c ? 1 : 0) + (conf_c ? 1 : 0) + (filtros_c ? 1 : 0) + (smt_c ? 1 : 0)
punt_v = (bias_v ? 1 : 0) + (en_horario ? 1 : 0) + (man_ok_v ? 1 : 0) + (conf_v ? 1 : 0) + (filtros_v ? 1 : 0) + (smt_v ? 1 : 0)
puede  = operable and cerrada and strategy.position_size == 0 and ops_hoy < max_dia and not dentro_rango and not (cerrar_ses and fin_ny) and not parado_sl and not en_bloq
senal_c = puede and dir_op != "Solo ventas" and bias_c and en_horario and man_ok_c and conf_c and punt_c >= punt_min
senal_v = puede and dir_op != "Solo compras" and bias_v and en_horario and man_ok_v and conf_v and punt_v >= punt_min and not senal_c
senal_fc = usar_fr and puede and not senal_c and not senal_v and dir_op != "Solo ventas" and en_horario and fr_c and (not fr_bias or bias_c) and (not fr_estr or tend == 1)
senal_fv = usar_fr and puede and not senal_c and not senal_v and not senal_fc and dir_op != "Solo compras" and en_horario and fr_v and (not fr_bias or bias_v) and (not fr_estr or tend == -1)

// Objetivo: la liquidez más cercana en la dirección de la operación que dé el riesgo/beneficio mínimo;
// si no hay ninguna, 2R
objetivo(float entrada, float riesgo, bool compra) =>
    cands = compra ? array.from(pdh, asia_hv, lon_hv, ny_hv, eqh, dh, pwh, h1_ph, h4_ph) : array.from(pdl, asia_lv, lon_lv, ny_lv, eql, dl, pwl, h1_pl, h4_pl)
    nombres = array.from(compra ? "PDH" : "PDL", compra ? "alto de Asia" : "bajo de Asia", compra ? "alto de Londres" : "bajo de Londres", compra ? "alto de NY" : "bajo de NY", compra ? "EQH" : "EQL", compra ? "alto del día" : "bajo del día", compra ? "alto semana ant." : "bajo semana ant.", compra ? "alto H1" : "bajo H1", compra ? "alto H4" : "bajo H4")
    float mejor = na
    string nom = "2R"
    for i = 0 to cands.size() - 1
        nv = cands.get(i)
        dist = compra ? nv - entrada : entrada - nv
        if not na(nv) and dist >= min_rr * riesgo and (na(mejor) or dist < (compra ? mejor - entrada : entrada - mejor))
            mejor := nv
            nom := nombres.get(i)
    [na(mejor) ? (compra ? entrada + 2 * riesgo : entrada - 2 * riesgo) : mejor, nom]

// Extremos de las últimas velas (se calculan en cada vela para que sean correctos)
bajo10 = ta.lowest(low, 10)
alto10 = ta.highest(high, 10)
var int orden_bar = na
dibujar(bool compra, float ent, float sl, float tp, string txt) =>
    col = compra ? col_c : col_v
    // La etiqueta se saca a una zona limpia: por debajo (compra) o por encima (venta) de las velas de
    // alrededor, separada sep_etq ATR, con una línea fina que la une a la vela de la señal
    extremo = compra ? bajo10 : alto10
    y = compra ? extremo - sep_etq * atr : extremo + sep_etq * atr
    line.new(bar_index, compra ? low : high, bar_index, y, color=color.new(col, 40), style=line.style_dotted)
    label.new(bar_index, y, txt, style=compra ? label.style_label_up : label.style_label_down, color=col, textcolor=color.white, size=size.small)
    if ver_lineas
        line.new(bar_index, ent, bar_index + 20, ent, color=color.new(#1565C0, 0), width=2)
        line.new(bar_index, sl, bar_index + 20, sl, color=color.new(col_v, 0), style=line.style_dashed)
        line.new(bar_index, tp, bar_index + 20, tp, color=color.new(col_c, 0), style=line.style_dashed)

// Datos de la operación en curso, para el break even
var float op_tp = na
var float op_r  = na
var bool  op_be = false

if senal_c
    ent = na(mc_fvg) ? close : math.min(mc_fvg, close)
    sl = mc_ext - sl_buf * atr
    riesgo = ent - sl
    // Sin operación si el SL queda demasiado lejos (las pérdidas grandes vienen de ahí)
    sl_ok = riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
    if sl_ok
        [tp0, tp_nom0] = objetivo(ent, riesgo, true)
        tp = tp_max_r > 0 ? math.min(tp0, ent + tp_max_r * riesgo) : tp0
        tp_nom = tp < tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        rr = (tp - ent) / riesgo
        strategy.entry("Compra", strategy.long, limit=na(mc_fvg) ? na : ent, comment="Setup " + str.tostring(punt_c) + "/6")
        strategy.exit("Salida compra", "Compra", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")
        op_tp := tp
        op_r  := riesgo
        op_be := false
        orden_bar := bar_index
        ops_hoy += 1
        dibujar(true, ent, sl, tp, "▲ SETUP " + str.tostring(punt_c) + "/6\nBarrido " + mc_txt + (smt_c ? " + SMT" : "") + "\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        alert("▲ Setup de compra " + str.tostring(punt_c) + "/6 en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)
        mc_bar := na

if senal_v
    ent = na(mv_fvg) ? close : math.max(mv_fvg, close)
    sl = mv_ext + sl_buf * atr
    riesgo = sl - ent
    sl_ok = riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
    if sl_ok
        [tp0, tp_nom0] = objetivo(ent, riesgo, false)
        tp = tp_max_r > 0 ? math.max(tp0, ent - tp_max_r * riesgo) : tp0
        tp_nom = tp > tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        rr = (ent - tp) / riesgo
        strategy.entry("Venta", strategy.short, limit=na(mv_fvg) ? na : ent, comment="Setup " + str.tostring(punt_v) + "/6")
        strategy.exit("Salida venta", "Venta", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")
        op_tp := tp
        op_r  := riesgo
        op_be := false
        orden_bar := bar_index
        ops_hoy += 1
        dibujar(false, ent, sl, tp, "▼ SETUP " + str.tostring(punt_v) + "/6\nBarrido " + mv_txt + (smt_v ? " + SMT" : "") + "\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        alert("▼ Setup de venta " + str.tostring(punt_v) + "/6 en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)
        mv_bar := na

// Entrada por FVG respetado: a mercado, SL al otro lado del FVG
if senal_fc
    ent = close
    sl = fr_c_bot - sl_buf * atr
    riesgo = ent - sl
    if riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
        [tp0, tp_nom0] = objetivo(ent, riesgo, true)
        tp = tp_max_r > 0 ? math.min(tp0, ent + tp_max_r * riesgo) : tp0
        tp_nom = tp < tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        rr = (tp - ent) / riesgo
        strategy.entry("Compra", strategy.long, comment="FVG respetado")
        strategy.exit("Salida compra", "Compra", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")
        op_tp := tp
        op_r  := riesgo
        op_be := false
        orden_bar := bar_index
        ops_hoy += 1
        dibujar(true, ent, sl, tp, "▲ FVG RESPETADO\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        alert("▲ FVG respetado, compra en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)

if senal_fv
    ent = close
    sl = fr_v_top + sl_buf * atr
    riesgo = sl - ent
    if riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
        [tp0, tp_nom0] = objetivo(ent, riesgo, false)
        tp = tp_max_r > 0 ? math.max(tp0, ent - tp_max_r * riesgo) : tp0
        tp_nom = tp > tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        rr = (ent - tp) / riesgo
        strategy.entry("Venta", strategy.short, comment="FVG respetado")
        strategy.exit("Salida venta", "Venta", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")
        op_tp := tp
        op_r  := riesgo
        op_be := false
        orden_bar := bar_index
        ops_hoy += 1
        dibujar(false, ent, sl, tp, "▼ FVG RESPETADO\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        alert("▼ FVG respetado, venta en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)

// Break even: cuando la operación va ganando be_r veces el riesgo, el SL pasa al precio de entrada.
// Cierre por tiempo: si lleva max_velas_op velas abierta, se cierra.
if strategy.position_size != 0 and cerrada
    largo = strategy.position_size > 0
    entp  = strategy.position_avg_price
    if be_r > 0 and not op_be and not na(op_r) and (largo ? high - entp >= be_r * op_r : entp - low >= be_r * op_r)
        op_be := true
        strategy.exit(largo ? "Salida compra" : "Salida venta", largo ? "Compra" : "Venta", stop=entp, limit=op_tp, comment_loss="BE", comment_profit="TP")
    if max_velas_op > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= max_velas_op
        strategy.close_all(comment="Tiempo máximo")

// Orden límite que no se llena a tiempo, o pendiente cuando el precio entra en rango o en la franja sin
// operar: se cancela
if strategy.position_size == 0 and not na(orden_bar) and (bar_index - orden_bar > vence_lim or ((dentro_rango or en_bloq) and bar_index > orden_bar))
    strategy.cancel("Compra")
    strategy.cancel("Venta")
    orden_bar := na

// Fin de la sesión de Nueva York: en su última vela se cierra lo abierto al cierre de esa misma vela
// (antes de las 16:00) y se cancela la orden límite pendiente, para que nada pase a la noche
if cerrar_ses and fin_ny
    strategy.cancel("Compra")
    strategy.cancel("Venta")
    orden_bar := na
    if strategy.position_size != 0
        strategy.close_all(comment="Cierre fin sesión NY", immediately=true)

// ─────────────────────────────
// Fin del script (si al pegar falta esta línea, el código no se ha copiado entero)
