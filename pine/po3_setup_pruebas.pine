// Po3 Setup NY (pruebas) — copia de "Po3 Setup NY (estrategia)" para hacer pruebas sin tocar la original
// Señal de confluencia de la estrategia Bias + PO3 en la apertura de Nueva York, como estrategia de
// TradingView para poder medirla en el Probador de estrategias. Es un script aparte: no depende del
// indicador "Po3 + CHoCH PRO" ni lo modifica.
//
// Compra (la venta es el espejo):
//   1. Bias: H1 alcista y H4 que no vaya en contra.
//   2. Horario: por defecto todo el horario de mercado; opcionalmente solo la apertura de Nueva York
//      (09:30-11:00 NY = 15:30-17:00 Madrid).
//   3. Manipulación: barrido de un bajo relevante (día anterior, semana anterior, Asia, Londres o
//      Nueva York ya cerradas, bajos iguales, último bajo de H1 o H4) o toque del 50 % de un FVG
//      alcista de M15 o H1. Las sesiones son las mismas que en el indicador (Asia 18:00-02:00,
//      Londres 02:00-09:30 y Nueva York 09:30-16:00, hora de Nueva York).
//   4. Confirmación: CHoCH alcista después de la manipulación que no falla en la vela siguiente.
//   5. Filtros: precio en descuento y rango del día por debajo del ATR diario (y opcionalmente del
//      movimiento esperado VIX/16).
//   Nunca se opera dentro de un rango (caja lateral recordada o Choppiness alto): ni señales ni órdenes
//   pendientes; solo se vuelve a operar cuando una vela cierra fuera de la caja con margen.
//   6. Punto extra: SMT alcista con MES (o el índice que se elija).
// Entrada en el FVG que deja el impulso (orden límite), SL bajo el mínimo de la manipulación y TP en la
// siguiente liquidez por arriba con un riesgo/beneficio mínimo. Todo se calcula con velas cerradas.
// Segunda entrada (opcional): FVG respetado. Cuando el precio vuelve a un FVG del gráfico por primera
// vez, mete la mecha dentro y la vela cierra fuera, a favor del FVG, se entra a mercado con el SL bajo
// el FVG (compra) o sobre él (venta) y el TP en la siguiente liquidez. Solo a favor de la estructura swing
// del gráfico (opcional). Respeta el bias de H1, los rangos
// y los límites de riesgo igual que el setup.
// Franja sin operar (por defecto 12:00-16:00 Madrid = 06:00-10:00 NY), con botón para quitarla.
// Tras 2 SL seguidos en el mismo día no se opera más hasta el día siguiente (se puede desactivar).
// Riesgo diario: ninguna operación queda abierta al terminar la sesión de Nueva York (16:00 NY = 22:00
// Madrid) y la pérdida del día no puede pasar de 300 $ (no se abre una operación cuyo SL la haría pasar
// del límite y, si se llega a él, se cierra todo y no se opera más ese día).

//@version=6
strategy("Po3 Setup NY (pruebas)", shorttitle="Po3 Pruebas", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.5, slippage=1, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false, max_labels_count=500, max_lines_count=500)

// ─────────────────────────────
// AJUSTES
// ─────────────────────────────
g_s        = "Señal"
dir_op     = input.string("Compras y ventas", "Operar", options=["Compras y ventas", "Solo compras", "Solo ventas"], group=g_s)
horario    = input.string("Todo el horario de mercado", "Horario de las señales", options=["Todo el horario de mercado", "Solo apertura de Nueva York (15:30-17:00 Madrid)"], group=g_s)
bloq_on    = input.bool(true, "No abrir operaciones de", group=g_s, inline="bloq")
bloq_h     = input.session("0600-1000", "", group=g_s, inline="bloq", tooltip="Hora de Nueva York. Por defecto 06:00-10:00 NY = 12:00-16:00 Madrid: mediodía de Londres, datos de las 14:30 y primera media hora de NY. En la prueba de 130 operaciones esa franja perdió 1.091 $ en 26 operaciones. Las operaciones ya abiertas siguen con su gestión; las órdenes pendientes se cancelan.")
bloq2_on   = input.bool(true, "Tampoco de", group=g_s, inline="bloq2")
bloq2_h    = input.session("1500-1900", "", group=g_s, inline="bloq2", tooltip="Hora de Nueva York. Por defecto 15:00-19:00 NY = 21:00-01:00 Madrid: no se abren operaciones de noche, después del cierre de NY (lo abierto a las 22:00 ya se cierra con la regla de fin de sesión). Para la tarde de NY (20:00-22:00 Madrid) se puede usar 14:00-16:00.")
bloq3_on   = input.bool(false, "Tampoco de", group=g_s, inline="bloq3")
bloq3_h    = input.session("0200-0300", "", group=g_s, inline="bloq3", tooltip="Hora de Nueva York. 02:00-03:00 NY = 08:00-09:00 Madrid: en la prueba perdió 165 $ en 10 operaciones (40 % de acierto).")
bloq4_on   = input.bool(false, "Tampoco de", group=g_s, inline="bloq4")
bloq4_h    = input.session("1800-1900", "", group=g_s, inline="bloq4", tooltip="Hora de Nueva York. 18:00-19:00 NY = 00:00-01:00 Madrid, apertura de Asia: en la prueba perdió 240 $ en 5 operaciones. Ojo: durante las semanas de cambio de hora de marzo y octubre-noviembre la diferencia con Madrid es de 5 horas, no 6.")
punt_min   = input.int(4, "Puntuación mínima (de 6)", minval=4, maxval=6, group=g_s, tooltip="Bias, horario, manipulación y CHoCH son siempre obligatorios (4 puntos; con todo el horario de mercado, el horario se cumple siempre). Los filtros y la SMT suman uno cada uno. Dentro de un rango nunca hay señal.")
piv_len    = input.int(5, "Sensibilidad de los pivotes (velas a cada lado)", minval=2, maxval=10, group=g_s)
vent_manip = input.int(50, "Velas máximas entre la manipulación y el CHoCH", minval=3, maxval=60, group=g_s)
min_rr     = input.float(1.5, "Riesgo/beneficio mínimo", minval=0.5, step=0.1, group=g_s)
sl_buf     = input.float(0.1, "Margen del SL más allá de la manipulación (× ATR)", minval=0, step=0.05, group=g_s)
vence_lim  = input.int(5, "Velas para que el precio vuelva a la entrada (si no, se cancela)", minval=1, maxval=50, group=g_s)
max_dia    = input.int(11, "Máx. operaciones por día", minval=1, maxval=30, group=g_s, tooltip="Con 'Prioridad al setup' activada, este máximo es solo para las entradas por FVG respetado; el setup tiene su propio cupo.")
prio_setup = input.bool(true, "Prioridad al setup", group=g_s, inline="prio", tooltip="El setup tiene su propio cupo diario (las entradas por FVG no se lo quitan) y, si cuando salta un setup hay abierta una operación de FVG, esta se cierra ('Cede al setup') y se entra en el setup. Mientras una orden del setup espera a llenarse no se abren entradas por FVG.")
max_dia_setup = input.int(10, "Setups por día", minval=1, maxval=30, group=g_s, inline="prio")

// Gestión del riesgo: limitar las pérdidas grandes
g_rg       = "Gestión del riesgo"
max_sl_atr = input.float(0, "SL máximo (× ATR): si el SL queda más lejos no se opera (0 = sin límite)", minval=0, step=0.25, group=g_rg)
max_sl_pts = input.float(0, "SL máximo en puntos (0 = sin límite)", minval=0, step=1, group=g_rg)
tp_max_r   = input.float(3, "TP máximo (R): si la liquidez está más lejos, el TP se pone aquí (0 = sin límite)", minval=0, step=0.5, group=g_rg)
be_r       = input.float(1.0, "Mover el SL a la entrada (break even) al ir ganando … R (0 = no)", minval=0, step=0.25, group=g_rg, tooltip="Para las entradas por FVG respetado. El setup tiene su propio valor justo debajo.")
be_setup   = input.float(0.5, "Break even del setup (R, 0 = no)", minval=0, step=0.1, group=g_rg, tooltip="El SL del setup va detrás del extremo de la manipulación y suele ser más ancho, así que muchas operaciones que acaban en SL llegan antes a ir ganando 0,5-0,8R. Con un valor menor que 1 (por ejemplo 0,7) el SL pasa antes a la entrada.")
be_ticks   = input.int(20, "Break even con beneficio (ticks por encima de la entrada, 0 = en la entrada)", minval=0, maxval=40, group=g_rg, tooltip="Al pasar a break even el SL no se pone justo en la entrada sino unos ticks a favor, para cubrir comisión y deslizamiento y cerrar con una pequeña ganancia. En el MNQ 1 tick = 0,25 puntos = 0,50 $; 8 ticks = 2 puntos = 4 $. Las operaciones que hoy salen en BE con -1,5 $ pasarían a ser pequeñas ganadoras.")
max_velas_op = input.int(0, "Cerrar la operación tras … velas abierta (0 = no)", minval=0, maxval=500, group=g_rg)
cerrar_ses = input.bool(true, "No dejar nada abierto al terminar la sesión de Nueva York (16:00 NY = 22:00 Madrid)", group=g_rg, tooltip="En la última vela antes de las 16:00 NY se cierra la operación abierta y se cancela la orden pendiente. Esa vela ya no da señales.")
min_fin_ny = input.int(30, "No abrir operaciones en los últimos … minutos de NY (0 = no)", minval=0, maxval=120, group=g_rg, tooltip="Por defecto, de 15:30 a 16:00 NY (21:30-22:00 Madrid) no se abren operaciones nuevas: no les da tiempo a desarrollarse y se cierran solas al final de la sesión.")
parar_sl   = input.bool(true, "Dejar de operar hasta el día siguiente tras varios SL seguidos", group=g_rg, inline="psl")
n_sl_seg   = input.int(2, "SL seguidos", minval=1, maxval=10, group=g_rg, inline="psl", tooltip="Cuenta solo las operaciones que terminan en su SL. Una operación ganadora o cerrada en break even corta la racha. Al empezar el día (18:00 NY) la cuenta vuelve a cero.")
fondeo     = input.bool(false, "Evaluación de fondeo: ganancia máxima por día", group=g_rg, inline="fondeo")
max_gan_dia = input.float(425, "$", minval=50, step=25, group=g_rg, inline="fondeo", tooltip="Para las reglas de consistencia de las cuentas de fondeo. El TP de cada operación se acerca lo necesario para que, si se cumple, la ganancia del día (operaciones cerradas, con comisiones) no pase de esta cifra. Cuando a la ganancia del día le quedan menos de 25 $ para el tope, no se abren más operaciones hasta el día siguiente. Las pérdidas no cambian.")
max_perd_dia = input.float(300, "Pérdida máxima por día ($, 0 = sin límite)", minval=0, step=25, group=g_rg, tooltip="Cuenta lo perdido hoy (operaciones cerradas y la abierta). No se abre una operación si su SL, con comisiones y deslizamiento, haría pasar la pérdida del día de este límite. Si aun así se llega al límite (hueco de precio), se cierra todo y no se opera más ese día.")

g_f        = "Filtros (suman un punto si se cumplen todos los activados)"
usar_h4    = input.bool(true, "H4 no puede ir en contra", group=g_f)
usar_desc  = input.bool(true, "Comprar en descuento y vender en premium", group=g_f)
usar_atr   = input.bool(true, "El rango de hoy no ha pasado el ATR diario", group=g_f)
usar_vix   = input.bool(true, "El rango de hoy no ha pasado el movimiento esperado (VIX / 16)", group=g_f)
vix_sym    = input.symbol("CBOE:VIX", "Índice de volatilidad (para el Nasdaq también vale CBOE:VXN)", group=g_f)

g_r        = "Rangos"
usar_rango  = input.bool(false, "No operar dentro de un rango", group=g_r, tooltip="Activado: dentro de un rango no hay señales y se cancelan las órdenes pendientes. Desactivado: los rangos no se tienen en cuenta.")
rango_velas = input.int(30, "Velas que se miran para detectar el rango", minval=10, maxval=200, group=g_r)
rango_atr   = input.float(3.0, "Es rango si su altura no pasa de (× ATR)", minval=1.0, step=0.5, group=g_r)
rango_rot   = input.int(4, "Y el precio cruza su mitad al menos (veces)", minval=2, maxval=20, group=g_r)
rango_marg  = input.float(0.5, "Para salir del rango hay que cerrar fuera de la caja al menos (× ATR)", minval=0, step=0.25, group=g_r, tooltip="Una vez detectado, el rango se recuerda (su caja crece si el precio sigue lateral) y no se opera hasta que una vela cierra fuera de la caja con este margen. Así no se entra en las falsas rupturas del borde.")
usar_chop   = input.bool(true, "También es rango si el Choppiness Index pasa del límite", group=g_r, inline="chop")
chop_lim    = input.float(61.8, "", minval=40, maxval=80, step=0.1, group=g_r, inline="chop", tooltip="Choppiness Index de 14 velas: por encima de 61,8 el mercado va lateral; por debajo de 38,2 tiene tendencia.")
usar_rq     = input.bool(false, "No operar las entradas de FVG dentro del rango del indicador", group=g_r, tooltip="Usa el mismo detector de rangos que dibuja el indicador (la caja de puntos 'RANGE … BARS', Auto Range Detector de QuantAlgo con sus mismos valores). Mientras la caja está activa no se abren entradas por FVG respetado; al romperse se vuelve a operar. Ojo: el indicador alarga la caja hacia atrás al detectarla; la estrategia solo puede saberlo desde que se detecta.")
rq_setup    = input.bool(false, "Aplicarlo también al setup", group=g_r, tooltip="Desactivado por defecto: el setup ya tiene su propia confirmación (manipulación + CHoCH) y este detector lo bloquearía muchas veces.")
rq_base     = input.int(20, "Velas mínimas para buscar un rango (igual que en el indicador)", minval=8, maxval=100, group=g_r)
rq_toques   = input.int(2, "Toques mínimos en cada borde del rango (igual que en el indicador)", minval=1, maxval=10, group=g_r)
rq_min      = input.int(10, "Duración mínima del rango en velas (igual que en el indicador)", minval=2, maxval=200, group=g_r)

g_m        = "Manipulación válida"
usar_pd    = input.bool(true, "Barrido del alto/bajo del día anterior", group=g_m)
usar_ses   = input.bool(true, "Barrido del alto/bajo de Asia, Londres y Nueva York (sesión ya cerrada)", group=g_m)
usar_sem   = input.bool(true, "Barrido del alto/bajo de la semana anterior", group=g_m)
usar_htf   = input.bool(true, "Barrido del último alto/bajo relevante de H1 y H4", group=g_m)
// Mismas sesiones que el indicador (hora de Nueva York, seguidas, sin huecos)
ses_asia_h = input.session("1800-0200", "Sesión de Asia (hora de Nueva York)", group=g_m)
ses_lon_h  = input.session("0200-0930", "Sesión de Londres (hora de Nueva York)", group=g_m)
ses_ny_h   = input.session("0930-1600", "Sesión de Nueva York (hora de Nueva York)", group=g_m)
usar_eq    = input.bool(true, "Barrido de altos/bajos iguales (EQH / EQL)", group=g_m)
usar_fvg50 = input.bool(true, "Toque del 50 % de un FVG de M15 o H1", group=g_m)

g_fr       = "Entrada por FVG respetado"
usar_fr    = input.bool(true, "Entrar cuando un FVG se respeta", group=g_fr, tooltip="Primer regreso del precio a un FVG del gráfico: la mecha entra en el hueco y la vela cierra fuera, a favor del FVG (sin cerrar dentro ni al otro lado). Entrada a mercado, SL al otro lado del FVG y TP en la siguiente liquidez.")
fr_bias    = input.bool(true, "Solo a favor del bias de H1 (y que H4 no vaya en contra)", group=g_fr)
fr_estr    = input.bool(false, "Solo a favor de la estructura swing del gráfico", group=g_fr, inline="estr", tooltip="El bias de H1 tarda en girar. Si en el gráfico el precio ya ha roto un alto de swing (estructura alcista), no se vende en FVG bajistas aunque H1 siga bajista, y al revés con las compras. Se usan pivotes swing (por defecto 10 velas a cada lado), no los internos, para que un pequeño retroceso no cambie la estructura.")
estr_len   = input.int(10, "Velas", minval=3, maxval=30, group=g_fr, inline="estr")
fr_min_atr = input.float(0.15, "Tamaño mínimo del FVG (× ATR)", minval=0, step=0.05, group=g_fr)
fr_vida    = input.int(50, "El FVG deja de valer tras … velas", minval=5, maxval=500, group=g_fr)
fr_conf    = input.bool(false, "Esperar una vela de confirmación", group=g_fr, tooltip="No se entra en la vela que respeta el FVG sino en la siguiente, y solo si esta cierra a favor (por encima del cierre anterior en compras, por debajo en ventas) sin volver a meterse en el FVG. Filtra las entradas que se dan la vuelta al momento y saltan el SL en la misma vela o en la siguiente.")
fr_vol_min = input.float(0.65, "Volumen mínimo de la vela de entrada (× media de 20 velas, 0 = no mirar)", minval=0, step=0.05, group=g_fr, tooltip="En la prueba de M5 (5 oct-27 nov) los FVG respetados con la vela de entrada por debajo de 0,65 veces el volumen medio (V0.5-V0.6 en la lista de operaciones) dieron 11 operaciones, 7 SL y -472 $. Con volumen bajo el rechazo del FVG no tiene fuerza. El número V de cada entrada en la lista de operaciones es este mismo volumen relativo.")

g_imp      = "Entrada por impulso (subidas y bajadas bruscas)"
usar_imp   = input.bool(true, "Entrar en los impulsos", group=g_imp, tooltip="Movimientos bruscos que no son tendencia: una o pocas velas grandes, todas del mismo color, que recorren mucho más que el ATR, cierran cerca de su extremo, con volumen alto y rompiendo el alto o bajo de las últimas velas. Se entra a favor del impulso (por defecto en el retroceso al 50 %), con el SL al otro lado del impulso y el TP a un número fijo de R. No hace falta bias, manipulación ni estructura; sí se respetan las franjas sin operar, los rangos, la pérdida máxima, los SL seguidos y el cupo diario (el mismo que las entradas por FVG).")
imp_n      = input.int(2, "Velas que forman el impulso (como máximo)", minval=1, maxval=4, group=g_imp)
imp_atr    = input.float(1.5, "Recorrido mínimo del impulso (× ATR)", minval=1, step=0.25, group=g_imp)
imp_cierre = input.float(0.3, "La última vela cierra en su … final (0,3 = en el 30 % más cercano al extremo)", minval=0.1, maxval=0.5, step=0.05, group=g_imp)
imp_vol    = input.float(1.2, "Volumen mínimo (× la media de 20 velas, 0 = no mirar)", minval=0, step=0.1, group=g_imp)
imp_rot    = input.int(12, "Tiene que romper el alto/bajo de las últimas … velas (0 = no)", minval=0, maxval=200, group=g_imp)
imp_modo   = input.string("Retroceso", "Entrada", options=["Retroceso", "A mercado"], group=g_imp, inline="impent", tooltip="Retroceso: orden límite en el % del impulso que pongas al lado, medido desde su cierre (30 % = poco retroceso, se llena más; 50 % = la mitad, mejor precio pero muchas no se llenan). Si no se llena en las velas de 'Velas para que el precio vuelva a la entrada', se cancela. A mercado: al cierre de la vela del impulso; entra siempre, pero con el SL más lejos.")
imp_ret    = input.float(30, "%", minval=5, maxval=80, step=5, group=g_imp, inline="impent")
imp_tp     = input.float(5.75, "TP (R)", minval=0.5, step=0.25, group=g_imp)
imp_bias   = input.bool(true, "Solo a favor del bias de H1", group=g_imp)
imp_fuerte = input.float(0, "Sin filtro de bias si el impulso recorre al menos … × ATR (0 = no)", minval=0, step=0.25, group=g_imp, tooltip="Un impulso muy fuerte suele ser el propio giro del mercado, y en ese momento el bias de H1 todavía va en contra (ejemplo: la caída del 19 nov a las 16:15). Con un valor, por ejemplo 3, los impulsos que recorran al menos 3 veces el ATR entran aunque el bias de H1 no acompañe. 0 = desactivado: siempre se exige el bias si la casilla de arriba está marcada.")
imp_estr   = input.bool(false, "Solo a favor de la estructura swing del gráfico", group=g_imp, tooltip="La misma estructura swing que usa el FVG respetado (ajuste 'Velas' de ese apartado): no se compra un impulso alcista si la estructura es bajista ni al revés. Quita muchas rupturas falsas que se dan la vuelta en una o dos velas.")
imp_h_on   = input.bool(true, "Solo en estos horarios (hora de Madrid)", group=g_imp, tooltip="En la prueba de M5 (oct-nov) los impulsos de 03:00-08:00 y 15:00-19:00 de Madrid dieron casi todo el beneficio con pocos SL; los de 00:00-03:00 y 08:00-12:00 acumularon la mayoría de los SL.")
imp_h1     = input.session("0200-0800", "Horario 1", group=g_imp, inline="imph")
imp_h2     = input.session("1400-1900", "Horario 2", group=g_imp, inline="imph")
imp_max_sl = input.int(1, "Sin más impulsos ese día tras … SL de impulso (0 = sin límite)", minval=0, maxval=10, group=g_imp)

g_smt      = "SMT (punto extra)"
usar_smt   = input.bool(true, "Sumar un punto si hay SMT con el otro índice", group=g_smt)
smt_sym    = input.symbol("CME_MINI:MES1!", "Comparar con", group=g_smt)

g_v        = "Visual"
col_c      = input.color(#00A651, "Compra", group=g_v)
col_v      = input.color(#E4002B, "Venta", group=g_v)
ver_lineas = input.bool(true, "Dibujar entrada, SL y TP de cada señal", group=g_v)
ver_imp_no = input.bool(true, "Explicar por qué no entra un impulso", group=g_v, tooltip="Cuando hay un movimiento brusco (velas del mismo color que recorren al menos el recorrido mínimo del impulso) y la estrategia no entra, se pone una etiqueta gris pequeña con los motivos: horario, bias H1, volumen, cierre, no rompe, operación abierta, ya hubo SL de impulso, cupo diario, franja bloqueada, etc. Solo es visual, no cambia las operaciones.")
sep_etq    = input.float(2.0, "Separación de la etiqueta respecto a las velas (× ATR)", minval=0.5, step=0.5, group=g_v)

g_ct       = "Automatización CrossTrade (Tradovate)"
ct_instr   = input.string("MNQ1!", "Instrumento", group=g_ct, tooltip="Cada orden que ejecuta la estrategia lleva un mensaje para CrossTrade. En la alerta: condición 'Solo ejecuciones de órdenes', webhook de CrossTrade y en el mensaje tres líneas: key=TU_CLAVE; account=TU_CUENTA; {{strategy.order.alert_message}}. La clave y la cuenta van solo en la alerta, no aquí.")
ct_qty     = input.int(1, "Contratos", minval=1, maxval=50, group=g_ct)
ct_cierre  = input.string("flatten", "Comando para cerrar la posición", group=g_ct)

// ─────────────────────────────
// DATOS BASE
// ─────────────────────────────
tz        = "America/New_York"
atr       = ta.atr(14)
// Mensajes para CrossTrade (formato clave=valor;). La clave y la cuenta las pone la alerta.
ct_px(float x) => str.tostring(math.round_to_mintick(x), format.mintick)
// Entrada: se manda cuando la estrategia ejecuta la orden (también las límite), a mercado y con su SL y TP
ct_entrada(bool largo, float sl, float tp) =>
    m = "command=place;instrument=" + ct_instr + ";action=" + (largo ? "buy" : "sell") + ";qty=" + str.tostring(ct_qty) + ";order_type=market;tif=day;destination=tradovate;flatten_first=true;stop_loss=" + ct_px(sl) + ";"
    na(tp) ? m : m + "take_profit=" + ct_px(tp) + ";"
// Salida: cualquier cierre de la estrategia (SL, TP, break even, 22:00, cede al setup…) cierra también en Tradovate
ct_cerrar = "command=" + ct_cierre + ";instrument=" + ct_instr + ";destination=tradovate;"

operable  = timeframe.isintraday and timeframe.in_seconds() <= 900   // M1 a M15
cerrada   = barstate.isconfirmed
min_ny    = hour(time, tz) * 60 + minute(time, tz)
en_ny     = min_ny >= 570 and min_ny < 660          // 09:30-11:00 NY
// Horario válido para las señales: cualquier vela con mercado abierto, o solo la apertura de NY
en_horario = horario == "Todo el horario de mercado" ? true : en_ny
en_asia   = not na(time(timeframe.period, ses_asia_h, tz))
en_lon    = not na(time(timeframe.period, ses_lon_h, tz))
en_nys    = not na(time(timeframe.period, ses_ny_h, tz))
nuevo_dia = timeframe.change("D")
en_bloq   = (bloq_on and not na(time(timeframe.period, bloq_h, tz))) or (bloq2_on and not na(time(timeframe.period, bloq2_h, tz))) or (bloq3_on and not na(time(timeframe.period, bloq3_h, tz))) or (bloq4_on and not na(time(timeframe.period, bloq4_h, tz)))
// Última vela de la sesión de Nueva York: la que termina a las 16:00 NY o después
min_ny_fin = hour(time_close, tz) * 60 + minute(time_close, tz)
fin_ny    = min_ny < 960 and (min_ny_fin >= 960 or min_ny_fin < min_ny)
ult_ny    = min_fin_ny > 0 and min_ny >= 960 - min_fin_ny and min_ny < 960

// Pérdida máxima por día: la propia de TradingView cierra todo y para el día si se llega al límite
strategy.risk.max_intraday_loss(max_perd_dia > 0 ? max_perd_dia : 1e12, strategy.cash, "Pérdida máxima del día")
// Resultado de hoy (cerradas y abierta), para no abrir operaciones que puedan pasar del límite
var float neto_ini_dia = 0.0
if nuevo_dia
    neto_ini_dia := strategy.netprofit
cts = strategy.default_entry_qty(close)   // contratos por operación (los de Propiedades)
res_hoy = strategy.netprofit - neto_ini_dia + strategy.openprofit
// Lo que costaría en $ que saltara el SL: puntos × valor del punto × contratos, más comisión y
// deslizamiento de entrada y salida
coste_sl(float riesgo) =>
    riesgo * syminfo.pointvalue * cts + 2 * 0.5 * cts + 2 * syminfo.mintick * syminfo.pointvalue * cts
cabe_riesgo(float riesgo) =>
    max_perd_dia == 0 or -math.min(res_hoy, 0) + coste_sl(riesgo) <= max_perd_dia
// Evaluación de fondeo: lo que aún se puede ganar hoy (con comisión y deslizamiento de la operación)
gan_libre = max_gan_dia - (strategy.netprofit - neto_ini_dia) - 2 * 0.5 * cts - 2 * syminfo.mintick * syminfo.pointvalue * cts
tope_dia  = fondeo and gan_libre < 25
// TP acercado para que la operación, si llega al TP, no haga pasar la ganancia del día del tope
tope_tp(bool largo, float ent, float tp) =>
    float r = tp
    if fondeo
        dist = math.floor(gan_libre / (syminfo.pointvalue * cts) / syminfo.mintick) * syminfo.mintick
        r := largo ? math.min(tp, ent + dist) : math.max(tp, ent - dist)
    r

// Bias de una temporalidad superior: dirección de la última ruptura de estructura, con su vela ya
// cerrada (no repinta)
bias_htf() =>
    var int t = 0
    var float uh = na
    var float ul = na
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    if not na(ph)
        uh := ph
    if not na(pl)
        ul := pl
    if not na(uh) and close > uh
        t := 1
        uh := na
    else if not na(ul) and close < ul
        t := -1
        ul := na
    t[1]
b4 = request.security(syminfo.tickerid, "240", bias_htf(), lookahead=barmerge.lookahead_on)
b1 = request.security(syminfo.tickerid, "60", bias_htf(), lookahead=barmerge.lookahead_on)

// Día anterior y día actual
[pdh, pdl, pdc, d_open, d_atr] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open, ta.atr(14)[1]], lookahead=barmerge.lookahead_on)
var float dh = na
var float dl = na
if nuevo_dia
    dh := high
    dl := low
else
    dh := math.max(nz(dh, high), high)
    dl := math.min(nz(dl, low), low)
float vix_ant = na
if usar_vix
    vix_ant := request.security(vix_sym, "D", close[1], lookahead=barmerge.lookahead_on)

// Rangos de Asia y Londres (solo cuentan como nivel cuando la sesión ya ha terminado)
var float asia_h = na
var float asia_l = na
var float lon_h  = na
var float lon_l  = na
if en_asia
    asia_h := en_asia[1] ? math.max(asia_h, high) : high
    asia_l := en_asia[1] ? math.min(asia_l, low) : low
if en_lon
    lon_h := en_lon[1] ? math.max(lon_h, high) : high
    lon_l := en_lon[1] ? math.min(lon_l, low) : low
var float ny_h = na
var float ny_l = na
if en_nys
    ny_h := en_nys[1] ? math.max(ny_h, high) : high
    ny_l := en_nys[1] ? math.min(ny_l, low) : low
// Al empezar el día (18:00 NY) los rangos de sesión son los del día nuevo
if nuevo_dia
    lon_h := na
    lon_l := na
    ny_h  := na
    ny_l  := na
asia_hv = en_asia ? na : asia_h
asia_lv = en_asia ? na : asia_l
lon_hv  = en_lon ? na : lon_h
lon_lv  = en_lon ? na : lon_l
ny_hv   = en_nys ? na : ny_h
ny_lv   = en_nys ? na : ny_l

// Semana anterior y último alto/bajo relevante (pivote de 3 velas) de H1 y H4, con su vela cerrada
float pwh = na
float pwl = na
if usar_sem
    [a_w, b_w] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
    pwh := a_w
    pwl := b_w
piv_ult() =>
    ph_ = ta.pivothigh(high, 3, 3)
    pl_ = ta.pivotlow(low, 3, 3)
    [ta.valuewhen(not na(ph_), ph_, 0)[1], ta.valuewhen(not na(pl_), pl_, 0)[1]]
float h1_ph = na
float h1_pl = na
float h4_ph = na
float h4_pl = na
if usar_htf
    [a1, b1_] = request.security(syminfo.tickerid, "60", piv_ult(), lookahead=barmerge.lookahead_on)
    [a4, b4_] = request.security(syminfo.tickerid, "240", piv_ult(), lookahead=barmerge.lookahead_on)
    h1_ph := a1
    h1_pl := b1_
    h4_ph := a4
    h4_pl := b4_

// Último FVG alcista y bajista sin rellenar de una temporalidad superior (vela cerrada)
fvg_ult() =>
    var float bt = na
    var float bb = na
    var float st = na
    var float sb = na
    if not na(bb) and low <= bb
        bt := na
        bb := na
    if not na(st) and high >= st
        st := na
        sb := na
    if low > high[2]
        bt := low
        bb := high[2]
    if high < low[2]
        st := low[2]
        sb := high
    [bt[1], bb[1], st[1], sb[1]]
[m15_bt, m15_bb, m15_st, m15_sb] = request.security(syminfo.tickerid, "15", fvg_ult(), lookahead=barmerge.lookahead_on)
[h1_bt, h1_bb, h1_st, h1_sb] = request.security(syminfo.tickerid, "60", fvg_ult(), lookahead=barmerge.lookahead_on)

// FVG del gráfico para la entrada por FVG respetado: se guardan los que siguen sin tocar
var array<float> fa_top = array.new<float>()
var array<float> fa_bot = array.new<float>()
var array<int>   fa_bar = array.new<int>()
var array<float> fb_top = array.new<float>()
var array<float> fb_bot = array.new<float>()
var array<int>   fb_bar = array.new<int>()
bool  fr_c = false
bool  fr_v = false
float fr_c_bot = na
float fr_v_top = na
if usar_fr and cerrada
    // Alcistas: si el precio vuelve por primera vez, el FVG se respeta (cierra por encima) o se
    // descarta (cierra dentro o por debajo); también caduca tras fr_vida velas
    for i = fa_top.size() - 1 to 0
        if fa_top.size() == 0
            break
        t_ = fa_top.get(i)
        b_ = fa_bot.get(i)
        if low <= t_
            if close > t_ and low >= b_ and not fr_c
                fr_c := true
                fr_c_bot := b_
            fa_top.remove(i)
            fa_bot.remove(i)
            fa_bar.remove(i)
        else if bar_index - fa_bar.get(i) > fr_vida
            fa_top.remove(i)
            fa_bot.remove(i)
            fa_bar.remove(i)
    for i = fb_top.size() - 1 to 0
        if fb_top.size() == 0
            break
        t_ = fb_top.get(i)
        b_ = fb_bot.get(i)
        if high >= b_
            if close < b_ and high <= t_ and not fr_v
                fr_v := true
                fr_v_top := t_
            fb_top.remove(i)
            fb_bot.remove(i)
            fb_bar.remove(i)
        else if bar_index - fb_bar.get(i) > fr_vida
            fb_top.remove(i)
            fb_bot.remove(i)
            fb_bar.remove(i)
    // FVG nuevos (la vela actual cierra el hueco de tres velas)
    if low > high[2] and low - high[2] >= fr_min_atr * atr
        fa_top.push(low)
        fa_bot.push(high[2])
        fa_bar.push(bar_index)
        if fa_top.size() > 20
            fa_top.shift()
            fa_bot.shift()
            fa_bar.shift()
    if high < low[2] and low[2] - high >= fr_min_atr * atr
        fb_top.push(low[2])
        fb_bot.push(high)
        fb_bar.push(bar_index)
        if fb_top.size() > 20
            fb_top.shift()
            fb_bot.shift()
            fb_bar.shift()

// Confirmación del FVG respetado: la vela siguiente tiene que cerrar a favor sin volver al FVG
var int   frp_dir = 0
var int   frp_bar = na
var float frp_lvl = na
var float frp_cls = na
bool  fc_ok = false
bool  fv_ok = false
float fc_sl = na
float fv_sl = na
if usar_fr and cerrada
    if fr_conf
        if frp_dir != 0 and bar_index == frp_bar + 1
            if frp_dir == 1 and close > frp_cls and low > frp_lvl
                fc_ok := true
                fc_sl := frp_lvl
            else if frp_dir == -1 and close < frp_cls and high < frp_lvl
                fv_ok := true
                fv_sl := frp_lvl
            frp_dir := 0
        if fr_c
            frp_dir := 1
            frp_lvl := fr_c_bot
            frp_cls := close
            frp_bar := bar_index
        else if fr_v
            frp_dir := -1
            frp_lvl := fr_v_top
            frp_cls := close
            frp_bar := bar_index
    else
        fc_ok := fr_c
        fc_sl := fr_c_bot
        fv_ok := fr_v
        fv_sl := fr_v_top

// ─────────────────────────────
// ESTRUCTURA DEL GRÁFICO: pivotes, CHoCH y altos/bajos iguales
// ─────────────────────────────
ph = ta.pivothigh(high, piv_len, piv_len)
pl = ta.pivotlow(low, piv_len, piv_len)
var float lph = na      // último alto de swing sin romper
var float lpl = na      // último bajo de swing sin romper
var int   tend = 0
var float prev_ph = na
var float prev_pl = na
var float eqh = na
var float eql = na
if not na(ph)
    if not na(prev_ph) and math.abs(ph - prev_ph) <= 0.1 * atr
        eqh := math.max(ph, prev_ph)
    prev_ph := ph
    lph := ph
if not na(pl)
    if not na(prev_pl) and math.abs(pl - prev_pl) <= 0.1 * atr
        eql := math.min(pl, prev_pl)
    prev_pl := pl
    lpl := pl

choch_alc = false
choch_baj = false
float nivel_choch = na
if cerrada and not na(lph) and close > lph
    choch_alc := tend <= 0
    nivel_choch := lph
    tend := 1
    lph := na
else if cerrada and not na(lpl) and close < lpl
    choch_baj := tend >= 0
    nivel_choch := lpl
    tend := -1
    lpl := na

// Estructura swing (pivotes más grandes) para el filtro de la entrada por FVG respetado
ph_sw = ta.pivothigh(high, estr_len, estr_len)
pl_sw = ta.pivotlow(low, estr_len, estr_len)
var float sw_h = na
var float sw_l = na
var int   tend_sw = 0
if not na(ph_sw)
    sw_h := ph_sw
if not na(pl_sw)
    sw_l := pl_sw
if cerrada and not na(sw_h) and close > sw_h
    tend_sw := 1
    sw_h := na
else if cerrada and not na(sw_l) and close < sw_l
    tend_sw := -1
    sw_l := na

// ─────────────────────────────
// MANIPULACIÓN: barridos de liquidez o toque del 50 % de un FVG de M15/H1
// ─────────────────────────────
barre_bajo(float nv) =>
    not na(nv) and low < nv and close > nv
barre_alto(float nv) =>
    not na(nv) and high > nv and close < nv

string man_c = ""
if cerrada
    if usar_pd and barre_bajo(pdl)
        man_c := "PDL"
    else if usar_ses and barre_bajo(asia_lv)
        man_c := "bajo de Asia"
    else if usar_ses and barre_bajo(lon_lv)
        man_c := "bajo de Londres"
    else if usar_ses and barre_bajo(ny_lv)
        man_c := "bajo de NY"
    else if usar_sem and barre_bajo(pwl)
        man_c := "bajo semana ant."
    else if usar_htf and barre_bajo(h4_pl)
        man_c := "bajo H4"
    else if usar_htf and barre_bajo(h1_pl)
        man_c := "bajo H1"
    else if usar_eq and barre_bajo(eql)
        man_c := "EQL"
    else if usar_fvg50 and not na(m15_bb) and low <= (m15_bt + m15_bb) / 2 and close > m15_bb
        man_c := "50 % FVG M15"
    else if usar_fvg50 and not na(h1_bb) and low <= (h1_bt + h1_bb) / 2 and close > h1_bb
        man_c := "50 % FVG H1"
string man_v = ""
if cerrada
    if usar_pd and barre_alto(pdh)
        man_v := "PDH"
    else if usar_ses and barre_alto(asia_hv)
        man_v := "alto de Asia"
    else if usar_ses and barre_alto(lon_hv)
        man_v := "alto de Londres"
    else if usar_ses and barre_alto(ny_hv)
        man_v := "alto de NY"
    else if usar_sem and barre_alto(pwh)
        man_v := "alto semana ant."
    else if usar_htf and barre_alto(h4_ph)
        man_v := "alto H4"
    else if usar_htf and barre_alto(h1_ph)
        man_v := "alto H1"
    else if usar_eq and barre_alto(eqh)
        man_v := "EQH"
    else if usar_fvg50 and not na(m15_st) and high >= (m15_st + m15_sb) / 2 and close < m15_st
        man_v := "50 % FVG M15"
    else if usar_fvg50 and not na(h1_st) and high >= (h1_st + h1_sb) / 2 and close < h1_st
        man_v := "50 % FVG H1"
// Los altos/bajos iguales dejan de ser liquidez cuando se barren
if not na(eql) and low < eql
    eql := na
if not na(eqh) and high > eqh
    eqh := na

// Última manipulación de cada lado, el extremo alcanzado desde entonces (para el SL) y el último FVG
// que deja el impulso posterior (para la entrada)
var int    mc_bar = na
var float  mc_ext = na
var string mc_txt = ""
var float  mc_fvg = na
var int    mv_bar = na
var float  mv_ext = na
var string mv_txt = ""
var float  mv_fvg = na
if man_c != ""
    mc_bar := bar_index
    mc_ext := low
    mc_txt := man_c
    mc_fvg := na
else if not na(mc_bar)
    mc_ext := math.min(mc_ext, low)
if man_v != ""
    mv_bar := bar_index
    mv_ext := high
    mv_txt := man_v
    mv_fvg := na
else if not na(mv_bar)
    mv_ext := math.max(mv_ext, high)
if cerrada and not na(mc_bar) and bar_index > mc_bar and low > high[2]
    mc_fvg := low
if cerrada and not na(mv_bar) and bar_index > mv_bar and high < low[2]
    mv_fvg := high

// ─────────────────────────────
// SMT con el otro índice (punto extra)
// ─────────────────────────────
var int smt_c_bar = na
var int smt_v_bar = na
if usar_smt
    [o_l, o_h] = request.security(smt_sym, timeframe.period, [ta.lowest(low, 2 * piv_len + 1), ta.highest(high, 2 * piv_len + 1)], gaps=barmerge.gaps_off)
    var float ant_pl = na
    var float ant_ol = na
    var float ant_ph = na
    var float ant_oh = na
    if not na(pl)
        if not na(ant_pl) and not na(o_l) and not na(ant_ol) and (pl < ant_pl) != (o_l < ant_ol)
            smt_c_bar := bar_index
        ant_pl := pl
        ant_ol := o_l
    if not na(ph)
        if not na(ant_ph) and not na(o_h) and not na(ant_oh) and (ph > ant_ph) != (o_h > ant_oh)
            smt_v_bar := bar_index
        ant_ph := ph
        ant_oh := o_h

// ─────────────────────────────
// CONFIRMACIÓN: el CHoCH no puede fallar en la vela siguiente
// ─────────────────────────────
var int   pc_bar = na
var float pc_lvl = na
var int   pv_bar = na
var float pv_lvl = na
conf_c = false
conf_v = false
if cerrada and not na(pc_bar) and bar_index == pc_bar + 1
    conf_c := close > pc_lvl
    pc_bar := na
if cerrada and not na(pv_bar) and bar_index == pv_bar + 1
    conf_v := close < pv_lvl
    pv_bar := na
if choch_alc and not na(mc_bar) and bar_index - mc_bar <= vent_manip
    pc_bar := bar_index
    pc_lvl := nivel_choch
if choch_baj and not na(mv_bar) and bar_index - mv_bar <= vent_manip
    pv_bar := bar_index
    pv_lvl := nivel_choch

// ─────────────────────────────
// PUNTUACIÓN Y SEÑAL
// ─────────────────────────────
var int ops_hoy = 0
var int ops_setup = 0
var int orden_bar = na
var bool op_setup = false   // la última operación (abierta o pendiente) es del setup
if nuevo_dia
    ops_hoy := 0
    ops_setup := 0

// SL seguidos de hoy: se revisan las operaciones que se acaban de cerrar
var int sl_seg = 0
var int n_cerr = 0
var int imp_sl_hoy = 0   // SL de entradas por impulso hoy
if nuevo_dia
    sl_seg := 0
    imp_sl_hoy := 0
if strategy.closedtrades > n_cerr
    for i = n_cerr to strategy.closedtrades - 1
        sl_seg := strategy.closedtrades.exit_comment(i) == "SL" ? sl_seg + 1 : 0
        if str.startswith(strategy.closedtrades.entry_comment(i), "Impulso") and strategy.closedtrades.exit_comment(i) == "SL"
            imp_sl_hoy += 1
    n_cerr := strategy.closedtrades
parado_sl = parar_sl and sl_seg >= n_sl_seg

rango_hoy = dh - dl
// Rango: las últimas velas (sin contar la actual) caben en poca altura y el precio rota alrededor de
// su mitad. Mientras la vela actual cierre dentro de esa caja no puede haber señal; al cerrar fuera
// (breakout) vuelve a estar permitida.
r_alto = ta.highest(high, rango_velas)[1]
r_bajo = ta.lowest(low, rango_velas)[1]
r_mid  = (r_alto + r_bajo) / 2
int cruces = 0
for i = 1 to rango_velas - 1
    if (close[i] > r_mid) != (close[i + 1] > r_mid)
        cruces += 1
es_rango = not na(r_alto) and r_alto - r_bajo <= rango_atr * atr and cruces >= rango_rot
// El rango se recuerda: su caja se amplía mientras se siga detectando y solo se sale de él cuando
// una vela cierra fuera con margen (ruptura de verdad)
var float rg_alto = na
var float rg_bajo = na
if es_rango
    solapa = not na(rg_alto) and r_bajo <= rg_alto and r_alto >= rg_bajo
    rg_alto := solapa ? math.max(rg_alto, r_alto) : r_alto
    rg_bajo := solapa ? math.min(rg_bajo, r_bajo) : r_bajo
if not na(rg_alto) and (close > rg_alto + rango_marg * atr or close < rg_bajo - rango_marg * atr)
    rg_alto := na
    rg_bajo := na
// Choppiness Index: mide si el precio se mueve lateral (alto) o con tendencia (bajo)
chop = 100 * math.log10(math.sum(ta.atr(1), 14) / (ta.highest(high, 14) - ta.lowest(low, 14))) / math.log10(14)
dentro_rango = usar_rango and (not na(rg_alto) or (usar_chop and chop > chop_lim))
// Rangos: el mismo detector que el indicador (Auto Range Detector [QuantAlgo] © QuantAlgo, CC BY-NC-SA
// 4.0, con sus mismos valores fijos). Busca ventanas de rq_base, 2× y 3× velas con poca altura para su
// volatilidad, que rotan alrededor de su mitad, tocan los dos bordes y apenas tienen pendiente. Mientras
// el rango está activo no se opera; se sale con un cierre fuera de la caja (0,15 ATR de 200); si el
// precio vuelve a entrar en las 10 velas siguientes (ruptura fallida) el rango sigue activo.
atr_r  = ta.atr(200)
ctx_ok = not na(atr_r) and atr_r > 0
scan_rng(simple int len) =>
    top    = ta.percentile_linear_interpolation(high, len, 90.0)
    bottom = ta.percentile_linear_interpolation(low, len, 10.0)
    band   = top - bottom
    compression = ctx_ok and band > 0 ? band / (atr_r * math.sqrt(len)) : 99.0
    span_cap = bar_index < 1 ? 500 : int(math.max(1, math.min(500, bar_index - 200)))
    rank   = ta.percentrank(compression, span_cap)
    slope  = ta.linreg(close, len, 0) - ta.linreg(close, len, 1)
    drift  = band > 0 ? math.abs(slope) * len / band : 99.0
    mid    = math.avg(top, bottom)
    tol    = 0.10 * nz(atr_r)
    crossings = 0
    hits_top = 0
    hits_bottom = 0
    contained = 0
    for i = 0 to len - 1
        if (close[i] > mid) != (close[i + 1] > mid)
            crossings += 1
        if high[i] >= top - tol
            hits_top += 1
        if low[i] <= bottom + tol
            hits_bottom += 1
        if close[i] <= top and close[i] >= bottom
            contained += 1
    containment = contained / float(len)
    q = ctx_ok and not na(rank) and bar_index > len + 5 and rank <= 40.0 and crossings >= math.max(3, math.round(0.18 * len)) and hits_top >= rq_toques and hits_bottom >= rq_toques and drift <= 0.45 and containment >= 0.70
    [q, top, bottom]
anclar_rng(int window, float top_price, float bottom_price, float tolerance) =>
    span = window
    limit = math.min(300, bar_index)
    allowed = math.max(2, math.round(0.30 * window))
    outside = 0
    offset = 0
    while offset < limit and outside <= allowed
        closed_in = close[offset] <= top_price and close[offset] >= bottom_price
        fully_in = closed_in and high[offset] <= top_price + tolerance and low[offset] >= bottom_price - tolerance
        if closed_in
            outside := math.max(0, outside - 1)
            if fully_in and offset + 1 >= window
                span := offset + 1
        else
            outside += 1
        offset += 1
    span
[rq_a, rt_a, rb_a] = scan_rng(rq_base)
[rq_b, rt_b, rb_b] = scan_rng(rq_base * 2)
[rq_c, rt_c, rb_c] = scan_rng(rq_base * 3)
rq_ok   = rq_a or rq_b or rq_c
rq_len  = rq_c ? rq_base * 3 : rq_b ? rq_base * 2 : rq_base
rq_top  = rq_c ? rt_c : rq_b ? rt_b : rt_a
rq_bot  = rq_c ? rb_c : rq_b ? rb_b : rb_a
var bool  rg_activo = false
var bool  rg_conf   = false
var bool  rg_dorm   = false
var float rg_top    = na
var float rg_bot    = na
var int   rg_left   = na
var int   rg_dsince = na
var int   rg_ddir   = 0
var int   rg_cool   = 0
if cerrada and rg_cool > 0
    rg_cool -= 1
if cerrada and not rg_activo and not rg_dorm and rg_cool <= 0 and rq_ok
    rg_left   := bar_index - anclar_rng(rq_len, rq_top, rq_bot, 0.10 * atr_r) + 1
    rg_top    := rq_top
    rg_bot    := rq_bot
    rg_activo := true
    rg_conf   := false
if rg_activo and cerrada
    if close <= rg_top and close >= rg_bot
        if high > rg_top and high <= rg_top + 0.25 * atr_r
            rg_top := high
        if low < rg_bot and low >= rg_bot - 0.25 * atr_r
            rg_bot := low
    rup_alc = close > rg_top + 0.15 * atr_r
    rup_baj = close < rg_bot - 0.15 * atr_r
    if rup_alc or rup_baj
        if rg_conf
            rg_dorm   := true
            rg_dsince := bar_index
            rg_ddir   := rup_alc ? 1 : -1
        rg_activo := false
        rg_conf   := false
        rg_cool   := 3
    else
        rg_conf := bar_index - rg_left + 1 >= rq_min
if rg_dorm and cerrada
    vuelve = rg_ddir == 1 ? close <= rg_top : close >= rg_bot
    if vuelve and bar_index > rg_dsince
        rg_activo := true
        rg_conf   := true
        rg_dorm   := false
        rg_ddir   := 0
        rg_cool   := 0
    else if bar_index - rg_dsince >= 10
        rg_dorm := false
        rg_ddir := 0
// Rango del indicador: bloquea las entradas por FVG (y el setup si se elige)
en_rango_ind = usar_rq and rg_activo
mitad_ant = (pdh + pdl) / 2
filtros_comunes = (not usar_atr or na(d_atr) or rango_hoy < d_atr) and (not usar_vix or na(vix_ant) or rango_hoy < pdc * vix_ant / 16 / 100)
filtros_c = filtros_comunes and (not usar_desc or close < mitad_ant or close < d_open)
filtros_v = filtros_comunes and (not usar_desc or close > mitad_ant or close > d_open)
bias_c = b1 == 1 and (not usar_h4 or b4 != -1)
bias_v = b1 == -1 and (not usar_h4 or b4 != 1)
smt_c  = usar_smt and not na(smt_c_bar) and bar_index - smt_c_bar <= vent_manip + piv_len
smt_v  = usar_smt and not na(smt_v_bar) and bar_index - smt_v_bar <= vent_manip + piv_len
man_ok_c = not na(mc_bar) and bar_index - mc_bar <= vent_manip + 1
man_ok_v = not na(mv_bar) and bar_index - mv_bar <= vent_manip + 1

punt_c = (bias_c ? 1 : 0) + (en_horario ? 1 : 0) + (man_ok_c ? 1 : 0) + (conf_c ? 1 : 0) + (filtros_c ? 1 : 0) + (smt_c ? 1 : 0)
punt_v = (bias_v ? 1 : 0) + (en_horario ? 1 : 0) + (man_ok_v ? 1 : 0) + (conf_v ? 1 : 0) + (filtros_v ? 1 : 0) + (smt_v ? 1 : 0)
// Impulso: las últimas imp_n velas (o menos) del mismo color recorren al menos imp_atr × ATR (el ATR de
// antes del impulso, para que el propio impulso no lo infle), la última cierra cerca de su extremo, con
// volumen alto, y se rompe el alto/bajo de las imp_rot velas anteriores
imp_atr_ref = atr[imp_n]
imp_vol_ref = ta.sma(volume, 20)[imp_n]
// Volumen relativo de la vela de la señal (volumen / media de las 20 anteriores). Se apunta en el nombre de
// cada entrada (" · V1.4") para poder estudiar en el CSV con qué volumen salen los SL
vol_rel  = volume / ta.sma(volume, 20)[1]
vol_txt  = " · V" + str.tostring(vol_rel, "0.0")
imp_rot_h   = ta.highest(high, math.max(imp_rot, 1))[imp_n]
imp_rot_l   = ta.lowest(low, math.max(imp_rot, 1))[imp_n]
// Busca, de 1 a imp_n velas hacia atrás, un tramo de velas todas del mismo color que recorra lo suficiente.
// Devuelve si hay impulso y el extremo donde empezó (el bajo en compras, el alto en ventas).
imp_detect(bool compra) =>
    bool ok = false
    float ext = na
    bool mismo = true
    float e = compra ? low : high
    float vsum = 0.0
    for k = 1 to imp_n
        j = k - 1
        mismo := mismo and (compra ? close[j] > open[j] : close[j] < open[j])
        e := compra ? math.min(e, low[j]) : math.max(e, high[j])
        vsum += volume[j]
        rec = compra ? close - e : e - close
        vol_ok = imp_vol == 0 or vsum / k >= imp_vol * imp_vol_ref
        if not ok and mismo and rec >= imp_atr * imp_atr_ref and vol_ok
            ok := true
            ext := e
    rango_v = high - low
    cierre_ok = rango_v > 0 and (compra ? high - close <= imp_cierre * rango_v : close - low <= imp_cierre * rango_v)
    rot_ok = imp_rot == 0 or (compra ? close > imp_rot_h : close < imp_rot_l)
    [ok and cierre_ok and rot_ok, ext]
[imp_c, imp_ext_c] = imp_detect(true)
// Candidato "geométrico" (solo velas del mismo color y recorrido), para explicar por qué no entra
imp_cand(bool compra) =>
    bool ok = false
    bool mismo = true
    float e = compra ? low : high
    for k = 1 to imp_n
        j = k - 1
        mismo := mismo and (compra ? close[j] > open[j] : close[j] < open[j])
        e := compra ? math.min(e, low[j]) : math.max(e, high[j])
        if mismo and (compra ? close - e : e - close) >= imp_atr * imp_atr_ref
            ok := true
    ok
imp_cand_c = imp_cand(true)
imp_cand_v = imp_cand(false)
[imp_v, imp_ext_v] = imp_detect(false)
// Impulso muy fuerte: no necesita el bias de H1
imp_fuerte_c = imp_fuerte > 0 and imp_c and close - imp_ext_c >= imp_fuerte * imp_atr_ref
imp_fuerte_v = imp_fuerte > 0 and imp_v and imp_ext_v - close >= imp_fuerte * imp_atr_ref
puede_b = operable and cerrada and not dentro_rango and not (cerrar_ses and fin_ny) and not ult_ny and not parado_sl and not en_bloq and not tope_dia
// Orden del setup esperando a llenarse: con prioridad, no se pisa con una entrada por FVG
setup_pend = prio_setup and op_setup and strategy.position_size == 0 and not na(orden_bar)
puede  = puede_b and strategy.position_size == 0 and ops_hoy < max_dia and not setup_pend and not en_rango_ind
// El setup: con prioridad tiene su cupo y puede entrar aunque haya una operación de FVG abierta
puede_s = (prio_setup ? puede_b and (strategy.position_size == 0 or not op_setup) and ops_setup < max_dia_setup : puede_b and strategy.position_size == 0 and ops_hoy < max_dia and not setup_pend) and not (rq_setup and en_rango_ind)
senal_c = puede_s and dir_op != "Solo ventas" and bias_c and en_horario and man_ok_c and conf_c and punt_c >= punt_min
senal_v = puede_s and dir_op != "Solo compras" and bias_v and en_horario and man_ok_v and conf_v and punt_v >= punt_min and not senal_c
senal_fc = usar_fr and puede and not senal_c and not senal_v and dir_op != "Solo ventas" and en_horario and (fr_vol_min == 0 or vol_rel >= fr_vol_min) and fc_ok and (not fr_bias or bias_c) and (not fr_estr or tend_sw == 1)
senal_fv = usar_fr and puede and not senal_c and not senal_v and not senal_fc and dir_op != "Solo compras" and en_horario and (fr_vol_min == 0 or vol_rel >= fr_vol_min) and fv_ok and (not fr_bias or bias_v) and (not fr_estr or tend_sw == -1)
// Impulso: solo si en esa vela no hay setup ni FVG respetado, en su horario, a favor de la estructura y
// sin haber llegado a los SL de impulso del día
imp_hora_ok = not imp_h_on or not na(time(timeframe.period, imp_h1, "Europe/Madrid")) or not na(time(timeframe.period, imp_h2, "Europe/Madrid"))
imp_dia_ok  = imp_max_sl == 0 or imp_sl_hoy < imp_max_sl
senal_ic = usar_imp and puede and not senal_c and not senal_v and not senal_fc and not senal_fv and dir_op != "Solo ventas" and en_horario and imp_c and (not imp_bias or bias_c or imp_fuerte_c) and (not imp_estr or tend_sw == 1) and imp_hora_ok and imp_dia_ok
senal_iv = usar_imp and puede and not senal_c and not senal_v and not senal_fc and not senal_fv and not senal_ic and dir_op != "Solo compras" and en_horario and imp_v and (not imp_bias or bias_v or imp_fuerte_v) and (not imp_estr or tend_sw == -1) and imp_hora_ok and imp_dia_ok
// Por qué no entra un impulso (solo visual)
imp_motivos(bool compra) =>
    string r = ""
    rango_v = high - low
    if not (compra ? imp_c : imp_v)
        if rango_v > 0 and (compra ? high - close > imp_cierre * rango_v : close - low > imp_cierre * rango_v)
            r += ", cierre"
        if imp_rot > 0 and (compra ? close <= imp_rot_h : close >= imp_rot_l)
            r += ", no rompe " + str.tostring(imp_rot) + " velas"
        if imp_vol > 0 and vol_rel < imp_vol
            r += ", volumen V" + str.tostring(vol_rel, "0.0")
    if not imp_hora_ok
        r += ", horario"
    if imp_bias and not (compra ? bias_c or imp_fuerte_c : bias_v or imp_fuerte_v)
        r += ", bias H1"
    if imp_estr and tend_sw != (compra ? 1 : -1)
        r += ", estructura"
    if not imp_dia_ok
        r += ", ya hubo SL de impulso"
    if strategy.position_size != 0
        r += ", operación abierta"
    if ops_hoy >= max_dia
        r += ", cupo diario"
    if en_bloq
        r += ", franja bloqueada"
    if parado_sl
        r += ", SL seguidos"
    if tope_dia
        r += ", tope fondeo"
    if dentro_rango or en_rango_ind
        r += ", rango"
    if (cerrar_ses and fin_ny) or ult_ny
        r += ", fin de sesión"
    if setup_pend
        r += ", setup pendiente"
    if senal_c or senal_v or senal_fc or senal_fv
        r += ", otra entrada"
    if dir_op == (compra ? "Solo ventas" : "Solo compras") or not en_horario
        r += ", dirección/horario de señales"
    str.length(r) > 2 ? str.substring(r, 2) : "?"
if ver_imp_no and usar_imp and cerrada and operable
    if imp_cand_c and not imp_cand_c[1] and not senal_ic
        label.new(bar_index, low - 0.5 * atr, "✕ impulso ▲: " + imp_motivos(true), style=label.style_label_up, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
    if imp_cand_v and not imp_cand_v[1] and not senal_iv
        label.new(bar_index, high + 0.5 * atr, "✕ impulso ▼: " + imp_motivos(false), style=label.style_label_down, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)

// Objetivo: la liquidez más cercana en la dirección de la operación que dé el riesgo/beneficio mínimo;
// si no hay ninguna, 2R
objetivo(float entrada, float riesgo, bool compra) =>
    cands = compra ? array.from(pdh, asia_hv, lon_hv, ny_hv, eqh, dh, pwh, h1_ph, h4_ph) : array.from(pdl, asia_lv, lon_lv, ny_lv, eql, dl, pwl, h1_pl, h4_pl)
    nombres = array.from(compra ? "PDH" : "PDL", compra ? "alto de Asia" : "bajo de Asia", compra ? "alto de Londres" : "bajo de Londres", compra ? "alto de NY" : "bajo de NY", compra ? "EQH" : "EQL", compra ? "alto del día" : "bajo del día", compra ? "alto semana ant." : "bajo semana ant.", compra ? "alto H1" : "bajo H1", compra ? "alto H4" : "bajo H4")
    float mejor = na
    string nom = "2R"
    for i = 0 to cands.size() - 1
        nv = cands.get(i)
        dist = compra ? nv - entrada : entrada - nv
        if not na(nv) and dist >= min_rr * riesgo and (na(mejor) or dist < (compra ? mejor - entrada : entrada - mejor))
            mejor := nv
            nom := nombres.get(i)
    [na(mejor) ? (compra ? entrada + 2 * riesgo : entrada - 2 * riesgo) : mejor, nom]

// Extremos de las últimas velas (se calculan en cada vela para que sean correctos)
bajo10 = ta.lowest(low, 10)
alto10 = ta.highest(high, 10)
dibujar(bool compra, float ent, float sl, float tp, string txt) =>
    col = compra ? col_c : col_v
    // La etiqueta se saca a una zona limpia: por debajo (compra) o por encima (venta) de las velas de
    // alrededor, separada sep_etq ATR, con una línea fina que la une a la vela de la señal
    extremo = compra ? bajo10 : alto10
    y = compra ? extremo - sep_etq * atr : extremo + sep_etq * atr
    line.new(bar_index, compra ? low : high, bar_index, y, color=color.new(col, 40), style=line.style_dotted)
    lbl = label.new(bar_index, y, txt, style=compra ? label.style_label_up : label.style_label_down, color=col, textcolor=color.white, size=size.small)
    if ver_lineas
        line.new(bar_index, ent, bar_index + 20, ent, color=color.new(#1565C0, 0), width=2)
        line.new(bar_index, sl, bar_index + 20, sl, color=color.new(col_v, 0), style=line.style_dashed)
        line.new(bar_index, tp, bar_index + 20, tp, color=color.new(col_c, 0), style=line.style_dashed)
    lbl

// Datos de la operación en curso, para el break even
var float op_tp = na
var float op_r  = na
var bool  op_be = false
var float op_ber = na   // break even de la operación en curso (setup o FVG)
// Etiqueta de la última señal y operaciones cerradas en ese momento: si su orden se cancela sin llenarse,
// la etiqueta se pone gris con "no entró"
var label ult_lbl = na
var int   ult_ct  = 0

if senal_c
    ent = na(mc_fvg) ? close : math.min(mc_fvg, close)
    sl = mc_ext - sl_buf * atr
    riesgo = ent - sl
    // Sin operación si el SL queda demasiado lejos (las pérdidas grandes vienen de ahí)
    sl_ok = riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
    if sl_ok
        [tp0, tp_nom0] = objetivo(ent, riesgo, true)
        tp = tp_max_r > 0 ? math.min(tp0, ent + tp_max_r * riesgo) : tp0
        tp_nom = tp < tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        tp_f = tope_tp(true, ent, tp)
        tp_nom := tp_f != tp ? "tope del día" : tp_nom
        tp := tp_f
        rr = (tp - ent) / riesgo
        if prio_setup and strategy.position_size != 0
            strategy.close_all(comment="Cede al setup", immediately=true, alert_message=ct_cerrar)
        strategy.entry("Compra", strategy.long, limit=na(mc_fvg) ? na : ent, comment="Setup " + str.tostring(punt_c) + "/6" + vol_txt, alert_message=ct_entrada(true, sl, tp))
        strategy.exit("Salida compra", "Compra", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP", alert_message=ct_cerrar)
        op_tp := tp
        op_r  := riesgo
        op_be := false
        op_ber := be_setup
        orden_bar := bar_index
        if prio_setup
            ops_setup += 1
        else
            ops_hoy += 1
        op_setup := true
        ult_lbl := dibujar(true, ent, sl, tp, "▲ SETUP " + str.tostring(punt_c) + "/6\nBarrido " + mc_txt + (smt_c ? " + SMT" : "") + "\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        ult_ct := strategy.closedtrades
        alert("▲ Setup de compra " + str.tostring(punt_c) + "/6 en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)
        mc_bar := na

if senal_v
    ent = na(mv_fvg) ? close : math.max(mv_fvg, close)
    sl = mv_ext + sl_buf * atr
    riesgo = sl - ent
    sl_ok = riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
    if sl_ok
        [tp0, tp_nom0] = objetivo(ent, riesgo, false)
        tp = tp_max_r > 0 ? math.max(tp0, ent - tp_max_r * riesgo) : tp0
        tp_nom = tp > tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        tp_f = tope_tp(false, ent, tp)
        tp_nom := tp_f != tp ? "tope del día" : tp_nom
        tp := tp_f
        rr = (ent - tp) / riesgo
        if prio_setup and strategy.position_size != 0
            strategy.close_all(comment="Cede al setup", immediately=true, alert_message=ct_cerrar)
        strategy.entry("Venta", strategy.short, limit=na(mv_fvg) ? na : ent, comment="Setup " + str.tostring(punt_v) + "/6" + vol_txt, alert_message=ct_entrada(false, sl, tp))
        strategy.exit("Salida venta", "Venta", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP", alert_message=ct_cerrar)
        op_tp := tp
        op_r  := riesgo
        op_be := false
        op_ber := be_setup
        orden_bar := bar_index
        if prio_setup
            ops_setup += 1
        else
            ops_hoy += 1
        op_setup := true
        ult_lbl := dibujar(false, ent, sl, tp, "▼ SETUP " + str.tostring(punt_v) + "/6\nBarrido " + mv_txt + (smt_v ? " + SMT" : "") + "\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        ult_ct := strategy.closedtrades
        alert("▼ Setup de venta " + str.tostring(punt_v) + "/6 en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)
        mv_bar := na

// Entrada por FVG respetado: a mercado, SL al otro lado del FVG
if senal_fc
    ent = close
    sl = fc_sl - sl_buf * atr
    riesgo = ent - sl
    if riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
        [tp0, tp_nom0] = objetivo(ent, riesgo, true)
        tp = tp_max_r > 0 ? math.min(tp0, ent + tp_max_r * riesgo) : tp0
        tp_nom = tp < tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        tp_f = tope_tp(true, ent, tp)
        tp_nom := tp_f != tp ? "tope del día" : tp_nom
        tp := tp_f
        rr = (tp - ent) / riesgo
        strategy.entry("Compra", strategy.long, comment="FVG respetado" + vol_txt, alert_message=ct_entrada(true, sl, tp))
        strategy.exit("Salida compra", "Compra", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP", alert_message=ct_cerrar)
        op_tp := tp
        op_r  := riesgo
        op_be := false
        op_ber := be_r
        orden_bar := bar_index
        ops_hoy += 1
        op_setup := false
        ult_lbl := dibujar(true, ent, sl, tp, "▲ FVG RESPETADO\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        ult_ct := strategy.closedtrades
        alert("▲ FVG respetado, compra en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)

if senal_fv
    ent = close
    sl = fv_sl + sl_buf * atr
    riesgo = sl - ent
    if riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
        [tp0, tp_nom0] = objetivo(ent, riesgo, false)
        tp = tp_max_r > 0 ? math.max(tp0, ent - tp_max_r * riesgo) : tp0
        tp_nom = tp > tp0 ? str.tostring(tp_max_r) + "R" : tp_nom0
        tp_f = tope_tp(false, ent, tp)
        tp_nom := tp_f != tp ? "tope del día" : tp_nom
        tp := tp_f
        rr = (ent - tp) / riesgo
        strategy.entry("Venta", strategy.short, comment="FVG respetado" + vol_txt, alert_message=ct_entrada(false, sl, tp))
        strategy.exit("Salida venta", "Venta", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP", alert_message=ct_cerrar)
        op_tp := tp
        op_r  := riesgo
        op_be := false
        op_ber := be_r
        orden_bar := bar_index
        ops_hoy += 1
        op_setup := false
        ult_lbl := dibujar(false, ent, sl, tp, "▼ FVG RESPETADO\nTP " + tp_nom + " · RR " + str.tostring(rr, "#.#"))
        ult_ct := strategy.closedtrades
        alert("▼ FVG respetado, venta en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick) + " (" + tp_nom + ")", alert.freq_once_per_bar_close)

// Entrada por impulso: a favor del movimiento brusco, en un retroceso (orden límite) o a mercado; SL al otro
// lado del impulso y TP a imp_tp R
if senal_ic
    a_merc = imp_modo == "A mercado"
    ent = a_merc ? close : math.round_to_mintick(close - imp_ret / 100 * (close - imp_ext_c))
    sl = imp_ext_c - sl_buf * atr
    riesgo = ent - sl
    if riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
        tp = tope_tp(true, ent, ent + imp_tp * riesgo)
        rr = (tp - ent) / riesgo
        strategy.entry("Compra", strategy.long, limit=a_merc ? na : ent, comment="Impulso" + vol_txt, alert_message=ct_entrada(true, sl, tp))
        strategy.exit("Salida compra", "Compra", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP", alert_message=ct_cerrar)
        op_tp := tp
        op_r  := riesgo
        op_be := false
        op_ber := be_r
        orden_bar := bar_index
        ops_hoy += 1
        op_setup := false
        ult_lbl := dibujar(true, ent, sl, tp, "▲ IMPULSO\nTP " + str.tostring(rr, "#.#") + "R")
        ult_ct := strategy.closedtrades
        alert("▲ Impulso, compra en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

if senal_iv
    a_merc = imp_modo == "A mercado"
    ent = a_merc ? close : math.round_to_mintick(close + imp_ret / 100 * (imp_ext_v - close))
    sl = imp_ext_v + sl_buf * atr
    riesgo = sl - ent
    if riesgo > 0 and (max_sl_atr == 0 or riesgo <= max_sl_atr * atr) and (max_sl_pts == 0 or riesgo <= max_sl_pts) and cabe_riesgo(riesgo)
        tp = tope_tp(false, ent, ent - imp_tp * riesgo)
        rr = (ent - tp) / riesgo
        strategy.entry("Venta", strategy.short, limit=a_merc ? na : ent, comment="Impulso" + vol_txt, alert_message=ct_entrada(false, sl, tp))
        strategy.exit("Salida venta", "Venta", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP", alert_message=ct_cerrar)
        op_tp := tp
        op_r  := riesgo
        op_be := false
        op_ber := be_r
        orden_bar := bar_index
        ops_hoy += 1
        op_setup := false
        ult_lbl := dibujar(false, ent, sl, tp, "▼ IMPULSO\nTP " + str.tostring(rr, "#.#") + "R")
        ult_ct := strategy.closedtrades
        alert("▼ Impulso, venta en " + syminfo.ticker + ": entrada " + str.tostring(ent, format.mintick) + ", SL " + str.tostring(sl, format.mintick) + ", TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

// Break even: cuando la operación va ganando be_r veces el riesgo, el SL pasa al precio de entrada.
// Cierre por tiempo: si lleva max_velas_op velas abierta, se cierra.
if strategy.position_size != 0 and cerrada
    largo = strategy.position_size > 0
    entp  = strategy.position_avg_price
    ber = na(op_ber) ? be_r : op_ber
    if ber > 0 and not op_be and not na(op_r) and (largo ? high - entp >= ber * op_r : entp - low >= ber * op_r)
        op_be := true
        be_px = largo ? entp + be_ticks * syminfo.mintick : entp - be_ticks * syminfo.mintick
        strategy.exit(largo ? "Salida compra" : "Salida venta", largo ? "Compra" : "Venta", stop=be_px, limit=op_tp, comment_loss="BE", comment_profit="TP", alert_message=ct_cerrar)
    if max_velas_op > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= max_velas_op
        strategy.close_all(comment="Tiempo máximo", alert_message=ct_cerrar)

// Orden límite que no se llena a tiempo, o pendiente cuando el precio entra en rango o en la franja sin
// operar: se cancela
if strategy.position_size == 0 and not na(orden_bar) and (bar_index - orden_bar > vence_lim or ((dentro_rango or en_bloq) and bar_index > orden_bar))
    strategy.cancel("Compra")
    strategy.cancel("Venta")
    if not na(ult_lbl) and strategy.opentrades == 0 and strategy.closedtrades == ult_ct
        label.set_text(ult_lbl, label.get_text(ult_lbl) + "\n✕ no entró")
        label.set_color(ult_lbl, color.gray)
    ult_lbl := na
    orden_bar := na

// Fin de la sesión de Nueva York: en su última vela se cierra lo abierto al cierre de esa misma vela
// (antes de las 16:00) y se cancela la orden límite pendiente, para que nada pase a la noche
if cerrar_ses and fin_ny
    strategy.cancel("Compra")
    strategy.cancel("Venta")
    if not na(ult_lbl) and strategy.opentrades == 0 and strategy.closedtrades == ult_ct
        label.set_text(ult_lbl, label.get_text(ult_lbl) + "\n✕ no entró")
        label.set_color(ult_lbl, color.gray)
    ult_lbl := na
    orden_bar := na
    if strategy.position_size != 0
        strategy.close_all(comment="Cierre fin sesión NY", immediately=true, alert_message=ct_cerrar)

// ─────────────────────────────
// Fin del script (si al pegar falta esta línea, el código no se ha copiado entero)
